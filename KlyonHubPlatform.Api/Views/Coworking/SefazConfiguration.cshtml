@{
    ViewData["Title"] = "Configurações SEFAZ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.CoworkingSefazConfiguration>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-gear"></i> Configurações SEFAZ</h2>
    <div>
        <span class="badge bg-success me-2"><i class="bi bi-cloud-check"></i> Focus NFe</span>
        <a href="@Url.Action("ServiceFiscalNotes", "Coworking")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> <strong>Integração Focus NFe:</strong> A emissão de notas fiscais é feita através do Focus NFe, 
    um intermediário que elimina a necessidade de certificado digital próprio. Configure seu token da API para cada estado onde você presta serviços.
    <a href="https://focusnfe.com.br" target="_blank">Saiba mais sobre o Focus NFe</a>
</div>

<!-- Lista de Configurações -->
<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Configurações Cadastradas</h5>
        <button type="button" class="btn btn-primary" onclick="openConfigModal(null)">
            <i class="bi bi-plus-circle"></i> Nova Configuração
        </button>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Estado</th>
                            <th>Ambiente</th>
                            <th>CNPJ</th>
                            <th>Inscrição Municipal</th>
                            <th>Código Serviço</th>
                            <th>ISS (%)</th>
                            <th>Token API</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in Model)
                        {
                            <tr>
                                <td><strong>@config.State</strong></td>
                                <td>
                                    <span class="badge bg-@(config.Environment == "Producao" ? "success" : "warning")">
                                        @config.Environment
                                    </span>
                                </td>
                                <td>@config.PartnerCNPJ</td>
                                <td>@config.PartnerMunicipalRegistration</td>
                                <td>@config.ServiceCode</td>
                                <td>@config.ISSAliquot.ToString(NumberFormatConstants.TwoDecimals)%</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(config.ApiToken))
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Configurado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning"><i class="bi bi-exclamation-triangle"></i> Pendente</span>
                                    }
                                </td>
                                <td>
                                    @if (config.IsActive)
                                    {
                                        <span class="badge bg-success">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inativa</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-primary" onclick="openConfigModal(@config.Id)">
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                <i class="bi bi-exclamation-triangle"></i> Nenhuma configuração SEFAZ cadastrada. 
                Clique em "Nova Configuração" para começar.
            </div>
        }
    </div>
</div>

<!-- Modal de Configuração -->
<div class="modal fade" id="configModal" tabindex="-1" aria-labelledby="configModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="configModalLabel">
                    <i class="bi bi-gear"></i> Configuração SEFAZ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("SaveSefazConfiguration", "Coworking")" id="configForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="configId" name="id" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="state" class="form-label">Estado (UF) <span class="text-danger">*</span></label>
                            <select class="form-select" id="state" name="state" required>
                                <option value="">Selecione...</option>
                                @foreach (var state in ViewBag.SupportedStates as string[])
                                {
                                    <option value="@state">@state</option>
                                }
                            </select>
                            <small class="form-text text-muted">Estados com integração disponível</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="environment" class="form-label">Ambiente <span class="text-danger">*</span></label>
                            <select class="form-select" id="environment" name="environment" required>
                                <option value="Homologacao">Homologação</option>
                                <option value="Producao">Produção</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="partnerCNPJ" class="form-label">CNPJ do Parceiro <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partnerCNPJ" name="partnerCNPJ" required placeholder="00.000.000/0001-00">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="partnerMunicipalRegistration" class="form-label">Inscrição Municipal <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partnerMunicipalRegistration" name="partnerMunicipalRegistration" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="serviceCode" class="form-label">Código do Serviço (LC 116) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="serviceCode" name="serviceCode" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="serviceDescription" class="form-label">Descrição do Serviço <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="serviceDescription" name="serviceDescription" required placeholder="Prestação de serviços">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="issAliquot" class="form-label">Alíquota de ISS (%) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control" id="issAliquot" name="issAliquot" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="issMunicipality" class="form-label">Município de Incidência do ISS <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="issMunicipality" name="issMunicipality" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="apiToken" class="form-label">Token da API Focus NFe <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="apiToken" name="apiToken" placeholder="Token de autenticação do Focus NFe" required>
                            <small class="form-text text-muted">Obtenha o token no painel do Focus NFe. Este token é usado para emitir notas fiscais em nome do seu estabelecimento.</small>
                        </div>
                    </div>
                    <div class="alert alert-info">
                        <i class="bi bi-lightbulb"></i> <strong>Dica:</strong> O Focus NFe oferece ambiente de homologação gratuito para testes. 
                        Use o ambiente de homologação primeiro antes de configurar a produção.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar Configuração
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        const modalEl = document.getElementById('configModal');
        const form = document.getElementById('configForm');
        const configIdInput = document.getElementById('configId');
        const cancelBtn = document.querySelector('#configModal .btn-secondary[data-bs-dismiss="modal"]');

        window.openConfigModal = function (configId) {
            form.reset();
            configIdInput.value = configId || '';
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        };

        if (cancelBtn) {
            cancelBtn.addEventListener('click', function () {
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            });
        }
    })();
</script>

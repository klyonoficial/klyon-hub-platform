@{
    ViewData["Title"] = "Repasses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Transfer>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-arrow-left-right"></i> Repasses</h2>
    <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Resumo -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-primary">
            <div class="card-body">
                <h6 class="card-title text-primary">Total</h6>
                <h4>R$ @(Model != null ? Model.Sum(t => t.Amount).ToString("N2") : "0,00")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-warning">
            <div class="card-body">
                <h6 class="card-title text-warning">Pendentes</h6>
                <h4>R$ @(Model != null ? Model.Where(t => t.Status == TransferStatus.Pending).Sum(t => t.Amount).ToString("N2") : "0,00")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body">
                <h6 class="card-title text-info">Processando</h6>
                <h4>R$ @(Model != null ? Model.Where(t => t.Status == TransferStatus.Processing).Sum(t => t.Amount).ToString("N2") : "0,00")</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-success">
            <div class="card-body">
                <h6 class="card-title text-success">Concluídos</h6>
                <h4>R$ @(Model != null ? Model.Where(t => t.Status == TransferStatus.Completed).Sum(t => t.Amount).ToString("N2") : "0,00")</h4>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-list-check"></i> Histórico de Repasses</h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Valor</th>
                            <th>Status</th>
                            <th>Data Agendada</th>
                            <th>Data Processamento</th>
                            <th>Descrição</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transfer in Model)
                        {
                            <tr>
                                <td>@transfer.Id</td>
                                <td><strong>R$ @transfer.Amount.ToString("N2")</strong></td>
                                <td>
                                    @switch (transfer.Status)
                                    {
                                        case TransferStatus.Pending:
                                            <span class="badge bg-warning">Pendente</span>
                                            break;
                                        case TransferStatus.Processing:
                                            <span class="badge bg-info">Processando</span>
                                            break;
                                        case TransferStatus.Completed:
                                            <span class="badge bg-success">Concluído</span>
                                            break;
                                        case TransferStatus.Failed:
                                            <span class="badge bg-danger">Falhou</span>
                                            break;
                                        case TransferStatus.Cancelled:
                                            <span class="badge bg-secondary">Cancelado</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@transfer.Status</span>
                                            break;
                                    }
                                </td>
                                <td>@transfer.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (transfer.ProcessedAt.HasValue)
                                    {
                                        @transfer.ProcessedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(transfer.Description))
                                    {
                                        @transfer.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    @if (!string.IsNullOrEmpty(transfer.FailureReason))
                                    {
                                        <br><small class="text-danger">Erro: @transfer.FailureReason</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum repasse encontrado.
            </div>
        }
    </div>
</div>

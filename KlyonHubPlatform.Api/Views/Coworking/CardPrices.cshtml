@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData[ViewDataKeys.Title] = "Preços de Venda no Cartão";
    Layout = LayoutPaths.Layout;
    var pendingRequest = Model?.CardPriceChangeRequests?.FirstOrDefault(r => r.Status == CapacityApprovalStatus.Pending);
    var hasPendingRequest = pendingRequest != null;
    var rejectedRequest = Model?.CardPriceChangeRequests?
        .Where(r => r.Status == CapacityApprovalStatus.Rejected && !string.IsNullOrEmpty(r.RejectionReason))
        .OrderByDescending(r => r.ReviewedAt ?? r.UpdatedAt ?? r.CreatedAt)
        .FirstOrDefault();
    var isCardPricesRejected = Model?.CardPricesApprovalStatus == CapacityApprovalStatus.Rejected;
    var hasRejectedWithReason = rejectedRequest != null && isCardPricesRejected;
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

@if (Model == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> Endereço não encontrado.
        <a href="/Parceiro/MyAddresses" class="btn btn-secondary ms-2">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-credit-card"></i> Preços de Venda no Cartão</h2>
    <a href="/Parceiro/MyAddresses" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (hasRejectedWithReason)
{
    <div class="alert alert-danger">
        <i class="bi bi-x-circle-fill"></i> <strong>Preços no cartão reprovados:</strong> Sua última solicitação de alteração foi reprovada pelo administrador.
        <p class="mb-0 mt-2"><strong>Motivo da reprovação:</strong> @rejectedRequest!.RejectionReason</p>
        <p class="mb-0 mt-1 small">Ajuste os valores conforme o feedback e envie novamente para aprovação.</p>
    </div>
}
@if (hasPendingRequest)
{
    <div class="alert alert-warning">
        <i class="bi bi-clock-history"></i> <strong>Solicitação pendente:</strong> Sua alteração de preços está aguardando aprovação administrativa.
        @if (pendingRequest.RequestedCardPrice1x.HasValue || pendingRequest.RequestedCardPriceMonthly.HasValue || pendingRequest.RequestedCardPrice12x.HasValue)
        {
            <span>Valores solicitados: </span>
            @if (pendingRequest.RequestedCardPrice1x.HasValue) { <span class="badge bg-info">1x: R$ @pendingRequest.RequestedCardPrice1x.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span> }
            @if (pendingRequest.RequestedCardPriceMonthly.HasValue) { <span class="badge bg-info">Mensal: R$ @pendingRequest.RequestedCardPriceMonthly.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span> }
            @if (pendingRequest.RequestedCardPrice12x.HasValue) { <span class="badge bg-info">12x: R$ @pendingRequest.RequestedCardPrice12x.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span> }
        }
        <span class="d-block mt-2">Os valores só serão exibidos aos clientes após aprovação do administrador.</span>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Informe os valores que serão exibidos para quem deseja contratar este endereço fiscal. Deixe em branco as opções que não deseja oferecer. <strong>As alterações precisam de aprovação administrativa antes de serem exibidas aos clientes.</strong>
    </div>
}

<div class="card mb-3">
    <div class="card-body">
        <p class="mb-0"><strong>Endereço:</strong> @Model.Address, @Model.Number @(string.IsNullOrEmpty(Model.Complement) ? "" : "- " + Model.Complement) — @Model.Neighborhood, @Model.City/@Model.State</p>
        @if (Model.Location != null)
        {
            <p class="mb-0 mt-1 text-muted"><small>Localidade: @Model.Location.City/@Model.Location.State</small></p>
        }
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-currency-dollar"></i> Valores para venda no cartão</h5>
    </div>
    <div class="card-body">
        <form method="post" action="/Parceiro/CardPrices?id=@Model.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="CardPrice1x" class="form-label">Venda à vista (1x no cartão) — R$</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="CardPrice1x" name="CardPrice1x"
                           value="@((hasPendingRequest ? pendingRequest.RequestedCardPrice1x : Model.CardPrice1x)?.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                           placeholder="Ex: 1200,00" @(hasPendingRequest ? "readonly" : "")>
                    <small class="form-text text-muted">Valor único para pagamento em 1 vez no cartão.</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="CardPriceMonthly" class="form-label">Venda mensal — R$</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="CardPriceMonthly" name="CardPriceMonthly"
                           value="@((hasPendingRequest ? pendingRequest.RequestedCardPriceMonthly : Model.CardPriceMonthly)?.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                           placeholder="Ex: 120,00" @(hasPendingRequest ? "readonly" : "")>
                    <small class="form-text text-muted">Valor da mensalidade no cartão (cobrança recorrente).</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="CardPrice12x" class="form-label">Venda em 12 vezes — R$ (por parcela)</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="CardPrice12x" name="CardPrice12x"
                           value="@((hasPendingRequest ? pendingRequest.RequestedCardPrice12x : Model.CardPrice12x)?.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                           placeholder="Ex: 110,00" @(hasPendingRequest ? "readonly" : "")>
                    <small class="form-text text-muted">Valor de cada parcela (12x no cartão).</small>
                </div>
            </div>

            <hr>
            @if (!hasPendingRequest)
            {
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Enviar para aprovação
                </button>
                <a href="/Parceiro/MyAddresses" class="btn btn-outline-secondary">Cancelar</a>
            }
        </form>
        @if (hasPendingRequest)
        {
            <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> Valores em exibição para clientes atualmente: @(Model.CardPrice1x.HasValue ? $"1x R$ {Model.CardPrice1x:N2}" : "") @(Model.CardPriceMonthly.HasValue ? $"Mensal R$ {Model.CardPriceMonthly:N2}" : "") @(Model.CardPrice12x.HasValue ? $"12x R$ {Model.CardPrice12x:N2}" : "") @(!Model.CardPrice1x.HasValue && !Model.CardPriceMonthly.HasValue && !Model.CardPrice12x.HasValue ? "Nenhum" : "")</p>
        }
    </div>
</div>

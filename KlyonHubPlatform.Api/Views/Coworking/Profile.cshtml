    <script>
        // Função para atualizar apenas a tabela de sócios sem recarregar a página
        function updatePartnersTable() {
            // Fazer requisição para buscar apenas a tabela atualizada
            // Adicionar timestamp para evitar cache
            var timestamp = new Date().getTime();
            fetch('@Url.Action("Profile", "Coworking")?tab=partners&_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                // Criar um elemento temporário para parsear o HTML
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar a tabela de sócios no HTML retornado
                var newTableBody = tempDiv.querySelector('#partnersTableBody');
                var currentTableBody = document.getElementById('partnersTableBody');
                
                if (newTableBody && currentTableBody) {
                    // Atualizar apenas o tbody da tabela
                    currentTableBody.innerHTML = newTableBody.innerHTML;
                    
                    // Forçar atualização das imagens adicionando timestamp para evitar cache
                    var imageTimestamp = new Date().getTime();
                    var images = currentTableBody.querySelectorAll('img[src*="GetPartnerPhoto"]');
                    images.forEach(function(img) {
                        var src = img.src;
                        // Remover timestamp anterior se existir
                        src = src.split('&t=')[0].split('?t=')[0];
                        // Adicionar novo timestamp
                        if (src.indexOf('?') > -1) {
                            img.src = src + '&t=' + imageTimestamp;
                        } else {
                            img.src = src + '?t=' + imageTimestamp;
                        }
                        // Forçar reload da imagem removendo do cache do navegador
                        var newImg = new Image();
                        newImg.onload = function() {
                            img.src = this.src;
                        };
                        newImg.src = img.src;
                    });
                    
                    // Re-inicializar Select2 nos novos elementos se necessário
                    if (typeof window.KlyonAutocomplete !== 'undefined' && window.KlyonAutocomplete.init) {
                        window.KlyonAutocomplete.init();
                    }

                    // Esconder loading após receber a resposta
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }                    
                } else {
                    // Esconder loading mesmo em caso de erro
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    showToast('Erro ao carregar tabela de sócios. Por favor, tente novamente.', 'error');
                }
            })
            .catch(error => {
                // Esconder loading em caso de erro
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                showToast('Erro ao salvar sócios. Por favor, tente novamente.', 'error');
            });
        }

        function updatePartnersPageSize(newSize) {
            window.location.href = '@Url.Action("Profile", "Coworking")?partnersPage=1&partnersPageSize=' + newSize;
        }
        
        function updatePhotosPageSize(newSize) {
            window.location.href = '@Url.Action("Profile", "Coworking")?photosPage=1&photosPageSize=' + newSize;
        }

        // Habilitar/desabilitar campos de horário baseado no checkbox
        function toggleTimeInputs() {
            var checkbox = document.getElementById('blocksFullDay');
            var timeInputs = document.getElementById('timeInputs');
            if (checkbox.checked) {
                timeInputs.style.display = 'none';
                document.getElementById('startTime').value = '';
                document.getElementById('endTime').value = '';
            } else {
                timeInputs.style.display = 'block';
            }
        }

        // Habilitar/desabilitar campos de horário ao marcar/desmarcar dia ativo
        document.querySelectorAll('.day-active-checkbox').forEach(function(checkbox) {
            checkbox.addEventListener('change', function() {
                var day = this.dataset.day;
                var row = this.closest('tr');
                var openingInput = row.querySelector('input[name="OpeningTime_' + day + '"]');
                var closingInput = row.querySelector('input[name="ClosingTime_' + day + '"]');
                
                if (this.checked) {
                    openingInput.disabled = false;
                    closingInput.disabled = false;
                } else {
                    openingInput.disabled = true;
                    closingInput.value = '';
                    closingInput.disabled = true;
                    openingInput.value = '';
                }
            });
        });

        // Inicializar estado dos campos baseado nos checkboxes
        document.querySelectorAll('.day-active-checkbox').forEach(function(checkbox) {
            if (!checkbox.checked) {
                var day = checkbox.dataset.day;
                var row = checkbox.closest('tr');
                var openingInput = row.querySelector('input[name="OpeningTime_' + day + '"]');
                var closingInput = row.querySelector('input[name="ClosingTime_' + day + '"]');
                openingInput.disabled = true;
                closingInput.disabled = true;
            }
        });

        // Habilitar todos os campos de horário antes de submeter o formulário
        // Isso garante que os valores sejam enviados mesmo se os campos estiverem desabilitados
        function enableAllTimeInputs() {
            document.querySelectorAll('input[type="time"]').forEach(function(input) {
                input.disabled = false;
            });
        }
        // Função para excluir sócio com confirmação elegante
        async function handleDeletePartner(form) {
            const confirmed = await showConfirm(
                'Tem certeza que deseja excluir este sócio?',
                'Confirmar Exclusão',
                'danger'
            );
            
            if (confirmed) {
                // Mostrar loading após confirmação
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                    window.KlyonLoading.show();
                }
                
                // Enviar requisição via AJAX
                var formData = new FormData(form);
                var actionUrl = form.action;
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // Marcar que este formulário está fazendo uma requisição AJAX manual
                form.setAttribute('data-ajax-request', 'true');
                
                fetch(actionUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token
                    },
                    redirect: 'manual'
                })
                .then(response => {
                    // Esconder loading após receber a resposta
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    
                    // Remover marcação de requisição AJAX
                    form.removeAttribute('data-ajax-request');
                    
                    if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected) {
                        // Se houve redirect, atualizar apenas a tabela de sócios
                        updatePartnersTable();
                        showToast('Sócio excluído com sucesso!', 'success');
                        return;
                    }
                    
                    if (response.ok) {
                        // Se a resposta foi OK, atualizar apenas a tabela de sócios
                        updatePartnersTable();
                        showToast('Sócio excluído com sucesso!', 'success');
                    } else {
                        // Se houve erro, mostrar mensagem
                        showToast('Erro ao excluir sócio. Por favor, tente novamente.', 'error');
                    }
                })
                .catch(error => {
                    // Esconder loading em caso de erro
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    
                    // Remover marcação de requisição AJAX
                    form.removeAttribute('data-ajax-request');
                    
                    showToast('Erro ao excluir sócio: ' + error.message, 'error');
                    console.error('Erro:', error);
                });
            }
        }

        // Função para excluir bloqueio com confirmação elegante
        async function handleDeleteBlockedDate(form) {

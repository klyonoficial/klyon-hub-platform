        // Função para validar CNPJ
        function validateCNPJ(cnpj) {
            cnpj = cnpj.replace(/[^\d]+/g, '');
            
            if (cnpj.length != 14) return false;
            
            // Eliminar CNPJs conhecidos como inválidos
            if (/^(\d)\1+$/.test(cnpj)) return false;
            
            // Validar dígitos verificadores
            let tamanho = cnpj.length - 2;
            let numeros = cnpj.substring(0, tamanho);
            let digitos = cnpj.substring(tamanho);
            let soma = 0;
            let pos = tamanho - 7;
            
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            
            let resultado = soma % 11 < 2 ? 0 : 11 - soma % 11;
            if (resultado != digitos.charAt(0)) return false;
            
            tamanho = tamanho + 1;
            numeros = cnpj.substring(0, tamanho);
            soma = 0;
            pos = tamanho - 7;
            
            for (let i = tamanho; i >= 1; i--) {
                soma += numeros.charAt(tamanho - i) * pos--;
                if (pos < 2) pos = 9;
            }
            
            resultado = soma % 11 < 2 ? 0 : 11 - soma % 11;
            if (resultado != digitos.charAt(1)) return false;
            
            return true;
        }

        // Validação de CNPJ no formulário básico
        document.addEventListener('DOMContentLoaded', function() {
            const cnpjInput = document.querySelector('#basic #CNPJ');
            const nameInput = document.querySelector('#basic #Name');
            const cnpjError = document.getElementById('cnpjError');
            
            if (cnpjInput) {
                // Validar nome durante a digitação (para garantir checkValidity antes do submit)
                if (nameInput) {
                    nameInput.addEventListener('input', function() {
                        if (!this.value || this.value.trim() === '') {
                            this.setCustomValidity('Nome do Coworking é obrigatório.');
                        } else {
                            this.setCustomValidity('');
                        }
                    });
                }

                // Validar CNPJ durante a digitação (para garantir checkValidity antes do submit)
                cnpjInput.addEventListener('input', function() {
                    const cnpjValue = this.value.replace(/[^\d]+/g, '');
                    if (!cnpjValue) {
                        this.setCustomValidity('');
                    } else if (cnpjValue.length === 14) {
                        if (!validateCNPJ(this.value)) {
                            this.setCustomValidity('CNPJ inválido. Verifique os dígitos.');
                        } else {
                            this.setCustomValidity('');
                        }
                    } else {
                        this.setCustomValidity('CNPJ deve conter 14 dígitos.');
                    }
                });

                // Criar elemento de erro se não existir
                let errorDiv = document.getElementById('cnpjError');
                if (!errorDiv) {
                    errorDiv = document.createElement('div');
                    errorDiv.className = 'invalid-feedback';
                    errorDiv.id = 'cnpjError';
                    cnpjInput.parentElement.appendChild(errorDiv);
                }
                
                // Validar ao sair do campo
                cnpjInput.addEventListener('blur', function() {
                    const cnpjValue = this.value.replace(/[^\d]+/g, '');
                    if (cnpjValue.length === 14) {
                        if (!validateCNPJ(this.value)) {
                            this.classList.add('is-invalid');
                            this.setCustomValidity('CNPJ inválido. Verifique os dígitos.');
                            if (errorDiv) {
                                errorDiv.textContent = 'CNPJ inválido. Verifique os dígitos.';
                            }
                        } else {
                            this.classList.remove('is-invalid');
                            this.classList.add('is-valid');
                            this.setCustomValidity('');
                            if (errorDiv) {
                                errorDiv.textContent = '';
                            }
                        }
                    } else if (cnpjValue.length > 0) {
                        this.classList.add('is-invalid');
                        this.setCustomValidity('CNPJ deve conter 14 dígitos.');
                        if (errorDiv) {
                            errorDiv.textContent = 'CNPJ deve conter 14 dígitos.';
                        }
                    } else {
                        this.setCustomValidity('');
                    }
                });

                // Validar valor inicial vindo do banco (sem interação)
                const initialCnpjValue = cnpjInput.value.replace(/[^\d]+/g, '');
                if (initialCnpjValue) {
                    if (initialCnpjValue.length === 14) {
                        if (!validateCNPJ(cnpjInput.value)) {
                            cnpjInput.classList.add('is-invalid');
                            cnpjInput.setCustomValidity('CNPJ inválido. Verifique os dígitos.');
                            if (errorDiv) {
                                errorDiv.textContent = 'CNPJ inválido. Verifique os dígitos.';
                            }
                        } else {
                            cnpjInput.classList.remove('is-invalid');
                            cnpjInput.setCustomValidity('');
                        }
                    } else {
                        cnpjInput.classList.add('is-invalid');
                        cnpjInput.setCustomValidity('CNPJ deve conter 14 dígitos.');
                        if (errorDiv) {
                            errorDiv.textContent = 'CNPJ deve conter 14 dígitos.';
                        }
                    }
                }
                
                // Validar antes de submeter o formulário básico e aplicar convertFormToAjax apenas se válido
                const basicForm = document.querySelector('#basic form[action*="UpdateProfile"]');
                if (basicForm) {
                    // Aplicar convertFormToAjax ao formulário básico com validação customizada
                    convertFormToAjax(basicForm, {
                        // Apenas mostrar toast, não recarregar
                        onSuccess: function() {
                            if (nameInput && nameInput.value) {
                                const trimmedName = nameInput.value.trim();
                                const userNameLink = document.getElementById('userNameLink');
                                if (userNameLink) {
                                    userNameLink.textContent = trimmedName;
                                }
                                const profileTitle = document.getElementById('coworkingProfileTitle');
                                if (profileTitle) {
                                    profileTitle.innerHTML = '<i class="bi bi-person-badge"></i> Meu Perfil - ' + trimmedName;
                                }
                                // Atualizar campos hidden de outras abas para manter consistência
                                document.querySelectorAll('input[type="hidden"][name="Name"]').forEach(function(hiddenInput) {
                                    hiddenInput.value = trimmedName;
                                });
                            }
                            showToast('Alterações salvas com sucesso!', 'success');
                        },
                        customValidation: function() {
                            let isValid = true;
                            let errorMessage = '';
                            
                            // Validar nome obrigatório
                            if (nameInput && (!nameInput.value || nameInput.value.trim() === '')) {
                                isValid = false;
                                nameInput.classList.add('is-invalid');
                                nameInput.setCustomValidity('Nome do Coworking é obrigatório.');
                                errorMessage = 'Nome do Coworking é obrigatório.';
                            } else if (nameInput) {
                                nameInput.classList.remove('is-invalid');
                                nameInput.setCustomValidity('');
                            }
                            
                            // Validar CNPJ obrigatório
                            const cnpjValue = cnpjInput.value.replace(/[^\d]+/g, '');
                            if (!cnpjInput.value || cnpjValue.length === 0) {
                                isValid = false;
                                cnpjInput.classList.add('is-invalid');
                                cnpjInput.setCustomValidity('CNPJ é obrigatório.');
                                if (errorDiv) {
                                    errorDiv.textContent = 'CNPJ é obrigatório.';
                                }
                                if (!errorMessage) {
                                    errorMessage = 'CNPJ é obrigatório.';
                                }
                            } else if (cnpjValue.length === 14) {
                                if (!validateCNPJ(cnpjInput.value)) {
                                    isValid = false;
                                    cnpjInput.classList.add('is-invalid');
                                    cnpjInput.setCustomValidity('CNPJ inválido. Verifique os dígitos.');
                                    if (errorDiv) {
                                        errorDiv.textContent = 'CNPJ inválido. Verifique os dígitos.';
                                    }
                                    if (!errorMessage) {
                                        errorMessage = 'CNPJ inválido. Verifique os dígitos.';
                                    }
                                } else {
                                    cnpjInput.classList.remove('is-invalid');
                                    cnpjInput.classList.add('is-valid');
                                    cnpjInput.setCustomValidity('');
                                }
                            } else if (cnpjValue.length > 0) {
                                isValid = false;
                                cnpjInput.classList.add('is-invalid');
                                cnpjInput.setCustomValidity('CNPJ deve conter 14 dígitos.');
                                if (errorDiv) {
                                    errorDiv.textContent = 'CNPJ deve conter 14 dígitos.';
                                }
                                if (!errorMessage) {
                                    errorMessage = 'CNPJ deve conter 14 dígitos.';
                                }
                            } else {
                                cnpjInput.setCustomValidity('');
                            }
                            
                            return {
                                isValid: isValid,
                                errorMessage: errorMessage
                            };
                        }
                    });
                }
            }
        });
    </script>


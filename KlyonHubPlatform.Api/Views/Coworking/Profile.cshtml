@{
    ViewData["Title"] = "Meu Perfil - Coworking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonHubPlatform.Domain.Entities.Coworking
@using KlyonHubPlatform.Domain.Core.Enums

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-badge"></i> Meu Perfil - @Model.Name</h2>
    <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.ApprovalStatus == CoworkingApprovalStatus.UnderReview)
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-hourglass-split"></i> <strong>Em análise.</strong> Seu cadastro está sendo analisado. Qualquer alteração feita aqui fará o cadastro retornar para nova análise.
    </div>
}
else if (Model.ApprovalStatus == CoworkingApprovalStatus.AwaitingAdjustment)
{
    <div class="alert alert-secondary mb-4">
        <strong><i class="bi bi-exclamation-diamond"></i> Aguardando ajuste.</strong>
        @if (!string.IsNullOrEmpty(Model.RejectionReason))
        {
            <p class="mb-2 mt-2">Justificativa / itens a corrigir: <span class="text-dark">@Model.RejectionReason</span></p>
        }
        <form method="post" action="@Url.Action("ResubmitForApproval", "Coworking")" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send"></i> Reenviar para análise</button>
        </form>
    </div>
}
else if (Model.ApprovalStatus == CoworkingApprovalStatus.Approved)
{
    <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle"></i> <strong>Cadastro aprovado.</strong> Seu espaço está no marketplace. Ao alterar qualquer informação, o cadastro voltará para análise.
    </div>
}

<!-- Abas -->
<ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">
            <i class="bi bi-info-circle"></i> Dados Básicos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab">
            <i class="bi bi-telephone"></i> Contatos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="address-tab" data-bs-toggle="tab" data-bs-target="#address" type="button" role="tab">
            <i class="bi bi-geo-alt"></i> Endereço
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="bank-tab" data-bs-toggle="tab" data-bs-target="#bank" type="button" role="tab">
            <i class="bi bi-bank"></i> Dados Bancários
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="social-tab" data-bs-toggle="tab" data-bs-target="#social" type="button" role="tab">
            <i class="bi bi-share"></i> Redes Sociais
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="photos-tab" data-bs-toggle="tab" data-bs-target="#photos" type="button" role="tab">
            <i class="bi bi-images"></i> Fotos
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="partners-tab" data-bs-toggle="tab" data-bs-target="#partners" type="button" role="tab">
            <i class="bi bi-people"></i> Sócios
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab">
            <i class="bi bi-file-earmark-text"></i> Documentos Obrigatórios
        </button>
    </li>
</ul>

<div class="tab-content" id="profileTabContent">
    <!-- Dados Básicos -->
    <div class="tab-pane fade show active" id="basic" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <form method="post" action="@Url.Action("UpdateProfile", "Coworking")">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="activeTab" value="basic" />
                    
                    <h5 class="mb-3"><i class="bi bi-building"></i> Informações da Empresa</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Name" class="form-label">Nome do Coworking <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="Name" name="Name" value="@Model.Name" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="CNPJ" class="form-label">CNPJ <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="CNPJ" name="CNPJ" value="@Model.CNPJ" placeholder="00.000.000/0000-00" maxlength="18" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="TradeName" class="form-label">Nome Fantasia</label>
                            <input type="text" class="form-control" id="TradeName" name="TradeName" value="@Model.TradeName">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label for="Description" class="form-label fw-bold">Descrição breve sobre o coworking</label>
                        <textarea class="form-control" id="Description" name="Description" rows="4" placeholder="Conte em poucas linhas o que seu espaço oferece, seu diferencial e o tipo de público que atende. Essa descrição aparecerá para quem visualizar seu perfil.">@Model.Description</textarea>
                        <small class="form-text text-muted"><i class="bi bi-lightbulb"></i> Uma boa descrição ajuda clientes a conhecerem seu espaço antes de entrar em contato.</small>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Salvar Alterações
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Contatos -->
    <div class="tab-pane fade" id="contact" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <form method="post" action="@Url.Action("UpdateProfile", "Coworking")">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="Name" value="@Model.Name" />
                    <input type="hidden" name="CNPJ" value="@Model.CNPJ" />
                    <input type="hidden" name="activeTab" value="contact" />
                    
                    <h5 class="mb-3"><i class="bi bi-telephone"></i> Informações de Contato</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="ContactEmail" class="form-label">Email Principal <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="ContactEmail" name="ContactEmail" value="@Model.ContactEmail" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="SecondaryEmail" class="form-label">Email Secundário</label>
                            <input type="email" class="form-control" id="SecondaryEmail" name="SecondaryEmail" value="@Model.SecondaryEmail">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="ContactPhone" class="form-label">Telefone Principal</label>
                            <input type="text" class="form-control" id="ContactPhone" name="ContactPhone" value="@Model.ContactPhone" placeholder="(00) 00000-0000" maxlength="15">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="SecondaryPhone" class="form-label">Telefone Secundário</label>
                            <input type="text" class="form-control" id="SecondaryPhone" name="SecondaryPhone" value="@Model.SecondaryPhone" placeholder="(00) 00000-0000" maxlength="15">
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Salvar Alterações
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Endereço -->
    <div class="tab-pane fade" id="address" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <form method="post" action="@Url.Action("UpdateProfile", "Coworking")">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="Name" value="@Model.Name" />
                    <input type="hidden" name="CNPJ" value="@Model.CNPJ" />
                    <input type="hidden" name="activeTab" value="address" />
                    
                    <h5 class="mb-3"><i class="bi bi-geo-alt"></i> Endereço da Sede</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label for="AddressZipCode" class="form-label">CEP</label>
                            <input type="text" class="form-control" id="AddressZipCode" name="AddressZipCode" value="@Model.AddressZipCode" placeholder="00000-000" maxlength="9">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Address" class="form-label">Endereço</label>
                            <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="AddressNumber" class="form-label">Número</label>
                            <input type="text" class="form-control" id="AddressNumber" name="AddressNumber" value="@Model.AddressNumber">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="AddressComplement" class="form-label">Complemento</label>
                            <input type="text" class="form-control" id="AddressComplement" name="AddressComplement" value="@Model.AddressComplement">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="AddressNeighborhood" class="form-label">Bairro</label>
                            <input type="text" class="form-control" id="AddressNeighborhood" name="AddressNeighborhood" value="@Model.AddressNeighborhood">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="AddressCity" class="form-label">Cidade</label>
                            <input type="text" class="form-control" id="AddressCity" name="AddressCity" value="@Model.AddressCity">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="AddressState" class="form-label">Estado (UF)</label>
                            <select class="form-select" id="AddressState" name="AddressState">
                                <option value="">Selecione</option>
                                @{
                                    var states = new[] { "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO" };
                                    var stateNames = new[] { "Acre", "Alagoas", "Amapá", "Amazonas", "Bahia", "Ceará", "Distrito Federal", "Espírito Santo", "Goiás", "Maranhão", "Mato Grosso", "Mato Grosso do Sul", "Minas Gerais", "Pará", "Paraíba", "Paraná", "Pernambuco", "Piauí", "Rio de Janeiro", "Rio Grande do Norte", "Rio Grande do Sul", "Rondônia", "Roraima", "Santa Catarina", "São Paulo", "Sergipe", "Tocantins" };
                                }
                                @for (int i = 0; i < states.Length; i++)
                                {
                                    var isSelected = Model.AddressState == states[i];
                                    <option value="@states[i]" selected="@isSelected">@states[i] - @stateNames[i]</option>
                                }
                            </select>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Salvar Alterações
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Dados Bancários -->
    <div class="tab-pane fade" id="bank" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <form method="post" action="@Url.Action("UpdateProfile", "Coworking")">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="Name" value="@Model.Name" />
                    <input type="hidden" name="CNPJ" value="@Model.CNPJ" />
                    <input type="hidden" name="activeTab" value="bank" />
                    
                    <h5 class="mb-3"><i class="bi bi-bank"></i> Dados Bancários para Repasses</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="BankName" class="form-label">Banco</label>
                            <select class="form-select" id="BankName" name="BankName">
                                <option value="">Selecione o banco</option>
                                @{
                                    var banks = KlyonHubPlatform.Domain.Core.Constants.BrazilianBanks.GetBanks();
                                    foreach (var bank in banks.OrderBy(b => b.Value))
                                    {
                                        var isSelected = !string.IsNullOrEmpty(Model.BankName) && 
                                                         (Model.BankName == bank.Key || Model.BankName == bank.Value || 
                                                          Model.BankName.Contains(bank.Value) || Model.BankName.Contains(bank.Key));
                                        <option value="@bank.Key" selected="@isSelected">@bank.Key - @bank.Value</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="BankAgency" class="form-label">Agência</label>
                            <input type="text" class="form-control" id="BankAgency" name="BankAgency" value="@Model.BankAgency">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="BankAccount" class="form-label">Conta</label>
                            <input type="text" class="form-control" id="BankAccount" name="BankAccount" value="@Model.BankAccount">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="BankAccountType" class="form-label">Tipo de Conta</label>
                            <select class="form-select" id="BankAccountType" name="BankAccountType">
                                <option value="">Selecione</option>
                                @{
                                    var isCorrente = Model.BankAccountType == "Corrente";
                                    var isPoupanca = Model.BankAccountType == "Poupança";
                                }
                                <option value="Corrente" selected="@isCorrente">Corrente</option>
                                <option value="Poupança" selected="@isPoupanca">Poupança</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="BankPixKey" class="form-label">Chave PIX</label>
                        <input type="text" class="form-control" id="BankPixKey" name="BankPixKey" value="@Model.BankPixKey" placeholder="CPF, CNPJ, Email, Telefone ou Chave Aleatória">
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Salvar Alterações
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Redes Sociais -->
    <div class="tab-pane fade" id="social" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <form method="post" action="@Url.Action("UpdateProfile", "Coworking")">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="Name" value="@Model.Name" />
                    <input type="hidden" name="CNPJ" value="@Model.CNPJ" />
                    <input type="hidden" name="activeTab" value="social" />
                    
                    <h5 class="mb-3"><i class="bi bi-share"></i> Redes Sociais e Website</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Website" class="form-label">Website</label>
                            <input type="url" class="form-control" id="Website" name="Website" value="@Model.Website" placeholder="https://www.exemplo.com.br">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="Instagram" class="form-label">Instagram</label>
                            <input type="text" class="form-control" id="Instagram" name="Instagram" value="@Model.Instagram" placeholder="usuario ou @@usuario">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="Facebook" class="form-label">Facebook</label>
                            <input type="text" class="form-control" id="Facebook" name="Facebook" value="@Model.Facebook" placeholder="facebook.com/usuario">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="LinkedIn" class="form-label">LinkedIn</label>
                            <input type="text" class="form-control" id="LinkedIn" name="LinkedIn" value="@Model.LinkedIn" placeholder="linkedin.com/company/usuario">
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Salvar Alterações
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Fotos -->
    <div class="tab-pane fade" id="photos" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><i class="bi bi-images"></i> Galeria de Fotos</h5>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#uploadPhotoModal">
                        <i class="bi bi-plus-circle"></i> Adicionar Fotos
                    </button>
                </div>

                @if (Model.Photos != null && Model.Photos.Any())
                {
                    <div class="alert alert-info mb-3">
                        <i class="bi bi-info-circle"></i> 
                        <strong>Foto de Capa:</strong> A foto marcada como "Principal" será exibida para os clientes na página de endereços disponíveis. 
                        Clique no ícone de estrela (<i class="bi bi-star-fill"></i>) para definir uma foto como principal.
                    </div>
                    <div class="row">
                        @foreach (var photo in Model.Photos.OrderByDescending(p => p.IsMain).ThenBy(p => p.DisplayOrder).ThenBy(p => p.CreatedAt))
                        {
                            <div class="col-md-3 mb-3">
                                <div class="card position-relative @(photo.IsMain ? "border-success border-3" : "")">
                                    @if (photo.IsMain)
                                    {
                                        <div class="position-absolute top-0 start-0 m-2">
                                            <span class="badge bg-success fs-6">
                                                <i class="bi bi-star-fill"></i> Foto de Capa
                                            </span>
                                        </div>
                                    }
                                    <img src="@Url.Action("GetPhoto", "Coworking", new { photoId = photo.Id })" 
                                         class="card-img-top" 
                                         alt="@photo.Description" 
                                         style="height: 200px; object-fit: cover; cursor: pointer;"
                                         onclick="viewPhoto(@photo.Id)">
                                    <div class="card-body p-2">
                                        @if (photo.IsMain)
                                        {
                                            <div class="alert alert-success py-1 px-2 mb-2">
                                                <small><i class="bi bi-check-circle"></i> <strong>Esta foto aparece para os clientes</strong></small>
                                            </div>
                                        }
                                        <div class="btn-group btn-group-sm w-100" role="group">
                                            @if (photo.IsMain)
                                            {
                                                <button type="button" class="btn btn-success" disabled title="Foto principal atual">
                                                    <i class="bi bi-star-fill"></i> Principal
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-outline-primary" onclick="setMainPhoto(@photo.Id)" title="Definir como foto de capa (aparece para os clientes)">
                                                    <i class="bi bi-star"></i> Definir como Capa
                                                </button>
                                            }
                                            <button type="button" class="btn btn-outline-danger" onclick="deletePhoto(@photo.Id)" title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhuma foto cadastrada. Clique em "Adicionar Fotos" para começar.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Modal para Upload de Fotos -->
    <div class="modal fade" id="uploadPhotoModal" tabindex="-1" aria-labelledby="uploadPhotoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="uploadPhotoModalLabel">
                        <i class="bi bi-upload"></i> Adicionar Fotos
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="@Url.Action("UploadPhotos", "Coworking")" enctype="multipart/form-data" id="uploadPhotoForm">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="alert alert-info mb-3">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Foto de Capa:</strong> A primeira foto enviada será automaticamente definida como "Foto de Capa" e será exibida para os clientes na página de endereços disponíveis. 
                            Você pode alterar a foto de capa depois clicando no ícone de estrela (<i class="bi bi-star-fill"></i>) na galeria.
                        </div>
                        <div class="mb-3">
                            <label for="Photos" class="form-label">Selecione as fotos (máximo 10)</label>
                            <input type="file" class="form-control" id="Photos" name="Photos" multiple accept="image/*" required>
                            <small class="form-text text-muted">Formatos aceitos: JPG, PNG. Tamanho máximo: 5MB por foto.</small>
                        </div>
                        <div id="photoPreview" class="row"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-upload"></i> Enviar Fotos
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal para Visualizar Foto -->
    <div class="modal fade" id="viewPhotoModal" tabindex="-1" aria-labelledby="viewPhotoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="viewPhotoModalLabel">Visualizar Foto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img id="viewPhotoImg" src="" alt="Foto" class="img-fluid">
                </div>
            </div>
        </div>
    </div>

    <!-- Sócios -->
    <div class="tab-pane fade" id="partners" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Sócios e Parceiros</h5>
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPartnerModal">
                        <i class="bi bi-plus-circle"></i> Adicionar Sócio
                    </button>
                </div>

                @if (Model.Partners != null && Model.Partners.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="width:60px">Foto</th>
                                    <th>Nome</th>
                                    <th>Cargo/Função</th>
                                    <th>Participação</th>
                                    <th>Principal</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var partner in Model.Partners.OrderByDescending(p => p.IsPrincipal).ThenBy(p => p.Name))
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(partner.PhotoPath))
                                            {
                                                <img src="@Url.Action("GetPartnerPhoto", "Coworking", new { partnerId = partner.Id })" alt="" class="rounded-circle" style="width:40px;height:40px;object-fit:cover;">
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:40px;height:40px;"><i class="bi bi-person text-muted"></i></div>
                                            }
                                        </td>
                                        <td><strong>@partner.Name</strong><br><small class="text-muted">@(partner.Email ?? partner.Phone ?? "-")</small></td>
                                        <td>@(partner.Role ?? "-")</td>
                                        <td>@(partner.SharePercentage.HasValue ? $"{partner.SharePercentage.Value:F0}%" : "-")</td>
                                        <td>@if (partner.IsPrincipal) { <span class="badge bg-success"><i class="bi bi-star-fill"></i> Principal</span> } else { <span class="text-muted">-</span> }</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-partner-json='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { Id=partner.Id, Name=partner.Name, CPF=partner.CPF, Email=partner.Email, Phone=partner.Phone, Role=partner.Role, SharePercentage=partner.SharePercentage, IsPrincipal=partner.IsPrincipal, PhotoPath=partner.PhotoPath }))' onclick="editPartnerFromData(this)" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form method="post" action="@Url.Action("DeletePartner", "Coworking")" style="display: inline;" onsubmit="return confirm('Tem certeza que deseja excluir este sócio?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="partnerId" value="@partner.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhum sócio cadastrado. Clique em "Adicionar Sócio" para começar.
                    </div>
                }
            </div>
        </div>
    </div>
    </div>

    <!-- Documentos Obrigatórios -->
    <div class="tab-pane fade" id="documents" role="tabpanel">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-4"><i class="bi bi-file-earmark-text"></i> Documentos Obrigatórios</h5>
                <p class="text-muted mb-4">
                    <i class="bi bi-info-circle"></i> 
                    Os documentos abaixo são obrigatórios para o cadastro do coworking. 
                    Certifique-se de anexar todos os documentos solicitados.
                </p>

                @{
                    var requiredDocuments = new[]
                    {
                        (CoworkingDocumentType.AddressCessionContract, "Contrato de cessão de endereço", "Documento que comprova a cessão do endereço para uso fiscal"),
                        (CoworkingDocumentType.AddressProof, "Comprovante de endereço do coworking", "Conta de água, luz ou IPTU emitido em nome do coworking (últimos 90 dias)"),
                        (CoworkingDocumentType.CNPJCard, "Cartão CNPJ do coworking", "Documento que comprova que o coworking está ativo e possui CNAE compatível"),
                        (CoworkingDocumentType.AddressAuthorization, "Declaração de autorização", "Declaração de autorização de uso de endereço fiscal")
                    };

                    var existingDocuments = Model.Documents?.ToDictionary(d => d.Type) ?? new Dictionary<CoworkingDocumentType, CoworkingDocument>();
                }

                <div class="row">
                    @foreach (var (docType, docName, docDescription) in requiredDocuments)
                    {
                        var existingDoc = existingDocuments.ContainsKey(docType) ? existingDocuments[docType] : null;
                        var hasDocument = existingDoc != null;
                        var isExpired = existingDoc?.ExpiresAt.HasValue == true && existingDoc.ExpiresAt.Value < DateTime.UtcNow;
                        
                        <div class="col-md-6 mb-4">
                            <div class="card @(hasDocument && !isExpired ? "border-success" : "border-warning")">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <h6 class="card-title mb-1">
                                                @if (hasDocument && !isExpired)
                                                {
                                                    <i class="bi bi-check-circle-fill text-success"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-exclamation-circle-fill text-warning"></i>
                                                }
                                                @docName
                                            </h6>
                                            <small class="text-muted">@docDescription</small>
                                        </div>
                                    </div>

                                    @if (hasDocument)
                                    {
                                        <div class="mb-3">
                                            <p class="mb-1">
                                                <strong>Arquivo:</strong> @existingDoc.FileName
                                            </p>
                                            <p class="mb-1">
                                                <strong>Enviado em:</strong> @existingDoc.CreatedAt.ToString("dd/MM/yyyy")
                                            </p>
                                            @if (existingDoc.ExpiresAt.HasValue)
                                            {
                                                <p class="mb-1 @(isExpired ? "text-danger" : "")">
                                                    <strong>Válido até:</strong> @existingDoc.ExpiresAt.Value.ToString("dd/MM/yyyy")
                                                    @if (isExpired)
                                                    {
                                                        <span class="badge bg-danger ms-2">Expirado</span>
                                                    }
                                                </p>
                                            }
                                        </div>
                                        <div class="btn-group w-100">
                                            <a href="@Url.Action("DownloadDocument", "Coworking", new { documentId = existingDoc.Id })" 
                                               class="btn btn-sm btn-outline-primary" target="_blank">
                                                <i class="bi bi-download"></i> Visualizar
                                            </a>
                                        </div>
                                        <form method="post" action="@Url.Action("UploadDocument", "Coworking")" 
                                              enctype="multipart/form-data" class="mt-2 document-upload-form" 
                                              data-doc-type="@((int)docType)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="documentType" value="@((int)docType)">
                                            <div class="mb-2">
                                                <input type="file" class="form-control form-control-sm" 
                                                       name="documentFile" accept=".pdf,.jpg,.jpeg,.png" required>
                                                <small class="text-muted">Formatos aceitos: PDF, JPG, PNG. Tamanho máximo: 10MB</small>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-warning w-100">
                                                <i class="bi bi-upload"></i> Substituir Documento
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="@Url.Action("UploadDocument", "Coworking")" 
                                              enctype="multipart/form-data" class="document-upload-form" 
                                              data-doc-type="@((int)docType)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="documentType" value="@((int)docType)">
                                            <div class="mb-3">
                                                <input type="file" class="form-control form-control-sm" 
                                                       name="documentFile" accept=".pdf,.jpg,.jpeg,.png" required>
                                                <small class="text-muted">Formatos aceitos: PDF, JPG, PNG. Tamanho máximo: 10MB</small>
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-primary w-100">
                                                <i class="bi bi-upload"></i> Enviar Documento
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- Modal para Adicionar/Editar Sócio (fora das abas para abrir corretamente ao editar) -->
    <div class="modal fade" id="addPartnerModal" tabindex="-1" aria-labelledby="addPartnerModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="addPartnerModalLabel">
                        <i class="bi bi-person-plus"></i> <span id="modalTitle">Adicionar Sócio</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" action="@Url.Action("AddPartner", "Coworking")" id="partnerForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" id="partnerId" value="0" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="partnerName" class="form-label">Nome Completo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="partnerName" name="Name" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="partnerCPF" class="form-label">CPF</label>
                                <input type="text" class="form-control" id="partnerCPF" name="CPF" placeholder="000.000.000-00" maxlength="14">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="partnerPhone" class="form-label">Telefone</label>
                                <input type="text" class="form-control" id="partnerPhone" name="Phone" placeholder="(00) 00000-0000" maxlength="15">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="partnerEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="partnerEmail" name="Email" placeholder="email@exemplo.com">
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="partnerRole" class="form-label">Cargo/Função</label>
                                <select class="form-select" id="partnerRole" name="Role">
                                    <option value="">Selecione</option>
                                    <option value="Sócio">Sócio</option>
                                    <option value="Diretor">Diretor</option>
                                    <option value="Gerente">Gerente</option>
                                    <option value="Coordenador">Coordenador</option>
                                    <option value="Administrador">Administrador</option>
                                    <option value="Representante Legal">Representante Legal</option>
                                    <option value="Superintendente">Superintendente</option>
                                    <option value="Contador">Contador</option>
                                    <option value="Sócio-Administrador">Sócio-Administrador</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Outro">Outro</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="partnerShare" class="form-label">Participação (%)</label>
                                <input type="number" class="form-control" id="partnerShare" name="SharePercentage" min="0" max="100" step="0.01" placeholder="0.00" oninput="this.value = Math.max(0, Math.min(100, this.value))">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Foto do sócio</label>
                            <div id="partnerPhotoCurrentWrap" class="mb-2" style="display:none;">
                                <span class="text-muted d-block small">Foto atual:</span>
                                <img id="partnerPhotoCurrent" src="" alt="" class="rounded-circle border" style="width:80px;height:80px;object-fit:cover;">
                            </div>
                            <input type="file" class="form-control" id="partnerPhotoInput" name="partnerPhoto" accept="image/jpeg,image/png,image/gif,image/webp">
                            <div id="partnerPhotoPreviewWrap" class="mt-2" style="display:none;">
                                <span class="text-muted d-block small">Nova foto:</span>
                                <img id="partnerPhotoPreview" src="" alt="" class="rounded-circle border" style="width:80px;height:80px;object-fit:cover;">
                            </div>
                            <small class="form-text text-muted">JPG, PNG, GIF ou WebP. Máx. 5MB.</small>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="IsPrincipal" value="true" id="partnerIsPrincipal">
                            <label class="form-check-label" for="partnerIsPrincipal">Sócio principal (será exibido ao clicar no coworking)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> <span id="modalSubmitText">Adicionar</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        // Preview de fotos ao selecionar
        document.getElementById('Photos')?.addEventListener('change', function(e) {
            const preview = document.getElementById('photoPreview');
            preview.innerHTML = '';
            
            if (e.target.files.length > 0) {
                Array.from(e.target.files).slice(0, 10).forEach((file, index) => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const col = document.createElement('div');
                            col.className = 'col-md-3 mb-2';
                            col.innerHTML = `
                                <div class="card">
                                    <img src="${e.target.result}" class="card-img-top" style="height: 150px; object-fit: cover;">
                                    <div class="card-body p-2">
                                        <small class="text-muted">${file.name}</small>
                                    </div>
                                </div>
                            `;
                            preview.appendChild(col);
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });

        // Visualizar foto
        function viewPhoto(photoId) {
            const img = document.getElementById('viewPhotoImg');
            img.src = '@Url.Action("GetPhoto", "Coworking")?photoId=' + photoId;
            const modal = new bootstrap.Modal(document.getElementById('viewPhotoModal'));
            modal.show();
        }

        // Definir foto como principal
        function setMainPhoto(photoId) {
            if (!confirm('Deseja definir esta foto como foto de capa?\n\nEsta foto será exibida para os clientes na página de endereços disponíveis.')) {
                return;
            }

            // Criar formulário dinamicamente
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("SetMainPhoto", "Coworking")';
            
            // Buscar token anti-forgery
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            
            if (token) {
                const tokenField = document.createElement('input');
                tokenField.type = 'hidden';
                tokenField.name = '__RequestVerificationToken';
                tokenField.value = token;
                form.appendChild(tokenField);
            }
            
            const photoIdInput = document.createElement('input');
            photoIdInput.type = 'hidden';
            photoIdInput.name = 'photoId';
            photoIdInput.value = photoId;
            form.appendChild(photoIdInput);
            
            document.body.appendChild(form);
            form.submit();
        }

        // Deletar foto
        function deletePhoto(photoId) {
            if (!confirm('Tem certeza que deseja excluir esta foto?')) {
                return;
            }

            // Criar formulário dinamicamente
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("DeletePhoto", "Coworking")';
            
            // Buscar token anti-forgery
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            
            if (token) {
                const tokenField = document.createElement('input');
                tokenField.type = 'hidden';
                tokenField.name = '__RequestVerificationToken';
                tokenField.value = token;
                form.appendChild(tokenField);
            }
            
            const photoIdInput = document.createElement('input');
            photoIdInput.type = 'hidden';
            photoIdInput.name = 'photoId';
            photoIdInput.value = photoId;
            form.appendChild(photoIdInput);
            
            document.body.appendChild(form);
            form.submit();
        }

        // Função para aplicar máscara de CPF
        function applyCPFMask(value) {
            if (!value) return '';
            let numbers = value.replace(/\D/g, '');
            if (numbers.length <= 11) {
                numbers = numbers.replace(/(\d{3})(\d)/, '$1.$2');
                numbers = numbers.replace(/(\d{3})(\d)/, '$1.$2');
                numbers = numbers.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
            }
            return numbers;
        }

        // Função para aplicar máscara de Telefone
        function applyPhoneMask(value) {
            if (!value) return '';
            let numbers = value.replace(/\D/g, '');
            if (numbers.length <= 11) {
                if (numbers.length <= 10) {
                    numbers = numbers.replace(/(\d{2})(\d)/, '($1) $2');
                    numbers = numbers.replace(/(\d{4})(\d)/, '$1-$2');
                } else {
                    numbers = numbers.replace(/(\d{2})(\d)/, '($1) $2');
                    numbers = numbers.replace(/(\d{5})(\d)/, '$1-$2');
                }
            }
            return numbers;
        }

        // Função para editar sócio a partir de data-partner-json
        function editPartnerFromData(btn) {
            var raw = btn.getAttribute('data-partner-json');
            if (!raw || raw.trim() === '') {
                console.error('editPartnerFromData: data-partner-json vazio ou não encontrado');
                return;
            }
            var d;
            try { 
                d = JSON.parse(raw); 
            } catch (e) { 
                console.error('editPartnerFromData: JSON inválido', e, 'Raw:', raw); 
                alert('Erro ao carregar dados do sócio. Por favor, recarregue a página.');
                return; 
            }
            var pid = document.getElementById('partnerId');
            var pname = document.getElementById('partnerName');
            if (!pid || !pname) return;
            pid.value = d.Id || 0;
            pname.value = d.Name || '';
            document.getElementById('partnerCPF').value = applyCPFMask(d.CPF || '');
            document.getElementById('partnerEmail').value = d.Email || '';
            document.getElementById('partnerPhone').value = applyPhoneMask(d.Phone || '');
            var share = d.SharePercentage != null && d.SharePercentage !== '' ? parseFloat(d.SharePercentage) : '';
            if (share !== '' && !isNaN(share)) { share = Math.max(0, Math.min(100, share)); share = parseFloat(share.toFixed(2)); }
            document.getElementById('partnerShare').value = share;
            document.getElementById('partnerIsPrincipal').checked = !!d.IsPrincipal;
            // Cargo/Função: select
            var sel = document.getElementById('partnerRole');
            var role = d.Role || '';
            if (role && !Array.from(sel.options).some(function(o) { return o.value === role; })) {
                var opt = document.createElement('option');
                opt.value = role;
                opt.textContent = role;
                sel.appendChild(opt);
            }
            sel.value = role;
            // Foto atual (só em edição com Id e quando existe PhotoPath)
            var wrap = document.getElementById('partnerPhotoCurrentWrap');
            var imgCur = document.getElementById('partnerPhotoCurrent');
            if (d.Id && d.Id > 0 && d.PhotoPath) {
                imgCur.src = '@Url.Action("GetPartnerPhoto", "Coworking")?partnerId=' + d.Id;
                wrap.style.display = 'block';
            } else {
                imgCur.src = '';
                wrap.style.display = 'none';
            }
            document.getElementById('partnerPhotoInput').value = '';
            document.getElementById('partnerPhotoPreviewWrap').style.display = 'none';
            document.getElementById('partnerPhotoPreview').src = '';
            document.getElementById('modalTitle').textContent = 'Editar Sócio';
            document.getElementById('modalSubmitText').textContent = 'Salvar Alterações';
            document.getElementById('partnerForm').action = '@Url.Action("UpdatePartner", "Coworking")';
            var modalEl = document.getElementById('addPartnerModal');
            if (!modalEl) return;
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        // Preview da nova foto ao selecionar arquivo
        document.getElementById('partnerPhotoInput')?.addEventListener('change', function(e) {
            var wrap = document.getElementById('partnerPhotoPreviewWrap');
            var img = document.getElementById('partnerPhotoPreview');
            if (e.target.files && e.target.files[0]) {
                var r = new FileReader();
                r.onload = function(ev) { img.src = ev.target.result; wrap.style.display = 'block'; };
                r.readAsDataURL(e.target.files[0]);
            } else {
                img.src = '';
                wrap.style.display = 'none';
            }
        });

        // Validação de tamanho da foto do sócio (5MB) no submit
        document.getElementById('partnerForm')?.addEventListener('submit', function(e) {
            var fi = document.getElementById('partnerPhotoInput');
            if (fi && fi.files && fi.files[0] && fi.files[0].size > 5 * 1024 * 1024) {
                e.preventDefault();
                alert('A foto não pode exceder 5MB.');
                return false;
            }
        });

        // Validação de participação (não permitir negativo)
        document.getElementById('partnerShare')?.addEventListener('input', function(e) {
            let value = parseFloat(e.target.value);
            if (isNaN(value) || value < 0) {
                e.target.value = '';
            } else if (value > 100) {
                e.target.value = '100';
            }
        });

        // Resetar modal ao fechar
        document.getElementById('addPartnerModal')?.addEventListener('hidden.bs.modal', function() {
            document.getElementById('partnerForm').reset();
            document.getElementById('partnerId').value = '0';
            document.getElementById('modalTitle').textContent = 'Adicionar Sócio';
            document.getElementById('modalSubmitText').textContent = 'Adicionar';
            document.getElementById('partnerForm').action = '@Url.Action("AddPartner", "Coworking")';
            document.getElementById('partnerIsPrincipal').checked = false;
            document.getElementById('partnerRole').value = '';
            var pi = document.getElementById('partnerPhotoInput');
            if (pi) pi.value = '';
            var w = document.getElementById('partnerPhotoCurrentWrap');
            var img = document.getElementById('partnerPhotoCurrent');
            if (w) w.style.display = 'none';
            if (img) img.src = '';
            w = document.getElementById('partnerPhotoPreviewWrap');
            img = document.getElementById('partnerPhotoPreview');
            if (w) w.style.display = 'none';
            if (img) img.src = '';
        });


        // Validação de tamanho de arquivo para documentos
        document.querySelectorAll('.document-upload-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                const fileInput = this.querySelector('input[type="file"]');
                if (fileInput && fileInput.files.length > 0) {
                    const file = fileInput.files[0];
                    if (file.size > 10 * 1024 * 1024) { // 10MB
                        e.preventDefault();
                        alert('O arquivo excede o tamanho máximo de 10MB.');
                        return false;
                    }
                }
            });
        });

        // Validação de tamanho de arquivo
        document.getElementById('uploadPhotoForm')?.addEventListener('submit', function(e) {
            const fileInput = document.getElementById('Photos');
            if (fileInput.files.length > 0) {
                const maxSize = 5 * 1024 * 1024; // 5MB
                const maxFiles = 10;
                
                if (fileInput.files.length > maxFiles) {
                    e.preventDefault();
                    alert(`Você pode enviar no máximo ${maxFiles} fotos por vez.`);
                    return false;
                }

                for (let i = 0; i < fileInput.files.length; i++) {
                    if (fileInput.files[i].size > maxSize) {
                        e.preventDefault();
                        alert(`O arquivo "${fileInput.files[i].name}" é muito grande. Tamanho máximo: 5MB`);
                        return false;
                    }
                }
            }
        });

        // Restaurar aba ativa após salvar
        @if (TempData["ActiveTab"] != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                var activeTab = '@TempData["ActiveTab"]';
                if (activeTab) {
                    // Remover classe active de todas as abas
                    document.querySelectorAll('.nav-link').forEach(function(tab) {
                        tab.classList.remove('active');
                    });
                    document.querySelectorAll('.tab-pane').forEach(function(pane) {
                        pane.classList.remove('show', 'active');
                    });
                    
                    // Ativar a aba correta
                    var tabButton = document.getElementById(activeTab + '-tab');
                    var tabPane = document.getElementById(activeTab);
                    
                    if (tabButton && tabPane) {
                        tabButton.classList.add('active');
                        tabPane.classList.add('show', 'active');
                    }
                }
            });
            </text>
        }
    </script>
}

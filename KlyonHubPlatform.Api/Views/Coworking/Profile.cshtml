                </form>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        // Função genérica para converter formulários para AJAX
        function convertFormToAjax(form, options) {
            // Opções padrão
            var defaults = {
                showLoading: true,
                hideLoading: true,
                onSuccess: null,
                onError: null,
                reloadOnSuccess: false,
                updateElement: null, // ID do elemento a ser atualizado
                customValidation: null // Função de validação customizada que retorna { isValid: boolean, errorMessage: string }
            };
            var config = Object.assign({}, defaults, options || {});
            
            form.addEventListener('submit', function(e) {
                // Executar validação customizada primeiro, se fornecida
                if (config.customValidation && typeof config.customValidation === 'function') {
                    var validationResult = config.customValidation();
                    if (!validationResult.isValid) {
                        e.preventDefault();
                        e.stopPropagation();
                        e.stopImmediatePropagation();
                        showToast(validationResult.errorMessage || 'Por favor, preencha todos os campos obrigatórios corretamente.', 'error');
                        return false;
                    }
                }
                
                // Verificar validação HTML5 antes de prevenir default
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                    form.classList.add('was-validated');
                    // Focar no primeiro campo inválido
                    const firstInvalid = form.querySelector(':invalid');
                    if (firstInvalid) {
                        firstInvalid.focus();
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    return;
                }
                
                e.preventDefault();
                
                // Verificar se há modal de confirmação aberto
                if (typeof window.isConfirmModalOpen === 'function' && window.isConfirmModalOpen()) {
                    return;
                }
                
                // Verificar se o formulário deve ignorar o loading
                if (form.classList.contains('no-loading')) {
                    config.showLoading = false;
                }
                
                // Mostrar loading se configurado
                if (config.showLoading && typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                    window.KlyonLoading.show();
                }
                
                // Preparar dados do formulário
                var formData = new FormData(form);
                var actionUrl = form.action;
                var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // Marcar como requisição AJAX manual
                form.setAttribute('data-ajax-request', 'true');
                
                fetch(actionUrl, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    redirect: 'manual'
                })
                .then(response => {
                    // Esconder loading após receber resposta
                    if (config.hideLoading && typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    
                    // Remover marcação
                    form.removeAttribute('data-ajax-request');
                    
                    // Verificar se a resposta é JSON (erro de validação)
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) {
                        return response.json().then(data => {
                            if (!data.success) {
                                // Erro de validação
                                if (config.onError) {
                                    config.onError(data);
                                } else {
                                    showToast(data.error || 'Erro ao salvar. Por favor, verifique os dados.', 'error');
                                }
                                return;
                            }
                            // Sucesso em JSON
                            if (config.onSuccess) {
                                config.onSuccess(response);
                            } else if (config.reloadOnSuccess) {
                                window.location.reload();
                            } else if (config.updateElement) {
                                updateElementContent(config.updateElement);
                                showToast('Alterações salvas com sucesso!', 'success');
                            } else if (config.updateTable) {
                                config.updateTable();
                                showToast('Alterações salvas com sucesso!', 'success');
                            } else {
                                showToast('Alterações salvas com sucesso!', 'success');
                            }
                        });
                    }
                    
                    if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected) {
                        // Sucesso com redirect
                        if (config.onSuccess) {
                            config.onSuccess(response);
                        } else if (config.reloadOnSuccess) {
                            window.location.reload();
                        } else if (config.updateElement) {
                            updateElementContent(config.updateElement);
                            showToast('Alterações salvas com sucesso!', 'success');
                        } else if (config.updateTable) {
                            config.updateTable();
                            showToast('Alterações salvas com sucesso!', 'success');
                        } else {
                            showToast('Alterações salvas com sucesso!', 'success');
                        }
                        return;
                    }
                    
                    if (response.ok) {
                        // Sucesso
                        if (config.onSuccess) {
                            config.onSuccess(response);
                        } else if (config.reloadOnSuccess) {
                            window.location.reload();
                        } else if (config.updateElement) {
                            updateElementContent(config.updateElement);
                            showToast('Alterações salvas com sucesso!', 'success');
                        } else if (config.updateTable) {
                            config.updateTable();
                            showToast('Alterações salvas com sucesso!', 'success');
                        } else {
                            showToast('Alterações salvas com sucesso!', 'success');
                        }
                    } else {
                        // Erro HTTP
                        if (config.onError) {
                            config.onError(response);
                        } else {
                            showToast('Erro ao salvar. Por favor, tente novamente.', 'error');
                        }
                    }
                })
                .catch(error => {
                    // Esconder loading em caso de erro
                    if (config.hideLoading && typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    
                    // Remover marcação
                    form.removeAttribute('data-ajax-request');
                    
                    if (config.onError) {
                        config.onError(error);
                    } else {
                        showToast('Erro ao processar requisição: ' + error.message, 'error');
                        console.error('Erro:', error);
                    }
                });
            });
        }
        
        // Função auxiliar para atualizar conteúdo de um elemento
        function updateElementContent(elementId) {
            var element = document.getElementById(elementId);
            if (!element) return;
            
            // Fazer requisição para buscar o conteúdo atualizado
            var timestamp = new Date().getTime();
            var url = window.location.href;
            if (url.indexOf('?') > -1) {
                url += '&_=' + timestamp;
            } else {
                url += '?_=' + timestamp;
            }
            
            fetch(url, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                var newElement = tempDiv.querySelector('#' + elementId);
                if (newElement && element) {
                    element.innerHTML = newElement.innerHTML;
                    // Re-inicializar Select2 se necessário
                    if (typeof window.KlyonAutocomplete !== 'undefined' && window.KlyonAutocomplete.init) {
                        window.KlyonAutocomplete.init();
                    }
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar elemento:', error);
                showToast('Erro ao atualizar conteúdo. Por favor, recarregue a página.', 'error');
            });
        }
        
        // Função para atualizar tabela de datas bloqueadas
        function updateBlockedDatesTable() {
            var timestamp = new Date().getTime();
            fetch('@Url.Action("Profile", "Coworking")?tab=hours&_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar a tabela de datas bloqueadas
                var newTableBody = tempDiv.querySelector('#blockedDatesTableBody');
                var currentTableBody = document.getElementById('blockedDatesTableBody');
                
                if (newTableBody && currentTableBody) {
                    // Atualizar apenas o tbody da tabela
                    currentTableBody.innerHTML = newTableBody.innerHTML;
                } else {
                    // Se não encontrou a tabela, atualizar toda a seção de datas bloqueadas
                    var blockedDatesSection = document.querySelector('#hours .table-responsive');
                    var newBlockedDatesSection = tempDiv.querySelector('#hours .table-responsive');
                    if (blockedDatesSection && newBlockedDatesSection) {
                        blockedDatesSection.innerHTML = newBlockedDatesSection.innerHTML;
                    }
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar tabela de datas bloqueadas:', error);
                showToast('Erro ao atualizar tabela. Por favor, recarregue a página.', 'error');
            });
        }
        
        // Função para atualizar galeria de fotos
        function updatePhotosGallery() {
            var timestamp = new Date().getTime();
            fetch('@Url.Action("Profile", "Coworking")?tab=photos&_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar a galeria de fotos
                var newPhotosContainer = tempDiv.querySelector('#photosGallery');
                var currentPhotosContainer = document.getElementById('photosGallery');
                
                if (newPhotosContainer && currentPhotosContainer) {
                    currentPhotosContainer.innerHTML = newPhotosContainer.innerHTML;
                    
                    // Forçar atualização das imagens
                    var imageTimestamp = new Date().getTime();
                    var images = currentPhotosContainer.querySelectorAll('img[src*="GetPhoto"]');
                    images.forEach(function(img) {
                        var src = img.src;
                        src = src.split('&t=')[0].split('?t=')[0];
                        if (src.indexOf('?') > -1) {
                            img.src = src + '&t=' + imageTimestamp;
                        } else {
                            img.src = src + '?t=' + imageTimestamp;
                        }
                    });
                } else {
                    // Se não encontrou, atualizar toda a aba de fotos
                    var photosTab = document.getElementById('photos');
                    var newPhotosTab = tempDiv.querySelector('#photos');
                    if (photosTab && newPhotosTab) {
                        photosTab.innerHTML = newPhotosTab.innerHTML;
                    }
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar galeria de fotos:', error);
                showToast('Erro ao atualizar galeria. Por favor, recarregue a página.', 'error');
            });
        }
        
        // Converter todos os formulários para AJAX quando a página carregar
        document.addEventListener('DOMContentLoaded', function() {
            // Formulários de UpdateProfile (basic, contact, address, bank, social)
            // Não recarregar página, apenas mostrar toast de sucesso
            document.querySelectorAll('form[action*="UpdateProfile"]').forEach(function(form) {
                if (form.id !== 'partnerForm') { // Excluir partnerForm que já tem tratamento especial
                    // Para o formulário básico, não aplicar convertFormToAjax aqui
                    // Será aplicado após a validação customizada ser configurada
                    if (form.closest('#basic')) {
                        return;
                    }
                    convertFormToAjax(form, {
                        // Apenas mostrar toast, não recarregar
                    });
                }
            });
            
            // Formulário ResubmitForApproval - recarregar para atualizar status de aprovação
            document.querySelectorAll('form[action*="ResubmitForApproval"]').forEach(function(form) {
                convertFormToAjax(form, {
                    reloadOnSuccess: true // Precisa recarregar para atualizar status de aprovação
                });
            });
            
            // Formulário SaveOperatingHours - não recarregar, apenas toast
            var operatingHoursForm = document.getElementById('operatingHoursForm');
            if (operatingHoursForm) {
                convertFormToAjax(operatingHoursForm, {
                    // Apenas mostrar toast, não recarregar
                });
            }
            
            // Formulários UploadDocument - não recarregar, apenas toast
            document.querySelectorAll('form.document-upload-form').forEach(function(form) {
                convertFormToAjax(form, {
                    // Apenas mostrar toast, não recarregar
                });
            });
            
            // Formulário UploadPhotos - atualizar galeria de fotos
            var uploadPhotoForm = document.getElementById('uploadPhotoForm');
            if (uploadPhotoForm) {
                uploadPhotoForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    // Mostrar loading
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                        if (typeof window.isConfirmModalOpen === 'function' && !window.isConfirmModalOpen()) {
                            window.KlyonLoading.show();
                        }
                    }
                    
                    var formData = new FormData(this);
                    var actionUrl = this.action;
                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    
                    this.setAttribute('data-ajax-request', 'true');
                    
                    fetch(actionUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token
                        },
                        redirect: 'manual'
                    })
                    .then(response => {
                        if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                            window.KlyonLoading.hide();
                        }
                        
                        this.removeAttribute('data-ajax-request');
                        
                        if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected || response.ok) {
                            // Fechar modal
                            var modalEl = document.getElementById('uploadPhotoModal');
                            if (modalEl) {
                                var modal = bootstrap.Modal.getInstance(modalEl);
                                if (modal) {
                                    modal.hide();
                                }
                            }
                            // Atualizar galeria de fotos
                            updatePhotosGallery();
                            showToast('Fotos enviadas com sucesso!', 'success');
                        } else {
                            showToast('Erro ao enviar fotos. Por favor, tente novamente.', 'error');
                        }
                    })
                    .catch(error => {
                        if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                            window.KlyonLoading.hide();
                        }
                        this.removeAttribute('data-ajax-request');
                        showToast('Erro ao enviar fotos: ' + error.message, 'error');
                        console.error('Erro:', error);
                    });
                });
            }
            
            // Formulário AddBlockedDate - atualizar tabela de datas bloqueadas
            var addBlockedDateForm = document.querySelector('form[action*="AddBlockedDate"]');
            if (addBlockedDateForm) {
                addBlockedDateForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    
                    // Mostrar loading
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                        if (typeof window.isConfirmModalOpen === 'function' && !window.isConfirmModalOpen()) {
                            window.KlyonLoading.show();
                        }
                    }
                    
                    var formData = new FormData(this);
                    var actionUrl = this.action;
                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    
                    this.setAttribute('data-ajax-request', 'true');
                    
                    fetch(actionUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token
                        },
                        redirect: 'manual'
                    })
                    .then(response => {
                        if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                            window.KlyonLoading.hide();
                        }
                        
                        this.removeAttribute('data-ajax-request');
                        
                        if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected || response.ok) {
                            // Fechar modal
                            var modalEl = document.getElementById('addBlockedDateModal');
                            if (modalEl) {
                                var modal = bootstrap.Modal.getInstance(modalEl);
                                if (modal) {
                                    modal.hide();
                                }
                            }
                            // Resetar formulário
                            this.reset();
                            // Atualizar tabela de datas bloqueadas
                            updateBlockedDatesTable();
                            showToast('Data bloqueada adicionada com sucesso!', 'success');
                        } else {
                            showToast('Erro ao adicionar data bloqueada. Por favor, tente novamente.', 'error');
                        }
                    })
                    .catch(error => {
                        if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                            window.KlyonLoading.hide();
                        }
                        this.removeAttribute('data-ajax-request');
                        showToast('Erro ao adicionar data bloqueada: ' + error.message, 'error');
                        console.error('Erro:', error);
                    });
                });
            }
        });

        // Preview de fotos ao selecionar
        document.getElementById('Photos')?.addEventListener('change', function(e) {
            const preview = document.getElementById('photoPreview');
            preview.innerHTML = '';
            
            if (e.target.files.length > 0) {
                const files = Array.from(e.target.files).filter(function(f) { return f.type.startsWith('image/'); });
                if (files.length === 0) return;
                preview.innerHTML = '<div class="col-12 text-center py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div><span class="text-muted">Carregando preview…</span></div>';
                var loaded = 0;
                function maybeClearLoading() {
                    loaded++;
                    if (loaded === files.length) {
                        var loading = preview.querySelector('.spinner-border');
                        if (loading && loading.closest('.col-12')) loading.closest('.col-12').remove();
                    }
                }
                files.slice(0, 10).forEach(function(file) {
                    var reader = new FileReader();
                    reader.onload = function(ev) {
                        var col = document.createElement('div');
                        col.className = 'col-md-3 mb-2';
                        col.innerHTML = '<div class="card"><img src="' + ev.target.result + '" class="card-img-top" style="height: 150px; object-fit: cover;"><div class="card-body p-2"><small class="text-muted">' + (file.name || '') + '</small></div></div>';
                        preview.appendChild(col);
                        maybeClearLoading();
                    };
                    reader.onerror = maybeClearLoading;
                    reader.readAsDataURL(file);
                });
            }
        });

        // Visualizar foto
        function viewPhoto(photoId) {
            const img = document.getElementById('viewPhotoImg');
            img.src = '@Url.Action("GetPhoto", "Coworking")?photoId=' + photoId;
            const modal = new bootstrap.Modal(document.getElementById('viewPhotoModal'));
            modal.show();
        }

        // Definir foto como principal
        async function setMainPhoto(photoId) {
            const confirmed = await showConfirm(
                'Deseja definir esta foto como foto de capa?\n\nEsta foto será exibida para os clientes na página de endereços disponíveis.',
                'Definir Foto de Capa',
                'info'
            );
            
            if (!confirmed) {
                return;
            }

            // Mostrar loading após confirmação
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                window.KlyonLoading.show();
            }
            
            // Buscar token anti-forgery
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            
            // Criar FormData
            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('photoId', photoId);
            
            fetch('@Url.Action("SetMainPhoto", "Coworking")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                redirect: 'manual'
            })
            .then(response => {
                // Esconder loading após receber resposta
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected || response.ok) {
                    // Atualizar galeria de fotos
                    updatePhotosGallery();
                    showToast('Foto de capa definida com sucesso!', 'success');
                } else {
                    showToast('Erro ao definir foto de capa. Por favor, tente novamente.', 'error');
                }
            })
            .catch(error => {
                // Esconder loading em caso de erro
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                showToast('Erro ao definir foto de capa: ' + error.message, 'error');
                console.error('Erro:', error);
            });
        }

        // Deletar foto
        async function deletePhoto(photoId) {
            const confirmed = await showConfirm(
                'Tem certeza que deseja excluir esta foto?',
                'Confirmar Exclusão',
                'danger'
            );
            
            if (!confirmed) {
                return;
            }

            // Mostrar loading após confirmação
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                window.KlyonLoading.show();
            }
            
            // Buscar token anti-forgery
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            
            // Criar FormData
            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('photoId', photoId);
            
            fetch('@Url.Action("DeletePhoto", "Coworking")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                redirect: 'manual'
            })
            .then(response => {
                // Esconder loading após receber resposta
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected || response.ok) {
                    // Atualizar galeria de fotos
                    updatePhotosGallery();
                    showToast('Foto excluída com sucesso!', 'success');
                } else {
                    showToast('Erro ao excluir foto. Por favor, tente novamente.', 'error');
                }
            })
            .catch(error => {
                // Esconder loading em caso de erro
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                showToast('Erro ao excluir foto: ' + error.message, 'error');
                console.error('Erro:', error);
            });
        }

        // Função para aplicar máscara de CPF
        function applyCPFMask(value) {
            if (!value) return '';
            let numbers = value.replace(/\D/g, '');
            if (numbers.length <= 11) {
                numbers = numbers.replace(/(\d{3})(\d)/, '$1.$2');
                numbers = numbers.replace(/(\d{3})(\d)/, '$1.$2');
                numbers = numbers.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
            }
            return numbers;
        }

        // Função para aplicar máscara de Telefone
        function applyPhoneMask(value) {
            if (!value) return '';
            let numbers = value.replace(/\D/g, '');
            if (numbers.length <= 11) {
                if (numbers.length <= 10) {
                    numbers = numbers.replace(/(\d{2})(\d)/, '($1) $2');
                    numbers = numbers.replace(/(\d{4})(\d)/, '$1-$2');
                } else {
                    numbers = numbers.replace(/(\d{2})(\d)/, '($1) $2');
                    numbers = numbers.replace(/(\d{5})(\d)/, '$1-$2');
                }
            }
            return numbers;
        }

        // CEP - Endereço da Sede: máscara e busca ViaCEP
        function formatarCEP(val) {
            if (!val) return '';
            val = val.replace(/\D/g, '');
            if (val.length > 5) return val.substring(0, 5) + '-' + val.substring(5, 8);
            return val;
        }
        function onlyNumbersCEP(event) {
            const ch = event.which || event.keyCode;
            if ((ch >= 48 && ch <= 57) || ch === 8 || ch === 9) return true;
            event.preventDefault();
            return false;
        }
        document.getElementById('AddressZipCode')?.addEventListener('input', function(e) {
            e.target.value = formatarCEP(e.target.value);
        });
        async function buscarCEPProfile(cep) {
            cep = (cep || '').replace(/\D/g, '');
            if (cep.length !== 8) return;
            try {
                const r = await fetch('https://viacep.com.br/ws/' + cep + '/json/');
                const data = await r.json();
                if (!data.erro) {
                    var addr = document.getElementById('Address');
                    var neigh = document.getElementById('AddressNeighborhood');
                    var city = document.getElementById('AddressCity');
                    var state = document.getElementById('AddressState');
                    if (addr) addr.value = data.logradouro || '';
                    if (neigh) neigh.value = data.bairro || '';
                    if (city) city.value = data.localidade || '';
                    if (state) state.value = data.uf || '';
                } else {
                    showToast('CEP não encontrado. Preencha os dados manualmente.', 'warning');
                }
            } catch (err) {
                console.error('Erro ao buscar CEP:', err);
                showToast('Erro ao buscar CEP. Preencha os dados manualmente.', 'error');
            }
        }

        // Função para editar sócio a partir de data-partner-json
        function editPartnerFromData(btn) {
            var raw = btn.getAttribute('data-partner-json');
            if (!raw || raw.trim() === '') {
                console.error('editPartnerFromData: data-partner-json vazio ou não encontrado');
                return;
            }
            var d;
            try { 
                d = JSON.parse(raw); 
            } catch (e) { 
                console.error('editPartnerFromData: JSON inválido', e, 'Raw:', raw); 
                showToast('Erro ao carregar dados do sócio. Por favor, recarregue a página.', 'error');
                return; 
            }
            var pid = document.getElementById('partnerId');
            var pname = document.getElementById('partnerName');
            if (!pid || !pname) return;
            pid.value = d.Id || 0;
            pname.value = d.Name || '';
            document.getElementById('partnerCPF').value = applyCPFMask(d.CPF || '');
            document.getElementById('partnerEmail').value = d.Email || '';
            document.getElementById('partnerPhone').value = applyPhoneMask(d.Phone || '');
            var share = d.SharePercentage != null && d.SharePercentage !== '' ? parseFloat(d.SharePercentage) : '';
            if (share !== '' && !isNaN(share)) { 
                share = Math.max(0, Math.min(100, share)); 
                share = share.toFixed(2).replace('.', ','); // Formatar com vírgula (formato brasileiro)
            }
            document.getElementById('partnerShare').value = share;
            document.getElementById('partnerIsPrincipal').checked = !!d.IsPrincipal;
            document.getElementById('partnerIsContractSigner').checked = !!d.IsContractSigner;
            // Cargo/Função: select
            var sel = document.getElementById('partnerRole');
            var role = d.Role || '';
            if (role && !Array.from(sel.options).some(function(o) { return o.value === role; })) {
                var opt = document.createElement('option');
                opt.value = role;
                opt.textContent = role;
                sel.appendChild(opt);
            }
            sel.value = role;
            
            // Atualizar Select2 se estiver inicializado
            if ($(sel).hasClass('select2-hidden-accessible')) {
                $(sel).trigger('change.select2');
            }
            // Foto atual (só em edição com Id e quando existe PhotoPath)
            var wrap = document.getElementById('partnerPhotoCurrentWrap');
            var imgCur = document.getElementById('partnerPhotoCurrent');
            if (d.Id && d.Id > 0 && d.PhotoPath) {
                // Adicionar timestamp para forçar atualização da imagem e evitar cache
                var photoTimestamp = new Date().getTime();
                imgCur.src = '@Url.Action("GetPartnerPhoto", "Coworking")?partnerId=' + d.Id + '&t=' + photoTimestamp;
                wrap.style.display = 'block';
                // Forçar reload da imagem para garantir que a versão mais recente seja exibida
                var newImg = new Image();
                newImg.onload = function() {
                    imgCur.src = this.src;
                };
                newImg.onerror = function() {
                    // Se falhar, tentar sem timestamp
                    imgCur.src = '@Url.Action("GetPartnerPhoto", "Coworking")?partnerId=' + d.Id;
                };
                newImg.src = imgCur.src;
            } else {
                imgCur.src = '';
                wrap.style.display = 'none';
            }
            document.getElementById('partnerPhotoInput').value = '';
            document.getElementById('partnerPhotoPreviewWrap').style.display = 'none';
            document.getElementById('partnerPhotoPreview').src = '';
            document.getElementById('modalTitle').textContent = 'Editar Sócio';
            document.getElementById('modalSubmitText').textContent = 'Salvar Alterações';
            document.getElementById('partnerForm').action = '@Url.Action("UpdatePartner", "Coworking")';
            var modalEl = document.getElementById('addPartnerModal');
            if (!modalEl) return;
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            
            // Aguardar o modal ser exibido antes de atualizar Select2
            modalEl.addEventListener('shown.bs.modal', function() {
                // Atualizar Select2 após o modal ser exibido
                var roleSelect = document.getElementById('partnerRole');
                if (roleSelect && $(roleSelect).hasClass('select2-hidden-accessible')) {
                    $(roleSelect).trigger('change.select2');
                }
            }, { once: true });
            
            modal.show();
        }

        // Preview da nova foto ao selecionar arquivo
        document.getElementById('partnerPhotoInput')?.addEventListener('change', function(e) {
            var wrap = document.getElementById('partnerPhotoPreviewWrap');
            var img = document.getElementById('partnerPhotoPreview');
            if (e.target.files && e.target.files[0]) {
                var r = new FileReader();
                r.onload = function(ev) { img.src = ev.target.result; wrap.style.display = 'block'; };
                r.readAsDataURL(e.target.files[0]);
            } else {
                img.src = '';
                wrap.style.display = 'none';
            }
        });

        // Validação de tamanho da foto do sócio no submit
        document.getElementById('partnerForm')?.addEventListener('submit', function(e) {
            e.preventDefault(); // Sempre prevenir submit padrão para usar AJAX
            
            // PRIMEIRA COISA: Mostrar loading ANTES de qualquer validação ou processamento
            // O loading só será exibido se não houver modal de confirmação aberto
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                // Verificar se não há modal de confirmação aberto antes de mostrar loading
                if (typeof window.isConfirmModalOpen === 'function' && !window.isConfirmModalOpen()) {
                    // Mostrar loading de forma síncrona e forçada
                    window.KlyonLoading.show();
                    // Forçar reflow para garantir que o loading apareça antes do submit
                    var overlay = document.getElementById('klyon-loading-overlay');
                    if (overlay) {
                        void overlay.offsetHeight;
                        void overlay.offsetWidth;
                    }
                }
            }
            
            // Fazer a validação
            var fi = document.getElementById('partnerPhotoInput');
            var maxPhotoMb = @(ViewBag.MaxPhotoSizeMB ?? 5);
            var maxSize = maxPhotoMb * 1024 * 1024;
            if (fi && fi.files && fi.files[0] && fi.files[0].size > maxSize) {
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                debugger;
                showToast('A foto não pode exceder ' + maxPhotoMb + 'MB.', 'warning');
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                return false;
            }
            
            // Se passou na validação, enviar via AJAX
            var form = this;
            // Converter vírgula para ponto no campo de participação antes de criar FormData
            let shareInput = document.getElementById('partnerShare');
            if (shareInput && shareInput.value) {
                shareInput.value = shareInput.value.replace(',', '.');
            }
            
            var formData = new FormData(form);
            var actionUrl = form.action;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Marcar que este formulário está fazendo uma requisição AJAX manual
            // Isso evita que o interceptor de fetch gerencie o loading automaticamente
            form.setAttribute('data-ajax-request', 'true');
            
            fetch(actionUrl, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                // Não seguir redirects automaticamente para poder processar a resposta
                redirect: 'manual'
            })
            .then(response => {         
                debugger;      
                // Remover marcação de requisição AJAX
                form.removeAttribute('data-ajax-request');
                
                if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected) {
                    // Se houve redirect, atualizar apenas a tabela de sócios
                    updatePartnersTable();
                    // Fechar o modal
                    var modalEl = document.getElementById('addPartnerModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) {
                            modal.hide();
                        }
                    }

                    showToast('Sócio salvo com sucesso!', 'success');
                    return;
                }
                
                if (response.ok) {
                    // Se a resposta foi OK, atualizar apenas a tabela de sócios
                    updatePartnersTable();
                    // Fechar o modal
                    var modalEl = document.getElementById('addPartnerModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) {
                            modal.hide();
                        }
                    }
                    showToast('Sócio salvo com sucesso!', 'success');
                } else {
                    // Se houve erro, mostrar mensagem
                    showToast('Erro ao salvar sócio. Por favor, tente novamente.', 'error');
                }
            })
            .catch(error => {
                // Esconder loading em caso de erro
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                // Remover marcação de requisição AJAX
                form.removeAttribute('data-ajax-request');
                
                showToast('Erro ao salvar sócio: ' + error.message, 'error');
                console.error('Erro:', error);
            });
        });

        // Validação de participação (aceita decimais com vírgula ou ponto, até 2 casas decimais)
        document.getElementById('partnerShare')?.addEventListener('input', function(e) {
            let input = e.target.value;
            // Substituir vírgula por ponto para validação
            let normalized = input.replace(',', '.');
            let value = parseFloat(normalized);
            
            // Permitir apenas números, vírgula ou ponto, e no máximo 2 casas decimais
            let regex = /^[0-9]+([,\.][0-9]{0,2})?$/;
            if (input && !regex.test(input)) {
                // Remover caracteres inválidos
                e.target.value = input.replace(/[^0-9,\.]/g, '');
                return;
            }
            
            // Validar range (0 a 100)
            if (input && !isNaN(value)) {
                if (value < 0) {
                    e.target.value = '0';
                } else if (value > 100) {
                    e.target.value = '100';
                } else {
                    // Manter o formato original (vírgula ou ponto)
                    if (input.includes(',')) {
                        // Limitar a 2 casas decimais
                        let parts = input.split(',');
                        if (parts[1] && parts[1].length > 2) {
                            e.target.value = parts[0] + ',' + parts[1].substring(0, 2);
                        }
                    } else if (input.includes('.')) {
                        // Limitar a 2 casas decimais
                        let parts = input.split('.');
                        if (parts[1] && parts[1].length > 2) {
                            e.target.value = parts[0] + '.' + parts[1].substring(0, 2);
                        }
                    }
                }
            }
        });
        

        // Resetar modal ao fechar
        document.getElementById('addPartnerModal')?.addEventListener('hidden.bs.modal', function() {
            document.getElementById('partnerForm').reset();
            document.getElementById('partnerId').value = '0';
            document.getElementById('modalTitle').textContent = 'Adicionar Sócio';
            document.getElementById('modalSubmitText').textContent = 'Adicionar';
            document.getElementById('partnerForm').action = '@Url.Action("AddPartner", "Coworking")';
            document.getElementById('partnerIsPrincipal').checked = false;
            document.getElementById('partnerRole').value = '';
            var pi = document.getElementById('partnerPhotoInput');
            if (pi) pi.value = '';
            var w = document.getElementById('partnerPhotoCurrentWrap');
            var img = document.getElementById('partnerPhotoCurrent');
            if (w) w.style.display = 'none';
            if (img) img.src = '';
            w = document.getElementById('partnerPhotoPreviewWrap');
            img = document.getElementById('partnerPhotoPreview');
            if (w) w.style.display = 'none';
            if (img) img.src = '';
        });


        // Validação de tamanho de arquivo para documentos
        document.querySelectorAll('.document-upload-form').forEach(form => {
            form.addEventListener('submit', function(e) {
                const fileInput = this.querySelector('input[type="file"]');
                if (fileInput && fileInput.files.length > 0) {
                    const file = fileInput.files[0];
                    if (file.size > 10 * 1024 * 1024) { // 10MB
                        e.preventDefault();
                        showToast('O arquivo excede o tamanho máximo de 10MB.', 'warning');
                        return false;
                    }
                }
            });
        });

        // Validação de tamanho de arquivo (galeria)
        document.getElementById('uploadPhotoForm')?.addEventListener('submit', function(e) {
            const fileInput = document.getElementById('Photos');
            function hideUploadLoading() {
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
            }
            if (fileInput.files.length > 0) {
                const maxPhotoMb = @(ViewBag.MaxPhotoSizeMB ?? 5);
                const maxSize = maxPhotoMb * 1024 * 1024;
                const maxTotalPhotos = 2;
                const existingPhotosCount = @(ViewBag.PhotosTotalItems ?? 0);
                const maxFilesToAdd = maxTotalPhotos - existingPhotosCount;
                
                if (maxFilesToAdd <= 0) {
                    e.preventDefault();
                    setTimeout(hideUploadLoading, 0);
                    showToast(`Você já atingiu o limite máximo de ${maxTotalPhotos} fotos. Remova uma foto antes de adicionar outra.`, 'warning');
                    return false;
                }
                
                if (fileInput.files.length > maxFilesToAdd) {
                    e.preventDefault();
                    setTimeout(hideUploadLoading, 0);
                    showToast(`Você pode adicionar no máximo ${maxFilesToAdd} foto(s). Você já possui ${existingPhotosCount} foto(s) de um total de ${maxTotalPhotos} permitidas.`, 'warning');
                    return false;
                }

                for (let i = 0; i < fileInput.files.length; i++) {
                    if (fileInput.files[i].size > maxSize) {
                        e.preventDefault();
                        setTimeout(hideUploadLoading, 0);
                        showToast(`O arquivo "${fileInput.files[i].name}" é muito grande. Tamanho máximo: ${maxPhotoMb}MB`, 'warning');
                        return false;
                    }
                }
            }
        });

        // Garantir que a primeira aba seja exibida ao carregar a página
        document.addEventListener('DOMContentLoaded', function() {
            // Restaurar aba ativa após salvar
            @if (TempData["ActiveTab"] != null)
            {
                <text>
                var activeTab = '@TempData["ActiveTab"]';
                if (activeTab) {
                    // Aguardar um pouco para garantir que o DOM está pronto
                    setTimeout(function() {
                        // Remover classe active de todas as abas
                        document.querySelectorAll('.nav-link').forEach(function(tab) {
                            tab.classList.remove('active');
                        });
                        document.querySelectorAll('.tab-pane').forEach(function(pane) {
                            pane.classList.remove('show', 'active');
                        });
                        
                        // Ativar a aba correta usando Bootstrap
                        var tabButton = document.getElementById(activeTab + '-tab');
                        var tabPane = document.getElementById(activeTab);
                        
                        if (tabButton && tabPane) {
                            // Usar Bootstrap para ativar a aba corretamente
                            var tab = new bootstrap.Tab(tabButton);
                            tab.show();
                            
                            // Scroll suave para a aba após um pequeno delay
                            setTimeout(function() {
                                tabButton.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                
                                // Destacar visualmente a mensagem de sucesso se existir
                                var successAlert = document.querySelector('.alert-success');
                                if (successAlert) {
                                    successAlert.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                    successAlert.style.animation = 'pulse 0.5s ease-in-out';
                                }
                            }, 200);
                        }
                    }, 150);
                }
                </text>
            }
            else
            {
                <text>
                // Garantir que a primeira aba (Dados Básicos) esteja visível
                var firstTab = document.getElementById('basic-tab');
                var firstPane = document.getElementById('basic');
                if (firstTab && firstPane) {
                    firstTab.classList.add('active');
                    firstPane.classList.add('show', 'active');
                }
                </text>
            }
        });
    </script>
    
    <!-- Modal para Adicionar Data Bloqueada -->

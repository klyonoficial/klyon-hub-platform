@{
    ViewData["Title"] = "Ajustar Quantidade de Contratos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

@if (Model == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> Endereço não encontrado.
        <a href="/Parceiro/MyAddresses" class="btn btn-secondary ms-2">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Ajustar Quantidade de Contratos</h2>
    <a href="/Parceiro/MyAddresses" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i> <strong>Atenção:</strong> Você está ajustando a quantidade máxima de contratos para o endereço <strong>@Model.Address, @Model.City/@Model.State</strong>. 
    O novo valor deve ser pelo menos <strong>20% maior</strong> que o valor atual e será enviado para aprovação do administrador.
</div>

<div class="card">
    <div class="card-body">
        <form method="post" action="/Parceiro/EditMaxContracts?id=@Model.Id">
            @Html.AntiForgeryToken()
            
            <!-- Informações do Endereço (somente leitura) -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <h5 class="mb-3">Informações do Endereço</h5>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Endereço</label>
                    <div class="form-control-plaintext">@Model.Address, @Model.Number</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Cidade/Estado</label>
                    <div class="form-control-plaintext">@Model.City/@Model.State</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Localidade</label>
                    <div class="form-control-plaintext">
                        @if (Model.Location != null)
                        {
                            @($"{Model.Location.City}/{Model.Location.State}")
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Preço Base</label>
                    <div class="form-control-plaintext">R$ @Model.BasePrice.ToString(NumberFormatConstants.TwoDecimals)</div>
                </div>
            </div>

            <hr class="my-4">

            <!-- Informações de Contratos -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <h5 class="mb-3">Informações de Contratos</h5>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Contratos Ativos</label>
                    <div class="input-group">
                        <input type="number" class="form-control" value="@Model.CurrentContracts" readonly>
                        <span class="input-group-text">
                            <i class="bi bi-people"></i>
                        </span>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Quantidade Máxima Atual</label>
                    <div class="input-group">
                        <input type="number" class="form-control" value="@Model.MaxContracts" readonly id="currentMaxContracts">
                        <span class="input-group-text">
                            <i class="bi bi-check-circle text-success"></i>
                        </span>
                    </div>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Nova Quantidade Máxima</label>
                    <input type="number" class="form-control" id="MaxContracts" name="maxContracts" 
                           value="@Model.MaxContracts" min="@Model.CurrentContracts" required>
                    <small class="form-text text-muted">
                        Mínimo: @Model.CurrentContracts (contratos ativos)<br>
                        Mínimo recomendado: <span id="minRecommended">@((int)Math.Ceiling(Model.MaxContracts * 1.2m))</span> (20% maior que o atual)
                    </small>
                </div>
            </div>

            @{
                var hasPendingRequest = Model.MaxContractsApprovalStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending;
            }
            @if (hasPendingRequest)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-clock-history"></i> <strong>Solicitação pendente:</strong> Você já solicitou alteração da quantidade máxima para <strong>@Model.RequestedMaxContracts</strong>. Aguardando aprovação administrativa.
                </div>
            }

            <div class="row mb-3">
                <div class="col-md-12">
                    <label for="justification" class="form-label">Justificativa <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="justification" name="justification" rows="4" 
                              placeholder="Explique o motivo da solicitação de alteração da quantidade máxima de contratos..." 
                              required @(hasPendingRequest ? "readonly" : "")>@(Model.MaxContractsChangeRequests?.FirstOrDefault(r => r.Status == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending)?.Justification)</textarea>
                    <small class="form-text text-muted">Obrigatório ao solicitar alteração</small>
                </div>
            </div>

            @if (!hasPendingRequest)
            {
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-send"></i> Enviar Solicitação para Aprovação
                </button>
            }
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const currentMaxContracts = parseInt(document.getElementById('currentMaxContracts').value);
    const maxContractsInput = document.getElementById('MaxContracts');
    const minRecommended = document.getElementById('minRecommended');
    
    // Calcular mínimo recomendado (20% maior)
    const minRequired = Math.ceil(currentMaxContracts * 1.2);
    
    // Atualizar o mínimo recomendado
    minRecommended.textContent = minRequired;
    
    // Validar valor mínimo
    maxContractsInput.addEventListener('input', function(e) {
        const value = parseInt(e.target.value);
        const currentContracts = @Model.CurrentContracts;
        
        if (value < currentContracts) {
            e.target.setCustomValidity('O máximo de contratos não pode ser menor que ' + currentContracts + ' (contratos ativos).');
        } else if (value < minRequired) {
            e.target.setCustomValidity('O novo valor deve ser pelo menos 20% maior que o valor atual (' + minRequired + ').');
        } else {
            e.target.setCustomValidity('');
        }
    });

    // Validar antes de enviar o formulário
    var form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const maxContracts = parseInt(maxContractsInput.value);
            const currentContracts = @Model.CurrentContracts;
            
            if (maxContracts < currentContracts) {
                e.preventDefault();
                showToast('O máximo de contratos não pode ser menor que ' + currentContracts + '.', 'warning');
                maxContractsInput.focus();
                return false;
            }

            if (maxContracts < minRequired) {
                e.preventDefault();
                showToast('O novo valor deve ser pelo menos 20% maior que o valor atual (' + minRequired + ').', 'warning');
                maxContractsInput.focus();
                return false;
            }

            const justification = document.getElementById('justification').value.trim();
            if (!justification) {
                e.preventDefault();
                showToast('Por favor, informe a justificativa para a alteração.', 'warning');
                document.getElementById('justification').focus();
                return false;
            }
        });
    }
});
</script>

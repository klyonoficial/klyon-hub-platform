@{
    ViewData[ViewDataKeys.Title] = "Meus Endereços";
    Layout = LayoutPaths.Layout;
}
@using KlyonHubPlatform.Domain.Core.Enums

@model List<KlyonHubPlatform.Domain.Entities.CoworkingAddress>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-geo-alt"></i> Meus Endereços</h2>
    @if (ViewBag.CanAddAddress == true)
    {
        <a href="/Parceiro/AddAddress" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Adicionar Endereço
        </a>
    }
    else
    {
        <button type="button" class="btn btn-primary" disabled title="Não é possível adicionar outro endereço. Você já possui um endereço fiscal cadastrado.">
            <i class="bi bi-plus-circle"></i> Adicionar Endereço
        </button>
    }
</div>

@{
    var coworkingApprovalStatus = ViewBag.CoworkingApprovalStatus as KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus?;
    var isCoworkingFullyApproved = coworkingApprovalStatus == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.Approved;
    var coworkingRejectionReason = ViewBag.CoworkingRejectionReason as string;
    var isAwaitingAdjustment = coworkingApprovalStatus == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.AwaitingAdjustment;
    var cardPriceRejectionByAddress = ViewBag.CardPriceRejectionReasonByAddress as Dictionary<int, string> ?? new Dictionary<int, string>();

    // Verificar endereços que estão próximos do limite (faltando 10% ou menos)
    var addressesNearLimit = Model.Where(a => 
        a.MaxContracts > 0 && 
        a.CurrentContracts >= Math.Ceiling(a.MaxContracts * 0.9m) &&
        a.CurrentContracts < a.MaxContracts &&
        a.AddressStatus == AddressStatus.Active
    ).ToList();
}

@if (isAwaitingAdjustment)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h5 class="alert-heading"><i class="bi bi-exclamation-triangle-fill"></i> Cadastro Aguardando Ajustes</h5>
        <p class="mb-0">Seu cadastro foi reprovado. Corrija os itens indicados e reenvie para análise pelo menu <a href="/Parceiro/Profile" class="alert-link">Meu Perfil</a>.</p>
        @if (!string.IsNullOrWhiteSpace(coworkingRejectionReason))
        {
            <hr class="my-2">
            <p class="mb-0"><strong>Motivo da reprovação / Itens a corrigir:</strong></p>
            <p class="mb-0 mt-1">@coworkingRejectionReason</p>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (addressesNearLimit.Any())
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <h5 class="alert-heading">
            <i class="bi bi-exclamation-triangle-fill"></i> Atenção: Capacidade Próxima do Limite
        </h5>
        <p class="mb-2">Os seguintes endereços estão próximos da capacidade máxima (faltando 10% ou menos):</p>
        <ul class="mb-2">
            @foreach (var address in addressesNearLimit)
            {
                var percentageUsed = address.MaxContracts > 0 ? (address.CurrentContracts * 100.0 / address.MaxContracts) : 0;
                var remaining = address.MaxContracts - address.CurrentContracts;
                <li>
                    <strong>@address.Address, @address.City/@address.State</strong> - 
                    @address.CurrentContracts de @address.MaxContracts contratos 
                    (@percentageUsed.ToString(NumberFormatConstants.OneDecimal)% utilizado, faltam @remaining)
                    <a href="/Parceiro/EditMaxContracts?id=@address.Id" class="btn btn-sm btn-warning ms-2">
                        <i class="bi bi-pencil"></i> Ajustar Quantidade
                    </a>
                </li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/Parceiro/MyAddresses" class="row g-3" id="filterForm">
            <input type="hidden" name="page" value="1" id="pageInput" />
            <div class="col-md-3">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Endereço, cidade, bairro ou estado">
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="available" selected="@(ViewBag.Status == "available")">Disponíveis</option>
                    <option value="unavailable" selected="@(ViewBag.Status == "unavailable")">Indisponíveis</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="locationId" class="form-label">Localidade</label>
                <select class="form-select" id="locationId" name="locationId">
                    <option value="">Todas</option>
                    @foreach (var location in ViewBag.Locations as List<KlyonHubPlatform.Domain.Entities.Location> ?? new List<KlyonHubPlatform.Domain.Entities.Location>())
                    {
                        <option value="@location.Id" selected="@(ViewBag.LocationId != null && ViewBag.LocationId == location.Id)">@location.City/@location.State</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="/Parceiro/MyAddresses" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    var currentPage = ViewBag.CurrentPage ?? 1;
    var pageSize = ViewBag.PageSize ?? 10;
    var totalItems = ViewBag.TotalItems ?? 0;
    <div class="mb-3">
        <p class="text-muted mb-0">
            Mostrando <strong>@((currentPage - 1) * pageSize + 1)</strong> a 
            <strong>@(Math.Min(currentPage * pageSize, totalItems))</strong> de 
            <strong>@totalItems</strong> endereço(s)
        </p>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Endereço</th>
                            <th>Cidade/Estado</th>
                            <th>Localidade</th>
                            <th>Preço Base</th>
                            <th>Contratos</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var address in Model)
                        {
                            var hasPendingCardPrices = address.CardPricesApprovalStatus == CapacityApprovalStatus.Pending;
                            var hasRejectedCardPrices = address.CardPricesApprovalStatus == CapacityApprovalStatus.Rejected;
                            var canShowDisponivel = isCoworkingFullyApproved && !hasPendingCardPrices && address.IsAvailable;
                            var addressStatusLabel = address.AddressStatus switch
                            {
                                AddressStatus.PendingApproval => isAwaitingAdjustment ? "Aguardando Ajustes" : "Em análise",
                                AddressStatus.Active => (isCoworkingFullyApproved && !hasPendingCardPrices) ? (address.IsAvailable ? "Disponível" : "Indisponível") : (isAwaitingAdjustment ? "Aguardando Ajustes" : "Em análise"),
                                AddressStatus.Suspended => "Suspenso",
                                AddressStatus.Removed => "Removido",
                                _ => "Indisponível"
                            };
                            var addressStatusBadge = address.AddressStatus switch
                            {
                                AddressStatus.PendingApproval => isAwaitingAdjustment ? "danger" : "warning",
                                AddressStatus.Active => canShowDisponivel ? "success" : (address.AddressStatus == AddressStatus.Active && !address.IsAvailable ? "danger" : (isAwaitingAdjustment ? "danger" : "warning")),
                                AddressStatus.Suspended => "warning",
                                AddressStatus.Removed => "secondary",
                                _ => "danger"
                            };
                            var capApprovalLabel = address.CapacityApprovalStatus.ToDisplayString();
                            var maxContractsApprovalLabel = address.MaxContractsApprovalStatus.ToDisplayString();
                            <tr class="row-address-detail"
                                data-address="@address.Address"
                                data-number="@address.Number"
                                data-complement="@(address.Complement ?? "")"
                                data-neighborhood="@address.Neighborhood"
                                data-city="@address.City"
                                data-state="@address.State"
                                data-zip="@address.ZipCode"
                                data-base-price="@address.BasePrice.ToString(NumberFormatConstants.TwoDecimals)"
                                data-available="@(address.IsAvailable ? "Sim" : "Não")"
                                data-status-label="@addressStatusLabel"
                                data-status-badge="@addressStatusBadge"
                                data-current-contracts="@address.CurrentContracts"
                                data-max-contracts="@address.MaxContracts"
                                data-requested-fiscal-capacity="@address.RequestedFiscalCapacity"
                                data-approved-fiscal-capacity="@address.ApprovedFiscalCapacity"
                                data-capacity-approval-status="@capApprovalLabel"
                                data-requested-max-contracts="@address.RequestedMaxContracts"
                                data-max-contracts-approval-status="@maxContractsApprovalLabel"
                                data-shared-room="@(address.OffersSharedRoom ? "Sim" : "Não")"
                                data-shared-price="@(address.SharedRoomPricePerHour?.ToString(NumberFormatConstants.TwoDecimals) ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                data-shared-seats="@(address.SharedRoomMaxSeats?.ToString() ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                data-private-room="@(address.OffersPrivateRoom ? "Sim" : "Não")"
                                data-private-price="@(address.PrivateRoomPricePerHour?.ToString(NumberFormatConstants.TwoDecimals) ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                data-private-seats="@(address.PrivateRoomMaxSeats?.ToString() ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                data-card-1x="@(address.CardPrice1x?.ToString(NumberFormatConstants.TwoDecimals) ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                data-card-monthly="@(address.CardPriceMonthly?.ToString(NumberFormatConstants.TwoDecimals) ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                data-location="@(address.Location != null ? $"{address.Location.City}/{address.Location.State}" : DefaultDisplayStrings.EmptyPlaceholder)"
                                data-created-at="@address.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)"
                                data-updated-at="@(address.UpdatedAt?.ToString(DateFormatConstants.DisplayDateAndTime) ?? DefaultDisplayStrings.EmptyPlaceholder)"
                                style="cursor: pointer;">
                                <td>
                                    @address.Address, @address.Number
                                    @if (!string.IsNullOrEmpty(address.Complement))
                                    {
                                        <br><small class="text-muted">@address.Complement</small>
                                    }
                                </td>
                                <td>@address.City/@address.State</td>
                                <td>
                                    @if (address.Location != null)
                                    {
                                        <span class="badge bg-info">@address.Location.City/@address.Location.State</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><strong>R$ @address.BasePrice.ToString(NumberFormatConstants.TwoDecimals)</strong></td>
                                <td>
                                    @{
                                        var warningThreshold = address.MaxContracts > 0 ? Math.Ceiling(address.MaxContracts * 0.9) : 0;
                                        var badgeColor = address.CurrentContracts >= address.MaxContracts ? "danger" 
                                            : (address.CurrentContracts >= warningThreshold ? "warning" : "secondary");
                                    }
                                    <span class="badge bg-@badgeColor">
                                        @address.CurrentContracts / @address.MaxContracts
                                        @if (address.CurrentContracts >= address.MaxContracts)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill ms-1" title="Capacidade máxima atingida"></i>
                                        }
                                        else if (address.CurrentContracts >= warningThreshold)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill ms-1" title="Próximo da capacidade máxima (faltando 10%)"></i>
                                        }
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var statusTitle = isAwaitingAdjustment ? "Cadastro reprovado: corrija os itens e reenvie para análise"
                                            : address.AddressStatus == AddressStatus.PendingApproval ? "Aguardando aprovação do administrador"
                                            : hasPendingCardPrices ? "Preços no cartão aguardando aprovação"
                                            : hasRejectedCardPrices ? "Preços no cartão reprovados — ver motivo abaixo"
                                            : !isCoworkingFullyApproved && address.AddressStatus == AddressStatus.Active ? "Cadastro ainda não totalmente aprovado pelo administrador"
                                            : "";
                                        var cardPriceRejectionReason = cardPriceRejectionByAddress.TryGetValue(address.Id, out var reason) ? reason : null;
                                    }
                                    <span class="badge bg-@addressStatusBadge" title="@statusTitle">
                                        @if (address.AddressStatus == AddressStatus.PendingApproval || hasPendingCardPrices || hasRejectedCardPrices || (address.AddressStatus == AddressStatus.Active && !isCoworkingFullyApproved))
                                        {
                                            <i class="bi bi-clock-history"></i>
                                        }
                                        @addressStatusLabel
                                    </span>
                                    @if (hasRejectedCardPrices && !string.IsNullOrWhiteSpace(cardPriceRejectionReason))
                                    {
                                        <div class="small text-danger mt-1" title="Motivo da reprovação dos preços no cartão">
                                            <i class="bi bi-info-circle"></i> Preços no cartão reprovados: @(cardPriceRejectionReason.Length > 60 ? cardPriceRejectionReason.Substring(0, 60) + "…" : cardPriceRejectionReason)
                                        </div>
                                    }
                                </td>
                                <td>
                                    @{
                                        var activeContractsDict = ViewBag.ActiveContractsByAddress as Dictionary<int, int> ?? new Dictionary<int, int>();
                                        var hasActiveContracts = activeContractsDict.ContainsKey(address.Id) && activeContractsDict[address.Id] > 0;
                                        var warningThresholdActions = address.MaxContracts > 0 ? Math.Ceiling(address.MaxContracts * 0.9m) : 0;
                                        var isNearLimit = address.MaxContracts > 0 && 
                                                          address.CurrentContracts >= warningThresholdActions && 
                                                          address.CurrentContracts < address.MaxContracts &&
                                                          address.AddressStatus == AddressStatus.Active;
                                    }
                                    <a href="/Parceiro/CardPrices?id=@address.Id" class="btn btn-sm btn-outline-info me-1" title="Preços no cartão">
                                        <i class="bi bi-credit-card"></i> Preços Cartão
                                        @if (address.CardPricesApprovalStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" title="Aguardando aprovação">!</span>
                                        }
                                    </a>
                                    @if (!hasActiveContracts)
                                    {
                                        <a href="/Parceiro/EditAddress?id=@address.Id" class="btn btn-sm btn-primary" title="Editar">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                    }
                                    else if (isNearLimit)
                                    {
                                        <a href="/Parceiro/EditMaxContracts?id=@address.Id" class="btn btn-sm btn-warning" title="Ajustar quantidade máxima de contratos">
                                            <i class="bi bi-pencil"></i> Ajustar Quantidade
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted" title="Não é possível editar endereço com contrato ativo">
                                            <i class="bi bi-lock"></i> Bloqueado
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center mt-3">
                        @{
                            int currentPage = ViewBag.CurrentPage ?? 1;
                            int totalPages = ViewBag.TotalPages ?? 1;
                            int pageSize = ViewBag.PageSize ?? 15;
                            string PageUrl(int p)
                            {
                                var query = $"?page={p}&pageSize={pageSize}";
                                if (!string.IsNullOrEmpty(ViewBag.Search)) query += $"&search={ViewBag.Search}";
                                if (!string.IsNullOrEmpty(ViewBag.Status)) query += $"&status={ViewBag.Status}";
                                if (ViewBag.LocationId != null) query += $"&locationId={ViewBag.LocationId}";
                                return $"/Parceiro/MyAddresses{query}";
                            }
                        }
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(currentPage - 1)">
                                <i class="bi bi-chevron-left"></i> Anterior
                            </a>
                        </li>
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            if (p == 1 || p == totalPages || Math.Abs(p - currentPage) <= 2)
                            {
                                <li class="page-item @(p == currentPage ? CssClasses.Active : "")">
                                    <a class="page-link" href="@PageUrl(p)">@p</a>
                                </li>
                            }
                            else if (p == 2 && currentPage > 4)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            else if (p == totalPages - 1 && currentPage < totalPages - 3)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@PageUrl(currentPage + 1)">
                                Próxima <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
            else if (ViewBag.TotalPages != null && ViewBag.TotalPages == 1 && ViewBag.TotalItems > 0)
            {
                <div class="text-center mt-3">
                    <small class="text-muted">Todos os @ViewBag.TotalItems endereço(s) estão sendo exibidos nesta página.</small>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum endereço encontrado.
                @if (ViewBag.Search != null || ViewBag.Status != null || ViewBag.LocationId != null)
                {
                    <a href="/Parceiro/MyAddresses" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="bi bi-x-circle"></i> Limpar Filtros
                    </a>
                }
                else if (ViewBag.CanAddAddress == true)
                {
                    <a href="/Parceiro/AddAddress" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Cadastrar Primeiro Endereço
                    </a>
                }
            </div>
        }
    </div>
</div>

<!-- Modal Detalhes do Endereço -->
<div class="modal fade" id="viewAddressModal" tabindex="-1" aria-labelledby="viewAddressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewAddressModalLabel"><i class="bi bi-geo-alt"></i> Detalhes do Endereço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12 mb-2"><label class="form-label fw-bold text-muted small">Endereço</label></div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted small">Logradouro</label>
                        <p class="mb-0" id="viewAddrStreet">—</p>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label fw-bold text-muted small">Número</label>
                        <p class="mb-0" id="viewAddrNumber">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Complemento</label>
                        <p class="mb-0" id="viewAddrComplement">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Bairro</label>
                        <p class="mb-0" id="viewAddrNeighborhood">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Cidade</label>
                        <p class="mb-0" id="viewAddrCity">—</p>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label fw-bold text-muted small">Estado</label>
                        <p class="mb-0" id="viewAddrState">—</p>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label fw-bold text-muted small">CEP</label>
                        <p class="mb-0" id="viewAddrZip">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Localidade (Klyon)</label>
                        <p class="mb-0" id="viewAddrLocation">—</p>
                    </div>
                    <div class="col-12 mb-2"><hr class="my-2" /><label class="form-label fw-bold text-muted small">Comercial</label></div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Preço base</label>
                        <p class="mb-0" id="viewAddrBasePrice">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Disponível</label>
                        <p class="mb-0" id="viewAddrAvailable">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Status do endereço</label>
                        <p class="mb-0" id="viewAddrStatus">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Contratos (atual / máximo)</label>
                        <p class="mb-0" id="viewAddrContracts">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Capacidade fiscal solicitada</label>
                        <p class="mb-0" id="viewAddrRequestedFiscal">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Capacidade fiscal aprovada</label>
                        <p class="mb-0" id="viewAddrApprovedFiscal">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Status aprovação capacidade</label>
                        <p class="mb-0" id="viewAddrCapacityApproval">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Máx. contratos solicitado</label>
                        <p class="mb-0" id="viewAddrRequestedMax">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Status aprovação máx. contratos</label>
                        <p class="mb-0" id="viewAddrMaxContractsApproval">—</p>
                    </div>
                    <div class="col-12 mb-2"><hr class="my-2" /><label class="form-label fw-bold text-muted small">Preços no cartão</label></div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">À vista (1x)</label>
                        <p class="mb-0" id="viewAddrCard1x">—</p>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold text-muted small">Mensal</label>
                        <p class="mb-0" id="viewAddrCardMonthly">—</p>
                    </div>
                    <div class="col-12 mb-2"><hr class="my-2" /><label class="form-label fw-bold text-muted small">Salas</label></div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted small">Sala compartilhada</label>
                        <p class="mb-0" id="viewAddrSharedRoom">—</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted small">Sala privada</label>
                        <p class="mb-0" id="viewAddrPrivateRoom">—</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted small">Cadastrado em</label>
                        <p class="mb-0" id="viewAddrCreatedAt">—</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-muted small">Atualizado em</label>
                        <p class="mb-0" id="viewAddrUpdatedAt">—</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Resetar página para 1 quando o tamanho da página mudar
    document.addEventListener('DOMContentLoaded', function() {
        var pageSizeSelect = document.getElementById('pageSize');
        if (pageSizeSelect) {
            pageSizeSelect.addEventListener('change', function() {
                document.getElementById('pageInput').value = '1';
                document.getElementById('filterForm').submit();
            });
        }

        // Resetar página para 1 quando os filtros forem aplicados
        var filterForm = document.getElementById('filterForm');
        if (filterForm) {
            filterForm.addEventListener('submit', function() {
                document.getElementById('pageInput').value = '1';
            });
        }

        // Abrir modal de detalhes ao clicar na linha (exceto em links/botões)
        document.querySelectorAll('.row-address-detail').forEach(function(row) {
            row.addEventListener('click', function(e) {
                if (e.target.closest('a') || e.target.closest('button')) return;
                var r = this;
                function val(attr) { return r.getAttribute(attr) || '—'; }
                document.getElementById('viewAddrStreet').textContent = val('data-address');
                document.getElementById('viewAddrNumber').textContent = val('data-number');
                document.getElementById('viewAddrComplement').textContent = val('data-complement') || '—';
                document.getElementById('viewAddrNeighborhood').textContent = val('data-neighborhood');
                document.getElementById('viewAddrCity').textContent = val('data-city');
                document.getElementById('viewAddrState').textContent = val('data-state');
                document.getElementById('viewAddrZip').textContent = val('data-zip');
                document.getElementById('viewAddrLocation').textContent = val('data-location');
                var basePrice = val('data-base-price');
                document.getElementById('viewAddrBasePrice').textContent = basePrice !== '—' ? 'R$ ' + basePrice : '—';
                document.getElementById('viewAddrAvailable').innerHTML = val('data-available') === 'Sim'
                    ? '<span class="badge bg-success">Sim</span>' : '<span class="badge bg-danger">Não</span>';
                var statusLabel = val('data-status-label');
                var statusBadge = val('data-status-badge');
                document.getElementById('viewAddrStatus').innerHTML = '<span class="badge bg-' + statusBadge + '">' + statusLabel + '</span>';
                document.getElementById('viewAddrContracts').textContent = val('data-current-contracts') + ' / ' + val('data-max-contracts');
                document.getElementById('viewAddrRequestedFiscal').textContent = val('data-requested-fiscal-capacity');
                document.getElementById('viewAddrApprovedFiscal').textContent = val('data-approved-fiscal-capacity');
                document.getElementById('viewAddrCapacityApproval').textContent = val('data-capacity-approval-status');
                document.getElementById('viewAddrRequestedMax').textContent = val('data-requested-max-contracts');
                document.getElementById('viewAddrMaxContractsApproval').textContent = val('data-max-contracts-approval-status');
                var card1x = val('data-card-1x');
                var cardMon = val('data-card-monthly');
                document.getElementById('viewAddrCard1x').textContent = card1x !== '—' ? 'R$ ' + card1x : '—';
                document.getElementById('viewAddrCardMonthly').textContent = cardMon !== '—' ? 'R$ ' + cardMon : '—';
                var shared = val('data-shared-room');
                var sharedPrice = val('data-shared-price');
                var sharedSeats = val('data-shared-seats');
                document.getElementById('viewAddrSharedRoom').textContent = shared === 'Sim'
                    ? 'Sim — R$ ' + sharedPrice + '/h, até ' + sharedSeats + ' lugares' : 'Não';
                var priv = val('data-private-room');
                var privPrice = val('data-private-price');
                var privSeats = val('data-private-seats');
                document.getElementById('viewAddrPrivateRoom').textContent = priv === 'Sim'
                    ? 'Sim — R$ ' + privPrice + '/h, até ' + privSeats + ' lugares' : 'Não';
                document.getElementById('viewAddrCreatedAt').textContent = val('data-created-at');
                document.getElementById('viewAddrUpdatedAt').textContent = val('data-updated-at');
                var modal = new bootstrap.Modal(document.getElementById('viewAddressModal'));
                modal.show();
            });
        });
    });
</script>

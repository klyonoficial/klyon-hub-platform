@{
    ViewData["Title"] = "Emitir NF de Serviço";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Payment>

@{
    var commissionDict = ViewBag.CommissionDict as Dictionary<int, KlyonHubPlatform.Domain.Entities.Commission> ?? new Dictionary<int, KlyonHubPlatform.Domain.Entities.Commission>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt-cutoff"></i> Emitir NF de Serviço</h2>
    <div>
        <a href="@Url.Action("ListServiceFiscalNotes", "Coworking")" class="btn btn-outline-info me-2">
            <i class="bi bi-list-ul"></i> Ver Notas Emitidas
        </a>
        @if (!ViewBag.HasSefazConfiguration)
        {
            <a href="@Url.Action("SefazConfiguration", "Coworking")" class="btn btn-outline-primary me-2">
                <i class="bi bi-gear"></i> Configurações SEFAZ
            </a>
        }
        <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>

<!-- Resumo -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-list-check"></i> Pagamentos Pendentes</h6>
                <h2 class="mb-0">@ViewBag.TotalItems</h2>
                <small class="text-white-50">Aguardando emissão de NF</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-cash-coin"></i> Valor Total para Emitir</h6>
                <h2 class="mb-0">R$ @(Model.Sum(p => p.Amount).ToString("N2"))</h2>
                <small class="text-white-50">Valor total (com percentagem)</small>
            </div>
        </div>
    </div>
</div>

<!-- Lista de Pagamentos -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código Contrato</th>
                            <th>Cliente</th>
                            <th>Serviço</th>
                            <th>Localização</th>
                            <th>Valor para Emitir (R$)</th>
                            <th>Data Pagamento</th>
                            <th>Opção</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            var client = payment.Subscription?.Contract?.Client ?? payment.Reservation?.Client;
                            var serviceName = payment.Subscription?.Contract != null ? "Endereço Fiscal" : "Reserva de Sala";
                            var location = payment.Subscription?.Contract?.CoworkingAddress?.Location ?? payment.Reservation?.CoworkingAddress?.Location;
                            var contractNumber = payment.Subscription?.Contract?.ContractNumber;
                            
                            <tr>
                                <td>#@payment.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contractNumber))
                                    {
                                        <strong>@contractNumber</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (client != null)
                                    {
                                        <strong>@(client.RazaoSocial ?? client.NomeFantasia ?? client.User?.FullName)</strong><br>
                                        <small class="text-muted">@(client.CNPJ ?? client.CPF)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @serviceName
                                </td>
                                <td>
                                    @if (location != null)
                                    {
                                        <strong>@location.City/@location.State</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    <strong>R$ @payment.Amount.ToString("N2")</strong>
                                    <input type="hidden" class="net-amount" value="@payment.Amount.ToString("F2")" />
                                </td>
                                <td>
                                    @if (payment.PaidAt.HasValue)
                                    {
                                        @payment.PaidAt.Value.ToString("dd/MM/yyyy")<br>
                                        <small class="text-muted">@payment.PaidAt.Value.ToString("HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" action="@Url.Action("IssueServiceFiscalNote", "Coworking")" style="display: inline;" class="confirm-required d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@payment.Id" />
                                        <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Tem certeza que deseja emitir a NF de serviço no valor de R$ @payment.Amount.ToString("N2")?');">
                                            <i class="bi bi-file-earmark-check"></i> Emitir NF
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-bs-toggle="modal" data-bs-target="#importNfModal" 
                                            data-payment-id="@payment.Id" data-net-amount="@payment.Amount.ToString("F2")" data-client-name="@(client?.RazaoSocial ?? client?.NomeFantasia ?? client?.User?.FullName ?? "—")">
                                        <i class="bi bi-upload"></i> Importar NF
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ServiceFiscalNotes", new { page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })">
                                    Anterior
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ServiceFiscalNotes", new { page = i, pageSize = ViewBag.PageSize })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("ServiceFiscalNotes", new { page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })">
                                    Próximo
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle"></i> Nenhum pagamento pendente de emissão de NF encontrado.
            </div>
        }
    </div>
</div>

<!-- Modal Importar NF -->
<div class="modal fade" id="importNfModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("ImportServiceFiscalNote", "Coworking")" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" id="importNfPaymentId" value="" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-upload"></i> Importar NF de Serviço</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Use quando a NF foi emitida pelo contador. Envie o PDF da nota para validação do administrador.</p>
                    <div class="mb-3">
                        <label class="form-label">Pagamento / Cliente</label>
                        <p class="form-control-plaintext fw-bold" id="importNfClientInfo">—</p>
                    </div>
                    <div class="mb-3">
                        <label for="importNfPdf" class="form-label">PDF da NF <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="importNfPdf" name="pdfFile" accept=".pdf" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('importNfModal').addEventListener('show.bs.modal', function (e) {
        var btn = e.relatedTarget;
        if (!btn) return;
        var paymentId = btn.getAttribute('data-payment-id');
        var netAmount = btn.getAttribute('data-net-amount');
        var clientName = btn.getAttribute('data-client-name');
        document.getElementById('importNfPaymentId').value = paymentId || '';
        document.getElementById('importNfClientInfo').textContent = (clientName || '—') + (netAmount ? ' — Valor total: R$ ' + parseFloat(netAmount).toFixed(2) : '');
        document.getElementById('importNfPdf').value = '';
    });
</script>
}

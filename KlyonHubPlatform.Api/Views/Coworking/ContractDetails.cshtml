@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData["Title"] = "Detalhes do Contrato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonHubPlatform.Domain.Entities.Contract

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Detalhes do Contrato @Model.ContractNumber</h2>
    <a href="@Url.Action("ActiveContracts", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <!-- Informações do Contrato -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title-tight"><i class="bi bi-file-earmark-text"></i> Informações do Contrato</h5>
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th width="40%">Número:</th>
                        <td><strong>@Model.ContractNumber</strong></td>
                    </tr>
                    <tr>
                        <th>Status:</th>
                        <td>
                            @{
                                var displayStatus = ViewBag.ContractDisplayStatus as string ?? Model.Status.ToString();
                                var statusBadgeClass = Model.Status switch
                                {
                                    ContractStatus.Active => "bg-active",
                                    ContractStatus.Suspended => "bg-suspended",
                                    ContractStatus.PendingPayment => (displayStatus == "Aguardando Validação" ? "bg-awaiting-validation" : "bg-pending-payment"),
                                    ContractStatus.PendingCancellation => "bg-pending-cancellation",
                                    ContractStatus.Cancelled => "bg-cancelled",
                                    ContractStatus.Expired => "bg-expired",
                                    _ => "bg-expired"
                                };
                                var statusIcon = Model.Status switch
                                {
                                    ContractStatus.Active => "bi-check-circle-fill",
                                    ContractStatus.Suspended => "bi-pause-circle-fill",
                                    ContractStatus.PendingPayment => (displayStatus == "Aguardando Validação" ? "bi-clock-history" : "bi-cash-coin"),
                                    ContractStatus.PendingCancellation => "bi-clock-history",
                                    ContractStatus.Cancelled => "bi-x-circle-fill",
                                    ContractStatus.Expired => "bi-calendar-x-fill",
                                    _ => "bi-question-circle-fill"
                                };
                            }
                            <span class="badge @statusBadgeClass"><i class="bi @statusIcon me-1"></i> @displayStatus</span>
                        </td>
                    </tr>
                    @if (Model.Status == ContractStatus.Cancelled && !string.IsNullOrEmpty(Model.CancellationReason))
                    {
                        <tr>
                            <th>Motivo do cancelamento:</th>
                            <td><span class="text-muted">@Model.CancellationReason</span></td>
                        </tr>
                    }
                    <tr>
                        <th>Data de Início:</th>
                        <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                    @if (Model.ExpiryDate.HasValue)
                    {
                        <tr>
                            <th>Data de Expiração:</th>
                            <td>@Model.ExpiryDate.Value.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                    <tr>
                        <th>Valor Mensal:</th>
                        <td><strong class="text-success">R$ @Model.MonthlyValue.ToString("N2")</strong></td>
                    </tr>
                    <tr>
                        <th>Data de Criação:</th>
                        <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <tr>
                            <th>Última Atualização:</th>
                            <td>@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>

    <!-- Assinatura e Documentos -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="card-title-tight"><i class="bi bi-file-earmark-pdf"></i> Documentos</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.Declarations != null && ((List<KlyonHubPlatform.Domain.Entities.AddressDeclaration>)ViewBag.Declarations).Any())
                {
                    <h6 class="mb-3">Declarações de Endereço:</h6>
                    <ul class="list-group mb-3">
                        @foreach (var declaration in (List<KlyonHubPlatform.Domain.Entities.AddressDeclaration>)ViewBag.Declarations)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="flex-grow-1">
                                    <a href="@Url.Action("DownloadDeclaration", "Coworking", new { id = declaration.Id })" class="text-decoration-none text-dark fw-bold">
                                        <i class="bi bi-download me-1"></i>@declaration.DeclarationNumber
                                    </a><br>
                                    <small class="text-muted">Versão @declaration.Version - @declaration.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                                @if (declaration.IsValid)
                                {
                                    <span class="badge bg-success">Válida</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inválida</span>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Nenhuma declaração gerada ainda.</p>
                }

                @if (Model.Documents != null && Model.Documents.Any())
                {
                    <h6 class="mb-3">Outros Documentos:</h6>
                    <ul class="list-group">
                        @foreach (var doc in Model.Documents)
                        {
                            var documentTypeText = doc.Type switch
                            {
                                DocumentType.Contract => "Contrato",
                                DocumentType.Receipt => "Recibo",
                                DocumentType.TaxDeclaration => "Declaração Fiscal",
                                DocumentType.TermsOfUse => "Termos de Uso",
                                _ => "Outro"
                            };
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <a href="@Url.Action("DownloadContractDocument", "Coworking", new { id = doc.Id })" class="text-decoration-none text-dark">
                                    <i class="bi bi-download me-1"></i>@documentTypeText
                                </a>
                                <small class="text-muted">@doc.GeneratedAt.ToString("dd/MM/yyyy")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Endereço Fiscal -->
    <div class="col-md-6 mb-4">
        <div class="card">
            <div class="card-header bg-success text-white" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#enderecoFiscalBody" aria-expanded="false" aria-controls="enderecoFiscalBody">
                <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Endereço Fiscal <i class="bi bi-chevron-down float-end"></i></h5>
            </div>
            <div class="card-body collapse" id="enderecoFiscalBody">
                <p>
                    <strong>@Model.CoworkingAddress?.Address</strong>, @Model.CoworkingAddress?.Number<br>
                    @if (!string.IsNullOrEmpty(Model.CoworkingAddress?.Complement))
                    {
                        <text>@Model.CoworkingAddress.Complement<br></text>
                    }
                    @Model.CoworkingAddress?.Neighborhood<br>
                    @Model.CoworkingAddress?.City/@Model.CoworkingAddress?.State<br>
                    CEP: @Model.CoworkingAddress?.ZipCode
                </p>
                @if (Model.CoworkingAddress?.Location != null)
                {
                    <p class="text-muted mb-0">
                        <small>Localidade: @Model.CoworkingAddress.Location.City/@Model.CoworkingAddress.Location.State</small>
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Histórico de Pagamentos -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-warning text-dark" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#historicoPagamentosBody" aria-expanded="false" aria-controls="historicoPagamentosBody">
                <h5 class="mb-0"><i class="bi bi-cash-coin"></i> Histórico de Pagamentos <i class="bi bi-chevron-down float-end"></i></h5>
            </div>
            <div class="card-body collapse" id="historicoPagamentosBody">
                @if (ViewBag.Payments != null && ((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Valor</th>
                                    <th>Método</th>
                                    <th>Status</th>
                                    <th>Data Pagamento</th>
                                    <th>Validação</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in (List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments)
                                {
                                    <tr>
                                        <td>@payment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><strong>R$ @payment.Amount.ToString("N2")</strong></td>
                                        <td>
                                            @switch (payment.Method)
                                            {
                                                case PaymentMethod.PIX:
                                                    <span class="badge bg-primary">PIX</span>
                                                    break;
                                                case PaymentMethod.CreditCard:
                                                    <span class="badge bg-info">Cartão</span>
                                                    @if (payment.InstallmentCount.HasValue && payment.InstallmentValue.HasValue)
                                                    {
                                                        <span class="text-muted ms-1">@payment.InstallmentCount.Value x de R$ @payment.InstallmentValue.Value.ToString("N2")</span>
                                                    }
                                                    break;
                                                case PaymentMethod.BankTransfer:
                                                    <span class="badge bg-secondary">Boleto</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">Outro</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @{
                                                string payStatusLabel;
                                                string payStatusClass;
                                                string payStatusIcon;
                                                switch (payment.Status)
                                                {
                                                    case PaymentStatus.Pending:
                                                        payStatusLabel = "Aguardando Pagamento";
                                                        payStatusClass = "bg-pending-payment";
                                                        payStatusIcon = "bi-cash-coin";
                                                        break;
                                                    case PaymentStatus.Processing:
                                                        payStatusLabel = "Processando";
                                                        payStatusClass = "bg-suspended";
                                                        payStatusIcon = "bi-arrow-repeat";
                                                        break;
                                                    case PaymentStatus.AwaitingValidation:
                                                        payStatusLabel = "Aguardando Validação";
                                                        payStatusClass = "bg-awaiting-validation";
                                                        payStatusIcon = "bi-clock-history";
                                                        break;
                                                    case PaymentStatus.Paid:
                                                        payStatusLabel = "Pago";
                                                        payStatusClass = "bg-active";
                                                        payStatusIcon = "bi-check-circle-fill";
                                                        break;
                                                    case PaymentStatus.Failed:
                                                        payStatusLabel = "Falhou";
                                                        payStatusClass = "bg-cancelled";
                                                        payStatusIcon = "bi-x-circle-fill";
                                                        break;
                                                    case PaymentStatus.Refunded:
                                                        payStatusLabel = "Reembolsado";
                                                        payStatusClass = "bg-expired";
                                                        payStatusIcon = "bi-arrow-counterclockwise";
                                                        break;
                                                    case PaymentStatus.Cancelled:
                                                        payStatusLabel = "Cancelado";
                                                        payStatusClass = "bg-cancelled";
                                                        payStatusIcon = "bi-x-circle-fill";
                                                        break;
                                                    default:
                                                        payStatusLabel = "Outro";
                                                        payStatusClass = "bg-expired";
                                                        payStatusIcon = "bi-question-circle-fill";
                                                        break;
                                                }
                                            }
                                            <span class="badge @payStatusClass"><i class="bi @payStatusIcon me-1"></i> @payStatusLabel</span>
                                        </td>
                                        <td>
                                            @if (payment.PaidAt.HasValue)
                                            {
                                                <text>@payment.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</text>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var histories = ViewBag.PaymentHistories as Dictionary<int, List<KlyonHubPlatform.Domain.Entities.PaymentHistory>>;
                                                if (payment.Status == PaymentStatus.Pending)
                                                {
                                                    <span class="badge bg-pending-payment"><i class="bi bi-cash-coin me-1"></i> Aguardando Pagamento</span>
                                                }
                                                else if (payment.Status == PaymentStatus.Processing)
                                                {
                                                    <span class="badge bg-suspended"><i class="bi bi-arrow-repeat me-1"></i> Processando</span>
                                                }
                                                else if (payment.Status == PaymentStatus.AwaitingValidation)
                                                {
                                                    <span class="badge bg-awaiting-validation"><i class="bi bi-clock-history me-1"></i> Aguardando Validação</span>
                                                }
                                                else if (payment.Status == PaymentStatus.Paid && histories != null && histories.ContainsKey(payment.Id) && histories[payment.Id].Any(h => h.Action == "Approved"))
                                                {
                                                    var lastApproved = histories[payment.Id].Where(h => h.Action == "Approved").OrderByDescending(h => h.ActionAt).First();
                                                    <span class="badge bg-active">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Aprovado @(lastApproved.ActionByUser != null ? "por " + lastApproved.ActionByUser.FullName : "automaticamente (PIX)")
                                                    </span>
                                                }
                                                else if (payment.Status == PaymentStatus.Failed || payment.Status == PaymentStatus.Cancelled)
                                                {
                                                    <span class="badge bg-cancelled">
                                                        <i class="bi bi-x-circle-fill me-1"></i> @(payment.Status == PaymentStatus.Cancelled ? "Cancelado" : "Reprovado")
                                                    </span>
                                                }
                                                else if (payment.Status == PaymentStatus.Refunded)
                                                {
                                                    <span class="badge bg-expired"><i class="bi bi-arrow-counterclockwise me-1"></i> Reembolsado</span>
                                                }
                                                else if (histories != null && histories.ContainsKey(payment.Id) && histories[payment.Id].Any())
                                                {
                                                    var lastHistory = histories[payment.Id].OrderByDescending(h => h.ActionAt).First();
                                                    if (lastHistory.Action == "Approved")
                                                    {
                                                        <span class="badge bg-active">
                                                            <i class="bi bi-check-circle-fill me-1"></i> Aprovado @(lastHistory.ActionByUser != null ? "por " + lastHistory.ActionByUser.FullName : "automaticamente (PIX)")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-cancelled">
                                                            <i class="bi bi-x-circle-fill me-1"></i> Reprovado
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhum pagamento registrado ainda.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Histórico -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h5 class="card-title-tight"><i class="bi bi-clock-history"></i> Histórico</h5>
            </div>
            <div class="card-body">
                @{
                    var timelineTotalItems = ViewBag.TimelineTotalItems as int? ?? 0;
                    var timelineCurrentPage = ViewBag.TimelineCurrentPage as int? ?? 1;
                    var timelineTotalPages = ViewBag.TimelineTotalPages as int? ?? 1;
                    var timelinePageSizeVal = ViewBag.TimelinePageSize as int? ?? 5;
                }
                @if (ViewBag.Timeline != null && ((List<object>)ViewBag.Timeline).Any())
                {
                    <div class="timeline">
                        @foreach (var item in (List<object>)ViewBag.Timeline)
                        {
                            var timelineItem = (dynamic)item;
                            <div class="timeline-item mb-4">
                                <div class="d-flex">
                                    <div class="timeline-marker me-3">
                                        <i class="bi @timelineItem.Icon text-@timelineItem.Color" style="font-size: 1.5rem;"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="card border-@timelineItem.Color">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                    <h6 class="mb-0">@timelineItem.Title</h6>
                                                    <small class="text-muted">@timelineItem.Date.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                                <p class="mb-0 text-muted">@timelineItem.Description</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    @if (timelineTotalPages > 1)
                    {
                        <nav aria-label="Paginação do histórico" class="mt-3">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item @(timelineCurrentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@(timelineCurrentPage <= 1 ? "#" : Url.Action("ContractDetails", "Coworking", new { id = Model.Id, timelinePage = timelineCurrentPage - 1, timelinePageSize = timelinePageSizeVal }))">
                                        Anterior
                                    </a>
                                </li>
                                @for (int p = 1; p <= timelineTotalPages; p++)
                                {
                                    <li class="page-item @(p == timelineCurrentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("ContractDetails", "Coworking", new { id = Model.Id, timelinePage = p, timelinePageSize = timelinePageSizeVal })">@p</a>
                                    </li>
                                }
                                <li class="page-item @(timelineCurrentPage >= timelineTotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@(timelineCurrentPage >= timelineTotalPages ? "#" : Url.Action("ContractDetails", "Coworking", new { id = Model.Id, timelinePage = timelineCurrentPage + 1, timelinePageSize = timelinePageSizeVal }))">
                                        Próximo
                                    </a>
                                </li>
                            </ul>
                            <p class="text-center text-muted small mt-2 mb-0">
                                Exibindo @(((timelineCurrentPage - 1) * timelinePageSizeVal) + 1)–@(Math.Min(timelineCurrentPage * timelinePageSizeVal, timelineTotalItems)) de @timelineTotalItems registro(s).
                            </p>
                        </nav>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhum evento registrado ainda.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .timeline-item {
        position: relative;
    }
    .timeline-item:not(:last-child)::after {
        content: '';
        position: absolute;
        left: 0.75rem;
        top: 2.5rem;
        width: 2px;
        height: calc(100% + 1rem);
        background-color: #dee2e6;
    }
</style>

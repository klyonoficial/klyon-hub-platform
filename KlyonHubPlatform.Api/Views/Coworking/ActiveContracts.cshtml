@{
    ViewData[ViewDataKeys.Title] = "Contratos de Endereço Fiscal Ativos";
    Layout = LayoutPaths.Layout;
}

@model List<KlyonHubPlatform.Domain.Entities.Contract>
@using KlyonHubPlatform.Domain.Core.Enums

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Contratos de Endereço Fiscal</h2>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5><i class="bi bi-funnel"></i> Filtros</h5>
    </div>
    <div class="card-body">
        <form method="get" action="@Url.Action(ActionNames.ActiveContracts, ControllerNames.Coworking)" id="filterForm">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="search" class="form-label">Buscar</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="@ViewBag.Search" placeholder="Cliente, endereço, cidade...">
                </div>
                <div class="col-md-2">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.Status as string))">Todos</option>
                        <option value="@ContractStatusFilterValues.Active" selected="@(ViewBag.Status as string == ContractStatusFilterValues.Active)">Ativo</option>
                        <option value="Suspended" selected="@(ViewBag.Status as string == "Suspended")">Suspenso</option>
                        <option value="PendingPayment" selected="@(ViewBag.Status as string == "PendingPayment")">Aguardando Pagamento</option>
                        <option value="PendingCancellation" selected="@(ViewBag.Status as string == "PendingCancellation")">Cancelamento Pendente</option>
                        <option value="@ContractStatusFilterValues.Cancelled" selected="@(ViewBag.Status as string == ContractStatusFilterValues.Cancelled)">Cancelado</option>
                        <option value="Expired" selected="@(ViewBag.Status as string == "Expired")">Expirado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="locationId" class="form-label">Localidade</label>
                    <select class="form-select" id="locationId" name="locationId">
                        <option value="">Todas</option>
                        @if (ViewBag.Locations != null)
                        {
                            @foreach (var location in (List<KlyonHubPlatform.Domain.Entities.Location>)ViewBag.Locations)
                            {
                                <option value="@location.Id" selected="@(ViewBag.LocationId != null && ViewBag.LocationId.ToString() == location.Id.ToString())">
                                    @location.City/@location.State
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="startDateFrom" class="form-label">Data Início (De)</label>
                    <input type="date" class="form-control" id="startDateFrom" name="startDateFrom" 
                           value="@ViewBag.StartDateFrom">
                </div>
                <div class="col-md-2">
                    <label for="startDateTo" class="form-label">Data Início (Até)</label>
                    <input type="date" class="form-control" id="startDateTo" name="startDateTo" 
                           value="@ViewBag.StartDateTo">
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || 
                 !string.IsNullOrEmpty(ViewBag.Status as string) || 
                 ViewBag.LocationId != null ||
                 !string.IsNullOrEmpty(ViewBag.StartDateFrom as string) ||
                 !string.IsNullOrEmpty(ViewBag.StartDateTo as string))
            {
                <div class="row mt-3">
                    <div class="col-12">
                        <a href="@Url.Action(ActionNames.ActiveContracts, ControllerNames.Coworking)" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x-circle"></i> Limpar Filtros
                        </a>
                    </div>
                </div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-list-check"></i> Lista de Contratos de Endereço Fiscal Ativos</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Cliente</th>
                            <th>Endereço</th>
                            <th>Localidade</th>
                            <th>Valor Mensal</th>
                            <th>Data Início</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model)
                        {
                            var addressDisplay = !string.IsNullOrEmpty(contract.SnapshotAddress)
                                ? contract.SnapshotAddress
                                : (contract.CoworkingAddress != null
                                    ? $"{contract.CoworkingAddress.Address ?? DefaultDisplayStrings.NotAvailable}, {contract.CoworkingAddress.Number ?? ""}" + (!string.IsNullOrEmpty(contract.CoworkingAddress.Complement) ? $" - {contract.CoworkingAddress.Complement}" : "")
                                    : DefaultDisplayStrings.NotAvailable);
                            var valueDisplay = contract.SnapshotMonthlyValue > 0
                                ? contract.SnapshotMonthlyValue.ToString(NumberFormatConstants.CurrencyTwoDecimals)
                                : (contract.Subscription?.MonthlyAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals) ?? contract.MonthlyValue.ToString(NumberFormatConstants.CurrencyTwoDecimals));
                            var locationDisplay = $"{contract.CoworkingAddress?.Location?.City ?? DefaultDisplayStrings.NotAvailable}/{contract.CoworkingAddress?.Location?.State ?? ""}";
                            string statusLabel;
                            string statusBadgeClass;
                            string statusIcon;
                            if (contract.Status == ContractStatus.PendingPayment && contract.Subscription?.Payments != null && contract.Subscription.Payments.Any())
                            {
                                var latestPaymentStatus = contract.Subscription.Payments.OrderByDescending(p => p.CreatedAt).First().Status;
                                if (latestPaymentStatus == PaymentStatus.AwaitingValidation || latestPaymentStatus == PaymentStatus.Processing)
                                {
                                    statusLabel = "Aguardando Validação";
                                    statusBadgeClass = "bg-awaiting-validation";
                                    statusIcon = "bi-clock-history";
                                }
                                else
                                {
                                    statusLabel = "Aguardando Pagamento";
                                    statusBadgeClass = "bg-pending-payment";
                                    statusIcon = "bi-cash-coin";
                                }
                            }
                            else
                            {
                                switch (contract.Status)
                                {
                                    case ContractStatus.Active:
                                        statusLabel = "Ativo";
                                        statusBadgeClass = "bg-active";
                                        statusIcon = "bi-check-circle-fill";
                                        break;
                                    case ContractStatus.Suspended:
                                        statusLabel = "Suspenso";
                                        statusBadgeClass = "bg-suspended";
                                        statusIcon = "bi-pause-circle-fill";
                                        break;
                                    case ContractStatus.PendingPayment:
                                        statusLabel = "Aguardando Pagamento";
                                        statusBadgeClass = "bg-pending-payment";
                                        statusIcon = "bi-cash-coin";
                                        break;
                                    case ContractStatus.PendingCancellation:
                                        statusLabel = "Cancelamento Pendente";
                                        statusBadgeClass = "bg-pending-cancellation";
                                        statusIcon = "bi-clock-history";
                                        break;
                                    case ContractStatus.Cancelled:
                                        statusLabel = "Cancelado";
                                        statusBadgeClass = "bg-cancelled";
                                        statusIcon = "bi-x-circle-fill";
                                        break;
                                    case ContractStatus.Expired:
                                        statusLabel = "Expirado";
                                        statusBadgeClass = "bg-expired";
                                        statusIcon = "bi-calendar-x-fill";
                                        break;
                                    default:
                                        statusLabel = contract.Status.ToString();
                                        statusBadgeClass = "bg-expired";
                                        statusIcon = "bi-question-circle-fill";
                                        break;
                                }
                            }
                            var latestPayment = contract.Subscription?.Payments?.OrderByDescending(p => p.CreatedAt).FirstOrDefault();
                            var paymentMethodLabel = DefaultDisplayStrings.EmptyPlaceholder;
                            if (latestPayment != null)
                            {
                                if (latestPayment.Method == PaymentMethod.PIX) paymentMethodLabel = "PIX";
                                else if (latestPayment.Method == PaymentMethod.BankTransfer) paymentMethodLabel = "Boleto";
                                else if (latestPayment.Method == PaymentMethod.CreditCard)
                                {
                                    paymentMethodLabel = latestPayment.InstallmentCount.HasValue && latestPayment.InstallmentValue.HasValue
                                        ? $"Cartão ({latestPayment.InstallmentCount.Value}x de R$ {latestPayment.InstallmentValue.Value:N2})"
                                        : "Cartão";
                                }
                                else paymentMethodLabel = latestPayment.Method.ToString();
                            }
                            <tr class="contract-row cursor-pointer" role="button" tabindex="0"
                                data-contract-id="@contract.Id"
                                data-contract-number="@(contract.ContractNumber ?? contract.Id.ToString())"
                                data-client-name="@(contract.Client?.RazaoSocial ?? contract.Client?.ContactName ?? DefaultDisplayStrings.NotAvailable)"
                                data-client-doc="@(contract.Client?.CNPJ ?? contract.Client?.CPF ?? "")"
                                data-address="@addressDisplay"
                                data-location="@locationDisplay"
                                data-value="@valueDisplay"
                                data-start-date="@contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)"
                                data-status-label="@statusLabel"
                                data-status-badge="@statusBadgeClass"
                                data-status-icon="@statusIcon"
                                data-payment-method="@paymentMethodLabel"
                                data-details-url="@Url.Action(ActionNames.ContractDetails, ControllerNames.Coworking, new { id = contract.Id })">
                                <td><strong>@(contract.ContractNumber ?? contract.Id.ToString())</strong></td>
                                <td>
                                    <strong>@(contract.Client?.RazaoSocial ?? contract.Client?.ContactName ?? DefaultDisplayStrings.NotAvailable)</strong><br>
                                    <small class="text-muted">@(contract.Client?.CNPJ ?? contract.Client?.CPF ?? "")</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contract.SnapshotAddress))
                                    {
                                        <span>@contract.SnapshotAddress</span>
                                    }
                                    else
                                    {
                                        <span>@(contract.CoworkingAddress?.Address ?? DefaultDisplayStrings.NotAvailable), @(contract.CoworkingAddress?.Number ?? "")</span>
                                        @if (!string.IsNullOrEmpty(contract.CoworkingAddress?.Complement))
                                        {
                                            <br><small class="text-muted">@contract.CoworkingAddress.Complement</small>
                                        }
                                    }
                                </td>
                                <td>@locationDisplay</td>
                                <td><strong>R$ @valueDisplay</strong></td>
                                <td>@contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                <td>
                                    <span class="badge @statusBadgeClass"><i class="bi @statusIcon me-1"></i> @statusLabel</span>
                                </td>
                                <td onclick="event.stopPropagation();">
                                    <button type="button" class="btn btn-sm btn-info"
                                            onclick="event.stopPropagation(); showContractDetails(@contract.Id)"
                                            title="Ver Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <strong>Total de contratos:</strong> @(ViewBag.TotalItems ?? Model.Count)
                    @if (ViewBag.TotalItems != null && ViewBag.TotalItems > Model.Count)
                    {
                        <text>(Mostrando @Model.Count de @ViewBag.TotalItems)</text>
                    }
                </p>
            </div>

            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? CssClasses.Active : "")">
                                <a class="page-link" href="@Url.Action(ActionNames.ActiveContracts, ControllerNames.Coworking, new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    locationId = ViewBag.LocationId,
                                    startDateFrom = ViewBag.StartDateFrom,
                                    startDateTo = ViewBag.StartDateTo,
                                    page = i 
                                })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum contrato ativo no momento.
            </div>
        }
    </div>
</div>

<!-- Modal com dados do contrato -->
<div class="modal fade" id="contractModal" tabindex="-1" aria-labelledby="contractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="contractModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i> Contrato <span id="modalContractNumber"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <table class="table table-borderless table-sm mb-0">
                    <tr>
                        <th class="text-muted" style="width: 38%;">Código:</th>
                        <td><strong id="modalContractCode"></strong></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Cliente:</th>
                        <td><strong id="modalClientName"></strong><br><small class="text-muted" id="modalClientDoc"></small></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Endereço:</th>
                        <td id="modalAddress"></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Localidade:</th>
                        <td id="modalLocation"></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Valor mensal:</th>
                        <td><strong class="text-success">R$ <span id="modalValue"></span></strong></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Data de início:</th>
                        <td id="modalStartDate"></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Status:</th>
                        <td><span id="modalStatusBadge"></span></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Forma de pagamento:</th>
                        <td><strong id="modalPaymentMethod"></strong></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <a id="modalDetailsLink" href="#" class="btn btn-primary">
                    <i class="bi bi-eye me-1"></i> Ver detalhes completos
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .contract-row.cursor-pointer { cursor: pointer; }
    .contract-row:hover { background-color: rgba(0, 0, 0, 0.04); }
</style>

<script>
function showContractDetails(contractId) {
    window.location.href = '@Url.Action(ActionNames.ContractDetails, ControllerNames.Coworking)?id=' + contractId;
}

document.addEventListener('DOMContentLoaded', function () {
    var modal = new bootstrap.Modal(document.getElementById('contractModal'));
    var rows = document.querySelectorAll('.contract-row');
    rows.forEach(function (row) {
        row.addEventListener('click', function (e) {
            if (e.target.closest('button') || e.target.closest('a')) return;
            var d = row.dataset;
            document.getElementById('modalContractNumber').textContent = d.contractNumber;
            document.getElementById('modalContractCode').textContent = d.contractNumber;
            document.getElementById('modalClientName').textContent = d.clientName;
            document.getElementById('modalClientDoc').textContent = d.clientDoc || '';
            document.getElementById('modalAddress').textContent = d.address || '—';
            document.getElementById('modalLocation').textContent = d.location || '—';
            document.getElementById('modalValue').textContent = d.value || '—';
            document.getElementById('modalStartDate').textContent = d.startDate || '—';
            var badge = document.getElementById('modalStatusBadge');
            badge.className = 'badge ' + (d.statusBadge || 'bg-secondary');
            badge.innerHTML = '<i class="bi ' + (d.statusIcon || 'bi-circle') + ' me-1"></i> ' + (d.statusLabel || '—');
            document.getElementById('modalDetailsLink').href = d.detailsUrl || '#';
            document.getElementById('modalPaymentMethod').textContent = d.paymentMethod || '—';
            modal.show();
        });
        row.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                row.click();
            }
        });
    });
});
</script>

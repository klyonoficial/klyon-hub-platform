@{
    ViewData["Title"] = "Contratos Ativos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Contract>
@using KlyonHubPlatform.Domain.Core.Enums

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Contratos Ativos</h2>
    <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h5><i class="bi bi-funnel"></i> Filtros</h5>
    </div>
    <div class="card-body">
        <form method="get" action="@Url.Action("ActiveContracts", "Coworking")" id="filterForm">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="search" class="form-label">Buscar</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="@ViewBag.Search" placeholder="Cliente, endereço, cidade...">
                </div>
                <div class="col-md-2">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="">Todos</option>
                        <option value="Active" selected="@(ViewBag.Status == "Active")">Ativo</option>
                        <option value="Suspended" selected="@(ViewBag.Status == "Suspended")">Suspenso</option>
                        <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelado</option>
                        <option value="Expired" selected="@(ViewBag.Status == "Expired")">Expirado</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="locationId" class="form-label">Localidade</label>
                    <select class="form-select" id="locationId" name="locationId">
                        <option value="">Todas</option>
                        @if (ViewBag.Locations != null)
                        {
                            @foreach (var location in (List<KlyonHubPlatform.Domain.Entities.Location>)ViewBag.Locations)
                            {
                                <option value="@location.Id" selected="@(ViewBag.LocationId != null && ViewBag.LocationId.ToString() == location.Id.ToString())">
                                    @location.City/@location.State
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="startDateFrom" class="form-label">Data Início (De)</label>
                    <input type="date" class="form-control" id="startDateFrom" name="startDateFrom" 
                           value="@ViewBag.StartDateFrom">
                </div>
                <div class="col-md-2">
                    <label for="startDateTo" class="form-label">Data Início (Até)</label>
                    <input type="date" class="form-control" id="startDateTo" name="startDateTo" 
                           value="@ViewBag.StartDateTo">
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Filtrar
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || 
                 !string.IsNullOrEmpty(ViewBag.Status as string) || 
                 ViewBag.LocationId != null ||
                 !string.IsNullOrEmpty(ViewBag.StartDateFrom as string) ||
                 !string.IsNullOrEmpty(ViewBag.StartDateTo as string))
            {
                <div class="row mt-3">
                    <div class="col-12">
                        <a href="@Url.Action("ActiveContracts", "Coworking")" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-x-circle"></i> Limpar Filtros
                        </a>
                    </div>
                </div>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-list-check"></i> Lista de Contratos Ativos</h5>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Endereço</th>
                            <th>Localidade</th>
                            <th>Valor Mensal</th>
                            <th>Data Início</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model)
                        {
                            <tr>
                                <td>@contract.Id</td>
                                <td>
                                    <strong>@(contract.Client?.RazaoSocial ?? contract.Client?.ContactName ?? "N/A")</strong><br>
                                    <small class="text-muted">@(contract.Client?.CNPJ ?? contract.Client?.CPF ?? "")</small>
                                </td>
                                <td>
                                    @(contract.CoworkingAddress?.Address ?? "N/A"), @(contract.CoworkingAddress?.Number ?? "")
                                    @if (!string.IsNullOrEmpty(contract.CoworkingAddress?.Complement))
                                    {
                                        <br><small class="text-muted">@contract.CoworkingAddress.Complement</small>
                                    }
                                </td>
                                <td>
                                    @(contract.CoworkingAddress?.Location?.City ?? "N/A")/@(contract.CoworkingAddress?.Location?.State ?? "")
                                </td>
                                <td>
                                    <strong>R$ @(contract.Subscription?.MonthlyAmount.ToString("N2") ?? "0,00")</strong>
                                </td>
                                <td>@contract.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @switch (contract.Status)
                                    {
                                        case ContractStatus.Active:
                                            <span class="badge bg-success">Ativo</span>
                                            break;
                                        case ContractStatus.Suspended:
                                            <span class="badge bg-warning">Suspenso</span>
                                            break;
                                        case ContractStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelado</span>
                                            break;
                                        case ContractStatus.Expired:
                                            <span class="badge bg-secondary">Expirado</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@contract.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("ContractDetails", "Client", new { id = contract.Id })" 
                                       class="btn btn-sm btn-info" title="Ver Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <strong>Total de contratos:</strong> @(ViewBag.TotalItems ?? Model.Count)
                    @if (ViewBag.TotalItems != null && ViewBag.TotalItems > Model.Count)
                    {
                        <text>(Mostrando @Model.Count de @ViewBag.TotalItems)</text>
                    }
                </p>
            </div>

            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("ActiveContracts", "Coworking", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    locationId = ViewBag.LocationId,
                                    startDateFrom = ViewBag.StartDateFrom,
                                    startDateTo = ViewBag.StartDateTo,
                                    page = i 
                                })">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum contrato ativo no momento.
            </div>
        }
    </div>
</div>

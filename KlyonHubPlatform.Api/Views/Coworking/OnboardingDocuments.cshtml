@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Application.DTOs.ClientOnboarding
@using KlyonHubPlatform.Domain.Core.Enums
@model List<ClientOnboardingReviewItem>
@{
    ViewData[ViewDataKeys.Title] = "Documentos de clientes";
    Layout = LayoutPaths.Layout;
    var isAdmin = ViewBag.IsAdmin as bool? == true;
    var reviewAction = ActionNames.ReviewOnboardingDocuments;
    var reviewController = isAdmin ? ControllerNames.Admin : ControllerNames.Coworking;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-check"></i> Documentos para aprovação</h2>
</div>

<p class="text-muted">Contratos pagos aguardando análise de identidade (RG frente e verso + CPF, ou CNH) e comprovante de residência.</p>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">Nenhum documento pendente no momento.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Contrato</th>
                    <th>Cliente</th>
                    <th>Parceiro</th>
                    <th>Status</th>
                    <th>Envio</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var clientName = item.Contract.Client?.NomeFantasia
                        ?? item.Contract.Client?.RazaoSocial
                        ?? item.Contract.Client?.User?.FullName
                        ?? "Cliente";
                    var partner = item.Contract.CoworkingAddress?.Coworking?.TradeName
                        ?? item.Contract.CoworkingAddress?.Coworking?.Name;
                    <tr>
                        <td>@item.Contract.ContractNumber</td>
                        <td>@clientName</td>
                        <td>@partner</td>
                        <td>
                            @if (item.SetStatus == ClientOnboardingSetStatus.AwaitingApproval)
                            {
                                <span class="badge bg-warning text-dark">Aguardando aprovação</span>
                            }
                            else if (item.SetStatus == ClientOnboardingSetStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejeitado (reenvio)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.SetStatus</span>
                            }
                        </td>
                        <td>@(item.LastUploadAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" href="@Url.Action(reviewAction, reviewController, new { contractId = item.Contract.Id })">Revisar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

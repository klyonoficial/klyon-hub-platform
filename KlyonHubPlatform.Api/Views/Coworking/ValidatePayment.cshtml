@model KlyonHubPlatform.Domain.Entities.Payment
@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData["Title"] = "Validar Pagamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var contract = Model.Subscription?.Contract;
    var client = contract?.Client;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-check-circle"></i> Validar Pagamento #@Model.Id</h2>
    <a href="@Url.Action("PendingPayments", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Informações do Pagamento</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Cliente:</dt>
                    <dd class="col-sm-8">
                        <strong>@(client?.RazaoSocial ?? client?.ContactName ?? "N/A")</strong><br>
                        <small class="text-muted">@(client?.CNPJ ?? client?.CPF ?? "")</small>
                    </dd>

                    <dt class="col-sm-4">Endereço:</dt>
                    <dd class="col-sm-8">
                        @(contract?.CoworkingAddress?.Address ?? "N/A"), @(contract?.CoworkingAddress?.Number ?? "")<br>
                        @if (!string.IsNullOrEmpty(contract?.CoworkingAddress?.Complement))
                        {
                            <text>@contract.CoworkingAddress.Complement<br></text>
                        }
                        <small class="text-muted">@(contract?.CoworkingAddress?.City ?? "")/@(contract?.CoworkingAddress?.State ?? "") - CEP: @(contract?.CoworkingAddress?.ZipCode ?? "")</small>
                    </dd>

                    <dt class="col-sm-4">Valor:</dt>
                    <dd class="col-sm-8"><h4 class="text-primary mb-0">R$ @Model.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h4></dd>

                    <dt class="col-sm-4">Método de Pagamento:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Method)
                        {
                            case PaymentMethod.PIX:
                                <span class="badge bg-primary"><i class="bi bi-qr-code"></i> PIX</span>
                                break;
                            case PaymentMethod.CreditCard:
                                <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão de Crédito</span>
                                @if (Model.InstallmentCount.HasValue && Model.InstallmentValue.HasValue)
                                {
                                    <span class="text-muted ms-1">— @Model.InstallmentCount.Value x de R$ @Model.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span>
                                }
                                break;
                            case PaymentMethod.BankTransfer:
                                <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto Bancário</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Data de Vencimento:</dt>
                    <dd class="col-sm-8">@Model.DueDate.ToString(DateFormatConstants.DisplayDateOnly)</dd>

                    <dt class="col-sm-4">Data de Envio:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)</dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ReceiptFilePath))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-image"></i> Comprovante Enviado</h5>
                </div>
                <div class="card-body text-center">
                    <a href="@Url.Action("DownloadPaymentReceipt", "Coworking", new { paymentId = Model.Id })" 
                       class="btn btn-primary mb-3" target="_blank">
                        <i class="bi bi-download"></i> Baixar Comprovante
                    </a>
                    <p class="text-muted">
                        <i class="bi bi-info-circle"></i> 
                        Verifique o comprovante e confirme se o pagamento foi recebido na conta.
                    </p>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-check-circle"></i> Aprovar Pagamento</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    Ao aprovar, o pagamento será confirmado e o contrato será ativado automaticamente.
                </p>
                <form method="post" action="@Url.Action("ApprovePayment", "Coworking")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@Model.Id" />
                    <button type="submit" class="btn btn-success w-100" onclick="event.preventDefault(); handleApprovePaymentCoworking(this);">
                        <i class="bi bi-check-circle"></i> Aprovar Pagamento
                    </button>
                </form>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-x-circle"></i> Reprovar Pagamento</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("RejectPayment", "Coworking")" id="rejectForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="paymentId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="validationNotes" class="form-label">Justificativa da Reprovação:</label>
                        <textarea class="form-control" id="validationNotes" name="validationNotes" rows="4" required 
                                  placeholder="Informe o motivo da reprovação (ex: comprovante não confere, valor diferente, etc.)"></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100" onclick="event.preventDefault(); handleRejectPaymentCoworking(this);">
                        <i class="bi bi-x-circle"></i> Reprovar Pagamento
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('rejectForm')?.addEventListener('submit', function(e) {
            const notes = document.getElementById('validationNotes').value.trim();
            if (!notes) {
                e.preventDefault();
                showToast('Por favor, informe a justificativa da reprovação.', 'warning');
                return false;
            }
        });

        // Função para aprovar pagamento com confirmação elegante
        async function handleApprovePaymentCoworking(button) {
            const confirmed = await showConfirm(
                'Confirma a aprovação deste pagamento? O contrato será ativado automaticamente.',
                'Confirmar Aprovação',
                'success'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }

        // Função para reprovar pagamento com confirmação elegante
        async function handleRejectPaymentCoworking(button) {
            const confirmed = await showConfirm(
                'Confirma a reprovação deste pagamento?',
                'Confirmar Reprovação',
                'danger'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}

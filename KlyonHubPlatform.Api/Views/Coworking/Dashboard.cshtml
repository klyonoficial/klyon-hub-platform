@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@{
    ViewData["Title"] = "Dashboard Coworking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Verificar se os menus de coworking estão habilitados
    var enableCoworkingMenus = await SystemConfigurationService.GetValueAsync("Features.EnableCoworkingMenus");
    var showCoworkingMenus = enableCoworkingMenus?.ToLower() == "true";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-speedometer2"></i> Dashboard</h2>
</div>

@* Notificações especiais de mudança de status *@
@if (ViewBag.HasStatusNotification == true)
{
    var notificationType = (KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus)ViewBag.StatusNotificationType;
    
    if (notificationType == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.Approved)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-lg border-success mb-4" role="alert" style="border-width: 3px;">
            <h4 class="alert-heading">
                <i class="bi bi-trophy-fill"></i> Parabéns! Seu cadastro foi aprovado!
            </h4>
            <hr>
            <p class="mb-3">
                <i class="bi bi-check-circle-fill"></i> Seu espaço está agora disponível no marketplace e você já pode começar a receber clientes para endereços fiscais e serviços de coworking. 
                Desejamos muito sucesso! 🎉
            </p>
            <form method="post" action="@Url.Action("DismissStatusNotification", "Coworking")" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-sm">
                    <i class="bi bi-check"></i> Entendi
                </button>
            </form>
        </div>
    }
    else if (notificationType == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.AwaitingAdjustment)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow-lg border-warning mb-4" role="alert" style="border-width: 3px;">
            <h4 class="alert-heading">
                <i class="bi bi-exclamation-triangle-fill"></i> Atenção: Seu cadastro requer revisão
            </h4>
            <hr>
            <p class="mb-3">
                <i class="bi bi-info-circle-fill"></i> Infelizmente seu cadastro não foi aprovado e necessita de ajustes. 
                Por favor, revise as informações indicadas abaixo e reenvie para análise.
            </p>
            <form method="post" action="@Url.Action("DismissStatusNotification", "Coworking")" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning btn-sm">
                    <i class="bi bi-check"></i> Entendi
                </button>
            </form>
        </div>
    }
}

@if (ViewBag.Coworking == null)
{
    <div class="alert alert-info">
        <h5><i class="bi bi-info-circle"></i> Complete seu cadastro</h5>
        <p>Para começar a cadastrar endereços, você precisa completar o cadastro do seu coworking.</p>
        <a href="@Url.Action("Register", "Coworking")" class="btn btn-primary">
            <i class="bi bi-building"></i> Cadastrar Coworking
        </a>
    </div>
}
else
{
    var c = ViewBag.Coworking as KlyonHubPlatform.Domain.Entities.Coworking;
    var ast = c?.ApprovalStatus ?? KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.UnderReview;
    if (ast == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.UnderReview)
    {
        <div class="alert alert-warning mb-4">
            <i class="bi bi-hourglass-split"></i> <strong>Em análise.</strong> Seu cadastro está sendo analisado pela nossa equipe. Você será notificado quando houver uma definição.
        </div>
    }
    else if (ast == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.AwaitingAdjustment)
    {
        <div class="alert alert-secondary mb-4">
            <strong><i class="bi bi-exclamation-diamond"></i> Aguardando ajuste.</strong>
            @if (!string.IsNullOrEmpty(c?.RejectionReason))
            {
                <p class="mb-2 mt-2">Justificativa / itens a corrigir: <span class="text-dark">@c.RejectionReason</span></p>
            }
            <form method="post" action="@Url.Action("ResubmitForApproval", "Coworking")" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send"></i> Reenviar para análise</button>
            </form>
        </div>
    }
    else if (ast == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.Approved)
    {
        @* Só mostra esta mensagem se não houver uma notificação especial de aprovação sendo exibida acima *@
        @if (!(ViewBag.HasStatusNotification == true && (KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus)ViewBag.StatusNotificationType == KlyonHubPlatform.Domain.Core.Enums.CoworkingApprovalStatus.Approved))
        {
            <div class="alert alert-success mb-4">
                <i class="bi bi-check-circle"></i> <strong>Cadastro aprovado.</strong> 
                @if (showCoworkingMenus)
                {
                    <text>Seu espaço está disponível no marketplace para que clientes possam alugar.</text>
                }
                else
                {
                    <text>Você já pode cadastrar endereços fiscais e receber clientes.</text>
                }
            </div>
        }
    }

    @* Seção de Alertas Administrativos *@
    @if (ViewBag.AdministrativeAlerts != null && ((List<object>)ViewBag.AdministrativeAlerts).Any())
    {
        <div class="card border-warning shadow-sm mb-4">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle-fill"></i> Alertas Administrativos
                </h5>
                <span class="badge bg-dark">@(((List<object>)ViewBag.AdministrativeAlerts).Count) pendência(s)</span>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (dynamic alert in (List<object>)ViewBag.AdministrativeAlerts)
                    {
                        <div class="list-group-item border-start border-@alert.Type border-3 px-3 py-3">
                            <div class="d-flex align-items-start">
                                <i class="bi @alert.Icon text-@alert.Type me-3 mt-1" style="font-size: 1.3rem;"></i>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-bold">@alert.Title</h6>
                                    <p class="mb-2 text-muted small">@alert.Message</p>
                                    @if (alert.ActionUrl != null)
                                    {
                                        <a href="@alert.ActionUrl" class="btn btn-sm btn-@alert.Type mt-1">
                                            <i class="bi bi-arrow-right"></i> @alert.ActionText
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3 pt-3 border-top text-center">
                    <a href="@Url.Action("Profile", "Coworking")" class="btn btn-warning btn-lg">
                        <i class="bi bi-list-check"></i> Verificar Pendências
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-2">
            <div class="card text-white bg-primary" data-drilldown="@Url.Action("ActiveContracts", "Parceiro")">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-file-earmark-text"></i> Contratos de Endereço Fiscal</h5>
                    <h2 class="display-4">@ViewBag.ActiveContracts</h2>
                    <a href="@Url.Action("ActiveContracts", "Parceiro")" class="btn btn-light btn-sm mt-2 w-100">
                        <i class="bi bi-arrow-right"></i> Ver Todos
                    </a>
                </div>
            </div>
        </div>
        @if (showCoworkingMenus)
        {
            <div class="col-md-2">
                <div class="card text-white" style="background-color: #6f42c1;" data-drilldown="@Url.Action("Reservations", "Parceiro")">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-calendar-check"></i> Reservas</h5>
                        <h2 class="display-4">@(ViewBag.PendingReservationsCount ?? 0)</h2>
                        <a href="@Url.Action("Reservations", "Parceiro")" class="btn btn-light btn-sm mt-2 w-100">
                            <i class="bi bi-arrow-right"></i> Ver Todas
                        </a>
                    </div>
                </div>
            </div>
        }
        <div class="col-md-2">
            <div class="card text-white bg-warning" data-drilldown="@((ViewBag.PendingPaymentsCount ?? 0) > 0 ? Url.Action("PendingPayments", "Parceiro") : "#")">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-clock-history"></i> Pagamentos</h5>
                    <h2 class="display-4">@(ViewBag.PendingPaymentsCount ?? 0)</h2>
                    @if ((ViewBag.PendingPaymentsCount ?? 0) > 0)
                    {
                        <a href="@Url.Action("PendingPayments", "Parceiro")" class="btn btn-light btn-sm mt-2 w-100">
                            <i class="bi bi-arrow-right"></i> Validar
                        </a>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success" data-drilldown="@Url.Action("Commissions", "Parceiro")">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-trophy-fill"></i> Ganhos Pendentes</h5>
                    <h2 class="mb-0" style="font-size: 2.2rem; font-weight: 700; line-height: 1.2; white-space: nowrap;">R$ @(((decimal)ViewBag.PendingCommissions).ToString("F2"))</h2>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card text-white bg-info" data-drilldown="@Url.Action("MyAddresses", "Parceiro")">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-building"></i> Endereços</h5>
                    <h2 class="display-4">@(ViewBag.TotalAddresses ?? 0)</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-trophy-fill"></i> Ganhos Pendentes</h5>
        </div>
        <div class="card-body">
            @if (ViewBag.Commissions != null && ((List<KlyonHubPlatform.Domain.Entities.Commission>)ViewBag.Commissions).Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Valor Recebido pelo Cliente</th>
                                <th>Valor Creditado para Você</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var commission in (List<KlyonHubPlatform.Domain.Entities.Commission>)ViewBag.Commissions)
                            {
                                var valorCreditado = commission.TotalPaymentAmount - commission.Amount;
                                <tr>
                                    <td>@commission.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="text-muted">R$ @commission.TotalPaymentAmount.ToString("F2")</span>
                                        <br><small class="text-muted">(@commission.Percentage.ToString("F2")% de comissão da plataforma)</small>
                                    </td>
                                    <td><strong class="text-success" style="font-size: 1.1em;">R$ @valorCreditado.ToString("F2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <form method="post" action="@Url.Action("RequestTransfer", "Coworking")">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-arrow-left-right"></i> Solicitar Repasse
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Não há ganhos pendentes no momento.
                </div>
            }
        </div>
    </div>
}

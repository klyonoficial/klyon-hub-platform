@{
    ViewData["Title"] = "Meu Contrato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.PartnerService>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Meu Contrato</h2>
    <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Percentagens por Serviço</h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-4">
            <i class="bi bi-lock"></i> As percentagens abaixo foram definidas em contrato e não podem ser alteradas.
        </p>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Serviço</th>
                            <th class="text-end">Percentagem (%)</th>
                            <th>Data do Contrato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var partnerService in Model.OrderBy(ps => ps.Service.Name))
                        {
                            <tr>
                                <td>
                                    <strong>@partnerService.Service.Name</strong>
                                    @if (!string.IsNullOrEmpty(partnerService.Service.Description))
                                    {
                                        <br><small class="text-muted">@partnerService.Service.Description</small>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-primary fs-6">@partnerService.Percentage.ToString("F2")%</span>
                                </td>
                                <td>
                                    @partnerService.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum serviço contratado encontrado.
            </div>
        }
    </div>
</div>

@{
    ViewData["Title"] = "Meus Ganhos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Commission>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trophy-fill text-warning"></i> Meus Ganhos</h2>
    <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<!-- Resumo -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="bi bi-wallet2"></i> Total Ganho</h6>
                <h2 class="mb-0">R$ @(Model.Sum(c => c.TotalPaymentAmount - c.Amount).ToString("N2"))</h2>
                <small class="text-white-50">Valor total creditado</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="bi bi-hourglass-split"></i> Aguardando Repasse</h6>
                <h2 class="mb-0">R$ @(Model.Where(c => !c.IsTransferred).Sum(c => c.TotalPaymentAmount - c.Amount).ToString("N2"))</h2>
                <small class="text-white-50">Disponível para transferência</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="bi bi-check-circle-fill"></i> Já Recebido</h6>
                <h2 class="mb-0">R$ @(Model.Where(c => c.IsTransferred).Sum(c => c.TotalPaymentAmount - c.Amount).ToString("N2"))</h2>
                <small class="text-white-50">Valor já transferido</small>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-list-check"></i> Histórico de Ganhos</h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Data do Pagamento</th>
                            <th>Valor Recebido pelo Cliente</th>
                            <th>Valor Creditado para Você</th>
                            <th>Status</th>
                            <th>Data do Repasse</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commission in Model)
                        {
                            var valorCreditado = commission.TotalPaymentAmount - commission.Amount;
                            <tr>
                                <td>@commission.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="text-muted">R$ @commission.TotalPaymentAmount.ToString("N2")</span>
                                    <br><small class="text-muted">(@commission.Percentage.ToString("F2")% de comissão da plataforma)</small>
                                </td>
                                <td>
                                    <strong class="text-success" style="font-size: 1.1em;">R$ @valorCreditado.ToString("N2")</strong>
                                </td>
                                <td>
                                    @{
                                        var transferMap = ViewBag.CommissionTransferMap as Dictionary<int, KlyonHubPlatform.Domain.Entities.Transfer?>;
                                        var transfer = transferMap != null && transferMap.ContainsKey(commission.Id) ? transferMap[commission.Id] : null;
                                        
                                        if (transfer != null)
                                        {
                                            // Exibir status baseado no status real da transferência
                                            switch (transfer.Status)
                                            {
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending:
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pendente</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Processing:
                                                    <span class="badge bg-primary"><i class="bi bi-arrow-repeat"></i> Em Processamento</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed:
                                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Repasse Realizado</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Failed:
                                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Repasse Falhou</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Cancelled:
                                                    <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Repasse Cancelado</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pendente</span>
                                                    break;
                                            }
                                        }
                                        else if (commission.IsTransferred)
                                        {
                                            // Se está marcado como transferido mas não encontrou a transferência, assumir como realizado (casos antigos)
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Repasse Realizado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning"><i class="bi bi-hourglass-split"></i> Aguardando Repasse</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @{
                                        var transferMap2 = ViewBag.CommissionTransferMap as Dictionary<int, KlyonHubPlatform.Domain.Entities.Transfer?>;
                                        var transfer2 = transferMap2 != null && transferMap2.ContainsKey(commission.Id) ? transferMap2[commission.Id] : null;
                                        
                                        if (transfer2 != null && transfer2.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed && transfer2.ProcessedAt.HasValue)
                                        {
                                            <span class="text-success">
                                                <i class="bi bi-calendar-check"></i> @transfer2.ProcessedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                        else if (commission.TransferredAt.HasValue)
                                        {
                                            // Casos antigos onde a comissão já foi marcada como transferida
                                            <span class="text-success">
                                                <i class="bi bi-calendar-check"></i> @commission.TransferredAt.Value.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                var transferMap = ViewBag.CommissionTransferMap as Dictionary<int, KlyonHubPlatform.Domain.Entities.Transfer?>;
                var hasEligibleCommission = Model.Any(c =>
                {
                    if (transferMap != null && transferMap.ContainsKey(c.Id) && transferMap[c.Id] != null)
                    {
                        var transfer = transferMap[c.Id];
                        var status = transfer.Status;
                        // Verifica se o status é diferente de Pendente e Repasse Realizado
                        return status != KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending &&
                               status != KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed;
                    }
                    else if (!c.IsTransferred)
                    {
                        // Se não tem transferência associada e não está transferido, está aguardando repasse
                        return true;
                    }
                    return false;
                });
            }
            
            @if (hasEligibleCommission)
            {
                var totalPendente = Model.Where(c => !c.IsTransferred).Sum(c => c.TotalPaymentAmount - c.Amount);
                <div class="mt-4 p-3 bg-light rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1"><i class="bi bi-info-circle text-primary"></i> Você tem ganhos disponíveis para repasse!</h6>
                            <p class="mb-0 text-muted">Total disponível: <strong class="text-success">R$ @totalPendente.ToString("N2")</strong></p>
                        </div>
                        <form method="post" action="@Url.Action("RequestTransfer", "Coworking")" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-lg" onclick="event.preventDefault(); handleRequestTransfer(this);">
                                <i class="bi bi-arrow-down-circle"></i> Solicitar Repasse Agora
                            </button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center py-5">
                <i class="bi bi-info-circle" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Ainda não há ganhos registrados</h5>
                <p class="mb-0">Seus ganhos aparecerão aqui assim que os pagamentos forem aprovados pelo administrador.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function handleRequestTransfer(button) {
            const confirmed = await showConfirm(
                'Deseja solicitar o repasse de todos os seus ganhos pendentes? O valor será transferido para sua conta bancária cadastrada.',
                'Solicitar Repasse',
                'success'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}

@{
    ViewData["Title"] = "Meus Ganhos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var transferMap = ViewBag.CommissionTransferMap as Dictionary<int, KlyonHubPlatform.Domain.Entities.Transfer?>;
    var transferIdsAllNfEmitida = ViewBag.TransferIdsAllNfEmitida as System.Collections.Generic.HashSet<int> ?? new System.Collections.Generic.HashSet<int>();
}
<style>
    .commission-row { cursor: pointer; }
    .commission-row:hover { background-color: rgba(102, 126, 234, 0.08) !important; }
</style>

@model List<KlyonHubPlatform.Domain.Entities.Commission>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trophy-fill text-warning"></i> Meus Ganhos</h2>
    <a href="@Url.Action("Dashboard", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<!-- Resumo -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="bi bi-wallet2"></i> Total Ganho</h6>
                <h2 class="mb-0">R$ @(Model.Sum(c => c.TotalPaymentAmount - c.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals))</h2>
                <small class="text-white-50">Valor total creditado</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="bi bi-hourglass-split"></i> Aguardando Repasse</h6>
                <h2 class="mb-0">R$ @(Model.Where(c => !c.IsTransferred).Sum(c => c.TotalPaymentAmount - c.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals))</h2>
                <small class="text-white-50">Disponível para transferência</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
            <div class="card-body">
                <h6 class="card-title mb-2"><i class="bi bi-check-circle-fill"></i> Já Recebido</h6>
                <h2 class="mb-0">R$ @(Model.Where(c => c.IsTransferred).Sum(c => c.TotalPaymentAmount - c.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals))</h2>
                <small class="text-white-50">Valor já transferido</small>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-list-check"></i> Histórico de Ganhos</h5>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Data do Pagamento</th>
                            <th>Valor Recebido pelo Cliente</th>
                            <th>Valor Creditado para Você</th>
                            <th>Status</th>
                            <th>Data do Repasse</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commission in Model)
                        {
                            var valorCreditado = commission.TotalPaymentAmount - commission.Amount;
                            var transfer = transferMap != null && transferMap.ContainsKey(commission.Id) ? transferMap[commission.Id] : null;
                            var nfEmitidaParaTransfer = transfer != null && transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice && transferIdsAllNfEmitida.Contains(transfer.Id);
                            var statusTexto = transfer != null
                                ? (transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending ? "Pendente"
                                    : transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Processing ? "Em Processamento"
                                    : transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice ? (nfEmitidaParaTransfer ? "NF Emitida" : "Aguardando NF")
                                    : transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed ? "Repasse Realizado"
                                    : transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Failed ? "Repasse Falhou"
                                    : transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Cancelled ? "Repasse Cancelado"
                                    : "Pendente")
                                : commission.IsTransferred ? "Repasse Realizado" : "Aguardando Repasse";
                            var dataRepasse = transfer != null && transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed && transfer.ProcessedAt.HasValue
                                ? transfer.ProcessedAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)
                                : transfer != null && transfer.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice && transfer.ScheduledDate != default
                                    ? transfer.ScheduledDate.ToString(DateFormatConstants.DisplayDateOnly)
                                    : commission.TransferredAt.HasValue ? commission.TransferredAt.Value.ToString(DateFormatConstants.DisplayDateAndTime) : "";
                            <tr class="commission-row cursor-pointer" role="button" tabindex="0"
                                data-id="@commission.Id"
                                data-created="@commission.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)"
                                data-total-pago="@commission.TotalPaymentAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)"
                                data-percentual="@commission.Percentage.ToString(NumberFormatConstants.TwoDecimals)"
                                data-valor-creditado="@valorCreditado.ToString(NumberFormatConstants.CurrencyTwoDecimals)"
                                data-status="@statusTexto"
                                data-repasse="@dataRepasse"
                                data-transferido="@(commission.IsTransferred ? "Sim" : "Não")"
                                data-transfer-status="@(transfer?.Status.ToString() ?? "")"
                                data-transfer-id="@(transfer?.Id.ToString() ?? "")"
                                data-transfer-amount="@(transfer?.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals) ?? "")"
                                data-transfer-created="@(transfer?.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime) ?? "")"
                                data-transfer-processed="@(transfer?.ProcessedAt?.ToString(DateFormatConstants.DisplayDateAndTime) ?? "")"
                                data-transfer-scheduled="@(transfer?.ScheduledDate != default ? transfer.ScheduledDate.ToString(DateFormatConstants.DisplayDateOnly) : "")"
                                data-transfer-failure="@(transfer?.FailureReason ?? "")"
                                data-payment-id="@commission.PaymentId"
                                data-payment-amount="@(commission.Payment?.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals) ?? "")"
                                data-payment-status="@(commission.Payment?.Status.ToString() ?? "")"
                                data-payment-method="@(commission.Payment?.Method.ToString() ?? "")"
                                data-payment-paid="@(commission.Payment?.PaidAt?.ToString(DateFormatConstants.DisplayDateAndTime) ?? "")"
                                data-payment-transaction="@(commission.Payment?.TransactionId ?? "")">
                                <td>@commission.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)</td>
                                <td>
                                    <span class="text-muted">R$ @commission.TotalPaymentAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span>
                                    <br><small class="text-muted">(@commission.Percentage.ToString(NumberFormatConstants.TwoDecimals)% de comissão da plataforma)</small>
                                </td>
                                <td>
                                    <strong class="text-success" style="font-size: 1.1em;">R$ @valorCreditado.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong>
                                </td>
                                <td>
                                    @{
                                        if (transfer != null)
                                        {
                                            // Exibir status baseado no status real da transferência
                                            switch (transfer.Status)
                                            {
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending:
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pendente</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Processing:
                                                    <span class="badge bg-primary"><i class="bi bi-arrow-repeat"></i> Em Processamento</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice:
                                                    if (transferIdsAllNfEmitida.Contains(transfer.Id))
                                                    {
                                                        <span class="badge bg-success"><i class="bi bi-file-earmark-check-fill"></i> NF Emitida</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-info"><i class="bi bi-file-earmark-check"></i> Aguardando NF</span>
                                                    }
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed:
                                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Repasse Realizado</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Failed:
                                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Repasse Falhou</span>
                                                    break;
                                                case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Cancelled:
                                                    <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Repasse Cancelado</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pendente</span>
                                                    break;
                                            }
                                        }
                                        else if (commission.IsTransferred)
                                        {
                                            // Se está marcado como transferido mas não encontrou a transferência, assumir como realizado (casos antigos)
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Repasse Realizado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning"><i class="bi bi-hourglass-split"></i> Aguardando Repasse</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @{
                                        var transfer2 = transferMap != null && transferMap.ContainsKey(commission.Id) ? transferMap[commission.Id] : null;
                                        
                                        if (transfer2 != null && transfer2.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice && transfer2.ScheduledDate != default)
                                        {
                                            <span class="text-info" title="Repasse agendado">
                                                <i class="bi bi-calendar-event"></i> @transfer2.ScheduledDate.ToString(DateFormatConstants.DisplayDateOnly)
                                            </span>
                                        }
                                        else if (transfer2 != null && transfer2.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed && transfer2.ProcessedAt.HasValue)
                                        {
                                            <span class="text-success">
                                                <i class="bi bi-calendar-check"></i> @transfer2.ProcessedAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)
                                            </span>
                                        }
                                        else if (commission.TransferredAt.HasValue)
                                        {
                                            // Casos antigos onde a comissão já foi marcada como transferida
                                            <span class="text-success">
                                                <i class="bi bi-calendar-check"></i> @commission.TransferredAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            {
                var hasEligibleCommission = false;

                foreach (var c in Model)
                {
                    Transfer? transfer = null;

                    if (transferMap != null && transferMap.ContainsKey(c.Id))
                    {
                        transfer = transferMap[c.Id];
                    }

                    if (transfer != null)
                    {
                        var status = transfer.Status;
                        // Elegível para solicitar repasse: apenas quando não tem transfer ou está realmente pendente (sem transfer)
                        // Pendente, Aguardando NF e Repasse Realizado não exibem o botão "Solicitar Repasse Agora"
                        if (status != KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending &&
                            status != KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed &&
                            status != KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice)
                        {
                            hasEligibleCommission = true;
                            break;
                        }
                    }
                    else if (!c.IsTransferred)
                    {
                        // Se não tem transferência associada e não está transferido, está aguardando repasse
                        hasEligibleCommission = true;
                        break;
                    }
                }

                if (hasEligibleCommission)
                {
                    var totalPendente = Model.Where(c => !c.IsTransferred).Sum(c => c.TotalPaymentAmount - c.Amount);
                    <div class="mt-4 p-3 bg-light rounded">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1"><i class="bi bi-info-circle text-primary"></i> Você tem ganhos disponíveis para repasse!</h6>
                                <p class="mb-0 text-muted">Total disponível: <strong class="text-success">R$ @totalPendente.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></p>
                            </div>
                            <form method="post" action="@Url.Action("RequestTransfer", "Coworking")" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-lg" onclick="event.preventDefault(); handleRequestTransfer(this);">
                                    <i class="bi bi-arrow-down-circle"></i> Solicitar Repasse Agora
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="alert alert-info text-center py-5">
                <i class="bi bi-info-circle" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Ainda não há ganhos registrados</h5>
                <p class="mb-0">Seus ganhos aparecerão aqui assim que os pagamentos forem aprovados pelo administrador.</p>
            </div>
        }
    </div>
</div>

@* Modal com detalhes da comissão *@
<div class="modal fade" id="commissionDetailModal" tabindex="-1" aria-labelledby="commissionDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <h5 class="modal-title" id="commissionDetailModalLabel">
                    <i class="bi bi-receipt me-2"></i> Detalhes do Ganho
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" id="commissionDetailModalBody">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Data do pagamento</dt>
                    <dd class="col-sm-7" id="modal-created"></dd>

                    <dt class="col-sm-5 text-muted">Valor pago pelo cliente</dt>
                    <dd class="col-sm-7" id="modal-total-pago"></dd>

                    <dt class="col-sm-5 text-muted">Percentual de comissão</dt>
                    <dd class="col-sm-7" id="modal-percentual"></dd>

                    <dt class="col-sm-5 text-muted">Valor creditado para você</dt>
                    <dd class="col-sm-7"><strong class="text-success" id="modal-valor-creditado"></strong></dd>

                    <dt class="col-sm-5 text-muted">Status</dt>
                    <dd class="col-sm-7" id="modal-status"></dd>

                    <dt class="col-sm-5 text-muted">Data do repasse</dt>
                    <dd class="col-sm-7" id="modal-repasse"></dd>

                    <dt class="col-sm-5 text-muted">Já transferido?</dt>
                    <dd class="col-sm-7" id="modal-transferido"></dd>

                    <hr class="my-3"/>

                    <dt class="col-sm-5 text-muted">ID do pagamento</dt>
                    <dd class="col-sm-7" id="modal-payment-id"></dd>

                    <dt class="col-sm-5 text-muted">Valor do pagamento</dt>
                    <dd class="col-sm-7" id="modal-payment-amount"></dd>

                    <dt class="col-sm-5 text-muted">Status do pagamento</dt>
                    <dd class="col-sm-7" id="modal-payment-status"></dd>

                    <dt class="col-sm-5 text-muted">Forma de pagamento</dt>
                    <dd class="col-sm-7" id="modal-payment-method"></dd>

                    <dt class="col-sm-5 text-muted">Data do pagamento (confirmação)</dt>
                    <dd class="col-sm-7" id="modal-payment-paid"></dd>

                    <dt class="col-sm-5 text-muted">ID da transação</dt>
                    <dd class="col-sm-7 text-break" id="modal-payment-transaction"></dd>

                    <div id="modal-transfer-section" class="w-100 mt-2 d-none">
                        <hr class="my-3"/>
                        <h6 class="text-muted mb-2"><i class="bi bi-arrow-down-up me-1"></i> Repasse</h6>
                        <dt class="col-sm-5 text-muted">Valor do repasse</dt>
                        <dd class="col-sm-7" id="modal-transfer-amount"></dd>
                        <dt class="col-sm-5 text-muted">Data da solicitação</dt>
                        <dd class="col-sm-7" id="modal-transfer-created"></dd>
                        <dt class="col-sm-5 text-muted">Data do processamento</dt>
                        <dd class="col-sm-7" id="modal-transfer-processed"></dd>
                        <dt class="col-sm-5 text-muted">Data agendada</dt>
                        <dd class="col-sm-7" id="modal-transfer-scheduled"></dd>
                        <dt class="col-sm-5 text-muted text-danger">Motivo da falha</dt>
                        <dd class="col-sm-7 text-danger" id="modal-transfer-failure"></dd>
                    </div>
                </dl>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('commissionDetailModal');
            if (!modalEl) return;
            var modal = new bootstrap.Modal(modalEl);

            function escapeHtml(s) {
                if (s == null || s === '') return '-';
                var div = document.createElement('div');
                div.textContent = s;
                return div.innerHTML;
            }

            function setEl(id, html) {
                var el = document.getElementById(id);
                if (el) el.innerHTML = html;
            }

            document.querySelectorAll('.commission-row').forEach(function (row) {
                row.addEventListener('click', function () {
                    setEl('modal-created', escapeHtml(row.dataset.created));
                    setEl('modal-total-pago', 'R$ ' + escapeHtml(row.dataset.totalPago));
                    setEl('modal-percentual', escapeHtml(row.dataset.percentual) + '%');
                    setEl('modal-valor-creditado', 'R$ ' + escapeHtml(row.dataset.valorCreditado));
                    setEl('modal-status', escapeHtml(row.dataset.status));
                    setEl('modal-repasse', escapeHtml(row.dataset.repasse) || '-');
                    setEl('modal-transferido', escapeHtml(row.dataset.transferido));
                    setEl('modal-payment-id', escapeHtml(row.dataset.paymentId));
                    setEl('modal-payment-amount', row.dataset.paymentAmount ? 'R$ ' + escapeHtml(row.dataset.paymentAmount) : '-');
                    setEl('modal-payment-status', escapeHtml(row.dataset.paymentStatus) || '-');
                    setEl('modal-payment-method', escapeHtml(row.dataset.paymentMethod) || '-');
                    setEl('modal-payment-paid', escapeHtml(row.dataset.paymentPaid) || '-');
                    setEl('modal-payment-transaction', escapeHtml(row.dataset.paymentTransaction) || '-');

                    var transferSection = document.getElementById('modal-transfer-section');
                    if (row.dataset.transferId) {
                        transferSection.classList.remove('d-none');
                        setEl('modal-transfer-amount', row.dataset.transferAmount ? 'R$ ' + escapeHtml(row.dataset.transferAmount) : '-');
                        setEl('modal-transfer-created', escapeHtml(row.dataset.transferCreated) || '-');
                        setEl('modal-transfer-processed', escapeHtml(row.dataset.transferProcessed) || '-');
                        setEl('modal-transfer-scheduled', escapeHtml(row.dataset.transferScheduled) || '-');
                        setEl('modal-transfer-failure', escapeHtml(row.dataset.transferFailure) || '-');
                    } else {
                        transferSection.classList.add('d-none');
                    }

                    modal.show();
                });
                row.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        row.click();
                    }
                });
            });
        })();

        async function handleRequestTransfer(button) {
            const confirmed = await showConfirm(
                'Deseja solicitar o repasse de todos os seus ganhos pendentes? O valor será transferido para sua conta bancária cadastrada.',
                'Solicitar Repasse',
                'success'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}

@model List<KlyonHubPlatform.Domain.Entities.Payment>
@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData["Title"] = "Pagamentos Pendentes de Validação";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-clock-history"></i> Pagamentos Pendentes de Validação</h2>
    <a href="@Url.Action(ActionNames.Dashboard, ControllerNames.Parceiro)" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@{
    var search = ViewBag.Search as string ?? "";
    var method = ViewBag.Method as string ?? "";
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var minValue = ViewBag.MinValue as decimal?;
    var maxValue = ViewBag.MaxValue as decimal?;
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros de Pesquisa</h5>
    </div>
    <div class="card-body">
        <form method="get" action="@Url.Action(ActionNames.PendingPayments, ControllerNames.Parceiro)" id="filterForm">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="search" class="form-label">Buscar</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="@search" placeholder="Nº pagamento, cliente ou documento">
                </div>
                <div class="col-md-2 mb-3">
                    <label for="method" class="form-label">Método</label>
                    <select class="form-select" id="method" name="method">
                        <option value="">Todos</option>
                        <option value="PIX" selected="@(method == "PIX")">PIX</option>
                        <option value="CreditCard" selected="@(method == "CreditCard")">Cartão</option>
                        <option value="BankTransfer" selected="@(method == "BankTransfer")">Boleto</option>
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label for="dateFrom" class="form-label">Data De</label>
                    <input type="date" class="form-control" id="dateFrom" name="dateFrom" 
                           value="@(dateFrom?.ToString("yyyy-MM-dd") ?? "")">
                </div>
                <div class="col-md-2 mb-3">
                    <label for="dateTo" class="form-label">Data Até</label>
                    <input type="date" class="form-control" id="dateTo" name="dateTo" 
                           value="@(dateTo?.ToString("yyyy-MM-dd") ?? "")">
                </div>
                <div class="col-md-1 mb-3">
                    <label for="minValue" class="form-label">Valor Mín.</label>
                    <input type="number" step="0.01" class="form-control" id="minValue" name="minValue" 
                           value="@(minValue?.ToString(NumberFormatConstants.TwoDecimals) ?? "")" placeholder="0,00">
                </div>
                <div class="col-md-1 mb-3">
                    <label for="maxValue" class="form-label">Valor Máx.</label>
                    <input type="number" step="0.01" class="form-control" id="maxValue" name="maxValue" 
                           value="@(maxValue?.ToString(NumberFormatConstants.TwoDecimals) ?? "")" placeholder="0,00">
                </div>
                <div class="col-md-1 mb-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Pesquisar
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(method) || dateFrom.HasValue || dateTo.HasValue || minValue.HasValue || maxValue.HasValue)
            {
                <div class="row">
                    <div class="col-12">
                        <a href="@Url.Action(ActionNames.PendingPayments, ControllerNames.Parceiro)" class="btn btn-secondary btn-sm">
                            <i class="bi bi-x-circle"></i> Limpar Filtros
                        </a>
                    </div>
                </div>
            }
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Nº Pagamento</th>
                            <th>Cliente</th>
                            <th>Endereço</th>
                            <th>Valor</th>
                            <th>Método</th>
                            <th>Data Envio</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            var contract = payment.Subscription?.Contract;
                            var client = contract?.Client;
                            <tr>
                                <td><strong>#@payment.Id</strong></td>
                                <td>
                                    @(client?.RazaoSocial ?? client?.ContactName ?? "N/A")<br>
                                    <small class="text-muted">@(client?.CNPJ ?? client?.CPF ?? "")</small>
                                </td>
                                <td>
                                    @(contract?.CoworkingAddress?.Address ?? "N/A"), @(contract?.CoworkingAddress?.Number ?? "")<br>
                                    <small class="text-muted">@(contract?.CoworkingAddress?.City ?? "")/@(contract?.CoworkingAddress?.State ?? "")</small>
                                </td>
                                <td><strong>R$ @payment.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></td>
                                <td>
                                    @switch (payment.Method)
                                    {
                                        case PaymentMethod.PIX:
                                            <span class="badge bg-primary"><i class="bi bi-qr-code"></i> PIX</span>
                                            break;
                                        case PaymentMethod.CreditCard:
                                            <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão</span>
                                            @if (payment.InstallmentCount.HasValue && payment.InstallmentValue.HasValue)
                                            {
                                                <br><small class="text-muted">@payment.InstallmentCount.Value x de R$ @payment.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</small>
                                            }
                                            break;
                                        case PaymentMethod.BankTransfer:
                                            <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto</span>
                                            break;
                                    }
                                </td>
                                <td>@payment.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(payment.ReceiptFilePath))
                                    {
                                        <a href="@Url.Action(ActionNames.DownloadPaymentReceipt, ControllerNames.Parceiro, new { paymentId = payment.Id })" 
                                           class="btn btn-sm btn-outline-secondary me-1" target="_blank" title="Ver comprovante enviado pelo cliente">
                                            <i class="bi bi-file-earmark-arrow-down"></i> Comprovante
                                        </a>
                                    }
                                    <a href="@Url.Action(ActionNames.ValidatePayment, ControllerNames.Parceiro, new { id = payment.Id })" class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> Validar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> 
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(method) || dateFrom.HasValue || dateTo.HasValue || minValue.HasValue || maxValue.HasValue)
        {
            <text>Nenhum pagamento encontrado com os filtros aplicados.</text>
        }
        else
        {
            <text>Não há pagamentos pendentes de validação no momento.</text>
        }
    </div>
}

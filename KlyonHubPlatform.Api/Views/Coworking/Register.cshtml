@{
    ViewData[ViewDataKeys.Title] = "Cadastro de Parceiro";
    Layout = LayoutPaths.Layout;
    var locations = ViewBag.Locations as List<KlyonHubPlatform.Domain.Entities.Location> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building"></i> Cadastro do seu espaço</h2>
</div>

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2" id="wizardSteps">
            <span class="badge rounded-pill bg-primary wizard-step-badge" data-step="1">1. Empresa</span>
            <i class="bi bi-chevron-right text-muted d-none d-md-inline"></i>
            <span class="badge rounded-pill bg-secondary wizard-step-badge" data-step="2">2. Endereço fiscal</span>
            <i class="bi bi-chevron-right text-muted d-none d-md-inline"></i>
            <span class="badge rounded-pill bg-secondary wizard-step-badge" data-step="3">3. Documentos</span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" action="@Url.Action("Register", "Coworking")" enctype="multipart/form-data" id="partnerWizardForm" novalidate>
            <!-- Step 1: Empresa -->
            <div class="wizard-panel" data-panel="1">
                <h5 class="mb-3"><i class="bi bi-building"></i> Dados da empresa</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="Name" class="form-label">Razão Social <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Name" name="Name" value="@ViewBag.UserFullName" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="CNPJ" class="form-label">CNPJ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="CNPJ" name="CNPJ" placeholder="00.000.000/0000-00" maxlength="18" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="TradeName" class="form-label">Nome Fantasia</label>
                        <input type="text" class="form-control" id="TradeName" name="TradeName">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="LegalRepresentative" class="form-label">Representante Legal <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="LegalRepresentative" name="LegalRepresentative" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="PropertyRegistration" class="form-label">Inscrição Imobiliária <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="PropertyRegistration" name="PropertyRegistration" maxlength="50" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="ContactEmail" class="form-label">E-mail de contato <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="ContactEmail" name="ContactEmail" value="@ViewBag.UserEmail" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ContactPhone" class="form-label">Telefone</label>
                        <input type="text" class="form-control" id="ContactPhone" name="ContactPhone" placeholder="(00) 00000-0000" maxlength="15">
                    </div>
                </div>
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-primary" data-wizard-next="2">Próximo: Endereço <i class="bi bi-arrow-right"></i></button>
                </div>
            </div>

            <!-- Step 2: Endereço -->
            <div class="wizard-panel d-none" data-panel="2">
                <h5 class="mb-3"><i class="bi bi-geo-alt"></i> Endereço fiscal ofertado</h5>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="ZipCode" class="form-label">CEP <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ZipCode" name="zipCode" placeholder="00000-000" maxlength="9" required>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label for="Address" class="form-label">Logradouro <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Address" name="address" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label for="Number" class="form-label">Número <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Number" name="number" required>
                    </div>
                    <div class="col-md-5 mb-3">
                        <label for="Complement" class="form-label">Complemento</label>
                        <input type="text" class="form-control" id="Complement" name="complement">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="Neighborhood" class="form-label">Bairro <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Neighborhood" name="neighborhood" required>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="LocationId" class="form-label">Cidade / Localidade <span class="text-danger">*</span></label>
                        <select class="form-select" id="LocationId" name="locationId" required>
                            <option value="">Selecione...</option>
                            @foreach (var loc in locations)
                            {
                                <option value="@loc.Id" data-state="@loc.State" data-city="@loc.City">@loc.City/@loc.State</option>
                            }
                        </select>
                        <input type="hidden" id="City" name="city" value="">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="State" class="form-label">UF <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="State" name="state" maxlength="2" required readonly>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="BasePrice" class="form-label">Preço anual (R$) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="BasePrice" name="basePrice" min="0" step="0.01" required>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-wizard-prev="1"><i class="bi bi-arrow-left"></i> Voltar</button>
                    <button type="button" class="btn btn-primary" data-wizard-next="3">Próximo: Documentos <i class="bi bi-arrow-right"></i></button>
                </div>
            </div>

            <!-- Step 3: Documentos -->
            <div class="wizard-panel d-none" data-panel="3">
                <h5 class="mb-3"><i class="bi bi-file-earmark-text"></i> Documentos obrigatórios</h5>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Após o envio, sua candidatura entra em análise. A comissão e a publicação do endereço são definidas pela equipe Klyon.
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="UtilityBill" class="form-label">Comprovante de endereço <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="UtilityBill" name="UtilityBill" accept=".pdf,.jpg,.jpeg,.png" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="AddressAuthorization" class="form-label">Declaração de autorização <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="AddressAuthorization" name="AddressAuthorization" accept=".pdf,.jpg,.jpeg,.png" required>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="CNPJCard" class="form-label">Cartão CNPJ <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="CNPJCard" name="CNPJCard" accept=".pdf,.jpg,.jpeg,.png" required>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="Photos" class="form-label">Fotos do espaço (opcional)</label>
                    <input type="file" class="form-control" id="Photos" name="Photos" multiple accept="image/*">
                    <small class="form-text text-muted">Até 2 fotos serão processadas no cadastro inicial.</small>
                </div>
                <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" data-wizard-prev="2"><i class="bi bi-arrow-left"></i> Voltar</button>
                    <button type="submit" class="btn btn-success" data-funnel="partner_wizard_submit">
                        <i class="bi bi-check-circle"></i> Enviar candidatura
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var currentStep = 1;
    var badges = document.querySelectorAll('.wizard-step-badge');
    var panels = document.querySelectorAll('.wizard-panel');

    function showStep(n) {
        currentStep = n;
        panels.forEach(function (p) {
            p.classList.toggle('d-none', parseInt(p.getAttribute('data-panel'), 10) !== n);
        });
        badges.forEach(function (b) {
            var s = parseInt(b.getAttribute('data-step'), 10);
            b.classList.toggle('bg-primary', s === n);
            b.classList.toggle('bg-secondary', s !== n);
            b.classList.toggle('bg-success', s < n);
        });
    }

    document.querySelectorAll('[data-wizard-next]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var next = parseInt(btn.getAttribute('data-wizard-next'), 10);
            var panel = document.querySelector('.wizard-panel[data-panel="' + currentStep + '"]');
            var inputs = panel.querySelectorAll('input[required], select[required]');
            for (var i = 0; i < inputs.length; i++) {
                if (!inputs[i].checkValidity()) { inputs[i].reportValidity(); return; }
            }
            showStep(next);
        });
    });
    document.querySelectorAll('[data-wizard-prev]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            showStep(parseInt(btn.getAttribute('data-wizard-prev'), 10));
        });
    });

    var locSelect = document.getElementById('LocationId');
    var cityHidden = document.getElementById('City');
    var stateInput = document.getElementById('State');
    if (locSelect) {
        locSelect.addEventListener('change', function () {
            var opt = locSelect.options[locSelect.selectedIndex];
            if (cityHidden) cityHidden.value = opt.getAttribute('data-city') || '';
            if (stateInput) stateInput.value = opt.getAttribute('data-state') || '';
        });
    }
})();
</script>
}

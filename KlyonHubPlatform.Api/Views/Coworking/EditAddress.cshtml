@{
    ViewData[ViewDataKeys.Title] = "Editar Endereço";
    Layout = LayoutPaths.Layout;
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

@if (Model == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> Endereço não encontrado.
        <a href="/Parceiro/MyAddresses" class="btn btn-secondary ms-2">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
    return;
}

@{
    var hasActiveContracts = ViewBag.HasActiveContracts as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Endereço</h2>
    <a href="/Parceiro/MyAddresses" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (hasActiveContracts)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> <strong>Atenção:</strong> Este endereço possui contrato(s) ativo(s). Não é possível alterar os dados do endereço enquanto houver contrato ativo.
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="post" action="/Parceiro/EditAddress?id=@Model.Id">
            @Html.AntiForgeryToken()
            <!-- CEP como primeiro campo -->
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="ZipCode" class="form-label">CEP <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">@Model.ZipCode</div>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="ZipCode" name="ZipCode" 
                               value="@Model.ZipCode" placeholder="00000-000" maxlength="9" required
                               onkeypress="return onlyNumbers(event)"
                               onblur="buscarCEP(this.value)">
                        <small class="form-text text-muted">Digite o CEP para buscar o endereço automaticamente</small>
                    }
                </div>
                <div class="col-md-8 mb-3">
                    <label for="LocationId" class="form-label">Localidade <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">
                            @if (Model.Location != null)
                            {
                                @($"{Model.Location.City}/{Model.Location.State}")
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </div>
                    }
                    else
                    {
                        <select class="form-select" id="LocationId" name="LocationId" required onchange="preencherEstado()">
                            <option value="">Selecione a localidade...</option>
                            @if (ViewBag.Locations != null)
                            {
                                @foreach (var location in ViewBag.Locations as List<KlyonHubPlatform.Domain.Entities.Location> ?? new List<KlyonHubPlatform.Domain.Entities.Location>())
                                {
                                    var isSelected = Model.LocationId == location.Id;
                                    <option value="@location.Id" data-state="@location.State" selected="@isSelected">
                                        @location.City/@location.State
                                    </option>
                                }
                            }
                        </select>
                    }
                </div>
            </div>

            <!-- Endereço -->
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label for="Address" class="form-label">Endereço <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">@Model.Address</div>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required>
                    }
                </div>
                <div class="col-md-4 mb-3">
                    <label for="Number" class="form-label">Número <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">@Model.Number</div>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Number" name="Number" value="@Model.Number" required>
                    }
                </div>
            </div>

            <!-- Complemento e Bairro -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Complement" class="form-label">Complemento</label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">@(Model.Complement ?? "-")</div>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Complement" name="Complement" value="@Model.Complement">
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <label for="Neighborhood" class="form-label">Bairro <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">@Model.Neighborhood</div>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Neighborhood" name="Neighborhood" value="@Model.Neighborhood" required>
                    }
                </div>
            </div>

            <!-- Cidade e Estado -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="City" class="form-label">Cidade <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="City" name="City" value="@Model.City" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="State" class="form-label">Estado (UF) <span class="text-danger">*</span></label>
                    <select class="form-select" id="State" name="State" required>
                        <option value="">Selecione o estado</option>
                        @{
                            var states = BrazilianUfs.All;
                            var stateNames = BrazilianUfs.Names;
                        }
                        @for (int i = 0; i < states.Length; i++)
                        {
                            var isSelected = Model.State == states[i];
                            <option value="@states[i]" selected="@isSelected">@states[i] - @stateNames[i]</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Preço e Máximo de Contratos -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="BasePrice" class="form-label">Preço Base (R$) <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">R$ @Model.BasePrice.ToString(NumberFormatConstants.TwoDecimals)</div>
                    }
                    else
                    {
                        <input type="number" step="0.01" min="0" class="form-control" id="BasePrice" name="BasePrice" 
                               value="@Model.BasePrice.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture)" placeholder="0.00" required>
                        <small class="form-text text-muted">O valor deve ser maior ou igual a zero</small>
                    }
                </div>
                <div class="col-md-6 mb-3">
                    <label for="MaxContracts" class="form-label">Máximo de Contratos <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">@Model.MaxContracts</div>
                    }
                    else
                    {
                        <input type="number" step="1" min="@Model.CurrentContracts" class="form-control" id="MaxContracts" name="MaxContracts" 
                               value="@Model.MaxContracts" required title="Somente números inteiros">
                        <small class="form-text text-muted">Mínimo: @Model.CurrentContracts (contratos ativos)</small>
                    }
                </div>
            </div>

            <!-- Capacidade Fiscal -->
            <div class="card mb-3 border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#capacidadeFiscalBody" aria-expanded="true" aria-controls="capacidadeFiscalBody">
                    <span><i class="bi bi-building"></i> Capacidade Fiscal</span>
                    <i class="bi bi-chevron-down"></i>
                </div>
                <div class="card-body collapse show" id="capacidadeFiscalBody">
                    @{
                        var capStatus = Model.CapacityApprovalStatus;
                        var addressInAnalysis = Model.AddressStatus == KlyonHubPlatform.Domain.Core.Enums.AddressStatus.PendingApproval;
                        var capacityStatusText = addressInAnalysis
                            ? "Em análise"
                            : capStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending
                                ? "Em análise"
                                : capStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Rejected
                                    ? "Aprovada (vigente)"
                                    : "Aprovada";
                        var capacityStatusWarning = addressInAnalysis || capStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending;
                        var capacityHelpText = capacityStatusWarning
                            ? (addressInAnalysis ? "Endereço em análise pelo administrador" : "Valor em análise pelo administrador")
                            : "Capacidade fiscal aprovada pela plataforma";
                    }
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Capacidade <span class="badge @(capacityStatusWarning ? "bg-warning text-dark" : capStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Rejected ? "bg-secondary" : "bg-success")">@capacityStatusText</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" value="@Model.ApprovedFiscalCapacity" readonly>
                                <span class="input-group-text">
                                    @if (capacityStatusWarning)
                                    {
                                        <i class="bi bi-hourglass-split text-warning" title="Em análise"></i>
                                    }
                                    else if (capStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Approved || capStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.None)
                                    {
                                        <i class="bi bi-check-circle text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle text-success"></i>
                                    }
                                </span>
                            </div>
                            <small class="form-text text-muted">@capacityHelpText</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Contratos Ativos</label>
                            <div class="input-group">
                                <input type="number" class="form-control" value="@Model.CurrentContracts" readonly>
                                <span class="input-group-text">
                                    <i class="bi bi-people"></i>
                                </span>
                            </div>
                            <small class="form-text text-muted">Contratos ativos no momento</small>
                        </div>
                    </div>
                    @{
                        var hasPendingRequest = Model.CapacityApprovalStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending;
                        var canRequestChange = !addressInAnalysis && !hasPendingRequest && Model.RequestedFiscalCapacity != Model.ApprovedFiscalCapacity;
                    }
                    @if (addressInAnalysis)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-hourglass-split"></i> <strong>Endereço em análise:</strong> Este endereço está aguardando aprovação administrativa. A capacidade fiscal será definida após a aprovação do endereço.
                        </div>
                    }
                    else if (hasPendingRequest)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-clock-history"></i> <strong>Solicitação pendente:</strong> Você solicitou alteração da capacidade fiscal para <strong>@Model.RequestedFiscalCapacity</strong>. Aguardando aprovação administrativa.
                        </div>
                    }
                    else if (canRequestChange)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> Você pode solicitar alteração da capacidade fiscal. A alteração requer aprovação administrativa.
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="RequestedFiscalCapacity" class="form-label">Nova Capacidade Solicitada</label>
                            <input type="number" class="form-control" id="RequestedFiscalCapacity" 
                                   value="@Model.RequestedFiscalCapacity" min="@Model.CurrentContracts" step="1"
                                   @(hasPendingRequest ? "readonly" : "")>
                            <small class="form-text text-muted">Mínimo: @Model.CurrentContracts (contratos ativos)</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="CapacityJustification" class="form-label">Justificativa</label>
                            <textarea class="form-control" id="CapacityJustification" rows="3" 
                                      placeholder="Explique o motivo da solicitação de alteração de capacidade..." 
                                      @(hasPendingRequest ? "readonly" : "")></textarea>
                            <small class="form-text text-muted">Obrigatório ao solicitar alteração</small>
                        </div>
                    </div>
                    @if (!addressInAnalysis && !hasPendingRequest)
                    {
                        <button type="button" class="btn btn-primary" id="btnRequestCapacityChange">
                            <i class="bi bi-send"></i> Solicitar Alteração de Capacidade
                        </button>
                    }
                </div>
            </div>

            @if (ViewBag.HasRoomRental == true)
            {
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle"></i> Para oferecer <strong>salas para aluguel</strong> (compartilhada, privativa, auditório) com fotos, capacidade, créditos e gestão individual de cada sala, configure em <a href="/Parceiro/Products">Produtos &gt; Aluguéis de Sala</a>.
                </div>
            }

            <!-- Status: checkbox DEVE vir antes do hidden para o model binder usar "true" quando marcado. Não exibir quando capacidade estiver em análise. -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Status</label>
                    @if (capacityStatusWarning)
                    {
                        <div class="form-control-plaintext text-muted">
                            <small>O status (disponível/indisponível) poderá ser alterado após a aprovação da capacidade fiscal.</small>
                        </div>
                        <input type="hidden" name="IsAvailable" value="@(Model.IsAvailable ? "true" : "false")">
                    }
                    else if (hasActiveContracts)
                    {
                        <div class="form-control-plaintext">
                            <span class="badge bg-@(Model.IsAvailable ? "success" : "danger")">
                                @(Model.IsAvailable ? "Disponível" : "Indisponível")
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IsAvailable" name="IsAvailable" 
                                   value="true" @(Model.IsAvailable ? "checked" : "")>
                            <label class="form-check-label" for="IsAvailable">
                                Endereço Disponível
                            </label>
                        </div>
                        <input type="hidden" name="IsAvailable" value="false">
                        <small class="form-text text-muted">Desmarque para tornar o endereço indisponível</small>
                    }
                </div>
            </div>

            @if (!hasActiveContracts)
            {
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Atualizar Endereço
                </button>
            }
        </form>
    </div>
</div>

<script>
// Formatar CEP
function formatarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    if (cep.length === 8) {
        return cep.substring(0, 5) + '-' + cep.substring(5);
    }
    return cep;
}

// Apenas números
function onlyNumbers(event) {
    const char = String.fromCharCode(event.which);
    if (!/[0-9]/.test(char)) {
        event.preventDefault();
        return false;
    }
    return true;
}

// Bloquear vírgula, ponto e outros caracteres não inteiros (para campos que aceitam só inteiro)
function allowOnlyIntegerInput(event) {
    var k = event.key;
    if (k === ',' || k === '.' || k === 'e' || k === 'E' || k === '+' || k === '-') {
        event.preventDefault();
        return;
    }
}
// Remover vírgula/ponto ao digitar ou colar
function stripDecimalChars(e) {
    var v = e.target.value;
    if (/[,.]/.test(v)) {
        e.target.value = v.replace(/[,.]/g, '');
    }
}

// Aplicar máscara de CEP
if (!hasActiveContracts) {
    var zipCodeInput = document.getElementById('ZipCode');
    if (zipCodeInput) {
        zipCodeInput.addEventListener('input', function(e) {
            e.target.value = formatarCEP(e.target.value);
        });
    }
}

// Buscar CEP via API ViaCEP
async function buscarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    
    if (cep.length !== 8) {
        return;
    }

    try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
        const data = await response.json();

        if (!data.erro) {
            document.getElementById('Address').value = data.logradouro || '';
            document.getElementById('Neighborhood').value = data.bairro || '';
            document.getElementById('City').value = data.localidade || '';
            document.getElementById('State').value = data.uf || '';
            
            // Se o estado foi preenchido e há uma localidade selecionada, verificar compatibilidade
            const locationSelect = document.getElementById('LocationId');
            if (locationSelect.value && data.uf) {
                const selectedOption = locationSelect.options[locationSelect.selectedIndex];
                const locationState = selectedOption.getAttribute('data-state');
                if (locationState !== data.uf) {
                    showToast('Atenção: O estado do CEP (' + data.uf + ') não corresponde ao estado da localidade selecionada (' + locationState + ').', 'warning');
                }
            }
        } else {
            showToast('CEP não encontrado. Por favor, preencha os dados manualmente.', 'warning');
        }
    } catch (error) {
        console.error('Erro ao buscar CEP:', error);
        showToast('Erro ao buscar CEP. Por favor, preencha os dados manualmente.', 'error');
    }
}

// Preencher estado quando selecionar localidade
function preencherEstado() {
    const locationSelect = document.getElementById('LocationId');
    const stateSelect = document.getElementById('State');
    
    if (locationSelect.value) {
        const selectedOption = locationSelect.options[locationSelect.selectedIndex];
        const state = selectedOption.getAttribute('data-state');
        
        if (state) {
            stateSelect.value = state;
        }
    }
}

// Validar preço base (não permitir valores negativos)
if (!hasActiveContracts) {
    var basePriceInput = document.getElementById('BasePrice');
    if (basePriceInput) {
        basePriceInput.addEventListener('input', function(e) {
            const value = parseFloat(e.target.value);
            if (value < 0) {
                e.target.setCustomValidity('O preço base não pode ser negativo.');
                e.target.value = '';
            } else {
                e.target.setCustomValidity('');
            }
        });
    }

    // Validar maxContracts: somente inteiro e não pode ser menor que currentContracts
    var maxContractsInput = document.getElementById('MaxContracts');
    if (maxContractsInput) {
        maxContractsInput.addEventListener('keydown', allowOnlyIntegerInput);
        maxContractsInput.addEventListener('input', stripDecimalChars);
        maxContractsInput.addEventListener('input', function(e) {
            var raw = e.target.value;
            if (raw === '' || raw === '-') {
                e.target.setCustomValidity('');
                return;
            }
            var num = parseFloat(raw);
            if (!Number.isInteger(num) || num !== Math.floor(num)) {
                e.target.setCustomValidity('O máximo de contratos deve ser um número inteiro.');
                return;
            }
            var minValue = parseInt(e.target.min, 10);
            if (!isNaN(minValue) && num < minValue) {
                e.target.setCustomValidity('O máximo de contratos não pode ser menor que ' + minValue + '.');
            } else {
                e.target.setCustomValidity('');
            }
        });
    }

    // Validar antes de enviar o formulário
    var form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const basePrice = parseFloat(document.getElementById('BasePrice').value);
            if (basePrice < 0) {
                e.preventDefault();
                showToast('O preço base não pode ser negativo. Por favor, informe um valor maior ou igual a zero.', 'warning');
                document.getElementById('BasePrice').focus();
                return false;
            }

            var maxContractsEl = document.getElementById('MaxContracts');
            if (maxContractsEl) {
                var maxContractsVal = maxContractsEl.value.trim();
                var maxContractsNum = parseFloat(maxContractsVal);
                if (maxContractsVal === '' || isNaN(maxContractsNum)) {
                    e.preventDefault();
                    showToast('Informe o máximo de contratos.', 'warning');
                    maxContractsEl.focus();
                    return false;
                }
                if (!Number.isInteger(maxContractsNum) || maxContractsNum !== Math.floor(maxContractsNum)) {
                    e.preventDefault();
                    showToast('O campo Máximo de Contratos aceita somente números inteiros.', 'warning');
                    maxContractsEl.focus();
                    return false;
                }
                var minContracts = parseInt(maxContractsEl.min, 10);
                if (!isNaN(minContracts) && maxContractsNum < minContracts) {
                    e.preventDefault();
                    showToast('O máximo de contratos não pode ser menor que ' + minContracts + '.', 'warning');
                    maxContractsEl.focus();
                    return false;
                }
            }
        });
    }
}

// Nova Capacidade Solicitada: bloquear vírgula e ponto
(function() {
    function initIntegerOnlyCapacity() {
        var capInput = document.getElementById('RequestedFiscalCapacity');
        if (capInput && !capInput.readOnly) {
            capInput.addEventListener('keydown', allowOnlyIntegerInput);
            capInput.addEventListener('input', stripDecimalChars);
        }
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initIntegerOnlyCapacity);
    } else {
        initIntegerOnlyCapacity();
    }
})();

// Solicitar alteração de capacidade fiscal (registrar após DOM pronto)
(function() {
    function initRequestCapacityChange() {
        var btn = document.getElementById('btnRequestCapacityChange');
        if (!btn) return;

        btn.addEventListener('click', async function() {
            var rawValue = document.getElementById('RequestedFiscalCapacity').value;
            var requestedCapacity = parseInt(rawValue, 10);
            var justification = (document.getElementById('CapacityJustification').value || '').trim();
            var currentContracts = @Model.CurrentContracts;
            var approvedCapacity = @Model.ApprovedFiscalCapacity;

            if (rawValue === '' || isNaN(requestedCapacity) || requestedCapacity !== parseFloat(rawValue) || !Number.isInteger(requestedCapacity)) {
                if (typeof showToast === 'function') showToast('Nova Capacidade Solicitada deve ser um número inteiro.', 'warning');
                else alert('Nova Capacidade Solicitada deve ser um número inteiro.');
                document.getElementById('RequestedFiscalCapacity').focus();
                return;
            }

            if (requestedCapacity < currentContracts) {
                if (typeof showToast === 'function') showToast('A capacidade solicitada deve ser maior ou igual ao número de contratos ativos (' + currentContracts + ').', 'warning');
                else alert('A capacidade solicitada deve ser maior ou igual ao número de contratos ativos (' + currentContracts + ').');
                document.getElementById('RequestedFiscalCapacity').focus();
                return;
            }

            if (requestedCapacity === approvedCapacity) {
                if (typeof showToast === 'function') showToast('A capacidade solicitada é igual à capacidade aprovada. Não é necessário solicitar alteração.', 'info');
                else alert('A capacidade solicitada é igual à capacidade aprovada.');
                return;
            }

            if (!justification) {
                if (typeof showToast === 'function') showToast('Por favor, informe a justificativa para a alteração de capacidade.', 'warning');
                else alert('Por favor, informe a justificativa para a alteração de capacidade.');
                document.getElementById('CapacityJustification').focus();
                return;
            }

            if (!confirm('Deseja solicitar alteração da capacidade fiscal de ' + approvedCapacity + ' para ' + requestedCapacity + '?')) {
                return;
            }

            var form = btn.closest('form');
            var tokenEl = form ? form.querySelector('input[name="__RequestVerificationToken"]') : document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenEl ? tokenEl.value : '';
            if (!token) {
                if (typeof showToast === 'function') showToast('Token de segurança não encontrado. Recarregue a página e tente novamente.', 'error');
                else alert('Token de segurança não encontrado. Recarregue a página e tente novamente.');
                return;
            }

            try {
                var response = await fetch('@Url.Action("RequestCapacityChange", "Coworking")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        addressId: @Model.Id,
                        requestedCapacity: requestedCapacity,
                        justification: justification
                    })
                });

                var result = await response.json().catch(function() { return { success: false, message: 'Resposta inválida do servidor.' }; });

                if (result.success) {
                    if (typeof showToast === 'function') showToast('Solicitação de alteração de capacidade enviada com sucesso! Aguardando aprovação administrativa.', 'success');
                    else alert('Solicitação enviada com sucesso!');
                    setTimeout(function() { window.location.reload(); }, 1500);
                } else {
                    if (typeof showToast === 'function') showToast(result.message || 'Erro ao enviar solicitação.', 'error');
                    else alert(result.message || 'Erro ao enviar solicitação.');
                }
            } catch (error) {
                console.error('Erro ao solicitar alteração de capacidade:', error);
                if (typeof showToast === 'function') showToast('Erro ao enviar solicitação. Tente novamente.', 'error');
                else alert('Erro ao enviar solicitação. Tente novamente.');
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRequestCapacityChange);
    } else {
        initRequestCapacityChange();
    }
})();
</script>

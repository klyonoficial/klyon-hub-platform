@{
    ViewData[ViewDataKeys.Title] = "Editar Endereço";
    Layout = LayoutPaths.Layout;
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

@if (Model == null)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i> Endereço não encontrado.
        <a href="/Parceiro/MyAddresses" class="btn btn-secondary ms-2">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
    return;
}

@{
    var hasActiveContracts = ViewBag.HasActiveContracts as bool? ?? false;
    var prices = ViewBag.Prices as KlyonHubPlatform.Application.DTOs.Pricing.AddressPricesDto;
    var pendingPriceRequest = Model?.CardPriceChangeRequests?.FirstOrDefault(r => r.Status == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Pending);
    var hasPendingPriceRequest = pendingPriceRequest != null;
    var rejectedPriceRequest = Model?.CardPriceChangeRequests?
        .Where(r => r.Status == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Rejected && !string.IsNullOrEmpty(r.RejectionReason))
        .OrderByDescending(r => r.ReviewedAt ?? r.UpdatedAt ?? r.CreatedAt)
        .FirstOrDefault();
    var isPricesRejected = Model?.CardPricesApprovalStatus == KlyonHubPlatform.Domain.Core.Enums.CapacityApprovalStatus.Rejected;
    var displayBasePrice = hasPendingPriceRequest ? (pendingPriceRequest!.RequestedBasePrice ?? Model!.BasePrice) : Model!.BasePrice;
    var displaySurcharge = hasPendingPriceRequest ? pendingPriceRequest!.RequestedCardMonthlySurchargePercent : Model!.CardMonthlySurchargePercent;
    var isAdmin = User.IsInRole(RoleNames.Administrator);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Endereço</h2>
    <a href="/Parceiro/MyAddresses" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (hasActiveContracts)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> <strong>Contrato(s) ativo(s):</strong> os dados físicos do endereço (CEP, rua, etc.) estão bloqueados. Você ainda pode alterar os <a href="#precos" class="alert-link">preços</a> abaixo; as mudanças passam por aprovação administrativa.
    </div>
}

<div class="card">
    <div class="card-header bg-primary text-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Dados do endereço</h5>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="small text-white">Contratos ativos</span>
                <span class="badge bg-light text-dark" title="Quantidade de contratos ativos neste endereço (somente leitura)">@Model.CurrentContracts</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="small text-white">Status</span>
                @if (hasActiveContracts)
                {
                    <span class="badge bg-@(Model.IsAvailable ? "success" : "danger")">
                        @(Model.IsAvailable ? "Disponível" : "Indisponível")
                    </span>
                }
                else
                {
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="IsAvailableHeader" form="editAddressForm"
                               name="IsAvailable" value="true" @(Model.IsAvailable ? "checked" : "")>
                        <label class="form-check-label small text-white" for="IsAvailableHeader">Disponível</label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="card-body">
        <form method="post" action="/Parceiro/EditAddress?id=@Model.Id" id="editAddressForm">
            @Html.AntiForgeryToken()
            @if (!hasActiveContracts)
            {
                <input type="hidden" name="IsAvailable" value="false">
            }

            <div class="row g-3">
                <div class="col-md-4">
                    <label for="ZipCode" class="form-label">CEP <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="ZipCode" value="@Model.ZipCode" readonly disabled>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="ZipCode" name="ZipCode"
                               value="@Model.ZipCode" placeholder="00000-000" maxlength="9" required
                               onkeypress="return onlyNumbers(event)"
                               onblur="buscarCEP(this.value)">
                        <small class="form-text text-muted">Busca automática do endereço</small>
                    }
                </div>
                <div class="col-md-4">
                    <label for="Address" class="form-label">Endereço <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="Address" value="@Model.Address" readonly disabled>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required>
                    }
                </div>
                <div class="col-md-4">
                    <label for="Number" class="form-label">Número <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="Number" value="@Model.Number" readonly disabled>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Number" name="Number" value="@Model.Number" required>
                    }
                </div>

                <div class="col-md-4">
                    <label for="Complement" class="form-label">Complemento</label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="Complement" value="@(Model.Complement ?? "-")" readonly disabled>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Complement" name="Complement" value="@Model.Complement">
                    }
                </div>
                <div class="col-md-4">
                    <label for="Neighborhood" class="form-label">Bairro <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="Neighborhood" value="@Model.Neighborhood" readonly disabled>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="Neighborhood" name="Neighborhood" value="@Model.Neighborhood" required>
                    }
                </div>
                <div class="col-md-4">
                    <label for="City" class="form-label">Cidade <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="City" value="@Model.City" readonly disabled>
                    }
                    else
                    {
                        <input type="text" class="form-control" id="City" name="City" value="@Model.City" required>
                    }
                </div>

                <div class="col-md-4">
                    <label for="State" class="form-label">UF <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="State" value="@Model.State" readonly disabled>
                    }
                    else
                    {
                        <select class="form-select" id="State" name="State" required>
                            <option value="">UF</option>
                            @{
                                var states = BrazilianUfs.All;
                                var stateNames = BrazilianUfs.Names;
                            }
                            @for (int i = 0; i < states.Length; i++)
                            {
                                var isSelected = Model.State == states[i];
                                <option value="@states[i]" selected="@isSelected">@states[i] - @stateNames[i]</option>
                            }
                        </select>
                    }
                </div>
                <div class="col-md-8">
                    <label for="LocationId" class="form-label">Localidade <span class="text-danger">*</span></label>
                    @if (hasActiveContracts)
                    {
                        <input type="text" class="form-control" id="LocationId"
                               value="@(Model.Location != null ? $"{Model.Location.City}/{Model.Location.State}" : "N/A")"
                               readonly disabled>
                    }
                    else
                    {
                        <select class="form-select" id="LocationId" name="LocationId" required onchange="preencherEstado()">
                            <option value="">Selecione a localidade...</option>
                            @if (ViewBag.Locations != null)
                            {
                                @foreach (var location in ViewBag.Locations as List<KlyonHubPlatform.Domain.Entities.Location> ?? new List<KlyonHubPlatform.Domain.Entities.Location>())
                                {
                                    var isSelected = Model.LocationId == location.Id;
                                    <option value="@location.Id" data-state="@location.State" selected="@isSelected">
                                        @location.City/@location.State
                                    </option>
                                }
                            }
                        </select>
                    }
                </div>
            </div>

            @if (ViewBag.HasRoomRental == true)
            {
                <div class="alert alert-info mt-3 mb-0">
                    <i class="bi bi-info-circle"></i> Para oferecer <strong>salas para aluguel</strong> (compartilhada, privativa, auditório) com fotos, capacidade, créditos e gestão individual de cada sala, configure em <a href="/Parceiro/Products">Produtos &gt; Aluguéis de Sala</a>.
                </div>
            }

            @if (!hasActiveContracts)
            {
                <button type="submit" class="btn btn-primary mt-3">
                    <i class="bi bi-check-circle"></i> Atualizar Endereço
                </button>
            }
        </form>
    </div>
</div>

<div class="card mt-4" id="precos">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-currency-dollar"></i> Preços (PIX / Cartão / Boleto)</h5>
    </div>
    <div class="card-body">
        @if (isPricesRejected && rejectedPriceRequest != null)
        {
            <div class="alert alert-danger">
                <i class="bi bi-x-circle"></i> <strong>Preços reprovados:</strong> @rejectedPriceRequest.RejectionReason
            </div>
        }
        @if (hasPendingPriceRequest)
        {
            <div class="alert alert-warning">
                <i class="bi bi-clock-history"></i> <strong>Solicitação pendente:</strong> preço anual R$ @(pendingPriceRequest!.RequestedBasePrice?.ToString(NumberFormatConstants.TwoDecimals) ?? Model.BasePrice.ToString(NumberFormatConstants.TwoDecimals))
                @if (pendingPriceRequest.RequestedCardMonthlySurchargePercent.HasValue)
                {
                    <span> · acréscimo mensal @pendingPriceRequest.RequestedCardMonthlySurchargePercent.Value.ToString(NumberFormatConstants.TwoDecimals)%</span>
                }
                <span class="d-block mt-1 small">Aguardando aprovação administrativa.</span>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Preço anual (PIX, cartão 1x e boleto) e acréscimo opcional para parcela mensal no cartão. Alterações exigem aprovação administrativa.
            </div>
        }

        <form method="post" action="/Parceiro/SubmitPriceChange?id=@Model.Id" id="submitPriceChangeForm" data-admin-direct="@(isAdmin ? "true" : "false")">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="PriceBasePrice" class="form-label">Preço anual (PIX / cartão 1x / boleto) (R$) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0" class="form-control price-input" id="PriceBasePrice" name="BasePrice"
                           value="@displayBasePrice.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture)"
                           @(hasPendingPriceRequest ? "readonly" : "") required>
                    <small class="form-text text-muted">Valor anual cobrado via PIX, boleto ou cartão à vista (1x).</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="CardMonthlySurchargePercent" class="form-label">Acréscimo mensal no cartão (%)</label>
                    <input type="number" step="0.01" min="0" max="100" class="form-control price-input" id="CardMonthlySurchargePercent" name="CardMonthlySurchargePercent"
                           value="@(displaySurcharge?.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                           placeholder="Ex: 10" @(hasPendingPriceRequest ? "readonly" : "")>
                    <small class="form-text text-muted">Opcional. Aplica-se sobre o preço anual para calcular a parcela mensal.</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Preview: parcela mensal (R$)</label>
                    <div class="form-control bg-light" id="MonthlyPreview">R$ @(prices?.CardPriceMonthly.ToString(NumberFormatConstants.TwoDecimals) ?? "0,00")</div>
                    <small class="form-text text-muted">Fórmula: (preço anual × (1 + acréscimo%)) ÷ 12</small>
                </div>
            </div>
            @if (!hasPendingPriceRequest)
            {
                @if (isAdmin)
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Aplicar preços
                    </button>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i> Enviar preços para aprovação
                    </button>
                }
            }
            else if (prices != null)
            {
                <p class="text-muted mb-0 small">Valores vigentes para clientes: anual (PIX / 1x / boleto) R$ @prices.PixPrice.ToString(NumberFormatConstants.TwoDecimals) · mensal R$ @prices.CardPriceMonthly.ToString(NumberFormatConstants.TwoDecimals)</p>
            }
        </form>
    </div>
</div>

<script>
var hasActiveContracts = @(hasActiveContracts ? "true" : "false");

// Formatar CEP
function formatarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    if (cep.length === 8) {
        return cep.substring(0, 5) + '-' + cep.substring(5);
    }
    return cep;
}

// Apenas números
function onlyNumbers(event) {
    const char = String.fromCharCode(event.which);
    if (!/[0-9]/.test(char)) {
        event.preventDefault();
        return false;
    }
    return true;
}

// Bloquear vírgula, ponto e outros caracteres não inteiros (para campos que aceitam só inteiro)
function allowOnlyIntegerInput(event) {
    var k = event.key;
    if (k === ',' || k === '.' || k === 'e' || k === 'E' || k === '+' || k === '-') {
        event.preventDefault();
        return;
    }
}
// Remover vírgula/ponto ao digitar ou colar
function stripDecimalChars(e) {
    var v = e.target.value;
    if (/[,.]/.test(v)) {
        e.target.value = v.replace(/[,.]/g, '');
    }
}

// Aplicar máscara de CEP
if (!hasActiveContracts) {
    var zipCodeInput = document.getElementById('ZipCode');
    if (zipCodeInput) {
        zipCodeInput.addEventListener('input', function(e) {
            e.target.value = formatarCEP(e.target.value);
        });
    }
}

// Buscar CEP via API ViaCEP
async function buscarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    
    if (cep.length !== 8) {
        return;
    }

    try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
        const data = await response.json();

        if (!data.erro) {
            document.getElementById('Address').value = data.logradouro || '';
            document.getElementById('Neighborhood').value = data.bairro || '';
            document.getElementById('City').value = data.localidade || '';
            document.getElementById('State').value = data.uf || '';
            
            // Se o estado foi preenchido e há uma localidade selecionada, verificar compatibilidade
            const locationSelect = document.getElementById('LocationId');
            if (locationSelect.value && data.uf) {
                const selectedOption = locationSelect.options[locationSelect.selectedIndex];
                const locationState = selectedOption.getAttribute('data-state');
                if (locationState !== data.uf) {
                    showToast('Atenção: O estado do CEP (' + data.uf + ') não corresponde ao estado da localidade selecionada (' + locationState + ').', 'warning');
                }
            }
        } else {
            showToast('CEP não encontrado. Por favor, preencha os dados manualmente.', 'warning');
        }
    } catch (error) {
        console.error('Erro ao buscar CEP:', error);
        showToast('Erro ao buscar CEP. Por favor, preencha os dados manualmente.', 'error');
    }
}

// Preencher estado quando selecionar localidade
function preencherEstado() {
    const locationSelect = document.getElementById('LocationId');
    const stateSelect = document.getElementById('State');
    
    if (locationSelect.value) {
        const selectedOption = locationSelect.options[locationSelect.selectedIndex];
        const state = selectedOption.getAttribute('data-state');
        
        if (state) {
            stateSelect.value = state;
        }
    }
}

// Preview de preço mensal (atualiza em tempo real ao digitar)
(function() {
    function formatCurrencyPtBr(value) {
        return value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function calcMonthlyPreview() {
        var baseEl = document.getElementById('PriceBasePrice');
        var surchargeEl = document.getElementById('CardMonthlySurchargePercent');
        var previewEl = document.getElementById('MonthlyPreview');
        if (!baseEl || !previewEl) return;
        var base = parseFloat(baseEl.value) || 0;
        var surcharge = surchargeEl && surchargeEl.value !== '' ? parseFloat(surchargeEl.value) : 0;
        if (isNaN(surcharge) || surcharge < 0) surcharge = 0;
        if (surcharge > 100) surcharge = 100;
        var monthly = (base * (1 + surcharge / 100)) / 12;
        previewEl.textContent = 'R$ ' + formatCurrencyPtBr(monthly);
    }

    document.querySelectorAll('.price-input').forEach(function(el) {
        el.addEventListener('input', calcMonthlyPreview);
        el.addEventListener('change', calcMonthlyPreview);
    });
    calcMonthlyPreview();
})();

// Confirmação antes de enviar solicitação de preços (parceiro; admin aplica direto)
(function() {
    var form = document.getElementById('submitPriceChangeForm');
    if (!form || form.getAttribute('data-admin-direct') === 'true') return;
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        var formRef = form;
        showConfirm(
            'As alterações de preço exigem aprovação administrativa. Deseja enviar a solicitação?',
            'Confirmar Ação',
            'warning'
        ).then(function(ok) {
            if (ok) formRef.submit();
        });
    });
})();

if (window.location.hash === '#precos') {
    var precosEl = document.getElementById('precos');
    if (precosEl) precosEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>

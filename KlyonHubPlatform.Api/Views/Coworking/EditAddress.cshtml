@{
    ViewData["Title"] = "Editar Endereço";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Endereço</h2>
    <a href="@Url.Action("MyAddresses", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="post" action="@Url.Action("EditAddress", "Coworking", new { id = Model.Id })">
            <!-- CEP como primeiro campo -->
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="ZipCode" class="form-label">CEP <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="ZipCode" name="ZipCode" 
                           value="@Model.ZipCode" placeholder="00000-000" maxlength="9" required
                           onkeypress="return onlyNumbers(event)"
                           onblur="buscarCEP(this.value)">
                    <small class="form-text text-muted">Digite o CEP para buscar o endereço automaticamente</small>
                </div>
                <div class="col-md-8 mb-3">
                    <label for="LocationId" class="form-label">Localidade <span class="text-danger">*</span></label>
                    <select class="form-select" id="LocationId" name="LocationId" required onchange="preencherEstado()">
                        <option value="">Selecione a localidade...</option>
                        @foreach (var location in ViewBag.Locations as List<KlyonHubPlatform.Domain.Entities.Location>)
                        {
                            var isSelected = Model.LocationId == location.Id;
                            <option value="@location.Id" data-state="@location.State" selected="@isSelected">
                                @location.City/@location.State
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- Endereço -->
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label for="Address" class="form-label">Endereço <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="Number" class="form-label">Número <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Number" name="Number" value="@Model.Number" required>
                </div>
            </div>

            <!-- Complemento e Bairro -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Complement" class="form-label">Complemento</label>
                    <input type="text" class="form-control" id="Complement" name="Complement" value="@Model.Complement">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="Neighborhood" class="form-label">Bairro <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Neighborhood" name="Neighborhood" value="@Model.Neighborhood" required>
                </div>
            </div>

            <!-- Cidade e Estado -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="City" class="form-label">Cidade <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="City" name="City" value="@Model.City" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="State" class="form-label">Estado (UF) <span class="text-danger">*</span></label>
                    <select class="form-select" id="State" name="State" required>
                        <option value="">Selecione o estado</option>
                        @{
                            var states = new[] { "AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO" };
                            var stateNames = new[] { "Acre", "Alagoas", "Amapá", "Amazonas", "Bahia", "Ceará", "Distrito Federal", "Espírito Santo", "Goiás", "Maranhão", "Mato Grosso", "Mato Grosso do Sul", "Minas Gerais", "Pará", "Paraíba", "Paraná", "Pernambuco", "Piauí", "Rio de Janeiro", "Rio Grande do Norte", "Rio Grande do Sul", "Rondônia", "Roraima", "Santa Catarina", "São Paulo", "Sergipe", "Tocantins" };
                        }
                        @for (int i = 0; i < states.Length; i++)
                        {
                            var isSelected = Model.State == states[i];
                            <option value="@states[i]" selected="@isSelected">@states[i] - @stateNames[i]</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Preço e Máximo de Contratos -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="BasePrice" class="form-label">Preço Base (R$) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0" class="form-control" id="BasePrice" name="BasePrice" 
                           value="@Model.BasePrice.ToString("F2")" required>
                    <small class="form-text text-muted">O valor deve ser maior ou igual a zero</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="MaxContracts" class="form-label">Máximo de Contratos <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="MaxContracts" name="MaxContracts" 
                           value="@Model.MaxContracts" min="@Model.CurrentContracts" required>
                    <small class="form-text text-muted">Mínimo: @Model.CurrentContracts (contratos ativos)</small>
                </div>
            </div>

            <hr class="my-4">
            <h5><i class="bi bi-door-open"></i> Configurações de Salas para Aluguel</h5>
            <p class="text-muted">Configure os tipos de salas disponíveis para aluguel por hora</p>

            <!-- Sala Compartilhada -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="OffersSharedRoom" name="OffersSharedRoom" value="true" 
                               @(Model.OffersSharedRoom ? "checked" : "") onchange="toggleSharedRoomFields()">
                        <label class="form-check-label fw-bold" for="OffersSharedRoom">
                            Oferecer Sala Compartilhada
                        </label>
                    </div>
                    <div id="sharedRoomFields" style="display: @(Model.OffersSharedRoom ? "block" : "none");">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="SharedRoomPricePerHour" class="form-label">Valor por Hora (R$) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" class="form-control" id="SharedRoomPricePerHour" name="SharedRoomPricePerHour"
                                       value="@(Model.SharedRoomPricePerHour?.ToString("F2") ?? "")" @(Model.OffersSharedRoom ? "required" : "")>
                                <small class="form-text text-muted">Ex: 20.00 (R$ 20,00 por hora)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="SharedRoomMaxSeats" class="form-label">Quantidade de Carteiras <span class="text-danger">*</span></label>
                                <input type="number" min="1" class="form-control" id="SharedRoomMaxSeats" name="SharedRoomMaxSeats"
                                       value="@(Model.SharedRoomMaxSeats?.ToString() ?? "")" @(Model.OffersSharedRoom ? "required" : "")>
                                <small class="form-text text-muted">Número máximo de pessoas simultâneas</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sala Privativa -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="OffersPrivateRoom" name="OffersPrivateRoom" value="true"
                               @(Model.OffersPrivateRoom ? "checked" : "") onchange="togglePrivateRoomFields()">
                        <label class="form-check-label fw-bold" for="OffersPrivateRoom">
                            Oferecer Sala Privativa
                        </label>
                    </div>
                    <div id="privateRoomFields" style="display: @(Model.OffersPrivateRoom ? "block" : "none");">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="PrivateRoomPricePerHour" class="form-label">Valor por Hora (R$) <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" class="form-control" id="PrivateRoomPricePerHour" name="PrivateRoomPricePerHour"
                                       value="@(Model.PrivateRoomPricePerHour?.ToString("F2") ?? "")" @(Model.OffersPrivateRoom ? "required" : "")>
                                <small class="form-text text-muted">Ex: 50.00 (R$ 50,00 por hora)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="PrivateRoomMaxSeats" class="form-label">Quantidade de Carteiras <span class="text-danger">*</span></label>
                                <input type="number" min="1" class="form-control" id="PrivateRoomMaxSeats" name="PrivateRoomMaxSeats"
                                       value="@(Model.PrivateRoomMaxSeats?.ToString() ?? "")" @(Model.OffersPrivateRoom ? "required" : "")>
                                <small class="form-text text-muted">Capacidade máxima da sala</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <input type="hidden" name="IsAvailable" value="false">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="IsAvailable" name="IsAvailable" 
                               value="true" @(Model.IsAvailable ? "checked" : "")>
                        <label class="form-check-label" for="IsAvailable">
                            Endereço Disponível
                        </label>
                    </div>
                    <small class="form-text text-muted">Desmarque para tornar o endereço indisponível</small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Atualizar Endereço
            </button>
        </form>
    </div>
</div>

<script>
// Formatar CEP
function formatarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    if (cep.length === 8) {
        return cep.substring(0, 5) + '-' + cep.substring(5);
    }
    return cep;
}

// Apenas números
function onlyNumbers(event) {
    const char = String.fromCharCode(event.which);
    if (!/[0-9]/.test(char)) {
        event.preventDefault();
        return false;
    }
    return true;
}

// Aplicar máscara de CEP
document.getElementById('ZipCode').addEventListener('input', function(e) {
    e.target.value = formatarCEP(e.target.value);
});

// Buscar CEP via API ViaCEP
async function buscarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    
    if (cep.length !== 8) {
        return;
    }

    try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
        const data = await response.json();

        if (!data.erro) {
            document.getElementById('Address').value = data.logradouro || '';
            document.getElementById('Neighborhood').value = data.bairro || '';
            document.getElementById('City').value = data.localidade || '';
            document.getElementById('State').value = data.uf || '';
            
            // Se o estado foi preenchido e há uma localidade selecionada, verificar compatibilidade
            const locationSelect = document.getElementById('LocationId');
            if (locationSelect.value && data.uf) {
                const selectedOption = locationSelect.options[locationSelect.selectedIndex];
                const locationState = selectedOption.getAttribute('data-state');
                if (locationState !== data.uf) {
                    alert('Atenção: O estado do CEP (' + data.uf + ') não corresponde ao estado da localidade selecionada (' + locationState + ').');
                }
            }
        } else {
            alert('CEP não encontrado. Por favor, preencha os dados manualmente.');
        }
    } catch (error) {
        console.error('Erro ao buscar CEP:', error);
        alert('Erro ao buscar CEP. Por favor, preencha os dados manualmente.');
    }
}

// Preencher estado quando selecionar localidade
function preencherEstado() {
    const locationSelect = document.getElementById('LocationId');
    const stateSelect = document.getElementById('State');
    
    if (locationSelect.value) {
        const selectedOption = locationSelect.options[locationSelect.selectedIndex];
        const state = selectedOption.getAttribute('data-state');
        
        if (state) {
            stateSelect.value = state;
        }
    }
}

// Validar preço base (não permitir valores negativos)
document.getElementById('BasePrice').addEventListener('input', function(e) {
    const value = parseFloat(e.target.value);
    if (value < 0) {
        e.target.setCustomValidity('O preço base não pode ser negativo.');
        e.target.value = '';
    } else {
        e.target.setCustomValidity('');
    }
});

// Validar maxContracts (não pode ser menor que currentContracts)
document.getElementById('MaxContracts').addEventListener('input', function(e) {
    const minValue = parseInt(e.target.min);
    const value = parseInt(e.target.value);
    if (value < minValue) {
        e.target.setCustomValidity('O máximo de contratos não pode ser menor que ' + minValue + '.');
    } else {
        e.target.setCustomValidity('');
    }
});

// Toggle campos de sala compartilhada
function toggleSharedRoomFields() {
    const checkbox = document.getElementById('OffersSharedRoom');
    const fields = document.getElementById('sharedRoomFields');
    if (checkbox.checked) {
        fields.style.display = 'block';
        document.getElementById('SharedRoomPricePerHour').required = true;
        document.getElementById('SharedRoomMaxSeats').required = true;
    } else {
        fields.style.display = 'none';
        document.getElementById('SharedRoomPricePerHour').required = false;
        document.getElementById('SharedRoomMaxSeats').required = false;
    }
}

// Toggle campos de sala privativa
function togglePrivateRoomFields() {
    const checkbox = document.getElementById('OffersPrivateRoom');
    const fields = document.getElementById('privateRoomFields');
    if (checkbox.checked) {
        fields.style.display = 'block';
        document.getElementById('PrivateRoomPricePerHour').required = true;
        document.getElementById('PrivateRoomMaxSeats').required = true;
    } else {
        fields.style.display = 'none';
        document.getElementById('PrivateRoomPricePerHour').required = false;
        document.getElementById('PrivateRoomMaxSeats').required = false;
    }
}

// Validar antes de enviar o formulário
document.querySelector('form').addEventListener('submit', function(e) {
    const basePrice = parseFloat(document.getElementById('BasePrice').value);
    if (basePrice < 0) {
        e.preventDefault();
        alert('O preço base não pode ser negativo. Por favor, informe um valor maior ou igual a zero.');
        document.getElementById('BasePrice').focus();
        return false;
    }

    const maxContracts = parseInt(document.getElementById('MaxContracts').value);
    const minContracts = parseInt(document.getElementById('MaxContracts').min);
    if (maxContracts < minContracts) {
        e.preventDefault();
        alert('O máximo de contratos não pode ser menor que ' + minContracts + '.');
        document.getElementById('MaxContracts').focus();
        return false;
    }

    // Validar sala compartilhada
    const offersShared = document.getElementById('OffersSharedRoom').checked;
    if (offersShared) {
        const sharedPrice = parseFloat(document.getElementById('SharedRoomPricePerHour').value);
        const sharedSeats = parseInt(document.getElementById('SharedRoomMaxSeats').value);
        if (!sharedPrice || sharedPrice <= 0) {
            e.preventDefault();
            alert('Por favor, informe o valor por hora da sala compartilhada.');
            document.getElementById('SharedRoomPricePerHour').focus();
            return false;
        }
        if (!sharedSeats || sharedSeats < 1) {
            e.preventDefault();
            alert('Por favor, informe a quantidade de carteiras da sala compartilhada.');
            document.getElementById('SharedRoomMaxSeats').focus();
            return false;
        }
    }

    // Validar sala privativa
    const offersPrivate = document.getElementById('OffersPrivateRoom').checked;
    if (offersPrivate) {
        const privatePrice = parseFloat(document.getElementById('PrivateRoomPricePerHour').value);
        const privateSeats = parseInt(document.getElementById('PrivateRoomMaxSeats').value);
        if (!privatePrice || privatePrice <= 0) {
            e.preventDefault();
            alert('Por favor, informe o valor por hora da sala privativa.');
            document.getElementById('PrivateRoomPricePerHour').focus();
            return false;
        }
        if (!privateSeats || privateSeats < 1) {
            e.preventDefault();
            alert('Por favor, informe a quantidade de carteiras da sala privativa.');
            document.getElementById('PrivateRoomMaxSeats').focus();
            return false;
        }
    }
});
</script>

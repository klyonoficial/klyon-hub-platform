@using KlyonHubPlatform.Domain.Core.Enums
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData[ViewDataKeys.Title] = "Gerenciar Contratos de Endereço Fiscal";
    Layout = LayoutPaths.Layout;
}

@model List<KlyonHubPlatform.Domain.Entities.Contract>
@{
    var pageSizeVal = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 10;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Gerenciar Contratos de Endereço Fiscal</h2>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Contracts", "Admin")" class="row g-3" id="filterForm">
            <input type="hidden" name="page" value="1" id="pageInput" />
            <div class="col-md-3">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Número, cliente ou endereço">
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="@ContractStatusFilterValues.Active" selected="@(ViewBag.Status == ContractStatusFilterValues.Active)">Ativos</option>
                    <option value="Suspended" selected="@(ViewBag.Status == "Suspended")">Suspensos</option>
                    <option value="PendingPayment" selected="@(ViewBag.Status == "PendingPayment")">Aguardando Pagamento</option>
                    <option value="PendingCancellation" selected="@(ViewBag.Status == "PendingCancellation")">Cancelamento Pendente</option>
                    <option value="@ContractStatusFilterValues.Cancelled" selected="@(ViewBag.Status == ContractStatusFilterValues.Cancelled)">Cancelados</option>
                    <option value="Expired" selected="@(ViewBag.Status == "Expired")">Expirados</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="clientId" class="form-label">Cliente</label>
                <select class="form-select" id="clientId" name="clientId">
                    <option value="">Todos</option>
                    @foreach (var client in ViewBag.Clients as List<KlyonHubPlatform.Domain.Entities.Client> ?? new List<KlyonHubPlatform.Domain.Entities.Client>())
                    {
                        <option value="@client.Id" selected="@(ViewBag.ClientId != null && ViewBag.ClientId == client.Id)">
                            @(client.RazaoSocial ?? client.NomeFantasia ?? client.ContactName ?? DefaultDisplayStrings.NotAvailable)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action("Contracts", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    <div class="mb-3">
        <p class="text-muted mb-0">
            Mostrando <strong>@((ViewBag.CurrentPage - 1) * pageSizeVal + 1)</strong> a 
            <strong>@(Math.Min(ViewBag.CurrentPage * pageSizeVal, ViewBag.TotalItems))</strong> de 
            <strong>@ViewBag.TotalItems</strong> contrato(s)
        </p>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Cliente</th>
                            <th>Endereço</th>
                            <th>Localidade</th>
                            <th>Valor</th>
                            <th>Status</th>
                            <th>Data Início</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model)
                        {
                            <tr>
                                <td><strong>@contract.ContractNumber</strong></td>
                                <td>
                                    @if (contract.Client != null)
                                    {
                                        <a href="@Url.Action("RegisterClient", "Client", new { id = contract.Client.Id })" 
                                           class="text-decoration-none fw-bold" title="Editar cliente">
                                            @(contract.Client.RazaoSocial ?? contract.Client.NomeFantasia ?? contract.Client.ContactName ?? DefaultDisplayStrings.NotAvailable)
                                        </a>
                                        @if (!string.IsNullOrEmpty(contract.Client.CNPJ))
                                        {
                                            <br><small class="text-muted">CNPJ: @contract.Client.CNPJ</small>
                                        }
                                        else if (!string.IsNullOrEmpty(contract.Client.CPF))
                                        {
                                            <br><small class="text-muted">CPF: @contract.Client.CPF</small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contract.SnapshotAddress))
                                    {
                                        <small>@contract.SnapshotAddress</small>
                                    }
                                    else if (contract.CoworkingAddress != null)
                                    {
                                        <small>@contract.CoworkingAddress.Address, @contract.CoworkingAddress.Number<br>
                                        @contract.CoworkingAddress.City/@contract.CoworkingAddress.State</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (contract.CoworkingAddress?.Location != null)
                                    {
                                        <span class="badge bg-info">
                                            @contract.CoworkingAddress.Location.City/@contract.CoworkingAddress.Location.State
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <strong>R$ @(contract.SnapshotMonthlyValue > 0 ? contract.SnapshotMonthlyValue.ToString(NumberFormatConstants.TwoDecimals) : contract.MonthlyValue.ToString(NumberFormatConstants.TwoDecimals))</strong>
                                </td>
                                <td>
                                    @{
                                        string statusLabel;
                                        string statusBadgeClass;
                                        string statusIcon;
                                        if (contract.Status == ContractStatus.PendingPayment && contract.Subscription?.Payments != null && contract.Subscription.Payments.Any())
                                        {
                                            var latestPaymentStatus = contract.Subscription.Payments.OrderByDescending(p => p.CreatedAt).First().Status;
                                            if (latestPaymentStatus == PaymentStatus.AwaitingValidation || latestPaymentStatus == PaymentStatus.Processing)
                                            {
                                                statusLabel = "Aguardando Validação";
                                                statusBadgeClass = "bg-pending-payment";
                                                statusIcon = "bi-clock-history";
                                            }
                                            else
                                            {
                                                statusLabel = "Aguardando Pagamento";
                                                statusBadgeClass = "bg-pending-payment";
                                                statusIcon = "bi-cash-coin";
                                            }
                                        }
                                        else
                                        {
                                            switch (contract.Status)
                                            {
                                                case ContractStatus.Active:
                                                    statusLabel = "Ativo";
                                                    statusBadgeClass = "bg-active";
                                                    statusIcon = "bi-check-circle-fill";
                                                    break;
                                                case ContractStatus.Suspended:
                                                    statusLabel = "Suspenso";
                                                    statusBadgeClass = "bg-suspended";
                                                    statusIcon = "bi-pause-circle-fill";
                                                    break;
                                                case ContractStatus.PendingPayment:
                                                    statusLabel = "Aguardando Pagamento";
                                                    statusBadgeClass = "bg-pending-payment";
                                                    statusIcon = "bi-cash-coin";
                                                    break;
                                                case ContractStatus.PendingCancellation:
                                                    statusLabel = "Cancelamento Pendente";
                                                    statusBadgeClass = "bg-pending-cancellation";
                                                    statusIcon = "bi-clock-history";
                                                    break;
                                                case ContractStatus.Cancelled:
                                                    statusLabel = "Cancelado";
                                                    statusBadgeClass = "bg-cancelled";
                                                    statusIcon = "bi-x-circle-fill";
                                                    break;
                                                case ContractStatus.Expired:
                                                    statusLabel = "Expirado";
                                                    statusBadgeClass = "bg-expired";
                                                    statusIcon = "bi-calendar-x-fill";
                                                    break;
                                                default:
                                                    statusLabel = contract.Status.ToString();
                                                    statusBadgeClass = "bg-expired";
                                                    statusIcon = "bi-question-circle-fill";
                                                    break;
                                            }
                                        }
                                    }
                                    <span class="badge @statusBadgeClass"><i class="bi @statusIcon me-1"></i> @statusLabel</span>
                                </td>
                                <td>@contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                <td>
                                    <a href="@Url.Action("ContractDetails", "Client", new { id = contract.Id })" 
                                       class="btn btn-sm btn-info" title="Visualizar">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (contract.Status == ContractStatus.Active)
                                    {
                                        <button class="btn btn-sm btn-warning" onclick="suspendContract(@contract.Id)" title="Suspender">
                                            <i class="bi bi-pause"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center mt-4">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Contracts", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    clientId = ViewBag.ClientId, 
                                    page = ViewBag.CurrentPage - 1,
                                    pageSize = pageSizeVal
                                })">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? CssClasses.Active : "")">
                                <a class="page-link" href="@Url.Action("Contracts", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    clientId = ViewBag.ClientId, 
                                    page = i,
                                    pageSize = pageSizeVal
                                })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Contracts", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    clientId = ViewBag.ClientId, 
                                    page = ViewBag.CurrentPage + 1,
                                    pageSize = pageSizeVal
                                })">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
            else if (ViewBag.TotalPages != null && ViewBag.TotalPages == 1 && ViewBag.TotalItems > 0)
            {
                <div class="text-center mt-3">
                    <small class="text-muted">Todos os @ViewBag.TotalItems contrato(s) estão sendo exibidos nesta página.</small>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum contrato encontrado.
                @if (ViewBag.Search != null || ViewBag.Status != null || ViewBag.ClientId != null)
                {
                    <a href="@Url.Action("Contracts", "Admin")" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="bi bi-x-circle"></i> Limpar Filtros
                    </a>
                }
            </div>
        }
    </div>
</div>

<script>
async function suspendContract(contractId) {
    const confirmed = await showConfirm(
        'Tem certeza que deseja suspender este contrato?',
        'Confirmar Suspensão',
        'warning'
    );
    
    if (confirmed) {
        showToast('Funcionalidade de suspensão será implementada em breve. Contrato ID: ' + contractId, 'info');
    }
}

// Resetar página para 1 quando o tamanho da página mudar
document.addEventListener('DOMContentLoaded', function() {
    var pageSizeSelect = document.getElementById('pageSize');
    if (pageSizeSelect) {
        pageSizeSelect.addEventListener('change', function() {
            document.getElementById('pageInput').value = '1';
            document.getElementById('filterForm').submit();
        });
    }
});
</script>

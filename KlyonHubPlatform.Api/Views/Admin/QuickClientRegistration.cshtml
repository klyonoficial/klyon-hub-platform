@{
    ViewData["Title"] = "Cadastro Rápido de Cliente com Endereço Fiscal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-plus-fill"></i> Cadastro Rápido de Cliente com Endereço Fiscal</h2>
    <a href="@Url.Action("Contracts", "Admin")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar para Contratos
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person"></i> Dados do Cliente</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("QuickClientRegistration", "Admin")" id="clientForm">
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="contactEmail" class="form-label">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="contactEmail" name="contactEmail" required>
                            <small class="form-text text-muted">Se o usuário já existir, será usado o cadastro existente.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="contactName" class="form-label">Nome do Contato <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="contactName" name="contactName" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="razaoSocial" class="form-label">Razão Social</label>
                            <input type="text" class="form-control" id="razaoSocial" name="razaoSocial">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="nomeFantasia" class="form-label">Nome Fantasia</label>
                            <input type="text" class="form-control" id="nomeFantasia" name="nomeFantasia">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="cnpj" class="form-label">CNPJ</label>
                            <input type="text" class="form-control" id="cnpj" name="cnpj" placeholder="00.000.000/0000-00" maxlength="18">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cpf" class="form-label">CPF (se pessoa física)</label>
                            <input type="text" class="form-control" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="contactPhone" class="form-label">Telefone</label>
                            <input type="text" class="form-control" id="contactPhone" name="contactPhone" placeholder="(00) 00000-0000" maxlength="15">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="zipCode" class="form-label">CEP</label>
                            <input type="text" class="form-control" id="zipCode" name="zipCode" placeholder="00000-000" maxlength="9">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="address" class="form-label">Endereço</label>
                            <input type="text" class="form-control" id="address" name="address">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="city" class="form-label">Cidade</label>
                            <input type="text" class="form-control" id="city" name="city">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="state" class="form-label">Estado</label>
                            <select class="form-select" id="state" name="state">
                                <option value="">Selecione o estado</option>
                                <option value="AC">AC - Acre</option>
                                <option value="AL">AL - Alagoas</option>
                                <option value="AP">AP - Amapá</option>
                                <option value="AM">AM - Amazonas</option>
                                <option value="BA">BA - Bahia</option>
                                <option value="CE">CE - Ceará</option>
                                <option value="DF">DF - Distrito Federal</option>
                                <option value="ES">ES - Espírito Santo</option>
                                <option value="GO">GO - Goiás</option>
                                <option value="MA">MA - Maranhão</option>
                                <option value="MT">MT - Mato Grosso</option>
                                <option value="MS">MS - Mato Grosso do Sul</option>
                                <option value="MG">MG - Minas Gerais</option>
                                <option value="PA">PA - Pará</option>
                                <option value="PB">PB - Paraíba</option>
                                <option value="PR">PR - Paraná</option>
                                <option value="PE">PE - Pernambuco</option>
                                <option value="PI">PI - Piauí</option>
                                <option value="RJ">RJ - Rio de Janeiro</option>
                                <option value="RN">RN - Rio Grande do Norte</option>
                                <option value="RS">RS - Rio Grande do Sul</option>
                                <option value="RO">RO - Rondônia</option>
                                <option value="RR">RR - Roraima</option>
                                <option value="SC">SC - Santa Catarina</option>
                                <option value="SP">SP - São Paulo</option>
                                <option value="SE">SE - Sergipe</option>
                                <option value="TO">TO - Tocantins</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-building"></i> Endereço Fiscal</h5>
            </div>
            <div class="card-body">
                <form id="contractForm">
                    <div class="mb-3">
                        <label for="coworkingAddressId" class="form-label">Endereço Disponível <span class="text-danger">*</span></label>
                        <select class="form-select" id="coworkingAddressId" name="coworkingAddressId" required>
                            <option value="">Selecione um endereço</option>
                            @if (ViewBag.AvailableAddresses != null)
                            {
                                foreach (var addr in (List<KlyonHubPlatform.Domain.Entities.CoworkingAddress>)ViewBag.AvailableAddresses)
                                {
                                    var locationLabel = addr.Location != null ? $"{addr.Location.City}/{addr.Location.State}" : "N/A";
                                    var coworkingName = addr.Coworking?.Name ?? "N/A";
                                    var vacancies = addr.MaxContracts - addr.CurrentContracts;
                                    <option value="@addr.Id" 
                                            data-location="@locationLabel" 
                                            data-coworking="@coworkingName" 
                                            data-vacancies="@vacancies"
                                            data-base-price="@addr.BasePrice.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                        @coworkingName - @addr.Address, @addr.Number (@locationLabel) - R$ @addr.BasePrice.ToString("F2")
                                        @if (vacancies <= 2)
                                        {
                                            <text> - Apenas @vacancies @(vacancies == 1 ? "vaga" : "vagas")</text>
                                        }
                                    </option>
                                }
                            }
                        </select>
                        <small class="form-text text-muted" id="addressInfo"></small>
                    </div>

                    <div class="mb-3">
                        <label for="monthlyValue" class="form-label">Valor Anual (R$) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input type="number" class="form-control" id="monthlyValue" name="monthlyValue" 
                                   step="0.01" min="0.01" required placeholder="0,00" readonly>
                        </div>
                        <small class="form-text text-muted">Valor anual definido automaticamente pelo endereço selecionado.</small>
                    </div>

                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label">Forma de Pagamento <span class="text-danger">*</span></label>
                        <select class="form-select" id="paymentMethod" name="paymentMethod" required>
                            <option value="PIX" selected>PIX</option>
                        </select>
                        <small class="form-text text-muted">O código PIX será gerado automaticamente após o cadastro.</small>
                    </div>

                    <button type="button" class="btn btn-primary w-100" onclick="submitForms()">
                        <i class="bi bi-check-circle"></i> Cadastrar Cliente e Criar Contrato
                    </button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informações</h6>
            </div>
            <div class="card-body">
                <ul class="small mb-0">
                    <li>O sistema criará automaticamente um usuário se o email não existir.</li>
                    <li>A senha padrão será as 4 primeiras letras do email (ex: email@exemplo.com = "emai").</li>
                    <li>O cliente será solicitado a alterar a senha no primeiro login.</li>
                    <li>O contrato será criado com status "Aguardando Pagamento".</li>
                    <li>O código PIX será gerado automaticamente.</li>
                    <li>O cliente receberá um email com credenciais e link direto para pagamento.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Máscaras de entrada
        document.getElementById('cnpj')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 14) {
                value = value.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5');
                e.target.value = value;
            }
        });

        document.getElementById('cpf')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 11) {
                value = value.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4');
                e.target.value = value;
            }
        });

        document.getElementById('contactPhone')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 11) {
                if (value.length <= 10) {
                    value = value.replace(/^(\d{2})(\d{4})(\d{4})$/, '($1) $2-$3');
                } else {
                    value = value.replace(/^(\d{2})(\d{5})(\d{4})$/, '($1) $2-$3');
                }
                e.target.value = value;
            }
        });

        document.getElementById('zipCode')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length <= 8) {
                value = value.replace(/^(\d{5})(\d{3})$/, '$1-$2');
                e.target.value = value;
            }
        });

        // Atualizar informações do endereço selecionado e preencher valor anual automaticamente
        document.getElementById('coworkingAddressId')?.addEventListener('change', function(e) {
            const option = e.target.options[e.target.selectedIndex];
            const info = document.getElementById('addressInfo');
            const monthlyValueInput = document.getElementById('monthlyValue');
            
            if (option.value) {
                const location = option.getAttribute('data-location');
                const coworking = option.getAttribute('data-coworking');
                const vacancies = option.getAttribute('data-vacancies');
                const basePrice = option.getAttribute('data-base-price');
                
                // Atualizar informações do endereço
                info.textContent = `${coworking} - ${location} (${vacancies} ${vacancies == 1 ? 'vaga disponível' : 'vagas disponíveis'})`;
                info.className = 'form-text text-muted';
                
                // Preencher valor anual automaticamente com o preço base
                if (basePrice && monthlyValueInput) {
                    monthlyValueInput.value = parseFloat(basePrice).toFixed(2);
                }
            } else {
                info.textContent = '';
                if (monthlyValueInput) {
                    monthlyValueInput.value = '';
                }
            }
        });

        // Formatar valor monetário
        document.getElementById('monthlyValue')?.addEventListener('blur', function(e) {
            const value = parseFloat(e.target.value);
            if (!isNaN(value) && value > 0) {
                e.target.value = value.toFixed(2);
            }
        });

        async function submitForms() {
            const clientForm = document.getElementById('clientForm');
            const contractForm = document.getElementById('contractForm');
            
            // Validar formulário de cliente
            if (!clientForm.checkValidity()) {
                clientForm.reportValidity();
                return;
            }

            // Validar formulário de contrato
            if (!contractForm.checkValidity()) {
                contractForm.reportValidity();
                return;
            }

            // Desabilitar botão durante o envio
            const submitBtn = document.querySelector('button[onclick="submitForms()"]');
            const originalBtnHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Cadastrando...';

            try {
                // Montar objeto de request para a API
                const requestData = {
                    contactEmail: document.getElementById('contactEmail').value,
                    contactName: document.getElementById('contactName').value,
                    razaoSocial: document.getElementById('razaoSocial').value || null,
                    nomeFantasia: document.getElementById('nomeFantasia').value || null,
                    cnpj: document.getElementById('cnpj').value || null,
                    cpf: document.getElementById('cpf').value || null,
                    contactPhone: document.getElementById('contactPhone').value || null,
                    address: document.getElementById('address').value || null,
                    city: document.getElementById('city').value || null,
                    state: document.getElementById('state').value || null,
                    zipCode: document.getElementById('zipCode').value || null,
                    coworkingAddressId: parseInt(document.getElementById('coworkingAddressId').value),
                    monthlyValue: parseFloat(document.getElementById('monthlyValue').value),
                    paymentMethod: document.getElementById('paymentMethod').value
                };

                // Chamar a nova API
                const response = await fetch('/api/QuickClientApi/Register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify(requestData)
                });

                const result = await response.json();

                if (result.success) {
                    // Redirecionar para página de sucesso com os dados do pagamento
                    if (result.paymentId) {
                        window.location.href = `/Admin/QuickClientRegistrationSuccess?paymentId=${result.paymentId}`;
                    } else {
                        // Se não houver pagamento, redirecionar para contratos
                        alert(result.message);
                        window.location.href = '/Admin/Contracts';
                    }
                } else {
                    // Exibir erro
                    alert('Erro: ' + result.message);
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalBtnHtml;
                }
            } catch (error) {
                console.error('Erro ao cadastrar cliente:', error);
                alert('Erro ao cadastrar cliente. Por favor, tente novamente.');
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnHtml;
            }
        }
    </script>
}

                                <button class="btn btn-sm btn-outline-primary mt-2" onclick="copyToEditor('SHOW TABLES;')">
                                    <i class="bi bi-clipboard"></i> Copiar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        details summary {
            cursor: pointer;
            user-select: none;
        }
        details summary:hover {
            opacity: 0.8;
        }
        details[open] summary .bi-chevron-down::before {
            content: "\f284"; /* bi-chevron-up */
        }
    </style>
    <script>
        function copyToEditor(text) {
            const textarea = document.querySelector('textarea[name="sqlQuery"]');
            textarea.value = text;
            textarea.focus();
        }
        // Funções para confirmações elegantes
        async function handleExecuteMigrations(button) {
            const confirmed = await showConfirm(
                '⚠️ ATENÇÃO: Você está prestes a executar @pendingMigrations.Count migration(s) no banco de dados.\n\nIsso irá:\n- Criar novas tabelas\n- Adicionar/modificar colunas\n- Criar índices\n- Aplicar outras alterações de estrutura\n\nTem certeza que deseja continuar?',
                'Confirmar Execução de Migrations',
                'warning'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }

        async function handleCreateTable(form, message) {
            const confirmed = await showConfirm(
                message,
                'Confirmar Criação de Tabela',
                'info'
            );
            
            if (confirmed) {
                form.submit();
            }
        }

        async function handleAddColumn(form, message) {
            const confirmed = await showConfirm(
                message,
                'Confirmar Adição de Coluna',
                'info'
            );
            
            if (confirmed) {
                form.submit();
            }
        }

        async function handleClearDatabase(button) {
            const confirmed = await showConfirm(
                '⚠️ ATENÇÃO: Você está prestes a APAGAR TODOS OS DADOS DE TESTE do banco de dados.\n\nIsso irá:\n- Apagar todos os contratos, reservas e pagamentos\n- Apagar todos os clientes e coworkings\n- Apagar todos os usuários (exceto admin)\n- Limpar comissões, transferências e notas fiscais\n\nDados preservados:\n- Roles e permissões\n- Configurações do sistema\n- Localidades e Serviços\n- Usuário administrador\n\nTem CERTEZA ABSOLUTA que deseja continuar?',
                '⚠️ Confirmar Limpeza de Base',
                'danger'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }

        async function handleExecuteQuery(button) {
            const confirmed = await showConfirm(
                'Tem certeza que deseja executar esta query?',
                'Confirmar Execução de Query',
                'warning'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}

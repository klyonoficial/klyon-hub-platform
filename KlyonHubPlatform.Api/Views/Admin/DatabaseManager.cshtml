@using System.Linq
@using System.Collections.Generic
@{
    ViewData["Title"] = "Gerenciador de Banco de Dados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-database"></i> Gerenciador de Banco de Dados</h2>
    <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar ao Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <i class="bi bi-info-circle"></i> @TempData["Info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Aviso de Segurança</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Esta ferramenta permite executar queries SQL diretamente no banco de dados.</strong></p>
                <ul class="mb-0">
                    <li>Use apenas para <strong>ALTER TABLE</strong>, <strong>CREATE TABLE</strong>, <strong>CREATE INDEX</strong> ou <strong>ADD COLUMN</strong></li>
                    <li>Operações perigosas como <strong>DROP</strong>, <strong>DELETE</strong> e <strong>TRUNCATE</strong> são bloqueadas</li>
                    <li>Sempre faça backup antes de executar queries que alteram a estrutura do banco</li>
                    <li>Teste as queries em ambiente de desenvolvimento primeiro</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@{
    var pendingMigrations = ViewBag.PendingMigrations as List<string> ?? new List<string>();
    var appliedMigrations = ViewBag.AppliedMigrations as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card border-primary shadow-lg">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-arrow-repeat"></i> Migrations do Entity Framework</h4>
                <small>Execute as migrations para aplicar alterações de estrutura do banco de dados</small>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    <strong>O que são migrations?</strong> As migrations são scripts que criam ou alteram a estrutura do banco de dados 
                    (tabelas, colunas, índices, etc.). Execute-as sempre que houver novas alterações de estrutura.
                </p>
                <p class="mb-3 text-muted">
                    <i class="bi bi-info-circle"></i> Equivale ao comando <code>dotnet ef database update</code> executado via terminal.
                </p>
                
                @if (pendingMigrations.Any())
                {
                    <div class="alert alert-warning mb-4 border-warning">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                            <div class="flex-grow-1">
                                <h5 class="alert-heading mb-2">
                                    <strong>@pendingMigrations.Count Migration(s) Pendente(s)</strong>
                                </h5>
                                <p class="mb-2">
                                    As seguintes alterações de estrutura estão aguardando execução:
                                </p>
                                <ul class="mb-3">
                                    @foreach (var m in pendingMigrations)
                                    {
                                        <li><code class="bg-light p-1 rounded">@m</code></li>
                                    }
                                </ul>
                                <form method="post" action="@Url.Action("RunMigrations", "Admin")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-warning btn-lg" 
                                            onclick="event.preventDefault(); handleExecuteMigrations(this);">
                                        <i class="bi bi-play-circle-fill"></i> Executar @pendingMigrations.Count Migration(s) Pendente(s)
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success mb-4 border-success">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill fs-3 me-3"></i>
                            <div>
                                <h5 class="alert-heading mb-1">
                                    <strong>Banco de Dados Atualizado</strong>
                                </h5>
                                <p class="mb-2">Nenhuma migration pendente. Todas as alterações de estrutura já foram aplicadas.</p>
                                <form method="post" action="@Url.Action("RunMigrations", "Admin")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-arrow-clockwise"></i> Verificar Novamente
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                @if (appliedMigrations.Any())
                {
                    <hr class="my-4" />
                    <details class="mt-3">
                        <summary class="text-primary fw-bold" style="cursor: pointer;">
                            <i class="bi bi-chevron-down"></i> Ver @appliedMigrations.Count() Migration(s) Já Aplicada(s)
                        </summary>
                        <div class="mt-3 p-3 bg-light rounded" style="max-height: 300px; overflow-y: auto;">
                            <ul class="small mb-0">
                                @foreach (var m in appliedMigrations.Take(50))
                                {
                                    <li class="mb-1">
                                        <code class="text-success">@m</code>
                                        <span class="badge bg-success ms-2">Aplicada</span>
                                    </li>
                                }
                                @if (appliedMigrations.Count() > 50)
                                {
                                    <li class="text-muted">... e mais @(appliedMigrations.Count() - 50) migration(s)</li>
                                }
                            </ul>
                        </div>
                    </details>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Limpar Base de Dados (Testes)</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning mb-3">
                    <h6 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> Atenção!</h6>
                    <p class="mb-2">Esta ação irá <strong>apagar todos os dados de teste</strong> do banco de dados, incluindo:</p>
                    <ul class="mb-2">
                        <li>Contratos, Reservas, Pagamentos</li>
                        <li>Clientes, Coworkings, Endereços</li>
                        <li>Comissões, Transferências, Notas Fiscais</li>
                        <li>Usuários (exceto o administrador)</li>
                    </ul>
                    <p class="mb-0"><strong>Serão preservados:</strong> Roles, Configurações do Sistema, Localidades, Serviços e o usuário administrador.</p>
                </div>
                <form method="post" action="@Url.Action("ClearDatabase", "Admin")" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-lg" 
                            onclick="event.preventDefault(); handleClearDatabase(this);">
                        <i class="bi bi-trash-fill"></i> Limpar Base
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-code-square"></i> Executar Query SQL</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("ExecuteSql", "Admin")">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label">Query SQL:</label>
                        <textarea class="form-control font-monospace" name="sqlQuery" rows="10" required 
                                  placeholder="Exemplo: ALTER TABLE CoworkingAddresses ADD COLUMN MaxPeople INT DEFAULT 1;">@TempData["ExecutedQuery"]</textarea>
                        <small class="form-text text-muted">
                            Digite sua query SQL aqui. Exemplos permitidos:
                            <ul class="mb-0 mt-2">
                                <li><code>ALTER TABLE NomeTabela ADD COLUMN NomeColuna TIPO;</code></li>
                                <li><code>CREATE TABLE NomeTabela (Coluna1 TIPO, Coluna2 TIPO);</code></li>
                                <li><code>SELECT * FROM NomeTabela LIMIT 10;</code></li>
                            </ul>
                        </small>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary" onclick="event.preventDefault(); handleExecuteQuery(this);">
                            <i class="bi bi-play-circle"></i> Executar Query
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="document.querySelector('textarea[name=\'sqlQuery\']').value = '';">
                            <i class="bi bi-x-circle"></i> Limpar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (TempData["QueryResult"] != null)
{
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle"></i> Resultado da Query</h5>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded" style="max-height: 500px; overflow-y: auto; white-space: pre-wrap; word-wrap: break-word;">@TempData["QueryResult"]</pre>
                </div>
            </div>
        </div>
    </div>
}

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">

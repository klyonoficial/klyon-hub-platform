@{
    ViewData[ViewDataKeys.Title] = "Emitir NF de Comissão";
    Layout = LayoutPaths.Layout;
}

@model List<KlyonHubPlatform.Domain.Entities.Commission>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt-cutoff"></i> Emitir NF de Comissão</h2>
    <a href="@Url.Action(ActionNames.FiscalNotes, ControllerNames.Admin)" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar para Notas Fiscais
    </a>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action(ActionNames.CommissionFiscalNotes, ControllerNames.Admin)" class="row g-3">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 10)" />
            <div class="col-md-4">
                <label for="coworkingId" class="form-label">Parceiro</label>
                <select class="form-select" id="coworkingId" name="coworkingId">
                    <option value="">Todos</option>
                    @foreach (var coworking in ViewBag.Coworkings as List<KlyonHubPlatform.Domain.Entities.Coworking>)
                    {
                        <option value="@coworking.Id" selected="@(ViewBag.CoworkingId != null && ViewBag.CoworkingId == coworking.Id)">
                            @coworking.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label for="clientId" class="form-label">Cliente</label>
                <select class="form-select" id="clientId" name="clientId" style="width: 100%;">
                    <option value="">Todos</option>
                    @if (ViewBag.SelectedClient != null)
                    {
                        var selectedClient = ViewBag.SelectedClient as KlyonHubPlatform.Domain.Entities.Client;
                        <option value="@selectedClient.Id" selected>
                            @(selectedClient.RazaoSocial ?? selectedClient.NomeFantasia ?? selectedClient.ContactName ?? "Sem nome") - @(selectedClient.CNPJ ?? selectedClient.CPF ?? "Sem documento")
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action(ActionNames.CommissionFiscalNotes, ControllerNames.Admin)" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Resumo -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-list-check"></i> Total de Comissões</h6>
                <h2 class="mb-0">@ViewBag.TotalItems</h2>
                <small class="text-white-50">Aguardando emissão de NF</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-cash-coin"></i> Valor Total</h6>
                <h2 class="mb-0">R$ @(Model.Sum(c => c.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals))</h2>
                <small class="text-white-50">Em comissões pendentes</small>
            </div>
        </div>
    </div>
</div>

<!-- Lista de Comissões -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            var totalItems = (int)ViewBag.TotalItems;
            var currentPage = (int)ViewBag.CurrentPage;
            var totalPages = (int)ViewBag.TotalPages;
            var pageSize = (int)ViewBag.PageSize;
            var from = (currentPage - 1) * pageSize + 1;
            var to = Math.Min(currentPage * pageSize, totalItems);

            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <span class="text-muted">
                    Mostrando <strong>@from</strong> a <strong>@to</strong> de <strong>@totalItems</strong> comissões
                </span>
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Itens por página:</span>
                    <div class="btn-group btn-group-sm" role="group">
                        @foreach (var size in new[] { 10, 20, 50 })
                        {
                            <a href="@Url.Action("CommissionFiscalNotes", new { page = 1, pageSize = size, coworkingId = ViewBag.CoworkingId, clientId = ViewBag.ClientId })"
                               class="btn @(pageSize == size ? "btn-primary" : "btn-outline-secondary")">@size</a>
                        }
                    </div>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Código Contrato</th>
                            <th>Parceiro</th>
                            <th>Cliente</th>
                            <th>Serviço</th>
                            <th>Valor Total</th>
                            <th>Comissão</th>
                            <th>Data</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commission in Model)
                        {
                            var coworking = commission.Coworking;
                            var payment = commission.Payment;
                            var client = payment?.Subscription?.Contract?.Client ?? payment?.Reservation?.Client;
                            var serviceName = payment?.Subscription?.Contract != null ? "Endereço Fiscal" : "Reserva de Sala";
                            var location = payment?.Subscription?.Contract?.CoworkingAddress?.Location ?? payment?.Reservation?.CoworkingAddress?.Location;
                            var contractNumber = payment?.Subscription?.Contract?.ContractNumber;
                            
                            <tr class="commission-row" data-commission-id="@commission.Id" style="cursor: pointer;">
                                <td>#@commission.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contractNumber))
                                    {
                                        <strong>@contractNumber</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <strong>@coworking?.Name</strong><br>
                                    <small class="text-muted">@coworking?.CNPJ</small>
                                </td>
                                <td>
                                    @if (client != null)
                                    {
                                        <strong>@(client.RazaoSocial ?? client.NomeFantasia ?? client.User?.FullName)</strong><br>
                                        <small class="text-muted">@(client.CNPJ ?? client.CPF)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @serviceName<br>
                                    @if (location != null)
                                    {
                                        <small class="text-muted">@location.City/@location.State</small>
                                    }
                                </td>
                                <td>
                                    <strong>R$ @commission.TotalPaymentAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong>
                                </td>
                                <td>
                                    <strong class="text-primary">R$ @commission.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong><br>
                                    <small class="text-muted">@commission.Percentage.ToString(NumberFormatConstants.TwoDecimals)%</small>
                                </td>
                                <td>
                                    @commission.CreatedAt.ToString(DateFormatConstants.DisplayDateOnly)<br>
                                    <small class="text-muted">@commission.CreatedAt.ToString("HH:mm")</small>
                                </td>
                                <td onclick="event.stopPropagation();">
                                    <form method="post" action="@Url.Action(ActionNames.IssueCommissionFiscalNote, ControllerNames.Admin)" style="display: inline;" class="confirm-required">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="commissionId" value="@commission.Id" />
                                        <button type="submit" class="btn btn-sm btn-success mb-1" onclick="return confirm('Tem certeza que deseja emitir a NF de comissão para esta comissão?');">
                                            <i class="bi bi-file-earmark-check"></i> Emitir NF
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importNfModal" 
                                            data-commission-id="@commission.Id" 
                                            data-commission-amount="@commission.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)"
                                            data-client-name="@(client != null ? (client.RazaoSocial ?? client.NomeFantasia ?? client.User?.FullName ?? DefaultDisplayStrings.NotAvailable) : DefaultDisplayStrings.NotAvailable)">
                                        <i class="bi bi-upload"></i> Importar NF
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("CommissionFiscalNotes", new { page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize, coworkingId = ViewBag.CoworkingId, clientId = ViewBag.ClientId })">
                                    Anterior
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? CssClasses.Active : "")">
                                <a class="page-link" href="@Url.Action("CommissionFiscalNotes", new { page = i, pageSize = ViewBag.PageSize, coworkingId = ViewBag.CoworkingId, clientId = ViewBag.ClientId })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("CommissionFiscalNotes", new { page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize, coworkingId = ViewBag.CoworkingId, clientId = ViewBag.ClientId })">
                                    Próximo
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle"></i> Nenhuma comissão pendente de emissão de NF encontrada.
            </div>
        }
    </div>
</div>

<!-- Modal Detalhes da Comissão -->
<div class="modal fade" id="detalhesComissaoModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-info-circle"></i> Detalhes da Comissão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body" id="detalhesComissaoBody">
                <div class="text-center py-5" id="detalhesComissaoLoading">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 mb-0">Carregando...</p>
                </div>
                <div id="detalhesComissaoContent" class="d-none"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Importar NF -->
<div class="modal fade" id="importNfModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action(ActionNames.ImportCommissionFiscalNote, ControllerNames.Admin)" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="commissionId" id="importNfCommissionId" value="" />
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-upload"></i> Importar NF de Comissão</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Importe a NF de comissão já emitida. Esta ação não requer validação.</p>
                    <div class="mb-3">
                        <label class="form-label">Comissão / Cliente</label>
                        <p class="form-control-plaintext fw-bold" id="importNfCommissionInfo">-</p>
                    </div>
                    <div class="mb-3">
                        <label for="importNfPdf" class="form-label">PDF da NF <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="importNfPdf" name="pdfFile" accept=".pdf" required />
                    </div>
                    <div class="mb-3">
                        <label for="importNfXml" class="form-label">XML da NF (opcional)</label>
                        <input type="file" class="form-control" id="importNfXml" name="xmlFile" accept=".xml" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-upload"></i> Importar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Clique na linha: abrir modal de detalhes (exceto na coluna Ações)
            $(document).on('click', '.commission-row', function(e) {
                if ($(e.target).closest('td:last').length) return;
                var id = $(this).data('commission-id');
                if (!id) return;
                openDetalhesModal(id);
            });

            function openDetalhesModal(commissionId) {
                var $modal = $('#detalhesComissaoModal');
                var $loading = $('#detalhesComissaoLoading');
                var $content = $('#detalhesComissaoContent');
                $content.addClass('d-none').empty();
                $loading.removeClass('d-none');
                $modal.modal('show');

                $.get('@Url.Action(ActionNames.CommissionFiscalNoteDetail, ControllerNames.Admin)', { id: commissionId })
                    .done(function(data) {
                        $loading.addClass('d-none');
                        $content.removeClass('d-none').html(renderDetalhes(data));
                    })
                    .fail(function() {
                        $loading.addClass('d-none');
                        $content.removeClass('d-none').html('<div class="alert alert-danger">Não foi possível carregar os detalhes.</div>');
                    });
            }

            function fmtDate(d) {
                if (!d) return '-';
                var dt = new Date(d);
                return isNaN(dt.getTime()) ? d : dt.toLocaleDateString('pt-BR') + ' ' + dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
            }

            function renderDetalhes(d) {
                var html = '';
                html += '<div class="small">';

                html += '<h6 class="border-bottom pb-1 mb-2"><i class="bi bi-currency-dollar"></i> Comissão</h6>';
                html += '<table class="table table-sm table-borderless mb-3"><tbody>';
                html += '<tr><td class="text-muted">ID</td><td>#' + (d.commission && d.commission.id) + '</td></tr>';
                html += '<tr><td class="text-muted">Valor comissão</td><td><strong>R$ ' + (d.commission && parseFloat(d.commission.amount).toFixed(2).replace('.', ',')) + '</strong></td></tr>';
                html += '<tr><td class="text-muted">Percentual</td><td>' + (d.commission && parseFloat(d.commission.percentage).toFixed(2)) + '%</td></tr>';
                html += '<tr><td class="text-muted">Valor total do pagamento</td><td>R$ ' + (d.commission && parseFloat(d.commission.totalPaymentAmount).toFixed(2).replace('.', ',')) + '</td></tr>';
                html += '<tr><td class="text-muted">Data</td><td>' + fmtDate(d.commission && d.commission.createdAt) + '</td></tr>';
                html += '</tbody></table>';

                if (d.coworking) {
                    html += '<h6 class="border-bottom pb-1 mb-2"><i class="bi bi-building"></i> Parceiro</h6>';
                    html += '<table class="table table-sm table-borderless mb-3"><tbody>';
                    html += '<tr><td class="text-muted">Nome</td><td>' + (d.coworking.name || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">CNPJ</td><td>' + (d.coworking.cnpj || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Email</td><td>' + (d.coworking.contactEmail || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Telefone</td><td>' + (d.coworking.contactPhone || '-') + '</td></tr>';
                    html += '</tbody></table>';
                }

                if (d.payment) {
                    html += '<h6 class="border-bottom pb-1 mb-2"><i class="bi bi-credit-card"></i> Pagamento</h6>';
                    html += '<table class="table table-sm table-borderless mb-3"><tbody>';
                    html += '<tr><td class="text-muted">ID</td><td>#' + d.payment.id + '</td></tr>';
                    html += '<tr><td class="text-muted">Valor</td><td>R$ ' + parseFloat(d.payment.amount).toFixed(2).replace('.', ',') + '</td></tr>';
                    html += '<tr><td class="text-muted">Status</td><td>' + (d.payment.status || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Método</td><td>' + (d.payment.method || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Vencimento</td><td>' + fmtDate(d.payment.dueDate) + '</td></tr>';
                    html += '<tr><td class="text-muted">Pago em</td><td>' + fmtDate(d.payment.paidAt) + '</td></tr>';
                    html += '<tr><td class="text-muted">Criado em</td><td>' + fmtDate(d.payment.createdAt) + '</td></tr>';
                    if (d.payment.transactionId) html += '<tr><td class="text-muted">ID transação</td><td>' + d.payment.transactionId + '</td></tr>';
                    html += '</tbody></table>';
                }

                if (d.contract) {
                    html += '<h6 class="border-bottom pb-1 mb-2"><i class="bi bi-file-text"></i> Contrato (Endereço Fiscal)</h6>';
                    html += '<table class="table table-sm table-borderless mb-3"><tbody>';
                    html += '<tr><td class="text-muted">Código</td><td>' + (d.contract.contractNumber || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Início</td><td>' + fmtDate(d.contract.startDate) + '</td></tr>';
                    html += '<tr><td class="text-muted">Fim</td><td>' + fmtDate(d.contract.endDate) + '</td></tr>';
                    html += '<tr><td class="text-muted">Valor mensal</td><td>R$ ' + parseFloat(d.contract.monthlyValue).toFixed(2).replace('.', ',') + '</td></tr>';
                    html += '<tr><td class="text-muted">Status</td><td>' + (d.contract.status || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Endereço</td><td>' + (d.contract.address || '-') + '</td></tr>';
                    if (d.contract.location) html += '<tr><td class="text-muted">Localidade</td><td>' + (d.contract.location.city || '') + '/' + (d.contract.location.state || '') + '</td></tr>';
                    html += '</tbody></table>';
                }

                if (d.reservation) {
                    html += '<h6 class="border-bottom pb-1 mb-2"><i class="bi bi-calendar-check"></i> Reserva de Sala</h6>';
                    html += '<table class="table table-sm table-borderless mb-3"><tbody>';
                    html += '<tr><td class="text-muted">ID</td><td>#' + d.reservation.id + '</td></tr>';
                    html += '<tr><td class="text-muted">Data</td><td>' + fmtDate(d.reservation.reservationDate) + '</td></tr>';
                    html += '<tr><td class="text-muted">Horário</td><td>' + (d.reservation.startTime || '-') + ' a ' + (d.reservation.endTime || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Tipo sala</td><td>' + (d.reservation.roomType || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Valor</td><td>R$ ' + parseFloat(d.reservation.totalValue).toFixed(2).replace('.', ',') + '</td></tr>';
                    html += '<tr><td class="text-muted">Status</td><td>' + (d.reservation.status || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Endereço</td><td>' + (d.reservation.address || '-') + '</td></tr>';
                    if (d.reservation.location) html += '<tr><td class="text-muted">Localidade</td><td>' + (d.reservation.location.city || '') + '/' + (d.reservation.location.state || '') + '</td></tr>';
                    html += '</tbody></table>';
                }

                if (d.client) {
                    html += '<h6 class="border-bottom pb-1 mb-2"><i class="bi bi-person"></i> Cliente</h6>';
                    html += '<table class="table table-sm table-borderless mb-3"><tbody>';
                    html += '<tr><td class="text-muted">Nome / Razão Social</td><td>' + (d.client.name || '-') + '</td></tr>';
                    if (d.client.razaoSocial) html += '<tr><td class="text-muted">Razão Social</td><td>' + d.client.razaoSocial + '</td></tr>';
                    if (d.client.nomeFantasia) html += '<tr><td class="text-muted">Nome Fantasia</td><td>' + d.client.nomeFantasia + '</td></tr>';
                    html += '<tr><td class="text-muted">Contato</td><td>' + (d.client.contactName || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">CNPJ/CPF</td><td>' + (d.client.cnpj || d.client.cpf || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Email</td><td>' + (d.client.contactEmail || '-') + '</td></tr>';
                    html += '<tr><td class="text-muted">Telefone</td><td>' + (d.client.contactPhone || '-') + '</td></tr>';
                    html += '</tbody></table>';
                }

                html += '</div>';
                return html;
            }

            // Inicializar Select2 com AJAX para busca de clientes
            $('#clientId').select2({
                theme: 'bootstrap-5',
                language: {
                    noResults: function() {
                        return "Nenhum cliente encontrado";
                    },
                    searching: function() {
                        return "Buscando...";
                    },
                    loadingMore: function() {
                        return "Carregando mais resultados...";
                    }
                },
                placeholder: 'Digite para buscar um cliente...',
                allowClear: true,
                ajax: {
                    url: '@Url.Action(ActionNames.SearchClients, ControllerNames.Admin)',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return {
                            term: params.term || '',
                            page: params.page || 1,
                            pageSize: 10
                        };
                    },
                    processResults: function(data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.results,
                            pagination: {
                                more: data.pagination.more
                            }
                        };
                    },
                    cache: true
                },
                minimumInputLength: 0,
                width: '100%'
            });

            // Configurar modal de importação
            document.getElementById('importNfModal').addEventListener('show.bs.modal', function (e) {
                var btn = e.relatedTarget;
                if (!btn) return;
                var commissionId = btn.getAttribute('data-commission-id');
                var commissionAmount = btn.getAttribute('data-commission-amount');
                var clientName = btn.getAttribute('data-client-name');
                document.getElementById('importNfCommissionId').value = commissionId || '';
                document.getElementById('importNfCommissionInfo').textContent = (clientName || '-') + (commissionAmount ? ', Valor: R$ ' + commissionAmount : '');
                document.getElementById('importNfPdf').value = '';
                document.getElementById('importNfXml').value = '';
            });
        });
    </script>
}

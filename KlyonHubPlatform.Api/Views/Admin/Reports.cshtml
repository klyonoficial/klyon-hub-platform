@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData["Title"] = "Relatórios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Payment>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-graph-up"></i> Relatórios Financeiros</h2>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Período</h5>
                <p class="card-text">
                    @ViewBag.StartDate.ToString("dd/MM/yyyy") até @ViewBag.EndDate.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Total de Pagamentos</h5>
                <h3>@(((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments)?.Count ?? 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Total Recebido</h5>
                <h3>R$ @(((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments)?.Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount).ToString("F2") ?? "0.00")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Pendentes</h5>
                <h3>R$ @(((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments)?.Where(p => p.Status == PaymentStatus.Pending || p.Status == PaymentStatus.AwaitingValidation).Sum(p => p.Amount).ToString("F2") ?? "0.00")</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-list-ul"></i> Detalhamento de Pagamentos</h5>
    </div>
    <div class="card-body">
        @if (ViewBag.Payments != null && ((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments).Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Valor</th>
                            <th>Método</th>
                            <th>Cliente</th>
                            <th>Localidade</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in (List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.Payments)
                        {
                            <tr>
                                <td>
                                    @if (payment.PaidAt.HasValue)
                                    {
                                        @payment.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        @payment.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    }
                                </td>
                                <td>R$ @payment.Amount.ToString("F2")</td>
                                <td>
                                    @switch (payment.Method)
                                    {
                                        case PaymentMethod.PIX:
                                            <span class="badge bg-primary"><i class="bi bi-qr-code"></i> PIX</span>
                                            break;
                                        case PaymentMethod.CreditCard:
                                            <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão</span>
                                            break;
                                        case PaymentMethod.BankTransfer:
                                            <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @(payment.Subscription?.Contract?.Client?.RazaoSocial ?? 
                                      payment.Subscription?.Contract?.Client?.NomeFantasia ?? 
                                      "N/A")
                                </td>
                                <td>
                                    @(payment.Subscription?.Contract?.CoworkingAddress?.City ?? "N/A")/
                                    @(payment.Subscription?.Contract?.CoworkingAddress?.State ?? "")
                                </td>
                                <td>
                                    @switch (payment.Status)
                                    {
                                        case PaymentStatus.Pending:
                                            <span class="badge bg-warning">Pendente</span>
                                            break;
                                        case PaymentStatus.Processing:
                                            <span class="badge bg-info">Processando</span>
                                            break;
                                        case PaymentStatus.AwaitingValidation:
                                            <span class="badge bg-info"><i class="bi bi-clock-history"></i> Aguardando Validação</span>
                                            break;
                                        case PaymentStatus.Paid:
                                            <span class="badge bg-success">Pago</span>
                                            break;
                                        case PaymentStatus.Failed:
                                            <span class="badge bg-danger">Falhou</span>
                                            break;
                                        case PaymentStatus.Refunded:
                                            <span class="badge bg-secondary">Reembolsado</span>
                                            break;
                                        case PaymentStatus.Cancelled:
                                            <span class="badge bg-dark">Cancelado</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@payment.Status</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum pagamento encontrado no período selecionado.
            </div>
        }
    </div>
</div>

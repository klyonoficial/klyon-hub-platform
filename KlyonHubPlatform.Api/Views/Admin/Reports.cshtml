@using KlyonHubPlatform.Application.Interfaces
@{
    ViewData["Title"] = "Relatórios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var report = ViewBag.Report as ReportFinancialResult;
    var startDate = ViewBag.StartDate as DateTime? ?? DateTime.UtcNow.AddMonths(-1);
    var endDate = ViewBag.EndDate as DateTime? ?? DateTime.UtcNow;
    var product = ViewBag.Product as string ?? ReportProductFilter.Todos;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-graph-up"></i> Relatórios Financeiros</h2>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="@Url.Action("ReportCredits", "Admin")" class="btn btn-outline-primary"><i class="bi bi-wallet2"></i> Créditos por Cliente</a>
    <a href="@Url.Action("ReportCoworkingRevenue", "Admin")" class="btn btn-outline-primary"><i class="bi bi-building"></i> Receita por Coworking</a>
</div>

<form method="get" action="@Url.Action("Reports", "Admin")" class="card mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Data inicial</label>
                <input type="date" name="startDate" class="form-control" value="@startDate.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-3">
                <label class="form-label">Data final</label>
                <input type="date" name="endDate" class="form-control" value="@endDate.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-4">
                <label class="form-label">Produto</label>
                <select name="product" class="form-select">
                    @if (product == ReportProductFilter.Todos) { <option value="" selected>Todos</option> } else { <option value="">Todos</option> }
                    @if (product == ReportProductFilter.EnderecoFiscal) { <option value="@ReportProductFilter.EnderecoFiscal" selected>Endereço fiscal</option> } else { <option value="@ReportProductFilter.EnderecoFiscal">Endereço fiscal</option> }
                    @if (product == ReportProductFilter.AluguelSalas) { <option value="@ReportProductFilter.AluguelSalas" selected>Aluguel de salas</option> } else { <option value="@ReportProductFilter.AluguelSalas">Aluguel de salas</option> }
                    @if (product == ReportProductFilter.CertificadoDigitais) { <option value="@ReportProductFilter.CertificadoDigitais" selected>Certificado digitais</option> } else { <option value="@ReportProductFilter.CertificadoDigitais">Certificado digitais</option> }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Filtrar</button>
            </div>
        </div>
    </div>
</form>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Período</h5>
                <p class="card-text">
                    @startDate.ToString("dd/MM/yyyy") até @endDate.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info">
            <div class="card-body">
                <h5 class="card-title">Total de Pagamentos</h5>
                <h3>@(report?.TotalPayments ?? 0)</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Total Recebido</h5>
                <h3>R$ @(report?.TotalReceived.ToString("F2") ?? "0,00")</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning">
            <div class="card-body">
                <h5 class="card-title">Pendentes</h5>
                <h3>R$ @(report?.Pending.ToString("F2") ?? "0,00")</h3>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-list-ul"></i> Detalhamento de Pagamentos</h5>
    </div>
    <div class="card-body">
        @if (report != null && report.Rows.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Data</th>
                            <th>Produto</th>
                            <th>Valor</th>
                            <th>Método</th>
                            <th>Cliente</th>
                            <th>Localidade</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in report.Rows)
                        {
                            <tr>
                                <td>@row.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@row.ProductType</td>
                                <td>R$ @row.Amount.ToString("F2")</td>
                                <td>
                                    @if (row.Method == "PIX") { <span class="badge bg-primary"><i class="bi bi-qr-code"></i> PIX</span> }
                                    else if (row.Method == "Cartão") { <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão</span> }
                                    else if (row.Method == "Boleto") { <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto</span> }
                                    else { <span class="badge bg-secondary">@(row.Method ?? "-")</span> }
                                </td>
                                <td>@row.Client</td>
                                <td>@row.Location</td>
                                <td>
                                    @if (row.Status == "Pago") { <span class="badge bg-success">Pago</span> }
                                    else if (row.Status == "Pendente") { <span class="badge bg-warning">Pendente</span> }
                                    else if (row.Status == "Processando" || row.Status == "Aguardando Validação") { <span class="badge bg-info">@row.Status</span> }
                                    else if (row.Status == "Falhou" || row.Status == "Cancelado") { <span class="badge bg-danger">@row.Status</span> }
                                    else { <span class="badge bg-secondary">@row.Status</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum pagamento encontrado no período e produto selecionados.
            </div>
        }
    </div>
</div>

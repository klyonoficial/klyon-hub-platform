@{
    ViewData["Title"] = "Gerenciar Localidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Location>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-geo-alt"></i> Gerenciar Localidades</h2>
    <a href="@Url.Action("CreateLocation", "Admin")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nova Localidade
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Locations", "Admin")" class="row g-3">
            <div class="col-md-3">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Cidade ou Estado">
            </div>
            <div class="col-md-2">
                <label for="state" class="form-label">Estado</label>
                <select class="form-select" id="state" name="state">
                    <option value="">Todos</option>
                    @foreach (var stateOption in ViewBag.States as List<string> ?? new List<string>())
                    {
                        <option value="@stateOption" selected="@(ViewBag.State == stateOption)">@stateOption</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="region" class="form-label">Região</label>
                <select class="form-select" id="region" name="region">
                    <option value="">Todas</option>
                    @foreach (var regionOption in ViewBag.Regions as List<string> ?? new List<string>())
                    {
                        <option value="@regionOption" selected="@(ViewBag.Region == regionOption)">@regionOption</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="active" selected="@(ViewBag.Status == "active")">Ativas</option>
                    <option value="inactive" selected="@(ViewBag.Status == "inactive")">Inativas</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action("Locations", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    <div class="mb-3">
        <small class="text-muted">
            Mostrando @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) a @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems)) 
            de @ViewBag.TotalItems localidade(s)
        </small>
    </div>
}

<div class="row">
    @foreach (var location in Model)
    {
        var commissions = ViewBag.Commissions as List<KlyonHubPlatform.Domain.Entities.LocationCommission>;
        var activeCommission = commissions?.FirstOrDefault(lc => lc.LocationId == location.Id && lc.IsActive);
        
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-geo-alt-fill text-primary"></i> @location.City
                    </h5>
                    <p class="card-text">
                        <strong>Estado:</strong> @location.State<br>
                        <strong>Região:</strong> @location.Region
                    </p>
                    <hr>
                    <form method="post" action="@Url.Action("UpdateLocationCommission", "Admin")" id="form_@location.Id">
                        <input type="hidden" name="locationId" value="@location.Id">
                        <div class="mb-3">
                            <label for="commission_@location.Id" class="form-label">Comissão (%)</label>
                            <input type="number" step="0.1" min="0" max="100" class="form-control" 
                                   id="commission_@location.Id" 
                                   name="commissionPercentage" 
                                   value="@(activeCommission?.CommissionPercentage.ToString("F1") ?? "15.0")" 
                                   required>
                            @if (activeCommission != null)
                            {
                                <small class="form-text text-success">
                                    <i class="bi bi-check-circle"></i> Valor atual: <strong>@activeCommission.CommissionPercentage.ToString("F1")%</strong>
                                </small>
                            }
                            else
                            {
                                <small class="form-text text-muted">
                                    <i class="bi bi-info-circle"></i> Valor padrão: 15.0%
                                </small>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-save"></i> Atualizar Comissão
                        </button>
                    </form>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-@(location.IsActive ? "success" : "danger")">
                            @(location.IsActive ? "Ativa" : "Inativa")
                        </span>
                        <div class="btn-group btn-group-sm">
                            <a href="@Url.Action("EditLocation", "Admin", new { id = location.Id })" class="btn btn-sm btn-warning" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" action="@Url.Action("DeleteLocation", "Admin", new { id = location.Id })" class="d-inline" 
                                  onsubmit="return confirm('Tem certeza que deseja excluir esta localidade? Esta ação não pode ser desfeita.');">
                                <button type="submit" class="btn btn-sm btn-danger" title="Excluir">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Nenhuma localidade encontrada com os filtros aplicados.
    </div>
}

<!-- Paginação -->
@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <nav aria-label="Paginação de localidades">
        <ul class="pagination justify-content-center">
            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Locations", "Admin", new { 
                        search = ViewBag.Search, 
                        state = ViewBag.State, 
                        region = ViewBag.Region, 
                        status = ViewBag.Status, 
                        page = ViewBag.CurrentPage - 1 
                    })">
                        <i class="bi bi-chevron-left"></i> Anterior
                    </a>
                </li>
            }

            @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Locations", "Admin", new { 
                        search = ViewBag.Search, 
                        state = ViewBag.State, 
                        region = ViewBag.Region, 
                        status = ViewBag.Status, 
                        page = i 
                    })">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Locations", "Admin", new { 
                        search = ViewBag.Search, 
                        state = ViewBag.State, 
                        region = ViewBag.Region, 
                        status = ViewBag.Status, 
                        page = ViewBag.CurrentPage + 1 
                    })">
                        Próxima <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
}

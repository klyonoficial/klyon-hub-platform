                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("CreateLocation", "Admin")" class="btn btn-outline-success w-100">
                            <i class="bi bi-plus-circle"></i><br>Nova Localidade
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("DatabaseManager", "Admin")" class="btn btn-outline-warning w-100 position-relative">
                            <i class="bi bi-database"></i><br>Banco de Dados
                            @if (pendingMigrationsCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @pendingMigrationsCount
                                    <span class="visually-hidden">migrations pendentes</span>
                                </span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];

// 1. Gráfico de Receita Bruta vs Líquida (substituindo o gráfico simples de receita)
const revenueBreakdownCtx = document.getElementById('revenueBreakdownChart').getContext('2d');
const monthlyRevenueBreakdown = @Html.Raw(Json.Serialize(ViewBag.MonthlyRevenueBreakdown ?? new List<dynamic>()));

if (monthlyRevenueBreakdown && monthlyRevenueBreakdown.length > 0) {
    const breakdownLabels = monthlyRevenueBreakdown.map(r => `${monthNames[r.month - 1]}/${r.year}`);
    
    new Chart(revenueBreakdownCtx, {
        type: 'bar',
        data: {
            labels: breakdownLabels,
            datasets: [
                {
                    label: 'Receita Bruta',
                    data: monthlyRevenueBreakdown.map(r => parseFloat(r.grossRevenue)),
                    backgroundColor: 'rgba(54, 162, 235, 0.7)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                },
                {
                    label: 'Receita Parceiro',
                    data: monthlyRevenueBreakdown.map(r => parseFloat(r.partnerRevenue)),
                    backgroundColor: 'rgba(255, 159, 64, 0.7)',
                    borderColor: 'rgba(255, 159, 64, 1)',
                    borderWidth: 1
                },
                {
                    label: 'Receita Líquida (Plataforma)',
                    data: monthlyRevenueBreakdown.map(r => parseFloat(r.netRevenue)),
                    backgroundColor: 'rgba(75, 192, 192, 0.7)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { position: 'top' },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return 'R$ ' + value.toLocaleString('pt-BR');
                        }
                    }
                }
            }
        }
    });
} else {
    document.getElementById('revenueBreakdownChart').parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhum dado de receita disponível.</p>';
}

// 2. Gráfico de Pagamentos por Método (lazy load - inicializa quando a seção for aberta)
const paymentsByMethod = @Html.Raw(Json.Serialize(ViewBag.PaymentsByMethod ?? new List<dynamic>()));
let paymentsByMethodChartInitialized = false;

function initPaymentsByMethodChart() {
    if (paymentsByMethodChartInitialized) return;
    paymentsByMethodChartInitialized = true;
    
    const paymentsByMethodCtx = document.getElementById('paymentsByMethodChart');
    if (!paymentsByMethodCtx) return;
    
    if (paymentsByMethod && paymentsByMethod.length > 0) {
        const methodColors = ['#4BC0C0', '#FF6384', '#36A2EB', '#FFCE56', '#9966FF'];
        
        new Chart(paymentsByMethodCtx.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: paymentsByMethod.map(p => p.methodDisplay),
                datasets: [{
                    data: paymentsByMethod.map(p => p.totalAmount),
                    backgroundColor: methodColors.slice(0, paymentsByMethod.length)
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const method = context.label || '';
                                const value = context.parsed || 0;
                                const count = paymentsByMethod[context.dataIndex]?.count || 0;
                                return [
                                    method + ': R$ ' + value.toLocaleString('pt-BR', {minimumFractionDigits: 2}),
                                    count + ' pagamento(s)'
                                ];
                            }
                        }
                    }
                }
            }
        });
    } else {
        paymentsByMethodCtx.parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhum pagamento registrado.</p>';
    }
}

// Inicializar quando a seção for aberta
document.getElementById('paymentsByMethodBody')?.addEventListener('shown.bs.collapse', initPaymentsByMethodChart);

// 3. Gráfico de Novos Contratos por Mês (lazy load)
const monthlyContracts = @Html.Raw(Json.Serialize(ViewBag.MonthlyContracts ?? new List<dynamic>()));
let monthlyContractsChartInitialized = false;

function initMonthlyContractsChart() {
    if (monthlyContractsChartInitialized) return;
    monthlyContractsChartInitialized = true;
    
    const monthlyContractsCtx = document.getElementById('monthlyContractsChart');
    if (!monthlyContractsCtx) return;
    
    if (monthlyContracts && monthlyContracts.length > 0) {
        const contractLabels = monthlyContracts.map(c => `${monthNames[c.month - 1]}/${c.year}`);
        
        new Chart(monthlyContractsCtx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: contractLabels,
                datasets: [{
                    label: 'Novos Contratos',
                    data: monthlyContracts.map(c => c.newContracts),
                    backgroundColor: 'rgba(75, 192, 192, 0.7)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    } else {
        monthlyContractsCtx.parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhum contrato registrado.</p>';
    }
}

document.getElementById('monthlyContractsBody')?.addEventListener('shown.bs.collapse', initMonthlyContractsChart);

// 4. Gráfico de Novos Clientes por Mês (lazy load)
const monthlyNewClients = @Html.Raw(Json.Serialize(ViewBag.MonthlyNewClients ?? new List<dynamic>()));
let monthlyClientsChartInitialized = false;

function initMonthlyClientsChart() {
    if (monthlyClientsChartInitialized) return;
    monthlyClientsChartInitialized = true;
    
    const monthlyClientsCtx = document.getElementById('monthlyClientsChart');
    if (!monthlyClientsCtx) return;
    
    if (monthlyNewClients && monthlyNewClients.length > 0) {
        const clientLabels = monthlyNewClients.map(c => `${monthNames[c.month - 1]}/${c.year}`);
        
        new Chart(monthlyClientsCtx.getContext('2d'), {
            type: 'line',
            data: {
                labels: clientLabels,
                datasets: [{
                    label: 'Novos Clientes',
                    data: monthlyNewClients.map(c => c.newClients),
                    borderColor: 'rgb(153, 102, 255)',
                    backgroundColor: 'rgba(153, 102, 255, 0.2)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    } else {
        monthlyClientsCtx.parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhum cliente registrado.</p>';
    }
}

document.getElementById('monthlyClientsBody')?.addEventListener('shown.bs.collapse', initMonthlyClientsChart);

// 5. Gráfico de Top 5 Coworkings por Receita
const topCoworkingsCtx = document.getElementById('topCoworkingsChart').getContext('2d');
const topCoworkingsByRevenue = @Html.Raw(Json.Serialize(ViewBag.TopCoworkingsByRevenue ?? new List<dynamic>()));

if (topCoworkingsByRevenue && topCoworkingsByRevenue.length > 0) {
    new Chart(topCoworkingsCtx, {
        type: 'bar',
        data: {
            labels: topCoworkingsByRevenue.map(c => c.coworkingName),
            datasets: [{
                label: 'Receita (R$)',
                data: topCoworkingsByRevenue.map(c => parseFloat(c.revenue)),
                backgroundColor: 'rgba(54, 162, 235, 0.7)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const coworking = topCoworkingsByRevenue[context.dataIndex];
                            return [
                                'Receita: R$ ' + context.parsed.x.toLocaleString('pt-BR', {minimumFractionDigits: 2}),
                                'Contratos: ' + (coworking?.contractsCount || 0)
                            ];
                        }
                    }
                }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return 'R$ ' + value.toLocaleString('pt-BR');
                        }
                    }
                }
            },
            onClick: (evt, items) => {
                if (items && items.length) {
                    const idx = items[0].index;
                    const coworking = topCoworkingsByRevenue[idx];
                    if (coworking?.coworkingId) window.location = '/Admin/ViewCoworking?id=' + coworking.coworkingId;
                }
            }
        }
    });
} else {
    document.getElementById('topCoworkingsChart').parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhum coworking com receita registrada.</p>';
}

// 6. Gráfico Top Localidades (lazy load - clique navega para Relatórios)
const topLocations = @Html.Raw(Json.Serialize(ViewBag.TopLocations));
let topLocationsChartInitialized = false;

function initTopLocationsChart() {
    if (topLocationsChartInitialized) return;
    topLocationsChartInitialized = true;
    
    const topLocationsCtx = document.getElementById('topLocationsChart');
    if (!topLocationsCtx) return;
    
    if (topLocations && topLocations.length > 0) {
        const locationLabels = topLocations.map(l => l.city);
        const locationData = topLocations.map(l => parseFloat(l.revenue));

        new Chart(topLocationsCtx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: locationLabels,
                datasets: [{
                    label: 'Receita (R$)',
                    data: locationData,
                    backgroundColor: 'rgba(153, 102, 255, 0.7)',
                    borderColor: 'rgba(153, 102, 255, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'R$ ' + context.parsed.x.toLocaleString('pt-BR', {minimumFractionDigits: 2});
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return 'R$ ' + value.toLocaleString('pt-BR');
                            }
                        }
                    }
                },
                onClick: (evt, items) => {
                    if (items && items.length) {
                        const idx = items[0].index;
                        const loc = topLocations[idx];
                        if (loc?.city) window.location = '/Admin/Reports?product=Todos';
                    }
                }
            }
        });
    } else {
        topLocationsCtx.parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhuma localidade com receita registrada.</p>';
    }
}

document.getElementById('topLocationsBody')?.addEventListener('shown.bs.collapse', initTopLocationsChart);

// 8. Gráfico de Produtos Oferecidos
const productsCtx = document.getElementById('productsChart');
const productsByTypeData = @Html.Raw(Json.Serialize(ViewBag.ProductsByType ?? new List<dynamic>()));

if (productsCtx && productsByTypeData && productsByTypeData.length > 0) {
    const productLabels = productsByTypeData.map(p => {
        const productType = p.productType;
        switch(productType) {
            case "FiscalAddress": return "Endereço Fiscal";
            case "RoomRental": return "Aluguéis de Sala";
            case "DigitalCertificate": return "Certificado Digital";
            default: return productType;
        }
    });
    const productData = productsByTypeData.map(p => p.count || 0);

    new Chart(productsCtx, {
        type: 'doughnut',
        data: {
            labels: productLabels,
            datasets: [{
                data: productData,
                backgroundColor: ['#4BC0C0', '#36A2EB', '#FFCE56', '#FF6384']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'bottom'
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const label = context.label || '';
                            const value = context.parsed || 0;
                            return label + ': ' + value + ' coworking(s)';
                        }
                    }
                }
            }
        }
    });
}

// 9. Gráfico de Reservas por Status (apenas se EnableCoworkingMenus estiver habilitado)
@if (showCoworkingMenus)
{
    <text>
    const reservationsStatusCtx = document.getElementById('reservationsByStatusChart');
    const reservationsByStatus = @Html.Raw(Json.Serialize(ViewBag.ReservationsByStatus ?? new List<dynamic>()));

    if (reservationsStatusCtx && reservationsByStatus && reservationsByStatus.length > 0) {
        const resvStatusMap = { 'Confirmed': 'Confirmadas', 'Cancelled': 'Canceladas', 'Completed': 'Concluídas', 'Pending': 'Pendentes' };
        const resvStatusColors = {
            'Confirmed': 'rgba(54, 162, 235, 0.7)',
            'Cancelled': 'rgba(255, 99, 132, 0.7)',
            'Completed': 'rgba(75, 192, 192, 0.7)',
            'Pending': 'rgba(255, 206, 86, 0.7)'
        };
        const resvStatusBorderColors = {
            'Confirmed': 'rgba(54, 162, 235, 1)',
            'Cancelled': 'rgba(255, 99, 132, 1)',
            'Completed': 'rgba(75, 192, 192, 1)',
            'Pending': 'rgba(255, 206, 86, 1)'
        };

        new Chart(reservationsStatusCtx, {
            type: 'bar',
            data: {
                labels: reservationsByStatus.map(r => resvStatusMap[r.status] || r.status),
                datasets: [{
                    label: 'Quantidade',
                    data: reservationsByStatus.map(r => r.count || 0),
                    backgroundColor: reservationsByStatus.map(r => resvStatusColors[r.status] || 'rgba(128, 128, 128, 0.6)'),
                    borderColor: reservationsByStatus.map(r => resvStatusBorderColors[r.status] || 'rgba(128, 128, 128, 1)'),
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {

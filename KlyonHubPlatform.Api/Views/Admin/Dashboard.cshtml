    } else if (reservationsStatusCtx) {
        document.getElementById('reservationsByStatusChart').parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhuma reserva cadastrada ainda.</p>';
    }
    </text>
}

// URLs base para ações (definidas uma vez)
const baseUrls = {
    viewUser: '@Url.Action("ViewUser", "Admin")',
    viewCoworking: '@Url.Action("ViewCoworking", "Admin")',
    contractDetails: '@Url.Action("ContractDetails", "Client")',
    editLocation: '@Url.Action("EditLocation", "Admin")',
    payments: '@Url.Action("Payments", "Admin")',
    reservationDetail: '@Url.Action("ReservationFinancialDetail", "Admin")',
    getPendingCardPriceRequests: '@Url.Action("GetPendingCardPriceRequests", "Admin")',
    getCardPriceRequestDetail: '@Url.Action("GetCardPriceRequestDetail", "Admin")',
    approveCardPriceChange: '@Url.Action("ApproveCardPriceChange", "Admin")',
    rejectCardPriceChange: '@Url.Action("RejectCardPriceChange", "Admin")'
};

// --- Preços no Cartão: modal lista + modal detalhe ---
function openCardPricePendingModal() {
    const modal = new bootstrap.Modal(document.getElementById('cardPricePendingListModal'));
    document.getElementById('cardPricePendingListModalBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-warning" role="status"></div></div>';
    modal.show();
    loadCardPricePendingList();
}

async function loadCardPricePendingList() {
    const body = document.getElementById('cardPricePendingListModalBody');
    try {
        const res = await fetch(baseUrls.getPendingCardPriceRequests);
        const result = await res.json();
        if (!result.success) {
            body.innerHTML = '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> ' + (result.message || 'Erro ao carregar.') + '</div>';
            return;
        }
        const data = result.data || [];
        if (data.length === 0) {
            body.innerHTML = '<div class="alert alert-info"><i class="bi bi-info-circle"></i> Nenhuma solicitação pendente.</div>';
            return;
        }
        let html = '<div class="table-responsive"><table class="table table-hover table-sm"><thead class="table-light"><tr><th>Coworking</th><th>Endereço</th><th>Valores solicitados</th><th>Data</th><th class="text-end">Ações</th></tr></thead><tbody>';
        data.forEach(function(item) {
            const req = [];
            if (item.requestedCardPrice1x != null) req.push('1x: R$ ' + parseFloat(item.requestedCardPrice1x).toFixed(2).replace('.', ','));
            if (item.requestedCardPriceMonthly != null) req.push('Mensal: R$ ' + parseFloat(item.requestedCardPriceMonthly).toFixed(2).replace('.', ','));
            if (item.requestedCardPrice12x != null) req.push('12x: R$ ' + parseFloat(item.requestedCardPrice12x).toFixed(2).replace('.', ','));
            const reqText = req.length ? req.join(' · ') : '—';
            html += '<tr class="card-price-row align-middle" data-request-id="' + item.id + '" style="cursor: pointer;">';
            html += '<td>' + (item.coworkingName || '—') + '</td>';
            html += '<td>' + (item.addressLabel || '—') + '</td>';
            html += '<td><small>' + reqText + '</small></td>';
            html += '<td><small>' + (item.createdAt || '—') + '</small></td>';
            html += '<td class="text-end"><button type="button" class="btn btn-sm btn-success btn-approve-card-price" data-request-id="' + item.id + '" onclick="event.stopPropagation(); approveCardPriceFromList(' + item.id + ')"><i class="bi bi-check-circle"></i> Aprovar</button></td></tr>';
        });
        html += '</tbody></table></div><p class="text-muted small mb-0"><i class="bi bi-hand-index"></i> Clique na linha para ver os detalhes que o parceiro preencheu.</p>';
        body.innerHTML = html;
        document.querySelectorAll('.card-price-row').forEach(function(row) {
            row.addEventListener('click', function(e) { if (!e.target.closest('.btn-approve-card-price')) openCardPriceDetailModal(parseInt(this.getAttribute('data-request-id'), 10)); });
        });
    } catch (err) {
        body.innerHTML = '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Erro ao carregar: ' + err.message + '</div>';
    }
}

let currentCardPriceDetailRequestId = null;

function openCardPriceDetailModal(requestId) {
    currentCardPriceDetailRequestId = requestId;
    const modal = new bootstrap.Modal(document.getElementById('cardPriceDetailModal'));
    document.getElementById('cardPriceDetailModalBody').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
    document.getElementById('cardPriceDetailModalLabel').textContent = 'Detalhes da solicitação';
    modal.show();
    loadCardPriceDetail(requestId);
}

async function loadCardPriceDetail(requestId) {
    const body = document.getElementById('cardPriceDetailModalBody');
    try {
        const res = await fetch(baseUrls.getCardPriceRequestDetail + '?id=' + requestId);
        const result = await res.json();
        if (!result.success) {
            body.innerHTML = '<div class="alert alert-danger">' + (result.message || 'Erro ao carregar.') + '</div>';
            return;
        }
        const d = result.data;
        const req = [], prev = [];
        if (d.requestedCardPrice1x != null) req.push('1x: R$ ' + parseFloat(d.requestedCardPrice1x).toFixed(2).replace('.', ','));
        if (d.requestedCardPriceMonthly != null) req.push('Mensal: R$ ' + parseFloat(d.requestedCardPriceMonthly).toFixed(2).replace('.', ','));
        if (d.requestedCardPrice12x != null) req.push('12x: R$ ' + parseFloat(d.requestedCardPrice12x).toFixed(2).replace('.', ','));
        if (d.previousCardPrice1x != null) prev.push('1x: R$ ' + parseFloat(d.previousCardPrice1x).toFixed(2).replace('.', ','));
        if (d.previousCardPriceMonthly != null) prev.push('Mensal: R$ ' + parseFloat(d.previousCardPriceMonthly).toFixed(2).replace('.', ','));
        if (d.previousCardPrice12x != null) prev.push('12x: R$ ' + parseFloat(d.previousCardPrice12x).toFixed(2).replace('.', ','));
        let html = '<div class="mb-3"><strong>Coworking</strong><br>' + (d.coworkingName || '—') + '</div>';
        html += '<div class="mb-3"><strong>Endereço</strong><br>' + (d.addressLabel || '—') + '</div>';
        html += '<div class="mb-3"><strong>Valores atuais (antes da solicitação)</strong><br><span class="text-muted">' + (prev.length ? prev.join(' · ') : 'Nenhum') + '</span></div>';
        html += '<div class="mb-3"><strong>Valores solicitados pelo parceiro</strong><br><span class="badge bg-info">' + (req.length ? req.join(' ') : '—') + '</span></div>';
        html += '<div><strong>Data da solicitação</strong><br>' + (d.createdAt || '—') + '</div>';
        body.innerHTML = html;
    } catch (err) {
        body.innerHTML = '<div class="alert alert-danger">Erro: ' + err.message + '</div>';
    }
}

document.getElementById('cardPriceDetailApproveBtn')?.addEventListener('click', function() {
    if (currentCardPriceDetailRequestId == null) return;
    approveCardPriceFromList(currentCardPriceDetailRequestId);
});

document.getElementById('cardPriceDetailRejectBtn')?.addEventListener('click', function() {
    if (currentCardPriceDetailRequestId == null) return;
    document.getElementById('rejectCardPriceRequestIdAjax').value = currentCardPriceDetailRequestId;
    document.getElementById('rejectCardPriceReasonAjax').value = '';
    bootstrap.Modal.getInstance(document.getElementById('cardPriceDetailModal'))?.hide();
    new bootstrap.Modal(document.getElementById('cardPriceRejectReasonModal')).show();
});

document.getElementById('formRejectCardPriceAjax')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const requestId = document.getElementById('rejectCardPriceRequestIdAjax').value;
    const reason = document.getElementById('rejectCardPriceReasonAjax').value;
    const token = document.querySelector('#cardPriceAntiforgeryForm input[name="__RequestVerificationToken"]')?.value;
    const formData = new FormData();
    formData.append('requestId', requestId);
    formData.append('rejectionReason', reason);
    formData.append('__RequestVerificationToken', token);
    try {
        const res = await fetch(baseUrls.rejectCardPriceChange, { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const result = await res.json();
        bootstrap.Modal.getInstance(document.getElementById('cardPriceRejectReasonModal'))?.hide();
        if (result.success) {
            loadCardPricePendingList();
            if (document.getElementById('cardPricePendingListModal').classList.contains('show')) { /* lista já visível */ }
        }
        alert(result.success ? result.message : result.message);
    } catch (err) {
        alert('Erro: ' + err.message);
    }
});

async function approveCardPriceFromList(requestId) {
    const token = document.querySelector('#cardPriceAntiforgeryForm input[name="__RequestVerificationToken"]')?.value;
    const formData = new FormData();
    formData.append('requestId', requestId);
    formData.append('__RequestVerificationToken', token);
    try {
        const res = await fetch(baseUrls.approveCardPriceChange, { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const result = await res.json();
        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('cardPriceDetailModal'))?.hide();
            loadCardPricePendingList();
            if (!result.message) result.message = 'Aprovado.';
            alert(result.message);
        } else {
            alert(result.message || 'Erro ao aprovar.');
        }
    } catch (err) {
        alert('Erro: ' + err.message);
    }
}

// Paginação de Pagamentos Recentes
let currentPaymentPage = 1;
const paymentsPerPage = 5;

function changePaymentPage(page) {
    const rows = document.querySelectorAll('.payment-row');
    const totalRows = rows.length;
    const totalPages = Math.ceil(totalRows / paymentsPerPage);
    
    if (page === 'prev') {
        if (currentPaymentPage > 1) currentPaymentPage--;
    } else if (page === 'next') {
        if (currentPaymentPage < totalPages) currentPaymentPage++;
    } else {
        currentPaymentPage = parseInt(page);
    }
    
    // Esconder todas as linhas
    rows.forEach(row => row.style.display = 'none');
    
    // Mostrar apenas as linhas da página atual
    const startIndex = (currentPaymentPage - 1) * paymentsPerPage;
    const endIndex = startIndex + paymentsPerPage;
    
    for (let i = startIndex; i < endIndex && i < totalRows; i++) {
        rows[i].style.display = '';
    }
    
    // Atualizar estado dos botões de paginação
    const pagination = document.getElementById('recentPaymentsPagination');
    if (pagination) {
        const pageItems = pagination.querySelectorAll('li[data-page]');
        pageItems.forEach(item => {
            const itemPage = parseInt(item.getAttribute('data-page'));
            item.classList.toggle('active', itemPage === currentPaymentPage);
        });
        
        // Atualizar botões anterior/próximo
        const prevBtn = document.getElementById('prevPaymentPageBtn');
        const nextBtn = document.getElementById('nextPaymentPageBtn');
        
        if (prevBtn) {
            prevBtn.classList.toggle('disabled', currentPaymentPage === 1);
        }
        if (nextBtn) {
            nextBtn.classList.toggle('disabled', currentPaymentPage === totalPages);
        }
    }
    
    // Atualizar info da página
    const pageInfo = document.getElementById('paymentPageInfo');
    if (pageInfo) {
        pageInfo.textContent = `Página ${currentPaymentPage} de ${totalPages}`;
    }
}

// Função para exibir listas do dashboard
async function showDashboardList(type, filter = null) {
    const modal = new bootstrap.Modal(document.getElementById('dashboardListModal'));
    const modalTitle = document.getElementById('dashboardListModalTitle');
    const modalBody = document.getElementById('dashboardListModalBody');
    
    // Definir título do modal
    const titles = {
        'users': filter === 'inactive' ? 'Usuários Inativos' : filter === 'unverified' ? 'Usuários Não Verificados' : 'Todos os Usuários',
        'coworkings': 'Todos os Coworkings',
        'contracts': filter === 'Active' ? 'Contratos Ativos' : 'Todos os Contratos',
        'locations': 'Todas as Localidades',
        'payments': filter === 'Pending' ? 'Pagamentos Pendentes' : 'Todos os Pagamentos',
        'reservations': 'Todas as Reservas'
    };
    
    modalTitle.innerHTML = `<i class="bi bi-list-ul"></i> ${titles[type] || 'Lista'}`;
    modalBody.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Carregando...</span></div></div>';
    modal.show();
    
    try {
        const page = (type === 'users') ? 1 : undefined;
        const pageSize = (type === 'users') ? 10 : undefined;
        let url = `@Url.Action("GetDashboardList", "Admin")?type=${type}${filter ? '&filter=' + encodeURIComponent(filter) : ''}`;
        if (page != null) url += `&page=${page}`;
        if (pageSize != null) url += `&pageSize=${pageSize}`;
        const response = await fetch(url);
        const result = await response.json();
        
        if (!result.success) {
            modalBody.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> ${result.message}</div>`;
            return;
        }
        
        modalBody.innerHTML = buildDashboardListHtml(type, filter, result);
    } catch (error) {
        modalBody.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Erro ao carregar dados: ${error.message}</div>`;
    }
}

// Carrega apenas o conteúdo do modal (para paginação) sem reabrir o modal
async function loadDashboardListContent(type, filter, page) {
    const modalBody = document.getElementById('dashboardListModalBody');
    modalBody.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Carregando...</span></div></div>';
    try {
        const pageSize = (type === 'users') ? 10 : undefined;
        let url = `@Url.Action("GetDashboardList", "Admin")?type=${type}${filter ? '&filter=' + encodeURIComponent(filter) : ''}&page=${page}`;
        if (pageSize != null) url += `&pageSize=${pageSize}`;
        const response = await fetch(url);
        const result = await response.json();
        if (!result.success) {
            modalBody.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> ${result.message}</div>`;
            return;
        }
        modalBody.innerHTML = buildDashboardListHtml(type, filter, result);
    } catch (error) {
        modalBody.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Erro ao carregar dados: ${error.message}</div>`;
    }
}

function buildDashboardListHtml(type, filter, result) {
    let html = '';
    if (result.data && result.data.length > 0) {
        html = '<div class="table-responsive"><table class="table table-hover"><thead class="table-light"><tr>';
        
            // Cabeçalhos dinâmicos baseados no tipo
            if (type === 'users') {
                html += '<th>Nome</th><th>Email</th><th>Status</th><th>Verificado</th><th>Ações</th>';
            } else if (type === 'coworkings') {
                html += '<th>Nome</th><th>CNPJ</th><th>Status</th><th>Aprovação</th><th>Ações</th>';
            } else if (type === 'contracts') {
                html += '<th>Número</th><th>Cliente</th><th>Localidade</th><th>Status</th><th>Ações</th>';
            } else if (type === 'locations') {
                html += '<th>Cidade</th><th>Estado</th><th>Região</th><th>Status</th><th>Ações</th>';
            } else if (type === 'payments') {
                html += '<th>ID</th><th>Cliente</th><th>Valor</th><th>Status</th><th>Data</th><th>Ações</th>';
            } else if (type === 'reservations') {
                html += '<th>ID</th><th>Cliente</th><th>Coworking</th><th>Data</th><th>Status</th><th>Ações</th>';
            }
            
            html += '</tr></thead><tbody>';
            
            result.data.forEach(item => {
                html += '<tr>';
                if (type === 'users') {
                    html += `<td>${item.fullName || 'N/A'}</td>`;
                    html += `<td>${item.email || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.isActive ? 'success' : 'danger'}">${item.isActive ? 'Ativo' : 'Inativo'}</span></td>`;
                    html += `<td><span class="badge bg-${item.emailVerified ? 'success' : 'warning'}">${item.emailVerified ? 'Sim' : 'Não'}</span></td>`;
                    html += `<td><a href="${baseUrls.viewUser}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'coworkings') {
                    html += `<td>${item.name || 'N/A'}</td>`;
                    html += `<td>${item.cnpj || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.isActive ? 'success' : 'danger'}">${item.isActive ? 'Ativo' : 'Inativo'}</span></td>`;
                    html += `<td><span class="badge bg-${item.approvalStatus === 'Approved' ? 'success' : item.approvalStatus === 'UnderReview' ? 'warning' : 'danger'}">${item.approvalStatusDisplay || item.approvalStatus}</span></td>`;
                    html += `<td><a href="${baseUrls.viewCoworking}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'contracts') {
                    html += `<td>${item.contractNumber || 'N/A'}</td>`;
                    html += `<td>${item.clientName || 'N/A'}</td>`;
                    html += `<td>${item.location || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.status === 'Active' ? 'success' : item.status === 'PendingPayment' ? 'warning' : 'secondary'}">${item.statusDisplay || item.status}</span></td>`;
                    html += `<td><a href="${baseUrls.contractDetails}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'locations') {
                    html += `<td>${item.city || 'N/A'}</td>`;
                    html += `<td>${item.state || 'N/A'}</td>`;
                    html += `<td>${item.region || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.isActive ? 'success' : 'danger'}">${item.isActive ? 'Ativa' : 'Inativa'}</span></td>`;
                    html += `<td><a href="${baseUrls.editLocation}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Editar</a></td>`;
                } else if (type === 'payments') {
                    html += `<td>#${item.id || 'N/A'}</td>`;
                    html += `<td>${item.clientName || 'N/A'}</td>`;
                    html += `<td>R$ ${(item.amount || 0).toFixed(2).replace('.', ',')}</td>`;
                    html += `<td><span class="badge bg-${item.status === 'Paid' ? 'success' : item.status === 'Pending' ? 'warning' : 'secondary'}">${item.statusDisplay || item.status}</span></td>`;
                    html += `<td>${item.createdAt || 'N/A'}</td>`;
                    html += `<td><a href="${baseUrls.payments}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'reservations') {
                    html += `<td>#${item.id || 'N/A'}</td>`;
                    html += `<td>${item.clientName || 'N/A'}</td>`;
                    html += `<td>${item.coworkingName || 'N/A'}</td>`;
                    html += `<td>${item.reservationDate || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.status === 'Confirmed' ? 'success' : item.status === 'Pending' ? 'warning' : 'secondary'}">${item.statusDisplay || item.status}</span></td>`;
                    html += `<td><a href="${baseUrls.reservationDetail}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                }
                html += '</tr>';
            });
            
            html += '</tbody></table></div>';
            // Paginação para usuários (10 por página)
            if (type === 'users' && result.totalCount != null && result.pageSize != null) {
                const totalCount = result.totalCount;
                const currentPage = result.page || 1;
                const pageSize = result.pageSize;
                const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
                const from = (currentPage - 1) * pageSize + 1;
                const to = Math.min(currentPage * pageSize, totalCount);
                html += '<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">';
                html += `<span class="text-muted small">Mostrando ${from}-${to} de ${totalCount}</span>`;
                html += '<nav><ul class="pagination pagination-sm mb-0">';
                const filterArg = (filter && filter !== 'null') ? `'${String(filter).replace(/'/g, "\\'")}'` : 'null';
                html += `<li class="page-item ${currentPage <= 1 ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadDashboardListContent('users', ${filterArg}, ${currentPage - 1}); return false;"><i class="bi bi-chevron-left"></i> Anterior</a></li>`;
                const maxVisible = 5;
                let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
                let endPage = Math.min(totalPages, startPage + maxVisible - 1);
                if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);
                for (let p = startPage; p <= endPage; p++) {
                    html += `<li class="page-item ${p === currentPage ? 'active' : ''}"><a class="page-link" href="#" onclick="loadDashboardListContent('users', ${filterArg}, ${p}); return false;">${p}</a></li>`;
                }
                html += `<li class="page-item ${currentPage >= totalPages ? 'disabled' : ''}"><a class="page-link" href="#" onclick="loadDashboardListContent('users', ${filterArg}, ${currentPage + 1}); return false;">Próximo <i class="bi bi-chevron-right"></i></a></li>`;
                html += '</ul></nav>';
                html += `<a href="${result.viewAllUrl || '#'}" class="btn btn-primary btn-sm">Ver Todos</a>`;
                html += '</div>';
            } else {
                html += `<div class="mt-3 text-end"><a href="${result.viewAllUrl || '#'}" class="btn btn-primary">Ver Todos</a></div>`;
            }
        } else {
            html = '<div class="alert alert-info"><i class="bi bi-info-circle"></i> Nenhum item encontrado.</div>';
        }
        return html;
}
</script>


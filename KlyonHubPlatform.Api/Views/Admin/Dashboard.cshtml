@using KlyonHubPlatform.Domain.Core.Enums
@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@{
    ViewData["Title"] = "Dashboard Administrativo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Verificar se os menus de coworking estão habilitados
    var enableCoworkingMenus = await SystemConfigurationService.GetValueAsync("Features.EnableCoworkingMenus");
    var showCoworkingMenus = enableCoworkingMenus?.ToLower() == "true";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-speedometer2"></i> Dashboard Administrativo</h2>
    <small class="text-muted">Última atualização: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
</div>

@{
    var pendingMigrationsCount = ViewBag.PendingMigrationsCount as int? ?? 0;
    var pendingMigrations = ViewBag.PendingMigrations as List<string> ?? new List<string>();
}

@if (pendingMigrationsCount > 0)
{
    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
        <div class="flex-grow-1">
            <h5 class="alert-heading mb-2">
                <i class="bi bi-exclamation-triangle-fill"></i> 
                <strong>@pendingMigrationsCount Migration(s) Pendente(s)</strong>
            </h5>
            <p class="mb-2">
                Há @pendingMigrationsCount alteração(ões) de estrutura de banco de dados aguardando execução.
            </p>
            @if (pendingMigrations.Any())
            {
                <details class="mb-2">
                    <summary class="text-dark fw-bold">Ver migrations pendentes</summary>
                    <ul class="mb-0 mt-2">
                        @foreach (var migration in pendingMigrations)
                        {
                            <li><code>@migration</code></li>
                        }
                    </ul>
                </details>
            }
            <div class="mt-3">
                <a href="@Url.Action("DatabaseManager", "Admin")" class="btn btn-warning btn-lg">
                    <i class="bi bi-database"></i> Executar Migrations Agora
                </a>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPIs Principais -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1"><i class="bi bi-people"></i> Total de Usuários</h6>
                        <h2 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('users')" title="Clique para ver todos os usuários">@ViewBag.TotalUsers</h2>
                        <small class="text-white-50">
                            <span class="clickable-number" style="cursor: pointer;" onclick="showDashboardList('users', 'inactive')" title="Clique para ver usuários inativos">@ViewBag.InactiveUsers inativos</span> | 
                            <span class="clickable-number" style="cursor: pointer;" onclick="showDashboardList('users', 'unverified')" title="Clique para ver usuários não verificados">@ViewBag.UnverifiedUsers não verificados</span>
                        </small>
                    </div>
                    <div class="display-1 opacity-25">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1"><i class="bi bi-building"></i> Coworkings</h6>
                        <h2 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('coworkings')" title="Clique para ver todos os coworkings">@ViewBag.TotalCoworkings</h2>
                        <small class="text-white-50">Parceiros cadastrados</small>
                    </div>
                    <div class="display-1 opacity-25">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title mb-1"><i class="bi bi-file-earmark-text"></i> Contratos de Endereço Fiscal Ativos</h6>
                        <h2 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('contracts', 'Active')" title="Clique para ver todos os contratos ativos">@ViewBag.ActiveContracts</h2>
                        <small class="text-white-50">Em andamento</small>
                    </div>
                    <div class="display-1 opacity-25">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
            <div class="card-body">
                <h6 class="card-title mb-3"><i class="bi bi-cash-coin"></i> Receitas</h6>
                <div class="mb-2">
                    <small class="text-white-50 d-block">Receita Bruta</small>
                    <h5 class="mb-0">R$ @(((decimal)ViewBag.GrossRevenue).ToString("N2"))</h5>
                </div>
                <div class="mb-2">
                    <small class="text-white-50 d-block">Receita Parceiro</small>
                    <h5 class="mb-0">R$ @(((decimal)ViewBag.PartnerRevenue).ToString("N2"))</h5>
                </div>
                <div>
                    <small class="text-white-50 d-block">Receita Líquida</small>
                    <h4 class="mb-0">R$ @(((decimal)ViewBag.NetRevenue).ToString("N2"))</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPIs Secundários -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-primary">
            <div class="card-body">
                <h6 class="card-title text-primary"><i class="bi bi-geo-alt"></i> Localidades</h6>
                <h3 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('locations')" title="Clique para ver todas as localidades">@ViewBag.TotalLocations</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-warning">
            <div class="card-body">
                <h6 class="card-title text-warning"><i class="bi bi-hourglass-split"></i> Pagamentos Pendentes</h6>
                <h3 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('payments', 'Pending')" title="Clique para ver todos os pagamentos pendentes">R$ @(((decimal)ViewBag.PendingPayments).ToString("N2"))</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-info">
            <div class="card-body">
                <h6 class="card-title text-info"><i class="bi bi-percent"></i> Comissões Pendentes</h6>
                <h3 class="mb-0">R$ @(((decimal)ViewBag.TotalCommissions).ToString("N2"))</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-success">
            <div class="card-body">
                <h6 class="card-title text-success"><i class="bi bi-check-circle"></i> Comissões Concluídas</h6>
                <h3 class="mb-0">R$ @(((decimal)ViewBag.CompletedCommissions).ToString("N2"))</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-primary">
            <div class="card-body">
                <h6 class="card-title text-primary"><i class="bi bi-cash-stack"></i> Receita Bruta</h6>
                <h3 class="mb-0">R$ @(((decimal)ViewBag.GrossRevenue).ToString("N2"))</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-secondary">
            <div class="card-body">
                <h6 class="card-title text-secondary"><i class="bi bi-handshake"></i> Receita Parceiro</h6>
                <h3 class="mb-0">R$ @(((decimal)ViewBag.PartnerRevenue).ToString("N2"))</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card border-danger">
            <div class="card-body">
                <h6 class="card-title text-danger"><i class="bi bi-exclamation-triangle"></i> Usuários Inativos</h6>
                <h3 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('users', 'inactive')" title="Clique para ver todos os usuários inativos">@ViewBag.InactiveUsers</h3>
            </div>
        </div>
    </div>
    @if (showCoworkingMenus)
    {
        <div class="col-md-3 mb-3">
            <div class="card border-info">
                <div class="card-body">
                    <h6 class="card-title text-info"><i class="bi bi-calendar-check"></i> Total de Reservas</h6>
                    <h3 class="mb-0 clickable-number" style="cursor: pointer;" onclick="showDashboardList('reservations')" title="Clique para ver todas as reservas">@(ViewBag.TotalReservations ?? 0)</h3>
                </div>
            </div>
        </div>
    }
    @{
        var partnersWithoutPercentage = ViewBag.PartnersWithoutPercentage as int? ?? 0;
        var servicesAwaitingPercentage = ViewBag.ServicesAwaitingPercentage as int? ?? 0;
        var pendingRemovalRequests = ViewBag.PendingRemovalRequests as int? ?? 0;
    }
    @if (partnersWithoutPercentage > 0 || servicesAwaitingPercentage > 0)
    {
        <div class="col-md-3 mb-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i> Percentagens Pendentes
                    </h6>
                    <h3 class="mb-2">@servicesAwaitingPercentage</h3>
                    <small class="text-muted">@partnersWithoutPercentage parceiro(s) aguardando</small>
                    <div class="mt-3">
                        <a href="@Url.Action("Coworkings", "Admin")" class="btn btn-warning btn-sm w-100">
                            <i class="bi bi-percent"></i> Definir Percentagens
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (pendingRemovalRequests > 0)
    {
        <div class="col-md-3 mb-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i> Solicitações de Remoção
                    </h6>
                    <h3 class="mb-2">@pendingRemovalRequests</h3>
                    <small class="text-muted">Aguardando aprovação</small>
                    <div class="mt-3">
                        <a href="@Url.Action("ServiceRemovalRequests", "Admin")" class="btn btn-danger btn-sm w-100">
                            <i class="bi bi-list-check"></i> Ver Solicitações
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Gráficos -->
<div class="row mb-4">
    <div class="col-md-8 mb-3">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-graph-up"></i> Receita Mensal (Últimos 6 Meses)</h5>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-pie-chart"></i> Usuários por Perfil</h5>
            </div>
            <div class="card-body">
                <canvas id="usersByRoleChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-bar-chart"></i> Contratos de Endereço Fiscal por Status</h5>
            </div>
            <div class="card-body">
                <canvas id="contractsByStatusChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-trophy"></i> Top 5 Localidades por Receita</h5>
            </div>
            <div class="card-body">
                <canvas id="topLocationsChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos de Produtos e Reservas -->
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-box-seam"></i> Produtos Oferecidos pelos Coworkings</h5>
            </div>
            <div class="card-body">
                <canvas id="productsChart"></canvas>
            </div>
        </div>
    </div>
    @if (showCoworkingMenus)
    {
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-calendar-check"></i> Reservas por Status</h5>
                </div>
                <div class="card-body">
                    <canvas id="reservationsByStatusChart"></canvas>
                </div>
            </div>
        </div>
    }
</div>

<!-- Tabelas -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-clock-history"></i> Pagamentos Recentes (Últimos 30 dias)</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.RecentPayments != null && ((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Cliente</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in (List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments)
                                {
                                    <tr>
                                        <td>@(payment.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>@(payment.Subscription?.Contract?.Client?.RazaoSocial ?? payment.Subscription?.Contract?.Client?.ContactName ?? "N/A")</td>
                                        <td>R$ @(payment.Amount.ToString("N2"))</td>
                                        <td>
                                            @switch (payment.Status)
                                            {
                                                case PaymentStatus.Pending:
                                                    <span class="badge bg-warning">Pendente</span>
                                                    break;
                                                case PaymentStatus.Processing:
                                                    <span class="badge bg-info">Processando</span>
                                                    break;
                                                case PaymentStatus.AwaitingValidation:
                                                    <span class="badge bg-info"><i class="bi bi-clock-history"></i> Aguardando Validação</span>
                                                    break;
                                                case PaymentStatus.Paid:
                                                    <span class="badge bg-success">Pago</span>
                                                    break;
                                                case PaymentStatus.Failed:
                                                    <span class="badge bg-danger">Falhou</span>
                                                    break;
                                                case PaymentStatus.Refunded:
                                                    <span class="badge bg-secondary">Reembolsado</span>
                                                    break;
                                                case PaymentStatus.Cancelled:
                                                    <span class="badge bg-dark">Cancelado</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@payment.Status</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhum pagamento nos últimos 30 dias.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Ações Rápidas -->
<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-lightning"></i> Ações Rápidas</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-outline-primary w-100">
                            <i class="bi bi-people"></i><br>Usuários
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("Coworkings", "Admin")" class="btn btn-outline-primary w-100">
                            <i class="bi bi-building"></i><br>Coworkings
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("Contracts", "Admin")" class="btn btn-outline-primary w-100">
                            <i class="bi bi-file-earmark-text"></i><br>Contratos de<br>Endereço Fiscal
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("Locations", "Admin")" class="btn btn-outline-primary w-100">
                            <i class="bi bi-geo-alt"></i><br>Localidades
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("Reports", "Admin")" class="btn btn-outline-primary w-100">
                            <i class="bi bi-graph-up"></i><br>Relatórios
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("CreateLocation", "Admin")" class="btn btn-outline-success w-100">
                            <i class="bi bi-plus-circle"></i><br>Nova Localidade
                        </a>
                    </div>
                    <div class="col-md-2 mb-2">
                        <a href="@Url.Action("DatabaseManager", "Admin")" class="btn btn-outline-warning w-100 position-relative">
                            <i class="bi bi-database"></i><br>Banco de Dados
                            @if (pendingMigrationsCount > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @pendingMigrationsCount
                                    <span class="visually-hidden">migrations pendentes</span>
                                </span>
                            }
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Gráfico de Receita Mensal
const revenueCtx = document.getElementById('revenueChart').getContext('2d');
const monthlyRevenue = @Html.Raw(Json.Serialize(ViewBag.MonthlyRevenue));
const monthNames = ['Jan', 'Fev', 'Mar', 'Abr', 'Mai', 'Jun', 'Jul', 'Ago', 'Set', 'Out', 'Nov', 'Dez'];

const revenueLabels = monthlyRevenue.map(r => `${monthNames[r.month - 1]}/${r.year}`);
const revenueData = monthlyRevenue.map(r => parseFloat(r.revenue));

new Chart(revenueCtx, {
    type: 'line',
    data: {
        labels: revenueLabels,
        datasets: [{
            label: 'Receita (R$)',
            data: revenueData,
            borderColor: 'rgb(75, 192, 192)',
            backgroundColor: 'rgba(75, 192, 192, 0.2)',
            tension: 0.4,
            fill: true
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
            legend: { display: true },
            tooltip: {
                callbacks: {
                    label: function(context) {
                        return 'R$ ' + context.parsed.y.toLocaleString('pt-BR', {minimumFractionDigits: 2});
                    }
                }
            }
        },
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    callback: function(value) {
                        return 'R$ ' + value.toLocaleString('pt-BR');
                    }
                }
            }
        },
        onClick: (evt, items) => {
            if (items && items.length && monthlyRevenue[items[0].index]) {
                const r = monthlyRevenue[items[0].index];
                const lastDay = new Date(r.year, r.month, 0).getDate();
                const start = r.year + '-' + String(r.month).padStart(2,'0') + '-01';
                const end = r.year + '-' + String(r.month).padStart(2,'0') + '-' + String(lastDay).padStart(2,'0');
                window.location = '/Admin/Reports?startDate=' + start + '&endDate=' + end;
            }
        }
    }
});

// Gráfico de Usuários por Perfil
const usersByRoleCtx = document.getElementById('usersByRoleChart').getContext('2d');
const usersByRole = @Html.Raw(Json.Serialize(ViewBag.UsersByRole));

const roleLabels = usersByRole.map(r => r.role);
const roleData = usersByRole.map(r => r.count);
const roleColors = ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40'];

new Chart(usersByRoleCtx, {
    type: 'doughnut',
    data: {
        labels: roleLabels,
        datasets: [{
            data: roleData,
            backgroundColor: roleColors.slice(0, roleData.length)
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
            legend: {
                position: 'bottom'
            }
        }
    }
});

// Gráfico de Contratos por Status (labels em português; clique navega para Contracts filtrado por status)
const contractsByStatusCtx = document.getElementById('contractsByStatusChart').getContext('2d');
const contractsByStatus = @Html.Raw(Json.Serialize(ViewBag.ContractsByStatus));

const contractStatusMap = { 'Active': 'Ativo', 'PendingPayment': 'Pendente de Pagamento', 'Suspended': 'Suspenso', 'Cancelled': 'Cancelado' };
const statusLabels = contractsByStatus.map(s => contractStatusMap[s.status] || s.status);
const statusData = contractsByStatus.map(s => s.count);

new Chart(contractsByStatusCtx, {
    type: 'bar',
    data: {
        labels: statusLabels,
        datasets: [{
            label: 'Quantidade',
            data: statusData,
            backgroundColor: [
                'rgba(54, 162, 235, 0.6)',
                'rgba(255, 99, 132, 0.6)',
                'rgba(255, 206, 86, 0.6)',
                'rgba(75, 192, 192, 0.6)'
            ],
            borderColor: [
                'rgba(54, 162, 235, 1)',
                'rgba(255, 99, 132, 1)',
                'rgba(255, 206, 86, 1)',
                'rgba(75, 192, 192, 1)'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: true,
        scales: {
            y: {
                beginAtZero: true,
                ticks: { stepSize: 1 }
            }
        },
        onClick: (evt, items) => {
            if (items && items.length) {
                const idx = items[0].index;
                const status = contractsByStatus[idx]?.status;
                if (status) window.location = '/Admin/Contracts?status=' + encodeURIComponent(status);
            }
        }
    }
});

// Gráfico Top Localidades (clique navega para Relatórios)
const topLocationsCtx = document.getElementById('topLocationsChart').getContext('2d');
const topLocations = @Html.Raw(Json.Serialize(ViewBag.TopLocations));

const locationLabels = topLocations.map(l => l.city);
const locationData = topLocations.map(l => parseFloat(l.revenue));

new Chart(topLocationsCtx, {
    type: 'bar',
    data: {
        labels: locationLabels,
        datasets: [{
            label: 'Receita (R$)',
            data: locationData,
            backgroundColor: 'rgba(153, 102, 255, 0.6)',
            borderColor: 'rgba(153, 102, 255, 1)',
            borderWidth: 1
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
            legend: { display: false },
            tooltip: {
                callbacks: {
                    label: function(context) {
                        return 'R$ ' + context.parsed.x.toLocaleString('pt-BR', {minimumFractionDigits: 2});
                    }
                }
            }
        },
        scales: {
            x: {
                beginAtZero: true,
                ticks: {
                    callback: function(value) {
                        return 'R$ ' + value.toLocaleString('pt-BR');
                    }
                }
            }
        },
        onClick: (evt, items) => {
            if (items && items.length) {
                const idx = items[0].index;
                const loc = topLocations[idx];
                if (loc?.city) window.location = '/Admin/Reports?product=Todos';
            }
        }
    }
});

// Gráfico de Produtos Oferecidos
const productsCtx = document.getElementById('productsChart');
const productsByType = @Html.Raw(Json.Serialize(ViewBag.ProductsByType ?? new List<dynamic>()));

if (productsByType && productsByType.length > 0) {
    const productLabels = productsByType.map(p => {
        const productType = p.productType;
        switch(productType) {
            case "FiscalAddress": return "Endereço Fiscal";
            case "RoomRental": return "Aluguéis de Sala";
            case "DigitalCertificate": return "Certificado Digital";
            default: return productType;
        }
    });
    const productData = productsByType.map(p => p.count || 0);

    new Chart(productsCtx, {
        type: 'doughnut',
        data: {
            labels: productLabels,
            datasets: [{
                data: productData,
                backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
} else {
    document.getElementById('productsChart').parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhum produto cadastrado ainda.</p>';
}

// Gráfico de Reservas por Status (apenas se EnableCoworkingMenus estiver habilitado)
@if (showCoworkingMenus)
{
    <text>
    const reservationsStatusCtx = document.getElementById('reservationsByStatusChart');
    const reservationsByStatus = @Html.Raw(Json.Serialize(ViewBag.ReservationsByStatus ?? new List<dynamic>()));

    if (reservationsStatusCtx && reservationsByStatus && reservationsByStatus.length > 0) {
        const resvStatusMap = { 'Confirmed': 'Confirmadas', 'Cancelled': 'Canceladas', 'Completed': 'Concluídas', 'Pending': 'Pendentes' };
        const statusLabels = reservationsByStatus.map(r => resvStatusMap[r.status] || r.status);
        const statusData = reservationsByStatus.map(r => r.count || 0);

        new Chart(reservationsStatusCtx, {
            type: 'bar',
            data: {
                labels: statusLabels,
                datasets: [{
                    label: 'Quantidade',
                    data: statusData,
                    backgroundColor: [
                        'rgba(255, 206, 86, 0.6)',
                        'rgba(54, 162, 235, 0.6)',
                        'rgba(75, 192, 192, 0.6)',
                        'rgba(255, 99, 132, 0.6)'
                    ],
                    borderColor: [
                        'rgba(255, 206, 86, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(75, 192, 192, 1)',
                        'rgba(255, 99, 132, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            stepSize: 1
                        }
                    }
                }
            }
        });
    } else if (reservationsStatusCtx) {
        document.getElementById('reservationsByStatusChart').parentElement.innerHTML = '<p class="text-muted text-center p-3">Nenhuma reserva cadastrada ainda.</p>';
    }
    </text>
}

// URLs base para ações (definidas uma vez)
const baseUrls = {
    viewUser: '@Url.Action("ViewUser", "Admin")',
    viewCoworking: '@Url.Action("ViewCoworking", "Admin")',
    contractDetails: '@Url.Action("ContractDetails", "Client")',
    editLocation: '@Url.Action("EditLocation", "Admin")',
    payments: '@Url.Action("Payments", "Admin")',
    reservationDetail: '@Url.Action("ReservationFinancialDetail", "Admin")'
};

// Função para exibir listas do dashboard
async function showDashboardList(type, filter = null) {
    const modal = new bootstrap.Modal(document.getElementById('dashboardListModal'));
    const modalTitle = document.getElementById('dashboardListModalTitle');
    const modalBody = document.getElementById('dashboardListModalBody');
    
    // Definir título do modal
    const titles = {
        'users': filter === 'inactive' ? 'Usuários Inativos' : filter === 'unverified' ? 'Usuários Não Verificados' : 'Todos os Usuários',
        'coworkings': 'Todos os Coworkings',
        'contracts': filter === 'Active' ? 'Contratos Ativos' : 'Todos os Contratos',
        'locations': 'Todas as Localidades',
        'payments': filter === 'Pending' ? 'Pagamentos Pendentes' : 'Todos os Pagamentos',
        'reservations': 'Todas as Reservas'
    };
    
    modalTitle.innerHTML = `<i class="bi bi-list-ul"></i> ${titles[type] || 'Lista'}`;
    modalBody.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Carregando...</span></div></div>';
    modal.show();
    
    try {
        const url = `@Url.Action("GetDashboardList", "Admin")?type=${type}${filter ? '&filter=' + filter : ''}`;
        const response = await fetch(url);
        const result = await response.json();
        
        if (!result.success) {
            modalBody.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> ${result.message}</div>`;
            return;
        }
        
        let html = '';
        if (result.data && result.data.length > 0) {
            html = '<div class="table-responsive"><table class="table table-hover"><thead class="table-light"><tr>';
            
            // Cabeçalhos dinâmicos baseados no tipo
            if (type === 'users') {
                html += '<th>Nome</th><th>Email</th><th>Status</th><th>Verificado</th><th>Ações</th>';
            } else if (type === 'coworkings') {
                html += '<th>Nome</th><th>CNPJ</th><th>Status</th><th>Aprovação</th><th>Ações</th>';
            } else if (type === 'contracts') {
                html += '<th>Número</th><th>Cliente</th><th>Localidade</th><th>Status</th><th>Ações</th>';
            } else if (type === 'locations') {
                html += '<th>Cidade</th><th>Estado</th><th>Região</th><th>Status</th><th>Ações</th>';
            } else if (type === 'payments') {
                html += '<th>ID</th><th>Cliente</th><th>Valor</th><th>Status</th><th>Data</th><th>Ações</th>';
            } else if (type === 'reservations') {
                html += '<th>ID</th><th>Cliente</th><th>Coworking</th><th>Data</th><th>Status</th><th>Ações</th>';
            }
            
            html += '</tr></thead><tbody>';
            
            result.data.forEach(item => {
                html += '<tr>';
                if (type === 'users') {
                    html += `<td>${item.fullName || 'N/A'}</td>`;
                    html += `<td>${item.email || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.isActive ? 'success' : 'danger'}">${item.isActive ? 'Ativo' : 'Inativo'}</span></td>`;
                    html += `<td><span class="badge bg-${item.emailVerified ? 'success' : 'warning'}">${item.emailVerified ? 'Sim' : 'Não'}</span></td>`;
                    html += `<td><a href="${baseUrls.viewUser}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'coworkings') {
                    html += `<td>${item.name || 'N/A'}</td>`;
                    html += `<td>${item.cnpj || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.isActive ? 'success' : 'danger'}">${item.isActive ? 'Ativo' : 'Inativo'}</span></td>`;
                    html += `<td><span class="badge bg-${item.approvalStatus === 'Approved' ? 'success' : item.approvalStatus === 'UnderReview' ? 'warning' : 'danger'}">${item.approvalStatusDisplay || item.approvalStatus}</span></td>`;
                    html += `<td><a href="${baseUrls.viewCoworking}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'contracts') {
                    html += `<td>${item.contractNumber || 'N/A'}</td>`;
                    html += `<td>${item.clientName || 'N/A'}</td>`;
                    html += `<td>${item.location || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.status === 'Active' ? 'success' : item.status === 'PendingPayment' ? 'warning' : 'secondary'}">${item.statusDisplay || item.status}</span></td>`;
                    html += `<td><a href="${baseUrls.contractDetails}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'locations') {
                    html += `<td>${item.city || 'N/A'}</td>`;
                    html += `<td>${item.state || 'N/A'}</td>`;
                    html += `<td>${item.region || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.isActive ? 'success' : 'danger'}">${item.isActive ? 'Ativa' : 'Inativa'}</span></td>`;
                    html += `<td><a href="${baseUrls.editLocation}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Editar</a></td>`;
                } else if (type === 'payments') {
                    html += `<td>#${item.id || 'N/A'}</td>`;
                    html += `<td>${item.clientName || 'N/A'}</td>`;
                    html += `<td>R$ ${(item.amount || 0).toFixed(2).replace('.', ',')}</td>`;
                    html += `<td><span class="badge bg-${item.status === 'Paid' ? 'success' : item.status === 'Pending' ? 'warning' : 'secondary'}">${item.statusDisplay || item.status}</span></td>`;
                    html += `<td>${item.createdAt || 'N/A'}</td>`;
                    html += `<td><a href="${baseUrls.payments}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                } else if (type === 'reservations') {
                    html += `<td>#${item.id || 'N/A'}</td>`;
                    html += `<td>${item.clientName || 'N/A'}</td>`;
                    html += `<td>${item.coworkingName || 'N/A'}</td>`;
                    html += `<td>${item.reservationDate || 'N/A'}</td>`;
                    html += `<td><span class="badge bg-${item.status === 'Confirmed' ? 'success' : item.status === 'Pending' ? 'warning' : 'secondary'}">${item.statusDisplay || item.status}</span></td>`;
                    html += `<td><a href="${baseUrls.reservationDetail}?id=${item.id}" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</a></td>`;
                }
                html += '</tr>';
            });
            
            html += '</tbody></table></div>';
            html += `<div class="mt-3 text-end"><a href="${result.viewAllUrl || '#'}" class="btn btn-primary">Ver Todos</a></div>`;
        } else {
            html = '<div class="alert alert-info"><i class="bi bi-info-circle"></i> Nenhum item encontrado.</div>';
        }
        
        modalBody.innerHTML = html;
    } catch (error) {
        modalBody.innerHTML = `<div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> Erro ao carregar dados: ${error.message}</div>`;
    }
}
</script>

<!-- Modal para exibir listas do dashboard -->
<div class="modal fade" id="dashboardListModal" tabindex="-1" aria-labelledby="dashboardListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dashboardListModalTitle">
                    <i class="bi bi-list-ul"></i> Lista
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="dashboardListModalBody">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<style>
.clickable-number {
    transition: transform 0.2s, opacity 0.2s;
}
.clickable-number:hover {
    transform: scale(1.1);
    opacity: 0.8;
}
</style>
</script>

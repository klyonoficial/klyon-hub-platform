</div>

<!-- Gráfico de Reservas (se habilitado) -->
@if (showCoworkingMenus)
{
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-calendar-check"></i> Reservas por Status</h5>
                </div>
                <div class="card-body">
                    <canvas id="reservationsByStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
}

<!-- Tabelas -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#recentPaymentsBody" aria-expanded="false" aria-controls="recentPaymentsBody">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Pagamentos Recentes (Últimos 30 dias) <i class="bi bi-chevron-down ms-2"></i></h5>
                @if (ViewBag.RecentPayments != null && ((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments).Any())
                {
                    <small class="text-muted">
                        Total: @(((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments).Count) pagamentos
                    </small>
                }
            </div>
            <div class="card-body collapse" id="recentPaymentsBody">
                @if (ViewBag.RecentPayments != null && ((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover" id="recentPaymentsTable">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Cliente</th>
                                    <th>Valor</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="recentPaymentsTableBody">
                                @{ 
                                    var paymentIndex = 0;
                                    var totalPayments = ((List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments).Count;
                                    var totalPages = (int)Math.Ceiling(totalPayments / 5.0);
                                }
                                @foreach (var payment in (List<KlyonHubPlatform.Domain.Entities.Payment>)ViewBag.RecentPayments)
                                {
                                    <tr class="payment-row" data-index="@paymentIndex" style="@(paymentIndex >= 5 ? "display: none;" : "")">
                                        <td>@(payment.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</td>
                                        <td>@(payment.Subscription?.Contract?.Client?.RazaoSocial ?? payment.Subscription?.Contract?.Client?.ContactName ?? "N/A")</td>
                                        <td>R$ @(payment.Amount.ToString("N2"))</td>
                                        <td>
                                            @switch (payment.Status)
                                            {
                                                case PaymentStatus.Pending:
                                                    <span class="badge bg-warning">Pendente</span>
                                                    break;
                                                case PaymentStatus.Processing:
                                                    <span class="badge bg-info">Processando</span>
                                                    break;
                                                case PaymentStatus.AwaitingValidation:
                                                    <span class="badge bg-info"><i class="bi bi-clock-history"></i> Aguardando Validação</span>
                                                    break;
                                                case PaymentStatus.Paid:
                                                    <span class="badge bg-success">Pago</span>
                                                    break;
                                                case PaymentStatus.Failed:
                                                    <span class="badge bg-danger">Falhou</span>
                                                    break;
                                                case PaymentStatus.Refunded:
                                                    <span class="badge bg-secondary">Reembolsado</span>
                                                    break;
                                                case PaymentStatus.Cancelled:
                                                    <span class="badge bg-dark">Cancelado</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">@payment.Status</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                    paymentIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Paginação -->
                    @if (totalPages > 1)
                    {
                        <nav aria-label="Paginação de pagamentos recentes" class="mt-3">
                            <ul class="pagination pagination-sm justify-content-center mb-0" id="recentPaymentsPagination">
                                <li class="page-item disabled" id="prevPaymentPageBtn">
                                    <a class="page-link" href="#" onclick="changePaymentPage('prev'); return false;" tabindex="-1">
                                        <i class="bi bi-chevron-left"></i> Anterior
                                    </a>
                                </li>
                                @for (var i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == 1 ? "active" : "")" data-page="@i">
                                        <a class="page-link" href="#" onclick="changePaymentPage(@i); return false;">@i</a>
                                    </li>
                                }
                                <li class="page-item @(totalPages <= 1 ? "disabled" : "")" id="nextPaymentPageBtn">
                                    <a class="page-link" href="#" onclick="changePaymentPage('next'); return false;">
                                        Próximo <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                        <div class="text-center mt-2">
                            <small class="text-muted" id="paymentPageInfo">Página 1 de @totalPages</small>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Nenhum pagamento nos últimos 30 dias.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Ações Rápidas -->

<!-- Gráficos de Distribuição -->
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#paymentsByMethodBody" aria-expanded="false" aria-controls="paymentsByMethodBody">

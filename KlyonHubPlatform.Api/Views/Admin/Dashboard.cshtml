            </div>
            <div class="card-body collapse" id="paymentsByMethodBody">
                <canvas id="paymentsByMethodChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Gráficos Adicionais -->
<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card">
            <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#topLocationsBody" aria-expanded="false" aria-controls="topLocationsBody">
                <h5 class="mb-0"><i class="bi bi-trophy"></i> Top 5 Localidades por Receita <i class="bi bi-chevron-down float-end"></i></h5>
            </div>
            <div class="card-body collapse" id="topLocationsBody">
                <canvas id="topLocationsChart"></canvas>
            </div>
        </div>
    </div>
    @{
        var productsByType = ViewBag.ProductsByType as List<dynamic> ?? new List<dynamic>();
        var hasProducts = productsByType != null && productsByType.Count > 0;
    }
    @if (hasProducts)
    {
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-box-seam"></i> Produtos Oferecidos pelos Coworkings</h5>
                </div>
                <div class="card-body">
                    <canvas id="productsChart"></canvas>
                </div>

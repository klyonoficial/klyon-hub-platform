@{
    ViewData["Title"] = "Gerenciar Coworkings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using KlyonHubPlatform.Domain.Core.Enums

@model List<KlyonHubPlatform.Domain.Entities.Coworking>

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-building"></i> Gerenciar Coworkings</h2>
        <p class="text-muted mb-0">
            <i class="bi bi-info-circle"></i> 
            <strong>Percentagens:</strong> Clique no botão <i class="bi bi-percent"></i> ou no badge da coluna "Serviços" para configurar percentagens. 
            <strong>Endereços:</strong> Clique no badge da coluna "Endereços" para ver os endereços de cada coworking.
        </p>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Coworkings", "Admin")" class="row g-3">
            @if (ViewBag.CapacityAlert == true)
            {
                <input type="hidden" name="capacityAlert" value="true" />
            }
            <div class="col-md-4">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Nome, CNPJ ou Email">
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="active" selected="@(ViewBag.Status == "active")">Ativos</option>
                    <option value="inactive" selected="@(ViewBag.Status == "inactive")">Inativos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="isPartner" class="form-label">Tipo</label>
                <select class="form-select" id="isPartner" name="isPartner">
                    <option value="">Todos</option>
                    <option value="true" selected="@(ViewBag.IsPartner == "true")">Parceiros</option>
                    <option value="false" selected="@(ViewBag.IsPartner == "false")">Próprios</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="approvalStatus" class="form-label">Aprovação</label>
                <select class="form-select" id="approvalStatus" name="approvalStatus">
                    <option value="">Todos</option>
                    <option value="UnderReview" selected="@(ViewBag.ApprovalStatus == "UnderReview")">Aguardando aprovação</option>
                    <option value="AwaitingAdjustment" selected="@(ViewBag.ApprovalStatus == "AwaitingAdjustment")">Aguardando ajuste</option>
                    <option value="Approved" selected="@(ViewBag.ApprovalStatus == "Approved")">Aprovado</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action("Coworkings", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.CapacityAlert == true)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
        <h5 class="alert-heading">
            <i class="bi bi-exclamation-triangle-fill"></i> 
            <strong>Alerta de Capacidade Máxima</strong>
        </h5>
        <p class="mb-0">
            Os coworkings destacados abaixo possuem <strong>pelo menos um endereço</strong> que atingiu a capacidade máxima 
            (seja por <strong>MaxContracts</strong> ou por <strong>Capacidade Fiscal Aprovada</strong>). 
            Clique em "Visualizar" para ver os detalhes de cada endereço e identificar qual(is) está(ão) na capacidade máxima.
        </p>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    <div class="mb-3">
        <p class="text-muted mb-0">
            Mostrando <strong>@((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)</strong> a 
            <strong>@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems))</strong> de 
            <strong>@ViewBag.TotalItems</strong> coworking(s)
        </p>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CNPJ</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Endereços</th>
                            <th>Serviços</th>
                            <th>Status</th>
                            <th>Aprovação</th>
                            <th>Tipo</th>
                            <th>Data Cadastro</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coworking in Model)
                        {
                            var hasMaxCapacity = ViewBag.HasMaxCapacity as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                            var isAtMaxCapacity = hasMaxCapacity.ContainsKey(coworking.Id) && hasMaxCapacity[coworking.Id];
                            <tr class="@(isAtMaxCapacity ? "table-warning" : "")">
                                <td>@coworking.Id</td>
                                <td>
                                    @coworking.Name
                                    @if (isAtMaxCapacity)
                                    {
                                        <span class="badge bg-danger ms-2" title="Este coworking possui endereços com capacidade máxima">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Capacidade Máxima
                                        </span>
                                    }
                                </td>
                                <td>@coworking.CNPJ</td>
                                <td>@((coworking.ContactEmail ?? coworking.User?.Email) ?? "-")</td>
                                <td>@(coworking.ContactPhone ?? "-")</td>
                                <td>
                                    <a href="@Url.Action("ViewCoworking", "Admin", new { id = coworking.Id })#enderecos" 
                                       class="badge bg-@(isAtMaxCapacity ? "danger" : "info") text-decoration-none" 
                                       title="@(isAtMaxCapacity ? "Este coworking possui endereços com capacidade máxima - Clique para ver detalhes" : "Clique para ver os endereços deste coworking")">
                                        @(coworking.Addresses?.Count ?? 0) endereço(s)
                                        @if (isAtMaxCapacity)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill ms-1"></i>
                                        }
                                    </a>
                                </td>
                                <td>
                                    @{
                                        var servicesCount = ViewBag.ServicesCount as Dictionary<int, int> ?? new Dictionary<int, int>();
                                        var hasPendingPercentages = ViewBag.HasPendingPercentages as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                                        var count = servicesCount.ContainsKey(coworking.Id) ? servicesCount[coworking.Id] : 0;
                                        var hasPending = hasPendingPercentages.ContainsKey(coworking.Id) && hasPendingPercentages[coworking.Id];
                                    }
                                    @if (count > 0)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <a href="@Url.Action("ViewCoworking", "Admin", new { id = coworking.Id })#servicos" 
                                               class="badge bg-@(hasPending ? "warning" : "success") text-decoration-none" 
                                               title="Clique para gerenciar serviços e percentagens">
                                                <i class="bi bi-grid"></i> @count serviço(s)
                                            </a>
                                            @if (hasPending)
                                            {
                                                <span class="badge bg-danger" title="Este coworking possui serviços com percentagem aguardando definição">
                                                    <i class="bi bi-exclamation-triangle-fill"></i> Pendente
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ViewCoworking", "Admin", new { id = coworking.Id })#servicos" 
                                           class="badge bg-secondary text-decoration-none" 
                                           title="Clique para adicionar serviços e definir percentagens">
                                            <i class="bi bi-plus-circle"></i> Adicionar
                                        </a>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@(coworking.IsActive ? "success" : "danger")">
                                        @(coworking.IsActive ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var aprovaçãoLabel = coworking.ApprovalStatus switch { 
                                            CoworkingApprovalStatus.UnderReview => "Pendente aprovação", 
                                            CoworkingApprovalStatus.AwaitingAdjustment => "Pendente reprovação", 
                                            _ => "Aprovado" 
                                        };
                                        var aprovaçãoBadge = coworking.ApprovalStatus switch { 
                                            CoworkingApprovalStatus.UnderReview => "warning", 
                                            CoworkingApprovalStatus.AwaitingAdjustment => "danger", 
                                            _ => "success" 
                                        };
                                        var isPendingApproval = coworking.ApprovalStatus == CoworkingApprovalStatus.UnderReview || coworking.ApprovalStatus == CoworkingApprovalStatus.AwaitingAdjustment;
                                    }
                                    <span class="badge bg-@aprovaçãoBadge" title="@(isPendingApproval ? "Este coworking está aguardando ação do administrador" : "")">
                                        @if (isPendingApproval)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                        }
                                        @aprovaçãoLabel
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@(coworking.IsPartner ? "primary" : "secondary")">
                                        @(coworking.IsPartner ? "Parceiro" : "Próprio")
                                    </span>
                                </td>
                                <td>@coworking.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a href="@Url.Action("ViewCoworking", "Admin", new { id = coworking.Id })" 
                                       class="btn btn-sm btn-info" 
                                       title="Visualizar">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    @{
                                        var hasPendingPercentagesBtn = ViewBag.HasPendingPercentages as Dictionary<int, bool> ?? new Dictionary<int, bool>();
                                        var hasPendingBtn = hasPendingPercentagesBtn.ContainsKey(coworking.Id) && hasPendingPercentagesBtn[coworking.Id];
                                    }
                                    <button type="button" 
                                            class="btn btn-sm btn-@(hasPendingBtn ? "warning" : "primary") position-relative" 
                                            title="@(hasPendingBtn ? "Gerenciar Serviços e Percentagens - Há percentagens pendentes" : "Gerenciar Serviços e Percentagens")"
                                            onclick="abrirModalPercentagem(@coworking.Id, '@(System.Net.WebUtility.HtmlEncode(coworking.Name ?? ""))')">
                                        <i class="bi bi-percent"></i>
                                        @if (hasPendingBtn)
                                        {
                                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                                <span class="visually-hidden">Percentagens pendentes</span>
                                            </span>
                                        }
                                    </button>
                                    <button type="button" class="btn btn-sm btn-warning" onclick="editCoworking(@coworking.Id)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    @if (coworking.ApprovalStatus == CoworkingApprovalStatus.UnderReview)
                                    {
                                        <form method="post" action="@Url.Action("ApproveCoworking", "Admin")" class="d-inline position-relative">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@coworking.Id" />
                                            <input type="hidden" name="search" value="@ViewBag.Search" />
                                            <input type="hidden" name="status" value="@ViewBag.Status" />
                                            <input type="hidden" name="isPartner" value="@ViewBag.IsPartner" />
                                            <input type="hidden" name="approvalStatus" value="@ViewBag.ApprovalStatus" />
                                            <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                                            <button type="submit" class="btn btn-sm btn-success position-relative" title="Aprovar coworking - Pendente aprovação">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                                    <span class="visually-hidden">Pendente aprovação</span>
                                                </span>
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-danger position-relative" onclick="abrirReprovar(@coworking.Id)" title="Reprovar coworking - Pendente aprovação">
                                            <i class="bi bi-x-octagon-fill"></i>
                                            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                                <span class="visually-hidden">Pendente aprovação</span>
                                            </span>
                                        </button>
                                    }
                                    @if (coworking.IsActive)
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="toggleStatus(@coworking.Id, @(System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(coworking.Name ?? ""))))" title="Inativar">
                                            <i class="bi bi-power"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" onclick="toggleStatus(@coworking.Id, @(System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(coworking.Name ?? ""))))" title="Ativar">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center mt-3">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    approvalStatus = ViewBag.ApprovalStatus,
                                    capacityAlert = ViewBag.CapacityAlert == true ? "true" : null,
                                    page = ViewBag.CurrentPage - 1 
                                })">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    approvalStatus = ViewBag.ApprovalStatus,
                                    capacityAlert = ViewBag.CapacityAlert == true ? "true" : null,
                                    page = i 
                                })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    approvalStatus = ViewBag.ApprovalStatus,
                                    capacityAlert = ViewBag.CapacityAlert == true ? "true" : null,
                                    page = ViewBag.CurrentPage + 1 
                                })">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum coworking encontrado.
            </div>
        }
    </div>
</div>

<!-- Modal Reprovar (lista) -->
<div class="modal fade" id="modalReprovarLista" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("RejectCoworking", "Admin")" id="formReprovarLista">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="reprovarId" value="" />
                <input type="hidden" name="search" value="@ViewBag.Search" />
                <input type="hidden" name="status" value="@ViewBag.Status" />
                <input type="hidden" name="isPartner" value="@ViewBag.IsPartner" />
                <input type="hidden" name="approvalStatus" value="@ViewBag.ApprovalStatus" />
                <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                <div class="modal-header">
                    <h5 class="modal-title">Reprovar cadastro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Informe a <strong>justificativa</strong> ou os <strong>itens a corrigir</strong>. O coworking verá esta mensagem no painel.</p>
                    <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Ex.: Descrição incompleta. Inclua fotos. Comprovante ilegível."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-octagon"></i> Reprovar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Percentagem do Serviço -->
<div class="modal fade" id="modalPercentagem" tabindex="-1" aria-labelledby="modalPercentagemLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalPercentagemLabel">
                    <i class="bi bi-percent"></i> Serviços e Percentagens - <span id="percentagemCoworkingName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Loading -->
                <div id="percentagemLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-2 text-muted">Carregando serviços...</p>
                </div>

                <!-- Conteúdo -->
                <div id="percentagemContent" style="display: none;">
                    <!-- Lista de serviços existentes -->
                    <div id="servicosExistentes" class="mb-4">
                        <h6 class="text-muted mb-3"><i class="bi bi-list-check"></i> Serviços Configurados</h6>
                        <div id="listaServicos"></div>
                        <div id="semServicos" class="alert alert-info" style="display: none;">
                            <i class="bi bi-info-circle"></i> Nenhum serviço cadastrado para este parceiro.
                        </div>
                    </div>

                    <hr>

                    <!-- Formulário para adicionar/editar serviço -->
                    <div id="formPercentagem">
                        <h6 class="text-muted mb-3" id="formPercentagemTitulo">
                            <i class="bi bi-plus-circle"></i> Adicionar Serviço
                        </h6>
                        <input type="hidden" id="percentagemCoworkingId" value="" />
                        <input type="hidden" id="percentagemServiceId" value="0" />
                        
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label for="percentagemServicoSelect" class="form-label">Serviço <span class="text-danger">*</span></label>
                                <select class="form-select" id="percentagemServicoSelect" required>
                                    <option value="">Selecione um serviço...</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="percentagemValor" class="form-label">Percentagem (%) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="percentagemValor" 
                                       step="any" min="0" max="100" required placeholder="Ex: 10">
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-primary w-100" onclick="salvarPercentagem()">
                                    <i class="bi bi-check-lg"></i> Salvar
                                </button>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">Percentagem fechada em contrato (não pode ser alterada pelo parceiro)</small>
                    </div>
                </div>

                <!-- Mensagem de erro -->
                <div id="percentagemErro" class="alert alert-danger" style="display: none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                <a href="#" id="btnVerDetalhes" class="btn btn-outline-primary">
                    <i class="bi bi-eye"></i> Ver Detalhes Completos
                </a>
            </div>
        </div>
    </div>
</div>

<script>
function abrirReprovar(coworkingId) {
    document.getElementById('reprovarId').value = coworkingId;
    var ta = document.querySelector('#modalReprovarLista textarea[name="rejectionReason"]');
    if (ta) ta.value = '';
    var modal = new bootstrap.Modal(document.getElementById('modalReprovarLista'));
    modal.show();
}

function editCoworking(coworkingId) {
    window.location.href = '@Url.Action("EditCoworking", "Admin")?id=' + coworkingId;
}

function toggleStatus(coworkingId, coworkingName) {
    var currentUrl = new URL(window.location.href);
    var search = currentUrl.searchParams.get('search') || '';
    var status = currentUrl.searchParams.get('status') || '';
    var isPartner = currentUrl.searchParams.get('isPartner') || '';
    var approvalStatus = currentUrl.searchParams.get('approvalStatus') || '';
    var page = currentUrl.searchParams.get('page') || '1';
    
    showConfirm(
        'Tem certeza que deseja alterar o status do coworking "' + coworkingName + '"?',
        'Confirmar Alteração de Status',
        'warning'
    ).then(confirmed => {
        if (confirmed) {
            var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("ToggleCoworkingStatus", "Admin")?id=' + coworkingId + 
                     '&search=' + encodeURIComponent(search) + 
                     '&status=' + encodeURIComponent(status) + 
                     '&isPartner=' + encodeURIComponent(isPartner) + 
                     '&approvalStatus=' + encodeURIComponent(approvalStatus) + 
                     '&page=' + encodeURIComponent(page);
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token.value;
            form.appendChild(tokenInput);
        }
        
        document.body.appendChild(form);
        form.submit();
        }
    });
}

// ========================
// Modal de Percentagem
// ========================
var percentagemModal = null;
var percentagemDadosAtuais = null;

function abrirModalPercentagem(coworkingId, coworkingName) {
    // Inicializar modal se necessário
    if (!percentagemModal) {
        percentagemModal = new bootstrap.Modal(document.getElementById('modalPercentagem'));
    }

    // Atualizar título e link
    document.getElementById('percentagemCoworkingName').textContent = coworkingName;
    document.getElementById('percentagemCoworkingId').value = coworkingId;
    document.getElementById('btnVerDetalhes').href = '@Url.Action("ViewCoworking", "Admin")/' + coworkingId + '#servicos';

    // Mostrar loading, esconder conteúdo
    document.getElementById('percentagemLoading').style.display = 'block';
    document.getElementById('percentagemContent').style.display = 'none';
    document.getElementById('percentagemErro').style.display = 'none';

    // Limpar formulário
    resetarFormularioPercentagem();

    // Abrir modal
    percentagemModal.show();

    // Carregar dados via AJAX
    carregarServicosCoworking(coworkingId);
}

function carregarServicosCoworking(coworkingId) {
    fetch('@Url.Action("GetCoworkingServicesJson", "Admin")?coworkingId=' + coworkingId)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                percentagemDadosAtuais = data;
                renderizarServicos(data);
                document.getElementById('percentagemLoading').style.display = 'none';
                document.getElementById('percentagemContent').style.display = 'block';
            } else {
                mostrarErroPercentagem(data.message || 'Erro ao carregar serviços.');
            }
        })
        .catch(error => {
            mostrarErroPercentagem('Erro de conexão: ' + error.message);
        });
}

function renderizarServicos(data) {
    var listaContainer = document.getElementById('listaServicos');
    var semServicos = document.getElementById('semServicos');
    var selectServico = document.getElementById('percentagemServicoSelect');

    // Limpar lista atual
    listaContainer.innerHTML = '';
    selectServico.innerHTML = '<option value="">Selecione um serviço...</option>';

    // Renderizar serviços existentes
    if (data.partnerServices && data.partnerServices.length > 0) {
        semServicos.style.display = 'none';
        
        var table = document.createElement('div');
        table.className = 'table-responsive';
        table.innerHTML = `
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Serviço</th>
                        <th class="text-end">Percentagem</th>
                        <th class="text-center" style="width: 120px;">Ações</th>
                    </tr>
                </thead>
                <tbody id="tbodyServicos"></tbody>
            </table>
        `;
        listaContainer.appendChild(table);

        var tbody = document.getElementById('tbodyServicos');
        data.partnerServices.forEach(function(ps) {
            var tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <strong>${escapeHtml(ps.serviceName)}</strong>
                    ${ps.serviceDescription ? '<br><small class="text-muted">' + escapeHtml(ps.serviceDescription) + '</small>' : ''}
                </td>
                <td class="text-end">
                    <span class="badge bg-primary fs-6">${ps.percentage.toFixed(2)}%</span>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-warning me-1" onclick="editarPercentagem(${ps.id}, ${ps.serviceId}, '${escapeHtml(ps.serviceName)}', ${ps.percentage})" title="Editar">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-danger" onclick="removerPercentagem(${ps.id}, '${escapeHtml(ps.serviceName)}')" title="Remover">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(tr);
        });
    } else {
        semServicos.style.display = 'block';
    }

    // Preencher select com serviços disponíveis
    if (data.availableServices && data.availableServices.length > 0) {
        data.availableServices.forEach(function(s) {
            var option = document.createElement('option');
            option.value = s.id;
            option.textContent = s.name;
            selectServico.appendChild(option);
        });
    }
}

function editarPercentagem(id, serviceId, serviceName, percentage) {
    document.getElementById('percentagemServiceId').value = id;
    
    // Adicionar o serviço atual como opção no dropdown (se não existir)
    var selectServico = document.getElementById('percentagemServicoSelect');
    var opcaoExiste = Array.from(selectServico.options).some(opt => opt.value == serviceId);
    if (!opcaoExiste) {
        var option = document.createElement('option');
        option.value = serviceId;
        option.textContent = serviceName;
        selectServico.appendChild(option);
    }
    
    selectServico.value = serviceId;
    selectServico.disabled = true;
    document.getElementById('percentagemValor').value = percentage;
    document.getElementById('formPercentagemTitulo').innerHTML = '<i class="bi bi-pencil"></i> Editar Percentagem do Serviço';
    
    // Scroll para o formulário
    document.getElementById('formPercentagem').scrollIntoView({ behavior: 'smooth' });
}

function resetarFormularioPercentagem() {
    document.getElementById('percentagemServiceId').value = '0';
    var selectServico = document.getElementById('percentagemServicoSelect');
    selectServico.value = '';
    selectServico.disabled = false;
    document.getElementById('percentagemValor').value = '';
    document.getElementById('formPercentagemTitulo').innerHTML = '<i class="bi bi-plus-circle"></i> Adicionar Serviço';
    
    // Recarregar opções do dropdown para remover serviços adicionados dinamicamente
    if (percentagemDadosAtuais && percentagemDadosAtuais.availableServices) {
        selectServico.innerHTML = '<option value="">Selecione um serviço...</option>';
        percentagemDadosAtuais.availableServices.forEach(function(s) {
            var option = document.createElement('option');
            option.value = s.id;
            option.textContent = s.name;
            selectServico.appendChild(option);
        });
    }
}

function salvarPercentagem() {
    var coworkingId = parseInt(document.getElementById('percentagemCoworkingId').value);
    var id = parseInt(document.getElementById('percentagemServiceId').value) || 0;
    var serviceId = parseInt(document.getElementById('percentagemServicoSelect').value);
    var percentage = parseFloat(document.getElementById('percentagemValor').value.replace(',', '.'));

    // Validação
    if (!serviceId || serviceId <= 0) {
        showToast('Por favor, selecione um serviço.', 'warning');
        return;
    }
    if (isNaN(percentage) || percentage < 0 || percentage > 100) {
        showToast('A percentagem deve estar entre 0 e 100.', 'warning');
        return;
    }

    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    fetch('@Url.Action("SavePartnerServiceJson", "Admin")', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({
            id: id,
            coworkingId: coworkingId,
            serviceId: serviceId,
            percentage: percentage
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showToast(data.message, 'success');
            resetarFormularioPercentagem();
            carregarServicosCoworking(coworkingId);
        } else {
            showToast(data.message || 'Erro ao salvar.', 'error');
        }
    })
    .catch(error => {
        showToast('Erro de conexão: ' + error.message, 'error');
    });
}

function removerPercentagem(id, serviceName) {
    showConfirm(
        'Tem certeza que deseja remover o serviço "' + serviceName + '"?',
        'Confirmar Remoção',
        'warning'
    ).then(confirmed => {
        if (confirmed) {
            var coworkingId = parseInt(document.getElementById('percentagemCoworkingId').value);
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch('@Url.Action("DeletePartnerServiceJson", "Admin")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ id: id })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    carregarServicosCoworking(coworkingId);
                } else {
                    showToast(data.message || 'Erro ao remover.', 'error');
                }
            })
            .catch(error => {
                showToast('Erro de conexão: ' + error.message, 'error');
            });
        }
    });
}

function mostrarErroPercentagem(mensagem) {
    document.getElementById('percentagemLoading').style.display = 'none';
    document.getElementById('percentagemContent').style.display = 'none';
    var erroDiv = document.getElementById('percentagemErro');
    erroDiv.textContent = mensagem;
    erroDiv.style.display = 'block';
}

function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Limpar formulário ao fechar modal
document.getElementById('modalPercentagem')?.addEventListener('hidden.bs.modal', function() {
    resetarFormularioPercentagem();
    percentagemDadosAtuais = null;
});
</script>

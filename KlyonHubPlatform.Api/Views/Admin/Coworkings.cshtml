@{
    ViewData["Title"] = "Gerenciar Coworkings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using KlyonHubPlatform.Domain.Core.Enums

@model List<KlyonHubPlatform.Domain.Entities.Coworking>

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building"></i> Gerenciar Coworkings</h2>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Coworkings", "Admin")" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Nome, CNPJ ou Email">
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="active" selected="@(ViewBag.Status == "active")">Ativos</option>
                    <option value="inactive" selected="@(ViewBag.Status == "inactive")">Inativos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="isPartner" class="form-label">Tipo</label>
                <select class="form-select" id="isPartner" name="isPartner">
                    <option value="">Todos</option>
                    <option value="true" selected="@(ViewBag.IsPartner == "true")">Parceiros</option>
                    <option value="false" selected="@(ViewBag.IsPartner == "false")">Próprios</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="approvalStatus" class="form-label">Aprovação</label>
                <select class="form-select" id="approvalStatus" name="approvalStatus">
                    <option value="">Todos</option>
                    <option value="UnderReview" selected="@(ViewBag.ApprovalStatus == "UnderReview")">Aguardando aprovação</option>
                    <option value="AwaitingAdjustment" selected="@(ViewBag.ApprovalStatus == "AwaitingAdjustment")">Aguardando ajuste</option>
                    <option value="Approved" selected="@(ViewBag.ApprovalStatus == "Approved")">Aprovado</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action("Coworkings", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    <div class="mb-3">
        <p class="text-muted mb-0">
            Mostrando <strong>@((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)</strong> a 
            <strong>@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems))</strong> de 
            <strong>@ViewBag.TotalItems</strong> coworking(s)
        </p>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CNPJ</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Endereços</th>
                            <th>Status</th>
                            <th>Aprovação</th>
                            <th>Tipo</th>
                            <th>Data Cadastro</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coworking in Model)
                        {
                            <tr>
                                <td>@coworking.Id</td>
                                <td>@coworking.Name</td>
                                <td>@coworking.CNPJ</td>
                                <td>@((coworking.ContactEmail ?? coworking.User?.Email) ?? "-")</td>
                                <td>@(coworking.ContactPhone ?? "-")</td>
                                <td>
                                    <span class="badge bg-info">@(coworking.Addresses?.Count ?? 0) endereços</span>
                                </td>
                                <td>
                                    <span class="badge bg-@(coworking.IsActive ? "success" : "danger")">
                                        @(coworking.IsActive ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var aprovaçãoLabel = coworking.ApprovalStatus switch { CoworkingApprovalStatus.UnderReview => "Em análise", CoworkingApprovalStatus.AwaitingAdjustment => "Aguardando ajuste", _ => "Aprovado" };
                                        var aprovaçãoBadge = coworking.ApprovalStatus switch { CoworkingApprovalStatus.UnderReview => "warning", CoworkingApprovalStatus.AwaitingAdjustment => "danger", _ => "success" };
                                    }
                                    <span class="badge bg-@aprovaçãoBadge">@aprovaçãoLabel</span>
                                </td>
                                <td>
                                    <span class="badge bg-@(coworking.IsPartner ? "primary" : "secondary")">
                                        @(coworking.IsPartner ? "Parceiro" : "Próprio")
                                    </span>
                                </td>
                                <td>@coworking.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="viewCoworking(@coworking.Id)" title="Visualizar">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="editCoworking(@coworking.Id)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    @if (coworking.ApprovalStatus == CoworkingApprovalStatus.UnderReview)
                                    {
                                        <form method="post" action="@Url.Action("ApproveCoworking", "Admin")" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@coworking.Id" />
                                            <input type="hidden" name="search" value="@ViewBag.Search" />
                                            <input type="hidden" name="status" value="@ViewBag.Status" />
                                            <input type="hidden" name="isPartner" value="@ViewBag.IsPartner" />
                                            <input type="hidden" name="approvalStatus" value="@ViewBag.ApprovalStatus" />
                                            <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                                            <button type="submit" class="btn btn-sm btn-success" title="Aprovar"><i class="bi bi-check-circle-fill"></i></button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="abrirReprovar(@coworking.Id)" title="Reprovar">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    }
                                    @if (coworking.IsActive)
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="toggleStatus(@coworking.Id, @(System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(coworking.Name ?? ""))))" title="Inativar">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" onclick="toggleStatus(@coworking.Id, @(System.Net.WebUtility.HtmlEncode(System.Text.Json.JsonSerializer.Serialize(coworking.Name ?? ""))))" title="Ativar">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center mt-3">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    approvalStatus = ViewBag.ApprovalStatus, 
                                    page = ViewBag.CurrentPage - 1 
                                })">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    approvalStatus = ViewBag.ApprovalStatus, 
                                    page = i 
                                })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    approvalStatus = ViewBag.ApprovalStatus, 
                                    page = ViewBag.CurrentPage + 1 
                                })">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum coworking encontrado.
            </div>
        }
    </div>
</div>

<!-- Modal Reprovar (lista) -->
<div class="modal fade" id="modalReprovarLista" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="@Url.Action("RejectCoworking", "Admin")" id="formReprovarLista">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="reprovarId" value="" />
                <input type="hidden" name="search" value="@ViewBag.Search" />
                <input type="hidden" name="status" value="@ViewBag.Status" />
                <input type="hidden" name="isPartner" value="@ViewBag.IsPartner" />
                <input type="hidden" name="approvalStatus" value="@ViewBag.ApprovalStatus" />
                <input type="hidden" name="page" value="@ViewBag.CurrentPage" />
                <div class="modal-header">
                    <h5 class="modal-title">Reprovar cadastro</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Informe a <strong>justificativa</strong> ou os <strong>itens a corrigir</strong>. O coworking verá esta mensagem no painel.</p>
                    <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="Ex.: Descrição incompleta. Inclua fotos. Comprovante ilegível."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle"></i> Reprovar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function abrirReprovar(coworkingId) {
    document.getElementById('reprovarId').value = coworkingId;
    var ta = document.querySelector('#modalReprovarLista textarea[name="rejectionReason"]');
    if (ta) ta.value = '';
    var modal = new bootstrap.Modal(document.getElementById('modalReprovarLista'));
    modal.show();
}

function viewCoworking(coworkingId) {
    window.location.href = '@Url.Action("ViewCoworking", "Admin")?id=' + coworkingId;
}

function editCoworking(coworkingId) {
    window.location.href = '@Url.Action("EditCoworking", "Admin")?id=' + coworkingId;
}

function toggleStatus(coworkingId, coworkingName) {
    var currentUrl = new URL(window.location.href);
    var search = currentUrl.searchParams.get('search') || '';
    var status = currentUrl.searchParams.get('status') || '';
    var isPartner = currentUrl.searchParams.get('isPartner') || '';
    var approvalStatus = currentUrl.searchParams.get('approvalStatus') || '';
    var page = currentUrl.searchParams.get('page') || '1';
    
    var action = confirm('Tem certeza que deseja alterar o status do coworking "' + coworkingName + '"?');
    
    if (action) {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("ToggleCoworkingStatus", "Admin")?id=' + coworkingId + 
                     '&search=' + encodeURIComponent(search) + 
                     '&status=' + encodeURIComponent(status) + 
                     '&isPartner=' + encodeURIComponent(isPartner) + 
                     '&approvalStatus=' + encodeURIComponent(approvalStatus) + 
                     '&page=' + encodeURIComponent(page);
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token.value;
            form.appendChild(tokenInput);
        }
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>

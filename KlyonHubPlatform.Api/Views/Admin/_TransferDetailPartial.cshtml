@model KlyonHubPlatform.Domain.Entities.Transfer
@{
    var relatedCommissions = ViewBag.RelatedCommissions as List<KlyonHubPlatform.Domain.Entities.Commission> ?? new List<KlyonHubPlatform.Domain.Entities.Commission>();
}

<div class="row">
    <div class="col-md-6">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt>
            <dd class="col-sm-8"><strong>#@Model.Id</strong></dd>
            <dt class="col-sm-4">Parceiro</dt>
            <dd class="col-sm-8"><strong>@(Model.Coworking?.Name ?? "—")</strong> @if (Model.Coworking?.CNPJ != null) { <br /><small class="text-muted">@Model.Coworking.CNPJ</small> }</dd>
            <dt class="col-sm-4">Valor</dt>
            <dd class="col-sm-8"><strong class="text-success">R$ @Model.Amount.ToString("N2")</strong></dd>
        </dl>
    </div>
    <div class="col-md-6">
        <dl class="row mb-0">
            <dt class="col-sm-4">Data solicitação</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Data agendada</dt>
            <dd class="col-sm-8">@Model.ScheduledDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8"><span class="badge bg-info"><i class="bi bi-file-earmark-check"></i> Aguardando NF</span></dd>
        </dl>
    </div>
</div>

@if (relatedCommissions.Any())
{
    <hr class="my-3" />
    <h6 class="mb-2"><i class="bi bi-cash-coin"></i> Comissões (@relatedCommissions.Count)</h6>
    <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light sticky-top">
                <tr>
                    <th>Cliente</th>
                    <th>Valor pago</th>
                    <th>%</th>
                    <th>Creditado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in relatedCommissions)
                {
                    var client = c.Payment?.Subscription?.Contract?.Client ?? c.Payment?.Reservation?.Client;
                    var name = client?.RazaoSocial ?? client?.NomeFantasia ?? client?.User?.FullName ?? "—";
                    var cred = c.TotalPaymentAmount - c.Amount;
                    <tr>
                        <td><small>@name</small></td>
                        <td><small>R$ @c.TotalPaymentAmount.ToString("N2")</small></td>
                        <td><small>@c.Percentage.ToString("F1")%</small></td>
                        <td><strong class="text-success">R$ @cred.ToString("N2")</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3 text-end">
    <a href="@Url.Action("TransferDetails", "Admin", new { id = Model.Id })" class="btn btn-sm btn-outline-primary" target="_blank">
        <i class="bi bi-box-arrow-up-right"></i> Ver detalhes completos
    </a>
</div>

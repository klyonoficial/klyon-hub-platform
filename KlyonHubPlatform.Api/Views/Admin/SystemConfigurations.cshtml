@model List<KlyonHubPlatform.Domain.Entities.SystemConfiguration>
@{
    ViewData["Title"] = "Configurações do Sistema";
    var groupedConfigurations = ViewBag.GroupedConfigurations as IEnumerable<IGrouping<string, KlyonHubPlatform.Domain.Entities.SystemConfiguration>>;
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentStorageProvider = ViewBag.CurrentStorageProvider as string ?? "AWS";
    
    // Dicionário para traduzir categorias
    var categoryTranslations = new Dictionary<string, string>
    {
        { "Email", "E-mail" },
        { "Payment", "Pagamento" },
        { "Storage", "Armazenamento" },
        { "D4Sign", "D4Sign (Assinatura Eletrônica)" },
        { "Upload", "Upload (Fotos)" },
        { "General", "Geral" },
        { "Features", "Funcionalidades" }
    };
    var d4SignConfigured = ViewBag.D4SignConfigured as bool? ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-gear"></i> Configurações do Sistema</h2>
    <div class="d-flex gap-2">
        <form method="post" action="@Url.Action("ConfigureAsaasSandbox", "Admin")" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-dark" title="Preparar configurações do Asaas (Sandbox)">
                <i class="bi bi-credit-card"></i> Configurar Asaas
            </button>
        </form>
        <form method="post" action="@Url.Action("TestAsaasConnection", "Admin")" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary" title="Testar conexão com Asaas">
                <i class="bi bi-wifi"></i> Testar Conexão Asaas
            </button>
        </form>
        <form method="post" action="@Url.Action("TestAsaasCreatePayment", "Admin")" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-success" title="Cria cobrança PIX de teste e exibe retorno 200 ou erro na tela">
                <i class="bi bi-check2-circle"></i> Testar criação de cobrança (200)
            </button>
        </form>
        <form method="post" action="@Url.Action("TestAsaasCreateCreditCardPayment", "Admin")" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-info" title="Cria cobrança com cartão de teste (R$ 5,00, sandbox) e exibe retorno na tela">
                <i class="bi bi-credit-card"></i> Testar cobrança com cartão (200)
            </button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="accordion" id="configAccordion">
            @foreach (var categoryGroup in groupedConfigurations)
            {
                var category = categoryGroup.Key;
                var categoryTranslated = categoryTranslations.ContainsKey(category) ? categoryTranslations[category] : category;
                var categoryId = category.Replace(" ", "").Replace(".", "");
                var isFirst = categoryGroup == groupedConfigurations.First();
                
                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading@(categoryId)">
                        <button class="accordion-button @(isFirst ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@(categoryId)" aria-expanded="@(isFirst ? "true" : "false")">
                            <i class="bi bi-folder me-2"></i> <strong>@categoryTranslated</strong>
                            <span class="badge bg-secondary ms-2">@categoryGroup.Count()</span>
                        </button>
                    </h2>
                    <div id="collapse@(categoryId)" class="accordion-collapse collapse @(isFirst ? "show" : "")" aria-labelledby="heading@(categoryId)" data-bs-parent="#configAccordion">
                        <div class="accordion-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Chave</th>
                                            <th>Valor</th>
                                            <th>Descrição</th>
                                            <th>Tipo</th>
                                            <th>Status</th>
                                            <th>Última Atualização</th>
                                            <th>Ações</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var config in categoryGroup)
                                        {
                                            var isStorageProvider = config.Key == "Storage.Provider";
                                            var isActiveProvider = isStorageProvider && config.Value?.ToUpper() == currentStorageProvider.ToUpper();
                                            var isStorageConfig = config.Key.StartsWith("AWS.") || config.Key.StartsWith("FTP.");
                                            var isActiveStorageConfig = isStorageConfig && 
                                                ((config.Key.StartsWith("AWS.") && currentStorageProvider.ToUpper() == "AWS") ||
                                                 (config.Key.StartsWith("FTP.") && currentStorageProvider.ToUpper() == "FTP"));
                                            var isD4SignConfig = config.Key.StartsWith("D4Sign.");
                                            var isActiveD4SignConfig = isD4SignConfig && d4SignConfigured;
                                            
                                            <tr class="@(isActiveProvider || isActiveStorageConfig || isActiveD4SignConfig ? "table-info" : "")">
                                                <td>
                                                    <code>@config.Key</code>
                                                    @if (isStorageProvider)
                                                    {
                                                        <br><small class="text-primary"><i class="bi bi-info-circle"></i> Configuração Principal</small>
                                                    }
                                                </td>
                                                <td>
                                                    @if (string.IsNullOrEmpty(config.Value))
                                                    {
                                                        <span class="text-muted">
                                                            <i class="bi bi-dash-circle"></i> Não definido
                                                        </span>
                                                    }
                                                    else if (config.IsSensitive)
                                                    {
                                                        <span class="text-muted">
                                                            <i class="bi bi-lock"></i> 
                                                            @(new string('*', Math.Min(config.Value.Length, 20)))
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>@(config.Value.Length > 100 ? config.Value.Substring(0, 100) + "..." : config.Value)</span>
                                                    }
                                                </td>
                                                <td>
                                                    <small class="text-muted">@(config.Description ?? "Sem descrição")</small>
                                                </td>
                                                <td>
                                                    @if (config.IsSensitive)
                                                    {
                                                        <span class="badge bg-danger">Sensível</span>
                                                    }
                                                    @if (config.IsEncrypted)
                                                    {
                                                        <span class="badge bg-warning">Criptografado</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (isStorageProvider)
                                                    {
                                                        if (isActiveProvider)
                                                        {
                                                            <span class="badge bg-success">
                                                                <i class="bi bi-check-circle"></i> Ativo
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                <i class="bi bi-x-circle"></i> Inativo
                                                            </span>
                                                        }
                                                    }
                                                    else if (isStorageConfig)
                                                    {
                                                        if (isActiveStorageConfig)
                                                        {
                                                            <span class="badge bg-info">
                                                                <i class="bi bi-check-circle"></i> Em Uso
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                <i class="bi bi-dash-circle"></i> Não Usado
                                                            </span>
                                                        }
                                                    }
                                                    else if (isD4SignConfig)
                                                    {
                                                        if (isActiveD4SignConfig)
                                                        {
                                                            <span class="badge bg-info">
                                                                <i class="bi bi-check-circle"></i> Em Uso
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">
                                                                <i class="bi bi-dash-circle"></i> Não Usado
                                                            </span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <small>
                                                        @if (config.UpdatedAt.HasValue)
                                                        {
                                                            @config.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                            @if (!string.IsNullOrEmpty(config.UpdatedBy))
                                                            {
                                                                <br><span class="text-muted">por @config.UpdatedBy</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Nunca atualizado</span>
                                                        }
                                                    </small>
                                                </td>
                                                <td>
                                                    <a href="@Url.Action("EditSystemConfiguration", "Admin", new { id = config.Id })" class="btn btn-sm btn-primary">
                                                        <i class="bi bi-pencil"></i> Editar
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-3">
    <small class="text-muted">
        <i class="bi bi-info-circle"></i> 
        <strong>Nota:</strong> Valores marcados como "Sensível" são mascarados por segurança. Apenas administradores podem visualizar e editar essas configurações.
    </small>
</div>

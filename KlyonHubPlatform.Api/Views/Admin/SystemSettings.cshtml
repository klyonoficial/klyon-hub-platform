@using KlyonHubPlatform.Api.Constants
@{
    ViewData[ViewDataKeys.Title] = PageTitles.SystemSettings;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-database-exclamation"></i> Manutenção da Base</h2>
    <a href="@Url.Action(ActionNames.Dashboard, ControllerNames.Admin)" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="card border-danger mb-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Zona de perigo</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">
            <strong>Resetar a base corrente</strong> apaga todos os <em>dados de negócio</em>
            (clientes, contratos, pagamentos, coworkings, documentos, históricos, etc.).
        </p>
        <p class="mb-3 text-muted">
            Configurações do sistema serão mantidas (ex.: SystemConfigurations, SEFAZ, Roles, Languages,
            Locations, Services, CreditPlans, FAQ do chatbot, histórico de migrations e o usuário admin).
            Após a limpeza, migrations pendentes (se houver) e o seed idempotente são executados.
        </p>
        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmResetDatabaseModal">
            <i class="bi bi-trash"></i> Resetar a base corrente
        </button>
    </div>
</div>

<div class="card border-warning mb-4">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-person-x"></i> Excluir dados de um cliente ou parceiro</h5>
    </div>
    <div class="card-body">
        <p class="mb-2">
            Remove <strong>todos</strong> os registros gerados por um usuário específico
            (contratos, pagamentos, documentos, chat, cartões, etc.), sem afetar o restante da base.
        </p>
        <p class="mb-3 text-muted small">
            Administradores não podem ser excluídos. Parceiros só podem ser excluídos se não houver
            contratos/clientes vinculados aos seus endereços.
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="purgeUserId" class="form-label">Id do usuário (tabela Users)</label>
                <input type="number" id="purgeUserId" class="form-control" min="1" step="1" placeholder="Ex.: 42" autocomplete="off" />
            </div>
            <div class="col-md-auto">
                <button type="button" id="btnLookupPurgeUser" class="btn btn-outline-primary">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </div>
        <div id="purgeLookupResult" class="mt-3 d-none">
            <div class="alert mb-2" id="purgeLookupAlert" role="status"></div>
            <button type="button" id="btnOpenPurgeModal" class="btn btn-warning d-none" data-bs-toggle="modal" data-bs-target="#confirmPurgeUserModal">
                <i class="bi bi-trash"></i> Excluir todos os registros deste usuário
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmResetDatabaseModal" tabindex="-1" aria-labelledby="confirmResetDatabaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmResetDatabaseModalLabel">
                    <i class="bi bi-exclamation-octagon"></i> Confirmar reset da base
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="fw-bold text-danger mb-2">
                    Esta ação é irreversível.
                </p>
                <p class="mb-2">
                    Apaga todos os dados de negócio. Configurações do sistema serão mantidas.
                </p>
                <p class="mb-0 small text-muted">
                    Digite <strong>RESETAR</strong> abaixo para habilitar a confirmação.
                </p>
                <input type="text" id="resetConfirmText" class="form-control mt-2" autocomplete="off" placeholder="RESETAR" aria-label="Confirmação textual" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" action="@Url.Action(ActionNames.ClearDatabase, ControllerNames.Admin)" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="btnConfirmResetDatabase" class="btn btn-danger" disabled>
                        <i class="bi bi-trash"></i> Sim, resetar a base
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmPurgeUserModal" tabindex="-1" aria-labelledby="confirmPurgeUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-warning">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="confirmPurgeUserModalLabel">
                    <i class="bi bi-exclamation-triangle"></i> Confirmar exclusão do usuário
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="fw-bold text-danger mb-2">Esta ação é irreversível.</p>
                <p class="mb-2" id="purgeConfirmQuestion"></p>
                <p class="mb-0 small text-muted">
                    Digite o nome exato abaixo para habilitar a confirmação.
                </p>
                <input type="text" id="purgeConfirmName" class="form-control mt-2" autocomplete="off" aria-label="Confirmação do nome" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form method="post" action="@Url.Action(ActionNames.PurgeUserData, ControllerNames.Admin)" class="d-inline" id="purgeUserForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" id="purgeFormUserId" value="" />
                    <input type="hidden" name="confirmedName" id="purgeFormConfirmedName" value="" />
                    <button type="submit" id="btnConfirmPurgeUser" class="btn btn-warning" disabled>
                        <i class="bi bi-trash"></i> Sim, excluir tudo
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('resetConfirmText');
        var btn = document.getElementById('btnConfirmResetDatabase');
        if (input && btn) {
            input.addEventListener('input', function () {
                btn.disabled = input.value.trim() !== 'RESETAR';
            });
            document.getElementById('confirmResetDatabaseModal')?.addEventListener('hidden.bs.modal', function () {
                input.value = '';
                btn.disabled = true;
            });
        }

        var lookupUrl = '@Url.Action(ActionNames.LookupUserForPurge, ControllerNames.Admin)';
        var purgeUserIdInput = document.getElementById('purgeUserId');
        var btnLookup = document.getElementById('btnLookupPurgeUser');
        var resultBox = document.getElementById('purgeLookupResult');
        var alertBox = document.getElementById('purgeLookupAlert');
        var btnOpenPurge = document.getElementById('btnOpenPurgeModal');
        var purgeConfirmName = document.getElementById('purgeConfirmName');
        var btnConfirmPurge = document.getElementById('btnConfirmPurgeUser');
        var purgeFormUserId = document.getElementById('purgeFormUserId');
        var purgeFormConfirmedName = document.getElementById('purgeFormConfirmedName');
        var purgeConfirmQuestion = document.getElementById('purgeConfirmQuestion');
        var expectedPurgeName = '';

        function resetPurgePreview() {
            expectedPurgeName = '';
            resultBox.classList.add('d-none');
            btnOpenPurge.classList.add('d-none');
            alertBox.className = 'alert mb-2';
            alertBox.textContent = '';
            purgeFormUserId.value = '';
        }

        function syncPurgeConfirm() {
            var ok = purgeConfirmName.value.trim() === expectedPurgeName && expectedPurgeName.length > 0;
            btnConfirmPurge.disabled = !ok;
            purgeFormConfirmedName.value = ok ? expectedPurgeName : '';
        }

        async function lookupPurgeUser() {
            var userId = parseInt(purgeUserIdInput.value, 10);
            if (!userId || userId <= 0) {
                resetPurgePreview();
                resultBox.classList.remove('d-none');
                alertBox.className = 'alert alert-warning mb-2';
                alertBox.textContent = 'Informe um Id de usuário válido.';
                return;
            }

            btnLookup.disabled = true;
            try {
                var response = await fetch(lookupUrl + '?userId=' + encodeURIComponent(userId), {
                    headers: { 'Accept': 'application/json' }
                });
                var data = await response.json();
                resultBox.classList.remove('d-none');
                btnOpenPurge.classList.add('d-none');
                expectedPurgeName = '';
                purgeFormUserId.value = '';

                if (!data.found) {
                    alertBox.className = 'alert alert-warning mb-2';
                    alertBox.textContent = data.blockReason || 'Usuário não encontrado.';
                    return;
                }

                var lines = [
                    '<strong>' + (data.name || '(sem nome)') + '</strong>',
                    'Tipo: ' + (data.roleDisplayName || data.roleType || '—'),
                    'E-mail: ' + (data.email || '—'),
                    'UserId: ' + data.userId
                ];

                if (!data.canDelete) {
                    alertBox.className = 'alert alert-danger mb-2';
                    alertBox.innerHTML = lines.join('<br/>') + '<hr class="my-2"/>' +
                        '<span>' + (data.blockReason || 'Exclusão não permitida.') + '</span>';
                    return;
                }

                alertBox.className = 'alert alert-success mb-2';
                alertBox.innerHTML = lines.join('<br/>');
                expectedPurgeName = data.name || '';
                purgeFormUserId.value = String(data.userId);
                purgeConfirmQuestion.textContent =
                    'Tem certeza que deseja deletar todos os registros de ' + expectedPurgeName + '?';
                btnOpenPurge.classList.remove('d-none');
            } catch (err) {
                resultBox.classList.remove('d-none');
                btnOpenPurge.classList.add('d-none');
                alertBox.className = 'alert alert-danger mb-2';
                alertBox.textContent = 'Erro ao buscar usuário. Tente novamente.';
            } finally {
                btnLookup.disabled = false;
            }
        }

        btnLookup?.addEventListener('click', lookupPurgeUser);
        purgeUserIdInput?.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                lookupPurgeUser();
            }
        });
        purgeConfirmName?.addEventListener('input', syncPurgeConfirm);
        document.getElementById('confirmPurgeUserModal')?.addEventListener('hidden.bs.modal', function () {
            purgeConfirmName.value = '';
            btnConfirmPurge.disabled = true;
            purgeFormConfirmedName.value = '';
        });
        document.getElementById('confirmPurgeUserModal')?.addEventListener('shown.bs.modal', function () {
            purgeConfirmName.focus();
        });
    })();
</script>

@{
    ViewData["Title"] = "Editar Localidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonHubPlatform.Domain.Entities.Location

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Localidade</h2>
    <a href="@Url.Action(ActionNames.Locations, ControllerNames.Admin)" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Informações da Localidade</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action(ActionNames.EditLocation, ControllerNames.Admin, new { id = Model.Id })">
                    <div class="mb-3">
                        <label for="city" class="form-label">Cidade <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="city" name="city" required maxlength="100" value="@Model.City">
                    </div>

                    <div class="mb-3">
                        <label for="state" class="form-label">Estado (UF) <span class="text-danger">*</span></label>
                        <select class="form-select" id="state" name="state" required>
                            <option value="">Selecione o estado</option>
                            @foreach (var stateOption in ViewBag.BrazilianStates as List<string>)
                            {
                                <option value="@stateOption" selected="@(Model.State == stateOption)">@stateOption</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="region" class="form-label">Região</label>
                        <select class="form-select" id="region" name="region">
                            <option value="">Selecione a região</option>
                            @foreach (var regionOption in ViewBag.Regions as List<string>)
                            {
                                <option value="@regionOption" selected="@(Model.Region == regionOption)">@regionOption</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="hidden" name="isActive" value="false">
                        <input type="checkbox" class="form-check-input" id="isActive" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                        <label class="form-check-label" for="isActive">
                            Localidade Ativa
                        </label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action(ActionNames.Locations, ControllerNames.Admin)" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-info-circle"></i> Informações</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <strong>ID:</strong> @Model.Id
                </p>
                <p class="text-muted">
                    <strong>Cadastrado em:</strong> @Model.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)
                </p>
                <p class="text-muted">
                    <strong>Status:</strong> Apenas localidades ativas aparecerão para os clientes na escolha de endereço fiscal.
                </p>
            </div>
        </div>
    </div>
</div>

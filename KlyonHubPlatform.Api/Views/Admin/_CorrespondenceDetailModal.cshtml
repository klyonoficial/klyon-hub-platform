@model KlyonHubPlatform.Domain.Entities.Correspondence
@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Domain.Core.Enums
@{
    var coworkingName = Model.Contract?.CoworkingAddress?.Coworking?.Name ?? "-";
    var clientName = Model.Contract?.Client?.ContactName ?? Model.Contract?.Client?.RazaoSocial ?? Model.Contract?.Client?.NomeFantasia ?? "-";
    var address = Model.Contract?.CoworkingAddress != null
        ? $"{Model.Contract.CoworkingAddress.Address}, {Model.Contract.CoworkingAddress.Number}"
        : "-";
    var status = Model.PickupStatus;
    var statusText = status == CorrespondencePickupStatus.AwaitingSchedule ? "Aguardando agendamento" : status == CorrespondencePickupStatus.Scheduled ? "Agendada" : "Retirada";
    var statusBadge = status == CorrespondencePickupStatus.AwaitingSchedule ? "bg-warning" : status == CorrespondencePickupStatus.Scheduled ? "bg-info" : "bg-success";
}
<div class="row">
    <div class="col-12">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Data de chegada</dt>
            <dd class="col-sm-8">@Model.ArrivalDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Parceiro</dt>
            <dd class="col-sm-8">@coworkingName</dd>

            <dt class="col-sm-4 text-muted">Cliente</dt>
            <dd class="col-sm-8">@clientName</dd>

            <dt class="col-sm-4 text-muted">Endereço</dt>
            <dd class="col-sm-8">@address</dd>

            <dt class="col-sm-4 text-muted">Contrato</dt>
            <dd class="col-sm-8">@(Model.Contract?.ContractNumber ?? "-")</dd>

            <dt class="col-sm-4 text-muted">Status</dt>
            <dd class="col-sm-8"><span class="badge @statusBadge">@statusText</span></dd>

            @if (Model.PickupScheduledAt.HasValue)
            {
                <dt class="col-sm-4 text-muted">Data/hora retirada</dt>
                <dd class="col-sm-8">@Model.PickupScheduledAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
            }

            <dt class="col-sm-4 text-muted">Registrado em</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <dt class="col-sm-4 text-muted">Observações</dt>
                <dd class="col-sm-8">@Model.Notes</dd>
            }
        </dl>
    </div>
</div>
@if (Model.Photos != null && Model.Photos.Any())
{
    <hr />
    <h6 class="text-muted mb-2"><i class="bi bi-images"></i> Fotos</h6>
    <div class="row g-2">
        @foreach (var photo in Model.Photos)
        {
            <div class="col-6 col-md-4">
                <a href="@Url.Action(ActionNames.GetCorrespondencePhoto, ControllerNames.Admin, new { id = photo.Id })" target="_blank" class="d-block border rounded overflow-hidden bg-light">
                    <img src="@Url.Action(ActionNames.GetCorrespondencePhoto, ControllerNames.Admin, new { id = photo.Id })"
                         alt="Foto"
                         class="img-fluid w-100"
                         style="max-height: 180px; object-fit: cover;" />
                </a>
            </div>
        }
    </div>
}

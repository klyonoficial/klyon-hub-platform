<!-- Modal para Adicionar/Editar Serviço -->
<div class="modal fade" id="addServiceModal" tabindex="-1" aria-labelledby="addServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addServiceModalLabel">
                    <i class="bi bi-plus-circle"></i> <span id="serviceModalTitle">Adicionar Serviço</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action(ActionNames.SavePartnerService, ControllerNames.Admin)" id="serviceForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="serviceId" value="0" />
                <input type="hidden" name="CoworkingId" value="@Model.Id" />
                <input type="hidden" name="ServiceId" id="serviceIdHidden" value="" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="serviceSelect" class="form-label">Serviço <span class="text-danger">*</span></label>
                        <select class="form-select" id="serviceSelect" required>
                            <option value="">Selecione um serviço...</option>
                            @{
                                var services = ViewBag.Services as List<Service> ?? new List<Service>();
                            }
                            @foreach (var service in services.OrderBy(s => s.DisplayOrder))
                            {
                                <option value="@service.Id">@service.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="servicePercentage" class="form-label">Percentagem (%) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="servicePercentage" name="Percentage" 
                               step="any" min="0" max="100" required placeholder="Ex: 20 ou 12,5">
                        <small class="text-muted">Percentagem fechada em contrato (não pode ser alterada pelo parceiro)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function editService(id, serviceId, serviceName, percentage) {
        document.getElementById('serviceId').value = id;
        document.getElementById('serviceIdHidden').value = serviceId;
        document.getElementById('serviceSelect').value = serviceId;
        document.getElementById('serviceSelect').disabled = true;
        document.getElementById('servicePercentage').value = percentage;
        document.getElementById('serviceModalTitle').textContent = 'Editar Percentagem do Serviço';
        document.getElementById('serviceForm').action = '@Url.Action(ActionNames.SavePartnerService, ControllerNames.Admin)';
        var modal = new bootstrap.Modal(document.getElementById('addServiceModal'));
        modal.show();
    }

    document.getElementById('serviceSelect')?.addEventListener('change', function() {
        document.getElementById('serviceIdHidden').value = this.value;
    });

    document.getElementById('addServiceModal')?.addEventListener('hidden.bs.modal', function() {
        document.getElementById('serviceForm').reset();
        document.getElementById('serviceId').value = '0';
        document.getElementById('serviceIdHidden').value = '';
        document.getElementById('serviceSelect').disabled = false;
        document.getElementById('serviceModalTitle').textContent = 'Adicionar Serviço';
    });

    document.getElementById('addServiceModal')?.addEventListener('show.bs.modal', function(e) {
        if (document.getElementById('serviceId').value === '0') {
            document.getElementById('serviceIdHidden').value = document.getElementById('serviceSelect').value;
        }
    });

    // Abrir modal de visualização ao clicar na linha (Serviços)
    document.querySelectorAll('.row-service-detail').forEach(function(row) {
        row.addEventListener('click', function(e) {
            if (e.target.closest('.no-row-click') || e.target.closest('button') || e.target.closest('form')) return;
            var name = this.getAttribute('data-service-name') || '—';
            var desc = this.getAttribute('data-service-desc') || '—';
            var pct = this.getAttribute('data-percentage') || '—';
            var created = this.getAttribute('data-created-at') || '—';
            document.getElementById('viewServiceName').textContent = name;
            document.getElementById('viewServiceDesc').textContent = desc ? desc : '—';
            document.getElementById('viewServicePercentage').textContent = pct !== '—' ? pct + '%' : '—';
            document.getElementById('viewServiceCreatedAt').textContent = created;
            var modal = new bootstrap.Modal(document.getElementById('viewServiceModal'));
            modal.show();
        });
    });

    // Abrir modal de visualização ao clicar na linha (Endereços)
    document.querySelectorAll('.row-address-detail').forEach(function(row) {
        row.addEventListener('click', function(e) {
            if (e.target.closest('.no-row-click') || e.target.closest('select') || e.target.closest('form')) return;
            document.getElementById('viewAddrStreet').textContent = this.getAttribute('data-address') || '—';
            document.getElementById('viewAddrNumber').textContent = this.getAttribute('data-number') || '—';
            document.getElementById('viewAddrComplement').textContent = this.getAttribute('data-complement') || '—';
            document.getElementById('viewAddrNeighborhood').textContent = this.getAttribute('data-neighborhood') || '—';
            document.getElementById('viewAddrCity').textContent = this.getAttribute('data-city') || '—';
            document.getElementById('viewAddrState').textContent = this.getAttribute('data-state') || '—';
            document.getElementById('viewAddrZip').textContent = this.getAttribute('data-zip') || '—';
            var basePrice = this.getAttribute('data-base-price');
            document.getElementById('viewAddrBasePrice').textContent = basePrice ? 'R$ ' + basePrice : '—';
            document.getElementById('viewAddrAvailable').innerHTML = (this.getAttribute('data-available') === 'Sim')
                ? '<span class="badge bg-success">Sim</span>' : '<span class="badge bg-danger">Não</span>';
            var statusLabel = this.getAttribute('data-status-label') || '—';
            var statusBadge = this.getAttribute('data-status-badge') || 'secondary';
            document.getElementById('viewAddrStatus').innerHTML = '<span class="badge bg-' + statusBadge + '">' + statusLabel + '</span>';
            document.getElementById('viewAddrContracts').textContent = (this.getAttribute('data-current-contracts') || '0') + ' / ' + (this.getAttribute('data-max-contracts') || '0');
            document.getElementById('viewAddrFiscalCapacity').textContent = this.getAttribute('data-fiscal-capacity') || '—';
            var shared = this.getAttribute('data-shared-room');
            var sharedPrice = this.getAttribute('data-shared-price');
            var sharedSeats = this.getAttribute('data-shared-seats');
            document.getElementById('viewAddrSharedRoom').textContent = shared === 'Sim'
                ? 'Sim — R$ ' + sharedPrice + '/h, até ' + sharedSeats + ' lugares' : 'Não';
            var priv = this.getAttribute('data-private-room');
            var privPrice = this.getAttribute('data-private-price');
            var privSeats = this.getAttribute('data-private-seats');
            document.getElementById('viewAddrPrivateRoom').textContent = priv === 'Sim'
                ? 'Sim — R$ ' + privPrice + '/h, até ' + privSeats + ' lugares' : 'Não';
            document.getElementById('viewAddrCreatedAt').textContent = this.getAttribute('data-created-at') || '—';
            document.getElementById('viewAddrUpdatedAt').textContent = this.getAttribute('data-updated-at') || '—';
            var modal = new bootstrap.Modal(document.getElementById('viewAddressModal'));
            modal.show();
        });
    });

    async function handleDeleteService(form) {
        const confirmed = await showConfirm(
            'Tem certeza que deseja remover este serviço?',
            'Confirmar Remoção',
            'warning'
        );
        
        if (confirmed) {
            form.submit();
        }
    }

    // Rotacionar ícones de chevron ao expandir/colapsar seções
    document.addEventListener('DOMContentLoaded', function() {
        const collapseElements = document.querySelectorAll('[data-bs-toggle="collapse"]');
        
        collapseElements.forEach(function(element) {
            const chevron = element.querySelector('.bi-chevron-down');
            if (chevron) {
                element.addEventListener('shown.bs.collapse', function() {
                    chevron.classList.remove('bi-chevron-down');
                    chevron.classList.add('bi-chevron-up');
                });
                
                element.addEventListener('hidden.bs.collapse', function() {
                    chevron.classList.remove('bi-chevron-up');
                    chevron.classList.add('bi-chevron-down');
                });
            }
        });

        // Expandir seção baseada na âncora da URL
        const hash = window.location.hash;
        if (hash) {
            let targetId = '';
            if (hash === '#servicos') {
                targetId = 'servicosBody';
            } else if (hash === '#documentos') {
                targetId = 'documentosBody';
            } else if (hash === '#enderecos') {
                targetId = 'enderecosBody';
            } else if (hash === '#fotos') {
                targetId = 'fotosBody';
            }
            
            if (targetId) {
                const targetElement = document.getElementById(targetId);
                if (targetElement) {
                    const bsCollapse = new bootstrap.Collapse(targetElement, { show: true });
                    // Atualizar o ícone
                    const header = document.querySelector('[data-bs-target="#' + targetId + '"]');
                    if (header) {
                        const chevron = header.querySelector('.bi-chevron-down');
                        if (chevron) {
                            chevron.classList.remove('bi-chevron-down');
                            chevron.classList.add('bi-chevron-up');
                        }
                    }
                }
            }
        }
    });
</script>

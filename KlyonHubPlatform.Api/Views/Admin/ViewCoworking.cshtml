                <h5 class="modal-title" id="viewServiceModalLabel"><i class="bi bi-grid"></i> Detalhes do Serviço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">

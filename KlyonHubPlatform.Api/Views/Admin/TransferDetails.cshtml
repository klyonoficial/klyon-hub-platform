@{
    ViewData[ViewDataKeys.Title] = "Detalhes da Transferência";
    Layout = LayoutPaths.Layout;
}

@model KlyonHubPlatform.Domain.Entities.Transfer
@{
    var relatedCommissions = ViewBag.RelatedCommissions as List<KlyonHubPlatform.Domain.Entities.Commission> ?? new List<KlyonHubPlatform.Domain.Entities.Commission>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-info-circle"></i> Detalhes da Transferência #@Model.Id</h2>
    <a href="@Url.Action(ActionNames.Transfers, ControllerNames.Admin)" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar para Transferências
    </a>
</div>

<!-- Informações da Transferência -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-arrow-left-right"></i> Informações da Transferência</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">ID:</dt>
                    <dd class="col-sm-8"><strong>#@Model.Id</strong></dd>

                    <dt class="col-sm-4">Parceiro:</dt>
                    <dd class="col-sm-8">
                        <strong>@(Model.Coworking?.Name ?? DefaultDisplayStrings.EmptyPlaceholder)</strong>
                        @if (Model.Coworking?.CNPJ != null)
                        {
                            <br /><small class="text-muted">CNPJ: @Model.Coworking.CNPJ</small>
                        }
                    </dd>

                    <dt class="col-sm-4">Valor:</dt>
                    <dd class="col-sm-8"><strong class="text-success" style="font-size: 1.2em;">R$ @Model.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Status)
                        {
                            case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending:
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock-history"></i> Pendente</span>
                                break;
                            case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.AwaitingInvoice:
                                <span class="badge bg-info"><i class="bi bi-file-earmark-check"></i> Aguardando NF</span>
                                break;
                            case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Processing:
                                <span class="badge bg-primary"><i class="bi bi-arrow-repeat"></i> Processando</span>
                                break;
                            case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Completed:
                                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Concluído</span>
                                break;
                            case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Failed:
                                <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Falhou</span>
                                break;
                            case KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Cancelled:
                                <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Cancelado</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@Model.Status</span>
                                break;
                        }
                    </dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Descrição:</dt>
                    <dd class="col-sm-8">@(Model.Description ?? DefaultDisplayStrings.EmptyPlaceholder)</dd>

                    <dt class="col-sm-4">Data de Solicitação:</dt>
                    <dd class="col-sm-8">
                        @Model.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)
                    </dd>

                    <dt class="col-sm-4">Data Agendada:</dt>
                    <dd class="col-sm-8">
                        @Model.ScheduledDate.ToString(DateFormatConstants.DisplayDateAndTime)
                    </dd>

                    @if (Model.ProcessedAt.HasValue)
                    {
                        <dt class="col-sm-4">Data do Repasse:</dt>
                        <dd class="col-sm-8">
                            @Model.ProcessedAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)
                        </dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.ExternalTransferId))
                    {
                        <dt class="col-sm-4">ID Externo:</dt>
                        <dd class="col-sm-8"><small class="text-muted">@Model.ExternalTransferId</small></dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.FailureReason))
                    {
                        <dt class="col-sm-4">Motivo da Falha:</dt>
                        <dd class="col-sm-8"><span class="text-danger">@Model.FailureReason</span></dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<!-- Informações da Reserva (se aplicável) -->
@if (Model.ReservationId.HasValue && Model.Reservation != null)
{
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Informações da Reserva</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">ID da Reserva:</dt>
                        <dd class="col-sm-8"><strong>#@Model.Reservation.Id</strong></dd>

                        <dt class="col-sm-4">Data da Reserva:</dt>
                        <dd class="col-sm-8">@Model.Reservation.ReservationDate.ToString(DateFormatConstants.DisplayDateOnly)</dd>

                        @if (Model.Reservation.StartTime.HasValue && Model.Reservation.EndTime.HasValue)
                        {
                            <dt class="col-sm-4">Horário:</dt>
                            <dd class="col-sm-8">
                                @Model.Reservation.StartTime.Value.ToString(@"hh\:mm") - @Model.Reservation.EndTime.Value.ToString(@"hh\:mm")
                            </dd>
                        }

                        <dt class="col-sm-4">Tipo de Sala:</dt>
                        <dd class="col-sm-8">@Model.Reservation.RoomType</dd>

                        <dt class="col-sm-4">Valor Total:</dt>
                        <dd class="col-sm-8"><strong class="text-success">R$ @Model.Reservation.TotalValue.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(Model.Reservation.Status == KlyonHubPlatform.Domain.Core.Enums.ReservationStatus.Confirmed ? "success" : Model.Reservation.Status == KlyonHubPlatform.Domain.Core.Enums.ReservationStatus.Cancelled ? "danger" : "secondary")">
                                @Model.Reservation.Status
                            </span>
                        </dd>

                        @if (Model.Reservation.CoworkingAddress != null)
                        {
                            <dt class="col-sm-4">Endereço:</dt>
                            <dd class="col-sm-8">
                                @Model.Reservation.CoworkingAddress.Address, @Model.Reservation.CoworkingAddress.Number
                                @if (!string.IsNullOrEmpty(Model.Reservation.CoworkingAddress.Complement))
                                {
                                    <text> - @Model.Reservation.CoworkingAddress.Complement</text>
                                }
                                <br />
                                <small class="text-muted">
                                    @Model.Reservation.CoworkingAddress.Neighborhood, @Model.Reservation.CoworkingAddress.City - @Model.Reservation.CoworkingAddress.State
                                </small>
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

<!-- Comissões Relacionadas -->
@if (relatedCommissions.Any())
{
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-cash-coin"></i> Comissões Relacionadas (@relatedCommissions.Count)</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID Comissão</th>
                            <th>Cliente</th>
                            <th>Valor do Pagamento</th>
                            <th>% Comissão</th>
                            <th>Valor da Comissão</th>
                            <th>Data do Pagamento</th>
                            <th>Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commission in relatedCommissions)
                        {
                            var client = commission.Payment?.Subscription?.Contract?.Client 
                                ?? commission.Payment?.Reservation?.Client;
                            var clientName = client?.RazaoSocial ?? client?.NomeFantasia ?? client?.User?.FullName ?? DefaultDisplayStrings.EmptyPlaceholder;
                            var clientDoc = client?.CNPJ ?? client?.CPF ?? DefaultDisplayStrings.EmptyPlaceholder;
                            var paymentType = commission.Payment?.Subscription != null ? "Endereço Fiscal" : "Reserva de Sala";
                            
                            <tr>
                                <td>#@commission.Id</td>
                                <td>
                                    <strong>@clientName</strong>
                                    <br /><small class="text-muted">@clientDoc</small>
                                </td>
                                <td><strong>R$ @commission.TotalPaymentAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></td>
                                <td>@commission.Percentage.ToString(NumberFormatConstants.TwoDecimals)%</td>
                                <td><strong class="text-success">R$ @commission.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></td>
                                <td>
                                    @if (commission.Payment?.PaidAt.HasValue == true)
                                    {
                                        @commission.Payment.PaidAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-@(paymentType == "Endereço Fiscal" ? "primary" : "info")">
                                        @paymentType
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Detalhes dos Pagamentos -->
    <div class="card mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-credit-card"></i> Detalhes dos Pagamentos</h5>
        </div>
        <div class="card-body">
            @foreach (var commission in relatedCommissions)
            {
                var payment = commission.Payment;
                var client = payment?.Subscription?.Contract?.Client 
                    ?? payment?.Reservation?.Client;
                var clientName = client?.RazaoSocial ?? client?.NomeFantasia ?? client?.User?.FullName ?? DefaultDisplayStrings.EmptyPlaceholder;
                var clientDoc = client?.CNPJ ?? client?.CPF ?? DefaultDisplayStrings.EmptyPlaceholder;
                var clientEmail = client?.ContactEmail ?? client?.User?.Email ?? DefaultDisplayStrings.EmptyPlaceholder;
                var clientPhone = client?.ContactPhone ?? DefaultDisplayStrings.EmptyPlaceholder;
                var paymentType = payment?.Subscription != null ? "Endereço Fiscal" : "Reserva de Sala";
                
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="bi bi-receipt"></i> Pagamento #@payment.Id - @paymentType
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-primary"><i class="bi bi-person"></i> Informações do Cliente</h6>
                                <dl class="row mb-0">
                                    <dt class="col-sm-5">Nome:</dt>
                                    <dd class="col-sm-7"><strong>@clientName</strong></dd>

                                    <dt class="col-sm-5">Documento:</dt>
                                    <dd class="col-sm-7">@clientDoc</dd>

                                    <dt class="col-sm-5">Email:</dt>
                                    <dd class="col-sm-7">@clientEmail</dd>

                                    @if (!string.IsNullOrEmpty(clientPhone) && clientPhone != DefaultDisplayStrings.EmptyPlaceholder)
                                    {
                                        <dt class="col-sm-5">Telefone:</dt>
                                        <dd class="col-sm-7">@clientPhone</dd>
                                    }
                                </dl>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-success"><i class="bi bi-cash-stack"></i> Informações do Pagamento</h6>
                                <dl class="row mb-0">
                                    <dt class="col-sm-5">Valor:</dt>
                                    <dd class="col-sm-7"><strong class="text-success">R$ @payment.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></dd>

                                    <dt class="col-sm-5">Método:</dt>
                                    <dd class="col-sm-7">
                                        @switch (payment.Method)
                                        {
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.PIX:
                                                <span class="badge bg-primary">PIX</span>
                                                break;
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.BankTransfer:
                                                <span class="badge bg-info">Boleto</span>
                                                break;
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.CreditCard:
                                                <span class="badge bg-success">Cartão de Crédito</span>
                                                @if (payment.InstallmentCount.HasValue && payment.InstallmentValue.HasValue)
                                                {
                                                    <span class="text-muted ms-1">— @payment.InstallmentCount.Value x de R$ @payment.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span>
                                                }
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@payment.Method</span>
                                                break;
                                        }
                                    </dd>

                                    <dt class="col-sm-5">Status:</dt>
                                    <dd class="col-sm-7">
                                        @switch (payment.Status)
                                        {
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pendente</span>
                                                break;
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentStatus.Paid:
                                                <span class="badge bg-success">Pago</span>
                                                break;
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentStatus.Failed:
                                                <span class="badge bg-danger">Falhou</span>
                                                break;
                                            case KlyonHubPlatform.Domain.Core.Enums.PaymentStatus.Cancelled:
                                                <span class="badge bg-secondary">Cancelado</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@payment.Status</span>
                                                break;
                                        }
                                    </dd>

                                    @if (payment.PaidAt.HasValue)
                                    {
                                        <dt class="col-sm-5">Data do Pagamento:</dt>
                                        <dd class="col-sm-7">@payment.PaidAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)</dd>
                                    }

                                    @if (!string.IsNullOrEmpty(payment.TransactionId))
                                    {
                                        <dt class="col-sm-5">ID da Transação:</dt>
                                        <dd class="col-sm-7"><small class="text-muted">@payment.TransactionId</small></dd>
                                    }
                                </dl>
                            </div>
                        </div>

                        @if (payment.Subscription != null && payment.Subscription.Contract != null)
                        {
                            <hr />
                            <h6 class="text-info"><i class="bi bi-file-earmark-text"></i> Informações do Contrato</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-2">Número do Contrato:</dt>
                                <dd class="col-sm-4"><strong>@payment.Subscription.Contract.ContractNumber</strong></dd>

                                <dt class="col-sm-2">Valor Anual:</dt>
                                <dd class="col-sm-4"><strong>R$ @((payment.Subscription.Contract.MonthlyValue * 12).ToString(NumberFormatConstants.CurrencyTwoDecimals))</strong></dd>

                                <dt class="col-sm-2">Data de Início:</dt>
                                <dd class="col-sm-4">@payment.Subscription.Contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</dd>

                                @if (payment.Subscription.Contract.EndDate.HasValue)
                                {
                                    <dt class="col-sm-2">Data de Término:</dt>
                                    <dd class="col-sm-4">@payment.Subscription.Contract.EndDate.Value.ToString(DateFormatConstants.DisplayDateOnly)</dd>
                                }
                            </dl>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Nenhuma comissão relacionada encontrada para esta transferência.
    </div>
}

<!-- Ações -->
<div class="card">
    <div class="card-body">
        <div class="d-flex gap-2">
            <a href="@Url.Action(ActionNames.Transfers, ControllerNames.Admin)" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Voltar para Lista
            </a>
            @if (Model.Status == KlyonHubPlatform.Domain.Core.Enums.TransferStatus.Pending)
            {
                <form method="post" action="@Url.Action(ActionNames.ApproveTransfer, ControllerNames.Admin)" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="transferId" value="@Model.Id" />
                    <button type="submit" class="btn btn-success" onclick="return confirm('Tem certeza que deseja aprovar o repasse de R$ @(Model.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals))?');">
                        <i class="bi bi-check-circle"></i> Aprovar Transferência
                    </button>
                </form>
            }
        </div>
    </div>
</div>

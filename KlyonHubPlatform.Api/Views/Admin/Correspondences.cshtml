@{
    ViewData[ViewDataKeys.Title] = PageTitles.Correspondences;
    Layout = LayoutPaths.Layout;
}
@model List<KlyonHubPlatform.Domain.Entities.Correspondence>
@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Domain.Entities
@using KlyonHubPlatform.Domain.Core.Enums

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-envelope-check"></i> Correspondências (todos os parceiros)</h2>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action(ActionNames.Correspondences, ControllerNames.Admin)" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="coworkingId" class="form-label">Filtrar por parceiro / coworking</label>
                <select class="form-select" id="coworkingId" name="coworkingId">
                    <option value="">Todos</option>
                    @if (ViewBag.Coworkings != null)
                    {
                        @foreach (var c in (List<Coworking>)ViewBag.Coworkings)
                        {
                            var selected = ViewBag.SelectedCoworkingId != null && ViewBag.SelectedCoworkingId.ToString() == c.Id.ToString();
                            <option value="@c.Id" selected="@selected">@c.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Data chegada</th>
                            <th>Parceiro</th>
                            <th>Cliente</th>
                            <th>Endereço</th>
                            <th>Contrato</th>
                            <th>Status retirada</th>
                            <th>Data/hora retirada</th>
                            <th>Fotos</th>
                            <th>Registrado em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var coworkingName = item.Contract?.CoworkingAddress?.Coworking?.Name ?? "-";
                            var clientName = item.Contract?.Client?.ContactName ?? item.Contract?.Client?.RazaoSocial ?? item.Contract?.Client?.NomeFantasia ?? "-";
                            var address = item.Contract?.CoworkingAddress != null
                                ? $"{item.Contract.CoworkingAddress.Address}, {item.Contract.CoworkingAddress.Number}"
                                : "-";
                            var photoCount = item.Photos?.Count ?? 0;
                            var status = item.PickupStatus;
                            var statusText = status == CorrespondencePickupStatus.AwaitingSchedule ? "Aguardando agendamento" : status == CorrespondencePickupStatus.Scheduled ? "Agendada" : "Retirada";
                            var statusBadge = status == CorrespondencePickupStatus.AwaitingSchedule ? "bg-warning" : status == CorrespondencePickupStatus.Scheduled ? "bg-info" : "bg-success";
                            <tr class="correspondence-row" data-id="@item.Id" style="cursor: pointer;">
                                <td>@item.ArrivalDate.ToString("dd/MM/yyyy")</td>
                                <td>@coworkingName</td>
                                <td>@clientName</td>
                                <td>@address</td>
                                <td>@(item.Contract?.ContractNumber ?? "-")</td>
                                <td><span class="badge @statusBadge">@statusText</span></td>
                                <td>@(item.PickupScheduledAt.HasValue ? item.PickupScheduledAt.Value.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>
                                    @if (photoCount > 0)
                                    {
                                        <span class="badge bg-secondary">@photoCount foto(s)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td onclick="event.stopPropagation();">
                                    <button type="button" class="btn btn-sm btn-outline-primary correspondence-detail-btn" data-id="@item.Id" title="Ver detalhes">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">Nenhuma correspondência encontrada.</p>
        }
    </div>
</div>

@* Modal de detalhes da correspondência *@
<div class="modal fade" id="correspondenceDetailModal" tabindex="-1" aria-labelledby="correspondenceDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="correspondenceDetailModalLabel">
                    <i class="bi bi-envelope-check"></i> Detalhes da correspondência
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-4" id="correspondenceDetailLoading">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                </div>
                <div id="correspondenceDetailContent" style="display: none;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var modalEl = document.getElementById('correspondenceDetailModal');
        if (!modalEl) return;
        var modal = new bootstrap.Modal(modalEl);
        var detailUrl = '@Url.Action(ActionNames.GetCorrespondenceDetailModal, ControllerNames.Admin, new { id = "__id__" })';
        var loadingEl = document.getElementById('correspondenceDetailLoading');
        var contentEl = document.getElementById('correspondenceDetailContent');

        function openDetailModal(id) {
            if (!id) return;
            loadingEl.style.display = 'block';
            contentEl.style.display = 'none';
            contentEl.innerHTML = '';
            modal.show();
            var url = detailUrl.replace('__id__', id);
            fetch(url)
                .then(function (r) { return r.text(); })
                .then(function (html) {
                    loadingEl.style.display = 'none';
                    contentEl.innerHTML = html;
                    contentEl.style.display = 'block';
                })
                .catch(function () {
                    loadingEl.style.display = 'none';
                    contentEl.innerHTML = '<p class="text-danger">Não foi possível carregar os detalhes.</p>';
                    contentEl.style.display = 'block';
                });
        }
        document.querySelectorAll('.correspondence-detail-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) { e.stopPropagation(); openDetailModal(this.getAttribute('data-id')); });
        });
        document.querySelectorAll('.correspondence-row').forEach(function (row) {
            row.addEventListener('click', function () { openDetailModal(this.getAttribute('data-id')); });
        });
    })();
</script>
}

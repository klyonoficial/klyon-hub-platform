@using KlyonHubPlatform.Application.Interfaces
@model List<ClientCreditsReportDto>
@{
    ViewData[ViewDataKeys.Title] = "Relatório Financeiro de Clientes (Ledger / Conta Corrente)";
    Layout = LayoutPaths.Layout;
    
    var totalPaid = Model?.Sum(c => c.TotalAmountPaid) ?? 0m;
    var totalSpent = Model?.Sum(c => c.SpendingByCoworking.Sum(s => s.TotalValue)) ?? 0m;
    var totalCurrentBalance = totalPaid - totalSpent;
}

<style>
    .credits-kpi {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .credits-kpi h6 {
        opacity: 0.9;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }
    .credits-kpi h2 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
    }
    .report-table-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .section-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 1.5rem;
        border-radius: 12px 12px 0 0;
        border-bottom: 2px solid #dee2e6;
    }
    .clickable-row {
        cursor: pointer;
        transition: background-color 0.2s;
    }
    .clickable-row:hover {
        background-color: #f8f9fa;
    }
</style>

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="container mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="fw-bold mb-2">
                    <i class="bi bi-wallet2 text-primary me-2"></i>
                    Relatório Financeiro de Clientes (Ledger / Conta Corrente)
                </h1>
                <p class="text-muted mb-0">
                    <i class="bi bi-exclamation-triangle text-warning"></i> Extrato financeiro de todos os clientes
                </p>
            </div>
            <a href="@Url.Action("Reports", "Admin")" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Voltar aos Relatórios
            </a>
        </div>
    </div>

    <!-- KPIs Para o Administrador -->
    <div class="container mb-4">
        <h3 class="mb-3">
            <i class="bi bi-person-badge text-primary me-2"></i>
            Para o Administrador
        </h3>
        <div class="row g-3">
            <div class="col-md-3">
                <div class="credits-kpi" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h6>Total Recebido dos Clientes</h6>
                    <h2>R$ @totalPaid.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="credits-kpi" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <h6>Total Gasto em Reservas</h6>
                    <h2>R$ @totalSpent.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="credits-kpi" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
                    <h6>Total Repassado aos Coworkings</h6>
                    <h2>R$ @totalSpent.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="credits-kpi" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);">
                    <h6>Saldo Atual (Disponível)</h6>
                    <h2>R$ @totalCurrentBalance.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela de Clientes -->
    <div class="container">
        <div class="report-table-card card">
            <div class="section-header">
                <h3 class="mb-0">
                    <i class="bi bi-people text-primary me-2"></i>
                    Extrato Financeiro por Cliente
                </h3>
                <p class="text-muted mb-0 mt-2">
                    <i class="bi bi-chevron-right"></i> Clique na linha para ver o extrato completo (pagamentos e gastos)
                </p>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 2.5rem;"></th>
                                    <th><strong>Cliente</strong></th>
                                    <th class="text-end"><strong>Saldo Atual (R$)</strong></th>
                                    <th class="text-end"><strong>Total Pago (R$)</strong></th>
                                    <th class="text-end"><strong>Total Gasto (R$)</strong></th>
                                    <th><strong>Gasto por Coworking</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr class="clickable-row" onclick="window.location.href='@Url.Action("ReportClientCreditStatement", "Admin", new { clientId = c.ClientId })'">
                                        <td>
                                            <i class="bi bi-chevron-right text-muted"></i>
                                        </td>
                                        <td>
                                            <strong class="text-primary">@c.ClientName</strong>
                                        </td>
                                        <td class="text-end">
                                            @{
                                                var clientSpent = c.SpendingByCoworking?.Sum(s => s.TotalValue) ?? 0m;
                                                var clientBalance = c.TotalAmountPaid - clientSpent;
                                            }
                                            <span class="badge @(clientBalance >= 0 ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                                <i class="bi bi-wallet2"></i> R$ @clientBalance.ToString(NumberFormatConstants.CurrencyTwoDecimals)
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <strong class="text-success">R$ @c.TotalAmountPaid.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong>
                                        </td>
                                        <td class="text-end">
                                            @{
                                                var totalClientSpent = c.SpendingByCoworking?.Sum(s => s.TotalValue) ?? 0m;
                                            }
                                            <strong class="text-danger">R$ @totalClientSpent.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong>
                                        </td>
                                        <td>
                                            @if (c.SpendingByCoworking != null && c.SpendingByCoworking.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var s in c.SpendingByCoworking)
                                                    {
                                                        <span class="badge bg-light text-dark">
                                                            <i class="bi bi-building"></i> @s.CoworkingName
                                                            <br>
                                                            <small>R$ @s.TotalValue.ToString(NumberFormatConstants.TwoDecimals)</small>
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="2"><strong>TOTAL</strong></td>
                                    <td class="text-end"><strong>R$ @totalCurrentBalance.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></td>
                                    <td class="text-end"><strong>R$ @totalPaid.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></td>
                                    <td class="text-end"><strong>R$ @totalSpent.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center">
                        <i class="bi bi-inbox" style="font-size: 4rem; color: #dee2e6;"></i>
                        <p class="text-muted mt-3 mb-0">Nenhum cliente com pagamentos ou reservas registradas.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@model KlyonHubPlatform.Domain.Entities.SystemConfiguration
@using KlyonHubPlatform.Domain.Core.Constants
@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData[ViewDataKeys.Title] = "Editar Configuração";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Configuração</h2>
    <a href="@Url.Action("SystemConfigurations", "Admin")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" action="@Url.Action("EditSystemConfiguration", "Admin")">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            <div class="mb-3">
                <label class="form-label"><strong>Chave</strong></label>
                <input type="text" class="form-control" value="@Model.Key" readonly>
                <small class="form-text text-muted">A chave não pode ser alterada.</small>
            </div>

            <div class="mb-3">
                <label class="form-label"><strong>Categoria</strong></label>
                <input type="text" class="form-control" value="@Model.Category" readonly>
            </div>

            <div class="mb-3">
                <label for="configValor" class="form-label">
                    <strong>Valor</strong>
                    @if (Model.IsSensitive)
                    {
                        <span class="badge bg-danger ms-2">Sensível</span>
                    }
                    @if (Model.IsEncrypted)
                    {
                        <span class="badge bg-warning ms-2">Criptografado</span>
                    }
                </label>
                @if (Model.IsSensitive)
                {
                    <input type="password" class="form-control" id="configValor" name="value" value="@Model.Value">
                    <small class="form-text text-muted">
                        <i class="bi bi-lock"></i> Este é um campo sensível. Digite o novo valor para atualizar.
                        @if (Model.Key == "PagBank.AccessToken" || Model.Key == AsaasConfigKey.ApiKey.ToConfigKey())
                        {
                            <text>
                                <br />
                                <i class="bi bi-info-circle"></i> <strong>Dica:</strong> Obtenha o token em 
                                @if (Model.Key == AsaasConfigKey.ApiKey.ToConfigKey())
                                {
                                    <text><strong>Cole o Token (Chave de API)</strong> que começa com <code>@("$aact_")</code>, obtido em <strong>Integrações → Chaves de API</strong> no <a href="https://sandbox.asaas.com/" target="_blank">Asaas Sandbox</a> (testes) ou no <a href="https://www.asaas.com/" target="_blank">Asaas</a>. Não use o Wallet ID.</text>
                                }
                                else
                                {
                                    <text><a href="https://sandbox.pagseguro.uol.com.br/" target="_blank">PagBank Sandbox</a> (testes) ou <a href="https://pagseguro.uol.com.br/" target="_blank">PagBank Produção</a> - Integrações - APIs</text>
                                }
                            </text>
                        }
                        @if (Model.Key == D4SignConfigKeys.TokenAPI || Model.Key == D4SignConfigKeys.CryptKey)
                        {
                            <text>
                                <br />
                                <i class="bi bi-info-circle"></i> <strong>Dica:</strong> Acesse sua conta 
                                <a href="https://secure.d4sign.com.br/" target="_blank">D4Sign</a> (ou 
                                <a href="https://sandbox.d4sign.com.br/" target="_blank">Sandbox</a>) e menu <strong>Dev API</strong> para obter Token e CryptKey.
                            </text>
                        }
                    </small>
                }
                else
                {
                    @if (Model.Key == "PagBank.UseSandbox" || Model.Key == AsaasConfigKey.UseSandbox.ToConfigKey())
                    {
                        <select class="form-control" id="configValor" name="value">
                            <option value="true" selected="@(Model.Value?.ToLower() == "true")">true (Ambiente de Testes - Sandbox)</option>
                            <option value="false" selected="@(Model.Value?.ToLower() == "false")">false (Ambiente de Produção)</option>
                        </select>
                        <small class="form-text text-muted">
                            <i class="bi bi-info-circle"></i> Use <strong>true</strong> para testes ou <strong>false</strong> para pagamentos reais.
                        </small>
                    }
                    else if (Model.Key == D4SignConfigKeys.UseSandbox)
                    {
                        <select class="form-control" id="configValor" name="value">
                            <option value="true" selected="@(Model.Value?.ToLower() == "true")">true (Sandbox - sem validade jurídica)</option>
                            <option value="false" selected="@(Model.Value?.ToLower() == "false")">false (Produção - assinaturas com validade jurídica)</option>
                        </select>
                        <small class="form-text text-muted">
                            <i class="bi bi-info-circle"></i> Sandbox para testes; Produção para contratos reais.
                        </small>
                    }
                    else
                    {
                        <textarea class="form-control" id="configValor" name="value" rows="3">@Model.Value</textarea>
                        @if (Model.Key == PaymentConfigKey.HiddenPaymentOptions.ToConfigKey())
                        {
                            <small class="form-text text-muted">Deixe em branco para exibir todas as formas. Valores (vírgula): <code>PixMonthly</code>, <code>PixAnnual</code>, <code>PIX</code>, <code>Card1x</code>, <code>CardMonthly</code>, <code>Boleto</code>.</small>
                        }
                        else
                        {
                            <small class="form-text text-muted">Deixe em branco se o parâmetro não precisar de valor (ex.: Payment.HiddenPaymentOptions vazio para exibir todas as formas de pagamento).</small>
                        }
                    }
                }
            </div>

            <div class="mb-3">
                <label for="description" class="form-label"><strong>Descrição</strong></label>
                <textarea class="form-control" id="description" name="description" rows="2">@(Model.Description ?? "")</textarea>
                <small class="form-text text-muted">Descrição opcional sobre o que é esta configuração.</small>
            </div>

            <div class="mb-3">
                <div class="card bg-light">
                    <div class="card-body">
                        <small class="text-muted">
                            <strong>Informações:</strong><br>
                            <i class="bi bi-calendar"></i> Criado em: @Model.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)<br />
                            @if (Model.UpdatedAt.HasValue)
                            {
                                <text><i class="bi bi-clock-history"></i> Última atualização: @Model.UpdatedAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)<br /></text>
                            }
                            @if (!string.IsNullOrEmpty(Model.UpdatedBy))
                            {
                                <text><i class="bi bi-person"></i> Atualizado por: @Model.UpdatedBy</text>
                            }
                        </small>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Salvar Alterações
                </button>
                <a href="@Url.Action("SystemConfigurations", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Remover obrigatoriedade do campo Valor em qualquer tipo (textarea, input, select)
            document.querySelectorAll('[name="value"]').forEach(function(el) { el.removeAttribute('required'); });

            // Mostrar/ocultar senha para campos sensíveis
            const sensitiveInputs = document.querySelectorAll('input[type="password"][name="value"]');
            sensitiveInputs.forEach(input => {
                const toggleBtn = document.createElement('button');
                toggleBtn.type = 'button';
                toggleBtn.className = 'btn btn-sm btn-outline-secondary mt-2';
                toggleBtn.innerHTML = '<i class="bi bi-eye"></i> Mostrar';
                toggleBtn.onclick = function() {
                    if (input.type === 'password') {
                        input.type = 'text';
                        toggleBtn.innerHTML = '<i class="bi bi-eye-slash"></i> Ocultar';
                    } else {
                        input.type = 'password';
                        toggleBtn.innerHTML = '<i class="bi bi-eye"></i> Mostrar';
                    }
                };
                input.parentElement.appendChild(toggleBtn);
            });
        });
    </script>
}

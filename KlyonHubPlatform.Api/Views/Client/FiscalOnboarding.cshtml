@using KlyonHubPlatform.Api.Constants
@{
    Layout = LayoutPaths.Layout;
    var cwId = (int)(ViewBag.CoworkingAddressId ?? 0);
    var hasCnpj = ViewBag.DeclaresHasCnpj as bool? ?? false;
    var partner = ViewBag.PartnerDisplay as string;
    var serviceType = ViewBag.ServiceType as string ?? "";
    var isCommercial = string.Equals(serviceType, "comercial", StringComparison.OrdinalIgnoreCase);
    var serviceLabel = isCommercial ? "Comercial" : "Fiscal";
    var pageHeading = !string.IsNullOrWhiteSpace(partner)
        ? $"Endereço {serviceLabel} - {partner}"
        : $"Endereço {serviceLabel}";
    ViewData[ViewDataKeys.Title] = pageHeading;
    var preservedAcceptLgpd = ViewBag.FiscalAcceptLgpdTerms as bool? == true;
    var showLgpdError = ViewBag.FiscalShowLgpdError as bool? == true;
    var validationIssues = ViewBag.FiscalValidationIssues as IList<string>;
    string? fiscalValidationTitle = ViewBag.FiscalValidationTitle as string;
    if (validationIssues != null && validationIssues.Count > 0 && string.IsNullOrEmpty(fiscalValidationTitle))
    {
        fiscalValidationTitle = validationIssues.All(s => s.Contains("não informado", StringComparison.OrdinalIgnoreCase))
            ? "Campo não informado:"
            : "Verifique os seguintes campos:";
    }
    var fiscalBlockKind = ViewBag.FiscalOnboardingBlockedKind as string;
    var fiscalBlockMessage = ViewBag.FiscalOnboardingBlockedMessage as string;
    var fiscalBlockLoginUrl = ViewBag.FiscalOnboardingLoginUrl as string ?? Url.Action(ActionNames.Login, ControllerNames.Auth);
    var isLoggedInCheckout = ViewBag.IsLoggedInCheckout as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h2 class="mb-3" id="fiscalOnboardingHeading" data-partner="@(partner ?? "")">
            <i class="bi @(isCommercial ? "bi-briefcase" : "bi-geo-alt")" id="fiscalOnboardingHeadingIcon" aria-hidden="true"></i>
            <span id="fiscalOnboardingHeadingText">@pageHeading</span>
        </h2>

        <div id="commercialBanner" class="alert alert-info d-flex align-items-start gap-2 mb-3 border-0 shadow-sm @(isCommercial ? "" : "d-none")" style="background:linear-gradient(135deg,#e0f2fe,#f0f9ff); border-left:4px solid #0ea5e9 !important;">
            <i class="bi bi-briefcase-fill text-info mt-1 fs-5"></i>
            <div>
                <strong class="d-block mb-1">Endereço Comercial</strong>
                <span class="text-muted small">
                    Você está contratando o <strong>Endereço Comercial</strong>: <strong>CPF</strong> ou <strong>CNPJ</strong> podem contratar. Use nosso endereço no cartão de visita, site e comunicações da empresa.
                    <strong>Não pode ser usado como sede da empresa no CNPJ</strong> e não inclui documentos fiscais (IPTU, Alvará e etc.).
                </span>
            </div>
        </div>

        @if (cwId <= 0)
        {
            <div class="alert alert-warning">Endereço do parceiro inválido. Volte e escolha um endereço na lista.</div>
            <a href="@Url.Action(ActionNames.ChooseLocation, ControllerNames.Client)" class="btn btn-secondary">Voltar</a>
        }
        else if (!string.IsNullOrEmpty(fiscalBlockKind))
        {
            <div class="alert alert-warning border shadow-sm">
                <p class="mb-2 fw-semibold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @(string.IsNullOrWhiteSpace(fiscalBlockMessage) ? "Não foi possível continuar com estes dados." : fiscalBlockMessage)
                </p>
                @if (fiscalBlockKind == "AlreadyRegistered")
                {
                    <p class="text-muted small mb-3">Acesse sua conta para gerenciar seus serviços e contratos.</p>
                    <a href="@fiscalBlockLoginUrl" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Fazer login
                    </a>
                }
                else if (fiscalBlockKind == "EmailMismatch")
                {
                    <p class="text-muted small mb-3 mb-md-0">Entre no sistema com sua conta; depois do login você poderá atualizar o e-mail de contato no perfil, se precisar.</p>
                    <a href="@fiscalBlockLoginUrl" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Fazer login
                    </a>
                }
                else if (fiscalBlockKind == "AlreadyHasAddress")
                {
                    <p class="text-muted small mb-3 mb-md-0">Utilize o login da plataforma para acessar seu cadastro neste endereço.</p>
                    <a href="@fiscalBlockLoginUrl" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Entrar
                    </a>
                }
            </div>
            <a href="@Url.Action(ActionNames.ChooseLocation, ControllerNames.Client)" class="btn btn-link">
                <i class="bi bi-arrow-left me-1"></i> Voltar à lista de endereços
            </a>
        }
        else
        {
            <form id="fiscalOnboardingForm" method="post" asp-action="@ActionNames.FiscalOnboarding" asp-controller="@ControllerNames.Client" novalidate data-ajax-request="true">
                @Html.AntiForgeryToken()
                <input type="hidden" name="coworkingAddressId" value="@cwId" />
                <input type="hidden" name="serviceType" value="@serviceType" />
                @* Um único campo postado evita radios que às vezes não chegam no POST; rádios só controlam o hidden via JS. *@
                <input type="hidden" name="declaresHasCnpj" id="declaresHasCnpjField" value="@(hasCnpj ? "true" : "false")" />

                <div id="fiscalValidationAlert" class="alert alert-danger @(validationIssues != null && validationIssues.Count > 0 ? "" : "d-none")" role="alert">
                    <strong id="fiscalValidationTitle">@fiscalValidationTitle</strong>
                    <ul class="mb-0 mt-2" id="fiscalValidationList">
                        @if (validationIssues != null)
                        {
                            foreach (var line in validationIssues)
                            {
                                <li>@line</li>
                            }
                        }
                    </ul>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <label class="form-label fw-semibold">Tipo de Endereço <span class="text-danger">*</span></label>
                        <div class="d-flex gap-3 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="serviceTypeUi" id="serviceTypeFiscal" value="fiscal" @(!isCommercial ? "checked" : null) />
                                <label class="form-check-label" for="serviceTypeFiscal">
                                    <i class="bi bi-geo-alt-fill me-1 text-primary"></i>Fiscal
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="serviceTypeUi" id="serviceTypeComercial" value="comercial" @(isCommercial ? "checked" : null) />
                                <label class="form-check-label" for="serviceTypeComercial">
                                    <i class="bi bi-briefcase-fill me-1 text-info"></i>Comercial
                                </label>
                            </div>
                        </div>
                        <hr class="my-2" />
                        <label class="form-label fw-semibold">Possui CNPJ aberto?</label>
                        <div class="d-flex gap-3 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="fiscalCnpjModeUi" id="cnpjSim" value="true" @(hasCnpj ? "checked" : null) />
                                <label class="form-check-label" for="cnpjSim">Sim</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="fiscalCnpjModeUi" id="cnpjNao" value="false" @(!hasCnpj ? "checked" : null) />
                                <label class="form-check-label" for="cnpjNao">Não</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="cpf">CPF <span class="text-danger">*</span></label>
                            <input class="form-control" id="cpf" name="cpf" value="@ViewBag.CpfValue"
                                   autocomplete="off" placeholder="000.000.000-00" inputmode="numeric" maxlength="14" />
                            <div id="cpfFeedback" class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3 @(!hasCnpj ? "d-none" : "")" id="cnpjFieldRow">
                            <label class="form-label" for="cnpj">CNPJ <span class="text-danger">*</span></label>
                            <input class="form-control" id="cnpj" name="cnpj" value="@ViewBag.CnpjValue"
                                   autocomplete="off" placeholder="00.000.000/0000-00" inputmode="numeric" maxlength="18"
                                   @(hasCnpj ? "required" : "") />
                            <div id="cnpjFeedback" class="invalid-feedback"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="contactEmail">E-mail <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="contactEmail" name="contactEmail" value="@ViewBag.ContactEmail" placeholder="seu@email.com" @(isLoggedInCheckout ? "readonly" : null) />
                            @if (isLoggedInCheckout)
                            {
                                <div class="form-text">E-mail da sua conta logada.</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="contactPhone">Telefone / WhatsApp <span class="text-danger">*</span></label>
                            <input class="form-control" id="contactPhone" name="contactPhone" value="@ViewBag.ContactPhone" placeholder="(00) 00000-0000" maxlength="15" required inputmode="numeric" />
                            <div id="contactPhoneFeedback" class="invalid-feedback"></div>
                            <div class="form-text">Usado para contato e suporte via WhatsApp.</div>
                        </div>

                        <div class="mb-0">
                            <div class="form-check">
                                <input type="hidden" name="acceptLgpdTerms" id="acceptLgpdTermsValue" value="@(preservedAcceptLgpd ? "true" : "false")">
                                <input class="form-check-input @(showLgpdError ? "is-invalid" : "")" type="checkbox" id="acceptLgpdTerms" aria-describedby="fiscalLgpdError" @(preservedAcceptLgpd ? "checked" : "")>
                                <label class="form-check-label" for="acceptLgpdTerms">
                                    Li e aceito os <a href="javascript:void(0)" class="link-primary" data-bs-toggle="modal" data-bs-target="#modalTermosLgpdFiscal">Termos de Uso e a Política de Privacidade (LGPD)</a>.
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" id="btnContinuarPagar" class="btn btn-primary btn-lg rounded-pill px-4">
                    <i class="bi bi-arrow-right-circle me-1"></i> Continuar e pagar
                </button>
                <a id="btnCancelar" href="@Url.Action(ActionNames.AddressDetail, ControllerNames.Client, new { coworkingAddressId = cwId })" class="btn btn-link">Cancelar</a>
            </form>
        }
    </div>
</div>

<!-- Modal Termos de Uso e LGPD (mesmo padrão do cadastro) -->
<div class="modal fade" id="modalTermosLgpdFiscal" tabindex="-1" aria-labelledby="modalTermosLgpdFiscalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTermosLgpdFiscalLabel">Termos de Uso e Política de Privacidade (LGPD)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0">
                <iframe src="@Url.Action("TermosUsoLgpd", ControllerNames.Home, new { embed = 1 })" title="Termos de Uso e LGPD" class="w-100 border-0" style="min-height: 70vh;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var sim               = document.getElementById('cnpjSim');
        var nao               = document.getElementById('cnpjNao');
        var declaresField     = document.getElementById('declaresHasCnpjField');
        var cpfInput          = document.getElementById('cpf');
        var cpfFeedback       = document.getElementById('cpfFeedback');
        var cnpjInput         = document.getElementById('cnpj');
        var cnpjFeedback      = document.getElementById('cnpjFeedback');
        var cnpjFieldRow      = document.getElementById('cnpjFieldRow');
        var form              = document.getElementById('fiscalOnboardingForm');
        var acceptCheckbox    = document.getElementById('acceptLgpdTerms');
        var acceptHidden      = document.getElementById('acceptLgpdTermsValue');
        var contactEmailEl    = document.getElementById('contactEmail');
        var contactPhoneEl    = document.getElementById('contactPhone');
        var contactPhoneFeedback = document.getElementById('contactPhoneFeedback');
        var validationAlertEl = document.getElementById('fiscalValidationAlert');
        var validationTitleEl = document.getElementById('fiscalValidationTitle');
        var validationListEl  = document.getElementById('fiscalValidationList');
        var serviceTypeFiscalRad    = document.getElementById('serviceTypeFiscal');
        var serviceTypeComercialRad = document.getElementById('serviceTypeComercial');
        var serviceTypeHiddenInput  = form ? form.querySelector('[name="serviceType"]') : null;
        var commercialBannerEl      = document.getElementById('commercialBanner');

        function refreshValidationRefs() {
            validationTitleEl = validationAlertEl ? validationAlertEl.querySelector('#fiscalValidationTitle') : null;
            validationListEl  = validationAlertEl ? validationAlertEl.querySelector('#fiscalValidationList') : null;
        }

        function updateHeadingForServiceType(isComercial) {
            var h2 = document.getElementById('fiscalOnboardingHeading');
            var icon = document.getElementById('fiscalOnboardingHeadingIcon');
            var textSpan = document.getElementById('fiscalOnboardingHeadingText');
            if (!h2 || !icon || !textSpan) return;
            var partner = (h2.getAttribute('data-partner') || '').trim();
            var label = isComercial ? 'Comercial' : 'Fiscal';
            var heading = partner ? ('Endereço ' + label + ' - ' + partner) : ('Endereço ' + label);
            textSpan.textContent = heading;
            icon.className = 'bi ' + (isComercial ? 'bi-briefcase' : 'bi-geo-alt');
            document.title = heading;
        }

        // ── Sincronizar radio de tipo de endereço com o hidden input, banner e título da página
        function onServiceTypeChange() {
            var isComercial = serviceTypeComercialRad && serviceTypeComercialRad.checked;
            if (serviceTypeHiddenInput) serviceTypeHiddenInput.value = isComercial ? 'comercial' : 'fiscal';
            if (commercialBannerEl) commercialBannerEl.classList.toggle('d-none', !isComercial);
            updateHeadingForServiceType(isComercial);
            try {
                var u = new URL(window.location.href);
                if (form) {
                    var cwInput = form.querySelector('[name="coworkingAddressId"]');
                    if (cwInput && cwInput.value) u.searchParams.set('coworkingAddressId', cwInput.value);
                }
                u.searchParams.set('serviceType', isComercial ? 'comercial' : 'fiscal');
                history.replaceState(null, '', u.toString());
            } catch (ex) { /* ignore */ }
        }

        if (serviceTypeFiscalRad)    serviceTypeFiscalRad.addEventListener('change', onServiceTypeChange);
        if (serviceTypeComercialRad) serviceTypeComercialRad.addEventListener('change', onServiceTypeChange);
        onServiceTypeChange(); // sincroniza hidden input com o radio marcado no carregamento

        // ── Sync hidden declaresHasCnpj
        function syncDeclaresHasCnpj() {
            if (declaresField) declaresField.value = (sim && sim.checked) ? 'true' : 'false';
        }

        function hasCnpjSelected() { return !!(sim && sim.checked); }

        // ── Mostrar/esconder campo CNPJ
        function toggleCnpjField() {
            var show = hasCnpjSelected();
            if (cnpjFieldRow) cnpjFieldRow.classList.toggle('d-none', !show);
            if (cnpjInput) {
                cnpjInput.required = show;
                if (!show) { cnpjInput.value = ''; cnpjInput.classList.remove('is-invalid'); if (cnpjFeedback) cnpjFeedback.textContent = ''; }
            }
            syncDeclaresHasCnpj();
        }

        if (sim) sim.addEventListener('change', toggleCnpjField);
        if (nao) nao.addEventListener('change', toggleCnpjField);
        toggleCnpjField(); // estado inicial

        // ── Máscaras (masks.js já aplica via id*="cpf" / id*="cnpj"; aqui só limpa is-invalid)
        if (cpfInput) {
            cpfInput.addEventListener('input', function () { this.classList.remove('is-invalid'); if (cpfFeedback) cpfFeedback.textContent = ''; });
            cpfInput.addEventListener('blur', function () {
                if (!this.value) return;
                var ok = typeof validateCPF === 'function' ? validateCPF(this.value) : this.value.replace(/\D/g,'').length === 11;
                if (!ok) { this.classList.add('is-invalid'); if (cpfFeedback) cpfFeedback.textContent = 'CPF inválido.'; }
            });
        }
        if (cnpjInput) {
            cnpjInput.addEventListener('input', function () { this.classList.remove('is-invalid'); if (cnpjFeedback) cnpjFeedback.textContent = ''; clearCnpjAsyncHint(); });
            cnpjInput.addEventListener('blur', async function () {
                if (!this.value) return;
                var ok = typeof validateCNPJ === 'function' ? validateCNPJ(this.value) : this.value.replace(/\D/g,'').length === 14;
                if (!ok) { this.classList.add('is-invalid'); if (cnpjFeedback) cnpjFeedback.textContent = 'CNPJ inválido.'; return; }
                var isFiscal = serviceTypeFiscalRad && serviceTypeFiscalRad.checked;
                if (!isFiscal || !hasCnpjSelected()) return;
                await validateCnpjStatusAsync(this.value);
            });
        }

        var cnpjAsyncHintEl = null;
        function clearCnpjAsyncHint() {
            if (cnpjAsyncHintEl) { cnpjAsyncHintEl.remove(); cnpjAsyncHintEl = null; }
        }
        function showCnpjAsyncHint(html, isError) {
            clearCnpjAsyncHint();
            cnpjAsyncHintEl = document.createElement('div');
            cnpjAsyncHintEl.className = 'form-text ' + (isError ? 'text-danger' : 'text-success');
            cnpjAsyncHintEl.innerHTML = html;
            if (cnpjInput && cnpjInput.parentNode) cnpjInput.parentNode.appendChild(cnpjAsyncHintEl);
        }
        async function validateCnpjStatusAsync(cnpjVal) {
            if (!cnpjInput) return;
            var digits = cnpjVal.replace(/\D/g, '');
            if (digits.length !== 14) return;
            showCnpjAsyncHint('<span class="spinner-border spinner-border-sm me-1"></span> Validando CNPJ...', false);
            try {
                var url = '@Url.Action(ActionNames.ValidateCnpjForFiscal, ControllerNames.Client)?cnpj=' + encodeURIComponent(digits);
                var resp = await fetch(url);
                var data = await resp.json();
                clearCnpjAsyncHint();
                if (data.valid) {
                    cnpjInput.classList.remove('is-invalid');
                    var msg = 'CNPJ válido para endereço fiscal.';
                    if (data.razaoSocial) msg += ' <strong>' + data.razaoSocial + '</strong>';
                    showCnpjAsyncHint(msg, false);
                } else {
                    cnpjInput.classList.add('is-invalid');
                    if (cnpjFeedback) cnpjFeedback.textContent = data.message || 'CNPJ não aprovado.';
                    showCnpjAsyncHint(data.message || 'CNPJ não aprovado para endereço fiscal.', true);
                }
            } catch (e) {
                clearCnpjAsyncHint();
            }
        }

        // ── LGPD sync
        function syncAcceptLgpd() {
            if (acceptHidden) acceptHidden.value = acceptCheckbox && acceptCheckbox.checked ? 'true' : 'false';
        }

        function isPlausibleEmailJs(s) {
            if (!s) return false;
            return /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(String(s).trim());
        }

        // ── Coletar problemas de validação client-side
        function collectIssues() {
            var items = [];
            var cpfDigits  = (cpfInput  ? cpfInput.value  : '').replace(/\D/g,'');
            var cnpjDigits = (cnpjInput ? cnpjInput.value : '').replace(/\D/g,'');
            var phoneDigits = (contactPhoneEl ? contactPhoneEl.value : '').replace(/\D/g,'');
            var emailVal   = (contactEmailEl ? contactEmailEl.value.trim() : '');

            // CPF: sempre obrigatório
            if (cpfDigits.length === 0)
                items.push('CPF: não informado');
            else if (cpfDigits.length < 11)
                items.push('CPF: incompleto (11 dígitos)');
            else if (typeof validateCPF === 'function' && !validateCPF(cpfInput.value))
                items.push('CPF: inválido');

            // CNPJ: obrigatório apenas quando "Sim"
            if (hasCnpjSelected()) {
                if (cnpjDigits.length === 0)
                    items.push('CNPJ: não informado');
                else if (cnpjDigits.length < 14)
                    items.push('CNPJ: incompleto (14 dígitos)');
                else if (typeof validateCNPJ === 'function' && !validateCNPJ(cnpjInput.value))
                    items.push('CNPJ: inválido');
            }

            if (!emailVal)
                items.push('E-mail: não informado');
            else if (!isPlausibleEmailJs(emailVal))
                items.push('E-mail: inválido');

            if (phoneDigits.length === 0)
                items.push('Telefone / WhatsApp: não informado');
            else if (phoneDigits.length !== 10 && phoneDigits.length !== 11)
                items.push('Telefone / WhatsApp: Informe um telefone válido com DDD.');

            if (!acceptCheckbox || !acceptCheckbox.checked)
                items.push('Termos de Uso e Política de Privacidade (LGPD): aceite obrigatório');

            return items;
        }

        function showValidation(issues) {
            if (!validationAlertEl || !validationTitleEl || !validationListEl) return;
            var onlyMissing = issues.every(function(s){ return s.toLowerCase().indexOf('não informado') !== -1; });
            validationTitleEl.textContent = onlyMissing ? 'Campo não informado:' : 'Verifique os seguintes campos:';
            validationListEl.innerHTML = issues.map(function(i){
                var d = document.createElement('div'); d.textContent = i;
                return '<li>' + d.innerHTML + '</li>';
            }).join('');
            validationAlertEl.classList.remove('d-none');
            validationAlertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function applyInvalidStates(issues) {
            [cpfInput, cnpjInput, contactEmailEl, contactPhoneEl, acceptCheckbox].forEach(function(el){ if (el) el.classList.remove('is-invalid'); });
            issues.forEach(function(msg){
                if (msg.indexOf('CPF') === 0)          { if (cpfInput) cpfInput.classList.add('is-invalid'); }
                else if (msg.indexOf('CNPJ') === 0)    { if (cnpjInput) cnpjInput.classList.add('is-invalid'); }
                else if (msg.indexOf('E-mail') === 0)  { if (contactEmailEl) contactEmailEl.classList.add('is-invalid'); }
                else if (msg.indexOf('Telefone') === 0){ if (contactPhoneEl) contactPhoneEl.classList.add('is-invalid'); }
                else if (msg.indexOf('Termos') === 0)  { if (acceptCheckbox) acceptCheckbox.classList.add('is-invalid'); }
            });
        }

        if (acceptCheckbox) {
            acceptCheckbox.addEventListener('change', function(){ syncAcceptLgpd(); this.classList.remove('is-invalid'); });
        }
        if (contactEmailEl) contactEmailEl.addEventListener('input', function(){ this.classList.remove('is-invalid'); });
        if (contactPhoneEl) {
            contactPhoneEl.addEventListener('input', function () {
                this.classList.remove('is-invalid');
                if (contactPhoneFeedback) contactPhoneFeedback.textContent = '';
            });
            contactPhoneEl.addEventListener('blur', function () {
                var digits = (this.value || '').replace(/\D/g, '');
                if (!digits) return;
                if (digits.length !== 10 && digits.length !== 11) {
                    this.classList.add('is-invalid');
                    if (contactPhoneFeedback) contactPhoneFeedback.textContent = 'Informe um telefone válido com DDD.';
                }
            });
        }

        function releaseFiscalSubmitUi() {
            var btn = document.getElementById('btnContinuarPagar');
            var btnCancelar = document.getElementById('btnCancelar');
            if (window.KlyonLoading) window.KlyonLoading.hide();
            if (btn) btn.disabled = false;
            if (btnCancelar) { btnCancelar.style.pointerEvents = ''; btnCancelar.style.opacity = ''; btnCancelar.tabIndex = 0; }
        }

        if (form && acceptHidden && acceptCheckbox) {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                syncDeclaresHasCnpj();
                syncAcceptLgpd();

                var issues = collectIssues();
                if (issues.length > 0) {
                    releaseFiscalSubmitUi();
                    showValidation(issues);
                    applyInvalidStates(issues);
                    return;
                }

                if (validationAlertEl) validationAlertEl.classList.add('d-none');

                var btn = document.getElementById('btnContinuarPagar');
                var btnCancelar = document.getElementById('btnCancelar');
                if (btn) btn.disabled = true;
                if (btnCancelar) { btnCancelar.style.pointerEvents = 'none'; btnCancelar.style.opacity = '0.5'; btnCancelar.tabIndex = -1; }

                if (window.KlyonLoading) window.KlyonLoading.show();

                fetch(form.action, { method: 'POST', body: new FormData(form), redirect: 'follow' })
                    .then(function (response) {
                        if (response.redirected) { window.location.href = response.url; return; }
                        return response.text().then(function (html) {
                            releaseFiscalSubmitUi();
                            var parser = new DOMParser();
                            var doc = parser.parseFromString(html, 'text/html');
                            var serverAlert = doc.getElementById('fiscalValidationAlert');
                            if (serverAlert && !serverAlert.classList.contains('d-none')) {
                                if (validationAlertEl) {
                                    validationAlertEl.innerHTML = serverAlert.innerHTML;
                                    validationAlertEl.classList.remove('d-none');
                                    refreshValidationRefs();
                                    validationAlertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                }
                                return;
                            }
                            var blockedEl = doc.querySelector('.alert-warning, .alert-danger');
                            if (blockedEl) {
                                if (validationAlertEl) { validationAlertEl.innerHTML = blockedEl.innerHTML; validationAlertEl.classList.remove('d-none'); validationAlertEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
                                return;
                            }
                            window.location.reload();
                        });
                    })
                    .catch(function () {
                        releaseFiscalSubmitUi();
                        if (validationAlertEl) { validationAlertEl.innerHTML = '<strong>Erro de conexão.</strong> Verifique sua internet e tente novamente.'; validationAlertEl.classList.remove('d-none'); }
                    });
            });
        }
    });
</script>

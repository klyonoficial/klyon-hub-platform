@{
    ViewData["Title"] = "Pagamento - Comprar Créditos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var purchase = ViewBag.Purchase as KlyonHubPlatform.Domain.Entities.CreditPurchase;
    var client = ViewBag.Client as KlyonHubPlatform.Domain.Entities.Client;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-credit-card"></i> Pagamento</h2>
    <a href="@Url.Action("BuyCredits", "Client")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (purchase != null)
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Detalhes da Compra</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Plano:</strong> @purchase.CreditPlan.Name
                        </div>
                        <div class="col-md-6 text-end">
                            <strong>Valor:</strong> <span class="text-primary fs-5">R$ @purchase.AmountPaid.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span>
                        </div>
                    </div>
                    <hr>
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <span>Créditos:</span>
                        </div>
                        <div class="col-md-6 text-end">
                            <strong>@purchase.CreditsReceived</strong>
                        </div>
                    </div>
                    @if (purchase.BonusCredits > 0)
                    {
                        <div class="row mb-2">
                            <div class="col-md-6">
                                <span class="text-success">Bônus:</span>
                            </div>
                            <div class="col-md-6 text-end">
                                <strong class="text-success">+@purchase.BonusCredits</strong>
                            </div>
                        </div>
                    }
                    <hr>
                    <div class="row">
                        <div class="col-md-6">
                            <strong>Total de Créditos:</strong>
                        </div>
                        <div class="col-md-6 text-end">
                            <strong class="text-success fs-5">@(purchase.CreditsReceived + purchase.BonusCredits) créditos</strong>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-md-6">
                            <small class="text-muted">Status:</small>
                        </div>
                        <div class="col-md-6 text-end">
                            @switch (purchase.Status)
                            {
                                case KlyonHubPlatform.Domain.Core.Enums.CreditPurchaseStatus.Pending:
                                    <span class="badge bg-warning">Pendente</span>
                                    break;
                                case KlyonHubPlatform.Domain.Core.Enums.CreditPurchaseStatus.Processing:
                                    <span class="badge bg-info">Processando</span>
                                    break;
                                case KlyonHubPlatform.Domain.Core.Enums.CreditPurchaseStatus.Paid:
                                    <span class="badge bg-success">Pago</span>
                                    break;
                                case KlyonHubPlatform.Domain.Core.Enums.CreditPurchaseStatus.Cancelled:
                                    <span class="badge bg-danger">Cancelado</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@purchase.Status</span>
                                    break;
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (purchase.PaymentMethod == KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.PIX)
            {
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-qr-code"></i> Pagamento via PIX</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(purchase.PixCode))
                        {
                            <p class="lead">Escaneie o QR Code ou copie o código PIX para pagar</p>
                            
                            <div class="mb-4">
                                <div class="d-inline-block p-3 bg-white border rounded"><canvas id="qrcode"></canvas></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Código PIX (Copiar e Colar):</label>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-lg" id="pixCode" value="@purchase.PixCode" readonly>
                                    <button class="btn btn-primary" type="button" onclick="copyPixCode()">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>

                            @if (purchase.PixExpiresAt.HasValue)
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-clock"></i> 
                                    <strong>Válido até:</strong> @purchase.PixExpiresAt.Value.ToLocalTime().ToString(DateFormatConstants.DisplayDateAndTime)
                                </div>
                            }

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                Após o pagamento, os créditos serão creditados automaticamente em sua conta.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> 
                                QR Code PIX não disponível. Aguarde alguns instantes e recarregue a página.
                            </div>
                        }
                    </div>
                </div>
            }
            else if (purchase.PaymentMethod == KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.BankTransfer)
            {
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-bank"></i> Pagamento via Boleto Bancário</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(purchase.BoletoBarcode))
                        {
                            <p class="lead">Pague o boleto em qualquer banco, lotérica ou internet banking</p>
                            
                            <div class="mb-4 text-center">
                                <div id="barcode" class="d-inline-block p-3 bg-white border rounded"></div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Código de Barras:</label>
                                <div class="input-group">
                                    <input type="text" class="form-control form-control-lg font-monospace" id="boletoBarcode" value="@purchase.BoletoBarcode" readonly>
                                    <button class="btn btn-primary" type="button" onclick="copyBoletoBarcode()">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(purchase.BoletoCode))
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Linha Digitável:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control font-monospace" id="boletoCode" value="@purchase.BoletoCode" readonly>
                                        <button class="btn btn-outline-primary" type="button" onclick="copyBoletoCode()">
                                            <i class="bi bi-clipboard"></i> Copiar
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (purchase.BoletoExpiresAt.HasValue)
                            {
                                <div class="alert alert-warning">
                                    <i class="bi bi-calendar"></i> 
                                    <strong>Vencimento:</strong> @purchase.BoletoExpiresAt.Value.ToLocalTime().ToString(DateFormatConstants.DisplayDateOnly)
                                </div>
                            }

                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                Após o pagamento, os créditos serão creditados automaticamente em até 2 dias úteis.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> 
                                Código de barras não disponível. Aguarde alguns instantes e recarregue a página.
                            </div>
                        }
                    </div>
                </div>
            }
            else if (purchase.PaymentMethod == KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.CreditCard)
            {
                <div class="card mb-4">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="bi bi-credit-card"></i> Pagamento via Cartão de Crédito</h5>
                    </div>
                    <div class="card-body">
                        <button type="button" class="btn btn-primary btn-lg w-100" data-bs-toggle="modal" data-bs-target="#creditCardModal">
                            <i class="bi bi-credit-card"></i> Preencher Dados do Cartão
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Resumo</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Plano:</span>
                        <strong>@purchase.CreditPlan.Name</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Créditos:</span>
                        <strong>@purchase.CreditsReceived</strong>
                    </div>
                    @if (purchase.BonusCredits > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Bônus:</span>
                            <strong>+@purchase.BonusCredits</strong>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Total de Créditos:</span>
                        <strong class="text-success">@(purchase.CreditsReceived + purchase.BonusCredits)</strong>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fs-5"><strong>Total a Pagar:</strong></span>
                        <span class="fs-4 text-primary fw-bold">R$ @purchase.AmountPaid.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para Cartão de Crédito -->
<div class="modal fade" id="creditCardModal" tabindex="-1" aria-labelledby="creditCardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="creditCardModalLabel">Dados do Cartão de Crédito</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="creditCardForm">
                <div class="modal-body">
                    <input type="hidden" id="purchaseId" value="@purchase?.Id" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Número do Cartão <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cardNumber" placeholder="0000 0000 0000 0000" maxlength="19" required>
                            <div class="invalid-feedback">Por favor, informe o número do cartão.</div>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Nome no Cartão <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cardName" placeholder="NOME COMO ESTÁ NO CARTÃO" required>
                            <div class="invalid-feedback">Por favor, informe o nome no cartão.</div>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Validade <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cardExpiry" placeholder="MM/AA" maxlength="5" required>
                            <div class="invalid-feedback">Por favor, informe a validade.</div>
                        </div>
                        
                        <div class="col-md-3">
                            <label class="form-label fw-bold">CVV <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="cardCvv" placeholder="123" maxlength="4" required>
                            <div class="invalid-feedback">Por favor, informe o CVV.</div>
                        </div>
                        
                        <div class="col-12">
                            <hr>
                            <h6 class="fw-bold">Endereço de Cobrança</h6>
                        </div>
                        
                        <div class="col-md-8">
                            <label class="form-label">Rua <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="billingStreet" value="@(client?.Address ?? "")" required>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label">Número <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="billingNumber" value="S/N" required>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label">Bairro <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="billingLocality" value="Não informado" required>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label">CEP <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="billingPostalCode" value="@(client?.ZipCode?.Replace("-", "") ?? "")" maxlength="8" required>
                        </div>
                        
                        <div class="col-md-8">
                            <label class="form-label">Cidade <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="billingCity" value="@(client?.City ?? "")" required>
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label">UF <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="billingState" value="@(client?.State ?? "")" maxlength="2" required>
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label">Parcelas</label>
                            <select class="form-select" id="installments">
                                <option value="1">1x sem juros</option>
                                <option value="2">2x sem juros</option>
                                <option value="3">3x sem juros</option>
                                <option value="4">4x sem juros</option>
                                <option value="5">5x sem juros</option>
                                <option value="6">6x sem juros</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Confirmar Pagamento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    
    <script>
        @if (purchase != null && purchase.PaymentMethod == KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.PIX && !string.IsNullOrEmpty(purchase.PixCode))
        {
            <text>
            // Gerar QR Code PIX
            QRCode.toCanvas(document.getElementById('qrcode'), '@purchase.PixCode', {
                width: 300,
                margin: 2
            }, function (error) {
                if (error) console.error(error);
            });
            </text>
        }

        @if (purchase != null && purchase.PaymentMethod == KlyonHubPlatform.Domain.Core.Enums.PaymentMethod.BankTransfer && !string.IsNullOrEmpty(purchase.BoletoBarcode))
        {
            <text>
            // Gerar código de barras do boleto
            JsBarcode("#barcode", '@purchase.BoletoBarcode', {
                format: "CODE128",
                width: 2,
                height: 80,
                displayValue: true
            });
            </text>
        }

        function copyPixCode() {
            var pixCode = document.getElementById('pixCode');
            pixCode.select();
            document.execCommand('copy');
            showToast('Código PIX copiado!', 'success', 3000);
        }

        function copyBoletoBarcode() {
            var barcode = document.getElementById('boletoBarcode');
            barcode.select();
            document.execCommand('copy');
            showToast('Código de barras copiado!', 'success', 3000);
        }

        function copyBoletoCode() {
            var code = document.getElementById('boletoCode');
            code.select();
            document.execCommand('copy');
            showToast('Linha digitável copiada!', 'success', 3000);
        }

        // Formatação do número do cartão
        document.getElementById('cardNumber')?.addEventListener('input', function(e) {
            var value = e.target.value.replace(/\s/g, '');
            var formatted = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formatted;
        });

        // Formatação da validade
        document.getElementById('cardExpiry')?.addEventListener('input', function(e) {
            var value = e.target.value.replace(/\D/g, '');
            if (value.length >= 2) {
                value = value.substring(0, 2) + '/' + value.substring(2, 4);
            }
            e.target.value = value;
        });

        // Formatação do CEP
        document.getElementById('billingPostalCode')?.addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/\D/g, '');
        });

        // Submissão do formulário de cartão
        document.getElementById('creditCardForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            var form = this;
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            var purchaseId = document.getElementById('purchaseId').value;
            var cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
            var cardName = document.getElementById('cardName').value;
            var cardExpiry = document.getElementById('cardExpiry').value.split('/');
            var cardCvv = document.getElementById('cardCvv').value;

            var card = {
                encrypted: null, // Será preenchido pelo backend se necessário
                securityCode: cardCvv,
                holder: {
                    name: cardName
                },
                // Campos adicionais que podem ser necessários
                number: cardNumber,
                expMonth: cardExpiry[0],
                expYear: '20' + cardExpiry[1]
            };

            var billingAddress = {
                street: document.getElementById('billingStreet').value,
                number: document.getElementById('billingNumber').value,
                locality: document.getElementById('billingLocality').value,
                city: document.getElementById('billingCity').value,
                regionCode: document.getElementById('billingState').value,
                country: 'BRA',
                postalCode: document.getElementById('billingPostalCode').value
            };

            var installments = parseInt(document.getElementById('installments').value);

            try {
                var response = await fetch('@Url.Action("ProcessCreditCardPayment", "Client")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        purchaseId: parseInt(purchaseId),
                        card: card,
                        billingAddress: billingAddress,
                        installments: installments
                    })
                });

                var result = await response.json();
                
                if (result.success) {
                    showToast(result.message, 'success');
                    window.location.reload();
                } else {
                    showToast(result.error || 'Falha no pagamento.', 'error');
                }
            } catch (error) {
                showToast('Erro de conexão: ' + error.message, 'error');
            }
        });
    </script>
}

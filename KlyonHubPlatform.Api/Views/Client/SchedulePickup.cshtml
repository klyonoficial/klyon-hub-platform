@{
    ViewData[ViewDataKeys.Title] = PageTitles.SchedulePickup;
    Layout = LayoutPaths.Layout;
}
@model KlyonHubPlatform.Domain.Entities.Correspondence
@using KlyonHubPlatform.Api.Constants

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-check"></i> Agendar data e hora para retirada</h2>
    <a href="@Url.Action(ActionNames.CorrespondenceDetail, ControllerNames.Client, new { id = Model.Id })" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData[ErrorMessages.TempDataKey] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData[ErrorMessages.TempDataKey]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <p class="mb-2"><strong>Endereço de retirada:</strong> @(Model.Contract?.CoworkingAddress != null ? $"{Model.Contract.CoworkingAddress.Address}, {Model.Contract.CoworkingAddress.Number}" : "-")</p>
        <p class="text-muted small mb-0">@(Model.Contract?.CoworkingAddress?.Coworking?.Name ?? "-")</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" action="@Url.Action(ActionNames.SchedulePickup, ControllerNames.Client, new { id = Model.Id })">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="scheduledDate" class="form-label">Data para retirada</label>
                    <input type="date" class="form-control" id="scheduledDate" name="scheduledDate" required
                           min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-6">
                    <label for="scheduledTime" class="form-label">Horário</label>
                    <input type="time" class="form-control" id="scheduledTime" name="scheduledTime" required value="09:00" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Confirmar agendamento
                    </button>
                    <a href="@Url.Action(ActionNames.CorrespondenceDetail, ControllerNames.Client, new { id = Model.Id })" class="btn btn-secondary">Cancelar</a>
                </div>
            </div>
        </form>
    </div>
</div>

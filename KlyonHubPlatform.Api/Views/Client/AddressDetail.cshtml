@section Scripts {
<script>
(function () {
    /* ---- Galeria swipe / lightbox ---- */
    var slides = document.querySelectorAll('.ad-carousel-slide');
    var thumbs = document.querySelectorAll('#adThumbs button');
    var current = 0;
    var total = slides.length;
    var counter = document.getElementById('adCounter');
    var lightbox = document.getElementById('adLightbox');
    var lightboxImg = document.getElementById('adLightboxImg');
    var transitioning = false;
    var TRANSITION_MS = 750;

    function showSlide(idx) {
        if (total === 0) return;
        var next = (idx + total) % total;
        if (next === current && slides[current] && slides[current].classList.contains('is-active')) return;

        current = next;
        slides.forEach(function (s, i) { s.classList.toggle('is-active', i === current); });
        thumbs.forEach(function (t, i) { t.classList.toggle('active', i === current); });
        if (counter) counter.textContent = (current + 1) + ' / ' + total;
        if (lightbox && lightbox.classList.contains('open') && lightboxImg) {
            lightboxImg.src = slides[current].src;
        }

        transitioning = true;
        setTimeout(function () { transitioning = false; }, TRANSITION_MS);
    }

    if (total > 0) {
        showSlide(0);
        var prevBtn = document.getElementById('adPrev');
        var nextBtn = document.getElementById('adNext');
        if (prevBtn) prevBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (transitioning) return;
            showSlide(current - 1);
        });
        if (nextBtn) nextBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            if (transitioning) return;
            showSlide(current + 1);
        });
        thumbs.forEach(function (t) {
            t.addEventListener('click', function () {
                if (transitioning) return;
                showSlide(parseInt(t.getAttribute('data-idx'), 10));
            });
        });
        var wrap = document.getElementById('adCarousel');
        var startX = 0, startY = 0, tracking = false;
        function onPointerDown(e) {
            tracking = true;
            startX = e.clientX;
            startY = e.clientY;
        }
        function onPointerUp(e) {
            if (!tracking) return;
            tracking = false;
            var dx = e.clientX - startX;
            var dy = e.clientY - startY;
            if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
            if (transitioning) return;
            showSlide(dx < 0 ? current + 1 : current - 1);
        }
        if (wrap) {
            wrap.addEventListener('pointerdown', onPointerDown);
            wrap.addEventListener('pointerup', onPointerUp);
            wrap.addEventListener('pointercancel', function () { tracking = false; });
            wrap.addEventListener('click', function (e) {
                if (e.target.closest('.ad-carousel-nav') || e.target.closest('#adThumbs')) return;
                if (!lightbox || total === 0) return;
                lightboxImg.src = slides[current].src;
                lightbox.classList.add('open');
            });
        }
        function closeLightbox() { if (lightbox) lightbox.classList.remove('open'); }
        var lbClose = document.getElementById('adLightboxClose');
        var lbPrev = document.getElementById('adLightboxPrev');
        var lbNext = document.getElementById('adLightboxNext');
        if (lbClose) lbClose.addEventListener('click', closeLightbox);
        if (lbPrev) lbPrev.addEventListener('click', function (e) {
            e.stopPropagation();
            if (transitioning) return;
            showSlide(current - 1);
        });
        if (lbNext) lbNext.addEventListener('click', function (e) {
            e.stopPropagation();
            if (transitioning) return;
            showSlide(current + 1);
        });
        if (lightbox) lightbox.addEventListener('click', function (e) { if (e.target === lightbox) closeLightbox(); });
        document.addEventListener('keydown', function (e) {
            if (lightbox && lightbox.classList.contains('open')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') showSlide(current - 1);
                if (e.key === 'ArrowRight') showSlide(current + 1);
            }
        });
    }

    /* ---- Comparativo: hint de scroll horizontal no mobile ---- */
    (function () {
        var wrap = document.getElementById('compareWrapper');
        var scroll = document.getElementById('compareScroll');
        if (!wrap || !scroll) return;
        function updateCompareHint() {
            var max = scroll.scrollWidth - scroll.clientWidth;
            wrap.classList.toggle('is-at-end', max <= 4 || scroll.scrollLeft >= max - 4);
        }
        scroll.addEventListener('scroll', updateCompareHint, { passive: true });
        window.addEventListener('resize', updateCompareHint);
        updateCompareHint();
    })();

    /* ---- Modal PDF ---- */
    var pdfModal = document.getElementById('adPdfModal');
    var pdfFrame = document.getElementById('adPdfFrame');
    var pdfTitle = document.getElementById('adPdfTitle');
    var pdfDownload = document.getElementById('adPdfDownload');
    var pdfClose = document.getElementById('adPdfClose');
    function closePdf() {
        if (!pdfModal) return;
        pdfModal.classList.remove('open');
        if (pdfFrame) pdfFrame.src = '';
    }
    document.querySelectorAll('[data-doc-type]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var type = btn.getAttribute('data-doc-type');
            var name = btn.getAttribute('data-doc-name') || 'Documento';
            var url = '@Url.Action(ActionNames.ViewPartnerDocument, ControllerNames.Client, new { coworkingAddressId = Model.Id })' + '&type=' + encodeURIComponent(type);
            if (pdfTitle) pdfTitle.textContent = name;
            if (pdfFrame) pdfFrame.src = url;
            if (pdfDownload) pdfDownload.href = url + '&download=true';
            if (pdfModal) pdfModal.classList.add('open');
        });
    });
    if (pdfClose) pdfClose.addEventListener('click', closePdf);
    if (pdfModal) pdfModal.addEventListener('click', function (e) { if (e.target === pdfModal) closePdf(); });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closePdf();
    });

    /* ---- Guia de Decisão ---- */
    window.showGuide = function (opt) {
        document.getElementById('result-sim').classList.remove('visible');
        document.getElementById('result-nao').classList.remove('visible');
        document.getElementById('btnSim').classList.remove('selected-sim', 'selected-nao');
        document.getElementById('btnNao').classList.remove('selected-sim', 'selected-nao');

        if (opt === 'sim') {
            document.getElementById('result-sim').classList.add('visible');
            document.getElementById('btnSim').classList.add('selected-sim');
        } else {
            document.getElementById('result-nao').classList.add('visible');
            document.getElementById('btnNao').classList.add('selected-nao');
        }

        setTimeout(function () {
            var el = document.getElementById('result-' + opt);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
    };

    window.resetGuide = function () {
        document.getElementById('result-sim').classList.remove('visible');
        document.getElementById('result-nao').classList.remove('visible');
        document.getElementById('btnSim').classList.remove('selected-sim', 'selected-nao');
        document.getElementById('btnNao').classList.remove('selected-sim', 'selected-nao');
        document.getElementById('guideQuestion').scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    /* ---- FAQ ---- */
    window.toggleFaq = function (btn) {
        var item = btn.closest('.ad-faq-item');
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.ad-faq-item.open').forEach(function (el) { el.classList.remove('open'); });
        if (!isOpen) item.classList.add('open');
    };

})();
</script>
}

                    </div>
                </div>
                <div class="ad-price-monthly">
                    <i class="bi bi-tag-fill me-1"></i>Equiv. R$ @monthlyEquivalent.ToString("N2")/mês
                </div>
            </div>

            @if (vacancies > 0 && vacancies <= 5)
            {
                <div class="ad-badge-vacancy">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Apenas @vacancies @(vacancies == 1 ? "vaga disponível" : "vagas disponíveis")
                </div>
            }
            else if (vacancies <= 0)
            {
                <div class="ad-badge-vacancy" style="color:#ef4444; background:rgba(239,68,68,0.1); border-color:rgba(239,68,68,0.25);">
                    <i class="bi bi-x-circle-fill"></i> Sem vagas disponíveis no momento
                </div>
            }
        </div>

        <!-- Carrossel de Fotos -->
        <div>
            <div class="ad-carousel-wrap" id="adCarousel">
                @if (hasPhotos)
                {
                    foreach (var photo in photos)
                    {
                        <img src="@Url.Action(ActionNames.GetPhoto, ControllerNames.Coworking, new { photoId = photo.Id })"
                             alt="Foto do local"
                             class="ad-carousel-slide"
                             style="display:none; width:100%; height:100%; object-fit:cover;"
                             onerror="this.style.display='none'; document.getElementById('adCarouselEmpty').style.display='flex';" />
                    }
                    <div class="ad-carousel-empty" id="adCarouselEmpty" style="display:none;">
                        <i class="bi bi-image"></i>
                        <span>Foto não disponível</span>
                    </div>
                    @if (photos.Count > 1)
                    {
                        <button class="ad-carousel-nav prev" id="adPrev" aria-label="Foto anterior"><i class="bi bi-chevron-left"></i></button>
                        <button class="ad-carousel-nav next" id="adNext" aria-label="Próxima foto"><i class="bi bi-chevron-right"></i></button>
                        <div class="ad-carousel-dots" id="adDots">
                            @for (int i = 0; i < photos.Count; i++)
                            {
                                <button class="ad-carousel-dot @(i == 0 ? "active" : "")" data-idx="@i" aria-label="Foto @(i+1)"></button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="ad-carousel-empty">
                        <i class="bi bi-building"></i>
                        <span>@tradeName</span>
                    </div>
                }
            </div>
        </div>
    </div>


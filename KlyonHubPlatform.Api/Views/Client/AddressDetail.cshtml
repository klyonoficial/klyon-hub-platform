                        <td style="background:rgba(249,115,22,0.02);"><span class="check-no"><i class="bi bi-x-circle-fill"></i> Não se aplica</span></td>
                    </tr>
                    <tr>
                        <td>Suporte Klyon</td>
                        <td style="background:rgba(16,185,129,0.04);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Incluso</span></td>
                        <td style="background:rgba(249,115,22,0.02);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Incluso</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<div class="divider-glow"></div>

<!-- ======================== BENEFÍCIOS ======================== -->

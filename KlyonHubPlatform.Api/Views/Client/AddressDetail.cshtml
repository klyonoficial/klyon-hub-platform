                        <td style="background:rgba(249,115,22,0.02);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Recomendado</span></td>
                    </tr>
                    <tr>
                        <td>Documentos (IPTU, Alvará)</td>

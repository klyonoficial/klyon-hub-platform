@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Domain.Core.Constants
@using KlyonHubPlatform.Domain.Core.Enums
@using KlyonHubPlatform.Application.DTOs.PartnerListing
@{
    ViewData[ViewDataKeys.Title] = "Endereço fiscal e comercial";
    Layout = LayoutPaths.LandingLayout;
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

@{
    var photos = ViewBag.Photos as List<KlyonHubPlatform.Domain.Entities.CoworkingPhoto>
                 ?? new List<KlyonHubPlatform.Domain.Entities.CoworkingPhoto>();
    var trustDocuments = ViewBag.TrustDocuments as List<PartnerTrustDocumentDto>
                         ?? new List<PartnerTrustDocumentDto>();
    var isSolePublished = ViewBag.IsSolePublishedAddress as bool? == true;
    var fiscalOnboardingUrl = ViewBag.FiscalOnboardingUrl as string ?? "#";
    var commercialOnboardingUrl = ViewBag.CommercialOnboardingUrl as string ?? "#";
    var chooseLocationUrl = ViewBag.ChooseLocationUrl as string ?? Url.Action(ActionNames.ChooseLocation, ControllerNames.Client);

    var tradeName = !string.IsNullOrWhiteSpace(Model.Coworking?.TradeName)
        ? Model.Coworking.TradeName
        : Model.Coworking?.Name ?? "Coworking";
    var locationLabel = Model.Location != null
        ? $"{Model.Location.City}/{Model.Location.State}"
        : $"{Model.City}/{Model.State}";
    // Precificação via AddressPricingService no controller (mesma fórmula do preview Parceiro/EditAddress):
    // parcela mensal = (BasePrice × (1 + CardMonthlySurchargePercent/100)) / 12
    var yearlyPrice = ViewBag.YearlyPrice as decimal? ?? Model.BasePrice;
    var monthlyPrice = ViewBag.MonthlyInstallmentPrice as decimal? ?? 0m;
    var fullAddress = $"{Model.Address}, {Model.Number}"
        + (!string.IsNullOrEmpty(Model.Complement) ? $", {Model.Complement}" : "")
        + $", {Model.Neighborhood}, {Model.City}/{Model.State}, CEP {Model.ZipCode}";
    var hasPhotos = photos.Any();
    var description = Model.Coworking?.Description;
}

<style>
html { overflow-x: hidden; }
body { overflow-x: hidden; }
/* ============ Address Detail Landing / Klyon ============ */
.ad-back-btn {
    position: fixed;
    top: 80px;
    left: 24px;
    z-index: 1000;
    background: rgba(5,19,35,0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    color: #94a3b8;
    border-radius: 50px;
    padding: 8px 18px 8px 14px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
}
.ad-back-btn:hover { color: #c69844; border-color: #c69844; }

/* ---- Hero ---- */
.ad-hero {
    padding: 100px 0 0;
    background: linear-gradient(160deg, #051323 0%, #0a1f3a 60%, #051323 100%);
    position: relative;
    overflow: hidden;
}
.ad-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 20%, rgba(45,107,163,0.2), transparent);
    pointer-events: none;
}
.ad-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}
@@media (max-width: 900px) {
    .ad-hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .ad-hero { padding-top: 80px; }
}
.ad-hero-meta {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c69844;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.ad-hero-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: #f8fafc;
    line-height: 1.2;
    margin-bottom: 16px;
}
.ad-hero-address {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 24px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
}
.ad-price-box {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: inline-flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}
.ad-price-primary {
    font-size: 2rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1;
}
.ad-price-primary small { font-size: 0.9rem; color: #94a3b8; font-weight: 400; }
.ad-price-secondary {
    font-size: 0.88rem;
    color: #94a3b8;
    font-weight: 500;
    margin-top: 6px;
}
.ad-mobile-cta-price-primary {
    color: #f8fafc;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
}
.ad-mobile-cta-price-primary small {
    color: #94a3b8;
    font-weight: 400;
    font-size: 0.85rem;
}
.ad-mobile-cta-price-secondary {
    color: #64748b;
    font-size: 0.75rem;
    font-weight: 500;
    margin-top: 2px;
}
.ad-badge-vacancy {
    font-size: 0.8rem;
    color: #fbbf24;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(251,191,36,0.1);
    border: 1px solid rgba(251,191,36,0.25);
    border-radius: 20px;
    width: fit-content;
}

/* Photo carousel */
.ad-carousel-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
    background: #0a1f3a;
    height: 380px;
}
.ad-carousel-stage {
    position: relative;
    height: 100%;
    min-height: 280px;
    overflow: hidden;
}
.ad-carousel-wrap img,
.ad-carousel-slide {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.ad-carousel-slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.03);
    transition:
        opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.75s;
    pointer-events: none;
    z-index: 0;
}
.ad-carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition:
        opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.75s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0s;
    pointer-events: auto;
    z-index: 1;
}
.ad-carousel-empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    gap: 12px;
}
.ad-carousel-empty i { font-size: 4rem; }
.ad-carousel-empty span { font-size: 0.9rem; }
.ad-carousel-dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
}
.ad-carousel-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s;
}
.ad-carousel-dot.active { background: #c69844; width: 20px; border-radius: 4px; }
.ad-carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.5);
    border: none;
    color: #fff;
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
    z-index: 5;
}
.ad-carousel-nav:hover { background: rgba(0,0,0,0.75); }
.ad-carousel-nav.prev { left: 12px; }
.ad-carousel-nav.next { right: 12px; }
.ad-carousel-wrap { touch-action: pan-y; cursor: grab; }
.ad-gallery-desktop { display: grid; grid-template-columns: 1fr 160px; gap: 10px; height: 420px; }
.ad-gallery-thumbs { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
.ad-gallery-thumbs button {
    border: 2px solid transparent; padding: 0; border-radius: 10px; overflow: hidden; height: 76px; background: #0a1f3a;
    min-height: 44px;
}
.ad-gallery-thumbs button.active { border-color: #c69844; }
.ad-gallery-thumbs img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ad-gallery-counter {
    position: absolute; bottom: 16px; right: 16px;
    background: rgba(5,19,35,0.75); color: #fff; border-radius: 20px; padding: 6px 12px; font-size: 0.85rem;
    z-index: 5;
}
.ad-listing-grid {
    max-width: 1200px; margin: 0 auto; padding: 40px 24px 120px;
    display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px;
}
.ad-sticky-card {
    position: sticky; top: 96px;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px; padding: 24px;
}
.ad-mobile-cta {
    display: none;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 1040;
    background: rgba(5,19,35,0.96); border-top: 1px solid rgba(255,255,255,0.1);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    align-items: center; justify-content: space-between; gap: 12px;
}
.ad-trust-menu { display: flex; flex-wrap: wrap; gap: 10px; }
.ad-trust-btn {
    min-height: 44px; border-radius: 12px; padding: 10px 14px;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(198,152,68,0.35);
    color: #e2e8f0; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
}
.ad-trust-btn:hover { color: #c69844; border-color: #c69844; }
.ad-trust-soon { opacity: 0.55; pointer-events: none; }
.ad-lightbox, .ad-pdf-modal {
    display: none; position: fixed; inset: 0; z-index: 2000;
    background: rgba(0,0,0,0.88); align-items: center; justify-content: center; padding: 16px;
}
.ad-lightbox.open, .ad-pdf-modal.open { display: flex; }
.ad-lightbox img { max-width: 100%; max-height: 90vh; object-fit: contain; border-radius: 8px; }
.ad-pdf-frame { width: 100%; height: min(90vh, 860px); background: #111; border: 0; border-radius: 8px; }
.ad-pdf-modal-panel {
    width: min(960px, 100%);
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 100%;
    overflow: hidden;
}
.ad-pdf-modal-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #fff;
}
.ad-pdf-modal-title {
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.3;
}
.ad-pdf-modal-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}
.ad-pdf-download {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
}
.ad-pdf-modal-close {
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(255,255,255,0.15);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
}
.ad-pdf-modal-close:hover { background: rgba(255,255,255,0.25); }
.ad-modal-close {
    position: absolute; top: 16px; right: 16px; min-width: 44px; min-height: 44px;
    border-radius: 50%; border: 0; background: rgba(255,255,255,0.15); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
}
.ad-pdf-modal {
    overflow-x: hidden;
    padding-top: calc(16px + env(safe-area-inset-top, 0px));
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    padding-left: calc(16px + env(safe-area-inset-left, 0px));
    padding-right: calc(16px + env(safe-area-inset-right, 0px));
}
@@media (max-width: 480px) {
    .ad-pdf-modal-header {
        flex-direction: column;
        align-items: stretch;
    }
    .ad-pdf-modal-actions {
        width: 100%;
        justify-content: flex-end;
    }
}
@@media (max-width: 1024px) {
    .ad-listing-grid { grid-template-columns: 1fr; padding-bottom: 140px; }
    .ad-sticky-card { display: none; }
    .ad-mobile-cta { display: flex; }
    #fiscal-chat-toggle { bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important; }
    #fiscal-chat-window { bottom: calc(148px + env(safe-area-inset-bottom, 0px)) !important; }
    .ad-gallery-desktop { grid-template-columns: 1fr; height: 62vh; min-height: 280px; }
    .ad-gallery-thumbs { display: none; }
    .ad-hero-inner { grid-template-columns: 1fr; }
    .ad-final-cta { padding-bottom: 24px; }
    .ad-final-cta .ad-section { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)); }
}

/* CTA bar */
.ad-cta-bar {
    background: rgba(255,255,255,0.04);
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 28px 0;
    margin-top: 60px;
}
.ad-cta-bar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
}
.ad-cta-bar-text { color: #94a3b8; font-size: 0.95rem; }
.ad-cta-bar-text strong { color: #f8fafc; }
.ad-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }

/* ---- Section base ---- */
.ad-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 24px;
}
.ad-section-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a4d7a;
    margin-bottom: 12px;
}
.ad-section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 16px;
    line-height: 1.25;
}
.ad-section-subtitle {
    color: #94a3b8;
    font-size: 1.05rem;
    max-width: 600px;
    margin-bottom: 48px;
    line-height: 1.7;
}

/* ---- Decision Guide ---- */
.ad-guide {
    background: linear-gradient(160deg, #0a1f3a 0%, #051323 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.ad-guide-question-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 40px 48px;
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
}
.ad-guide-question-icon {
    font-size: 3rem;
    margin-bottom: 16px;
}
.ad-guide-question-text {
    font-size: 1.4rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 8px;
}
.ad-guide-question-sub {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 28px;
}
.ad-guide-btn-group { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.ad-guide-btn {
    padding: 14px 32px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    border: 2px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.05);
    color: #f8fafc;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    gap: 10px;
}
.ad-guide-btn:hover { border-color: #1a4d7a; background: rgba(26,77,122,0.2); }
.ad-guide-btn.selected-sim { border-color: #f97316; background: rgba(249,115,22,0.15); color: #fb923c; }
.ad-guide-btn.selected-nao { border-color: #10b981; background: rgba(16,185,129,0.15); color: #34d399; }

/* Result cards */
.ad-result {
    display: none;
    animation: adFadeIn 0.4s ease;
}
.ad-result.visible { display: block; }
@@keyframes adFadeIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

.ad-result-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
@@media (max-width: 768px) { .ad-result-cards { grid-template-columns: 1fr; } }

.ad-result-card {
    border-radius: 20px;
    padding: 32px;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}
.ad-result-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0.06;
    pointer-events: none;
}
.ad-result-card.recommended {
    border-color: rgba(16,185,129,0.5);
    background: rgba(16,185,129,0.06);
}
.ad-result-card.recommended::before { background: #10b981; }
.ad-result-card.not-recommended {
    border-color: rgba(249,115,22,0.3);
    background: rgba(249,115,22,0.04);
}
.ad-result-card.not-recommended::before { background: #f97316; }
.ad-result-card.evaluate {
    border-color: rgba(198,152,68,0.45);
    background: rgba(198,152,68,0.06);
}
.ad-result-card.evaluate::before { background: #c69844; }
.ad-result-card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.05em;
}
.badge-recommended { background: rgba(16,185,129,0.2); color: #34d399; border: 1px solid rgba(16,185,129,0.3); }
.badge-not-recommended { background: rgba(249,115,22,0.15); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
.badge-evaluate { background: rgba(198,152,68,0.18); color: #e8c57a; border: 1px solid rgba(198,152,68,0.4); }
.ad-result-card-list li .hint { color: #c69844; flex-shrink: 0; margin-top: 1px; }
.ad-ideal-for {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
}
.ad-ideal-chip {
    font-size: 0.78rem;
    font-weight: 600;
    color: #cbd5e1;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 999px;
    padding: 6px 12px;
}
.ad-result-card-icon { font-size: 2.5rem; margin-bottom: 12px; }
.ad-result-card-title { font-size: 1.3rem; font-weight: 700; color: #f8fafc; margin-bottom: 8px; }
.ad-result-card-desc { color: #94a3b8; font-size: 0.9rem; margin-bottom: 20px; line-height: 1.6; }
.ad-result-card-list {
    list-style: none;
    padding: 0; margin: 0 0 24px;
    display: flex; flex-direction: column; gap: 8px;
}
.ad-result-card-list li {
    font-size: 0.88rem;
    color: #cbd5e1;
    display: flex;
    align-items: flex-start;
    gap: 8px;
}
.ad-result-card-list li .check { color: #10b981; flex-shrink: 0; margin-top: 1px; }
.ad-result-card-list li .cross { color: #ef4444; flex-shrink: 0; margin-top: 1px; }

/* ---- Comparison Table ---- */
.ad-compare {
    background: #051323;
    border-top: 1px solid rgba(255,255,255,0.06);
}
.ad-compare-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.92rem;
}
.ad-compare-table th {
    padding: 20px 24px;
    text-align: left;
    font-weight: 700;
    font-size: 0.85rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 2px solid rgba(255,255,255,0.08);
}
.ad-compare-table th.col-fiscal { color: #10b981; }
.ad-compare-table th.col-comercial { color: #f97316; }
.ad-compare-table td {
    padding: 16px 24px;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    vertical-align: middle;
}
.ad-compare-table td:first-child { color: #94a3b8; font-size: 0.88rem; }
.ad-compare-table tr:hover td { background: rgba(255,255,255,0.02); }
.ad-compare-table .check-yes { color: #10b981; font-weight: 600; }
.ad-compare-table .check-no { color: #ef4444; }
.ad-compare-table .check-partial { color: #fbbf24; }
.ad-compare-header {
    text-align: center;
    padding: 20px 24px;
    border-radius: 12px 12px 0 0;
}
.ad-compare-header.fiscal-head { background: rgba(16,185,129,0.1); color: #34d399; }
.ad-compare-header.comercial-head { background: rgba(249,115,22,0.08); color: #fb923c; }
.ad-compare-header-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }
.ad-compare-header-sub { font-size: 0.8rem; opacity: 0.8; }
.compare-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
}
.compare-scroll {
    width: 100%;
    overflow-x: visible;
}
.compare-scroll-hint {
    display: none;
}
@@media (max-width: 768px) {
    .compare-scroll-hint {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 12px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        color: #94a3b8;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.02em;
    }
    .compare-scroll-hint i {
        color: #c69844;
        animation: compare-hint-nudge 1.6s ease-in-out infinite;
    }
    @@keyframes compare-hint-nudge {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(4px); }
    }
    .compare-wrapper {
        overflow: hidden;
    }
    .compare-wrapper::after {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 48px;
        background: linear-gradient(90deg, transparent, #051323 85%);
        pointer-events: none;
        z-index: 3;
        opacity: 1;
        transition: opacity 0.25s ease;
    }
    .compare-wrapper.is-at-end::after {
        opacity: 0;
    }
    .compare-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        overscroll-behavior-x: contain;
        scrollbar-width: thin;
        scrollbar-color: rgba(198,152,68,0.5) rgba(255,255,255,0.04);
    }
    .compare-scroll::-webkit-scrollbar {
        height: 6px;
    }
    .compare-scroll::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.04);
    }
    .compare-scroll::-webkit-scrollbar-thumb {
        background: rgba(198,152,68,0.45);
        border-radius: 999px;
    }
    .ad-compare-table {
        min-width: 640px;
        width: max-content;
    }
    .ad-compare-table th,
    .ad-compare-table td {
        padding: 14px 16px;
        white-space: nowrap;
    }
    .ad-compare-table td:first-child,
    .ad-compare-table th:first-child {
        white-space: normal;
        min-width: 140px;
        max-width: 160px;
        position: sticky;
        left: 0;
        z-index: 2;
        background: #0a1628 !important;
        box-shadow: 6px 0 14px rgba(0,0,0,0.28);
    }
    .ad-compare-table th:first-child {
        background: #0d1a2e !important;
    }
    .ad-compare-table tbody tr:hover td:first-child {
        background: #0f1f35 !important;
    }
    .ad-compare-header {
        padding: 14px 12px;
    }
    .ad-compare-header-title { font-size: 0.95rem; }
    .ad-compare-header-sub { font-size: 0.72rem; }
}

/* ---- Benefits ---- */
.ad-benefits {
    background: linear-gradient(160deg, #0a1f3a 0%, #051323 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
}
.ad-benefits-grid {

                <span style="font-size:0.8rem; opacity:0.8; font-weight:400;">— Para minha imagem</span>
            </a>
        </div>
        <div style="margin-top:24px;">
            <a href="@chooseLocationUrl" class="btn-ad-outline">
                <i class="bi bi-arrow-left"></i> Ver outros endereços
            </a>
        </div>
    </div>
</section>

@section Scripts {
<script>
(function () {
    /* ---- Carrossel ---- */
    var slides = document.querySelectorAll('.ad-carousel-slide');
    var dots = document.querySelectorAll('.ad-carousel-dot');
    var current = 0;
    var total = slides.length;
    var autoTimer = null;

    function showSlide(idx) {
        if (total === 0) return;
        slides.forEach(function (s) { s.style.display = 'none'; });
        dots.forEach(function (d) { d.classList.remove('active'); });
        current = (idx + total) % total;
        slides[current].style.display = 'block';
        if (dots[current]) dots[current].classList.add('active');
    }

    function startAuto() {
        if (total <= 1) return;
        autoTimer = setInterval(function () { showSlide(current + 1); }, 4000);
    }

    function resetAuto() {
        clearInterval(autoTimer);
        startAuto();
    }

    if (total > 0) {
        showSlide(0);
        startAuto();

        var prevBtn = document.getElementById('adPrev');
        var nextBtn = document.getElementById('adNext');
        if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(current - 1); resetAuto(); });
        if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(current + 1); resetAuto(); });

        dots.forEach(function (d) {
            d.addEventListener('click', function () {
                showSlide(parseInt(d.getAttribute('data-idx')));
                resetAuto();
            });
        });
    }

    /* ---- Guia de Decisão ---- */
    window.showGuide = function (opt) {
        document.getElementById('result-sim').classList.remove('visible');
        document.getElementById('result-nao').classList.remove('visible');
        document.getElementById('btnSim').classList.remove('selected-sim', 'selected-nao');
        document.getElementById('btnNao').classList.remove('selected-sim', 'selected-nao');

        if (opt === 'sim') {
            document.getElementById('result-sim').classList.add('visible');
            document.getElementById('btnSim').classList.add('selected-sim');
        } else {
            document.getElementById('result-nao').classList.add('visible');
            document.getElementById('btnNao').classList.add('selected-nao');
        }

        setTimeout(function () {
            var el = document.getElementById('result-' + opt);
            if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
    };

    window.resetGuide = function () {
        document.getElementById('result-sim').classList.remove('visible');
        document.getElementById('result-nao').classList.remove('visible');
        document.getElementById('btnSim').classList.remove('selected-sim', 'selected-nao');
        document.getElementById('btnNao').classList.remove('selected-sim', 'selected-nao');
        document.getElementById('guideQuestion').scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    /* ---- FAQ ---- */
    window.toggleFaq = function (btn) {
        var item = btn.closest('.ad-faq-item');
        var isOpen = item.classList.contains('open');
        document.querySelectorAll('.ad-faq-item.open').forEach(function (el) { el.classList.remove('open'); });
        if (!isOpen) item.classList.add('open');
    };

    /* ---- Loading em links de navegação ---- */
    document.querySelectorAll('a[href]').forEach(function (link) {
        var href = (link.getAttribute('href') || '').trim();
        if (!href || href === '#' || href.startsWith('javascript:')) return;
        link.addEventListener('click', function (e) {
            if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return; // abre nova aba
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                window.KlyonLoading.show();
            }
        });
    });
})();
</script>
}

<section class="ad-hero">
    <div class="ad-hero-inner" style="grid-template-columns: 1fr; gap: 24px;">
        <div class="ad-carousel-wrap" id="adCarousel" style="height: auto;">
            @if (hasPhotos)
            {
                <div class="ad-gallery-desktop">
                    <div class="ad-carousel-stage">
                        @for (var i = 0; i < photos.Count; i++)
                        {
                            var photo = photos[i];
                            <img src="@Url.Action(ActionNames.GetPhoto, ControllerNames.Coworking, new { photoId = photo.Id })"
                                 alt="Foto @(i + 1) de @tradeName"
                                 class="ad-carousel-slide@(i == 0 ? " is-active" : "")"
                                 data-idx="@i"
                                 onerror="this.style.opacity='0';" />
                        }
                        @if (photos.Count > 1)
                        {
                            <button type="button" class="ad-carousel-nav prev" id="adPrev" aria-label="Foto anterior"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="ad-carousel-nav next" id="adNext" aria-label="Próxima foto"><i class="bi bi-chevron-right"></i></button>
                            <div class="ad-gallery-counter" id="adCounter">1 / @photos.Count</div>
                        }
                    </div>
                    @if (photos.Count > 1)
                    {
                        <div class="ad-gallery-thumbs" id="adThumbs">
                            @for (int i = 0; i < photos.Count; i++)
                            {
                                <button type="button" class="@(i == 0 ? "active" : "")" data-idx="@i" aria-label="Foto @(i+1)">
                                    <img src="@Url.Action(ActionNames.GetPhoto, ControllerNames.Coworking, new { photoId = photos[i].Id })" alt="" onerror="this.style.opacity='0';" />
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ad-carousel-empty" style="min-height:280px;">
                    <i class="bi bi-building"></i>
                    <span>@tradeName</span>
                </div>
            }
        </div>
    </div>
</section>


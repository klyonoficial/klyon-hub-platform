@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Domain.Core.Constants
@using KlyonHubPlatform.Domain.Core.Enums
@using KlyonHubPlatform.Application.DTOs.PartnerListing
@{
    ViewData[ViewDataKeys.Title] = "Endereço fiscal";
    Layout = LayoutPaths.LandingLayout;
}

@model KlyonHubPlatform.Domain.Entities.CoworkingAddress

@{
    var photos = ViewBag.Photos as List<KlyonHubPlatform.Domain.Entities.CoworkingPhoto>
                 ?? new List<KlyonHubPlatform.Domain.Entities.CoworkingPhoto>();
    var trustDocuments = ViewBag.TrustDocuments as List<PartnerTrustDocumentDto>
                         ?? new List<PartnerTrustDocumentDto>();
    var isSolePublished = ViewBag.IsSolePublishedAddress as bool? == true;
    var fiscalOnboardingUrl = ViewBag.FiscalOnboardingUrl as string ?? "#";
    var commercialOnboardingUrl = ViewBag.CommercialOnboardingUrl as string ?? "#";
    var chooseLocationUrl = ViewBag.ChooseLocationUrl as string ?? Url.Action(ActionNames.ChooseLocation, ControllerNames.Client);

    var tradeName = !string.IsNullOrWhiteSpace(Model.Coworking?.TradeName)
        ? Model.Coworking.TradeName
        : Model.Coworking?.Name ?? "Coworking";
    var locationLabel = Model.Location != null
        ? $"{Model.Location.City}/{Model.Location.State}"
        : $"{Model.City}/{Model.State}";
    var yearlyPrice = Model.BasePrice;
    var fullAddress = $"{Model.Address}, {Model.Number}"
        + (!string.IsNullOrEmpty(Model.Complement) ? $", {Model.Complement}" : "")
        + $" — {Model.Neighborhood}, {Model.City}/{Model.State} — CEP {Model.ZipCode}";
    var hasPhotos = photos.Any();
    var description = Model.Coworking?.Description;
}

<style>
html { overflow-x: hidden; }
body { overflow-x: hidden; }
/* ============ Address Detail Landing — Klyon ============ */
.ad-back-btn {
    position: fixed;
    top: 80px;
    left: 24px;
    z-index: 1000;
    background: rgba(5,19,35,0.85);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    color: #94a3b8;
    border-radius: 50px;
    padding: 8px 18px 8px 14px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
}
.ad-back-btn:hover { color: #c69844; border-color: #c69844; }

/* ---- Hero ---- */
.ad-hero {
    padding: 100px 0 0;
    background: linear-gradient(160deg, #051323 0%, #0a1f3a 60%, #051323 100%);
    position: relative;
    overflow: hidden;
}
.ad-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 20%, rgba(45,107,163,0.2), transparent);
    pointer-events: none;
}
.ad-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
}
@@media (max-width: 900px) {
    .ad-hero-inner { grid-template-columns: 1fr; gap: 40px; }
    .ad-hero { padding-top: 80px; }
}
.ad-hero-meta {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c69844;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.ad-hero-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 700;
    color: #f8fafc;
    line-height: 1.2;
    margin-bottom: 16px;
}
.ad-hero-address {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 24px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
}
.ad-price-box {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 20px 24px;
    margin-bottom: 24px;
    display: inline-flex;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
}
.ad-price-yearly {
    font-size: 2rem;
    font-weight: 800;
    color: #f8fafc;
    line-height: 1;
}
.ad-price-yearly small { font-size: 0.9rem; color: #94a3b8; font-weight: 400; }
.ad-price-monthly {
    font-size: 0.9rem;
    color: #10b981;
    font-weight: 600;
    padding: 4px 10px;
    background: rgba(16,185,129,0.12);
    border-radius: 20px;
}
.ad-badge-vacancy {
    font-size: 0.8rem;
    color: #fbbf24;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    background: rgba(251,191,36,0.1);
    border: 1px solid rgba(251,191,36,0.25);
    border-radius: 20px;
    width: fit-content;
}

/* Photo carousel */
.ad-carousel-wrap {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5);
    background: #0a1f3a;
    height: 380px;
}
.ad-carousel-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.ad-carousel-empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    gap: 12px;
}
.ad-carousel-empty i { font-size: 4rem; }
.ad-carousel-empty span { font-size: 0.9rem; }
.ad-carousel-dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
}
.ad-carousel-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s;
}
.ad-carousel-dot.active { background: #c69844; width: 20px; border-radius: 4px; }
.ad-carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.5);
    border: none;
    color: #fff;
    width: 40px; height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
}
.ad-carousel-nav:hover { background: rgba(0,0,0,0.75); }
.ad-carousel-nav.prev { left: 12px; }
.ad-carousel-nav.next { right: 12px; }
.ad-carousel-wrap { touch-action: pan-y; cursor: grab; }
.ad-gallery-desktop { display: grid; grid-template-columns: 1fr 160px; gap: 10px; height: 420px; }
.ad-gallery-thumbs { display: flex; flex-direction: column; gap: 8px; overflow-y: auto; }
.ad-gallery-thumbs button {
    border: 2px solid transparent; padding: 0; border-radius: 10px; overflow: hidden; height: 76px; background: #0a1f3a;
    min-height: 44px;
}
.ad-gallery-thumbs button.active { border-color: #c69844; }
.ad-gallery-thumbs img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ad-gallery-counter {
    position: absolute; bottom: 16px; right: 16px;
    background: rgba(5,19,35,0.75); color: #fff; border-radius: 20px; padding: 6px 12px; font-size: 0.85rem;
}
.ad-listing-grid {
    max-width: 1200px; margin: 0 auto; padding: 40px 24px 120px;
    display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px;
}
.ad-sticky-card {
    position: sticky; top: 96px;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px; padding: 24px;
}
.ad-mobile-cta {
    display: none;
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 1040;
    background: rgba(5,19,35,0.96); border-top: 1px solid rgba(255,255,255,0.1);
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    align-items: center; justify-content: space-between; gap: 12px;
}
.ad-trust-menu { display: flex; flex-wrap: wrap; gap: 10px; }
.ad-trust-btn {
    min-height: 44px; border-radius: 12px; padding: 10px 14px;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(198,152,68,0.35);
    color: #e2e8f0; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
}
.ad-trust-btn:hover { color: #c69844; border-color: #c69844; }
.ad-trust-soon { opacity: 0.55; pointer-events: none; }
.ad-lightbox, .ad-pdf-modal {
    display: none; position: fixed; inset: 0; z-index: 2000;
    background: rgba(0,0,0,0.88); align-items: center; justify-content: center; padding: 16px;
}
.ad-lightbox.open, .ad-pdf-modal.open { display: flex; }
.ad-lightbox img { max-width: 100%; max-height: 90vh; object-fit: contain; border-radius: 8px; }
.ad-pdf-frame { width: 100%; height: min(90vh, 860px); background: #111; border: 0; border-radius: 8px; }
.ad-pdf-modal-panel {
    width: min(960px, 100%);
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 100%;
    overflow: hidden;
}
.ad-pdf-modal-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #fff;
}
.ad-pdf-modal-title {
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.3;
}
.ad-pdf-modal-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}
.ad-pdf-download {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
}
.ad-pdf-modal-close {
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgba(255,255,255,0.15);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
}
.ad-pdf-modal-close:hover { background: rgba(255,255,255,0.25); }
.ad-modal-close {
    position: absolute; top: 16px; right: 16px; min-width: 44px; min-height: 44px;
    border-radius: 50%; border: 0; background: rgba(255,255,255,0.15); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
}
.ad-pdf-modal {
    overflow-x: hidden;
    padding-top: calc(16px + env(safe-area-inset-top, 0px));
    padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    padding-left: calc(16px + env(safe-area-inset-left, 0px));
    padding-right: calc(16px + env(safe-area-inset-right, 0px));
}
@@media (max-width: 480px) {
    .ad-pdf-modal-header {
        flex-direction: column;
        align-items: stretch;
    }
    .ad-pdf-modal-actions {
        width: 100%;
        justify-content: flex-end;
    }
}
@@media (max-width: 1024px) {
    .ad-listing-grid { grid-template-columns: 1fr; padding-bottom: 140px; }
    .ad-sticky-card { display: none; }
    .ad-mobile-cta { display: flex; }
    #fiscal-chat-toggle { bottom: calc(80px + env(safe-area-inset-bottom, 0px)) !important; }
    #fiscal-chat-window { bottom: calc(148px + env(safe-area-inset-bottom, 0px)) !important; }
    .ad-gallery-desktop { grid-template-columns: 1fr; height: 62vh; min-height: 280px; }
    .ad-gallery-thumbs { display: none; }
    .ad-hero-inner { grid-template-columns: 1fr; }
    .ad-final-cta { padding-bottom: 24px; }
    .ad-final-cta .ad-section { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)); }
}

/* CTA bar */
.ad-cta-bar {
    background: rgba(255,255,255,0.04);
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 28px 0;
    margin-top: 60px;
}
.ad-cta-bar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
}
.ad-cta-bar-text { color: #94a3b8; font-size: 0.95rem; }
.ad-cta-bar-text strong { color: #f8fafc; }
.ad-cta-btns { display: flex; gap: 12px; flex-wrap: wrap; }

/* ---- Section base ---- */
.ad-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 24px;
}
.ad-section-label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a4d7a;
    margin-bottom: 12px;
}
.ad-section-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 16px;
    line-height: 1.25;
}
.ad-section-subtitle {
    color: #94a3b8;
    font-size: 1.05rem;
    max-width: 600px;
    margin-bottom: 48px;
    line-height: 1.7;
}

/* ---- Decision Guide ---- */
.ad-guide {
    background: linear-gradient(160deg, #0a1f3a 0%, #051323 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.ad-guide-question-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 40px 48px;
    text-align: center;
    max-width: 640px;
    margin: 0 auto 48px;
}
.ad-guide-question-icon {
    font-size: 3rem;
    margin-bottom: 16px;
}
.ad-guide-question-text {
    font-size: 1.4rem;
    font-weight: 700;
    color: #f8fafc;
    margin-bottom: 8px;
}
.ad-guide-question-sub {
    color: #94a3b8;
    font-size: 0.95rem;
    margin-bottom: 28px;
}
.ad-guide-btn-group { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.ad-guide-btn {
    padding: 14px 32px;
    border-radius: 50px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    border: 2px solid rgba(255,255,255,0.15);
    background: rgba(255,255,255,0.05);
    color: #f8fafc;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    gap: 10px;
}
.ad-guide-btn:hover { border-color: #1a4d7a; background: rgba(26,77,122,0.2); }
.ad-guide-btn.selected-sim { border-color: #f97316; background: rgba(249,115,22,0.15); color: #fb923c; }
.ad-guide-btn.selected-nao { border-color: #10b981; background: rgba(16,185,129,0.15); color: #34d399; }

/* Result cards */
.ad-result {
    display: none;
    animation: adFadeIn 0.4s ease;
}
.ad-result.visible { display: block; }
@@keyframes adFadeIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

.ad-result-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
@@media (max-width: 768px) { .ad-result-cards { grid-template-columns: 1fr; } }

.ad-result-card {
    border-radius: 20px;
    padding: 32px;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}
.ad-result-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0.06;
    pointer-events: none;
}
.ad-result-card.recommended {
    border-color: rgba(16,185,129,0.5);
    background: rgba(16,185,129,0.06);
}
.ad-result-card.recommended::before { background: #10b981; }
.ad-result-card.not-recommended {
    border-color: rgba(249,115,22,0.3);
    background: rgba(249,115,22,0.04);
}
.ad-result-card.not-recommended::before { background: #f97316; }
.ad-result-card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
    letter-spacing: 0.05em;
}
.badge-recommended { background: rgba(16,185,129,0.2); color: #34d399; border: 1px solid rgba(16,185,129,0.3); }
.badge-not-recommended { background: rgba(249,115,22,0.15); color: #fb923c; border: 1px solid rgba(249,115,22,0.3); }
.ad-result-card-icon { font-size: 2.5rem; margin-bottom: 12px; }
.ad-result-card-title { font-size: 1.3rem; font-weight: 700; color: #f8fafc; margin-bottom: 8px; }
.ad-result-card-desc { color: #94a3b8; font-size: 0.9rem; margin-bottom: 20px; line-height: 1.6; }
.ad-result-card-list {
    list-style: none;
    padding: 0; margin: 0 0 24px;
    display: flex; flex-direction: column; gap: 8px;
}
.ad-result-card-list li {
    font-size: 0.88rem;
    color: #cbd5e1;
    display: flex;
    align-items: flex-start;
    gap: 8px;
}
.ad-result-card-list li .check { color: #10b981; flex-shrink: 0; margin-top: 1px; }
.ad-result-card-list li .cross { color: #ef4444; flex-shrink: 0; margin-top: 1px; }

/* ---- Comparison Table ---- */
.ad-compare {
    background: #051323;
    border-top: 1px solid rgba(255,255,255,0.06);
}
.ad-compare-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.92rem;
}
.ad-compare-table th {
    padding: 20px 24px;
    text-align: left;
    font-weight: 700;
    font-size: 0.85rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 2px solid rgba(255,255,255,0.08);
}
.ad-compare-table th.col-fiscal { color: #10b981; }
.ad-compare-table th.col-comercial { color: #f97316; }
.ad-compare-table td {
    padding: 16px 24px;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    vertical-align: middle;
}
.ad-compare-table td:first-child { color: #94a3b8; font-size: 0.88rem; }
.ad-compare-table tr:hover td { background: rgba(255,255,255,0.02); }
.ad-compare-table .check-yes { color: #10b981; font-weight: 600; }
.ad-compare-table .check-no { color: #ef4444; }
.ad-compare-table .check-partial { color: #fbbf24; }
.ad-compare-header {
    text-align: center;
    padding: 20px 24px;
    border-radius: 12px 12px 0 0;
}
.ad-compare-header.fiscal-head { background: rgba(16,185,129,0.1); color: #34d399; }
.ad-compare-header.comercial-head { background: rgba(249,115,22,0.08); color: #fb923c; }
.ad-compare-header-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 4px; }
.ad-compare-header-sub { font-size: 0.8rem; opacity: 0.8; }
.compare-wrapper {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
}

/* ---- Benefits ---- */
.ad-benefits {
    background: linear-gradient(160deg, #0a1f3a 0%, #051323 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
}
.ad-benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}
.ad-benefit-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 24px;
    transition: all 0.3s ease;
}
.ad-benefit-card:hover {
    border-color: rgba(198,152,68,0.3);
    background: rgba(198,152,68,0.05);
    transform: translateY(-2px);
}
.ad-benefit-icon {
    font-size: 1.8rem;
    margin-bottom: 12px;
    display: block;
}
.ad-benefit-title { font-size: 0.95rem; font-weight: 700; color: #f8fafc; margin-bottom: 6px; }
.ad-benefit-desc { font-size: 0.83rem; color: #64748b; line-height: 1.6; }

/* ---- Matrix/Filial Scenario ---- */
.ad-scenario {
    background: #051323;
    border-top: 1px solid rgba(255,255,255,0.06);
}
.ad-scenario-box {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px;
    padding: 40px;
    max-width: 800px;
    margin: 0 auto;
}
.ad-scenario-text {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.75;
    text-align: center;
    margin-bottom: 36px;
}
.ad-scenario-text em { color: #f8fafc; font-style: normal; font-weight: 600; }
.ad-scenario-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
}
.ad-scenario-node {
    background: rgba(255,255,255,0.06);
    border-radius: 16px;
    padding: 20px 28px;
    text-align: center;
    min-width: 200px;
    border: 1px solid rgba(255,255,255,0.1);
    position: relative;
}
.ad-scenario-node.node-fiscal { border-color: rgba(16,185,129,0.4); background: rgba(16,185,129,0.07); }
.ad-scenario-node.node-filial { border-color: rgba(249,115,22,0.4); background: rgba(249,115,22,0.07); }
.ad-scenario-node-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
}
.node-fiscal .ad-scenario-node-label { color: #34d399; }
.node-filial .ad-scenario-node-label { color: #fb923c; }
.ad-scenario-node-cnpj {
    font-size: 0.85rem;
    font-family: monospace;
    color: #94a3b8;
    margin-bottom: 6px;
}
.ad-scenario-node-desc { font-size: 0.82rem; color: #64748b; }
.ad-scenario-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20px;
    gap: 4px;
    color: #334155;
}
.ad-scenario-arrow i { font-size: 1.5rem; }
.ad-scenario-arrow span { font-size: 0.7rem; color: #475569; }

/* ---- FAQ ---- */
.ad-faq {
    background: linear-gradient(160deg, #0a1f3a 0%, #051323 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
}
.ad-faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 820px; }
.ad-faq-item {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s;
}
.ad-faq-item:hover { border-color: rgba(198,152,68,0.25); }
.ad-faq-q {
    width: 100%;
    background: none;
    border: none;
    color: #f8fafc;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 18px 24px;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}
.ad-faq-q .faq-icon { flex-shrink: 0; color: #94a3b8; font-size: 1.1rem; transition: transform 0.25s; }
.ad-faq-item.open .faq-icon { transform: rotate(45deg); color: #c69844; }
.ad-faq-a { display: none; padding: 0 24px 18px; color: #94a3b8; font-size: 0.9rem; line-height: 1.75; }
.ad-faq-item.open .ad-faq-a { display: block; }

/* ---- Final CTA ---- */
.ad-final-cta {
    background: linear-gradient(135deg, #0a1f3a 0%, #051323 50%, #0a1f3a 100%);
    border-top: 1px solid rgba(255,255,255,0.06);
    text-align: center;
}
.ad-final-cta-subtitle {
    color: #94a3b8;
    font-size: 1rem;
    max-width: 560px;
    margin: 0 auto 36px;
    line-height: 1.75;
}
.ad-final-btns {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
}

/* ---- Buttons ---- */
.btn-ad-fiscal {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    background: linear-gradient(135deg, #1a4d7a 0%, #2d6ba3 100%);
    color: #fff;
    border: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(26,77,122,0.4);
    cursor: pointer;
}
.btn-ad-fiscal:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(26,77,122,0.5); color: #fff; }

.ad-cta-secondary-link {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
}
.ad-cta-secondary-link:hover { color: #c69844; }
.ad-cta-secondary-link strong { color: #e2e8f0; font-weight: 600; }

.btn-ad-comercial {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    background: rgba(255,255,255,0.06);
    color: #f8fafc;
    border: 2px solid rgba(255,255,255,0.15);
    transition: all 0.25s ease;
    cursor: pointer;
}
.btn-ad-comercial:hover {
    background: rgba(249,115,22,0.12);
    border-color: rgba(249,115,22,0.5);
    color: #fb923c;
    transform: translateY(-2px);
}

.btn-ad-outline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    background: transparent;
    color: #94a3b8;
    border: 1px solid rgba(255,255,255,0.12);
    transition: all 0.25s ease;
    cursor: pointer;
}
.btn-ad-outline:hover { border-color: rgba(255,255,255,0.3); color: #f8fafc; }

.divider-glow {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(26,77,122,0.5), rgba(198,152,68,0.3), transparent);
    margin: 0;
}
</style>

@if (!isSolePublished)
{
    <a href="@chooseLocationUrl" class="ad-back-btn">
        <i class="bi bi-arrow-left"></i> Voltar à lista
    </a>
}

<section class="ad-hero">
    <div class="ad-hero-inner" style="grid-template-columns: 1fr; gap: 24px;">
        <div class="ad-carousel-wrap" id="adCarousel" style="height: auto;">
            @if (hasPhotos)
            {
                <div class="ad-gallery-desktop">
                    <div style="position:relative; height:100%; min-height:280px;">
                        @for (var i = 0; i < photos.Count; i++)
                        {
                            var photo = photos[i];
                            <img src="@Url.Action(ActionNames.GetPhoto, ControllerNames.Coworking, new { photoId = photo.Id })"
                                 alt="Foto @(i + 1) de @tradeName"
                                 class="ad-carousel-slide"
                                 data-idx="@i"
                                 style="display:@(i == 0 ? "block" : "none"); width:100%; height:100%; object-fit:cover;"
                                 onerror="this.style.opacity='0';" />
                        }
                        @if (photos.Count > 1)
                        {
                            <button type="button" class="ad-carousel-nav prev" id="adPrev" aria-label="Foto anterior"><i class="bi bi-chevron-left"></i></button>
                            <button type="button" class="ad-carousel-nav next" id="adNext" aria-label="Próxima foto"><i class="bi bi-chevron-right"></i></button>
                            <div class="ad-gallery-counter" id="adCounter">1 / @photos.Count</div>
                        }
                    </div>
                    @if (photos.Count > 1)
                    {
                        <div class="ad-gallery-thumbs" id="adThumbs">
                            @for (int i = 0; i < photos.Count; i++)
                            {
                                <button type="button" class="@(i == 0 ? "active" : "")" data-idx="@i" aria-label="Foto @(i+1)">
                                    <img src="@Url.Action(ActionNames.GetPhoto, ControllerNames.Coworking, new { photoId = photos[i].Id })" alt="" onerror="this.style.opacity='0';" />
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ad-carousel-empty" style="min-height:280px;">
                    <i class="bi bi-building"></i>
                    <span>@tradeName</span>
                </div>
            }
        </div>
    </div>
</section>

<div class="ad-listing-grid">
    <div>
        <div class="ad-hero-meta"><i class="bi bi-geo-alt-fill"></i> @locationLabel</div>
        <h1 class="ad-hero-title">@tradeName — Endereço fiscal</h1>
        <div class="ad-hero-address">
            <i class="bi bi-building" style="color:#c69844;"></i>
            <span>@fullAddress</span>
        </div>
        @* Badge de vagas removido — limite de contratos não é mais aplicado *@

        <div class="mb-4">
            <div class="ad-section-label">Documentos de confiança</div>
            <div class="ad-trust-menu">
                @foreach (var doc in trustDocuments)
                {
                    if (doc.IsAvailable)
                    {
                        <button type="button" class="ad-trust-btn" data-doc-type="@doc.Type" data-doc-name="@doc.DisplayName">
                            <i class="bi bi-file-earmark-pdf"></i> @doc.DisplayName
                        </button>
                    }
                    else
                    {
                        <span class="ad-trust-btn ad-trust-soon"><i class="bi bi-clock"></i> @doc.DisplayName — em breve</span>
                    }
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(description))
        {
            <div class="mb-4">
                <div class="ad-section-label">Sobre o espaço</div>
                <p style="color:#94a3b8; line-height:1.75;">@description</p>
            </div>
        }
    </div>
    <aside class="ad-sticky-card">
        <div style="font-size:0.75rem; color:#64748b; text-transform:uppercase; letter-spacing:0.08em;">A partir de</div>
        <div class="ad-price-yearly mb-3">R$ @yearlyPrice.ToString("N2") <small>/ano</small></div>
        <a href="@fiscalOnboardingUrl" class="btn-ad-fiscal w-100 justify-content-center" data-funnel="cta_address_detail_contratar" data-show-loading>
            <i class="bi bi-bank"></i> Contratar
        </a>
        <a href="@commercialOnboardingUrl" class="ad-cta-secondary-link d-block text-center mt-3 small" data-funnel="cta_address_detail_comercial" data-show-loading>
            Prefere endereço comercial?
        </a>
    </aside>
</div>

<div class="ad-mobile-cta">
    <div>
        <div style="color:#f8fafc; font-weight:700;">R$ @yearlyPrice.ToString("N2") <small style="color:#94a3b8; font-weight:400;">/ano</small></div>
    </div>
    <a href="@fiscalOnboardingUrl" class="btn-ad-fiscal" style="padding:12px 18px; white-space:nowrap;" data-funnel="cta_address_detail_mobile" data-show-loading>Contratar</a>
</div>

<div class="ad-lightbox" id="adLightbox" role="dialog" aria-modal="true" aria-label="Galeria">
    <button type="button" class="ad-modal-close" id="adLightboxClose" aria-label="Fechar">&times;</button>
    <button type="button" class="ad-carousel-nav prev" id="adLightboxPrev" aria-label="Anterior"><i class="bi bi-chevron-left"></i></button>
    <img id="adLightboxImg" alt="Foto ampliada" />
    <button type="button" class="ad-carousel-nav next" id="adLightboxNext" aria-label="Próxima"><i class="bi bi-chevron-right"></i></button>
</div>
<div class="ad-pdf-modal" id="adPdfModal" role="dialog" aria-modal="true">
    <div class="ad-pdf-modal-panel">
        <div class="ad-pdf-modal-header">
            <strong id="adPdfTitle" class="ad-pdf-modal-title">Documento</strong>
            <div class="ad-pdf-modal-actions">
                <a id="adPdfDownload" class="btn btn-sm btn-outline-light ad-pdf-download" href="#" download>Baixar</a>
                <button type="button" class="ad-pdf-modal-close" id="adPdfClose" aria-label="Fechar">&times;</button>
            </div>
        </div>
        <iframe id="adPdfFrame" class="ad-pdf-frame" title="Documento PDF"></iframe>
    </div>
</div>

<div class="divider-glow"></div>

<!-- ======================== GUIA DE DECISÃO ======================== -->
<section class="ad-guide">
    <div class="ad-section">
        <div style="text-align:center; margin-bottom:48px;">
            <div class="ad-section-label" style="justify-content:center; display:flex;">Guia Rápido</div>
            <div class="ad-section-title" style="text-align:center;">Qual endereço é ideal para você?</div>
            <div class="ad-section-subtitle" style="margin:0 auto 0;">Responda uma pergunta e descubra em segundos.</div>
        </div>

        <!-- Pergunta -->
        <div class="ad-guide-question-card" id="guideQuestion">
            <div class="ad-guide-question-icon">📦</div>
            <div class="ad-guide-question-text">Sua empresa tem, ou pretende ter, <strong>estoque físico</strong>?</div>
            <div class="ad-guide-question-sub">Estoque físico = mercadorias, produtos para venda ou distribuição guardados em algum local.</div>
            <div class="ad-guide-btn-group">
                <button class="ad-guide-btn" id="btnSim" onclick="showGuide('sim')">
                    <i class="bi bi-check-circle"></i> SIM, tenho estoque
                </button>
                <button class="ad-guide-btn" id="btnNao" onclick="showGuide('nao')">
                    <i class="bi bi-x-circle"></i> NÃO tenho estoque
                </button>
            </div>
        </div>

        <!-- Resultado SIM -->
        <div class="ad-result" id="result-sim">
            <div class="ad-result-cards">
                <div class="ad-result-card not-recommended">
                    <span class="ad-result-card-badge badge-not-recommended">Não recomendado para CNPJ</span>
                    <div class="ad-result-card-icon">🏢</div>
                    <div class="ad-result-card-title">Endereço Fiscal</div>
                    <div class="ad-result-card-desc">
                        Empresas com estoque precisam que o CNPJ fique no local onde a operação acontece de fato.
                        Usar nosso endereço como sede fiscal pode gerar problemas na prefeitura.
                    </div>
                    <ul class="ad-result-card-list">
                        <li><i class="bi bi-x-circle-fill cross"></i> CNPJ com estoque não pode usar endereço virtual como sede</li>
                        <li><i class="bi bi-x-circle-fill cross"></i> Risco de autuação fiscal e cancelamento do CNPJ</li>
                        <li><i class="bi bi-x-circle-fill cross"></i> CNAEs de comércio não são permitidos para endereço fiscal virtual</li>
                    </ul>
                </div>
                <div class="ad-result-card recommended">
                    <span class="ad-result-card-badge badge-recommended">Recomendado para você</span>
                    <div class="ad-result-card-icon">📍</div>
                    <div class="ad-result-card-title">Endereço Comercial</div>
                    <div class="ad-result-card-desc">
                        Use nosso endereço para dar uma imagem profissional à sua empresa: cartão de visita, site, reuniões — sem precisar colocar no CNPJ.
                    </div>
                    <ul class="ad-result-card-list">
                        <li><i class="bi bi-check-circle-fill check"></i> Endereço premium no cartão de visita e site</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Recebimento de correspondências e encomendas</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Apoio administrativo e atendimento presencial</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Acesso a salas de reunião (mediante contratação)</li>
                    </ul>
                    <a href="@commercialOnboardingUrl" class="btn-ad-comercial" style="width:100%; justify-content:center;" data-show-loading>
                        <i class="bi bi-briefcase"></i> Contratar Endereço Comercial
                    </a>
                </div>
            </div>
            <div style="text-align:center; margin-top:20px;">
                <button class="btn-ad-outline" onclick="resetGuide()"><i class="bi bi-arrow-counterclockwise"></i> Refazer</button>
            </div>
        </div>

        <!-- Resultado NÃO -->
        <div class="ad-result" id="result-nao">
            <div class="ad-result-cards">
                <div class="ad-result-card recommended">
                    <span class="ad-result-card-badge badge-recommended">Ideal para você</span>
                    <div class="ad-result-card-icon">🏢</div>
                    <div class="ad-result-card-title">Endereço Fiscal</div>
                    <div class="ad-result-card-desc">
                        Perfeito para prestadores de serviço! Use nosso endereço diretamente no seu CNPJ com documentação completa e suporte Klyon.
                    </div>
                    <ul class="ad-result-card-list">
                        <li><i class="bi bi-check-circle-fill check"></i> Use no CNPJ — sede oficial da sua empresa</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Documentação inclusa (IPTU, alvará, etc.)</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Aceito para prestadores de serviço (CNAEs de serviço)</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Suporte Klyon</li>
                        <li><i class="bi bi-check-circle-fill check"></i> Recebimento de correspondências</li>
                    </ul>
                    <a href="@fiscalOnboardingUrl" class="btn-ad-fiscal" style="width:100%; justify-content:center;" data-show-loading>
                        <i class="bi bi-bank"></i> Contratar Endereço Fiscal
                    </a>
                </div>
                <div class="ad-result-card" style="border-color:rgba(255,255,255,0.1); background:rgba(255,255,255,0.03);">
                    <div class="ad-result-card-icon" style="opacity:0.5;">📍</div>
                    <div class="ad-result-card-title" style="color:#64748b;">Endereço Comercial</div>
                    <div class="ad-result-card-desc">
                        Pode ser contratado como complemento, mas não é necessário se você já tem o Endereço Fiscal — ele já inclui uso para cartão de visita e site.
                    </div>
                    <ul class="ad-result-card-list">
                        <li><i class="bi bi-dash-circle" style="color:#475569; flex-shrink:0;"></i> <span style="color:#475569;">Não coloca no CNPJ</span></li>
                        <li><i class="bi bi-dash-circle" style="color:#475569; flex-shrink:0;"></i> <span style="color:#475569;">Não inclui documentos</span></li>
                        <li><i class="bi bi-check-circle-fill check"></i> Pode ser usado para cartão de visita e site</li>
                    </ul>
                </div>
            </div>
            <div style="text-align:center; margin-top:20px;">
                <button class="btn-ad-outline" onclick="resetGuide()"><i class="bi bi-arrow-counterclockwise"></i> Refazer</button>
            </div>
        </div>
    </div>
</section>

<div class="divider-glow"></div>

<!-- ======================== COMPARATIVO ======================== -->

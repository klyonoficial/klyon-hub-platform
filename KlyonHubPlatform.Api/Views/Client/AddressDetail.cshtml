                        <td style="background:rgba(249,115,22,0.02);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Sim</span></td>
                    </tr>
                    <tr>
                        <td>Recebimento de correspondência</td>
                        <td style="background:rgba(16,185,129,0.04);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Sim</span></td>
                        <td style="background:rgba(249,115,22,0.02);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Sim</span></td>
                    </tr>
                    <tr>
                        <td>CNAEs de prestação de serviço</td>
                        <td style="background:rgba(16,185,129,0.04);"><span class="check-yes"><i class="bi bi-check-circle-fill"></i> Aceito</span></td>
                        <td style="background:rgba(249,115,22,0.02);"><span class="check-partial"><i class="bi bi-dash-circle-fill"></i> Não aplicável</span></td>
                    </tr>

    text-align: center;
    margin-bottom: 36px;
}
.ad-scenario-text em { color: #f8fafc; font-style: normal; font-weight: 600; }
.ad-scenario-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
}
.ad-scenario-node {
    background: rgba(255,255,255,0.06);
    border-radius: 16px;
    padding: 20px 28px;
    text-align: center;
    min-width: 200px;
    border: 1px solid rgba(255,255,255,0.1);
    position: relative;
}
.ad-scenario-node.node-fiscal { border-color: rgba(16,185,129,0.4); background: rgba(16,185,129,0.07); }
.ad-scenario-node.node-filial { border-color: rgba(249,115,22,0.4); background: rgba(249,115,22,0.07); }
.ad-scenario-node-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
}
.node-fiscal .ad-scenario-node-label { color: #34d399; }
.node-filial .ad-scenario-node-label { color: #fb923c; }
.ad-scenario-node-cnpj {
    font-size: 0.85rem;
    font-family: monospace;
    color: #94a3b8;
    margin-bottom: 6px;
}
.ad-scenario-node-desc { font-size: 0.82rem; color: #64748b; }
.ad-scenario-arrow {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0 20px;
    gap: 4px;
    color: #334155;
}
.ad-scenario-arrow i { font-size: 1.5rem; }
.ad-scenario-arrow span { font-size: 0.7rem; color: #475569; }
.ad-scenario-arrow .arrow-mobile { display: none; }
@@media (max-width: 768px) {
    .ad-scenario-box {
        padding: 24px 16px;
        max-width: 100%;
        box-sizing: border-box;
    }
    .ad-scenario-diagram {
        flex-direction: column;
        flex-wrap: nowrap;
        align-items: stretch;
        width: 100%;
        gap: 12px;
    }
    .ad-scenario-node {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        box-sizing: border-box;
        padding: 18px 16px;
    }
    .ad-scenario-arrow {
        width: 100%;
        padding: 4px 0;
    }
    .ad-scenario-arrow .arrow-desktop { display: none; }
    .ad-scenario-arrow .arrow-mobile { display: inline-block; }
}

/* ---- FAQ ---- */

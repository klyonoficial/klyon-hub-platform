@{
    ViewData["Title"] = "Endereços Disponíveis";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.CoworkingAddress>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building"></i> Endereços Disponíveis</h2>
    <a href="@Url.Action("ChooseLocation", "Client")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var address in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-geo-alt"></i> @address.Address, @address.Number
                        </h5>
                        <p class="card-text">
                            <strong>Bairro:</strong> @address.Neighborhood<br>
                            <strong>Cidade:</strong> @address.City/@address.State<br>
                            <strong>CEP:</strong> @address.ZipCode
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="text-primary mb-0">R$ @address.BasePrice.ToString("F2")/mês</h4>
                            <form method="post" action="@Url.Action("CreateContract", "Client")" class="contract-form" onsubmit="return handleContractSubmit(this)">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="coworkingAddressId" value="@address.Id">
                                <button type="submit" class="btn btn-primary contract-btn">
                                    <i class="bi bi-check-circle"></i> Contratar
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Não há endereços disponíveis nesta localidade no momento.
    </div>
}

<script>
function handleContractSubmit(form) {
    const button = form.querySelector('.contract-btn');
    if (button.disabled) {
        return false; // Já está processando
    }
    
    // Desabilitar o botão para evitar múltiplos cliques
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processando...';
    
    // Permitir o submit
    return true;
}

// Reabilitar botões se houver erro (página recarregada)
document.addEventListener('DOMContentLoaded', function() {
    const errorAlert = document.querySelector('.alert-danger');
    if (errorAlert) {
        document.querySelectorAll('.contract-btn').forEach(btn => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle"></i> Contratar';
        });
    }
});
</script>

@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@{
    ViewData["Title"] = "Dashboard Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Verificar se os menus de coworking estão habilitados
    var enableCoworkingMenus = await SystemConfigurationService.GetValueAsync("Features.EnableCoworkingMenus");
    var showCoworkingMenus = enableCoworkingMenus?.ToLower() == "true";
}

@model KlyonHubPlatform.Domain.Entities.Client

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-speedometer2"></i> Dashboard
        @if (ViewBag.HasPending == true)
        {
            var pendingMessages = new List<string>();
            if (ViewBag.HasFinancialPending == true)
            {
                pendingMessages.Add("Pendência financeira");
            }
            if (ViewBag.HasCertificateExpiring == true)
            {
                pendingMessages.Add("Certificado próximo de vencer (30 dias)");
            }
            var tooltipText = string.Join(" e ", pendingMessages);
            <span class="badge bg-warning text-dark ms-2" title="@tooltipText" data-bs-toggle="tooltip" data-bs-placement="top">
                <i class="bi bi-exclamation-triangle-fill"></i> Pendência
            </span>
        }
    </h2>
</div>

@if (ViewBag.Client == null)
{
    <div class="alert alert-info">
        <h5><i class="bi bi-info-circle"></i> Complete seu cadastro</h5>
        <p>Para contratar um endereço fiscal, você precisa completar seu cadastro primeiro.</p>
        <a href="@Url.Action("RegisterClient", "Client")" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Completar Cadastro
        </a>
    </div>
}
else
{
    var client = ViewBag.Client as KlyonHubPlatform.Domain.Entities.Client;
    var activeContracts = client?.Contracts?.Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.PendingPayment).ToList() ?? new List<KlyonHubPlatform.Domain.Entities.Contract>();

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-file-earmark-text"></i> Contratos Ativos</h5>
                    <h2 class="display-4">@activeContracts.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-check-circle"></i> Status</h5>
                    <h4>Ativo</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-geo-alt"></i> Endereços</h5>
                    <h4>@activeContracts.Count</h4>
                </div>
            </div>
        </div>
        @if (showCoworkingMenus)
        {
            <div class="col-md-3">
                <div class="card text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-building"></i> Reservas de Coworking</h5>
                        <h2 class="display-4">@(ViewBag.ReservationsCount ?? 0)</h2>
                        <a href="@Url.Action("Marketplace", "Home")" class="btn btn-light btn-sm mt-2">
                            <i class="bi bi-search"></i> Ver Marketplace
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showCoworkingMenus)
    {
        <!-- Seção de Aluguel de Coworking -->
        <div class="card mb-4 border-warning">
            <div class="card-header bg-warning text-dark">
                <h5><i class="bi bi-building"></i> Aluguel de Coworking</h5>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h6 class="mb-2">Encontre e reserve salas de coworking</h6>
                        <p class="text-muted mb-0">Explore nosso marketplace e reserve salas para reuniões, eventos ou trabalho em equipe.</p>
                    </div>
                    <div class="col-md-4 text-end">
                        <a href="@Url.Action("Marketplace", "Home")" class="btn btn-warning btn-lg">
                            <i class="bi bi-search"></i> Acessar Marketplace
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5><i class="bi bi-file-earmark-text"></i> Meus Contratos de Endereço Fiscal</h5>
            <small class="text-muted">Exibindo contratos ativos e pendentes de pagamento</small>
        </div>
        <div class="card-body">
            @if (activeContracts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Número</th>
                                <th>Endereço</th>
                                <th>Valor Mensal</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var contract in activeContracts)
                            {
                                <tr>
                                    <td>@contract.ContractNumber</td>
                                    <td>@contract.CoworkingAddress?.Address, @contract.CoworkingAddress?.Number</td>
                                    <td>R$ @contract.MonthlyValue.ToString("F2")</td>
                                    <td>
                                        @{
                                            var statusText = contract.Status switch
                                            {
                                                ContractStatus.Active => "Ativo",
                                                ContractStatus.Suspended => "Suspenso",
                                                ContractStatus.PendingPayment => "Pendente",
                                                ContractStatus.PendingCancellation => "Cancelamento Pendente",
                                                ContractStatus.Cancelled => "Cancelado",
                                                ContractStatus.Expired => "Expirado",
                                                _ => contract.Status.ToString()
                                            };
                                            var statusBadgeClass = contract.Status switch
                                            {
                                                ContractStatus.Active => "bg-success",
                                                ContractStatus.PendingPayment => "bg-warning",
                                                ContractStatus.Suspended => "bg-secondary",
                                                ContractStatus.PendingCancellation => "bg-info",
                                                ContractStatus.Cancelled => "bg-danger",
                                                ContractStatus.Expired => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusBadgeClass">@statusText</span>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("ContractDetails", "Client", new { id = contract.Id })" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> Ver Detalhes
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <p>Você ainda não possui contratos ativos de endereço fiscal.</p>
                    <a href="@Url.Action("ChooseLocation", "Client")" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Ofertar Endereço Fiscal
                    </a>
                </div>
            }
        </div>
    </div>
}

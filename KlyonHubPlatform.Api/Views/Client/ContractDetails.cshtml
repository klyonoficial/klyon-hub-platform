@{
    ViewData["Title"] = "Detalhes do Contrato";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonHubPlatform.Domain.Entities.Contract

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Contrato @Model.ContractNumber</h2>
    <a href="@Url.Action("MyContracts", "Client")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5>Informações do Contrato</h5>
            </div>
            <div class="card-body">
                <table class="table">
                    <tr>
                        <th>Número:</th>
                        <td>@Model.ContractNumber</td>
                    </tr>
                    <tr>
                        <th>Status:</th>
                        <td>
                            <span class="badge bg-@(Model.Status == ContractStatus.Active ? "success" : "secondary")">
                                @Model.Status
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th>Data de Início:</th>
                        <td>@Model.StartDate.ToString("dd/MM/yyyy")</td>
                    </tr>
                    <tr>
                        <th>Valor Mensal:</th>
                        <td><strong>R$ @Model.MonthlyValue.ToString("F2")</strong></td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Endereço Fiscal</h5>
            </div>
            <div class="card-body">
                <p>
                    @Model.CoworkingAddress?.Address, @Model.CoworkingAddress?.Number<br>
                    @Model.CoworkingAddress?.Neighborhood<br>
                    @Model.CoworkingAddress?.City/@Model.CoworkingAddress?.State<br>
                    CEP: @Model.CoworkingAddress?.ZipCode
                </p>
            </div>
        </div>

        @if (Model.Status == ContractStatus.Active)
        {
            <div class="card">
                <div class="card-header">
                    <h5>Cancelar Contrato</h5>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("CancelContract", "Client")">
                        <input type="hidden" name="contractId" value="@Model.Id">
                        <div class="mb-3">
                            <label for="reason" class="form-label">Motivo do Cancelamento</label>
                            <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza que deseja cancelar este contrato?')">
                            <i class="bi bi-x-circle"></i> Cancelar Contrato
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Documentos</h5>
            </div>
            <div class="card-body">
                @if (Model.Documents != null && Model.Documents.Any())
                {
                    <ul class="list-group">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@doc.Type</span>
                                <a href="@Url.Action("DownloadDocument", "Client", new { documentId = doc.Id })" class="btn btn-sm btn-primary">
                                    <i class="bi bi-download"></i> Download
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted">Nenhum documento disponível.</p>
                }
            </div>
        </div>
    </div>
</div>

@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData["Title"] = "Notas Fiscais";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.FiscalNote>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-receipt-cutoff"></i> Notas Fiscais</h2>
        <p class="text-muted mb-0">Visualize as notas fiscais aprovadas e emitidas para você</p>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3" id="filterForm">
            <div class="col-md-3">
                <label class="form-label">Tipo</label>
                <select class="form-select" name="type">
                    <option value="">Todos</option>
                    @if (ViewBag.Type == "Intermediacao")
                    {
                        <option value="Intermediacao" selected>Intermediação</option>
                    }
                    else
                    {
                        <option value="Intermediacao">Intermediação</option>
                    }
                    @if (ViewBag.Type == "Servico")
                    {
                        <option value="Servico" selected>Serviço</option>
                    }
                    else
                    {
                        <option value="Servico">Serviço</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Parceiro</label>
                <select class="form-select" name="coworkingId">
                    <option value="">Todos</option>
                    @if (ViewBag.Coworkings != null)
                    {
                        foreach (var coworking in ViewBag.Coworkings)
                        {
                            var isSelected = ViewBag.CoworkingId != null && Convert.ToInt32(ViewBag.CoworkingId) == coworking.Id;
                            if (isSelected)
                            {
                                <option value="@coworking.Id" selected>@coworking.Name</option>
                            }
                            else
                            {
                                <option value="@coworking.Id">@coworking.Name</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Data Inicial</label>
                <input type="date" class="form-control" name="startDate" value="@(ViewBag.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Data Final</label>
                <input type="date" class="form-control" name="endDate" value="@(ViewBag.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Buscar (Número ou Chave de Acesso)</label>
                <input type="text" class="form-control" name="search" value="@ViewBag.Search" placeholder="Digite o número da NF ou chave de acesso" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action("FiscalNotes", "Client")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
            <input type="hidden" name="page" value="1" />
        </form>
    </div>
</div>

<!-- Tabela de Notas Fiscais -->
<div class="card">
    <div class="card-body">
        @{
            var currentPage = ViewBag.CurrentPage as int? ?? 1;
            var totalPages = ViewBag.TotalPages as int? ?? 1;
            var totalItems = ViewBag.TotalItems as int? ?? 0;
            var pageSize = ViewBag.PageSize as int? ?? 20;
        }
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Número</th>
                            <th>Serviço</th>
                            <th>Parceiro</th>
                            <th>Valor Pago (R$)</th>
                            <th>Data Emissão</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in Model)
                        {
                            var serviceName = "Serviço";
                            var location = "";
                            
                            if (note.Contract != null && note.Contract.CoworkingAddress != null && note.Contract.CoworkingAddress.Location != null)
                            {
                                serviceName = "Endereço Fiscal";
                                location = $"{note.Contract.CoworkingAddress.Location.City}/{note.Contract.CoworkingAddress.Location.State}";
                            }
                            else if (note.Reservation != null && note.Reservation.CoworkingAddress != null && note.Reservation.CoworkingAddress.Location != null)
                            {
                                serviceName = "Reserva de Sala";
                                location = $"{note.Reservation.CoworkingAddress.Location.City}/{note.Reservation.CoworkingAddress.Location.State}";
                            }
                            
                            <tr class="fiscal-note-row" style="cursor: pointer;" 
                                data-note-id="@note.Id"
                                data-note-number="@(note.Number ?? "")"
                                data-note-access-key="@(note.AccessKey ?? "")"
                                data-note-verification-code="@(note.VerificationCode ?? "")"
                                data-note-amount="@note.Amount.ToString("F2")"
                                data-note-service-amount="@(note.ServiceAmount?.ToString("F2") ?? "")"
                                data-note-commission-amount="@(note.CommissionAmount?.ToString("F2") ?? "")"
                                data-note-status="@note.Status"
                                data-note-issue-date="@note.IssueDate.ToString("dd/MM/yyyy")"
                                data-note-due-date="@(note.DueDate?.ToString("dd/MM/yyyy") ?? "")"
                                data-note-authorized-at="@(note.AuthorizedAt?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                data-note-authorization-protocol="@(note.AuthorizationProtocol ?? "")"
                                data-note-cancelled-at="@(note.CancelledAt?.ToString("dd/MM/yyyy HH:mm") ?? "")"
                                data-note-cancellation-reason="@(note.CancellationReason ?? "")"
                                data-note-error-message="@(note.ErrorMessage ?? "")"
                                data-note-view-url="@(note.ViewUrl ?? "")"
                                data-note-pdf-url="@(note.PdfUrl ?? "")"
                                data-coworking-name="@(note.Coworking?.Name ?? "")"
                                data-service-name="@serviceName"
                                data-location="@location">
                                <td>
                                    @if (!string.IsNullOrEmpty(note.Number))
                                    {
                                        <strong>@note.Number</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <strong>@serviceName</strong>
                                    @if (!string.IsNullOrEmpty(location))
                                    {
                                        <br><small class="text-muted">@location</small>
                                    }
                                </td>
                                <td>
                                    @if (note.Coworking != null)
                                    {
                                        @note.Coworking.Name
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <strong>R$ @note.Amount.ToString("F2")</strong>
                                </td>
                                <td>@note.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @{
                                        var statusClass = note.Status switch
                                        {
                                            FiscalNoteStatus.Emitida => "success",
                                            FiscalNoteStatus.Pendente => "warning",
                                            FiscalNoteStatus.Cancelada => "danger",
                                            FiscalNoteStatus.Erro => "danger",
                                            _ => "secondary"
                                        };
                                        var statusText = note.Status.ToString();
                                    }
                                    <span class="badge bg-@statusClass">@statusText</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        @if (!string.IsNullOrEmpty(note.AccessKey) && !string.IsNullOrEmpty(note.ViewUrl))
                                        {
                                            <a href="@note.ViewUrl" target="_blank" class="btn btn-sm btn-outline-primary" title="Visualizar NF" onclick="event.stopPropagation();">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(note.PdfUrl))
                                        {
                                            <a href="@Url.Action("DownloadFiscalNotePdf", "Client", new { fiscalNoteId = note.Id })" target="_blank" class="btn btn-sm btn-outline-danger" title="Download PDF" onclick="event.stopPropagation();">
                                                <i class="bi bi-file-pdf"></i>
                                            </a>
                                        }
                                        @if (string.IsNullOrEmpty(note.AccessKey) && string.IsNullOrEmpty(note.PdfUrl))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (totalPages > 1)
            {
                var routeValues = new Dictionary<string, object>
                {
                    { "pageSize", pageSize }
                };
                
                if (!string.IsNullOrEmpty(ViewBag.Type as string))
                {
                    routeValues["type"] = ViewBag.Type;
                }
                if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    routeValues["search"] = ViewBag.Search;
                }
                if (ViewBag.CoworkingId != null)
                {
                    routeValues["coworkingId"] = Convert.ToInt32(ViewBag.CoworkingId);
                }
                if (ViewBag.StartDate != null)
                {
                    routeValues["startDate"] = ((DateTime)ViewBag.StartDate).ToString("yyyy-MM-dd");
                }
                if (ViewBag.EndDate != null)
                {
                    routeValues["endDate"] = ((DateTime)ViewBag.EndDate).ToString("yyyy-MM-dd");
                }

                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center">
                        @if (currentPage > 1)
                        {
                            routeValues["page"] = currentPage - 1;
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("FiscalNotes", routeValues)">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            routeValues["page"] = i;
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("FiscalNotes", routeValues)">@i</a>
                            </li>
                        }

                        @if (currentPage < totalPages)
                        {
                            routeValues["page"] = currentPage + 1;
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("FiscalNotes", routeValues)">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <div class="text-center text-muted mt-3">
                Mostrando @((currentPage - 1) * pageSize + 1) a @(Math.Min(currentPage * pageSize, totalItems)) de @totalItems nota(s) fiscal(is)
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhuma nota fiscal encontrada.
            </div>
        }
    </div>
</div>

<!-- Modal de Detalhes da Nota Fiscal -->
<div class="modal fade" id="fiscalNoteDetailModal" tabindex="-1" aria-labelledby="fiscalNoteDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="fiscalNoteDetailModalLabel">
                    <i class="bi bi-receipt-cutoff"></i> Detalhes da Nota Fiscal
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Informações Básicas -->
                    <div class="col-12 mb-4">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-info-circle"></i> Informações Básicas</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Número da NF:</label>
                                <p class="mb-0" id="modal-note-number">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Status:</label>
                                <p class="mb-0" id="modal-note-status">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Data de Emissão:</label>
                                <p class="mb-0" id="modal-note-issue-date">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Data de Vencimento:</label>
                                <p class="mb-0" id="modal-note-due-date">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Chave de Acesso:</label>
                                <p class="mb-0 text-break" id="modal-note-access-key">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Código de Verificação:</label>
                                <p class="mb-0" id="modal-note-verification-code">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Valores -->
                    <div class="col-12 mb-4">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-currency-dollar"></i> Valores</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Valor Total:</label>
                                <p class="mb-0 fs-5 text-primary" id="modal-note-amount">-</p>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Valor do Serviço:</label>
                                <p class="mb-0" id="modal-note-service-amount">-</p>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Valor da Comissão:</label>
                                <p class="mb-0" id="modal-note-commission-amount">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Parceiro -->
                    <div class="col-12 mb-4">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-building"></i> Parceiro</h6>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Nome do Parceiro:</label>
                                <p class="mb-0" id="modal-coworking-name">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Serviço -->
                    <div class="col-12 mb-4">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-briefcase"></i> Serviço</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Tipo de Serviço:</label>
                                <p class="mb-0" id="modal-service-name">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Localização:</label>
                                <p class="mb-0" id="modal-location">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Autorização -->
                    <div class="col-12 mb-4" id="modal-authorization-section" style="display: none;">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-check-circle"></i> Autorização</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Data de Autorização:</label>
                                <p class="mb-0" id="modal-note-authorized-at">-</p>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Protocolo de Autorização:</label>
                                <p class="mb-0 text-break" id="modal-note-authorization-protocol">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Cancelamento -->
                    <div class="col-12 mb-4" id="modal-cancellation-section" style="display: none;">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-x-circle"></i> Cancelamento</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Data de Cancelamento:</label>
                                <p class="mb-0" id="modal-note-cancelled-at">-</p>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-bold">Motivo do Cancelamento:</label>
                                <p class="mb-0" id="modal-note-cancellation-reason">-</p>
                            </div>
                        </div>
                    </div>

                    <!-- Erro -->
                    <div class="col-12 mb-4" id="modal-error-section" style="display: none;">
                        <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-exclamation-triangle"></i> Erro</h6>
                        <div class="alert alert-danger mb-0">
                            <p class="mb-0" id="modal-note-error-message">-</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <div id="modal-actions" class="w-100">
                    <a id="modal-view-url" href="#" target="_blank" class="btn btn-primary" style="display: none;">
                        <i class="bi bi-eye"></i> Visualizar NF
                    </a>
                    <a id="modal-pdf-url" href="#" target="_blank" class="btn btn-danger" style="display: none;">
                        <i class="bi bi-file-pdf"></i> Download PDF
                    </a>
                </div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Resetar página para 1 quando os filtros mudarem
            const filterForm = document.getElementById('filterForm');
            if (filterForm) {
                const filterInputs = filterForm.querySelectorAll('select, input[type="text"], input[type="date"]');
                filterInputs.forEach(input => {
                    input.addEventListener('change', function() {
                        const pageInput = filterForm.querySelector('input[name="page"]');
                        if (pageInput) {
                            pageInput.value = '1';
                        }
                    });
                });
            }

            const rows = document.querySelectorAll('.fiscal-note-row');
            const modal = new bootstrap.Modal(document.getElementById('fiscalNoteDetailModal'));
            const downloadPdfBaseUrl = '@Url.Action("DownloadFiscalNotePdf", "Client")';

            rows.forEach(row => {
                row.addEventListener('click', function(e) {
                    // Não abrir modal se clicar em botões de ação
                    if (e.target.closest('a, button')) {
                        return;
                    }

                    // Preencher dados do modal
                    document.getElementById('modal-note-number').textContent = row.dataset.noteNumber || '-';
                    
                    // Status com badge
                    const status = row.dataset.noteStatus || '-';
                    const statusClass = status === 'Emitida' ? 'success' : 
                                       status === 'Pendente' ? 'warning' : 
                                       status === 'Cancelada' || status === 'Erro' ? 'danger' : 'secondary';
                    document.getElementById('modal-note-status').innerHTML = status !== '-' 
                        ? `<span class="badge bg-${statusClass}">${status}</span>` 
                        : '-';
                    
                    document.getElementById('modal-note-issue-date').textContent = row.dataset.noteIssueDate || '-';
                    document.getElementById('modal-note-due-date').textContent = row.dataset.noteDueDate || '-';
                    document.getElementById('modal-note-access-key').textContent = row.dataset.noteAccessKey || '-';
                    document.getElementById('modal-note-verification-code').textContent = row.dataset.noteVerificationCode || '-';
                    
                    // Valores
                    document.getElementById('modal-note-amount').textContent = row.dataset.noteAmount ? `R$ ${row.dataset.noteAmount}` : '-';
                    document.getElementById('modal-note-service-amount').textContent = row.dataset.noteServiceAmount ? `R$ ${row.dataset.noteServiceAmount}` : '-';
                    document.getElementById('modal-note-commission-amount').textContent = row.dataset.noteCommissionAmount ? `R$ ${row.dataset.noteCommissionAmount}` : '-';
                    
                    // Parceiro
                    document.getElementById('modal-coworking-name').textContent = row.dataset.coworkingName || '-';
                    
                    // Serviço
                    document.getElementById('modal-service-name').textContent = row.dataset.serviceName || '-';
                    document.getElementById('modal-location').textContent = row.dataset.location || '-';
                    
                    // Autorização
                    const authorizedAt = row.dataset.noteAuthorizedAt;
                    const authProtocol = row.dataset.noteAuthorizationProtocol;
                    if (authorizedAt || authProtocol) {
                        document.getElementById('modal-authorization-section').style.display = 'block';
                        document.getElementById('modal-note-authorized-at').textContent = authorizedAt || '-';
                        document.getElementById('modal-note-authorization-protocol').textContent = authProtocol || '-';
                    } else {
                        document.getElementById('modal-authorization-section').style.display = 'none';
                    }
                    
                    // Cancelamento
                    const cancelledAt = row.dataset.noteCancelledAt;
                    const cancellationReason = row.dataset.noteCancellationReason;
                    if (cancelledAt || cancellationReason) {
                        document.getElementById('modal-cancellation-section').style.display = 'block';
                        document.getElementById('modal-note-cancelled-at').textContent = cancelledAt || '-';
                        document.getElementById('modal-note-cancellation-reason').textContent = cancellationReason || '-';
                    } else {
                        document.getElementById('modal-cancellation-section').style.display = 'none';
                    }
                    
                    // Erro
                    const errorMessage = row.dataset.noteErrorMessage;
                    if (errorMessage) {
                        document.getElementById('modal-error-section').style.display = 'block';
                        document.getElementById('modal-note-error-message').textContent = errorMessage;
                    } else {
                        document.getElementById('modal-error-section').style.display = 'none';
                    }
                    
                    // Links de ação
                    const viewUrl = row.dataset.noteViewUrl;
                    const pdfUrl = row.dataset.notePdfUrl;
                    
                    const viewLink = document.getElementById('modal-view-url');
                    const pdfLink = document.getElementById('modal-pdf-url');
                    
                    if (viewUrl) {
                        viewLink.href = viewUrl;
                        viewLink.style.display = 'inline-block';
                    } else {
                        viewLink.style.display = 'none';
                    }
                    
                    if (pdfUrl) {
                        const noteId = row.dataset.noteId;
                        pdfLink.href = `${downloadPdfBaseUrl}?fiscalNoteId=${noteId}`;
                        pdfLink.style.display = 'inline-block';
                    } else {
                        pdfLink.style.display = 'none';
                    }
                    
                    // Abrir modal
                    modal.show();
                });
            });
        });
    </script>
}

@{
    ViewData["Title"] = "Declarações de Uso de Endereço Fiscal";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using KlyonHubPlatform.Domain.Entities
@using KlyonHubPlatform.Domain.Core.Enums

@{
    var contracts = ViewBag.Contracts as List<Contract> ?? new List<Contract>();
    var allContracts = ViewBag.AllContracts as List<Contract> ?? contracts; // Para o dropdown de filtros
    var declarationsByContract = ViewBag.DeclarationsByContract as Dictionary<int, List<AddressDeclaration>> ?? new Dictionary<int, List<AddressDeclaration>>();
    var contractsWithPaidPayments = ViewBag.ContractsWithPaidPayments as List<int> ?? new List<int>();
    var search = ViewBag.Search as string ?? "";
    var contractId = ViewBag.ContractId as int?;
    var status = ViewBag.Status as string ?? "";
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasMultipleContracts = ViewBag.HasMultipleContracts as bool? ?? false;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalItems = ViewBag.TotalItems as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Declarações de Uso de Endereço Fiscal</h2>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros de Pesquisa</h5>
    </div>
    <div class="card-body">
        <form method="get" action="@Url.Action(ActionNames.Declarations, ControllerNames.Client)" id="filterForm">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="search" class="form-label">Buscar</label>
                    <input type="text" class="form-control" id="search" name="search" 
                           value="@search" placeholder="Número da declaração ou contrato">
                </div>
                <div class="col-md-3 mb-3">
                    <label for="contractId" class="form-label">Contrato</label>
                    <select class="form-select" id="contractId" name="contractId">
                        <option value="">Todos os contratos</option>
                        @foreach (var contract in allContracts)
                        {
                            @if (contractId == contract.Id)
                            {
                                <option value="@contract.Id" selected>
                                    @contract.ContractNumber - @contract.CoworkingAddress.City/@contract.CoworkingAddress.State
                                </option>
                            }
                            else
                            {
                                <option value="@contract.Id">
                                    @contract.ContractNumber - @contract.CoworkingAddress.City/@contract.CoworkingAddress.State
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="">Todos</option>
                        @if (status == "valid")
                        {
                            <option value="valid" selected>Válida</option>
                        }
                        else
                        {
                            <option value="valid">Válida</option>
                        }
                        @if (status == "expired")
                        {
                            <option value="expired" selected>Expirada</option>
                        }
                        else
                        {
                            <option value="expired">Expirada</option>
                        }
                        @if (status == "invalid")
                        {
                            <option value="invalid" selected>Inválida</option>
                        }
                        else
                        {
                            <option value="invalid">Inválida</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <label for="dateFrom" class="form-label">Data de Geração (De)</label>
                    <input type="date" class="form-control" id="dateFrom" name="dateFrom" 
                           value="@(dateFrom?.ToString("yyyy-MM-dd") ?? "")">
                </div>
                <div class="col-md-2 mb-3">
                    <label for="dateTo" class="form-label">Data de Geração (Até)</label>
                    <input type="date" class="form-control" id="dateTo" name="dateTo" 
                           value="@(dateTo?.ToString("yyyy-MM-dd") ?? "")">
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <input type="hidden" name="page" value="1" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Pesquisar
                    </button>
                    <a href="@Url.Action(ActionNames.Declarations, ControllerNames.Client)" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Limpar Filtros
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!allContracts.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Você não possui contratos ativos para gerar declarações.
    </div>
}
else
{
    @if (contractId.HasValue || !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status) || dateFrom.HasValue || dateTo.HasValue)
    {
        var totalFiltered = declarationsByContract.Values.SelectMany(d => d).Count();
        <div class="alert alert-info mb-3">
            <i class="bi bi-info-circle"></i> 
            @if (totalFiltered > 0)
            {
                <text>Encontradas <strong>@totalFiltered</strong> declaração(ões) com os filtros aplicados.</text>
            }
            else
            {
                <text>Nenhuma declaração encontrada com os filtros aplicados.</text>
            }
        </div>
    }

    @if (hasMultipleContracts)
    {
        <div class="accordion" id="contractsAccordion">
            @{
                var contractIndex = 0;
            }
            @foreach (var contract in contracts)
            {
                var declarations = declarationsByContract.ContainsKey(contract.Id) ? declarationsByContract[contract.Id] : new List<AddressDeclaration>();
                var hasValidDeclaration = declarations.Any(d => d.IsValid && d.EndDate >= DateTime.UtcNow);
                
                // Se houver filtros e não houver declarações para este contrato, não exibir o card
                if ((contractId.HasValue || !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status) || dateFrom.HasValue || dateTo.HasValue) && !declarations.Any())
                {
                    continue;
                }
                
                var accordionId = $"contract_{contract.Id}";
                var collapseId = $"collapse_{contract.Id}";
                contractIndex++;
                
                <div class="accordion-item mb-3">
                    <h2 class="accordion-header" id="@accordionId">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                <div>
                                    <h5 class="mb-1">
                                        <i class="bi bi-building"></i> @(contract.CoworkingAddress?.Coworking?.Name ?? "Coworking")
                                    </h5>
                                    <small class="text-muted">
                                        <i class="bi bi-file-earmark-text"></i> Contrato: @contract.ContractNumber
                                    </small>
                                </div>
                                <div>
                                    @if (contract.Status == ContractStatus.Active && contractsWithPaidPayments.Contains(contract.Id))
                                    {
                                        <form method="post" action="@Url.Action(ActionNames.GenerateDeclaration, ControllerNames.Client)" class="d-inline" onclick="event.stopPropagation();">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="contractId" value="@contract.Id">
                                            <button type="submit" class="btn btn-primary btn-sm" 
                                                    onclick="event.preventDefault(); handleGenerateDeclaration(this);">
                                                <i class="bi bi-file-earmark-pdf"></i> Emitir Declaração
                                            </button>
                                        </form>
                                    }
                                    else if (contract.Status == ContractStatus.Active && !contractsWithPaidPayments.Contains(contract.Id))
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-clock-history"></i> Aguardando Pagamento
                                        </span>
                                    }
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@accordionId" data-bs-parent="#contractsAccordion">
                        <div class="accordion-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6 class="text-primary mb-3">
                            <i class="bi bi-geo-alt"></i> Endereço Fiscal
                        </h6>
                        <p class="mb-2">
                            <strong>Endereço:</strong><br>
                            @contract.CoworkingAddress.Address, @contract.CoworkingAddress.Number
                            @if (!string.IsNullOrEmpty(contract.CoworkingAddress.Complement))
                            {
                                <text>, @contract.CoworkingAddress.Complement</text>
                            }
                        </p>
                        <p class="mb-2">
                            <strong>Bairro:</strong> @contract.CoworkingAddress.Neighborhood
                        </p>
                        <p class="mb-2">
                            <strong>Cidade/Estado:</strong> @contract.CoworkingAddress.City/@contract.CoworkingAddress.State
                        </p>
                        <p class="mb-0">
                            <strong>CEP:</strong> @contract.CoworkingAddress.ZipCode
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary mb-3">
                            <i class="bi bi-calendar"></i> Período de Vigência
                        </h6>
                        <p class="mb-2">
                            <strong>Data Inicial:</strong><br>
                            <span class="badge bg-info">@contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</span>
                        </p>
                        <p class="mb-2">
                            <strong>Data Final:</strong><br>
                            @if (contract.ExpiryDate.HasValue)
                            {
                                <span class="badge bg-success">@contract.ExpiryDate.Value.ToString(DateFormatConstants.DisplayDateOnly)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Não definida</span>
                            }
                        </p>
                        @if (contract.ExpiryDate.HasValue)
                        {
                            var daysRemaining = (contract.ExpiryDate.Value - DateTime.UtcNow).Days;
                            <p class="mb-0">
                                <strong>Dias Restantes:</strong><br>
                                @if (daysRemaining > 0)
                                {
                                    <span class="badge bg-@(daysRemaining <= 30 ? "warning" : "info")">@daysRemaining dia(s)</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Expirado</span>
                                }
                            </p>
                        }
                    </div>
                </div>

                @if (declarations.Any())
                {
                    <h6 class="mt-3 mb-2">Declarações Geradas (@declarations.Count):</h6>
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Número</th>
                                    <th>Versão</th>
                                    <th>Data Inicial</th>
                                    <th>Data Final</th>
                                    <th>Status</th>
                                    <th>Data de Geração</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var declaration in declarations.OrderByDescending(d => d.Version))
                                {
                                    var isExpired = declaration.EndDate < DateTime.UtcNow;
                                    var isValid = declaration.IsValid && !isExpired;
                                    
                                    <tr class="@(isValid ? "" : "table-secondary")">
                                        <td>@declaration.DeclarationNumber</td>
                                        <td>v@(declaration.Version)</td>
                                        <td>@declaration.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                        <td>@declaration.EndDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                        <td>
                                            @if (isValid)
                                            {
                                                <span class="badge bg-success">Válida</span>
                                            }
                                            else if (isExpired)
                                            {
                                                <span class="badge bg-danger">Expirada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inválida</span>
                                            }
                                        </td>
                                        <td>@declaration.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)</td>
                                        <td>
                                            @if (isValid)
                                            {
                                                <a href="@Url.Action(ActionNames.DownloadDeclaration, ControllerNames.Client, new { declarationId = declaration.Id })" 
                                                   class="btn btn-sm btn-primary" target="_blank">
                                                    <i class="bi bi-download"></i> Baixar PDF
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Indisponível</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!contractId.HasValue && string.IsNullOrEmpty(search) && string.IsNullOrEmpty(status) && !dateFrom.HasValue && !dateTo.HasValue)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> Nenhuma declaração gerada para este contrato.
                    </div>
                }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @foreach (var contract in contracts)
        {
            var declarations = declarationsByContract.ContainsKey(contract.Id) ? declarationsByContract[contract.Id] : new List<AddressDeclaration>();
            var hasValidDeclaration = declarations.Any(d => d.IsValid && d.EndDate >= DateTime.UtcNow);
            
            // Se houver filtros e não houver declarações para este contrato, não exibir o card
            if ((contractId.HasValue || !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status) || dateFrom.HasValue || dateTo.HasValue) && !declarations.Any())
            {
                continue;
            }
            
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">
                            <i class="bi bi-building"></i> @(contract.CoworkingAddress?.Coworking?.Name ?? "Coworking")
                        </h5>
                        <small class="text-white-50">
                            <i class="bi bi-file-earmark-text"></i> Contrato: @contract.ContractNumber
                        </small>
                    </div>
                    <div>
                        @if (contract.Status == ContractStatus.Active && contractsWithPaidPayments.Contains(contract.Id))
                        {
                            <form method="post" action="@Url.Action(ActionNames.GenerateDeclaration, ControllerNames.Client)" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contractId" value="@contract.Id">
                                <button type="submit" class="btn btn-light btn-sm" 
                                        onclick="event.preventDefault(); handleGenerateDeclaration(this);">
                                    <i class="bi bi-file-earmark-pdf"></i> Emitir Declaração
                                </button>
                            </form>
                        }
                        else if (contract.Status == ContractStatus.Active && !contractsWithPaidPayments.Contains(contract.Id))
                        {
                            <span class="badge bg-warning text-dark">
                                <i class="bi bi-clock-history"></i> Aguardando Pagamento
                            </span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">
                                <i class="bi bi-geo-alt"></i> Endereço Fiscal
                            </h6>
                            <p class="mb-2">
                                <strong>Endereço:</strong><br>
                                @contract.CoworkingAddress.Address, @contract.CoworkingAddress.Number
                                @if (!string.IsNullOrEmpty(contract.CoworkingAddress.Complement))
                                {
                                    <text>, @contract.CoworkingAddress.Complement</text>
                                }
                            </p>
                            <p class="mb-2">
                                <strong>Bairro:</strong> @contract.CoworkingAddress.Neighborhood
                            </p>
                            <p class="mb-2">
                                <strong>Cidade/Estado:</strong> @contract.CoworkingAddress.City/@contract.CoworkingAddress.State
                            </p>
                            <p class="mb-0">
                                <strong>CEP:</strong> @contract.CoworkingAddress.ZipCode
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">
                                <i class="bi bi-calendar"></i> Período de Vigência
                            </h6>
                            <p class="mb-2">
                                <strong>Data Inicial:</strong><br>
                                <span class="badge bg-info">@contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</span>
                            </p>
                            <p class="mb-2">
                                <strong>Data Final:</strong><br>
                                @if (contract.ExpiryDate.HasValue)
                                {
                                    <span class="badge bg-success">@contract.ExpiryDate.Value.ToString(DateFormatConstants.DisplayDateOnly)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Não definida</span>
                                }
                            </p>
                            @if (contract.ExpiryDate.HasValue)
                            {
                                var daysRemaining = (contract.ExpiryDate.Value - DateTime.UtcNow).Days;
                                <p class="mb-0">
                                    <strong>Dias Restantes:</strong><br>
                                    @if (daysRemaining > 0)
                                    {
                                        <span class="badge bg-@(daysRemaining <= 30 ? "warning" : "info")">@daysRemaining dia(s)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Expirado</span>
                                    }
                                </p>
                            }
                        </div>
                    </div>

                    @if (declarations.Any())
                    {
                        <h6 class="mt-3 mb-2">Declarações Geradas (@declarations.Count):</h6>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Número</th>
                                        <th>Versão</th>
                                        <th>Data Inicial</th>
                                        <th>Data Final</th>
                                        <th>Status</th>
                                        <th>Data de Geração</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var declaration in declarations.OrderByDescending(d => d.Version))
                                    {
                                        var isExpired = declaration.EndDate < DateTime.UtcNow;
                                        var isValid = declaration.IsValid && !isExpired;
                                        
                                        <tr class="@(isValid ? "" : "table-secondary")">
                                            <td>@declaration.DeclarationNumber</td>
                                            <td>v@(declaration.Version)</td>
                                            <td>@declaration.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                            <td>@declaration.EndDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                            <td>
                                                @if (isValid)
                                                {
                                                    <span class="badge bg-success">Válida</span>
                                                }
                                                else if (isExpired)
                                                {
                                                    <span class="badge bg-danger">Expirada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inválida</span>
                                                }
                                            </td>
                                            <td>@declaration.CreatedAt.ToString(DateFormatConstants.DisplayDateAndTime)</td>
                                            <td>
                                                @if (isValid)
                                                {
                                                    <a href="@Url.Action(ActionNames.DownloadDeclaration, ControllerNames.Client, new { declarationId = declaration.Id })" 
                                                       class="btn btn-sm btn-primary" target="_blank">
                                                        <i class="bi bi-download"></i> Baixar PDF
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Indisponível</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (!contractId.HasValue && string.IsNullOrEmpty(search) && string.IsNullOrEmpty(status) && !dateFrom.HasValue && !dateTo.HasValue)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> Nenhuma declaração gerada para este contrato.
                        </div>
                    }
                </div>
            </div>
        }
    }

    <!-- Paginação -->
    @if (totalPages > 1)
    {
        <nav aria-label="Paginação de contratos">
            <ul class="pagination justify-content-center mt-4">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action(ActionNames.Declarations, ControllerNames.Client, new { 
                            search = search, 
                            contractId = contractId, 
                            status = status, 
                            dateFrom = dateFrom?.ToString("yyyy-MM-dd"), 
                            dateTo = dateTo?.ToString("yyyy-MM-dd"),
                            page = currentPage - 1 
                        })">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>
                }

                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(ActionNames.Declarations, ControllerNames.Client, new { 
                            search = search, 
                            contractId = contractId, 
                            status = status, 
                            dateFrom = dateFrom?.ToString("yyyy-MM-dd"), 
                            dateTo = dateTo?.ToString("yyyy-MM-dd"),
                            page = i 
                        })">
                            @i
                        </a>
                    </li>
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action(ActionNames.Declarations, ControllerNames.Client, new { 
                            search = search, 
                            contractId = contractId, 
                            status = status, 
                            dateFrom = dateFrom?.ToString("yyyy-MM-dd"), 
                            dateTo = dateTo?.ToString("yyyy-MM-dd"),
                            page = currentPage + 1 
                        })">
                            Próxima <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
        
        <div class="text-center text-muted small mt-2">
            Mostrando <strong>@((currentPage - 1) * (ViewBag.PageSize as int? ?? 10) + 1)</strong> a <strong>@(Math.Min(currentPage * (ViewBag.PageSize as int? ?? 10), totalItems))</strong> de <strong>@totalItems</strong> contrato(s)
        </div>
    }
}

@section Scripts {
    <script>
        async function handleGenerateDeclaration(button) {
            const confirmed = await showConfirm(
                'Deseja gerar uma nova declaração de autorização de uso de endereço fiscal para este contrato?',
                'Gerar Declaração',
                'info'
            );
            
            if (confirmed) {
                const form = button.closest('form');
                if (form) {
                    form.submit();
                }
            }
        }
    </script>
}

@model KlyonHubPlatform.Domain.Entities.Client
@using KlyonHubPlatform.Domain.Core.Helpers
@{
    ViewData[ViewDataKeys.Title] = "Dados para o contrato";
    Layout = LayoutPaths.Layout;
    var userEmail = ViewBag.UserEmail as string ?? Model?.ContactEmail;
    var contactNameValue = ClientDisplayName.IsPlaceholderName(Model?.ContactName, userEmail) ? "" : Model?.ContactName;
    var titleSuffix = string.IsNullOrWhiteSpace(contactNameValue) ? "" : " - " + contactNameValue;
    var cnpjDigits = Model?.CNPJ != null ? System.Text.RegularExpressions.Regex.Replace(Model.CNPJ, @"\D", "") : "";
    if (cnpjDigits.Length > 0 && cnpjDigits.All(c => c == '0'))
        cnpjDigits = "";
    var cnpjValue = cnpjDigits.Length == 14 ? Model?.CNPJ : "";
    var cpfObrigatorio = string.IsNullOrEmpty(cnpjDigits) || cnpjDigits.Length < 14;
    var isPj = cnpjDigits.Length == 14;
    var returnUrl = ViewBag.ReturnUrl as string;
    var partyIncomplete = ViewBag.ContractPartyIncomplete as bool? == true;
    var missingFields = ViewBag.ContractPartyMissingFields as IReadOnlyList<string>;
}

<style>
/* Botão Salvar em estado de loading (Client/Profile) */
.profile-save-btn.profile-save-btn-loading {
    background-color: #051323 !important;
    border-color: #051323 !important;
    color: #fff;
}
.profile-save-btn.profile-save-btn-loading .spinner-white {
    color: #fff;
}
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 id="clientProfileTitle"><i class="bi bi-person-badge"></i> Dados para o contrato@(titleSuffix)</h2>
</div>

@if (partyIncomplete)
{
    <div class="alert alert-warning">
        <strong>Preencha todos os campos obrigatórios nesta tela.</strong>
        Esses dados entram no contrato e na declaração. Não use o login ou o prefixo do e-mail como nome.
        @if (missingFields != null && missingFields.Count > 0)
        {
            <div class="small mt-1">Em falta: @string.Join(", ", missingFields).</div>
        }
    </div>
}
else
{
    <p class="text-muted">Estes dados constam no contrato e na declaração. Mantenha-os atualizados nesta única tela.</p>
}

<div class="card">
    <div class="card-header">
        <h5><i class="bi bi-person"></i> Dados Cadastrais</h5>
    </div>
    <div class="card-body">
        <form method="post" action="@Url.Action(ActionNames.UpdateProfile, ControllerNames.Client)" enctype="multipart/form-data" id="clientProfileForm">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }

            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label">Tipo de contratante</label>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PersonType" id="personTypePf" value="Fisica" @(isPj ? "" : "checked")>
                            <label class="form-check-label" for="personTypePf">Pessoa física</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="PersonType" id="personTypePj" value="Juridica" @(isPj ? "checked" : "")>
                            <label class="form-check-label" for="personTypePj">Pessoa jurídica</label>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Seção de Logo -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <label class="form-label"><i class="bi bi-image"></i> Logomarca</label>
                    <div class="d-flex align-items-center gap-3">
                        <div id="logoPreviewContainer" class="border rounded p-2" style="max-width: 200px; max-height: 200px; min-width: 200px; min-height: 150px; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(Model.LogoPath))
                            {
                                <img id="logoCurrentImage" src="@Url.Action(ActionNames.GetLogo, ControllerNames.Client, new { clientId = Model.Id })" 
                                     alt="Logo" 
                                     class="img-fluid" 
                                     style="max-width: 100%; max-height: 200px; object-fit: contain;">
                            }
                            else
                            {
                                <div id="logoPlaceholder" class="text-muted text-center">
                                    <i class="bi bi-image" style="font-size: 3rem;"></i>
                                    <div class="small mt-2">Nenhuma logo</div>
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1">
                            <input type="file" class="form-control" id="Logo" name="Logo" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp">
                            <small class="form-text text-muted d-block mt-1">
                                Formatos aceitos: JPG, PNG, GIF, WEBP. Tamanho máximo: @(ViewBag.MaxPhotoSizeMB ?? 5)MB.
                            </small>
                            <small id="logoPreviewHint" class="form-text text-primary d-none mt-1 d-block">
                                <i class="bi bi-info-circle"></i> Prévia acima. A alteração será salva ao clicar em &quot;Salvar Alterações&quot;.
                            </small>
                            <button type="button" id="logoClearPreviewBtn" class="btn btn-outline-secondary btn-sm mt-1 d-none" title="Desfazer e manter a logo atual">
                                <i class="bi bi-arrow-counterclockwise"></i> Desfazer prévia
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <hr class="my-4">
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="RazaoSocial" class="form-label">Razão Social <span id="razaoRequiredMarker" class="text-danger @(isPj ? "" : "d-none")">*</span></label>
                    <input type="text" class="form-control" id="RazaoSocial" name="RazaoSocial" value="@Model.RazaoSocial" @(isPj ? "required" : "")>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="NomeFantasia" class="form-label">Nome Fantasia</label>
                    <input type="text" class="form-control" id="NomeFantasia" name="NomeFantasia" value="@Model.NomeFantasia">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="CNPJ" class="form-label">CNPJ <span id="cnpjRequiredMarker" class="text-danger @(isPj ? "" : "d-none")">*</span></label>
                    <input type="text" class="form-control" id="CNPJ" name="CNPJ" value="@cnpjValue" placeholder="00.000.000/0000-00" maxlength="18" @(isPj ? "required" : "")>
                    <div class="invalid-feedback"></div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="CPF" class="form-label">CPF <span id="cpfRequiredMarker" class="text-danger @(cpfObrigatorio ? "" : "d-none")">*</span></label>
                    <input type="text" class="form-control" id="CPF" name="CPF" value="@Model.CPF" placeholder="000.000.000-00" maxlength="14" @(cpfObrigatorio ? "required" : "")>
                    <small class="form-text text-muted" id="cpfHelper">Obrigatório para pessoa física. Não necessário se CNPJ estiver preenchido.</small>
                    <div class="invalid-feedback"></div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContactName" class="form-label">Nome Completo <span id="contactNameRequiredMarker" class="text-danger @(isPj ? "d-none" : "")">*</span></label>
                    <input type="text" class="form-control" id="ContactName" name="ContactName" value="@contactNameValue" placeholder="Nome e sobrenome" autocomplete="name" @(isPj ? "" : "required")>
                    <small class="form-text text-muted">Obrigatório para pessoa física. Não use o login ou o prefixo do e-mail.</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ContactEmail" class="form-label">Email de Contato <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="ContactEmail" name="ContactEmail" 
                           value="@ViewBag.UserEmail" readonly required>
                    <small class="form-text text-muted">Este email é o mesmo do seu cadastro e não pode ser alterado.</small>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContactPhone" class="form-label">Telefone <span class="text-danger">*</span></label>
                    @{
                        var phoneValue = Model.ContactPhone;
                        if (!string.IsNullOrEmpty(phoneValue) && phoneValue.Length >= 10)
                        {
                            if (phoneValue.Length == 10)
                            {
                                phoneValue = $"({phoneValue.Substring(0, 2)}) {phoneValue.Substring(2, 4)}-{phoneValue.Substring(6, 4)}";
                            }
                            else if (phoneValue.Length == 11)
                            {
                                phoneValue = $"({phoneValue.Substring(0, 2)}) {phoneValue.Substring(2, 5)}-{phoneValue.Substring(7, 4)}";
                            }
                        }
                    }
                    <input type="text" class="form-control" id="ContactPhone" name="ContactPhone" value="@phoneValue" placeholder="(00) 00000-0000" maxlength="15" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ZipCode" class="form-label">CEP <span class="text-danger">*</span></label>
                    @{
                        var zipCodeValue = Model.ZipCode;
                        if (!string.IsNullOrEmpty(zipCodeValue) && zipCodeValue.Length == 8)
                        {
                            zipCodeValue = $"{zipCodeValue.Substring(0, 5)}-{zipCodeValue.Substring(5, 3)}";
                        }
                    }
                    <div class="input-group">
                        <input type="text" class="form-control" id="ZipCode" name="ZipCode" value="@zipCodeValue" placeholder="00000-000" maxlength="9" required autocomplete="postal-code">
                        <span class="input-group-text d-none" id="zipCodeSpinner">
                            <span class="spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></span>
                        </span>
                    </div>
                    <div id="zipCodeFeedback" class="text-danger small mt-1 d-none"></div>
                    <small class="form-text text-muted">Obrigatório para o contrato. O endereço será preenchido automaticamente.</small>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Address" class="form-label">Endereço (logradouro) <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required>
                </div>
                <div class="col-md-2 mb-3">
                    <label for="AddressNumber" class="form-label">Número <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="AddressNumber" name="AddressNumber" value="@Model.AddressNumber" placeholder="Nº" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="Neighborhood" class="form-label">Bairro <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Neighborhood" name="Neighborhood" value="@Model.Neighborhood" required>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Complement" class="form-label">Complemento</label>
                    <input type="text" class="form-control" id="Complement" name="Complement" value="@Model.Complement" placeholder="Apto, sala, bloco...">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="City" class="form-label">Cidade <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="City" name="City" value="@Model.City" required>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="State" class="form-label">Estado <span class="text-danger">*</span></label>
                    <select class="form-select" id="State" name="State" required>
                        <option value="">Selecione o estado</option>
                        @if (Model.State == "AC") { <option value="AC" selected>AC - Acre</option> } else { <option value="AC">AC - Acre</option> }
                        @if (Model.State == "AL") { <option value="AL" selected>AL - Alagoas</option> } else { <option value="AL">AL - Alagoas</option> }
                        @if (Model.State == "AP") { <option value="AP" selected>AP - Amapá</option> } else { <option value="AP">AP - Amapá</option> }
                        @if (Model.State == "AM") { <option value="AM" selected>AM - Amazonas</option> } else { <option value="AM">AM - Amazonas</option> }
                        @if (Model.State == "BA") { <option value="BA" selected>BA - Bahia</option> } else { <option value="BA">BA - Bahia</option> }
                        @if (Model.State == "CE") { <option value="CE" selected>CE - Ceará</option> } else { <option value="CE">CE - Ceará</option> }
                        @if (Model.State == "DF") { <option value="DF" selected>DF - Distrito Federal</option> } else { <option value="DF">DF - Distrito Federal</option> }
                        @if (Model.State == "ES") { <option value="ES" selected>ES - Espírito Santo</option> } else { <option value="ES">ES - Espírito Santo</option> }
                        @if (Model.State == "GO") { <option value="GO" selected>GO - Goiás</option> } else { <option value="GO">GO - Goiás</option> }
                        @if (Model.State == "MA") { <option value="MA" selected>MA - Maranhão</option> } else { <option value="MA">MA - Maranhão</option> }
                        @if (Model.State == "MT") { <option value="MT" selected>MT - Mato Grosso</option> } else { <option value="MT">MT - Mato Grosso</option> }
                        @if (Model.State == "MS") { <option value="MS" selected>MS - Mato Grosso do Sul</option> } else { <option value="MS">MS - Mato Grosso do Sul</option> }
                        @if (Model.State == "MG") { <option value="MG" selected>MG - Minas Gerais</option> } else { <option value="MG">MG - Minas Gerais</option> }
                        @if (Model.State == "PA") { <option value="PA" selected>PA - Pará</option> } else { <option value="PA">PA - Pará</option> }
                        @if (Model.State == "PB") { <option value="PB" selected>PB - Paraíba</option> } else { <option value="PB">PB - Paraíba</option> }
                        @if (Model.State == "PR") { <option value="PR" selected>PR - Paraná</option> } else { <option value="PR">PR - Paraná</option> }
                        @if (Model.State == "PE") { <option value="PE" selected>PE - Pernambuco</option> } else { <option value="PE">PE - Pernambuco</option> }
                        @if (Model.State == "PI") { <option value="PI" selected>PI - Piauí</option> } else { <option value="PI">PI - Piauí</option> }
                        @if (Model.State == "RJ") { <option value="RJ" selected>RJ - Rio de Janeiro</option> } else { <option value="RJ">RJ - Rio de Janeiro</option> }
                        @if (Model.State == "RN") { <option value="RN" selected>RN - Rio Grande do Norte</option> } else { <option value="RN">RN - Rio Grande do Norte</option> }
                        @if (Model.State == "RS") { <option value="RS" selected>RS - Rio Grande do Sul</option> } else { <option value="RS">RS - Rio Grande do Sul</option> }
                        @if (Model.State == "RO") { <option value="RO" selected>RO - Rondônia</option> } else { <option value="RO">RO - Rondônia</option> }
                        @if (Model.State == "RR") { <option value="RR" selected>RR - Roraima</option> } else { <option value="RR">RR - Roraima</option> }
                        @if (Model.State == "SC") { <option value="SC" selected>SC - Santa Catarina</option> } else { <option value="SC">SC - Santa Catarina</option> }
                        @if (Model.State == "SP") { <option value="SP" selected>SP - São Paulo</option> } else { <option value="SP">SP - São Paulo</option> }
                        @if (Model.State == "SE") { <option value="SE" selected>SE - Sergipe</option> } else { <option value="SE">SE - Sergipe</option> }
                        @if (Model.State == "TO") { <option value="TO" selected>TO - Tocantins</option> } else { <option value="TO">TO - Tocantins</option> }
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary profile-save-btn">
                    <i class="bi bi-check-circle"></i> Salvar Alterações
                </button>
                <a href="@Url.Action(ActionNames.DashboardDetails, ControllerNames.Client)" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Prévia da logomarca ao escolher arquivo (salva apenas ao clicar em Salvar Alterações)
    var logoPreviewContainer = document.getElementById('logoPreviewContainer');
    var logoInput = document.getElementById('Logo');
    var logoPreviewHint = document.getElementById('logoPreviewHint');
    var initialLogoHtml = logoPreviewContainer ? logoPreviewContainer.innerHTML : '';
    var logoClearPreviewBtn = document.getElementById('logoClearPreviewBtn');
    function restoreLogoPreview() {
        logoPreviewContainer.innerHTML = initialLogoHtml;
        if (logoPreviewHint) logoPreviewHint.classList.add('d-none');
        if (logoClearPreviewBtn) logoClearPreviewBtn.classList.add('d-none');
        if (logoInput) logoInput.value = '';
    }
    if (logoInput && logoPreviewContainer) {
        logoInput.addEventListener('change', function() {
            var file = this.files && this.files[0];
            if (file && file.type.indexOf('image/') === 0) {
                var reader = new FileReader();
                reader.onload = function() {
                    logoPreviewContainer.innerHTML = '<img src="' + reader.result + '" alt="Prévia" class="img-fluid" style="max-width:100%;max-height:200px;object-fit:contain;">';
                    if (logoPreviewHint) logoPreviewHint.classList.remove('d-none');
                    if (logoClearPreviewBtn) logoClearPreviewBtn.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            } else {
                restoreLogoPreview();
            }
        });
    }
    if (logoClearPreviewBtn) {
        logoClearPreviewBtn.addEventListener('click', restoreLogoPreview);
    }

    // Pessoa física vs jurídica: campos obrigatórios nesta única tela
    var cnpjInput = document.getElementById('CNPJ');
    var cpfInput = document.getElementById('CPF');
    var cpfMarker = document.getElementById('cpfRequiredMarker');
    var razaoInput = document.getElementById('RazaoSocial');
    var razaoMarker = document.getElementById('razaoRequiredMarker');
    var cnpjMarker = document.getElementById('cnpjRequiredMarker');
    var contactNameInput = document.getElementById('ContactName');
    var contactNameMarker = document.getElementById('contactNameRequiredMarker');
    var personTypePf = document.getElementById('personTypePf');
    var personTypePj = document.getElementById('personTypePj');
    function isPjSelected() {
        if (personTypePj && personTypePj.checked) return true;
        var cnpjVal = (cnpjInput && cnpjInput.value || '').replace(/\D/g, '');
        return cnpjVal.length === 14;
    }
    function updatePersonTypeRequired() {
        var pj = isPjSelected();
        if (cpfInput) {
            if (pj) {
                cpfInput.removeAttribute('required');
                cpfInput.setCustomValidity('');
                if (cpfMarker) cpfMarker.classList.add('d-none');
            } else {
                cpfInput.setAttribute('required', 'required');
                if (cpfMarker) cpfMarker.classList.remove('d-none');
            }
        }
        if (cnpjInput) {
            if (pj) cnpjInput.setAttribute('required', 'required');
            else cnpjInput.removeAttribute('required');
        }
        if (cnpjMarker) cnpjMarker.classList.toggle('d-none', !pj);
        if (razaoInput) {
            if (pj) razaoInput.setAttribute('required', 'required');
            else razaoInput.removeAttribute('required');
        }
        if (razaoMarker) razaoMarker.classList.toggle('d-none', !pj);
        if (contactNameInput) {
            if (pj) contactNameInput.removeAttribute('required');
            else contactNameInput.setAttribute('required', 'required');
        }
        if (contactNameMarker) contactNameMarker.classList.toggle('d-none', pj);
    }
    if (cnpjInput) {
        cnpjInput.addEventListener('input', updatePersonTypeRequired);
        cnpjInput.addEventListener('change', updatePersonTypeRequired);
    }
    if (personTypePf) personTypePf.addEventListener('change', updatePersonTypeRequired);
    if (personTypePj) personTypePj.addEventListener('change', updatePersonTypeRequired);
    updatePersonTypeRequired();

    var form = document.getElementById('clientProfileForm');
    if (!form) return;
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
            form.reportValidity();
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) window.KlyonLoading.hide();
            return;
        }
        var submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.classList.add('profile-save-btn-loading');
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm spinner-white me-1" role="status" aria-hidden="true"></span> Salvando...';
        }
        var formData = new FormData(form);
        var actionUrl = form.action;
        var tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
        var headers = { 'X-Requested-With': 'XMLHttpRequest' };
        if (tokenEl && tokenEl.value) headers['RequestVerificationToken'] = tokenEl.value;
        if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) window.KlyonLoading.show();
        fetch(actionUrl, {
            method: 'POST',
            body: formData,
            headers: headers,
            redirect: 'manual',
            credentials: 'same-origin'
        })
        .then(function(response) {
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) window.KlyonLoading.hide();
            var contentType = response.headers.get('content-type') || '';
            if (contentType.indexOf('application/json') !== -1)
                return response.json();
            return response.text().then(function() { return { success: false, error: 'Resposta inválida do servidor. Tente novamente.' }; });
        })
        .then(function(data) {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('profile-save-btn-loading');
                submitBtn.innerHTML = '<i class="bi bi-check-circle"></i> Salvar Alterações';
            }
            if (!data) return;
            if (data.success === true) {
                if (typeof showToast === 'function') showToast(data.message || 'Perfil atualizado com sucesso!', 'success');
                if (data.warning && typeof showToast === 'function') showToast(data.warning, 'warning');
                if (logoPreviewHint) logoPreviewHint.classList.add('d-none');
                if (logoClearPreviewBtn) logoClearPreviewBtn.classList.add('d-none');
                if (logoInput) logoInput.value = '';
                var headerName = data.displayName || data.contactName;
                if (headerName) {
                    var userNameLink = document.getElementById('userNameLink');
                    if (userNameLink) userNameLink.textContent = headerName;
                    var titleEl = document.getElementById('clientProfileTitle');
                    if (titleEl) titleEl.innerHTML = '<i class="bi bi-person-badge"></i> Dados para o contrato - ' + headerName;
                }
                if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                    return;
                }
            } else if (data.success === false && data.error) {
                if (typeof showToast === 'function') showToast(data.error, 'error');
            }
        })
        .catch(function() {
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) window.KlyonLoading.hide();
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.classList.remove('profile-save-btn-loading');
                submitBtn.innerHTML = '<i class="bi bi-check-circle"></i> Salvar Alterações';
            }
            if (typeof showToast === 'function') showToast('Erro ao processar. Tente novamente.', 'error');
        });
    });

    // ── Busca de endereço por CEP via ViaCEP
    (function () {
        var zipInput     = document.getElementById('ZipCode');
        var zipSpinner   = document.getElementById('zipCodeSpinner');
        var zipFeedback  = document.getElementById('zipCodeFeedback');
        var addressInput = document.getElementById('Address');
        var neighborhoodInput = document.getElementById('Neighborhood');
        var cityInput    = document.getElementById('City');
        var stateSelect  = document.getElementById('State');

        if (!zipInput) return;

        function showZipError(msg) {
            if (zipFeedback) { zipFeedback.textContent = msg; zipFeedback.classList.remove('d-none'); }
            zipInput.classList.add('is-invalid');
        }
        function clearZipError() {
            if (zipFeedback) { zipFeedback.textContent = ''; zipFeedback.classList.add('d-none'); }
            zipInput.classList.remove('is-invalid');
        }

        function fillAddress(data) {
            if (addressInput    && data.logradouro) addressInput.value    = data.logradouro;
            if (neighborhoodInput && data.bairro)   neighborhoodInput.value = data.bairro;
            if (cityInput       && data.localidade) cityInput.value       = data.localidade;
            if (stateSelect && data.uf) {
                var opt = stateSelect.querySelector('option[value="' + data.uf + '"]');
                if (opt) {
                    stateSelect.value = data.uf;
                    // Notifica o Select2 (se presente) para atualizar o componente visual
                    if (typeof $ !== 'undefined' && $(stateSelect).data('select2')) {
                        $(stateSelect).trigger('change');
                    } else {
                        stateSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                }
            }
        }

        function fetchCep(cep) {
            clearZipError();
            if (zipSpinner) zipSpinner.classList.remove('d-none');
            fetch('https://viacep.com.br/ws/' + cep + '/json/')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (zipSpinner) zipSpinner.classList.add('d-none');
                    if (data.erro) {
                        showZipError('CEP não encontrado. Verifique e tente novamente.');
                        return;
                    }
                    fillAddress(data);
                })
                .catch(function () {
                    if (zipSpinner) zipSpinner.classList.add('d-none');
                    showZipError('Não foi possível consultar o CEP. Verifique sua conexão.');
                });
        }

        var lastFetchedCep = '';

        function fetchCepOnce(digits) {
            if (digits.length !== 8 || digits === lastFetchedCep) return;
            lastFetchedCep = digits;
            fetchCep(digits);
        }

        zipInput.addEventListener('input', function () {
            clearZipError();
            var digits = this.value.replace(/\D/g, '');
            if (digits.length < 8) lastFetchedCep = ''; // reseta se o usuário apagar
            fetchCepOnce(digits);
        });

        zipInput.addEventListener('blur', function () {
            fetchCepOnce(this.value.replace(/\D/g, ''));
        });
    }());
});
</script>
}

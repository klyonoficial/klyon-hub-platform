@if (!string.IsNullOrEmpty(Model.ReceiptFilePath))
{
    var receiptUrl = Url.Action("ViewReceipt", "Client", new { paymentId = Model.Id });
    var receiptFileExtension = System.IO.Path.GetExtension(Model.ReceiptFilePath ?? "").ToLowerInvariant();
    if (string.IsNullOrEmpty(receiptFileExtension)) { receiptFileExtension = FileExtensions.Pdf; }
    var receiptIsPdf = receiptFileExtension == FileExtensions.Pdf;
    <!-- Modal Comprovante Enviado (mesmo padrão do Admin/Validar Pagamento) -->
    <div class="modal fade" id="viewReceiptModal" tabindex="-1" aria-labelledby="viewReceiptModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="viewReceiptModalLabel">
                        <i class="bi bi-file-earmark-image"></i> Comprovante Enviado
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="text-muted mb-3" id="viewReceiptUploadDate">
                        <i class="bi bi-calendar"></i> Enviado em: —
                    </p>
                    <div class="border rounded p-3 text-center bg-light" style="min-height: 400px; max-height: 70vh; overflow: auto;">
                        @if (receiptIsPdf)
                        {
                            <div style="width: 100%; height: 70vh;">
                                <embed src="@(receiptUrl)&t=@DateTime.UtcNow.Ticks"
                                       type="application/pdf"
                                       style="width: 100%; height: 100%; border: none;"
                                       frameborder="0">
                                <p class="mt-2 text-muted small">Seu navegador não suporta a visualização de PDFs.</p>
                            </div>
                        }
                        else
                        {
                            <div id="viewReceiptImageContainer">
                                <img id="viewReceiptImage"
                                     src="@(receiptUrl)&t=@DateTime.UtcNow.Ticks"
                                     alt="Comprovante"
                                     class="img-thumbnail"
                                     style="max-width: 100%; max-height: 70vh; object-fit: contain; display: block; margin: 0 auto;"
                                     onclick="window.open('@receiptUrl', '_blank')"
                                     onerror="this.onerror=null; var c=document.getElementById('viewReceiptImageContainer'); if(c){ c.innerHTML='<div class=\'text-danger\'><i class=\'bi bi-exclamation-triangle\'></i><br>Erro ao carregar imagem.<br><a href=\'@receiptUrl\' target=\'_blank\' class=\'btn btn-sm btn-primary mt-2\'>Abrir em nova aba</a></div>'; }">
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <a href="@Url.Action("DownloadReceipt", "Client", new { paymentId = Model.Id })" class="btn btn-primary" target="_blank" download>
                            <i class="bi bi-download"></i> Baixar Comprovante
                        </a>
                        <a href="@receiptUrl" class="btn btn-outline-primary ms-2" target="_blank">
                            <i class="bi bi-box-arrow-up-right"></i> Abrir em Nova Aba
                        </a>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para Adicionar Cartão -->
<div class="modal fade" id="addCardModal" tabindex="-1" aria-labelledby="addCardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCardModalLabel">
                    <i class="bi bi-credit-card"></i> Adicionar Novo Cartão
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("AddCreditCard", "Client")" id="addCardForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@Model.Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="cardNumber" class="form-label">Número do Cartão <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cardNumber" name="cardNumber" 
                               placeholder="0000 0000 0000 0000" maxlength="19" required>
                        <small class="form-text text-muted">Digite apenas os números do cartão</small>
                    </div>
                    <div class="mb-3">
                        <label for="cardHolderName" class="form-label">Nome no Cartão <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cardHolderName" name="cardHolderName" 
                               placeholder="NOME COMO ESTÁ NO CARTÃO" required>
                    </div>
                    <div class="mb-3">
                        <label for="cardNickname" class="form-label">Apelido do cartão</label>
                        <input type="text" class="form-control" id="cardNickname" name="nickname" 
                               placeholder="Ex.: Cartão pessoal, Nubank" maxlength="100">
                        <small class="form-text text-muted">Opcional. Use para identificar este cartão nas listas.</small>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="expiryMonth" class="form-label">Mês <span class="text-danger">*</span></label>
                            <select class="form-select" id="expiryMonth" name="expiryMonth" required>
                                <option value="">MM</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i.ToString("00")">@i.ToString("00")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="expiryYear" class="form-label">Ano <span class="text-danger">*</span></label>
                            <select class="form-select" id="expiryYear" name="expiryYear" required>
                                <option value="">AAAA</option>
                                @for (int year = DateTime.Now.Year; year <= DateTime.Now.Year + 10; year++)
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="cvv" class="form-label">CVV <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cvv" name="cvv" 
                               placeholder="000" maxlength="4" required>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isDefault" name="isDefault" value="true">
                        <label class="form-check-label" for="isDefault">
                            Definir como cartão padrão
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar Cartão
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (isPending && Model.Method == PaymentMethod.CreditCard)
{
    var totalAmountForCard = ViewBag.FinalAmount ?? Model.Amount;
    var addressCard = Model.Subscription?.Contract?.CoworkingAddress;
    decimal? cardPrice1x = addressCard?.CardPrice1x;
    decimal? cardPriceMonthly = addressCard?.CardPriceMonthly;
    var has1x = cardPrice1x.HasValue && cardPrice1x.Value > 0;
    var hasMonthly = cardPriceMonthly.HasValue && cardPriceMonthly.Value > 0;
    if (!has1x && !hasMonthly) { has1x = true; cardPrice1x = (decimal)totalAmountForCard; }
    var creditCardsJson = "[]";
    if (ViewBag.CreditCards != null && ((List<KlyonHubPlatform.Domain.Entities.CreditCard>)ViewBag.CreditCards).Any())
    {
        var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
        var cards = ((List<KlyonHubPlatform.Domain.Entities.CreditCard>)ViewBag.CreditCards)
            .Select(c => new {
                id = c.Id,
                cardHolderName = c.CardHolderName ?? "",
                expiryMonth = !string.IsNullOrEmpty(c.ExpiryMonth) && c.ExpiryMonth.Length == 1 ? "0" + c.ExpiryMonth : (c.ExpiryMonth ?? ""),
                expiryYear = c.ExpiryYear ?? "",
                lastFourDigits = c.LastFourDigits ?? "",
                brand = c.Brand ?? "",
                nickname = string.IsNullOrWhiteSpace(c.Nickname) ? null : c.Nickname.Trim(),
                hasToken = !string.IsNullOrEmpty(c.AsaasToken),
                isDefault = c.IsDefault
            })
            .ToList();
        creditCardsJson = System.Text.Json.JsonSerializer.Serialize(cards, jsonOptions);
    }

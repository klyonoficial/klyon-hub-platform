@model KlyonHubPlatform.Domain.Entities.Payment
@using KlyonHubPlatform.Domain.Core.Enums
@using KlyonHubPlatform.Domain.Core.Constants
@using KlyonHubPlatform.Application.Helpers
@{
    ViewData[ViewDataKeys.Title] = "Detalhes do Pagamento";
    var isPaymentOwner = ViewBag.IsPaymentOwner as bool? ?? true;
    var contract = Model.Subscription?.Contract;
    var reservation = Model.Reservation;
    var isPending = Model.Status == PaymentStatus.Pending;
    var isAwaitingValidation = Model.Status == PaymentStatus.AwaitingValidation;
    var isPix = Model.Method == PaymentMethod.PIX;
    // PIX único: código e expiração em Payments (PixCode, PixExpiresAt). PIX Automático: em Subscriptions (PixAutomaticPayload, PixAutomaticPayloadExpiresAt)
    var isPixAutomatic = isPix && contract?.CardPlanType.IsPixAutomatic() == true;
    var isPixAnnual = isPix && contract?.CardPlanType == ContractCardPlanType.PixAnnual;
    var isPixMonthly = isPix && contract?.CardPlanType == ContractCardPlanType.PixMonthly;
    var effectivePixCode = isPixAutomatic ? (Model.Subscription?.PixAutomaticPayload) : Model.PixCode;
    var effectivePixExpiresAt = isPixAutomatic ? Model.Subscription?.PixAutomaticPayloadExpiresAt : Model.PixExpiresAt;
    var pixExpiresAtUtc = effectivePixExpiresAt.HasValue ? (effectivePixExpiresAt.Value.Kind == DateTimeKind.Utc ? effectivePixExpiresAt.Value : DateTime.SpecifyKind(effectivePixExpiresAt.Value, DateTimeKind.Utc)) : (DateTime?)null;
    var isExpired = pixExpiresAtUtc.HasValue && pixExpiresAtUtc.Value < DateTime.UtcNow;
    var hiddenPaymentOptions = ViewBag.HiddenPaymentOptions as IReadOnlySet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var showPixAnnualInDropdown = !hiddenPaymentOptions.Contains("PixAnnual");
    var showPixMonthlyInDropdown = !hiddenPaymentOptions.Contains("PixMonthly");
    var showPixSingleInDropdown = !hiddenPaymentOptions.Contains("PIX");
    var showPixInDropdown = showPixAnnualInDropdown || showPixMonthlyInDropdown || showPixSingleInDropdown;
    var snapshotListPrice = ViewBag.SnapshotListPrice as decimal? ?? (contract?.SnapshotListPrice > 0 ? contract.SnapshotListPrice : Model.SnapshotListPrice > 0 ? Model.SnapshotListPrice : Model.Amount);
    var snapshotPrice1x = ViewBag.SnapshotPrice1x as decimal? ?? snapshotListPrice;
    var snapshotPriceMonthly = ViewBag.SnapshotPriceMonthly as decimal? ?? snapshotListPrice;
    var addressHasCard1x = snapshotListPrice > 0 && !hiddenPaymentOptions.Contains("Card1x");
    var addressHasCardMonthly = snapshotListPrice > 0 && !hiddenPaymentOptions.Contains("CardMonthly");
    var showCreditCardInDropdown = (addressHasCard1x || addressHasCardMonthly) && (!hiddenPaymentOptions.Contains("Card1x") || !hiddenPaymentOptions.Contains("CardMonthly"));
    var showCard1x = addressHasCard1x && !hiddenPaymentOptions.Contains("Card1x");
    var showCardMonthly = addressHasCardMonthly && !hiddenPaymentOptions.Contains("CardMonthly");
    var showBoletoInDropdown = !hiddenPaymentOptions.Contains("Boleto");
    var currentPixPlanValue = isPixAnnual ? "PixAnnual" : (isPixMonthly ? "PixMonthly" : "PIX");
    var currentMethodValue = isPix ? "PIX" : Model.Method.ToString();
    // Quando qualquer opção está em HiddenPaymentOptions (PixAnnual, PixMonthly, PIX, Card1x, CardMonthly, Boleto): carregar a tela da primeira opção disponível (fallback)
    var showPixCard = isPending && (
        (Model.Method == PaymentMethod.PIX && showPixInDropdown) ||
        (Model.Method == PaymentMethod.CreditCard && !showCreditCardInDropdown && showPixInDropdown) ||
        (Model.Method == PaymentMethod.BankTransfer && !showBoletoInDropdown && showPixInDropdown));
    var showCreditCardSection = (Model.Method == PaymentMethod.CreditCard && showCreditCardInDropdown) ||
        (Model.Method == PaymentMethod.PIX && !showPixInDropdown && showCreditCardInDropdown) ||
        (Model.Method == PaymentMethod.BankTransfer && !showBoletoInDropdown && showCreditCardInDropdown);
    var showBoletoSection = isPending && (
        (Model.Method == PaymentMethod.BankTransfer && showBoletoInDropdown) ||
        (Model.Method == PaymentMethod.PIX && !showPixInDropdown && !showCreditCardInDropdown && showBoletoInDropdown) ||
        (Model.Method == PaymentMethod.CreditCard && !showCreditCardInDropdown && showBoletoInDropdown));
    var cardHolderPostalCode = ViewBag.CardHolderPostalCode as string ?? "";
    var cardHolderAddressNumber = ViewBag.CardHolderAddressNumber as string ?? "";
    var cardHolderHasNoNumber = ViewBag.CardHolderHasNoNumber as bool? ?? false;
}

<style>
    .card-holder-billing .form-label { font-size: 1.05rem; font-weight: 600; }
    .card-holder-billing .form-control,
    #payWithCardModal .form-control,
    #payWithCardModal .form-select,
    #payWithCardModal .btn,
    #addCardModal .form-control,
    #addCardModal .form-select,
    #addCardModal .btn {
        min-height: 44px;
    }
    .card-holder-billing .form-check {
        min-height: 44px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .card-holder-billing .form-check-input {
        width: 1.25rem;
        height: 1.25rem;
        margin-top: 0;
        flex-shrink: 0;
    }
    .card-holder-billing .form-check-label {
        font-size: 1rem;
        padding: 8px 0;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-credit-card"></i> Detalhes do Pagamento</h2>
    <a href="@(User.IsInRole("Administrator") ? Url.Action("Payments", "Admin") : Url.Action("MyPayments", "Client"))" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>
@if (!isPaymentOwner)
{
    <div class="alert alert-info mb-4" role="alert">
        <i class="bi bi-eye"></i> <strong>Visualização somente leitura.</strong> Você está visualizando este pagamento como administrador; nenhum campo pode ser alterado.
    </div>
}
@if (isPending && isPaymentOwner && showPixInDropdown)
{
    <div class="alert alert-primary border-0 shadow-sm mb-4" role="status">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-qr-code fs-4"></i>
            <div>
                <strong>PIX recomendado</strong>: confirmação rápida e sem taxas extras.
                <span class="d-block small mt-1 opacity-75">Cartão e boleto ficam em <em>Outras formas de pagamento</em>, abaixo do QR Code.</span>
            </div>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4" id="paymentInfoCard">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informações do Pagamento</h5>
            </div>
            <div class="card-body" id="paymentInfoBody">
                <dl class="row">
                    @if (Model.SubscriptionId.HasValue && contract != null)
                    {
                        <dt class="col-sm-4">Número do Contrato:</dt>
                        <dd class="col-sm-8"><strong>@contract.ContractNumber</strong></dd>

                        @if (contract.CoworkingAddress?.Coworking != null)
                        {
                            <dt class="col-sm-4">Parceiro/Coworking:</dt>
                            <dd class="col-sm-8">
                                <strong>@contract.CoworkingAddress.Coworking.Name</strong>
                            </dd>
                        }

                        <dt class="col-sm-4">Endereço:</dt>
                        <dd class="col-sm-8">
                            @{
                                var hasAddress = !string.IsNullOrWhiteSpace(contract.CoworkingAddress?.Address);
                                var hasCity = !string.IsNullOrWhiteSpace(contract.CoworkingAddress?.City);
                                var hasState = !string.IsNullOrWhiteSpace(contract.CoworkingAddress?.State);
                                
                                if (hasAddress || hasCity || hasState)
                                {
                                    var addressParts = new List<string>();
                                    if (hasAddress)
                                    {
                                        addressParts.Add(contract.CoworkingAddress.Address);
                                    }
                                    if (hasCity && hasState)
                                    {
                                        addressParts.Add($"{contract.CoworkingAddress.City}/{contract.CoworkingAddress.State}");
                                    }
                                    else if (hasCity)
                                    {
                                        addressParts.Add(contract.CoworkingAddress.City);
                                    }
                                    else if (hasState)
                                    {
                                        addressParts.Add(contract.CoworkingAddress.State);
                                    }
                                    <text>@string.Join(", ", addressParts)</text>
                                }
                            }
                        </dd>
                    }
                    else if (Model.ReservationId.HasValue && reservation != null)
                    {
                        <dt class="col-sm-4">Tipo:</dt>
                        <dd class="col-sm-8"><strong>Pagamento de Reserva</strong></dd>
                        
                        <dt class="col-sm-4">Reserva ID:</dt>
                        <dd class="col-sm-8"><strong>#@Model.ReservationId</strong></dd>
                        
                        <dt class="col-sm-4">Coworking:</dt>
                        <dd class="col-sm-8">
                            @reservation.CoworkingAddress?.Coworking?.Name<br>
                            <small class="text-muted">@reservation.CoworkingAddress?.City/@reservation.CoworkingAddress?.State</small>
                        </dd>
                        
                        <dt class="col-sm-4">Data da Reserva:</dt>
                        <dd class="col-sm-8">@reservation.ReservationDate.ToString(DateFormatConstants.DisplayDateOnly)</dd>
                        
                        @if (reservation.StartTime.HasValue && reservation.EndTime.HasValue)
                        {
                            <dt class="col-sm-4">Horário:</dt>
                            <dd class="col-sm-8">@reservation.StartTime.Value.ToString(@"hh\:mm") - @reservation.EndTime.Value.ToString(@"hh\:mm")</dd>
                        }
                        
                        <dt class="col-sm-4">Tipo de Sala:</dt>
                        <dd class="col-sm-8">@(reservation.RoomType == "Shared" ? "Compartilhada" : "Privativa")</dd>
                    }

                    <dt class="col-sm-4">Valor:</dt>
                    <dd class="col-sm-8">
                        @if (showCreditCardSection && isPending)
                        {
                            var price1xVal = snapshotPrice1x;
                            var priceMonthlyVal = snapshotPriceMonthly;
                            var has1xVal = showCard1x;
                            var hasMonthlyVal = showCardMonthly;
                            var use1xAsInitial = showCard1x;
                            var initialVal = use1xAsInitial ? price1xVal : priceMonthlyVal;
                            var initialLabel = use1xAsInitial ? "recorrência anual, equivale a R$ " + ((initialVal / 12m).ToString(NumberFormatConstants.CurrencyTwoDecimals)) + "/mês" : "recorrência mensal";
                            var price1xStr = price1xVal.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture);
                            var priceMonthlyStr = priceMonthlyVal.ToString(NumberFormatConstants.TwoDecimals, System.Globalization.CultureInfo.InvariantCulture);
                            <div id="paymentInfoValorContainer" data-card-price-1x="@price1xStr" data-card-price-monthly="@priceMonthlyStr">
                                <h4 class="text-primary mb-0">R$ <span id="paymentInfoValorDisplay">@initialVal.ToString(NumberFormatConstants.CurrencyTwoDecimals)</span></h4>
                                <small class="text-muted d-block mt-1" id="paymentInfoValorLabel">@initialLabel</small>
                            </div>
                        }
                        else if (Model.Method == PaymentMethod.CreditCard && ViewBag.FeePercentage != null && ViewBag.FeePercentage > 0)
                        {
                            <div>
                                <h4 class="text-primary mb-0">R$ @ViewBag.FinalAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h4>
                                <small class="text-muted">
                                    Valor original: R$ @ViewBag.OriginalAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)
                                    <br>
                                    <span class="text-warning">
                                        <i class="bi bi-info-circle"></i> Taxa de cartão de crédito: @ViewBag.FeePercentage.ToString(NumberFormatConstants.CurrencyTwoDecimals)%
                                    </span>
                                    @if (Model.InstallmentCount.HasValue && Model.InstallmentValue.HasValue)
                                    {
                                        <br>
                                        <span><i class="bi bi-credit-card-2-back"></i> Parcelado em <strong>@Model.InstallmentCount.Value x</strong> de <strong>R$ @Model.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></span>
                                    }
                                </small>
                            </div>
                        }
                        else
                        {
                            <h4 class="text-primary mb-0">R$ @Model.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</h4>
                            @if (Model.SnapshotDiscountAmount > 0)
                            {
                                var grossBeforeDiscount = Model.Amount + Model.SnapshotDiscountAmount;
                                <small class="text-success d-block mt-1">
                                    <i class="bi bi-tag"></i> Cupom @Model.PromoCodeSnapshot aplicado: desconto de R$ @Model.SnapshotDiscountAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)
                                    @if (grossBeforeDiscount > Model.Amount)
                                    {
                                        <span class="text-muted">(de R$ @grossBeforeDiscount.ToString(NumberFormatConstants.CurrencyTwoDecimals))</span>
                                    }
                                </small>
                            }
                            @if (Model.Method == PaymentMethod.PIX)
                            {
                                var pixPlan = contract?.CardPlanType;
                                if (pixPlan == ContractCardPlanType.PixMonthly)
                                {
                                    <small class="text-muted d-block mt-1">recorrência mensal</small>
                                }
                                else if (pixPlan == ContractCardPlanType.PixAnnual || pixPlan == ContractCardPlanType.None || !pixPlan.HasValue)
                                {
                                    var pixMonthlyEq = Model.Amount / 12m;
                                    <small class="text-muted d-block mt-1">@(pixPlan == ContractCardPlanType.PixAnnual ? "recorrência anual" : "pagamento único (anual)")</small>
                                    <small class="text-muted d-block mt-1">equivale a R$ @pixMonthlyEq.ToString(NumberFormatConstants.CurrencyTwoDecimals)/mês</small>
                                }
                            }
                            else if (Model.Method == PaymentMethod.CreditCard && Model.InstallmentCount.HasValue && Model.InstallmentValue.HasValue)
                            {
                                <small class="text-muted d-block mt-1"><i class="bi bi-credit-card-2-back"></i> Parcelado em <strong>@Model.InstallmentCount.Value x</strong> de <strong>R$ @Model.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong></small>
                            }
                        }
                    </dd>

                    @{
                        var hasPromoApplied = Model.PromoCodeId != null
                            || Model.SnapshotDiscountAmount > 0
                            || !string.IsNullOrEmpty(Model.PromoCodeSnapshot);
                    }
                    @if (isPending && isPaymentOwner && contract != null)
                    {
                        <dt class="col-sm-4">Cupom:</dt>
                        <dd class="col-sm-8">
                            @if (hasPromoApplied)
                            {
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <span class="badge text-bg-success">
                                        <i class="bi bi-tag"></i>
                                        @(string.IsNullOrEmpty(Model.PromoCodeSnapshot) ? "Cupom aplicado" : Model.PromoCodeSnapshot)
                                        @if (Model.SnapshotDiscountAmount > 0)
                                        {
                                            <text>- R$ @Model.SnapshotDiscountAmount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</text>
                                        }
                                    </span>
                                    <form method="post" action="@Url.Action("RemovePromoCode", "Client")" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-x-circle"></i> Remover cupom
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("ApplyPromoCode", "Client")" class="row g-2 align-items-center" id="applyPromoCodeForm">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="paymentId" value="@Model.Id" />
                                    <input type="hidden" name="cardPlanOption" id="promoCardPlanOption" value="@(contract?.CardPlanType == ContractCardPlanType.CardMonthly ? "monthly" : "1x")" />
                                    <div class="col-auto flex-grow-1" style="min-width: 180px;">
                                        <input type="text" name="promoCode" class="form-control" placeholder="Código promocional" maxlength="50" autocomplete="off" />
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-tag"></i> Aplicar
                                        </button>
                                    </div>
                                </form>
                            }
                        </dd>
                    }

                    <dt class="col-sm-4">Método de Pagamento:</dt>
                    <dd class="col-sm-8">
                        @if (isPending && isPaymentOwner)
                        {
                            @if (!showPixInDropdown && !showCreditCardInDropdown && !showBoletoInDropdown)
                            {
                                <p class="text-danger mb-0"><i class="bi bi-exclamation-triangle"></i> Nenhuma forma de pagamento disponível no momento. Entre em contato com o suporte.</p>
                            }
                            else
                            {
                            var defaultPixPlanForSwitch = showPixAnnualInDropdown ? "PixAnnual" : (showPixMonthlyInDropdown ? "PixMonthly" : "PIX");
                            <form method="post" action="@Url.Action("UpdatePaymentMethod", "Client")" id="paymentMethodForm" class="d-inline" data-action-url="@Url.Action("UpdatePaymentMethod", "Client")" data-default-pix-plan="@defaultPixPlanForSwitch">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="paymentId" value="@Model.Id" />
                                <select name="method" id="paymentMethodSelect" class="form-select d-inline-block no-select2" style="width: auto; min-width: 200px;" onchange="updatePaymentMethod(this)" data-previous-value="@currentMethodValue" data-default-pix-plan="@defaultPixPlanForSwitch">
                                    @if (showPixInDropdown)
                                    {
                                        if (isPix)
                                        {
                                            <option value="PIX" selected>PIX</option>
                                        }
                                        else
                                        {
                                            <option value="PIX">PIX</option>
                                        }
                                    }
                                    @if (showCreditCardInDropdown)
                                    {
                                        if (currentMethodValue == "CreditCard")
                                        {
                                            <option value="CreditCard" selected>Cartão de Crédito</option>
                                        }
                                        else
                                        {
                                            <option value="CreditCard">Cartão de Crédito</option>
                                        }
                                    }
                                    @if (showBoletoInDropdown)
                                    {
                                        if (Model.Method == PaymentMethod.BankTransfer)
                                        {
                                            <option value="BankTransfer" selected>Boleto Bancário</option>
                                        }
                                        else
                                        {
                                            <option value="BankTransfer">Boleto Bancário</option>
                                        }
                                    }
                                </select>
                            </form>
                            @if (Model.Method == PaymentMethod.PIX && (showPixAnnualInDropdown || showPixMonthlyInDropdown || showPixSingleInDropdown))
                            {
                                var pixPriceAnnual = snapshotPrice1x;
                                var pixPriceMonthly = snapshotPriceMonthly;
                                var pixAnnualMonthlyEq = pixPriceAnnual / 12m;
                                var pixPlanChecked = currentPixPlanValue;
                                if (pixPlanChecked == "PixAnnual" && !showPixAnnualInDropdown)
                                    pixPlanChecked = showPixMonthlyInDropdown ? "PixMonthly" : (showPixSingleInDropdown ? "PIX" : pixPlanChecked);
                                else if (pixPlanChecked == "PixMonthly" && !showPixMonthlyInDropdown)
                                    pixPlanChecked = showPixAnnualInDropdown ? "PixAnnual" : (showPixSingleInDropdown ? "PIX" : pixPlanChecked);
                                else if (pixPlanChecked == "PIX" && !showPixSingleInDropdown)
                                    pixPlanChecked = showPixAnnualInDropdown ? "PixAnnual" : (showPixMonthlyInDropdown ? "PixMonthly" : pixPlanChecked);
                                <div class="mt-3 pt-2 border-top" id="pagePixPlanOptionWrap" data-current-pix-plan="@currentPixPlanValue">
                                    <label class="form-label fw-semibold">Forma de cobrança <span class="text-danger">*</span></label>
                                    @if (showPixAnnualInDropdown)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="pagePixPlanOption" id="pagePixPlanAnnual" value="PixAnnual" @(pixPlanChecked == "PixAnnual" ? "checked" : "")>
                                            <label class="form-check-label" for="pagePixPlanAnnual">
                                                PIX Automático (anual): autorize uma vez; débitos anuais após a 1ª liquidação. R$ @pixPriceAnnual.ToString(NumberFormatConstants.CurrencyTwoDecimals) (equivale a R$ @pixAnnualMonthlyEq.ToString(NumberFormatConstants.CurrencyTwoDecimals)/mês)
                                            </label>
                                        </div>
                                    }
                                    @if (showPixMonthlyInDropdown)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="pagePixPlanOption" id="pagePixPlanMonthly" value="PixMonthly" @(pixPlanChecked == "PixMonthly" ? "checked" : "")>
                                            <label class="form-check-label" for="pagePixPlanMonthly">
                                                PIX Automático (mensal): autorize uma vez; débitos mensais após a 1ª liquidação. R$ @pixPriceMonthly.ToString(NumberFormatConstants.CurrencyTwoDecimals)
                                            </label>
                                        </div>
                                    }
                                    @if (showPixSingleInDropdown)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="pagePixPlanOption" id="pagePixPlanSingle" value="PIX" @(pixPlanChecked == "PIX" ? "checked" : "")>
                                            <label class="form-check-label" for="pagePixPlanSingle">
                                                PIX (pagamento único): pague o primeiro ano via PIX; depois você pode renovar manualmente ou escolher outra forma. R$ @pixPriceAnnual.ToString(NumberFormatConstants.CurrencyTwoDecimals) (equivale a R$ @pixAnnualMonthlyEq.ToString(NumberFormatConstants.CurrencyTwoDecimals)/mês)
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                            @if (showCreditCardSection)
                            {
                                var pagePrice1x = snapshotPrice1x;
                                var pagePriceMonthly = snapshotPriceMonthly;
                                var pageHas1x = showCard1x;
                                var pageHasMonthly = showCardMonthly;
                                var pageShowCard1x = showCard1x;
                                var pageShowCardMonthly = showCardMonthly;
                                var pageCardFirstChecked = contract?.CardPlanType == ContractCardPlanType.CardMonthly ? "monthly" : (pageShowCard1x ? "1x" : (pageShowCardMonthly ? "monthly" : ""));
                                <div class="mt-3 pt-2 border-top" id="pageCardPlanOptionWrap">
                                    @if (!pageShowCard1x && !pageShowCardMonthly)
                                    {
                                        <p class="text-danger mb-0"><i class="bi bi-exclamation-triangle"></i> Nenhuma forma de pagamento disponível no momento. Entre em contato com o suporte.</p>
                                    }
                                    else
                                    {
                                        <label class="form-label fw-semibold">Forma de cobrança <span class="text-danger">*</span></label>
                                        <div id="pageCardPlanOptionError" class="alert alert-danger py-2 mt-1 mb-2 d-none" role="alert">Selecione a forma de cobrança antes de clicar em "Pagar com cartão".</div>
                                        @if (pageShowCard1x)
                                        {
                                            var pageMonthly1x = pagePrice1x / 12m;
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="pageCardPlanOption" id="pageCardPlan1x" value="1x" @(pageCardFirstChecked == "1x" ? "checked" : "")>
                                                <label class="form-check-label" for="pageCardPlan1x">1x à vista (recorrência anual): R$ @pagePrice1x.ToString(NumberFormatConstants.CurrencyTwoDecimals) (equivale a R$ @pageMonthly1x.ToString(NumberFormatConstants.CurrencyTwoDecimals)/mês)</label>
                                            </div>
                                        }
                                        @if (pageShowCardMonthly)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="pageCardPlanOption" id="pageCardPlanMonthly" value="monthly" @(pageCardFirstChecked == "monthly" ? "checked" : "")>
                                                <label class="form-check-label" for="pageCardPlanMonthly">Mensal (recorrência mensal): R$ @pagePriceMonthly.ToString(NumberFormatConstants.CurrencyTwoDecimals)</label>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                            }
                        }
                        else if (isPending && !isPaymentOwner)
                        {
                            @switch (Model.Method)
                            {
                                case PaymentMethod.PIX:
                                    var pixLabelRo = contract?.CardPlanType == ContractCardPlanType.PixAnnual
                                        ? "PIX Automático (anual)"
                                        : contract?.CardPlanType == ContractCardPlanType.PixMonthly
                                            ? "PIX Automático (mensal)"
                                            : "PIX (pagamento único)";
                                    <span class="badge bg-primary"><i class="bi bi-qr-code"></i> @pixLabelRo</span>
                                    break;
                                case PaymentMethod.CreditCard:
                                    <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão de Crédito</span>
                                    @if (ViewBag.CreditCardPlanLabel != null)
                                    {
                                        <span class="text-muted ms-2">(@ViewBag.CreditCardPlanLabel)</span>
                                    }
                                    @if (Model.InstallmentCount.HasValue && Model.InstallmentValue.HasValue)
                                    {
                                        <span class="text-muted ms-2">(@Model.InstallmentCount.Value x de R$ @Model.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals))</span>
                                    }
                                    break;
                                case PaymentMethod.BankTransfer:
                                    <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto Bancário</span>
                                    break;
                            }
                        }
                        else
                        {
                            @switch (Model.Method)
                            {
                                case PaymentMethod.PIX:
                                    var pixLabel = contract?.CardPlanType == ContractCardPlanType.PixAnnual
                                        ? "PIX Automático (anual)"
                                        : contract?.CardPlanType == ContractCardPlanType.PixMonthly
                                            ? "PIX Automático (mensal)"
                                            : "PIX (pagamento único)";
                                    <span class="badge bg-primary"><i class="bi bi-qr-code"></i> @pixLabel</span>
                                    break;
                                case PaymentMethod.CreditCard:
                                    <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão de Crédito</span>
                                    @if (ViewBag.CreditCardPlanLabel != null)
                                    {
                                        <span class="text-muted ms-2">(@ViewBag.CreditCardPlanLabel)</span>
                                    }
                                    @if (Model.InstallmentCount.HasValue && Model.InstallmentValue.HasValue)
                                    {
                                        <span class="text-muted ms-2">(@Model.InstallmentCount.Value x de R$ @Model.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals))</span>
                                    }
                                    break;
                                case PaymentMethod.BankTransfer:
                                    <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto Bancário</span>
                                    break;
                            }
                        }
                    </dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Status)
                        {
                            case PaymentStatus.Pending:
                                <span class="badge bg-pending-payment">
                                    <i class="bi bi-cash-coin me-1"></i> Aguardando Pagamento
                                </span>
                                break;
                        
                            case PaymentStatus.Processing:
                                <span class="badge bg-suspended">
                                    <i class="bi bi-arrow-repeat me-1"></i> Processando
                                </span>
                                break;
                        
                            case PaymentStatus.AwaitingValidation:
                                <span class="badge bg-pending-payment">
                                    <i class="bi bi-clock-history me-1"></i> Aguardando Validação
                                </span>
                                break;
                        
                            case PaymentStatus.Paid:
                                <span class="badge bg-active">
                                    <i class="bi bi-check-circle-fill me-1"></i> Pago
                                </span>
                                break;
                        
                            case PaymentStatus.Failed:
                                <span class="badge bg-cancelled">
                                    <i class="bi bi-x-circle-fill me-1"></i> Falhou
                                </span>
                                break;
                        
                            case PaymentStatus.Cancelled:
                                <span class="badge bg-cancelled">
                                    <i class="bi bi-x-circle-fill me-1"></i> Cancelado
                                </span>
                                break;
                        
                            case PaymentStatus.Refunded:
                                <span class="badge bg-expired">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i> Estornado
                                </span>
                                break;
                        
                            default:
                                <span class="badge bg-expired">
                                    <i class="bi bi-question-circle-fill me-1"></i> @Model.Status
                                </span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Data de Vencimento:</dt>
                    <dd class="col-sm-8">
                        @Model.DueDate.ToString(DateFormatConstants.DisplayDateOnly)
                        @if (Model.DueDate < DateTime.UtcNow && isPending)
                        {
                            <span class="badge bg-cancelled ms-2">Vencido</span>
                        }
                    </dd>

                    @if (Model.PaidAt.HasValue)
                    {
                        <dt class="col-sm-4">Data do Pagamento:</dt>
                        <dd class="col-sm-8">@Model.PaidAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.TransactionId))
                    {
                        <dt class="col-sm-4">ID da Transação:</dt>
                        <dd class="col-sm-8"><code>@Model.TransactionId</code></dd>
                    }
                </dl>
            </div>
        </div>

        @if (isPending)
        {
            @if (showPixCard)
            {
                <div class="card mb-4" id="pixPaymentCard">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-qr-code"></i> Código PIX</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (isExpired)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> <strong>Este código PIX expirou.</strong>
                                @if (isPaymentOwner)
                                {
                                    <p class="mb-2 mt-2">Clique no botão abaixo para gerar um novo código e realizar o pagamento.</p>
                                    <form method="post" action="@Url.Action("GeneratePixCode", "Client")" class="d-inline generate-pix-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@Model.Id" />
                                        <input type="hidden" name="pixPlanType" class="generate-pix-plan-input" value="@currentPixPlanValue" />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-qr-code"></i> Gerar novo código PIX
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <p class="mb-0 mt-2 text-muted">Visualização somente leitura.</p>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(effectivePixCode))
                        {
                            <div class="mb-3">
                                <div id="qrcode" class="d-inline-block p-3 bg-white border rounded"></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Código PIX Copia e Cola:</strong></label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="pixCode" value="@effectivePixCode" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyPixCode(event)">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>
                            <p class="text-muted">
                                <i class="bi bi-info-circle"></i> 
                                @if (effectivePixExpiresAt.HasValue)
                                {
                                    <text>Este código expira em: @effectivePixExpiresAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)</text>
                                }
                                else
                                {
                                    <text>Escaneie o QR Code ou copie o código para pagar via PIX</text>
                                }
                            </p>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> 
                                <strong>Código PIX não gerado.</strong>
                                @if (isPaymentOwner)
                                {
                                    <p class="mb-2 mt-2">Clique no botão abaixo para gerar o código PIX agora.</p>
                                    <form method="post" action="@Url.Action("GeneratePixCode", "Client")" class="d-inline generate-pix-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="paymentId" value="@Model.Id" />
                                        <input type="hidden" name="pixPlanType" class="generate-pix-plan-input" value="@currentPixPlanValue" />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-qr-code"></i> Gerar Código PIX
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <p class="mb-0 mt-2 text-muted">Visualização somente leitura.</p>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (showBoletoSection)
            {
                <div class="card mb-4" id="boletoPaymentCard">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-bank"></i> Boleto Bancário</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.BoletoCode))
                        {
                            @* Copiar sempre clicáveis (inclusive para admin) para repassar códigos ao usuário *@
                            <div class="mb-3">
                                <label class="form-label"><strong>Código de Barras (44 dígitos):</strong></label>
                                <p class="text-muted small mb-1">Para leitura por equipamento de código de barras.</p>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" id="boletoBarcode" value="@Model.BoletoBarcode" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyBoletoBarcode(event)">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Linha Digitável (47 caracteres):</strong></label>
                                <p class="text-muted small mb-1">Para digitação no internet banking ou aplicativo do banco.</p>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" id="boletoCode" value="@Model.BoletoCode" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyBoletoCode(event)">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.BankSlipUrl))
                            {
                                @* Link sempre clicável (inclusive para admin) para permitir emitir/visualizar o boleto para o usuário *@
                                <div class="mb-3">
                                    <a href="@Model.BankSlipUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                                        <i class="bi bi-file-earmark-pdf"></i> Abrir boleto (PDF)
                                    </a>
                                    <p class="text-muted small mb-0 mt-1">Clique para visualizar ou imprimir o boleto em PDF.</p>
                                </div>
                            }
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                <strong>Instruções:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Pague o boleto em qualquer banco, lotérica ou aplicativo bancário</li>
                                    <li>O boleto vence em: <strong>@((Model.BoletoExpiresAt ?? Model.DueDate).ToString(DateFormatConstants.DisplayDateOnly))</strong></li>
                                    <li>Após o pagamento, envie o comprovante para validação</li>
                                </ul>
                            </div>
                            @if (User.IsInRole("Administrator") && ViewBag.BoletoValidationValid != null)
                            {
                                @if (ViewBag.BoletoValidationValid == true)
                                {
                                    <p class="text-success small mb-0"><i class="bi bi-check-circle"></i> @(ViewBag.BoletoValidationMessage ?? "Validação FEBRABAN: dígitos verificadores conferem.")</p>
                                }
                                else
                                {
                                    <p class="text-warning small mb-0"><i class="bi bi-exclamation-triangle"></i> @ViewBag.BoletoValidationMessage</p>
                                }
                            }
                        }
                        else
                        {
                            <p class="text-muted">Gerando boleto...</p>
                        }
                    </div>
                </div>
            }
            else if (showCreditCardSection)
            {
                <div class="card mb-4" id="creditCardPaymentCard">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-credit-card"></i> Cartão de Crédito
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.CreditCards != null && ((List<KlyonHubPlatform.Domain.Entities.CreditCard>)ViewBag.CreditCards).Any())
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Cartões já cadastrados:</strong></label>
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-info-circle"></i> Estes cartões poderão ser selecionados no modal ao clicar em "Pagar com cartão".
                                </p>
                                <div class="list-group">
                                    @foreach (var card in (List<KlyonHubPlatform.Domain.Entities.CreditCard>)ViewBag.CreditCards)
                                    {
                                        <div class="list-group-item">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                                <div>
                                                    <i class="bi bi-credit-card-2-front"></i>
                                                    @if (!string.IsNullOrWhiteSpace(card.Nickname))
                                                    {
                                                        <strong>@card.Nickname</strong>
                                                        <span class="text-muted"> (@card.Brand •••• @card.LastFourDigits)</span>
                                                    }
                                                    else
                                                    {
                                                        <strong>@card.Brand</strong> <span class="text-muted">•••• @card.LastFourDigits</span>
                                                    }
                                                    <br />
                                                    <small class="text-muted">@card.CardHolderName - @card.ExpiryMonth/@card.ExpiryYear</small>
                                                </div>
                                                <div class="d-flex align-items-center gap-1">
                                                    @if (card.IsDefault)
                                                    {
                                                        <span class="badge bg-primary">Padrão</span>
                                                    }
                                                    @if (isPaymentOwner)
                                                    {
                                                        @if (!card.IsDefault)
                                                        {
                                                            <form method="post" action="@Url.Action("SetDefaultCreditCard", "Client")" class="d-inline">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="paymentId" value="@Model.Id" />
                                                                <input type="hidden" name="cardId" value="@card.Id" />
                                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Definir como padrão">Padrão</button>
                                                            </form>
                                                        }
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary edit-card-nickname-btn"
                                                                title="Editar apelido"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#editCardNicknameModal"
                                                                data-card-id="@card.Id"
                                                                data-card-nickname="@(card.Nickname ?? "")"
                                                                data-card-label="@card.Brand •••• @card.LastFourDigits">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <form method="post" action="@Url.Action("RemoveCreditCard", "Client")" class="d-inline" onsubmit="return confirm('Remover este cartão? Você poderá adicioná-lo novamente depois.');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="paymentId" value="@Model.Id" />
                                                            <input type="hidden" name="cardId" value="@card.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remover cartão"><i class="bi bi-trash"></i></button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (isPaymentOwner)
                        {
                        <p class="text-muted small mb-3">
                            <i class="bi bi-info-circle"></i> Cadastre um cartão abaixo para usar no pagamento. Ao clicar em "Pagar com cartão", você escolhe a forma de cobrança (1x anual ou mensal) e o cartão no modal.
                        </p>
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addCardModal">
                            <i class="bi bi-plus-circle"></i> Adicionar Novo Cartão
                        </button>
                        }
                    </div>
                </div>
            }
        }
        @if (Model.Status == PaymentStatus.Cancelled && Model.Method == PaymentMethod.PIX && showPixInDropdown)
        {
            <div class="card mb-4" id="pixCancelledRegenerateCard">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-qr-code"></i> Código PIX vencido ou cancelado</h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Este pagamento PIX venceu ou foi cancelado. Você pode gerar um novo código para realizar o pagamento.</p>
                    @if (isPaymentOwner)
                    {
                    <form method="post" action="@Url.Action("GeneratePixCode", "Client")" class="d-inline generate-pix-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="paymentId" value="@Model.Id" />
                        <input type="hidden" name="pixPlanType" class="generate-pix-plan-input" value="@currentPixPlanValue" />
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-qr-code"></i> Gerar novo código PIX
                        </button>
                    </form>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Visualização somente leitura.</p>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Ações</h5>
            </div>
            <div class="card-body" id="actionsCardBody">
                @if (isPending)
                {
                    @if (showPixCard || showBoletoSection)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Instruções:</strong> Após realizar o pagamento, envie o comprovante para validação.
                        </div>

                        @if (isPaymentOwner)
                        {
                        <button type="button" class="btn btn-success w-100 mb-2" data-bs-toggle="modal" data-bs-target="#confirmPaymentModal">
                            <i class="bi bi-upload"></i> Enviar Comprovante
                        </button>
                        }

                        <p class="text-muted small mt-3">
                            <i class="bi bi-info-circle"></i> 
                            Após enviar o comprovante, nossa equipe fará a validação manual do pagamento. Assim que aprovado, seu contrato será ativado.
                        </p>
                    }
                    else if (showCreditCardSection)
                    {
                        @if (showCard1x || showCardMonthly)
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                Seu contrato será ativado assim que o pagamento for aprovado.
                            </div>

                            @if (isPaymentOwner)
                            {
                            <button type="button" class="btn btn-success w-100 mb-2" id="btnPagarComCartao" data-payment-id="@Model.Id" data-pay-modal-id="payWithCardModal">
                                <i class="bi bi-credit-card"></i> Pagar com cartão
                            </button>
                            }

                            <p class="text-muted small mt-3">
                                <i class="bi bi-info-circle"></i> 
                                O pagamento é processado na hora pelo Asaas. Informe o CEP e o número do titular; cartões cadastrados preenchem nome e validade.
                            </p>
                        }
                        else
                        {
                            <p class="text-danger mb-0"><i class="bi bi-exclamation-triangle"></i> Nenhuma forma de pagamento disponível no momento. Entre em contato com o suporte.</p>
                        }
                    }
                }
                else if (isAwaitingValidation)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-clock-history"></i> 
                        <strong>Comprovante Enviado!</strong><br>
                        Nossa equipe vai validar tudo rapidinho. Fique de olho no seu e-mail/notificações.
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ReceiptFilePath))
                    {
                        var receiptUploadedAt = ViewBag.ReceiptUploadedAt as DateTime?;
                        var receiptUploadedAtStr = receiptUploadedAt.HasValue ? receiptUploadedAt.Value.ToString(DateFormatConstants.DisplayDateAndTime) : "";
                        <button type="button" class="btn btn-outline-primary w-100 mb-2" onclick="viewReceipt(@Model.Id, '@receiptUploadedAtStr'); return false;">
                            <i class="bi bi-file-earmark-image"></i> Ver Comprovante Enviado
                        </button>
                    }
                }
                else if (Model.Status == PaymentStatus.Paid)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i> 
                        <strong>Pagamento Confirmado!</strong><br>
                        Seu contrato está ativo.
                    </div>
                    <a href="@Url.Action("ContractDetails", "Client", new { id = contract?.Id })" class="btn btn-primary w-100">
                        <i class="bi bi-file-text"></i> Ver Contrato
                    </a>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        Este pagamento está sendo processado ou já foi processado.
                    </div>
                }

                <hr>

                <a href="@Url.Action("MyPayments", "Client")" class="btn btn-outline-secondary w-100" id="viewPaymentsLink">
                    <i class="bi bi-list"></i> Ver Cobranças de Endereço Fiscal
                </a>
            </div>
        </div>

        <!-- Card de Histórico -->
        <div class="card mt-3" id="paymentHistoryCard">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Histórico</h5>
            </div>
            <div class="card-body" id="paymentHistoryBody">
                @if (Model.Status == KlyonHubPlatform.Domain.Core.Enums.PaymentStatus.Cancelled && ViewBag.ContractCancellationReason != null)
                {
                    <div class="alert alert-secondary mb-3" role="alert">
                        <strong><i class="bi bi-info-circle me-1"></i> Motivo do cancelamento:</strong> @ViewBag.ContractCancellationReason
                    </div>
                }
                @if (ViewBag.PaymentHistory != null && ((List<KlyonHubPlatform.Domain.Entities.PaymentHistory>)ViewBag.PaymentHistory).Any())
                {
                    <div class="list-group">
                        @foreach (var history in (List<KlyonHubPlatform.Domain.Entities.PaymentHistory>)ViewBag.PaymentHistory)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">
                                        @if (history.Action == PaymentHistoryActions.Approved)
                                        {
                                            <span class="badge bg-success me-2"><i class="bi bi-check-circle"></i> Aprovado</span>
                                        }
                                        else if (history.Action == PaymentHistoryActions.Rejected)
                                        {
                                            <span class="badge bg-danger me-2"><i class="bi bi-x-circle"></i> Reprovado</span>
                                        }
                                        else if (history.Action == PaymentHistoryActions.ReceiptUploaded)
                                        {
                                            @if (!string.IsNullOrEmpty(Model.ReceiptFilePath))
                                            {
                                                <button type="button" class="btn btn-sm btn-info me-2" onclick="viewReceipt(@Model.Id, '@history.ActionAt.ToString(DateFormatConstants.DisplayDateAndTime)')">
                                                    <i class="bi bi-upload"></i> Comprovante Enviado
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info me-2"><i class="bi bi-upload"></i> Comprovante Enviado</span>
                                            }
                                        }
                                        else if (history.Action == PaymentHistoryActions.ContractCreated)
                                        {
                                            <span class="badge bg-primary me-2"><i class="bi bi-file-earmark-text"></i> Contrato Criado</span>
                                        }
                                        else if (history.Action == PaymentHistoryActions.Cancelled)
                                        {
                                            <span class="badge bg-cancelled me-2"><i class="bi bi-x-circle"></i> Cancelado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary me-2">@history.Action</span>
                                        }
                                    </h6>
                                    <small>@history.ActionAt.ToString(DateFormatConstants.DisplayDateAndTime)</small>
                                </div>
                                <p class="mb-1"><strong>Por:</strong> @(history.Action == PaymentHistoryActions.Approved ? PaymentHistoryDisplayHelper.FormatActionByLabel(history, Model.Method) : (history.ActionByUser?.FullName ?? "Sistema"))</p>
                                @if (!string.IsNullOrEmpty(history.RejectionReason))
                                {
                                    <p class="mb-0"><strong>Motivo:</strong> @history.RejectionReason</p>
                                }
                            </div>
                        }
                    </div>
                    
                    @* Paginação do Histórico *@
                    @if (ViewBag.HistoryTotalPages != null && (int)ViewBag.HistoryTotalPages > 1)
                    {
                        <nav aria-label="Paginação do histórico" class="mt-3">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                @{
                                    int currentPage = ViewBag.HistoryCurrentPage ?? 1;
                                    int totalPages = ViewBag.HistoryTotalPages ?? 1;
                                    int totalItems = ViewBag.HistoryTotalItems ?? 0;
                                }
                                
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("PaymentDetails", "Client", new { id = Model.Id, historyPage = currentPage - 1 })" aria-label="Anterior">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                
                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? CssClasses.Active : "")">
                                        <a class="page-link" href="@Url.Action("PaymentDetails", "Client", new { id = Model.Id, historyPage = i })">@i</a>
                                    </li>
                                }
                                
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("PaymentDetails", "Client", new { id = Model.Id, historyPage = currentPage + 1 })" aria-label="Próximo">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                            <p class="text-center text-muted small mt-2 mb-0">
                                Mostrando @((currentPage - 1) * 10 + 1) - @(Math.Min(currentPage * 10, totalItems)) de @totalItems itens
                            </p>
                        </nav>
                    }
                }
                else
                {
                    <p class="text-muted text-center mb-0">Nenhum histórico disponível.</p>
                }
            </div>
        </div>
    </div>
</div>


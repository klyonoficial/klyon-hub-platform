                        <div class="form-check mb-3" id="payModalSetDefaultWrap">
                            <input class="form-check-input" type="checkbox" id="payModalSetDefault" name="payModalSetDefault">
                            <label class="form-check-label" for="payModalSetDefault">Marcar como cartão padrão</label>
                        </div>
                    </form>
                </div>
                <div id="payWithCardError" class="alert alert-danger d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="payWithCardSubmitBtn">
                    <i class="bi bi-credit-card"></i> Pagar agora
                </button>
            </div>
        </div>
    </div>
</div>
<script type="application/json" id="paymentDetailsCreditCards">@Html.Raw(creditCardsJson)</script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        function copyPixCode() {
            const pixCode = document.getElementById('pixCode');
            pixCode.select();
            document.execCommand('copy');
            
            const button = event.target.closest('button');
            const originalHtml = button.innerHTML;
            button.innerHTML = '<i class="bi bi-check"></i> Copiado!';
            button.classList.add('btn-success');
            button.classList.remove('btn-outline-secondary');
            
            setTimeout(() => {
                button.innerHTML = originalHtml;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-secondary');
            }, 2000);
        }

        @if (isPending && Model.Method == PaymentMethod.PIX && !string.IsNullOrEmpty(Model.PixCode) && !isExpired)
        {
            <text>
            // Gerar QR Code
            new QRCode(document.getElementById("qrcode"), {
                text: "@Model.PixCode",
                width: 200,
                height: 200
            });
            </text>
        }

        function copyBoletoBarcode() {
            const barcode = document.getElementById('boletoBarcode');
            barcode.select();
            document.execCommand('copy');
            showToast('Código de barras copiado!', 'success', 3000);
        }

        function copyBoletoCode() {
            const code = document.getElementById('boletoCode');
            code.select();
            document.execCommand('copy');
            showToast('Linha digitável copiada!', 'success', 3000);
        }

        // Helper de loading: usa KlyonLoading do loading.js ou fallback pelo overlay (se o script não carregou)
        function showPaymentLoading() {
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                window.KlyonLoading.show();
                return;
            }
            var el = document.getElementById('klyon-loading-overlay');
            if (!el && document.body) {
                el = document.createElement('div');
                el.id = 'klyon-loading-overlay';
                el.className = 'klyon-loading-overlay';
                el.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(255,255,255,0.9);display:flex;justify-content:center;align-items:center;z-index:99999;';
                el.innerHTML = '<div style="text-align:center"><div class="klyon-loading-spinner"></div><div class="klyon-loading-text">Carregando...</div></div>';
                document.body.appendChild(el);
            }
            if (el) { el.style.display = 'flex'; el.classList.remove('hidden'); }
        }
        function hidePaymentLoading() {
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                window.KlyonLoading.hide();
                return;
            }
            var el = document.getElementById('klyon-loading-overlay');
            if (el) { el.style.display = 'none'; el.classList.add('hidden'); }
        }

        window.updatePaymentMethod = async function(selectElement) {
            // Valor atual (antes da alteração): ao mudar o option, value já é o novo; usar data-previous-value da página
            const previousValue = (selectElement.dataset.previousValue || selectElement.value || '').trim();
            
            const confirmed = await showConfirm(
                'Deseja alterar o método de pagamento? Isso pode gerar um novo código de pagamento dependendo do método selecionado.',
                'Alterar Método de Pagamento',
                'warning'
            );
            
            if (confirmed) {
                // Preparar dados do formulário (usar data-action-url para evitar action relativa após innerHTML)
                const form = selectElement.form;
                const formData = new FormData(form);
                let actionUrl = form.getAttribute('data-action-url') || form.action;
                if (actionUrl && actionUrl.startsWith('/')) {
                    actionUrl = window.location.origin + actionUrl;
                }
                const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) {
                    showToast('Token de segurança não encontrado. Recarregue a página e tente novamente.', 'error');
                    return;
                }
                
                // beforeSend: mostrar loading antes de enviar a requisição
                showPaymentLoading();
                
                try {
                    const response = await fetch(actionUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': token
                        },
                        redirect: 'manual'
                    });
                    
                    if (response.ok || response.type === 'opaqueredirect' || response.status === 0 || response.redirected) {
                        await updatePaymentMethodSections();
                        selectElement.dataset.previousValue = selectElement.value;
                        showToast('Método de pagamento atualizado com sucesso!', 'success');
                    } else {
                        // Reverter dropdown para a opção anterior em caso de erro
                        selectElement.value = previousValue;
                        selectElement.dataset.previousValue = previousValue;
                        let errMsg = 'Erro ao atualizar método de pagamento. Por favor, tente novamente.';
                        try {
                            const data = await response.json();
                            if (data && typeof data.error === 'string' && data.error.trim()) errMsg = data.error;
                        } catch (_) { }
                        showToast(errMsg, 'error');
                    }
                } catch (error) {
                    // Reverter dropdown para a opção anterior em caso de exceção (rede, etc.)
                    selectElement.value = previousValue;
                    selectElement.dataset.previousValue = previousValue;
                    showToast('Erro ao atualizar método de pagamento: ' + error.message, 'error');
                    console.error('Erro:', error);
                } finally {
                    // complete: esconder o loading após terminar (sucesso ou erro)
                    hidePaymentLoading();
                }
            } else {
                // Restaurar valor anterior sem recarregar a página
                selectElement.value = previousValue;
            }
        }

        // Função para atualizar as seções após alterar o método de pagamento
        async function updatePaymentMethodSections() {
            const timestamp = new Date().getTime();
            try {
                const response = await fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Cache-Control': 'no-cache'
                    }
                });
                
                const html = await response.text();
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Atualizar card de método de pagamento (PIX, Boleto ou Cartão)
                const newPixCard = tempDiv.querySelector('#pixPaymentCard');
                const newBoletoCard = tempDiv.querySelector('#boletoPaymentCard');
                const newCreditCardCard = tempDiv.querySelector('#creditCardPaymentCard');
                
                const currentPixCard = document.getElementById('pixPaymentCard');
                const currentBoletoCard = document.getElementById('boletoPaymentCard');
                const currentCreditCardCard = document.getElementById('creditCardPaymentCard');
                
                // Remover todos os cards de método de pagamento existentes
                if (currentPixCard) currentPixCard.remove();
                if (currentBoletoCard) currentBoletoCard.remove();
                if (currentCreditCardCard) currentCreditCardCard.remove();
                
                // Adicionar o novo card de método de pagamento
                const paymentInfoCard = document.getElementById('paymentInfoCard');
                if (paymentInfoCard && paymentInfoCard.parentElement) {
                    // O paymentInfoCard está dentro de uma col-md-8, então inserimos após ele
                    if (newPixCard) {
                        const clonedPixCard = newPixCard.cloneNode(true);
                        paymentInfoCard.parentElement.insertBefore(clonedPixCard, paymentInfoCard.nextSibling);
                        // Reinicializar QR Code se for PIX
                        setTimeout(() => {
                            const pixCodeInput = clonedPixCard.querySelector('#pixCode');
                            if (pixCodeInput && pixCodeInput.value) {
                                const qrcodeDiv = clonedPixCard.querySelector('#qrcode');
                                if (qrcodeDiv) {
                                    qrcodeDiv.innerHTML = '';
                                    if (typeof QRCode !== 'undefined') {
                                        new QRCode(qrcodeDiv, {
                                            text: pixCodeInput.value,
                                            width: 200,
                                            height: 200
                                        });
                                    }
                                }
                            }
                        }, 100);
                    } else if (newBoletoCard) {
                        const clonedBoletoCard = newBoletoCard.cloneNode(true);
                        paymentInfoCard.parentElement.insertBefore(clonedBoletoCard, paymentInfoCard.nextSibling);
                    } else if (newCreditCardCard) {
                        const clonedCreditCardCard = newCreditCardCard.cloneNode(true);
                        paymentInfoCard.parentElement.insertBefore(clonedCreditCardCard, paymentInfoCard.nextSibling);
                        // Inserir modal e script de cartões ao trocar para Cartão de Crédito (podem não existir se veio de PIX)
                        const newPayWithCardModal = tempDiv.querySelector('#payWithCardModal');
                        const newPaymentDetailsCreditCards = tempDiv.querySelector('#paymentDetailsCreditCards');
                        const existingModal = document.getElementById('payWithCardModal');
                        const existingCardsScript = document.getElementById('paymentDetailsCreditCards');
                        if (newPayWithCardModal && !existingModal) {
                            document.body.appendChild(newPayWithCardModal.cloneNode(true));
                        } else if (newPayWithCardModal && existingModal) {
                            existingModal.replaceWith(newPayWithCardModal.cloneNode(true));
                        }
                        if (newPaymentDetailsCreditCards && !existingCardsScript) {
                            document.body.appendChild(newPaymentDetailsCreditCards.cloneNode(true));
                        } else if (newPaymentDetailsCreditCards && existingCardsScript) {
                            existingCardsScript.replaceWith(newPaymentDetailsCreditCards.cloneNode(true));
                        }
                        var newModal = document.getElementById('payWithCardModal');
                        if (newModal && typeof window.attachPayWithCardModalOnShow === 'function') {
                            window.attachPayWithCardModalOnShow(newModal);
                        }
                    }
                }
                
                // Atualizar card de Ações
                const newActionsCardBody = tempDiv.querySelector('#actionsCardBody');
                const currentActionsCardBody = document.getElementById('actionsCardBody');
                if (newActionsCardBody && currentActionsCardBody) {
                    currentActionsCardBody.innerHTML = newActionsCardBody.innerHTML;
                }
                
                // Atualizar informações do pagamento completamente
                const newPaymentInfoBody = tempDiv.querySelector('#paymentInfoBody');
                const currentPaymentInfoBody = document.getElementById('paymentInfoBody');
                if (newPaymentInfoBody && currentPaymentInfoBody) {
                    // Salvar o valor atual do select antes de atualizar
                    const currentSelect = currentPaymentInfoBody.querySelector('select[name="method"]');
                    const currentSelectValue = currentSelect ? currentSelect.value : null;
                    
                    // Atualizar todo o conteúdo do paymentInfoBody
                    currentPaymentInfoBody.innerHTML = newPaymentInfoBody.innerHTML;
                    
                    // Restaurar o valor do select e atualizar o data-previous-value
                    if (currentSelectValue) {
                        const updatedSelect = currentPaymentInfoBody.querySelector('select[name="method"]');
                        if (updatedSelect) {
                            updatedSelect.value = currentSelectValue;
                            updatedSelect.dataset.previousValue = currentSelectValue;
                            // Reatachar o event listener para manter a funcionalidade
                            updatedSelect.onchange = function() { window.updatePaymentMethod(this); };
                        }
                    } else {
                        // Se não havia select antes, ainda precisamos anexar o event listener ao novo select
                        const updatedSelect = currentPaymentInfoBody.querySelector('select[name="method"]');
                        if (updatedSelect) {
                            updatedSelect.onchange = function() { window.updatePaymentMethod(this); };
                        }
                    }
                }
            } catch (error) {
                console.error('Erro ao atualizar seções:', error);
                showToast('Erro ao atualizar informações. Por favor, recarregue a página.', 'error');
            }
        }

        // Formatação do número do cartão
        document.getElementById('cardNumber')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formattedValue;
        });

        // Máscara para CVV
        document.getElementById('cvv')?.addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/\D/g, '');
        });

        // Modal Pagar com cartão: valor exibido conforme forma de cobrança (1x ou mensal)
        (function() {
            var modalEl = document.getElementById('payWithCardModal');

            function formatBrl(value) {
                return value.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function updatePlanDisplay() {
                var modal = document.getElementById('payWithCardModal');
                var totalDisplay = document.getElementById('payWithCardTotalDisplay');
                if (!modal || !totalDisplay) return;
                var planRadio = document.querySelector('input[name="payCardPlanOption"]:checked');
                var option = planRadio ? (planRadio.value || '1x') : '1x';
                var totalAmount = parseFloat(modal.getAttribute('data-total-amount') || '0');
                var price1x = modal.getAttribute('data-card-price-1x');
                var priceMonthly = modal.getAttribute('data-card-price-monthly');
                var amount = totalAmount;
                if (option === 'monthly' && priceMonthly) {
                    var m = parseFloat(priceMonthly);
                    if (!isNaN(m)) amount = m;
                } else if (price1x) {
                    var x = parseFloat(price1x);
                    if (!isNaN(x)) amount = x;
                }
                totalDisplay.textContent = formatBrl(amount);
            }

            function clearPagePlanHighlight() {
                var wrap = document.getElementById('pageCardPlanOptionWrap');
                var errBox = document.getElementById('pageCardPlanOptionError');
                if (wrap) wrap.classList.remove('border', 'border-2', 'border-danger', 'rounded', 'p-2', 'bg-danger', 'bg-opacity-10');
                if (errBox) errBox.classList.add('d-none');
            }
            function clearModalPlanHighlight() {
                var wrap = document.getElementById('payModalPlanOptionWrap');
                var errBox = document.getElementById('payModalPlanOptionError');
                if (wrap) wrap.classList.remove('border', 'border-2', 'border-danger', 'rounded', 'p-2', 'bg-danger', 'bg-opacity-10');
                if (errBox) errBox.classList.add('d-none');
            }
            function updatePaymentInfoValor() {
                var container = document.getElementById('paymentInfoValorContainer');
                var displayEl = document.getElementById('paymentInfoValorDisplay');
                var labelEl = document.getElementById('paymentInfoValorLabel');
                if (!container || !displayEl) return;
                var pagePlan = document.querySelector('input[name="pageCardPlanOption"]:checked');
                var option = (pagePlan && pagePlan.value) ? pagePlan.value : '1x';
                var price1x = container.getAttribute('data-card-price-1x');
                var priceMonthly = container.getAttribute('data-card-price-monthly');
                var amount = 0;
                if (option === 'monthly' && priceMonthly) {
                    var m = parseFloat(priceMonthly);
                    if (!isNaN(m)) amount = m;
                } else if (price1x) {
                    var x = parseFloat(price1x);
                    if (!isNaN(x)) amount = x;
                }
                displayEl.textContent = amount.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (labelEl) {
                    if (option === 'monthly') {
                        labelEl.textContent = 'recorrência mensal';
                    } else {
                        var monthlyEq = (amount / 12).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        labelEl.textContent = 'recorrência anual — equivale a R$ ' + monthlyEq + '/mês';
                    }
                }
            }
            document.body.addEventListener('change', function(e) {
                if (e.target && e.target.name === 'payCardPlanOption') {
                    updatePlanDisplay();
                    clearModalPlanHighlight();
                }
                if (e.target && e.target.name === 'pageCardPlanOption') {
                    clearPagePlanHighlight();
                    updatePaymentInfoValor();
                }
            });
            updatePaymentInfoValor();
            function attachPayWithCardModalOnShow(modalElement) {
                if (!modalElement) return;
                modalElement.removeEventListener('show.bs.modal', attachPayWithCardModalOnShow._handler);
                attachPayWithCardModalOnShow._handler = function() {
                    var pagePlan = document.querySelector('input[name="pageCardPlanOption"]:checked');
                    if (pagePlan && pagePlan.value) {
                        var modal1x = document.getElementById('payCardPlan1x');
                        var modalMonthly = document.getElementById('payCardPlanMonthly');
                        if (pagePlan.value === '1x' && modal1x) { modal1x.checked = true; if (modalMonthly) modalMonthly.checked = false; }
                        else if (pagePlan.value === 'monthly' && modalMonthly) { modalMonthly.checked = true; if (modal1x) modal1x.checked = false; }
                    }
                    updatePlanDisplay();
                    var cardsEl = document.getElementById('paymentDetailsCreditCards');
                    var cards = [];
                    if (cardsEl && cardsEl.textContent) {
                        try { cards = JSON.parse(cardsEl.textContent.trim()); } catch (e) { cards = []; }
                    }
                    var optSaved = document.getElementById('payModalOptionSaved');
                    var optNew = document.getElementById('payModalOptionNew');
                    var sectionSaved = document.getElementById('payModalSavedCardsSection');
                    var sectionNew = document.getElementById('payModalNewCardSection');
                    var listSaved = document.getElementById('payModalSavedCardsList');
                    if (cards.length > 0) {
                        if (optSaved && optSaved.parentElement) optSaved.parentElement.style.display = '';
                        if (optSaved) optSaved.checked = true;
                        if (optNew) optNew.checked = false;
                        if (sectionSaved) sectionSaved.classList.remove('d-none');
                        if (sectionNew) sectionNew.classList.add('d-none');
                        if (listSaved) {
                            listSaved.innerHTML = '';
                            var defaultCard = cards.find(function(c) { return c.isDefault; }) || cards[0];
                            cards.forEach(function(c) {
                                var id = c.id || c.Id;
                                var item = document.createElement('label');
                                item.className = 'list-group-item list-group-item-action d-flex align-items-center';
                                item.style.cursor = 'pointer';
                                var radio = document.createElement('input');
                                radio.type = 'radio';
                                radio.name = 'payModalSavedCardId';
                                radio.value = id;
                                radio.className = 'form-check-input me-2';
                                radio.dataset.hasToken = c.hasToken ? '1' : '0';
                                if (id === (defaultCard.id || defaultCard.Id)) radio.checked = true;
                                item.appendChild(radio);
                                var text = document.createElement('span');
                                var displayName = (c.nickname && c.nickname.trim()) ? (c.nickname.trim() + ' — ' + (c.brand || 'Cartão') + ' •••• ' + (c.lastFourDigits || '')) : ((c.brand || 'Cartão') + ' •••• ' + (c.lastFourDigits || ''));
                                if (!c.hasToken) displayName += ' <span class="badge bg-warning text-dark ms-1">Revalidar</span>';
                                text.innerHTML = displayName + (c.isDefault ? ' <span class="badge bg-primary ms-1">Padrão</span>' : '');
                                item.appendChild(text);
                                item.addEventListener('click', function() {
                                    radio.checked = true;
                                    if (typeof updateModalSavedVsNewCardVisibility === 'function') updateModalSavedVsNewCardVisibility();
                                });
                                listSaved.appendChild(item);
                            });
                        }
                    } else {
                        if (optSaved && optSaved.parentElement) optSaved.parentElement.style.display = 'none';
                        if (optNew) optNew.checked = true;
                        if (sectionSaved) sectionSaved.classList.add('d-none');
                        if (sectionNew) sectionNew.classList.remove('d-none');
                    }
                    var payHolder = document.getElementById('payCardHolderName');
                    var payMonth = document.getElementById('payCardExpiryMonth');
                    var payYear = document.getElementById('payCardExpiryYear');
                    var payNumber = document.getElementById('payCardNumber');
                    var payCvv = document.getElementById('payCardCvv');
                    if (payHolder) payHolder.value = '';
                    if (payMonth) payMonth.value = '';
                    if (payYear) payYear.value = '';
                    if (payNumber) payNumber.value = '';
                    if (payCvv) payCvv.value = '';
                    var saveCheck = document.getElementById('payModalSaveCard');
                    var defaultWrap = document.getElementById('payModalSetDefaultWrap');
                    if (saveCheck && defaultWrap) defaultWrap.style.display = saveCheck.checked ? 'block' : 'none';
                    if (typeof updateModalSavedVsNewCardVisibility === 'function') updateModalSavedVsNewCardVisibility();
                };
                modalElement.addEventListener('show.bs.modal', attachPayWithCardModalOnShow._handler);
            }
            window.attachPayWithCardModalOnShow = attachPayWithCardModalOnShow;
            if (modalEl) attachPayWithCardModalOnShow(modalEl);
            function updateModalSavedVsNewCardVisibility() {
                var sectionSaved = document.getElementById('payModalSavedCardsSection');
                var sectionNew = document.getElementById('payModalNewCardSection');
                var payModalRevalidateMsg = document.getElementById('payModalRevalidateMsg');
                var savedCardConfirmMsg = document.getElementById('payModalSavedCardConfirmMsg');
                var newCardIntro = document.getElementById('payModalNewCardIntro');
                if (!sectionSaved || !sectionNew) return;
                var useSaved = document.getElementById('payModalOptionSaved')?.checked;
                if (!useSaved) {
                    sectionSaved.classList.add('d-none');
                    sectionNew.classList.remove('d-none');
                    if (payModalRevalidateMsg) payModalRevalidateMsg.classList.add('d-none');
                    if (savedCardConfirmMsg) savedCardConfirmMsg.classList.add('d-none');
                    if (newCardIntro) newCardIntro.classList.remove('d-none');
                    return;
                }
                sectionSaved.classList.remove('d-none');
                if (savedCardConfirmMsg) savedCardConfirmMsg.classList.add('d-none');
                var savedRadio = document.querySelector('input[name="payModalSavedCardId"]:checked');
                var needsRevalidate = savedRadio && savedRadio.dataset.hasToken === '0';
                if (needsRevalidate) {
                    sectionNew.classList.remove('d-none');
                    if (payModalRevalidateMsg) payModalRevalidateMsg.classList.remove('d-none');
                    if (newCardIntro) newCardIntro.classList.add('d-none');
                    var cardsEl = document.getElementById('paymentDetailsCreditCards');
                    var cards = [];
                    if (cardsEl && cardsEl.textContent) { try { cards = JSON.parse(cardsEl.textContent.trim()); } catch (e) { } }
                    var cardId = savedRadio ? parseInt(savedRadio.value, 10) : 0;
                    var card = cards.find(function(c) { return (c.id || c.Id) === cardId; });
                    if (card) {
                        var payHolder = document.getElementById('payCardHolderName');
                        var payMonth = document.getElementById('payCardExpiryMonth');
                        var payYear = document.getElementById('payCardExpiryYear');
                        if (payHolder && card.cardHolderName) payHolder.value = card.cardHolderName;
                        if (payMonth && card.expiryMonth) payMonth.value = card.expiryMonth;
                        if (payYear && card.expiryYear) payYear.value = card.expiryYear.length === 4 ? card.expiryYear : (card.expiryYear.length === 2 ? '20' + card.expiryYear : card.expiryYear);
                    }
                } else {
                    sectionNew.classList.add('d-none');
                    if (payModalRevalidateMsg) payModalRevalidateMsg.classList.add('d-none');
                    if (newCardIntro) newCardIntro.classList.add('d-none');
                }
            }
            document.body.addEventListener('change', function(e) {
                if (e.target && e.target.name === 'payModalOption') {
                    updateModalSavedVsNewCardVisibility();
                }
                if (e.target && e.target.name === 'payModalSavedCardId') {
                    updateModalSavedVsNewCardVisibility();
                }
                if (e.target && e.target.id === 'payModalSaveCard') {
                    var wrap = document.getElementById('payModalSetDefaultWrap');
                    if (wrap) wrap.style.display = e.target.checked ? 'block' : 'none';
                    if (!e.target.checked) {
                        var defChk = document.getElementById('payModalSetDefault');
                        if (defChk) defChk.checked = false;
                    }
                }
            });
            updatePlanDisplay();
        })();

        // Botão "Pagar com cartão": se houver cartão selecionado, tenta cobrar direto no Asaas; senão ou se a API pedir dados do cartão, abre o modal (delegação para funcionar após AJAX)
        function openPayWithCardModal() {
            var modalEl = document.getElementById('payWithCardModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }
        document.body.addEventListener('click', async function(e) {
            var btn = e.target.closest('#btnPagarComCartao');
            if (!btn) return;
            e.preventDefault();
            e.stopPropagation();
            var pagePlan = document.querySelector('input[name="pageCardPlanOption"]:checked');
            if (!pagePlan || !pagePlan.value) {
                var wrap = document.getElementById('pageCardPlanOptionWrap');
                var errBox = document.getElementById('pageCardPlanOptionError');
                if (wrap) {
                    wrap.classList.add('border', 'border-2', 'border-danger', 'rounded', 'p-2', 'bg-danger', 'bg-opacity-10');
                    wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                if (errBox) { errBox.classList.remove('d-none'); }
                return;
            }
            openPayWithCardModal();
        }, true);

        // Modal Pagar com cartão: formatação e envio
        document.getElementById('payCardNumber')?.addEventListener('input', function(e) {
            let v = e.target.value.replace(/\D/g, '');
            e.target.value = (v.match(/.{1,4}/g) || []).join(' ').substring(0, 19);
        });
        document.getElementById('payCardCvv')?.addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/\D/g, '');
        });
        // Delegação de evento: o modal pode ser substituído ao trocar método de pagamento, e o botão clonado perde o listener
        document.body.addEventListener('click', async function payWithCardHandler(e) {
            var btn = e.target.closest('#payWithCardSubmitBtn');
            if (!btn) return;
            e.preventDefault();
            var errEl = document.getElementById('payWithCardError');
            var paymentIdEl = document.getElementById('payWithCardPaymentId');
            if (!errEl || !paymentIdEl) return;
            var paymentId = parseInt(paymentIdEl.value, 10);
            if (isNaN(paymentId) || paymentId <= 0) return;
            errEl.classList.add('d-none');
            errEl.textContent = '';

            var planRadio = document.querySelector('input[name="payCardPlanOption"]:checked');
            if (!planRadio || !planRadio.value) {
                var modalWrap = document.getElementById('payModalPlanOptionWrap');
                var modalErrBox = document.getElementById('payModalPlanOptionError');
                if (modalWrap) {
                    modalWrap.classList.add('border', 'border-2', 'border-danger', 'rounded', 'p-2', 'bg-danger', 'bg-opacity-10');
                    modalWrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                if (modalErrBox) modalErrBox.classList.remove('d-none');
                return;
            }
            var modalWrapOk = document.getElementById('payModalPlanOptionWrap');
            var modalErrBoxOk = document.getElementById('payModalPlanOptionError');
            if (modalWrapOk) modalWrapOk.classList.remove('border', 'border-2', 'border-danger', 'rounded', 'p-2', 'bg-danger', 'bg-opacity-10');
            if (modalErrBoxOk) modalErrBoxOk.classList.add('d-none');
            var cardPlanOption = planRadio.value;

            var useSaved = document.getElementById('payModalOptionSaved')?.checked;
            var payload = { paymentId: paymentId, installments: 1, cardPlanOption: cardPlanOption };

            if (useSaved) {
                var savedRadio = document.querySelector('input[name="payModalSavedCardId"]:checked');
                if (!savedRadio) {
                    errEl.textContent = 'Selecione um cartão cadastrado.';
                    errEl.classList.remove('d-none');
                    return;
                }
                payload.creditCardId = parseInt(savedRadio.value, 10);
                var needsRevalidate = savedRadio.dataset.hasToken === '0';
                if (needsRevalidate) {
                    var form = document.getElementById('payWithCardForm');
                    var numEl = document.getElementById('payCardNumber');
                    var nameEl = document.getElementById('payCardHolderName');
                    var monthEl = document.getElementById('payCardExpiryMonth');
                    var yearEl = document.getElementById('payCardExpiryYear');
                    var cvvEl = document.getElementById('payCardCvv');
                    if (!numEl || !nameEl || !monthEl || !yearEl || !cvvEl) return;
                    var number = (numEl.value || '').replace(/\s/g, '');
                    var holderName = (nameEl.value || '').trim();
                    var expMonth = monthEl.value;
                    var expYear = yearEl.value;
                    var securityCode = (cvvEl.value || '').trim();
                    if (number.length < 13 || number.length > 19) {
                        errEl.textContent = 'Número do cartão inválido. Informe entre 13 e 19 dígitos.';
                        errEl.classList.remove('d-none');
                        errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        return;
                    }
                    if (!holderName || holderName.length < 2) {
                        errEl.textContent = 'Nome no cartão é obrigatório (mínimo 2 caracteres).';
                        errEl.classList.remove('d-none');
                        errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        return;
                    }
                    if (!expMonth || !expYear) {
                        errEl.textContent = 'Data de validade inválida. Selecione mês e ano.';
                        errEl.classList.remove('d-none');
                        errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        return;
                    }
                    if (securityCode.length < 3 || securityCode.length > 4) {
                        errEl.textContent = 'CVV inválido. Informe 3 ou 4 dígitos.';
                        errEl.classList.remove('d-none');
                        errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        return;
                    }
                    var year = expYear.length === 2 ? '20' + expYear : expYear;
                    payload.card = {
                        number: number,
                        expirationMonth: expMonth,
                        expirationYear: year,
                        securityCode: securityCode,
                        holderName: holderName,
                        nickname: null
                    };
                }
            } else {
                var form = document.getElementById('payWithCardForm');
                var numEl = document.getElementById('payCardNumber');
                var nameEl = document.getElementById('payCardHolderName');
                var monthEl = document.getElementById('payCardExpiryMonth');
                var yearEl = document.getElementById('payCardExpiryYear');
                var cvvEl = document.getElementById('payCardCvv');
                if (!numEl || !nameEl || !monthEl || !yearEl || !cvvEl) return;
                var number = (numEl.value || '').replace(/\s/g, '');
                var holderName = (nameEl.value || '').trim();
                var expMonth = monthEl.value;
                var expYear = yearEl.value;
                var securityCode = (cvvEl.value || '').trim();
                if (number.length < 13 || number.length > 19) {
                    errEl.textContent = 'Número do cartão inválido. Informe entre 13 e 19 dígitos.';
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    return;
                }
                if (!holderName || holderName.length < 2) {
                    errEl.textContent = 'Nome no cartão é obrigatório (mínimo 2 caracteres).';
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    return;
                }
                if (!/[a-zA-Z\u00C0-\u024F]/.test(holderName)) {
                    errEl.textContent = 'Nome do portador deve conter pelo menos uma letra.';
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    return;
                }
                if (!expMonth || !expYear) {
                    errEl.textContent = 'Data de validade inválida. Selecione mês e ano.';
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    return;
                }
                if (securityCode.length < 3 || securityCode.length > 4) {
                    errEl.textContent = 'CVV inválido. Informe 3 ou 4 dígitos.';
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    return;
                }
                var year = expYear.length === 2 ? '20' + expYear : expYear;
                var nicknameEl = document.getElementById('payCardNickname');
                payload.card = {
                    number: number,
                    expirationMonth: expMonth,
                    expirationYear: year,
                    securityCode: securityCode,
                    holderName: holderName,
                    nickname: (nicknameEl && nicknameEl.value) ? nicknameEl.value.trim() : null
                };
                var saveCardChk = document.getElementById('payModalSaveCard');
                var setDefaultChk = document.getElementById('payModalSetDefault');
                payload.saveCard = !!(saveCardChk && saveCardChk.checked);
                payload.setAsDefault = !!(setDefaultChk && setDefaultChk.checked);
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processando...';
            try {
                var response = await fetch('@Url.Action("ProcessPaymentWithCard", "Client")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify(payload)
                });
                var text = await response.text();
                var result = null;
                try { result = text ? JSON.parse(text) : null; } catch (_) { }
                if (!result) {
                    errEl.textContent = response.ok ? 'Resposta inválida do servidor. Tente novamente.' : ('Erro ' + response.status + (text && text.length < 200 ? ': ' + text : '. Verifique os dados e tente novamente.'));
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-credit-card"></i> Pagar agora';
                    return;
                }
                if (result.success) {
                    if (typeof showToast === 'function') showToast(result.message || 'Pagamento processado!', 'success');
                    var modal = bootstrap.Modal.getInstance(document.getElementById('payWithCardModal'));
                    if (modal) modal.hide();
                    window.location.reload();
                } else {
                    errEl.textContent = result.error || 'Erro ao processar pagamento.';
                    errEl.classList.remove('d-none');
                    errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-credit-card"></i> Pagar agora';
                }
            } catch (e) {
                errEl.textContent = 'Erro de conexão: ' + (e.message || 'Tente novamente.');
                errEl.classList.remove('d-none');
                errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-credit-card"></i> Pagar agora';
            }
        });

        // Preview de imagem ao selecionar arquivo
        document.getElementById('receiptFile')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            const preview = document.getElementById('filePreview');
            const previewImage = document.getElementById('previewImage');
            
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none';
            }
        });

        // Função para atualizar o histórico de pagamento
        function updatePaymentHistory() {
            var timestamp = new Date().getTime();
            fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar o card de histórico atualizado
                var newHistoryBody = tempDiv.querySelector('#paymentHistoryBody');
                var currentHistoryBody = document.getElementById('paymentHistoryBody');
                
                if (newHistoryBody && currentHistoryBody) {
                    currentHistoryBody.innerHTML = newHistoryBody.innerHTML;
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar histórico:', error);
                showToast('Erro ao atualizar histórico. Por favor, recarregue a página.', 'error');
            });
        }

        // Função para atualizar as informações do pagamento
        function updatePaymentInfo() {
            var timestamp = new Date().getTime();
            fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar o card de informações do pagamento atualizado
                var newPaymentInfoBody = tempDiv.querySelector('#paymentInfoBody');
                var currentPaymentInfoBody = document.getElementById('paymentInfoBody');
                
                if (newPaymentInfoBody && currentPaymentInfoBody) {
                    currentPaymentInfoBody.innerHTML = newPaymentInfoBody.innerHTML;
                }
                
                // Verificar se as seções de pagamento (PIX, Boleto, Cartão) devem ser ocultadas
                // Se o status não for mais "Pending", ocultar essas seções
                var pixCard = document.getElementById('pixPaymentCard');
                var boletoCard = document.getElementById('boletoPaymentCard');
                var creditCardCard = document.getElementById('creditCardPaymentCard');
                
                // Verificar se existe algum card de pagamento na nova versão
                var newPixCard = tempDiv.querySelector('#pixPaymentCard');
                var newBoletoCard = tempDiv.querySelector('#boletoPaymentCard');
                var newCreditCardCard = tempDiv.querySelector('#creditCardPaymentCard');
                
                // Se não existir nenhum card de pagamento na nova versão, significa que o status mudou
                // e devemos ocultar os cards existentes
                if (!newPixCard && !newBoletoCard && !newCreditCardCard) {
                    if (pixCard) {
                        pixCard.style.display = 'none';
                    }
                    if (boletoCard) {
                        boletoCard.style.display = 'none';
                    }
                    if (creditCardCard) {
                        creditCardCard.style.display = 'none';
                    }
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar informações do pagamento:', error);
                showToast('Erro ao atualizar informações. Por favor, recarregue a página.', 'error');
            });
        }

        // Converter formulário de envio de comprovante para AJAX
        document.getElementById('confirmPaymentForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const fileInput = document.getElementById('receiptFile');
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                const maxSize = 10 * 1024 * 1024; // 10MB
                if (file.size > maxSize) {
                    showToast('O arquivo é muito grande. Tamanho máximo: 10MB', 'warning');
                    return false;
                }
            }
            
            // Verificar se há modal de confirmação aberto
            if (typeof window.isConfirmModalOpen === 'function' && window.isConfirmModalOpen()) {
                return;
            }
            
            // Mostrar loading
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                window.KlyonLoading.show();
            }
            
            // Preparar dados do formulário
            var formData = new FormData(this);
            var actionUrl = this.action;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Marcar como requisição AJAX manual
            this.setAttribute('data-ajax-request', 'true');
            
            fetch(actionUrl, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                redirect: 'manual'
            })
            .then(response => {
                // Esconder loading após receber resposta
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                // Remover marcação
                this.removeAttribute('data-ajax-request');
                
                if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected || response.ok) {
                    // Fechar modal
                    var modalEl = document.getElementById('confirmPaymentModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) {
                            modal.hide();
                        }
                    }
                    
                    // Limpar formulário
                    this.reset();
                    document.getElementById('filePreview').style.display = 'none';
                    
                    // Atualizar informações do pagamento (inclui status)
                    updatePaymentInfo();
                    
                    // Atualizar histórico
                    updatePaymentHistory();
                    
                    // Atualizar seção de ações
                    var timestamp = new Date().getTime();
                    fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Cache-Control': 'no-cache'
                        }
                    })
                    .then(response => response.text())
                    .then(html => {
                        var tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;
                        var newActionsCard = tempDiv.querySelector('.col-md-4 .card .card-body');
                        var currentActionsCard = document.querySelector('.col-md-4 .card .card-body');
                        if (newActionsCard && currentActionsCard) {
                            currentActionsCard.innerHTML = newActionsCard.innerHTML;
                            // Reatachar o event listener do link após atualização
                            reattachViewPaymentsLink();
                        }
                    })
                    .catch(error => {
                        console.error('Erro ao atualizar ações:', error);
                    });
                    
                    showToast('Comprovante enviado com sucesso! O pagamento está em análise e aguardando validação.', 'success');
                } else {
                    showToast('Erro ao enviar comprovante. Por favor, tente novamente.', 'error');
                }
            })
            .catch(error => {
                // Esconder loading em caso de erro
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                // Remover marcação
                this.removeAttribute('data-ajax-request');
                
                showToast('Erro ao enviar comprovante: ' + error.message, 'error');
                console.error('Erro:', error);
            });
        });

        // Função para visualizar comprovante (modal pré-renderido com ViewReceipt, como Admin/Validar Pagamento)
        function viewReceipt(paymentId, uploadDate) {
            var modalEl = document.getElementById('viewReceiptModal');
            if (!modalEl) return;
            var dateEl = document.getElementById('viewReceiptUploadDate');
            if (dateEl && uploadDate) {
                dateEl.innerHTML = '<i class="bi bi-calendar"></i> Enviado em: ' + uploadDate;
            }
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        // Garantir que o link "Ver Cobranças" funcione corretamente
        document.addEventListener('DOMContentLoaded', function() {
            const viewPaymentsLink = document.getElementById('viewPaymentsLink');
            if (viewPaymentsLink) {
                viewPaymentsLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("MyPayments", "Client")';
                });
            }
        });

        // Reatachar o event listener após atualizações dinâmicas
        function reattachViewPaymentsLink() {
            const viewPaymentsLink = document.getElementById('viewPaymentsLink');
            if (viewPaymentsLink) {
                // Remover listeners antigos
                const newLink = viewPaymentsLink.cloneNode(true);
                viewPaymentsLink.parentNode.replaceChild(newLink, viewPaymentsLink);
                
                // Adicionar novo listener
                newLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("MyPayments", "Client")';
                });
            }
        }

        // ============================================================
        // Atualização em tempo real apenas via SignalR (sem polling)
        @if (isPending || Model.Status == PaymentStatus.Processing)
        {
            <text>
            (function() {
                var paymentIdForHub = @Model.Id;
                var hubUrl = '@Url.Content("~/hubs/payment")';
                if (typeof signalR !== 'undefined') {
                    var connection = new signalR.HubConnectionBuilder()
                        .withUrl(hubUrl)
                        .withAutomaticReconnect()
                        .build();
                    connection.on('PaymentConfirmed', function(data) {
                        if (data && data.paymentId === paymentIdForHub) {
                            if (typeof showToast === 'function') showToast('Pagamento confirmado! Atualizando página...', 'success', 5000);
                            setTimeout(function() { window.location.reload(); }, 1000);
                        }
                    });
                    connection.on('PaymentCancelled', function(data) {
                        if (data && data.paymentId === paymentIdForHub) {
                            if (typeof showToast === 'function') showToast('Pagamento cancelado ou vencido. Atualizando página...', 'info', 5000);
                            setTimeout(function() { window.location.reload(); }, 1000);
                        }
                    });
                    connection.start().then(function() {
                        return connection.invoke('JoinPaymentGroup', paymentIdForHub);
                    }).catch(function(err) {
                        console.warn('SignalR PaymentHub:', err);
                    });
                }
            })();
            </text>
        }
    </script>
}

                hasToken = !string.IsNullOrEmpty(c.AsaasToken),
                hasBilling = KlyonHubPlatform.Application.Helpers.CreditCardHolderBilling.TryReadStored(c.PostalCode, c.AddressNumber, out _, out _),
                postalCode = KlyonHubPlatform.Application.Helpers.CreditCardHolderBilling.FormatMasked(c.PostalCode),
                addressNumber = c.AddressNumber,
                isDefault = c.IsDefault
            })
            .ToList();

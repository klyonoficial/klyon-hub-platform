@model KlyonHubPlatform.Domain.Entities.Payment
@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData["Title"] = "Detalhes do Pagamento";
    var contract = Model.Subscription?.Contract;
    var reservation = Model.Reservation;
    var isPending = Model.Status == PaymentStatus.Pending;
    var isAwaitingValidation = Model.Status == PaymentStatus.AwaitingValidation;
    var isPix = Model.Method == PaymentMethod.PIX;
    var isExpired = Model.PixExpiresAt.HasValue && Model.PixExpiresAt.Value < DateTime.UtcNow;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-credit-card"></i> Detalhes do Pagamento</h2>
    <a href="@Url.Action("MyPayments", "Client")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4" id="paymentInfoCard">
            <div class="card-header">
                <h5 class="mb-0">Informações do Pagamento</h5>
            </div>
            <div class="card-body" id="paymentInfoBody">
                <dl class="row">
                    @if (Model.SubscriptionId.HasValue && contract != null)
                    {
                        <dt class="col-sm-4">Número do Contrato:</dt>
                        <dd class="col-sm-8"><strong>@contract.ContractNumber</strong></dd>

                        @if (contract.CoworkingAddress?.Coworking != null)
                        {
                            <dt class="col-sm-4">Parceiro/Coworking:</dt>
                            <dd class="col-sm-8">
                                <strong>@contract.CoworkingAddress.Coworking.Name</strong>
                            </dd>
                        }

                        <dt class="col-sm-4">Endereço:</dt>
                        <dd class="col-sm-8">
                            @{
                                var hasAddress = !string.IsNullOrWhiteSpace(contract.CoworkingAddress?.Address);
                                var hasCity = !string.IsNullOrWhiteSpace(contract.CoworkingAddress?.City);
                                var hasState = !string.IsNullOrWhiteSpace(contract.CoworkingAddress?.State);
                                
                                if (hasAddress || hasCity || hasState)
                                {
                                    var addressParts = new List<string>();
                                    if (hasAddress)
                                    {
                                        addressParts.Add(contract.CoworkingAddress.Address);
                                    }
                                    if (hasCity && hasState)
                                    {
                                        addressParts.Add($"{contract.CoworkingAddress.City}/{contract.CoworkingAddress.State}");
                                    }
                                    else if (hasCity)
                                    {
                                        addressParts.Add(contract.CoworkingAddress.City);
                                    }
                                    else if (hasState)
                                    {
                                        addressParts.Add(contract.CoworkingAddress.State);
                                    }
                                    <text>@string.Join(", ", addressParts)</text>
                                }
                            }
                        </dd>
                    }
                    else if (Model.ReservationId.HasValue && reservation != null)
                    {
                        <dt class="col-sm-4">Tipo:</dt>
                        <dd class="col-sm-8"><strong>Pagamento de Reserva</strong></dd>
                        
                        <dt class="col-sm-4">Reserva ID:</dt>
                        <dd class="col-sm-8"><strong>#@Model.ReservationId</strong></dd>
                        
                        <dt class="col-sm-4">Coworking:</dt>
                        <dd class="col-sm-8">
                            @reservation.CoworkingAddress?.Coworking?.Name<br>
                            <small class="text-muted">@reservation.CoworkingAddress?.City/@reservation.CoworkingAddress?.State</small>
                        </dd>
                        
                        <dt class="col-sm-4">Data da Reserva:</dt>
                        <dd class="col-sm-8">@reservation.ReservationDate.ToString("dd/MM/yyyy")</dd>
                        
                        @if (reservation.StartTime.HasValue && reservation.EndTime.HasValue)
                        {
                            <dt class="col-sm-4">Horário:</dt>
                            <dd class="col-sm-8">@reservation.StartTime.Value.ToString(@"hh\:mm") - @reservation.EndTime.Value.ToString(@"hh\:mm")</dd>
                        }
                        
                        <dt class="col-sm-4">Tipo de Sala:</dt>
                        <dd class="col-sm-8">@(reservation.RoomType == "Shared" ? "Compartilhada" : "Privativa")</dd>
                    }

                    <dt class="col-sm-4">Valor:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Method == PaymentMethod.CreditCard && ViewBag.FeePercentage != null && ViewBag.FeePercentage > 0)
                        {
                            <div>
                                <h4 class="text-primary mb-0">R$ @ViewBag.FinalAmount.ToString("N2")</h4>
                                <small class="text-muted">
                                    Valor original: R$ @ViewBag.OriginalAmount.ToString("N2")
                                    <br>
                                    <span class="text-warning">
                                        <i class="bi bi-info-circle"></i> Taxa de cartão de crédito: @ViewBag.FeePercentage.ToString("N2")%
                                    </span>
                                </small>
                            </div>
                        }
                        else
                        {
                            <h4 class="text-primary mb-0">R$ @Model.Amount.ToString("N2")</h4>
                        }
                    </dd>

                    <dt class="col-sm-4">Método de Pagamento:</dt>
                    <dd class="col-sm-8">
                        @if (isPending)
                        {
                            <form method="post" action="@Url.Action("UpdatePaymentMethod", "Client")" id="paymentMethodForm" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="paymentId" value="@Model.Id" />
                                <select name="method" class="form-select d-inline-block" style="width: auto; min-width: 200px;" onchange="updatePaymentMethod(this)" data-previous-value="@Model.Method.ToString()">
                                    @if (Model.Method == PaymentMethod.PIX)
                                    {
                                        <option value="PIX" selected>PIX</option>
                                    }
                                    else
                                    {
                                        <option value="PIX">PIX</option>
                                    }
                                    @if (Model.Method == PaymentMethod.BankTransfer)
                                    {
                                        <option value="BankTransfer" selected>Boleto Bancário</option>
                                    }
                                    else
                                    {
                                        <option value="BankTransfer">Boleto Bancário</option>
                                    }
                                    @if (Model.Method == PaymentMethod.CreditCard)
                                    {
                                        <option value="CreditCard" selected>Cartão de Crédito</option>
                                    }
                                    else
                                    {
                                        <option value="CreditCard">Cartão de Crédito</option>
                                    }
                                </select>
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-info-circle"></i> Você pode alterar o método de pagamento a qualquer momento
                                </small>
                            </form>
                        }
                        else
                        {
                            @switch (Model.Method)
                            {
                                case PaymentMethod.PIX:
                                    <span class="badge bg-primary"><i class="bi bi-qr-code"></i> PIX</span>
                                    break;
                                case PaymentMethod.CreditCard:
                                    <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão de Crédito</span>
                                    break;
                                case PaymentMethod.BankTransfer:
                                    <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto Bancário</span>
                                    break;
                            }
                        }
                    </dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Status)
                        {
                            case PaymentStatus.Pending:
                                <span class="badge bg-pending-payment">
                                    <i class="bi bi-cash-coin me-1"></i> Aguardando Pagamento
                                </span>
                                break;
                        
                            case PaymentStatus.Processing:
                                <span class="badge bg-info">
                                    <i class="bi bi-arrow-repeat me-1"></i> Processando
                                </span>
                                break;
                        
                            case PaymentStatus.AwaitingValidation:
                                <span class="badge bg-info">
                                    <i class="bi bi-cash-coin me-1"></i> Aguardando Validação
                                </span>
                                break;
                        
                            case PaymentStatus.Paid:
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle-fill me-1"></i> Pago
                                </span>
                                break;
                        
                            case PaymentStatus.Failed:
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle-fill me-1"></i> Falhou
                                </span>
                                break;
                        
                            default:
                                <span class="badge bg-secondary">
                                    <i class="bi bi-question-circle-fill me-1"></i> @Model.Status
                                </span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Data de Vencimento:</dt>
                    <dd class="col-sm-8">
                        @Model.DueDate.ToString("dd/MM/yyyy")
                        @if (Model.DueDate < DateTime.UtcNow && isPending)
                        {
                            <span class="badge bg-danger ms-2">Vencido</span>
                        }
                    </dd>

                    @if (Model.PaidAt.HasValue)
                    {
                        <dt class="col-sm-4">Data do Pagamento:</dt>
                        <dd class="col-sm-8">@Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.TransactionId))
                    {
                        <dt class="col-sm-4">ID da Transação:</dt>
                        <dd class="col-sm-8"><code>@Model.TransactionId</code></dd>
                    }
                </dl>
            </div>
        </div>

        @if (isPending)
        {
            @if (Model.Method == PaymentMethod.PIX)
            {
                <div class="card mb-4" id="pixPaymentCard">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-qr-code"></i> Código PIX</h5>
                    </div>
                    <div class="card-body text-center">
                        @if (isExpired)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> Este código PIX expirou. Um novo código será gerado ao confirmar o pagamento.
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Model.PixCode))
                        {
                            <div class="mb-3">
                                <div id="qrcode" class="d-inline-block p-3 bg-white border rounded"></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Código PIX Copia e Cola:</strong></label>
                                <div class="input-group">
                                    <input type="text" class="form-control" id="pixCode" value="@Model.PixCode" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyPixCode()">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>
                            <p class="text-muted">
                                <i class="bi bi-info-circle"></i> 
                                @if (Model.PixExpiresAt.HasValue)
                                {
                                    <text>Este código expira em: @Model.PixExpiresAt.Value.ToString("dd/MM/yyyy HH:mm")</text>
                                }
                                else
                                {
                                    <text>Escaneie o QR Code ou copie o código para pagar via PIX</text>
                                }
                            </p>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> 
                                <strong>Código PIX não gerado.</strong>
                                <p class="mb-2 mt-2">Clique no botão abaixo para gerar o código PIX agora.</p>
                                <form method="post" action="@Url.Action("GeneratePixCode", "Client")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="paymentId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-qr-code"></i> Gerar Código PIX
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.Method == PaymentMethod.BankTransfer)
            {
                <div class="card mb-4" id="boletoPaymentCard">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-bank"></i> Boleto Bancário</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.BoletoCode))
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Código de Barras:</strong></label>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" id="boletoBarcode" value="@Model.BoletoBarcode" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyBoletoBarcode()">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label"><strong>Linha Digitável:</strong></label>
                                <div class="input-group">
                                    <input type="text" class="form-control font-monospace" id="boletoCode" value="@Model.BoletoCode" readonly>
                                    <button class="btn btn-outline-secondary" type="button" onclick="copyBoletoCode()">
                                        <i class="bi bi-clipboard"></i> Copiar
                                    </button>
                                </div>
                            </div>
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> 
                                <strong>Instruções:</strong>
                                <ul class="mb-0 mt-2">
                                    <li>Pague o boleto em qualquer banco, lotérica ou aplicativo bancário</li>
                                    <li>O boleto vence em: <strong>@Model.DueDate.ToString("dd/MM/yyyy")</strong></li>
                                    <li>Após o pagamento, envie o comprovante para validação</li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">Gerando boleto...</p>
                        }
                    </div>
                </div>
            }
            else if (Model.Method == PaymentMethod.CreditCard)
            {
                <div class="card mb-4" id="creditCardPaymentCard">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-credit-card"></i> Pagamento com Cartão de Crédito</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">
                            <strong>Valor:</strong> 
                            @if (ViewBag.FeePercentage != null && ViewBag.FeePercentage > 0)
                            {
                                <span class="text-primary">R$ @ViewBag.FinalAmount.ToString("N2")</span>
                                <br>
                                <small class="text-muted">
                                    Valor original: R$ @ViewBag.OriginalAmount.ToString("N2")
                                    <br>
                                    <span class="text-warning">
                                        <i class="bi bi-info-circle"></i> Taxa de cartão de crédito: @ViewBag.FeePercentage.ToString("N2")%
                                    </span>
                                </small>
                            }
                            else
                            {
                                <span class="text-primary">R$ @Model.Amount.ToString("N2")</span>
                            }
                            <br>
                            <strong>Vencimento:</strong> @Model.DueDate.ToString("dd/MM/yyyy")
                        </p>
                        
                        @if (ViewBag.CreditCards != null && ((List<KlyonHubPlatform.Domain.Entities.CreditCard>)ViewBag.CreditCards).Any())
                        {
                            <div class="mb-3">
                                <label class="form-label"><strong>Selecione um cartão cadastrado:</strong></label>
                                <div class="list-group">
                                    @foreach (var card in (List<KlyonHubPlatform.Domain.Entities.CreditCard>)ViewBag.CreditCards)
                                    {
                                        <div class="list-group-item">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="selectedCard" id="card_@card.Id" value="@card.Id" @(card.IsDefault ? "checked" : "")>
                                                <label class="form-check-label w-100" for="card_@card.Id">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <i class="bi bi-credit-card-2-front"></i> 
                                                            <strong>@card.Brand</strong> •••• @card.LastFourDigits
                                                            <br>
                                                            <small class="text-muted">@card.CardHolderName - @card.ExpiryMonth/@card.ExpiryYear</small>
                                                        </div>
                                                        @if (card.IsDefault)
                                                        {
                                                            <span class="badge bg-primary">Padrão</span>
                                                        }
                                                    </div>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> 
                                Você não possui cartões cadastrados. Adicione um cartão para realizar o pagamento.
                            </div>
                        }

                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addCardModal">
                            <i class="bi bi-plus-circle"></i> Adicionar Novo Cartão
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Ações</h5>
            </div>
            <div class="card-body" id="actionsCardBody">
                @if (isPending)
                {
                    @if (Model.Method == PaymentMethod.PIX || Model.Method == PaymentMethod.BankTransfer)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Instruções:</strong> Após realizar o pagamento, envie o comprovante para validação.
                        </div>

                        <button type="button" class="btn btn-success w-100 mb-2" data-bs-toggle="modal" data-bs-target="#confirmPaymentModal">
                            <i class="bi bi-upload"></i> Enviar Comprovante
                        </button>

                        <p class="text-muted small mt-3">
                            <i class="bi bi-info-circle"></i> 
                            Após enviar o comprovante, nossa equipe fará a validação manual do pagamento. Assim que aprovado, seu contrato será ativado.
                        </p>
                    }
                    else if (Model.Method == PaymentMethod.CreditCard)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> 
                            <strong>Instruções:</strong> Selecione um cartão cadastrado ou adicione um novo cartão para processar o pagamento.
                        </div>

                        <p class="text-muted small mt-3">
                            <i class="bi bi-info-circle"></i> 
                            O pagamento será processado automaticamente após a confirmação.
                            Seu contrato será ativado imediatamente após o processamento.
                        </p>
                    }
                }
                else if (isAwaitingValidation)
                {
                    <div class="alert alert-info">
                        <i class="bi bi-clock-history"></i> 
                        <strong>Comprovante Enviado!</strong><br>
                        Seu comprovante está aguardando validação pelo coworking.
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ReceiptFilePath))
                    {
                        <a href="@Url.Action("DownloadReceipt", "Client", new { paymentId = Model.Id })" class="btn btn-outline-primary w-100 mb-2" target="_blank">
                            <i class="bi bi-download"></i> Ver Comprovante Enviado
                        </a>
                    }
                }
                else if (Model.Status == PaymentStatus.Paid)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle"></i> 
                        <strong>Pagamento Confirmado!</strong><br>
                        Seu contrato está ativo.
                    </div>
                    <a href="@Url.Action("ContractDetails", "Client", new { id = contract?.Id })" class="btn btn-primary w-100">
                        <i class="bi bi-file-text"></i> Ver Contrato
                    </a>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        Este pagamento está sendo processado ou já foi processado.
                    </div>
                }

                <hr>

                <a href="@Url.Action("MyPayments", "Client")" class="btn btn-outline-secondary w-100" id="viewPaymentsLink">
                    <i class="bi bi-list"></i> Ver Cobranças de Endereço Fiscal
                </a>
            </div>
        </div>

        <!-- Card de Histórico -->
        <div class="card mt-3" id="paymentHistoryCard">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Histórico</h5>
            </div>
            <div class="card-body" id="paymentHistoryBody">
                @if (ViewBag.PaymentHistory != null && ((List<KlyonHubPlatform.Domain.Entities.PaymentHistory>)ViewBag.PaymentHistory).Any())
                {
                    <div class="list-group">
                        @foreach (var history in (List<KlyonHubPlatform.Domain.Entities.PaymentHistory>)ViewBag.PaymentHistory)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">
                                        @if (history.Action == "Approved")
                                        {
                                            <span class="badge bg-success me-2"><i class="bi bi-check-circle"></i> Aprovado</span>
                                        }
                                        else if (history.Action == "Rejected")
                                        {
                                            <span class="badge bg-danger me-2"><i class="bi bi-x-circle"></i> Reprovado</span>
                                        }
                                        else if (history.Action == "ReceiptUploaded")
                                        {
                                            @if (!string.IsNullOrEmpty(Model.ReceiptFilePath))
                                            {
                                                <button type="button" class="btn btn-sm btn-info me-2" onclick="viewReceipt(@Model.Id, '@history.ActionAt.ToString("dd/MM/yyyy HH:mm")')">
                                                    <i class="bi bi-upload"></i> Comprovante Enviado
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info me-2"><i class="bi bi-upload"></i> Comprovante Enviado</span>
                                            }
                                        }
                                        else if (history.Action == "ContractCreated")
                                        {
                                            <span class="badge bg-primary me-2"><i class="bi bi-file-earmark-text"></i> Contrato Criado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary me-2">@history.Action</span>
                                        }
                                    </h6>
                                    <small>@history.ActionAt.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p class="mb-1"><strong>Por:</strong> @(history.ActionByUser?.FullName ?? "Sistema")</p>
                                @if (!string.IsNullOrEmpty(history.RejectionReason))
                                {
                                    <p class="mb-0"><strong>Motivo:</strong> @history.RejectionReason</p>
                                }
                            </div>
                        }
                    </div>
                    
                    @* Paginação do Histórico *@
                    @if (ViewBag.HistoryTotalPages != null && (int)ViewBag.HistoryTotalPages > 1)
                    {
                        <nav aria-label="Paginação do histórico" class="mt-3">
                            <ul class="pagination pagination-sm justify-content-center mb-0">
                                @{
                                    int currentPage = ViewBag.HistoryCurrentPage ?? 1;
                                    int totalPages = ViewBag.HistoryTotalPages ?? 1;
                                    int totalItems = ViewBag.HistoryTotalItems ?? 0;
                                }
                                
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("PaymentDetails", "Client", new { id = Model.Id, historyPage = currentPage - 1 })" aria-label="Anterior">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                
                                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("PaymentDetails", "Client", new { id = Model.Id, historyPage = i })">@i</a>
                                    </li>
                                }
                                
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("PaymentDetails", "Client", new { id = Model.Id, historyPage = currentPage + 1 })" aria-label="Próximo">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                            <p class="text-center text-muted small mt-2 mb-0">
                                Mostrando @((currentPage - 1) * 10 + 1) - @(Math.Min(currentPage * 10, totalItems)) de @totalItems itens
                            </p>
                        </nav>
                    }
                }
                else
                {
                    <p class="text-muted text-center mb-0">Nenhum histórico disponível.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal para Enviar Comprovante -->
<div class="modal fade" id="confirmPaymentModal" tabindex="-1" aria-labelledby="confirmPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmPaymentModalLabel">
                    <i class="bi bi-upload"></i> Enviar Comprovante de Pagamento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("ConfirmPayment", "Client")" enctype="multipart/form-data" id="confirmPaymentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@Model.Id" />
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        Envie uma foto ou PDF do comprovante de pagamento. 
                        O coworking validará manualmente antes de ativar seu contrato.
                    </div>
                    
                    <div class="mb-3">
                        <label for="receiptFile" class="form-label">Comprovante (JPG, PNG ou PDF)</label>
                        <input type="file" class="form-control" id="receiptFile" name="receiptFile" accept=".jpg,.jpeg,.png,.pdf" required>
                        <small class="form-text text-muted">Tamanho máximo: 10MB</small>
                    </div>

                    <div id="filePreview" class="mt-3" style="display: none;">
                        <img id="previewImage" src="" alt="Preview" class="img-thumbnail" style="max-width: 100%; max-height: 300px;">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Enviar Comprovante
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal para Adicionar Cartão -->
<div class="modal fade" id="addCardModal" tabindex="-1" aria-labelledby="addCardModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCardModalLabel">
                    <i class="bi bi-credit-card"></i> Adicionar Novo Cartão
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" action="@Url.Action("AddCreditCard", "Client")" id="addCardForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="paymentId" value="@Model.Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="cardNumber" class="form-label">Número do Cartão <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cardNumber" name="cardNumber" 
                               placeholder="0000 0000 0000 0000" maxlength="19" required>
                        <small class="form-text text-muted">Digite apenas os números do cartão</small>
                    </div>
                    <div class="mb-3">
                        <label for="cardHolderName" class="form-label">Nome no Cartão <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cardHolderName" name="cardHolderName" 
                               placeholder="NOME COMO ESTÁ NO CARTÃO" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="expiryMonth" class="form-label">Mês <span class="text-danger">*</span></label>
                            <select class="form-select" id="expiryMonth" name="expiryMonth" required>
                                <option value="">MM</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i.ToString("00")">@i.ToString("00")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="expiryYear" class="form-label">Ano <span class="text-danger">*</span></label>
                            <select class="form-select" id="expiryYear" name="expiryYear" required>
                                <option value="">AAAA</option>
                                @for (int year = DateTime.Now.Year; year <= DateTime.Now.Year + 10; year++)
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="cvv" class="form-label">CVV <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="cvv" name="cvv" 
                               placeholder="000" maxlength="4" required>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isDefault" name="isDefault" value="true">
                        <label class="form-check-label" for="isDefault">
                            Definir como cartão padrão
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Salvar Cartão
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script>
        function copyPixCode() {
            const pixCode = document.getElementById('pixCode');
            pixCode.select();
            document.execCommand('copy');
            
            const button = event.target.closest('button');
            const originalHtml = button.innerHTML;
            button.innerHTML = '<i class="bi bi-check"></i> Copiado!';
            button.classList.add('btn-success');
            button.classList.remove('btn-outline-secondary');
            
            setTimeout(() => {
                button.innerHTML = originalHtml;
                button.classList.remove('btn-success');
                button.classList.add('btn-outline-secondary');
            }, 2000);
        }

        @if (isPending && Model.Method == PaymentMethod.PIX && !string.IsNullOrEmpty(Model.PixCode) && !isExpired)
        {
            <text>
            // Gerar QR Code
            new QRCode(document.getElementById("qrcode"), {
                text: "@Model.PixCode",
                width: 200,
                height: 200
            });
            </text>
        }

        function copyBoletoBarcode() {
            const barcode = document.getElementById('boletoBarcode');
            barcode.select();
            document.execCommand('copy');
            showToast('Código de barras copiado!', 'success', 3000);
        }

        function copyBoletoCode() {
            const code = document.getElementById('boletoCode');
            code.select();
            document.execCommand('copy');
            showToast('Linha digitável copiada!', 'success', 3000);
        }

        async function updatePaymentMethod(selectElement) {
            // Armazenar o valor anterior antes de mostrar o confirm
            const previousValue = selectElement.dataset.previousValue || selectElement.value;
            
            const confirmed = await showConfirm(
                'Deseja alterar o método de pagamento? Isso pode gerar um novo código de pagamento dependendo do método selecionado.',
                'Alterar Método de Pagamento',
                'warning'
            );
            
            if (confirmed) {
                // Garantir que o loading seja exibido após a confirmação
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                    window.KlyonLoading.show();
                }
                
                // Preparar dados do formulário
                const form = selectElement.form;
                const formData = new FormData(form);
                const actionUrl = form.action;
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                
                // Marcar como requisição AJAX manual
                form.setAttribute('data-ajax-request', 'true');
                
                try {
                    const response = await fetch(actionUrl, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': token
                        },
                        redirect: 'manual'
                    });
                    
                    // Esconder loading após receber resposta
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    
                    // Remover marcação
                    form.removeAttribute('data-ajax-request');
                    
                    if (response.ok || response.type === 'opaqueredirect' || response.status === 0 || response.redirected) {
                        // Atualizar as seções dinamicamente
                        await updatePaymentMethodSections();
                        
                        // Salvar o valor atual como anterior
                        selectElement.dataset.previousValue = selectElement.value;
                        
                        showToast('Método de pagamento atualizado com sucesso!', 'success');
                    } else {
                        // Restaurar valor anterior em caso de erro
                        selectElement.value = previousValue;
                        showToast('Erro ao atualizar método de pagamento. Por favor, tente novamente.', 'error');
                    }
                } catch (error) {
                    // Esconder loading em caso de erro
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    
                    // Remover marcação
                    form.removeAttribute('data-ajax-request');
                    
                    // Restaurar valor anterior
                    selectElement.value = previousValue;
                    showToast('Erro ao atualizar método de pagamento: ' + error.message, 'error');
                    console.error('Erro:', error);
                }
            } else {
                // Restaurar valor anterior sem recarregar a página
                selectElement.value = previousValue;
            }
        }

        // Função para atualizar as seções após alterar o método de pagamento
        async function updatePaymentMethodSections() {
            const timestamp = new Date().getTime();
            try {
                const response = await fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Cache-Control': 'no-cache'
                    }
                });
                
                const html = await response.text();
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Atualizar card de método de pagamento (PIX, Boleto ou Cartão)
                const newPixCard = tempDiv.querySelector('#pixPaymentCard');
                const newBoletoCard = tempDiv.querySelector('#boletoPaymentCard');
                const newCreditCardCard = tempDiv.querySelector('#creditCardPaymentCard');
                
                const currentPixCard = document.getElementById('pixPaymentCard');
                const currentBoletoCard = document.getElementById('boletoPaymentCard');
                const currentCreditCardCard = document.getElementById('creditCardPaymentCard');
                
                // Remover todos os cards de método de pagamento existentes
                if (currentPixCard) currentPixCard.remove();
                if (currentBoletoCard) currentBoletoCard.remove();
                if (currentCreditCardCard) currentCreditCardCard.remove();
                
                // Adicionar o novo card de método de pagamento
                const paymentInfoCard = document.getElementById('paymentInfoCard');
                if (paymentInfoCard && paymentInfoCard.parentElement) {
                    // O paymentInfoCard está dentro de uma col-md-8, então inserimos após ele
                    if (newPixCard) {
                        const clonedPixCard = newPixCard.cloneNode(true);
                        paymentInfoCard.parentElement.insertBefore(clonedPixCard, paymentInfoCard.nextSibling);
                        // Reinicializar QR Code se for PIX
                        setTimeout(() => {
                            const pixCodeInput = clonedPixCard.querySelector('#pixCode');
                            if (pixCodeInput && pixCodeInput.value) {
                                const qrcodeDiv = clonedPixCard.querySelector('#qrcode');
                                if (qrcodeDiv) {
                                    qrcodeDiv.innerHTML = '';
                                    if (typeof QRCode !== 'undefined') {
                                        new QRCode(qrcodeDiv, {
                                            text: pixCodeInput.value,
                                            width: 200,
                                            height: 200
                                        });
                                    }
                                }
                            }
                        }, 100);
                    } else if (newBoletoCard) {
                        const clonedBoletoCard = newBoletoCard.cloneNode(true);
                        paymentInfoCard.parentElement.insertBefore(clonedBoletoCard, paymentInfoCard.nextSibling);
                    } else if (newCreditCardCard) {
                        const clonedCreditCardCard = newCreditCardCard.cloneNode(true);
                        paymentInfoCard.parentElement.insertBefore(clonedCreditCardCard, paymentInfoCard.nextSibling);
                    }
                }
                
                // Atualizar card de Ações
                const newActionsCardBody = tempDiv.querySelector('#actionsCardBody');
                const currentActionsCardBody = document.getElementById('actionsCardBody');
                if (newActionsCardBody && currentActionsCardBody) {
                    currentActionsCardBody.innerHTML = newActionsCardBody.innerHTML;
                }
                
                // Atualizar informações do pagamento completamente
                const newPaymentInfoBody = tempDiv.querySelector('#paymentInfoBody');
                const currentPaymentInfoBody = document.getElementById('paymentInfoBody');
                if (newPaymentInfoBody && currentPaymentInfoBody) {
                    // Salvar o valor atual do select antes de atualizar
                    const currentSelect = currentPaymentInfoBody.querySelector('select[name="method"]');
                    const currentSelectValue = currentSelect ? currentSelect.value : null;
                    
                    // Atualizar todo o conteúdo do paymentInfoBody
                    currentPaymentInfoBody.innerHTML = newPaymentInfoBody.innerHTML;
                    
                    // Restaurar o valor do select e atualizar o data-previous-value
                    if (currentSelectValue) {
                        const updatedSelect = currentPaymentInfoBody.querySelector('select[name="method"]');
                        if (updatedSelect) {
                            updatedSelect.value = currentSelectValue;
                            updatedSelect.dataset.previousValue = currentSelectValue;
                            // Reatachar o event listener para manter a funcionalidade
                            updatedSelect.onchange = function() { updatePaymentMethod(this); };
                        }
                    } else {
                        // Se não havia select antes, ainda precisamos anexar o event listener ao novo select
                        const updatedSelect = currentPaymentInfoBody.querySelector('select[name="method"]');
                        if (updatedSelect) {
                            updatedSelect.onchange = function() { updatePaymentMethod(this); };
                        }
                    }
                }
            } catch (error) {
                console.error('Erro ao atualizar seções:', error);
                showToast('Erro ao atualizar informações. Por favor, recarregue a página.', 'error');
            }
        }

        // Formatação do número do cartão
        document.getElementById('cardNumber')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
            e.target.value = formattedValue;
        });

        // Máscara para CVV
        document.getElementById('cvv')?.addEventListener('input', function(e) {
            e.target.value = e.target.value.replace(/\D/g, '');
        });

        // Preview de imagem ao selecionar arquivo
        document.getElementById('receiptFile')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            const preview = document.getElementById('filePreview');
            const previewImage = document.getElementById('previewImage');
            
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none';
            }
        });

        // Função para atualizar o histórico de pagamento
        function updatePaymentHistory() {
            var timestamp = new Date().getTime();
            fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar o card de histórico atualizado
                var newHistoryBody = tempDiv.querySelector('#paymentHistoryBody');
                var currentHistoryBody = document.getElementById('paymentHistoryBody');
                
                if (newHistoryBody && currentHistoryBody) {
                    currentHistoryBody.innerHTML = newHistoryBody.innerHTML;
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar histórico:', error);
                showToast('Erro ao atualizar histórico. Por favor, recarregue a página.', 'error');
            });
        }

        // Função para atualizar as informações do pagamento
        function updatePaymentInfo() {
            var timestamp = new Date().getTime();
            fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Cache-Control': 'no-cache'
                }
            })
            .then(response => response.text())
            .then(html => {
                var tempDiv = document.createElement('div');
                tempDiv.innerHTML = html;
                
                // Encontrar o card de informações do pagamento atualizado
                var newPaymentInfoBody = tempDiv.querySelector('#paymentInfoBody');
                var currentPaymentInfoBody = document.getElementById('paymentInfoBody');
                
                if (newPaymentInfoBody && currentPaymentInfoBody) {
                    currentPaymentInfoBody.innerHTML = newPaymentInfoBody.innerHTML;
                }
                
                // Verificar se as seções de pagamento (PIX, Boleto, Cartão) devem ser ocultadas
                // Se o status não for mais "Pending", ocultar essas seções
                var pixCard = document.getElementById('pixPaymentCard');
                var boletoCard = document.getElementById('boletoPaymentCard');
                var creditCardCard = document.getElementById('creditCardPaymentCard');
                
                // Verificar se existe algum card de pagamento na nova versão
                var newPixCard = tempDiv.querySelector('#pixPaymentCard');
                var newBoletoCard = tempDiv.querySelector('#boletoPaymentCard');
                var newCreditCardCard = tempDiv.querySelector('#creditCardPaymentCard');
                
                // Se não existir nenhum card de pagamento na nova versão, significa que o status mudou
                // e devemos ocultar os cards existentes
                if (!newPixCard && !newBoletoCard && !newCreditCardCard) {
                    if (pixCard) {
                        pixCard.style.display = 'none';
                    }
                    if (boletoCard) {
                        boletoCard.style.display = 'none';
                    }
                    if (creditCardCard) {
                        creditCardCard.style.display = 'none';
                    }
                }
            })
            .catch(error => {
                console.error('Erro ao atualizar informações do pagamento:', error);
                showToast('Erro ao atualizar informações. Por favor, recarregue a página.', 'error');
            });
        }

        // Converter formulário de envio de comprovante para AJAX
        document.getElementById('confirmPaymentForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const fileInput = document.getElementById('receiptFile');
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                const maxSize = 10 * 1024 * 1024; // 10MB
                if (file.size > maxSize) {
                    showToast('O arquivo é muito grande. Tamanho máximo: 10MB', 'warning');
                    return false;
                }
            }
            
            // Verificar se há modal de confirmação aberto
            if (typeof window.isConfirmModalOpen === 'function' && window.isConfirmModalOpen()) {
                return;
            }
            
            // Mostrar loading
            if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.show) {
                window.KlyonLoading.show();
            }
            
            // Preparar dados do formulário
            var formData = new FormData(this);
            var actionUrl = this.action;
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            // Marcar como requisição AJAX manual
            this.setAttribute('data-ajax-request', 'true');
            
            fetch(actionUrl, {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                },
                redirect: 'manual'
            })
            .then(response => {
                // Esconder loading após receber resposta
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                // Remover marcação
                this.removeAttribute('data-ajax-request');
                
                if (response.type === 'opaqueredirect' || response.status === 0 || response.redirected || response.ok) {
                    // Fechar modal
                    var modalEl = document.getElementById('confirmPaymentModal');
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) {
                            modal.hide();
                        }
                    }
                    
                    // Limpar formulário
                    this.reset();
                    document.getElementById('filePreview').style.display = 'none';
                    
                    // Atualizar informações do pagamento (inclui status)
                    updatePaymentInfo();
                    
                    // Atualizar histórico
                    updatePaymentHistory();
                    
                    // Atualizar seção de ações
                    var timestamp = new Date().getTime();
                    fetch('@Url.Action("PaymentDetails", "Client", new { id = Model.Id })?_=' + timestamp, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Cache-Control': 'no-cache'
                        }
                    })
                    .then(response => response.text())
                    .then(html => {
                        var tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;
                        var newActionsCard = tempDiv.querySelector('.col-md-4 .card .card-body');
                        var currentActionsCard = document.querySelector('.col-md-4 .card .card-body');
                        if (newActionsCard && currentActionsCard) {
                            currentActionsCard.innerHTML = newActionsCard.innerHTML;
                            // Reatachar o event listener do link após atualização
                            reattachViewPaymentsLink();
                        }
                    })
                    .catch(error => {
                        console.error('Erro ao atualizar ações:', error);
                    });
                    
                    showToast('Comprovante enviado com sucesso! O pagamento está em análise e aguardando validação.', 'success');
                } else {
                    showToast('Erro ao enviar comprovante. Por favor, tente novamente.', 'error');
                }
            })
            .catch(error => {
                // Esconder loading em caso de erro
                if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                // Remover marcação
                this.removeAttribute('data-ajax-request');
                
                showToast('Erro ao enviar comprovante: ' + error.message, 'error');
                console.error('Erro:', error);
            });
        });

        // Função para visualizar comprovante
        function viewReceipt(paymentId, uploadDate) {
            const receiptUrl = '@Url.Action("DownloadReceipt", "Client")?paymentId=' + paymentId;
            
            // Criar modal para visualizar o comprovante
            const modalHtml = `
                <div class="modal fade" id="viewReceiptModal" tabindex="-1" aria-labelledby="viewReceiptModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-xl modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="viewReceiptModalLabel">
                                    <i class="bi bi-file-earmark-image"></i> Comprovante Enviado
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                            </div>
                            <div class="modal-body text-center">
                                <p class="text-muted mb-3">
                                    <i class="bi bi-calendar"></i> Enviado em: ${uploadDate}
                                </p>
                                <div id="receiptContainer" style="min-height: 500px; max-height: 70vh; overflow: auto;">
                                    <div class="d-flex justify-content-center align-items-center" style="min-height: 500px;">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Carregando...</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <a href="${receiptUrl}" class="btn btn-primary" target="_blank" download>
                                        <i class="bi bi-download"></i> Baixar Comprovante
                                    </a>
                                    <a href="${receiptUrl}" class="btn btn-outline-primary" target="_blank">
                                        <i class="bi bi-box-arrow-up-right"></i> Abrir em Nova Aba
                                    </a>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            // Remover modal anterior se existir
            const existingModal = document.getElementById('viewReceiptModal');
            if (existingModal) {
                existingModal.remove();
            }
            
            // Adicionar novo modal ao body
            document.body.insertAdjacentHTML('beforeend', modalHtml);
            
            // Mostrar modal
            const modal = new bootstrap.Modal(document.getElementById('viewReceiptModal'));
            modal.show();
            
            // Carregar o comprovante após o modal ser exibido
            const receiptContainer = document.getElementById('receiptContainer');
            const iframe = document.createElement('iframe');
            iframe.src = receiptUrl;
            iframe.style.width = '100%';
            iframe.style.height = '70vh';
            iframe.style.border = '1px solid #dee2e6';
            iframe.style.borderRadius = '4px';
            iframe.onload = function() {
                receiptContainer.innerHTML = '';
                receiptContainer.appendChild(iframe);
            };
            iframe.onerror = function() {
                receiptContainer.innerHTML = `
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i> 
                        Não foi possível carregar o comprovante. 
                        <a href="${receiptUrl}" target="_blank" class="alert-link">Clique aqui para tentar abrir diretamente</a>.
                    </div>
                `;
            };
            
            // Limpar modal quando fechar
            document.getElementById('viewReceiptModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        }

        // Garantir que o link "Ver Cobranças" funcione corretamente
        document.addEventListener('DOMContentLoaded', function() {
            const viewPaymentsLink = document.getElementById('viewPaymentsLink');
            if (viewPaymentsLink) {
                viewPaymentsLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("MyPayments", "Client")';
                });
            }
        });

        // Reatachar o event listener após atualizações dinâmicas
        function reattachViewPaymentsLink() {
            const viewPaymentsLink = document.getElementById('viewPaymentsLink');
            if (viewPaymentsLink) {
                // Remover listeners antigos
                const newLink = viewPaymentsLink.cloneNode(true);
                viewPaymentsLink.parentNode.replaceChild(newLink, viewPaymentsLink);
                
                // Adicionar novo listener
                newLink.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.location.href = '@Url.Action("MyPayments", "Client")';
                });
            }
        }
    </script>
}

@{
    ViewData["Title"] = "Checkout - Comprar Créditos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var plan = ViewBag.Plan as KlyonHubPlatform.Domain.Entities.CreditPlan;
    var client = ViewBag.Client as KlyonHubPlatform.Domain.Entities.Client;
    var totalCredits = ViewBag.TotalCredits as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-cart-check"></i> Checkout - Comprar Créditos</h2>
    <a href="@Url.Action("BuyCredits", "Client")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Área para mensagens de erro dinâmicas -->
<div id="errorMessageContainer" class="d-none mb-3"></div>

<style>
    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    #errorMessageContainer .alert {
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
</style>

<div class="row">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Resumo do Pedido</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Plano:</strong> @plan.Name
                    </div>
                    <div class="col-md-6 text-end">
                        <strong>Valor:</strong> <span class="text-primary fs-5">R$ @plan.Price.ToString("N2")</span>
                    </div>
                </div>
                <hr>
                <div class="row mb-2">
                    <div class="col-md-6">
                        <span>Créditos:</span>
                    </div>
                    <div class="col-md-6 text-end">
                        <strong>@plan.Credits</strong>
                    </div>
                </div>
                @if (plan.BonusCredits > 0)
                {
                    <div class="row mb-2">
                        <div class="col-md-6">
                            <span class="text-success">Bônus:</span>
                        </div>
                        <div class="col-md-6 text-end">
                            <strong class="text-success">+@plan.BonusCredits</strong>
                        </div>
                    </div>
                }
                <hr>
                <div class="row">
                    <div class="col-md-6">
                        <strong>Total de Créditos:</strong>
                    </div>
                    <div class="col-md-6 text-end">
                        <strong class="text-success fs-5">@totalCredits créditos</strong>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-6">
                        <small class="text-muted">Validade:</small>
                    </div>
                    <div class="col-md-6 text-end">
                        <small class="text-muted">@plan.ValidityMonths @(plan.ValidityMonths == 1 ? "mês" : "meses")</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-geo-alt"></i> Dados para Cobrança</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nome/Razão Social:</dt>
                    <dd class="col-sm-8">@(client.RazaoSocial ?? client.NomeFantasia ?? client.ContactName ?? client.User.FullName)</dd>

                    <dt class="col-sm-4">CPF/CNPJ:</dt>
                    <dd class="col-sm-8">@(client.CNPJ ?? client.CPF ?? "Não informado")</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@(client.ContactEmail ?? client.User.Email)</dd>

                    <dt class="col-sm-4">Telefone:</dt>
                    <dd class="col-sm-8">@(client.ContactPhone ?? client.User.Phone ?? "Não informado")</dd>

                    @if (!string.IsNullOrEmpty(client.Address))
                    {
                        <dt class="col-sm-4">Endereço:</dt>
                        <dd class="col-sm-8">
                            @client.Address
                            <br>
                            @if (!string.IsNullOrEmpty(client.City))
                            {
                                <text>@client.City</text>
                            }
                            @if (!string.IsNullOrEmpty(client.State))
                            {
                                <text> - @client.State</text>
                            }
                            @if (!string.IsNullOrEmpty(client.ZipCode))
                            {
                                <br><text>CEP: @client.ZipCode</text>
                            }
                        </dd>
                    }
                </dl>
                <div class="alert alert-info mt-3 mb-0">
                    <i class="bi bi-info-circle"></i> 
                    <small>Os dados acima serão utilizados para emissão da nota fiscal. Para alterar, atualize seu perfil.</small>
                </div>
            </div>
        </div>

        <div class="card" id="paymentMethodCard" data-credit-plan-id="@plan.Id" data-amount="@plan.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-credit-card"></i> Método de Pagamento</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Método de Pagamento:</label>
                    <select class="form-select" id="paymentMethodSelect" style="max-width: 320px;">
                        <option value="PIX" selected>PIX</option>
                        <option value="Boleto">Boleto Bancário</option>
                        <option value="CreditCard">Cartão de Crédito</option>
                    </select>
                    <small class="text-muted d-block mt-1"><i class="bi bi-info-circle"></i> Você pode alterar o método de pagamento a qualquer momento</small>
                </div>

                <div id="paymentDetails" class="mt-4">
                    <!-- PIX (igual Detalhes do Pagamento / Código PIX) -->
                    <div id="pixSection" class="payment-section">
                        <div class="card mb-0">
                            <div class="card-header bg-primary text-white">
                                <h5 class="mb-0"><i class="bi bi-qr-code"></i> Código PIX</h5>
                            </div>
                            <div class="card-body text-center">
                                <div id="pixGenerateBlock">
                                    <button type="button" class="btn btn-primary btn-lg" id="btnGeneratePix">
                                        <i class="bi bi-qr-code"></i> Gerar Código PIX
                                    </button>
                                </div>
                                <div id="pixResultBlock" class="d-none">
                                    <div class="mb-3"><div class="d-inline-block p-3 bg-white border rounded"><canvas id="qrcodeCanvas"></canvas></div></div>
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Código PIX Copia e Cola:</strong></label>
                                        <div class="input-group justify-content-center">
                                            <input type="text" class="form-control" id="pixCodeInput" readonly style="max-width: 400px;">
                                            <button class="btn btn-outline-secondary" type="button" id="btnCopyPix"><i class="bi bi-clipboard"></i> Copiar</button>
                                        </div>
                                    </div>
                                    <p class="text-muted mb-0"><i class="bi bi-info-circle"></i> <span id="pixExpiresText">Escaneie o QR Code ou copie o código para pagar via PIX</span></p>
                                    <div class="alert alert-info mt-3 mb-0"><i class="bi bi-info-circle"></i> Após o pagamento, os créditos serão creditados automaticamente em sua conta.</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Boleto (igual Detalhes do Pagamento / Boleto Bancário) -->
                    <div id="boletoSection" class="payment-section d-none">
                        <div class="card mb-0">
                            <div class="card-header bg-secondary text-white">
                                <h5 class="mb-0"><i class="bi bi-bank"></i> Boleto Bancário</h5>
                            </div>
                            <div class="card-body">
                                <div id="boletoGenerateBlock">
                                    <button type="button" class="btn btn-secondary btn-lg w-100" id="btnGenerateBoleto">
                                        <i class="bi bi-bank"></i> Gerar Boleto Bancário
                                    </button>
                                </div>
                                <div id="boletoResultBlock" class="d-none">
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Código de Barras:</strong></label>
                                        <div class="input-group">
                                            <input type="text" class="form-control font-monospace" id="boletoBarcodeInput" readonly>
                                            <button class="btn btn-outline-secondary" type="button" id="btnCopyBoletoBarcode"><i class="bi bi-clipboard"></i> Copiar</button>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label"><strong>Linha Digitável:</strong></label>
                                        <div class="input-group">
                                            <input type="text" class="form-control font-monospace" id="boletoCodeInput" readonly>
                                            <button class="btn btn-outline-secondary" type="button" id="btnCopyBoletoCode"><i class="bi bi-clipboard"></i> Copiar</button>
                                        </div>
                                    </div>
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle"></i> <strong>Instruções:</strong>
                                        <ul class="mb-0 mt-2">
                                            <li>Pague o boleto em qualquer banco, lotérica ou aplicativo bancário</li>
                                            <li>O boleto vence em: <strong id="boletoVencimento"></strong></li>
                                            <li>Após o pagamento, os créditos serão creditados em até 2 dias úteis</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cartão de Crédito (igual Detalhes do Pagamento / Pagamento com Cartão) -->
                    <div id="cardSection" class="payment-section d-none">
                        <div class="card mb-0">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0"><i class="bi bi-credit-card"></i> Pagamento com Cartão de Crédito</h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-3"><strong>Valor:</strong> R$ @plan.Price.ToString("N2")</p>
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i> <strong>Instruções:</strong> Preencha os dados do cartão para processar o pagamento. O pagamento será processado automaticamente e os créditos creditados em sua conta.
                                </div>
                                <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#creditCardModal">
                                    <i class="bi bi-plus-circle"></i> Preencher Dados do Cartão
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle"></i> <strong>Atenção:</strong> Após a confirmação do pagamento, os créditos serão creditados automaticamente em sua conta.
                </div>

                <div class="mt-3">
                    <a href="@Url.Action("BuyCredits", "Client")" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Cancelar</a>
                </div>
            </div>
        </div>

        <!-- Modal Dados do Cartão (espelhando "Adicionar Novo Cartão" do Detalhes do Pagamento) -->
        <div class="modal fade" id="creditCardModal" tabindex="-1" aria-labelledby="creditCardModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="creditCardModalLabel"><i class="bi bi-credit-card"></i> Dados do Cartão de Crédito</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <form id="creditCardForm">
                        <div class="modal-body">
                            <!-- Área para mensagens de erro dentro do modal -->
                            <div id="modalErrorMessageContainer" class="d-none mb-3"></div>
                            
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold">Número do Cartão <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="cardNumber" placeholder="0000 0000 0000 0000" maxlength="19" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Nome no Cartão <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="cardName" placeholder="NOME COMO ESTÁ NO CARTÃO" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">Validade <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="cardExpiry" placeholder="MM/AA" maxlength="5" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">CVV <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="cardCvv" placeholder="123" maxlength="4" required>
                                </div>
                                <div class="col-12"><hr><h6 class="fw-bold">Endereço de Cobrança</h6></div>
                                <div class="col-md-8">
                                    <label class="form-label">Rua <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="billingStreet" value="@(client?.Address ?? "")" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Número <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="billingNumber" value="S/N" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Bairro <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="billingLocality" value="Não informado" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">CEP <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="billingPostalCode" value="@(client?.ZipCode?.Replace("-", "") ?? "")" maxlength="8" required>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Cidade <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="billingCity" value="@(client?.City ?? "")" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">UF <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="billingState" value="@(client?.State ?? "")" maxlength="2" required>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Parcelas</label>
                                    <select class="form-select" id="installments">
                                        <option value="1">1x sem juros</option>
                                        <option value="2">2x sem juros</option>
                                        <option value="3">3x sem juros</option>
                                        <option value="4">4x sem juros</option>
                                        <option value="5">5x sem juros</option>
                                        <option value="6">6x sem juros</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Confirmar Pagamento</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card sticky-top" style="top: 20px;">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-receipt"></i> Resumo</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Plano:</span>
                    <strong>@plan.Name</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Créditos:</span>
                    <strong>@plan.Credits</strong>
                </div>
                @if (plan.BonusCredits > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Bônus:</span>
                        <strong>+@plan.BonusCredits</strong>
                    </div>
                }
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span>Total de Créditos:</span>
                    <strong class="text-success">@totalCredits</strong>
                </div>
                <hr>
                <div class="d-flex justify-content-between">
                    <span class="fs-5"><strong>Total a Pagar:</strong></span>
                    <span class="fs-4 text-primary fw-bold">R$ @plan.Price.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        (function() {
            var planId = parseInt(document.getElementById('paymentMethodCard').getAttribute('data-credit-plan-id'), 10);
            var pixData = null, boletoData = null;

            // Função para exibir mensagens de erro de forma bonita (na página ou no modal)
            function showErrorMessage(message, inModal) {
                var container;
                if (inModal) {
                    container = document.getElementById('modalErrorMessageContainer');
                    if (!container) return;
                } else {
                    container = document.getElementById('errorMessageContainer');
                    if (!container) return;
                }
                
                container.innerHTML = '<div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-left: 4px solid #dc3545; animation: slideDown 0.3s ease-out;">' +
                    '<div class="d-flex align-items-center">' +
                    '<i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>' +
                    '<div class="flex-grow-1"><strong>Erro:</strong> ' + message + '</div>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>' +
                    '</div></div>';
                container.classList.remove('d-none');
                
                if (!inModal) {
                    // Scroll suave até a mensagem (apenas se não estiver no modal)
                    container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
                
                // Auto-remover após 8 segundos
                setTimeout(function() {
                    var alert = container.querySelector('.alert');
                    if (alert) {
                        alert.classList.remove('show');
                        setTimeout(function() {
                            container.classList.add('d-none');
                            container.innerHTML = '';
                        }, 300);
                    }
                }, 8000);
            }

            // Função para exibir mensagens de sucesso
            function showSuccessMessage(message) {
                var container = document.getElementById('errorMessageContainer');
                if (!container) return;
                
                container.innerHTML = '<div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-left: 4px solid #198754; animation: slideDown 0.3s ease-out;">' +
                    '<div class="d-flex align-items-center">' +
                    '<i class="bi bi-check-circle-fill fs-4 me-3"></i>' +
                    '<div class="flex-grow-1">' + message + '</div>' +
                    '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>' +
                    '</div></div>';
                container.classList.remove('d-none');
                
                // Scroll suave até a mensagem
                container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                
                // Auto-remover após 5 segundos
                setTimeout(function() {
                    var alert = container.querySelector('.alert');
                    if (alert) {
                        alert.classList.remove('show');
                        setTimeout(function() {
                            container.classList.add('d-none');
                            container.innerHTML = '';
                        }, 300);
                    }
                }, 5000);
            }

            function showSection(name) {
                document.querySelectorAll('.payment-section').forEach(function(el) { el.classList.add('d-none'); });
                var section = document.getElementById(name + 'Section');
                if (section) section.classList.remove('d-none');
            }

            var sel = document.getElementById('paymentMethodSelect');
            sel.addEventListener('change', function() {
                var v = this.value;
                if (v === 'PIX') showSection('pix');
                else if (v === 'Boleto') showSection('boleto');
                else if (v === 'CreditCard') showSection('card');
            });
            showSection(sel.value === 'Boleto' ? 'boleto' : (sel.value === 'CreditCard' ? 'card' : 'pix'));

            // Função para verificar se a biblioteca QRCode está carregada
            function waitForQRCode(callback, maxAttempts) {
                maxAttempts = maxAttempts || 50;
                var attempts = 0;
                function check() {
                    if (typeof QRCode !== 'undefined' && typeof QRCode.toCanvas === 'function') {
                        callback();
                    } else if (attempts < maxAttempts) {
                        attempts++;
                        setTimeout(check, 100);
                    } else {
                        showErrorMessage('Biblioteca de QR Code não carregada. Por favor, recarregue a página.');
                    }
                }
                check();
            }

            // PIX - Gerar QR Code (usa qrcode: QRCode.toCanvas em <canvas>)
            document.getElementById('btnGeneratePix').addEventListener('click', async function() {
                var btn = this;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Gerando...';
                try {
                    var res = await fetch('@Url.Action("GenerateCreditPurchasePix", "Client")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ creditPlanId: planId })
                    });
                    var data = await res.json();
                    if (data.success && data.pixCode) {
                        pixData = data;
                        document.getElementById('pixGenerateBlock').classList.add('d-none');
                        document.getElementById('pixResultBlock').classList.remove('d-none');
                        document.getElementById('pixCodeInput').value = data.pixCode;
                        var canvas = document.getElementById('qrcodeCanvas');
                        var exp = data.pixExpiresAt ? new Date(data.pixExpiresAt).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
                        document.getElementById('pixExpiresText').textContent = exp ? 'Este código expira em: ' + exp : 'Escaneie o QR Code ou copie o código para pagar via PIX';
                        
                        // Aguardar a biblioteca QRCode estar disponível antes de gerar o QR Code
                        waitForQRCode(function() {
                            try {
                                QRCode.toCanvas(canvas, data.pixCode, { width: 260, margin: 2 }, function(err) {
                                    if (err) {
                                        console.error('Erro ao gerar QR Code:', err);
                                        showErrorMessage('Erro ao gerar QR Code. O código PIX está disponível para copiar abaixo.');
                                    }
                                });
                            } catch (e) {
                                console.error('Erro ao gerar QR Code:', e);
                                showErrorMessage('Erro ao gerar QR Code. O código PIX está disponível para copiar abaixo.');
                            }
                        });
                    } else {
                        showErrorMessage(data.error || 'Erro ao gerar PIX.');
                    }
                } catch (e) {
                    showErrorMessage('Erro: ' + e.message);
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-qr-code"></i> Gerar Código PIX';
            });

            document.getElementById('btnCopyPix').addEventListener('click', function() {
                var i = document.getElementById('pixCodeInput');
                i.select();
                document.execCommand('copy');
                showSuccessMessage('Código PIX copiado para a área de transferência!');
            });

            // Boleto - Gerar
            document.getElementById('btnGenerateBoleto').addEventListener('click', async function() {
                var btn = this;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Gerando...';
                try {
                    var res = await fetch('@Url.Action("GenerateCreditPurchaseBoleto", "Client")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ creditPlanId: planId })
                    });
                    var data = await res.json();
                    if (data.success && data.boletoBarcode) {
                        boletoData = data;
                        document.getElementById('boletoGenerateBlock').classList.add('d-none');
                        document.getElementById('boletoResultBlock').classList.remove('d-none');
                        document.getElementById('boletoBarcodeInput').value = data.boletoBarcode;
                        document.getElementById('boletoCodeInput').value = data.boletoCode || '';
                        try { JsBarcode('#boletoBarcodeSvg', data.boletoBarcode, { format: 'CODE128', width: 2, height: 60, displayValue: true }); } catch (e) { console.error(e); }
                        var exp = data.boletoExpiresAt ? new Date(data.boletoExpiresAt).toLocaleDateString('pt-BR') : '';
                        document.getElementById('boletoVencimento').textContent = exp || '-';
                    } else {
                        showErrorMessage(data.error || 'Erro ao gerar boleto.');
                    }
                } catch (e) {
                    showErrorMessage('Erro: ' + e.message);
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-bank"></i> Gerar Boleto Bancário';
            });

            document.getElementById('btnCopyBoletoBarcode').addEventListener('click', function() {
                document.getElementById('boletoBarcodeInput').select();
                document.execCommand('copy');
                showSuccessMessage('Código de barras copiado para a área de transferência!');
            });
            document.getElementById('btnCopyBoletoCode').addEventListener('click', function() {
                document.getElementById('boletoCodeInput').select();
                document.execCommand('copy');
                showSuccessMessage('Linha digitável copiada para a área de transferência!');
            });

            // Cartão - formatação
            document.getElementById('cardNumber').addEventListener('input', function(e) {
                var v = e.target.value.replace(/\s/g, '');
                e.target.value = (v.match(/.{1,4}/g) || [v]).join(' ');
            });
            document.getElementById('cardExpiry').addEventListener('input', function(e) {
                var v = e.target.value.replace(/\D/g, '');
                if (v.length >= 2) v = v.substring(0,2) + '/' + v.substring(2,4);
                e.target.value = v;
            });
            document.getElementById('billingPostalCode').addEventListener('input', function(e) {
                e.target.value = e.target.value.replace(/\D/g, '');
            });

            // Limpar mensagem de erro quando o modal for aberto
            var creditCardModal = document.getElementById('creditCardModal');
            if (creditCardModal) {
                creditCardModal.addEventListener('show.bs.modal', function() {
                    var errorContainer = document.getElementById('modalErrorMessageContainer');
                    if (errorContainer) {
                        errorContainer.classList.add('d-none');
                        errorContainer.innerHTML = '';
                    }
                });
            }

            // Cartão - submit
            document.getElementById('creditCardForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                var f = this;
                if (!f.checkValidity()) { f.classList.add('was-validated'); return; }
                var btn = f.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Processando...';
                try {
                    var createRes = await fetch('@Url.Action("CreateCreditCardPurchase", "Client")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ creditPlanId: planId })
                    });
                    var createData = await createRes.json();
                    if (!createData.success || !createData.purchaseId) {
                        showErrorMessage(createData.error || 'Erro ao iniciar pagamento.', true);
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bi bi-check-circle"></i> Confirmar Pagamento';
                        return;
                    }
                    var exp = document.getElementById('cardExpiry').value.split('/');
                    var card = {
                        encrypted: null,
                        securityCode: document.getElementById('cardCvv').value,
                        holder: { name: document.getElementById('cardName').value },
                        number: document.getElementById('cardNumber').value.replace(/\s/g, ''),
                        expMonth: exp[0] || '',
                        expYear: '20' + (exp[1] || '')
                    };
                    var billingAddress = {
                        street: document.getElementById('billingStreet').value,
                        number: document.getElementById('billingNumber').value,
                        locality: document.getElementById('billingLocality').value,
                        city: document.getElementById('billingCity').value,
                        regionCode: document.getElementById('billingState').value,
                        country: 'BRA',
                        postalCode: document.getElementById('billingPostalCode').value
                    };
                    var payRes = await fetch('@Url.Action("ProcessCreditCardPayment", "Client")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            purchaseId: createData.purchaseId,
                            card: card,
                            billingAddress: billingAddress,
                            installments: parseInt(document.getElementById('installments').value, 10) || 1
                        })
                    });
                    var payData = await payRes.json();
                    if (payData.success) {
                        showSuccessMessage(payData.message || 'Pagamento processado com sucesso!');
                        setTimeout(function() {
                            window.location.href = '@Url.Action("BuyCredits", "Client")';
                        }, 2000);
                    } else {
                        showErrorMessage(payData.error || 'Falha no pagamento. Verifique os dados do cartão e tente novamente.', true);
                    }
                } catch (err) {
                    showErrorMessage('Erro de conexão: ' + err.message, true);
                }
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle"></i> Confirmar Pagamento';
            });
        })();
    </script>
}

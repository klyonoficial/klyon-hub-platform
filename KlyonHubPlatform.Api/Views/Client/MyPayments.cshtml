@model List<KlyonHubPlatform.Domain.Entities.Payment>
@using KlyonHubPlatform.Domain.Core.Enums
@{
    ViewData[ViewDataKeys.Title] = "Cobranças de Endereço Fiscal";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-credit-card"></i> Cobranças de Endereço Fiscal</h2>
</div>
<p class="text-muted mb-4">
    <i class="bi bi-info-circle"></i> Cobranças dos seus contratos de endereço fiscal.
</p>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Você não possui cobranças de endereço fiscal no momento.
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card border-0 bg-pending-payment text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-cash-coin me-1"></i> Pendentes</h6>
                    <h4 class="mb-0">R$ @Model.Where(p => p.Status == PaymentStatus.Pending).Sum(p => p.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals)</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-suspended text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-arrow-repeat me-1"></i> Processando / Aguardando Validação</h6>
                    <h4 class="mb-0">R$ @Model.Where(p => p.Status == PaymentStatus.Processing || p.Status == PaymentStatus.AwaitingValidation).Sum(p => p.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals)</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-active text-white">
                <div class="card-body">
                    <h6 class="card-title"><i class="bi bi-check-circle-fill me-1"></i> Pagas</h6>
                    <h4 class="mb-0">R$ @Model.Where(p => p.Status == PaymentStatus.Paid).Sum(p => p.Amount).ToString(NumberFormatConstants.CurrencyTwoDecimals)</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Contrato de Endereço Fiscal</th>
                            <th>Valor</th>
                            <th>Método</th>
                            <th>Status</th>
                            <th>Vencimento</th>
                            <th>Pago em</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@payment.Subscription?.Contract?.ContractNumber</strong><br>
                                    <small class="text-muted">@payment.Subscription?.Contract?.CoworkingAddress?.Address</small>
                                </td>
                                <td>
                                    <strong>R$ @payment.Amount.ToString(NumberFormatConstants.CurrencyTwoDecimals)</strong>
                                </td>
                                <td>
                                    @switch (payment.Method)
                                    {
                                        case PaymentMethod.PIX:
                                            <span class="badge bg-primary"><i class="bi bi-qr-code"></i> PIX</span>
                                            break;
                                        case PaymentMethod.CreditCard:
                                            <span class="badge bg-info"><i class="bi bi-credit-card"></i> Cartão</span>
                                            @if (payment.InstallmentCount.HasValue && payment.InstallmentValue.HasValue)
                                            {
                                                <br><small class="text-muted">@payment.InstallmentCount.Value x de R$ @payment.InstallmentValue.Value.ToString(NumberFormatConstants.CurrencyTwoDecimals)</small>
                                            }
                                            break;
                                        case PaymentMethod.BankTransfer:
                                            <span class="badge bg-secondary"><i class="bi bi-bank"></i> Boleto</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @switch (payment.Status)
                                    {
                                        case PaymentStatus.Pending:
                                            <span class="badge bg-pending-payment"><i class="bi bi-cash-coin me-1"></i> Aguardando Pagamento</span>
                                            break;
                                        case PaymentStatus.Processing:
                                            <span class="badge bg-suspended"><i class="bi bi-arrow-repeat me-1"></i> Processando</span>
                                            break;
                                        case PaymentStatus.AwaitingValidation:
                                            <span class="badge bg-pending-payment"><i class="bi bi-clock-history me-1"></i> Aguardando Validação</span>
                                            break;
                                        case PaymentStatus.Paid:
                                            <span class="badge bg-active"><i class="bi bi-check-circle-fill me-1"></i> Pago</span>
                                            break;
                                        case PaymentStatus.Failed:
                                            <span class="badge bg-cancelled"><i class="bi bi-x-circle-fill me-1"></i> Falhou</span>
                                            break;
                                        case PaymentStatus.Cancelled:
                                            <span class="badge bg-cancelled"><i class="bi bi-x-circle-fill me-1"></i> Cancelado</span>
                                            break;
                                        case PaymentStatus.Refunded:
                                            <span class="badge bg-expired"><i class="bi bi-arrow-counterclockwise me-1"></i> Estornado</span>
                                            break;
                                        default:
                                            <span class="badge bg-expired"><i class="bi bi-question-circle-fill me-1"></i> @payment.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @payment.DueDate.ToString(DateFormatConstants.DisplayDateOnly)
                                    @if (payment.DueDate < DateTime.UtcNow && payment.Status == PaymentStatus.Pending)
                                    {
                                        <br><span class="badge bg-cancelled">Vencido</span>
                                    }
                                </td>
                                <td>
                                    @if (payment.PaidAt.HasValue)
                                    {
                                        @payment.PaidAt.Value.ToString(DateFormatConstants.DisplayDateAndTime)
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action(ActionNames.PaymentDetails, ControllerNames.Client, new { id = payment.Id })" class="btn btn-sm btn-primary">
                                        <i class="bi bi-eye"></i> Ver Detalhes
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Paginação">
            <ul class="pagination justify-content-center">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action(ActionNames.MyPayments, ControllerNames.Client, new { page = ViewBag.CurrentPage - 1 })">Anterior</a>
                    </li>
                }
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? CssClasses.Active : "")">
                        <a class="page-link" href="@Url.Action(ActionNames.MyPayments, ControllerNames.Client, new { page = i })">@i</a>
                    </li>
                }
                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action(ActionNames.MyPayments, ControllerNames.Client, new { page = ViewBag.CurrentPage + 1 })">Próximo</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

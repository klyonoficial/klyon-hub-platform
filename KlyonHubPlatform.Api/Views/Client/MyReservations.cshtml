@{
    ViewData["Title"] = "Minhas Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var sortBy = ViewBag.SortBy as string ?? "date_asc";
    var statusFilter = ViewBag.Status as string;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var searchFilter = ViewBag.Search as string ?? "";
    var roomTypeFilter = ViewBag.RoomType as string;
    var hasFilters = !string.IsNullOrEmpty(statusFilter) || dateFrom.HasValue || dateTo.HasValue || !string.IsNullOrWhiteSpace(searchFilter) || !string.IsNullOrEmpty(roomTypeFilter);
}

@model List<KlyonHubPlatform.Domain.Entities.Reservation>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar-check"></i> Minhas Reservas</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if ((Model == null || !Model.Any()) && !hasFilters)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Você ainda não possui reservas. <a href="@Url.Action("Marketplace", "Home")">Clique aqui para fazer sua primeira reserva!</a>
    </div>
}
else
{
    <form method="get" action="@Url.Action("MyReservations", "Client")" class="card mb-4">
        <input type="hidden" name="page" value="1" />
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Ordenar e filtrar</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6 col-lg-2">
                    <label class="form-label">Ordenar por</label>
                    <select name="sortBy" class="form-select">
                        @if (sortBy == "date_asc") { <option value="date_asc" selected>Data mais próxima / Horário</option> } else { <option value="date_asc">Data mais próxima / Horário</option> }
                        @if (sortBy == "date_desc") { <option value="date_desc" selected>Data mais distante</option> } else { <option value="date_desc">Data mais distante</option> }
                        @if (sortBy == "time_asc") { <option value="time_asc" selected>Horário mais cedo</option> } else { <option value="time_asc">Horário mais cedo</option> }
                        @if (sortBy == "time_desc") { <option value="time_desc" selected>Horário mais tarde</option> } else { <option value="time_desc">Horário mais tarde</option> }
                    </select>
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">Todos</option>
                        @if (statusFilter == "Confirmed") { <option value="Confirmed" selected>Confirmadas</option> } else { <option value="Confirmed">Confirmadas</option> }
                        @if (statusFilter == "Completed") { <option value="Completed" selected>Concluídas</option> } else { <option value="Completed">Concluídas</option> }
                        @if (statusFilter == "Cancelled") { <option value="Cancelled" selected>Canceladas</option> } else { <option value="Cancelled">Canceladas</option> }
                    </select>
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label">Data de</label>
                    <input type="date" name="dateFrom" class="form-control" value="@((dateFrom?.ToString("yyyy-MM-dd")) ?? "")">
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label">Data até</label>
                    <input type="date" name="dateTo" class="form-control" value="@((dateTo?.ToString("yyyy-MM-dd")) ?? "")">
                </div>
                <div class="col-md-6 col-lg-2">
                    <label class="form-label">Tipo de sala</label>
                    <select name="roomType" class="form-select">
                        <option value="">Todos</option>
                        @if (roomTypeFilter == "Shared") { <option value="Shared" selected>Compartilhada</option> } else { <option value="Shared">Compartilhada</option> }
                        @if (roomTypeFilter == "Private") { <option value="Private" selected>Privativa</option> } else { <option value="Private">Privativa</option> }
                    </select>
                </div>
                <div class="col-md-12 col-lg-2">
                    <label class="form-label">Pesquisar</label>
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Coworking, endereço, cidade" value="@searchFilter">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Filtrar</button>
                    <a href="@Url.Action("MyReservations", "Client")" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Limpar</a>
                </div>
            </div>
        </div>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-search"></i> Nenhuma reserva encontrada com os filtros aplicados. Tente alterar os critérios ou <a href="@Url.Action("MyReservations", "Client")">Limpar</a>.
        </div>
    }
    else
    {
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h5 class="text-primary">@(ViewBag.TotalReservations ?? Model.Count)</h5>
                            <small class="text-muted">Total de Reservas</small>
                        </div>
                        <div class="col-md-3">
                            <h5 class="text-success">@(ViewBag.TotalConfirmed ?? Model.Count(r => r.Status == "Confirmed"))</h5>
                            <small class="text-muted">Confirmadas</small>
                        </div>
                        <div class="col-md-3">
                            <h5 class="text-info">@(ViewBag.TotalCompleted ?? Model.Count(r => r.Status == "Completed"))</h5>
                            <small class="text-muted">Concluídas</small>
                        </div>
                        <div class="col-md-3">
                            <h5 class="text-danger">@(ViewBag.TotalCancelled ?? Model.Count(r => r.Status == "Cancelled"))</h5>
                            <small class="text-muted">Canceladas</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Informações de paginação -->
    @if (ViewBag.TotalItems != null)
    {
        <div class="mb-3">
            <p class="text-muted mb-0">
                Mostrando <strong>@((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)</strong> a 
                <strong>@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems))</strong> de 
                <strong>@ViewBag.TotalItems</strong> reserva(s)
            </p>
        </div>
    }

    <div class="row">
        @foreach (var reservation in Model)
        {
            var statusClass = reservation.Status switch
            {
                "Confirmed" => "success",
                "Completed" => "info",
                "Cancelled" => "danger",
                _ => "secondary"
            };

            var statusText = reservation.Status switch
            {
                "Confirmed" => "Confirmada",
                "Completed" => "Concluída",
                "Cancelled" => "Cancelada",
                _ => reservation.Status
            };

            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="badge bg-@statusClass">@statusText</span>
                        <small class="text-muted">#@reservation.Id</small>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-building"></i> @reservation.CoworkingAddress.Coworking.Name
                        </h5>
                        <p class="card-text mb-2">
                            <i class="bi bi-geo-alt"></i> <strong>Endereço:</strong><br>
                            @reservation.CoworkingAddress.Address<br>
                            <small class="text-muted">
                                @reservation.CoworkingAddress.Location.City - @reservation.CoworkingAddress.Location.State
                            </small>
                        </p>
                        <hr>
                        <div class="row">
                            <div class="col-6">
                                <p class="mb-1">
                                    <i class="bi bi-calendar-event"></i> <strong>Data:</strong><br>
                                    <span>@reservation.ReservationDate.ToString("dd/MM/yyyy")</span>
                                </p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1">
                                    <i class="bi bi-clock"></i> <strong>Horário:</strong><br>
                                    @if (reservation.StartTime.HasValue && reservation.EndTime.HasValue)
                                    {
                                        <span>@reservation.StartTime.Value.ToString(@"hh\:mm") - @reservation.EndTime.Value.ToString(@"hh\:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Não informado</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-6">
                                <p class="mb-1">
                                    <i class="bi bi-door-open"></i> <strong>Tipo de Sala:</strong><br>
                                    <span>@(reservation.RoomType == "Shared" ? "Compartilhada" : "Privativa")</span>
                                </p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1">
                                    <i class="bi bi-currency-dollar"></i> <strong>Valor:</strong><br>
                                    <span>R$ @reservation.TotalValue.ToString("F2")</span>
                                </p>
                            </div>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Valor Total:</strong> R$ @reservation.TotalValue.ToString("F2")
                            </div>
                            <small class="text-muted">
                                Criada em: @reservation.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>
                        @if (reservation.CancelledAt.HasValue)
                        {
                            <div class="mt-2">
                                <small class="text-danger">
                                    <i class="bi bi-x-circle"></i> Cancelada em: @reservation.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        }
                        @if (reservation.Status == "Confirmed" && !reservation.ClientConfirmedAt.HasValue)
                        {
                            <div class="mt-3">
                                <form method="post" action="@Url.Action("ConfirmReservationUsed", "Client")" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reservation.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-box-arrow-in-right"></i> Confirmar checkin
                                    </button>
                                </form>
                                <small class="d-block text-muted mt-1">Após você e o coworking confirmarem, o pagamento será processado.</small>
                            </div>
                        }
                        @if (reservation.ClientConfirmedAt.HasValue && reservation.Status == "Confirmed")
                        {
                            <div class="mt-2">
                                <small class="text-success"><i class="bi bi-check-circle"></i> Você confirmou uso em @reservation.ClientConfirmedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Aguardando confirmação do coworking.</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Paginação -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <nav aria-label="Paginação">
            <ul class="pagination justify-content-center mt-4">
                @if (ViewBag.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("MyReservations", "Client", new { 
                            sortBy = ViewBag.SortBy, 
                            status = ViewBag.Status, 
                            dateFrom = ViewBag.DateFrom, 
                            dateTo = ViewBag.DateTo, 
                            search = ViewBag.Search, 
                            roomType = ViewBag.RoomType, 
                            page = ViewBag.CurrentPage - 1 
                        })">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>
                }

                @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("MyReservations", "Client", new { 
                            sortBy = ViewBag.SortBy, 
                            status = ViewBag.Status, 
                            dateFrom = ViewBag.DateFrom, 
                            dateTo = ViewBag.DateTo, 
                            search = ViewBag.Search, 
                            roomType = ViewBag.RoomType, 
                            page = i 
                        })">
                            @i
                        </a>
                    </li>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("MyReservations", "Client", new { 
                            sortBy = ViewBag.SortBy, 
                            status = ViewBag.Status, 
                            dateFrom = ViewBag.DateFrom, 
                            dateTo = ViewBag.DateTo, 
                            search = ViewBag.Search, 
                            roomType = ViewBag.RoomType, 
                            page = ViewBag.CurrentPage + 1 
                        })">
                            Próxima <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }
    }
}

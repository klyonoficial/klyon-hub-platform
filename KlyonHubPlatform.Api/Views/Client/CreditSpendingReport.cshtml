@{
    ViewData["Title"] = "Relatório de Gastos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonHubPlatform.Domain.Entities.Reservation>

@{
    var totalValueSpent = ViewBag.TotalValueSpent as decimal? ?? 0;
    var totalReservations = ViewBag.TotalReservations as int? ?? 0;
    var confirmedReservations = ViewBag.ConfirmedReservations as int? ?? 0;
    var cancelledReservations = ViewBag.CancelledReservations as int? ?? 0;
    var completedReservations = ViewBag.CompletedReservations as int? ?? 0;
    var monthlySpending = ViewBag.MonthlySpending as dynamic;
    var filteredValueSpent = ViewBag.FilteredValueSpent as decimal? ?? totalValueSpent;
    var filteredReservations = ViewBag.FilteredReservations as int? ?? totalReservations;
    var selectedMonth = ViewBag.SelectedMonth as int?;
    var selectedYear = ViewBag.SelectedYear as int?;
    var isFiltered = selectedMonth.HasValue && selectedYear.HasValue;
}

<style>
    .month-filter-row:hover {
        background-color: #f8f9fa !important;
        transition: background-color 0.2s;
    }
    .month-filter-row.table-active {
        background-color: #e7f3ff !important;
        font-weight: 600;
    }
    .month-filter-row.table-active:hover {
        background-color: #d0e7ff !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-graph-up"></i> Relatório de Gastos</h2>
    @if (isFiltered)
    {
        <a href="@Url.Action("CreditSpendingReport", "Client")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-x-circle"></i> Remover Filtro
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Cards de Resumo -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card text-center border-primary">
            <div class="card-body">
                <h3 class="text-primary">@totalReservations</h3>
                <p class="card-text text-muted mb-0">Total de Reservas</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center border-success">
            <div class="card-body">
                <h3 class="text-success">R$ @totalValueSpent.ToString("F2")</h3>
                <p class="card-text text-muted mb-0">Valor Total Gasto</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center border-info">
            <div class="card-body">
                <h3 class="text-info">@confirmedReservations</h3>
                <p class="card-text text-muted mb-0">Reservas Confirmadas</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h3 class="text-warning">R$ @(totalReservations > 0 ? (totalValueSpent / totalReservations).ToString("F2") : "0,00")</h3>
                <p class="card-text text-muted mb-0">Média por Reserva</p>
            </div>
        </div>
    </div>
</div>

<!-- Estatísticas por Status -->
<div class="row mb-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Reservas por Status</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <h4 class="text-success">@confirmedReservations</h4>
                            <p class="mb-0">Confirmadas</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <h4 class="text-info">@completedReservations</h4>
                            <p class="mb-0">Concluídas</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded">
                            <h4 class="text-danger">@cancelledReservations</h4>
                            <p class="mb-0">Canceladas</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gastos por Mês -->
@if (monthlySpending != null && ((IEnumerable<dynamic>)monthlySpending).Any())
{
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-calendar-month"></i> Gastos por Mês</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Mês/Ano</th>
                                    <th class="text-end">Reservas</th>
                                    <th class="text-end">Valor Gasto (R$)</th>
                                    <th class="text-end">Média por Reserva (R$)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Opção "Todos" -->
                                <tr class="month-filter-row @(!isFiltered ? "table-active" : "")" 
                                    style="cursor: pointer;" 
                                    onclick="window.location.href='@Url.Action("CreditSpendingReport", "Client")'">
                                    <td>
                                        <strong>
                                            <i class="bi bi-check-circle @(!isFiltered ? "text-primary" : "")"></i> Todos
                                        </strong>
                                    </td>
                                    <td class="text-end">@totalReservations</td>
                                    <td class="text-end">R$ @totalValueSpent.ToString("F2")</td>
                                    <td class="text-end">R$ @(totalReservations > 0 ? (totalValueSpent / totalReservations).ToString("F2") : "0,00")</td>
                                </tr>
                                @foreach (var month in (IEnumerable<dynamic>)monthlySpending)
                                {
                                    var monthName = new DateTime(month.Year, month.Month, 1).ToString("MMMM/yyyy", new System.Globalization.CultureInfo("pt-BR"));
                                    var average = month.Count > 0 ? month.Value / month.Count : 0;
                                    var isSelected = isFiltered && selectedMonth == month.Month && selectedYear == month.Year;
                                    <tr class="month-filter-row @(isSelected ? "table-active" : "")" 
                                        style="cursor: pointer;" 
                                        onclick="window.location.href='@Url.Action("CreditSpendingReport", "Client", new { month = month.Month, year = month.Year })'">
                                        <td>
                                            <strong>
                                                @if (isSelected)
                                                {
                                                    <i class="bi bi-check-circle text-primary"></i>
                                                }
                                                @char.ToUpper(monthName[0])@monthName.Substring(1)
                                            </strong>
                                        </td>
                                        <td class="text-end">@month.Count</td>
                                        <td class="text-end">R$ @month.Value.ToString("F2")</td>
                                        <td class="text-end">R$ @average.ToString("F2")</td>
                                    </tr>
                                }
                            </tbody>
                            @if (isFiltered)
                            {
                                <tfoot>
                                    <tr class="table-info">
                                        <td><strong>FILTRADO (@(new DateTime(selectedYear.Value, selectedMonth.Value, 1).ToString("MMMM/yyyy", new System.Globalization.CultureInfo("pt-BR"))))</strong></td>
                                        <td class="text-end"><strong>@filteredReservations</strong></td>
                                        <td class="text-end"><strong>R$ @filteredValueSpent.ToString("F2")</strong></td>
                                        <td class="text-end"><strong>R$ @(filteredReservations > 0 ? (filteredValueSpent / filteredReservations).ToString("F2") : "0,00")</strong></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Detalhamento das Reservas -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Detalhamento das Reservas</h5>
            </div>
            <div class="card-body">
                @if (Model == null || !Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Você ainda não possui reservas.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Horário</th>
                                    <th>Coworking</th>
                                    <th>Tipo</th>
                                    <th class="text-end">Valor (R$)</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model)
                                {
                                    var statusClass = reservation.Status switch
                                    {
                                        "Confirmed" => "success",
                                        "Completed" => "info",
                                        "Cancelled" => "danger",
                                        _ => "secondary"
                                    };

                                    var statusText = reservation.Status switch
                                    {
                                        "Confirmed" => "Confirmada",
                                        "Completed" => "Concluída",
                                        "Cancelled" => "Cancelada",
                                        _ => reservation.Status
                                    };

                                    <tr>
                                        <td>@reservation.ReservationDate.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (reservation.StartTime.HasValue && reservation.EndTime.HasValue)
                                            {
                                                @reservation.StartTime.Value.ToString(@"hh\:mm")<text> - </text>@reservation.EndTime.Value.ToString(@"hh\:mm")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @reservation.CoworkingAddress.Coworking.Name<br>
                                            <small class="text-muted">@reservation.CoworkingAddress.Location.City - @reservation.CoworkingAddress.Location.State</small>
                                        </td>
                                        <td>@(reservation.RoomType == "Shared" ? "Compartilhada" : "Privativa")</td>
                                        <td class="text-end">R$ @reservation.TotalValue.ToString("F2")</td>
                                        <td><span class="badge bg-@statusClass">@statusText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

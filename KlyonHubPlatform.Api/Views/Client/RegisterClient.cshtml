@model KlyonHubPlatform.Domain.Entities.Client?
@{
    ViewData[ViewDataKeys.Title] = Model == null ? "Cadastro de Cliente" : "Editar Cliente";
    Layout = LayoutPaths.Layout;
    var client = Model ?? new KlyonHubPlatform.Domain.Entities.Client();
    var personType = ViewBag.PersonType as string ?? (!string.IsNullOrWhiteSpace(client.CNPJ) ? "Juridica" : "Fisica");
    var clientHasCnpj = ViewBag.ClientHasCnpj as bool? == true;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-person-plus"></i> @(Model == null ? "Cadastro de Cliente" : "Editar Cliente")</h2>
</div>

<div class="card">
    <div class="card-body">
        <form method="post" action="@Url.Action(ActionNames.RegisterClient, ControllerNames.Client)" id="formRegisterClient" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (ViewBag.ReturnUrl != null && !string.IsNullOrEmpty((string)ViewBag.ReturnUrl))
            {
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            }
            @if (Model != null)
            {
                <input type="hidden" name="Id" value="@Model.Id" />
            }
            <input type="hidden" name="PersonType" id="PersonType" value="@personType" />

            <div class="mb-4">
                <label class="form-label">Tipo de pessoa <span class="text-danger">*</span></label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="PersonTypeRadio" id="personFisica" value="Fisica" @(personType == "Fisica" ? "checked" : "")>
                        <label class="form-check-label" for="personFisica">Pessoa Física</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="PersonTypeRadio" id="personJuridica" value="Juridica" @(personType == "Juridica" ? "checked" : "")>
                        <label class="form-check-label" for="personJuridica">Pessoa Jurídica</label>
                    </div>
                </div>
            </div>

            <div id="campos-cpf" class="">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="CPF" class="form-label" id="labelCPF">@(personType == "Juridica" ? "CPF do responsável" : "CPF") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="CPF" name="CPF" placeholder="000.000.000-00" maxlength="14" value="@client.CPF" data-document-check="CPF" aria-describedby="CPF-feedback" required>
                        <div class="invalid-feedback d-block text-danger" id="CPF-feedback" role="alert" style="display: none;"></div>
                    </div>
                </div>
            </div>
            <div id="campos-juridica" class="@(personType == "Fisica" ? "d-none" : "")">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="CNPJ" class="form-label">CNPJ <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="CNPJ" name="CNPJ" placeholder="00.000.000/0000-00" maxlength="18" value="@client.CNPJ" data-document-check="CNPJ" aria-describedby="CNPJ-feedback" @(personType == "Juridica" ? "required" : "")>
                        <div class="invalid-feedback d-block text-danger" id="CNPJ-feedback" role="alert" style="display: none;"></div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="RazaoSocial" class="form-label">Razão Social <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="RazaoSocial" name="RazaoSocial" value="@client.RazaoSocial" @(personType == "Juridica" ? "required" : "")>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="NomeFantasia" class="form-label">Nome Fantasia</label>
                        <input type="text" class="form-control" id="NomeFantasia" name="NomeFantasia" value="@client.NomeFantasia">
                    </div>
                </div>
            </div>

            <div id="campos-nome-completo" class="@(personType == "Juridica" ? "d-none" : "")">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="ContactName" class="form-label">Nome Completo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ContactName" name="ContactName" value="@client.ContactName" @(personType == "Fisica" ? "required" : "")>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContactEmail" class="form-label">Email de Contato <span class="text-danger">*</span></label>
                    <input type="email" class="form-control" id="ContactEmail" name="ContactEmail"
                           value="@(Model?.ContactEmail ?? ViewBag.UserEmail)" @(Model == null ? "readonly" : "") required>
                    <small class="form-text text-muted">@(Model == null ? "Este email é o mesmo do seu cadastro e não pode ser alterado." : "")</small>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="ContactPhone" class="form-label">Telefone <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="ContactPhone" name="ContactPhone" placeholder="(00) 00000-0000" maxlength="15" value="@client.ContactPhone" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="ZipCode" class="form-label">CEP</label>
                    <input type="text" class="form-control" id="ZipCode" name="ZipCode" placeholder="00000-000" maxlength="9" value="@(client.ZipCode != null && client.ZipCode.Length == 8 ? client.ZipCode.Insert(5, "-") : client.ZipCode)">
                    <small class="form-text text-muted">Digite o CEP para preencher endereço, cidade e estado automaticamente.</small>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Address" class="form-label">Endereço (logradouro)</label>
                    <input type="text" class="form-control" id="Address" name="Address" value="@client.Address">
                </div>
                <div class="col-md-2 mb-3">
                    <label for="AddressNumber" class="form-label">Número</label>
                    <input type="text" class="form-control" id="AddressNumber" name="AddressNumber" value="@client.AddressNumber" placeholder="Nº">
                </div>
                <div class="col-md-4 mb-3">
                    <label for="Neighborhood" class="form-label">Bairro</label>
                    <input type="text" class="form-control" id="Neighborhood" name="Neighborhood" value="@client.Neighborhood">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Complement" class="form-label">Complemento</label>
                    <input type="text" class="form-control" id="Complement" name="Complement" value="@client.Complement" placeholder="Apto, sala, bloco...">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="City" class="form-label">Cidade</label>
                    <input type="text" class="form-control" id="City" name="City" value="@client.City">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="State" class="form-label">Estado <span class="text-danger">*</span></label>
                    <select class="form-select" id="State" name="State" required>
                        <option value="">Selecione o estado</option>
                        <option value="AC" selected="@(client.State == "AC")">AC - Acre</option>
                        <option value="AL" selected="@(client.State == "AL")">AL - Alagoas</option>
                        <option value="AP" selected="@(client.State == "AP")">AP - Amapá</option>
                        <option value="AM" selected="@(client.State == "AM")">AM - Amazonas</option>
                        <option value="BA" selected="@(client.State == "BA")">BA - Bahia</option>
                        <option value="CE" selected="@(client.State == "CE")">CE - Ceará</option>
                        <option value="DF" selected="@(client.State == "DF")">DF - Distrito Federal</option>
                        <option value="ES" selected="@(client.State == "ES")">ES - Espírito Santo</option>
                        <option value="GO" selected="@(client.State == "GO")">GO - Goiás</option>
                        <option value="MA" selected="@(client.State == "MA")">MA - Maranhão</option>
                        <option value="MT" selected="@(client.State == "MT")">MT - Mato Grosso</option>
                        <option value="MS" selected="@(client.State == "MS")">MS - Mato Grosso do Sul</option>
                        <option value="MG" selected="@(client.State == "MG")">MG - Minas Gerais</option>
                        <option value="PA" selected="@(client.State == "PA")">PA - Pará</option>
                        <option value="PB" selected="@(client.State == "PB")">PB - Paraíba</option>
                        <option value="PR" selected="@(client.State == "PR")">PR - Paraná</option>
                        <option value="PE" selected="@(client.State == "PE")">PE - Pernambuco</option>
                        <option value="PI" selected="@(client.State == "PI")">PI - Piauí</option>
                        <option value="RJ" selected="@(client.State == "RJ")">RJ - Rio de Janeiro</option>
                        <option value="RN" selected="@(client.State == "RN")">RN - Rio Grande do Norte</option>
                        <option value="RS" selected="@(client.State == "RS")">RS - Rio Grande do Sul</option>
                        <option value="RO" selected="@(client.State == "RO")">RO - Rondônia</option>
                        <option value="RR" selected="@(client.State == "RR")">RR - Roraima</option>
                        <option value="SC" selected="@(client.State == "SC")">SC - Santa Catarina</option>
                        <option value="SP" selected="@(client.State == "SP")">SP - São Paulo</option>
                        <option value="SE" selected="@(client.State == "SE")">SE - Sergipe</option>
                        <option value="TO" selected="@(client.State == "TO")">TO - Tocantins</option>
                    </select>
                </div>
            </div>
            @if (clientHasCnpj)
            {
                <div class="mb-4 mt-4 p-3 border rounded bg-light">
                    <h6 class="mb-3"><i class="bi bi-file-earmark-arrow-up"></i> Documentos</h6>
                    <p class="text-muted small mb-3">Você pode anexar os documentos abaixo.</p>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="CnpjDocument" class="form-label">CNPJ</label>
                            <input type="file" class="form-control" id="CnpjDocument" name="CnpjDocument" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="ContratoSocialDocument" class="form-label">Contrato social e última alteração ou contrato consolidado</label>
                            <input type="file" class="form-control" id="ContratoSocialDocument" name="ContratoSocialDocument" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label for="RgCnhRepresentantesDocument" class="form-label">RG/CNH dos representantes da empresa</label>
                            <input type="file" class="form-control" id="RgCnhRepresentantesDocument" name="RgCnhRepresentantesDocument" accept=".pdf,.jpg,.jpeg,.png">
                        </div>
                    </div>
                </div>
            }
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Salvar Cadastro
            </button>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function() {
    var personTypeInput = document.getElementById('PersonType');
    var personFisica = document.getElementById('personFisica');
    var personJuridica = document.getElementById('personJuridica');
    var camposJuridica = document.getElementById('campos-juridica');
    var camposNomeCompleto = document.getElementById('campos-nome-completo');
    var labelCPF = document.getElementById('labelCPF');
    var inputCPF = document.getElementById('CPF');
    var inputCNPJ = document.getElementById('CNPJ');
    var inputRazaoSocial = document.getElementById('RazaoSocial');
    var inputContactName = document.getElementById('ContactName');

    var checkDocumentUrl = '@Url.Action(ActionNames.CheckDocumentExists, ControllerNames.Client)';
    var excludeClientId = @(Model?.Id ?? 0);

    function onlyDigits(s) { return (s || '').replace(/\D/g, ''); }

    function setDocumentFeedback(inputEl, feedbackEl, showError, message) {
        if (!inputEl || !feedbackEl) return;
        if (showError) {
            inputEl.classList.add('is-invalid');
            feedbackEl.textContent = message || 'Documento inválido ou já cadastrado. Verifique o valor informado.';
            feedbackEl.style.display = 'block';
        } else {
            inputEl.classList.remove('is-invalid');
            feedbackEl.textContent = '';
            feedbackEl.style.display = 'none';
        }
    }

    async function checkDocument(inputEl, type) {
        if (!inputEl) return;
        var raw = onlyDigits(inputEl.value);
        var feedbackEl = document.getElementById(inputEl.id + '-feedback');
        if (type === 'CPF' && raw.length !== 11) {
            setDocumentFeedback(inputEl, feedbackEl, false);
            return;
        }
        if (type === 'CNPJ' && raw.length !== 14) {
            setDocumentFeedback(inputEl, feedbackEl, false);
            return;
        }
        var url = checkDocumentUrl + '?document=' + encodeURIComponent(inputEl.value) + '&type=' + encodeURIComponent(type);
        if (excludeClientId > 0) url += '&excludeClientId=' + excludeClientId;
        try {
            var r = await fetch(url);
            var data = await r.json();
            var showError = false;
            var message = (data && data.message) ? data.message : '';
            if (data && data.exists) {
                showError = true;
                if (!message) message = type === 'CPF' ? 'Este CPF já está cadastrado no sistema.' : 'Este CNPJ já está cadastrado no sistema.';
            } else if (data && data.valid === false) {
                showError = true;
                if (!message) message = type === 'CPF' ? 'Informe um CPF válido.' : 'Informe um CNPJ válido.';
            }
            setDocumentFeedback(inputEl, feedbackEl, showError, message);
        } catch (err) {
            console.error('Erro ao verificar documento:', err);
            setDocumentFeedback(inputEl, feedbackEl, true, 'Não foi possível validar o documento. Tente novamente.');
        }
    }

    if (inputCPF) {
        inputCPF.addEventListener('blur', function() { checkDocument(inputCPF, 'CPF'); });
        inputCPF.addEventListener('input', function() { setDocumentFeedback(inputCPF, document.getElementById('CPF-feedback'), false); });
    }
    if (inputCNPJ) {
        inputCNPJ.addEventListener('blur', function() { checkDocument(inputCNPJ, 'CNPJ'); });
        inputCNPJ.addEventListener('input', function() { setDocumentFeedback(inputCNPJ, document.getElementById('CNPJ-feedback'), false); });
    }

    var form = document.getElementById('formRegisterClient');
    if (form) {
        form.addEventListener('submit', function(e) {
            var invalidDoc = (inputCPF && inputCPF.classList.contains('is-invalid')) || (inputCNPJ && inputCNPJ.classList.contains('is-invalid'));
            if (invalidDoc) {
                e.preventDefault();
                if (typeof showToast === 'function') {
                    showToast('Corrija o CPF ou CNPJ antes de salvar. O documento informado já está cadastrado no sistema.', 'error');
                } else {
                    alert('O CPF ou CNPJ informado já está cadastrado no sistema. Corrija o documento antes de salvar.');
                }
            }
        });
    }

    function setPersonType(value) {
        personTypeInput.value = value;
        if (labelCPF) labelCPF.innerHTML = value === 'Juridica' ? 'CPF do responsável <span class="text-danger">*</span>' : 'CPF <span class="text-danger">*</span>';
        if (value === 'Fisica') {
            camposJuridica.classList.add('d-none');
            if (camposNomeCompleto) camposNomeCompleto.classList.remove('d-none');
            if (inputContactName) inputContactName.setAttribute('required', 'required');
            inputCPF.setAttribute('required', 'required');
            inputCNPJ.removeAttribute('required');
            inputRazaoSocial.removeAttribute('required');
            setDocumentFeedback(inputCNPJ, document.getElementById('CNPJ-feedback'), false);
        } else {
            camposJuridica.classList.remove('d-none');
            if (camposNomeCompleto) camposNomeCompleto.classList.add('d-none');
            if (inputContactName) inputContactName.removeAttribute('required');
            inputCPF.setAttribute('required', 'required');
            inputCNPJ.setAttribute('required', 'required');
            inputRazaoSocial.setAttribute('required', 'required');
            setDocumentFeedback(inputCPF, document.getElementById('CPF-feedback'), false);
        }
    }

    if (personFisica) personFisica.addEventListener('change', function() { setPersonType('Fisica'); });
    if (personJuridica) personJuridica.addEventListener('change', function() { setPersonType('Juridica'); });

    // Máscara e busca CEP
    function formatarCEP(cep) {
        cep = (cep || '').replace(/\D/g, '');
        if (cep.length >= 8) return cep.substring(0, 5) + '-' + cep.substring(5, 8);
        return cep;
    }
    var zipInput = document.getElementById('ZipCode');
    if (zipInput) {
        zipInput.addEventListener('input', function(e) {
            e.target.value = formatarCEP(e.target.value);
        });
        zipInput.addEventListener('blur', function() {
            buscarCEP(this.value);
        });
    }

    async function buscarCEP(cep) {
        cep = (cep || '').replace(/\D/g, '');
        if (cep.length !== 8) return;
        try {
            var r = await fetch('https://viacep.com.br/ws/' + cep + '/json/');
            var data = await r.json();
            if (!data.erro) {
                var addr = document.getElementById('Address');
                var neighborhood = document.getElementById('Neighborhood');
                var city = document.getElementById('City');
                var stateEl = document.getElementById('State');
                var uf = data.uf || '';
                if (addr) addr.value = data.logradouro || '';
                if (neighborhood) neighborhood.value = data.bairro || '';
                if (city) city.value = data.localidade || '';
                if (stateEl) stateEl.value = uf;
                // Select2: atualizar a exibição quando o valor é definido por script (busca CEP)
                if (uf && typeof $ !== 'undefined' && $('#State').length && $('#State').hasClass('select2-hidden-accessible')) {
                    $('#State').val(uf).trigger('change');
                }
            }
        } catch (err) {
            console.error('Erro ao buscar CEP:', err);
        }
    }
})();
</script>
}

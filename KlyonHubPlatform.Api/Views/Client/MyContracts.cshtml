@{
    ViewData[ViewDataKeys.Title] = "Contrato de Endereço Fiscal";
    Layout = LayoutPaths.Layout;
}

@model List<KlyonHubPlatform.Domain.Entities.Contract>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-earmark-text"></i> Contrato de Endereço Fiscal</h2>
    @if (!(ViewBag.HasActiveContract as bool? ?? false))
    {
        <a href="@Url.Action(ActionNames.ChooseLocation, ControllerNames.Client)" class="btn btn-primary">
            <i class="bi bi-geo-alt-fill"></i> Alugar Endereço Fiscal
        </a>
    }
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action(ActionNames.MyContracts, ControllerNames.Client)" class="row g-3">
            <div class="col-md-6">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Número do contrato, endereço ou cidade">
            </div>
            <div class="col-md-3">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="@ContractStatusFilterValues.Active" selected="@(ViewBag.Status == ContractStatusFilterValues.Active)">Ativos</option>
                    <option value="Suspended" selected="@(ViewBag.Status == "Suspended")">Suspensos</option>
                    <option value="PendingPayment" selected="@(ViewBag.Status == "PendingPayment")">Aguardando Pagamento</option>
                    <option value="@ContractStatusFilterValues.Cancelled" selected="@(ViewBag.Status == ContractStatusFilterValues.Cancelled)">Cancelados</option>
                    <option value="Expired" selected="@(ViewBag.Status == "Expired")">Expirados</option>
                    <option value="PendingCancellation" selected="@(ViewBag.Status == "PendingCancellation")">Cancelamento Pendente</option>
                </select>

            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action(ActionNames.MyContracts, ControllerNames.Client)" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    <div class="mb-3">
        <p class="text-muted mb-0">
            Mostrando <strong>@((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)</strong> a 
            <strong>@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems))</strong> de 
            <strong>@ViewBag.TotalItems</strong> contrato(s)
        </p>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Número</th>
                            <th>Endereço</th>
                            <th>Localidade</th>
                            <th>Valor Mensal</th>
                            <th>Status</th>
                            <th>Data Início</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model)
                        {
                            <tr>
                                <td><strong>@contract.ContractNumber</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(contract.SnapshotAddress))
                                    {
                                        <span>@contract.SnapshotAddress</span>
                                    }
                                    else
                                    {
                                        <span>@contract.CoworkingAddress?.Address, @contract.CoworkingAddress?.Number</span>
                                        @if (!string.IsNullOrEmpty(contract.CoworkingAddress?.Complement))
                                        {
                                            <br><small class="text-muted">@contract.CoworkingAddress.Complement</small>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (contract.CoworkingAddress?.Location != null)
                                    {
                                        <span class="badge bg-info">
                                            @contract.CoworkingAddress.Location.City/@contract.CoworkingAddress.Location.State
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <strong>R$ @(contract.SnapshotMonthlyValue > 0 ? contract.SnapshotMonthlyValue.ToString(NumberFormatConstants.TwoDecimals) : contract.MonthlyValue.ToString(NumberFormatConstants.TwoDecimals))</strong>
                                </td>
                                <td>
                                    @{
                                        string statusClass;
                                        string statusText;
                                        string statusIcon;
                                        if (contract.Status == ContractStatus.PendingPayment)
                                        {
                                            var hasPaymentAwaitingValidation = contract.Subscription?.Payments?.Any(p => p.Status == PaymentStatus.AwaitingValidation) == true;
                                            var hasPaymentProcessing = contract.Subscription?.Payments?.Any(p => p.Status == PaymentStatus.Processing) == true;
                                            if (hasPaymentProcessing)
                                            {
                                                statusClass = "suspended";
                                                statusText = "Processando";
                                                statusIcon = "bi-arrow-repeat";
                                            }
                                            else if (hasPaymentAwaitingValidation)
                                            {
                                                statusClass = "pending-payment";
                                                statusText = "Aguardando Validação";
                                                statusIcon = "bi-clock-history";
                                            }
                                            else
                                            {
                                                statusClass = "pending-payment";
                                                statusText = "Aguardando Pagamento";
                                                statusIcon = "bi-cash-coin";
                                            }
                                        }
                                        else
                                        {
                                            statusClass = contract.Status switch
                                            {
                                                ContractStatus.Active => CssClasses.Active,
                                                ContractStatus.Suspended => "suspended",
                                                ContractStatus.PendingCancellation => "pending-cancellation",
                                                ContractStatus.Cancelled => "cancelled",
                                                ContractStatus.Expired => "expired",
                                                _ => "expired"
                                            };
                                            (statusText, statusIcon) = contract.Status switch
                                            {
                                                ContractStatus.Active => ("Ativo", "bi-check-circle-fill"),
                                                ContractStatus.Suspended => ("Suspenso", "bi-pause-circle-fill"),
                                                ContractStatus.PendingCancellation => ("Cancelamento Pendente", "bi-clock-history"),
                                                ContractStatus.Cancelled => ("Cancelado", "bi-x-circle-fill"),
                                                ContractStatus.Expired => ("Expirado", "bi-calendar-x-fill"),
                                                _ => (contract.Status.ToString(), "bi-question-circle-fill")
                                            };
                                        }
                                    }
                                    <span class="badge bg-@statusClass">
                                        <i class="bi @statusIcon me-1"></i>
                                        @statusText
                                    </span>
                                </td>
                                <td>@contract.StartDate.ToString(DateFormatConstants.DisplayDateOnly)</td>
                                <td>
                                    <a href="@Url.Action(ActionNames.ContractDetails, ControllerNames.Client, new { id = contract.Id })" 
                                       class="btn btn-sm btn-primary" title="Ver Detalhes">
                                        <i class="bi bi-eye"></i> Detalhes
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center mt-3">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action(ActionNames.MyContracts, ControllerNames.Client, new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    page = ViewBag.CurrentPage - 1 
                                })">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? CssClasses.Active : "")">
                                <a class="page-link" href="@Url.Action(ActionNames.MyContracts, ControllerNames.Client, new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    page = i 
                                })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action(ActionNames.MyContracts, ControllerNames.Client, new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    page = ViewBag.CurrentPage + 1 
                                })">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum contrato encontrado.
                @if (ViewBag.Search != null || ViewBag.Status != null)
                {
                    <a href="@Url.Action(ActionNames.MyContracts, ControllerNames.Client)" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="bi bi-x-circle"></i> Limpar Filtros
                    </a>
                }
                else if (!(ViewBag.HasActiveContract as bool? ?? false))
                {
                    <a href="@Url.Action(ActionNames.ChooseLocation, ControllerNames.Client)" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Contratar Agora
                    </a>
                }
            </div>
        }
    </div>
</div>

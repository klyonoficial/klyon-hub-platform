@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@using System.Security.Claims
@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Domain.Core.Enums
@{
    // Mesmo critério do _Layout: só exibe "Aluguel de Salas" se Features.EnableCoworkingMenus = true
    var enableCoworkingMenusValue = await SystemConfigurationService.GetValueAsync(FeaturesConfigKey.EnableCoworkingMenus.ToConfigKey());
    var enableCoworkingMenus = enableCoworkingMenusValue?.ToLower() == "true";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData[ViewDataKeys.Title] != null ? ViewData[ViewDataKeys.Title] + " — " : "")Klyon — Endereço Fiscal e Espaços Corporativos</title>
    <meta name="description" content="Marketplace que conecta clientes a parceiros: endereço fiscal, coworking, salas de reunião e espaços corporativos. Simples, seguro e premium." />
    <link rel="icon" href="~/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@7.1.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true">
</head>
<body class="landing-body">
    <nav class="navbar navbar-expand-lg landing-nav fixed-top">
        <div class="lp-container container-fluid">
            <a class="navbar-brand fw-bold d-flex align-items-center" href="@Url.Action(ActionNames.Index, ControllerNames.Home)">
                <img src="~/images/logo-klyon-transparente-dourado-horizontal.png" alt="Klyon" class="d-inline-block" />
            </a>
            <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse" data-bs-target="#landingNav" aria-controls="landingNav" aria-expanded="false" aria-label="Menu">
                <i class="fa-solid fa-bars fs-4" aria-hidden="true"></i>
            </button>
            <div class="collapse navbar-collapse" id="landingNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action(ActionNames.Index, ControllerNames.Home)">Início</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Client") ? Url.Action(ActionNames.ChooseLocation, ControllerNames.Client) : Url.Action(ActionNames.FiscalAddress, ControllerNames.Home))">Endereço Fiscal</a>
                    </li>
                    @if (enableCoworkingMenus)
                    {
                    <li class="nav-item">
                        <a class="nav-link" href="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Client") ? Url.Action(ActionNames.Marketplace, ControllerNames.Home) : Url.Action(ActionNames.Rooms, ControllerNames.Home))">Aluguel de Salas</a>
                    </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action(ActionNames.Partner, ControllerNames.Home)">Quero ser Parceiro</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@(User.IsInRole("Administrator") ? Url.Action(ActionNames.Dashboard, ControllerNames.Admin) : User.IsInRole("Client") ? Url.Action(ActionNames.DashboardDetails, ControllerNames.Client) : Url.Action(ActionNames.Dashboard, ControllerNames.Coworking))">
                                <i class="fa-solid fa-th-large me-1" aria-hidden="true"></i> Área logada
                            </a>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="@Url.Action(ActionNames.Logout, ControllerNames.Auth)" class="d-inline ms-lg-2">
                                <button type="submit" class="btn btn-outline-light btn-sm">
                                    <i class="fa-solid fa-right-from-bracket me-1" aria-hidden="true"></i> Sair
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action(ActionNames.Login, ControllerNames.Auth)">Entrar</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm ms-lg-2" href="@(Url.Action(ActionNames.Register, ControllerNames.Auth) + "?role=Client")">
                                <i class="fa-solid fa-user-plus me-1" aria-hidden="true"></i> Cadastrar
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="pt-0">
        @RenderBody()
    </main>

    <footer class="landing-footer" id="contato">
        <div class="lp-container">
            <div class="row g-4">
                <div class="col-md-4">
                    <a href="@Url.Action(ActionNames.Index, ControllerNames.Home)" class="footer-brand d-inline-flex align-items-center mb-3">
                        <img src="~/images/logo-klyon-transparente-dourado-vertical.png" alt="Klyon" />
                    </a>
                    <p class="lp-text-muted small mb-0">
                        Marketplace de endereço fiscal e espaços corporativos. Conectamos clientes e parceiros com simplicidade e segurança.
                    </p>
                </div>
                <div class="col-md-2 col-6">
                    <h6 class="text-uppercase small fw-600 text-white mb-3">Institucional</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="@Url.Action(ActionNames.Privacy, ControllerNames.Home)">Política de privacidade</a></li>
                        <li class="mb-2"><a href="@Url.Action(ActionNames.Privacy, ControllerNames.Home)">Termos de uso</a></li>
                        <li class="mb-2"><a href="#contato">Contato</a></li>
                    </ul>
                </div>
                <div class="col-md-2 col-6">
                    <h6 class="text-uppercase small fw-600 text-white mb-3">Produto</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="@Url.Action(ActionNames.Index, ControllerNames.Home)">Início</a></li>
                        <li class="mb-2"><a href="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Client") ? Url.Action(ActionNames.ChooseLocation, ControllerNames.Client) : Url.Action(ActionNames.FiscalAddress, ControllerNames.Home))">Endereço Fiscal</a></li>
                        @if (enableCoworkingMenus)
                        {
                        <li class="mb-2"><a href="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Client") ? Url.Action(ActionNames.Marketplace, ControllerNames.Home) : Url.Action(ActionNames.Rooms, ControllerNames.Home))">Aluguel de Salas</a></li>
                        }
                        <li class="mb-2"><a href="@Url.Action(ActionNames.Partner, ControllerNames.Home)">Quero ser Parceiro</a></li>
                    </ul>
                </div>
                <div class="col-md-4 text-md-end">
                    <h6 class="text-uppercase small fw-600 text-white mb-3">Redes sociais</h6>
                    <div class="social-links">
                        <a href="https://www.instagram.com/klyonoficial" target="_blank" rel="noopener noreferrer" aria-label="Instagram Klyon"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary" />
            <div class="row">
                <div class="col-12 text-center lp-text-muted small">
                    © @DateTime.Now.Year <strong>Klyon</strong>. Todos os direitos reservados.
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/loading.js" asp-append-version="true"></script>
    <script src="~/js/funnel-analytics.js" asp-append-version="true"></script>

    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;" id="toastContainer"></div>

    <!-- Sistema de Notificações Toast (TempData) -->
    <script>
        function showToast(message, type, duration) {
            if (!message) return;
            var toastTypes = {
                'success': { class: 'bg-success text-white', icon: 'bi-check-circle-fill', title: 'Sucesso', closeClass: 'btn-close btn-close-white' },
                'error': { class: 'bg-danger text-white', icon: 'bi-exclamation-triangle-fill', title: 'Erro', closeClass: 'btn-close btn-close-white' },
                'warning': { class: 'bg-warning text-dark', icon: 'bi-exclamation-triangle-fill', title: 'Atenção', closeClass: 'btn-close' },
                'info': { class: 'bg-info text-white', icon: 'bi-info-circle-fill', title: 'Informação', closeClass: 'btn-close btn-close-white' }
            };
            var config = toastTypes[type] || toastTypes['info'];
            var el = document.createElement('div');
            el.className = 'toast align-items-center border-0 shadow-lg';
            el.setAttribute('role', 'alert');
            el.style.minWidth = '350px';
            el.style.maxWidth = '500px';
            el.innerHTML = '<div class="d-flex ' + config.class + ' rounded"><div class="toast-body d-flex align-items-center"><i class="bi ' + config.icon + ' fs-4 me-3"></i><div class="flex-grow-1"><strong>' + config.title + ':</strong> ' + message + '</div><button type="button" class="' + config.closeClass + ' ms-2" data-bs-dismiss="toast" aria-label="Fechar"></button></div></div>';
            var container = document.getElementById('toastContainer');
            if (container) {
                container.appendChild(el);
                var t = new bootstrap.Toast(el, { autohide: true, delay: duration || 5000 });
                t.show();
                el.addEventListener('hidden.bs.toast', function() { el.remove(); });
            }
        }
    </script>
    @{
        var _toastSuccess = TempData[SuccessMessage.TempDataKey]?.ToString();
        var _toastError = TempData[ErrorMessages.TempDataKey]?.ToString();
        var _toastInfo = TempData[TempDataKeys.Info]?.ToString();
        var _toastWarning = TempData[TempDataKeys.Warning]?.ToString();
    }
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var s = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastSuccess ?? ""));
            var e = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastError ?? ""));
            var i = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastInfo ?? ""));
            var w = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastWarning ?? ""));
            if (s) showToast(s, 'success');
            if (e) showToast(e, 'error', 7000);
            if (i) showToast(i, 'info');
            if (w) showToast(w, 'warning');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @* Widget de chat flutuante - Endereço Fiscal (em todas as páginas do layout landing) *@
    <style>
        #fiscal-chat-toggle { position: fixed; bottom: 28px; right: 28px; width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, #1a4d7a 0%, #0a1f3a 100%); color: #fff; border: none; box-shadow: 0 6px 24px rgba(0,0,0,0.45); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; z-index: 99999; transition: transform 0.2s, box-shadow 0.2s; }
        #fiscal-chat-toggle:hover { transform: scale(1.05); box-shadow: 0 8px 28px rgba(0,0,0,0.5); }
        #fiscal-chat-toggle svg { width: 28px; height: 28px; }
        #fiscal-chat-window { position: fixed; bottom: 96px; right: 28px; width: 380px; max-width: calc(100vw - 56px); height: 520px; max-height: calc(100vh - 140px); background: #fff; border-radius: 16px; box-shadow: 0 8px 32px rgba(0,0,0,0.3); display: none; flex-direction: column; z-index: 99999; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        #fiscal-chat-window.is-open { display: flex; }
        .fiscal-chat-header { background: linear-gradient(135deg, #1a4d7a 0%, #0a1f3a 100%); color: #fff; padding: 14px 16px; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
        .fiscal-chat-header-avatar { width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.25); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
        .fiscal-chat-header-text { flex: 1; }
        .fiscal-chat-header-title { font-weight: 600; font-size: 1rem; }
        .fiscal-chat-header-sub { font-size: 0.8rem; opacity: 0.9; }
        .fiscal-chat-header-actions { display: flex; gap: 4px; }
        .fiscal-chat-header-actions button { background: transparent; border: none; color: rgba(255,255,255,0.9); width: 32px; height: 32px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s; }
        .fiscal-chat-header-actions button:hover { background: rgba(255,255,255,0.15); }
        .fiscal-chat-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; background: #f8f9fa; }
        .fiscal-chat-msg { max-width: 85%; padding: 10px 14px; border-radius: 16px; font-size: 0.9rem; line-height: 1.4; word-wrap: break-word; }
        .fiscal-chat-msg.bot { align-self: flex-start; background: #e9ecef; color: #212529; border-bottom-left-radius: 4px; }
        .fiscal-chat-msg.user { align-self: flex-end; background: #1a4d7a; color: #fff; border-bottom-right-radius: 4px; }
        .fiscal-chat-msg.typing { align-self: flex-start; background: #e9ecef; padding: 12px 18px; }
        .fiscal-chat-typing-dots span { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #6c757d; margin: 0 2px; animation: fiscal-chat-bounce 1.4s ease-in-out infinite both; }
        .fiscal-chat-typing-dots span:nth-child(2) { animation-delay: 0.2s; }
        .fiscal-chat-typing-dots span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes fiscal-chat-bounce { 0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; } 40% { transform: scale(1.2); opacity: 1; } }
        .fiscal-chat-input-wrap { padding: 12px 16px; background: #fff; border-top: 1px solid #e9ecef; flex-shrink: 0; display: flex; gap: 8px; align-items: flex-end; }
        .fiscal-chat-input-wrap textarea { flex: 1; border: 1px solid #dee2e6; border-radius: 20px; padding: 10px 16px; font-size: 0.9rem; resize: none; min-height: 42px; max-height: 100px; font-family: inherit; }
        .fiscal-chat-input-wrap textarea:focus { outline: none; border-color: #1a4d7a; }
        .fiscal-chat-send { width: 42px; height: 42px; border-radius: 50%; background: #1a4d7a; color: #fff; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s; }
        .fiscal-chat-send:hover { background: #0a1f3a; }
        .fiscal-chat-send:disabled { opacity: 0.6; cursor: not-allowed; }
        .fiscal-chat-msg.bot .fiscal-chat-especialista-btn { display: inline-block; margin-top: 10px; padding: 8px 16px; background: #1a4d7a; color: #fff !important; border-radius: 20px; text-decoration: none; font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: background 0.2s; }
        .fiscal-chat-msg.bot .fiscal-chat-especialista-btn:hover { background: #0a1f3a; color: #fff !important; }
        .fiscal-chat-msg.bot .fiscal-chat-proxima-etapa-btn { display: inline-block; margin-top: 10px; margin-right: 8px; padding: 8px 16px; background: #28a745; color: #fff !important; border-radius: 20px; text-decoration: none; font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: background 0.2s; }
        .fiscal-chat-msg.bot .fiscal-chat-proxima-etapa-btn:hover { background: #218838; color: #fff !important; }
    </style>
    <button type="button" id="fiscal-chat-toggle" aria-label="Abrir chat de endereço fiscal" title="Endereço fiscal - Tire suas dúvidas">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.804 21.644A6.707 6.707 0 0 1 2 18H1a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h1a6.707 6.707 0 0 1 2.804-3.644l1.392-1.392A6.707 6.707 0 0 1 8 8.5V7a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v1.5a6.707 6.707 0 0 1 2.804 3.644l1.392 1.392A6.707 6.707 0 0 1 23 13v4a1 1 0 0 1-1 1h-1a6.707 6.707 0 0 1-2.804 3.644l-1.392 1.392A6.707 6.707 0 0 1 16 19.5V21a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1v-1.5a6.707 6.707 0 0 1-2.804-3.644l-1.392-1.392z"/></svg>
    </button>
    @{
        var fiscalChatNextStepUrl = User.Identity?.IsAuthenticated == true && User.IsInRole("Client")
            ? Url.Action("ChooseLocation", "Client")
            : Url.Action("FiscalAddress", "Home");
    }
    <div id="fiscal-chat-window" role="dialog" aria-label="Chat Endereço Fiscal" data-next-step-url="@fiscalChatNextStepUrl">
        <div class="fiscal-chat-header">
            <div class="fiscal-chat-header-avatar" aria-hidden="true">📍</div>
            <div class="fiscal-chat-header-text">
                <div class="fiscal-chat-header-title">Endereço Fiscal</div>
                <div class="fiscal-chat-header-sub">Klyon Coworking · Shopping Moxuara</div>
            </div>
            <div class="fiscal-chat-header-actions">
                <button type="button" id="fiscal-chat-minimize" aria-label="Minimizar"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 15l-6-6-6 6"/></svg></button>
                <button type="button" id="fiscal-chat-close" aria-label="Fechar"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
        </div>
        <div class="fiscal-chat-messages" id="fiscal-chat-messages"></div>
        <div class="fiscal-chat-input-wrap">
            <textarea id="fiscal-chat-input" rows="1" placeholder="Digite sua mensagem..." maxlength="1000" aria-label="Mensagem"></textarea>
            <button type="button" class="fiscal-chat-send" id="fiscal-chat-send" aria-label="Enviar"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg></button>
        </div>
    </div>
    <script>
    (function(){
        var API_BASE = '/api/fiscal-address-chat';
        var WHATSAPP_URL = 'https://wa.me/27989030369';
        var INACTIVITY_MS = 60000;
        var toggle = document.getElementById('fiscal-chat-toggle');
        var windowEl = document.getElementById('fiscal-chat-window');
        var NEXT_STEP_URL = (windowEl && windowEl.getAttribute('data-next-step-url') || '/Client/ChooseLocation').replace(/&amp;/g, '&');
        var messagesEl = document.getElementById('fiscal-chat-messages');
        var inputEl = document.getElementById('fiscal-chat-input');
        var sendBtn = document.getElementById('fiscal-chat-send');
        var closeBtn = document.getElementById('fiscal-chat-close');
        var minBtn = document.getElementById('fiscal-chat-minimize');
        var initialLoaded = false;
        var inactivityTimerId = null;
        var inactivityMessageShown = false;
        function openWindow(){ windowEl.classList.add('is-open'); if(!initialLoaded){ initialLoaded=true; fetch(API_BASE+'/initial').then(function(r){return r.json();}).then(function(d){ if(d&&d.message){ var div=document.createElement('div'); div.className='fiscal-chat-msg bot'; div.textContent=d.message; messagesEl.appendChild(div); messagesEl.scrollTop=messagesEl.scrollHeight; } startInactivityTimer(); }).catch(function(){ var div=document.createElement('div'); div.className='fiscal-chat-msg bot'; div.textContent='Olá! Como posso ajudar com endereço fiscal? Envie sua pergunta.'; messagesEl.appendChild(div); startInactivityTimer(); }); } else startInactivityTimer(); inputEl.focus(); }
        function closeWindow(){ windowEl.classList.remove('is-open'); stopInactivityTimer(); }
        if(toggle){ toggle.addEventListener('click',function(){ if(windowEl.classList.contains('is-open')) closeWindow(); else openWindow(); }); }
        if(closeBtn) closeBtn.addEventListener('click', closeWindow);
        if(minBtn) minBtn.addEventListener('click', closeWindow);
        function appendMessage(text, isUser){ var div=document.createElement('div'); div.className='fiscal-chat-msg '+(isUser?'user':'bot'); div.textContent=text; messagesEl.appendChild(div); messagesEl.scrollTop=messagesEl.scrollHeight; }
        function appendNextStepMessage(){ if(inactivityMessageShown) return; inactivityMessageShown=true; var div=document.createElement('div'); div.className='fiscal-chat-msg bot'; div.innerHTML='Podemos continuar para próxima etapa? Ou deseja falar com um especialista?<br><a href="'+NEXT_STEP_URL+'" class="fiscal-chat-proxima-etapa-btn">Ir para próxima etapa</a><a href="'+WHATSAPP_URL+'" target="_blank" rel="noopener noreferrer" class="fiscal-chat-especialista-btn">Falar com especialista</a>'; messagesEl.appendChild(div); messagesEl.scrollTop=messagesEl.scrollHeight; }
        function showTyping(){ var div=document.createElement('div'); div.className='fiscal-chat-msg typing'; div.id='fiscal-chat-typing'; div.innerHTML='<div class="fiscal-chat-typing-dots"><span></span><span></span><span></span></div>'; messagesEl.appendChild(div); messagesEl.scrollTop=messagesEl.scrollHeight; }
        function hideTyping(){ var el=document.getElementById('fiscal-chat-typing'); if(el) el.remove(); }
        function startInactivityTimer(){ stopInactivityTimer(); if(inactivityMessageShown) return; inactivityTimerId=setTimeout(function(){ inactivityTimerId=null; if(windowEl.classList.contains('is-open')) appendNextStepMessage(); }, INACTIVITY_MS); }
        function stopInactivityTimer(){ if(inactivityTimerId){ clearTimeout(inactivityTimerId); inactivityTimerId=null; } }
        function sendMessage(){
            var text=(inputEl.value||'').trim();
            if(!text) return;
            inputEl.value='';
            inactivityMessageShown=false;
            appendMessage(text, true);
            sendBtn.disabled=true;
            showTyping();
            fetch(API_BASE+'/chat',{ method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({message:text}) })
                .then(function(r){ return r.json(); })
                .then(function(d){ hideTyping(); appendMessage((d&&d.reply)?d.reply:'Não foi possível obter resposta. Tente novamente.', false); startInactivityTimer(); })
                .catch(function(){ hideTyping(); appendMessage('Erro de conexão. Tente novamente ou fale com o atendimento.', false); startInactivityTimer(); })
                .finally(function(){ sendBtn.disabled=false; inputEl.focus(); });
        }
        if(sendBtn) sendBtn.addEventListener('click', sendMessage);
        if(inputEl) inputEl.addEventListener('keydown', function(e){ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); sendMessage(); } });
    })();
    </script>
</body>
</html>

@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@{
    // Verificar se os menus de coworking estão habilitados
    var enableCoworkingMenus = await SystemConfigurationService.GetValueAsync("Features.EnableCoworkingMenus");
    var showCoworkingMenus = enableCoworkingMenus?.ToLower() == "true";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Klyon Endereço Fiscal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/klyon-theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .sidebar {
            min-height: calc(100vh - 56px);
        }
        .main-content {
            min-height: calc(100vh - 56px);
        }
        .content-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .container-fluid.d-flex {
            flex: 1;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-building"></i> Klyon Gestão de Endereço Fiscal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @{
                        var isClient = User.IsInRole("Client");
                        var isCoworking = User.IsInRole("CoworkingPartner");
                        var isAdmin = User.IsInRole("Administrator");
                        var isAuthenticated = User.Identity?.IsAuthenticated == true;
                    }
                    @if ((!isAuthenticated || (isClient && !isCoworking && !isAdmin)) && showCoworkingMenus)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Marketplace", "Home")">
                                <i class="bi bi-search"></i> Encontrar Coworking
                            </a>
                        </li>
                    }
                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            @{
                                // Prioridade: Administrator > CoworkingPartner > Client
                                // isAdmin, isCoworking, isClient já foram definidos acima
                            }
                            @if (isAdmin)
                            {
                                <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            }
                            else if (isCoworking && !isAdmin)
                            {
                                <a class="nav-link" href="@Url.Action("Dashboard", "Parceiro")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            }
                            else if (isClient && !isAdmin && !isCoworking)
                            {
                                <a class="nav-link" href="@Url.Action("Dashboard", "Client")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            }
                        </li>
                        <li class="nav-item dropdown" id="userMenuDropdown">
                            <span class="nav-link dropdown-toggle" id="userNameLink" style="cursor: pointer;" 
                                  onmouseenter="showUserMenu()" onmouseleave="hideUserMenu()">
                                @User.Identity.Name
                            </span>
                            <ul class="dropdown-menu" id="userMenu" style="display: none; margin-top: 0;" 
                                onmouseenter="showUserMenu()" onmouseleave="hideUserMenu()">
                                @if (isClient)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Client")">
                                        <i class="bi bi-person-badge"></i> Meu Perfil
                                    </a></li>
                                }
                                else if (isCoworking)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Parceiro")">
                                        <i class="bi bi-person-badge"></i> Meu Perfil
                                    </a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="@Url.Action("Logout", "Auth")" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link text-white">
                                    <i class="bi bi-box-arrow-right"></i> Sair
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Auth")">
                                <i class="bi bi-box-arrow-in-right"></i> Entrar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Register", "Auth")">
                                <i class="bi bi-person-plus"></i> Cadastrar
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid d-flex flex-column min-vh-100">
        <div class="row flex-grow-1">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="col-md-2 sidebar p-3">
                    <nav class="nav flex-column">
                        @if (User.IsInRole("Administrator"))
                        {
                            <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                <i class="bi bi-speedometer2"></i> Dashboard Admin
                            </a>
                            <a class="nav-link" href="@Url.Action("Users", "Admin")">
                                <i class="bi bi-people"></i> Usuários
                            </a>
                            <a class="nav-link" href="@Url.Action("Coworkings", "Admin")">
                                <i class="bi bi-building"></i> Coworkings Parceiros
                            </a>
                            <a class="nav-link" href="@Url.Action("Contracts", "Admin")">
                                <i class="bi bi-file-earmark-text"></i> Contratos de Endereço Fiscal
                            </a>
                            <a class="nav-link" href="@Url.Action("Locations", "Admin")">
                                <i class="bi bi-geo-alt"></i> Localidades Disponíveis
                            </a>
                            <a class="nav-link" href="@Url.Action("Reports", "Admin")">
                                <i class="bi bi-graph-up"></i> Relatórios Financeiros
                            </a>
                            <a class="nav-link" href="@Url.Action("SystemConfigurations", "Admin")">
                                <i class="bi bi-gear"></i> Configurações do Sistema
                            </a>
                            <a class="nav-link" href="@Url.Action("SefazConfiguration", "Admin")">
                                <i class="bi bi-receipt"></i> Configuração SEFAZ
                            </a>
                            <a class="nav-link" href="@Url.Action("DatabaseManager", "Admin")">
                                <i class="bi bi-database"></i> Gerenciador de BD
                            </a>
                        }
                        @if (User.IsInRole("CoworkingPartner"))
                        {
                            // Invocar ViewComponent para buscar produtos (ele popula ViewContext.ViewData)
                            var componentResult = await Component.InvokeAsync("CoworkingProducts");
                            var hasFiscalAddress = ViewData["HasFiscalAddress"] as bool? ?? false;
                            var hasRoomRental = ViewData["HasRoomRental"] as bool? ?? false;
                            
                            <a class="nav-link" href="@Url.Action("Dashboard", "Parceiro")">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                            
                            @* Menu Endereço Fiscal com submenu *@
                            <div class="sidebar-dropdown" id="enderecoFiscalParceiroDropdown">
                                <a class="nav-link sidebar-dropdown-toggle" id="enderecoFiscalParceiroLink" 
                                   onmouseenter="showSidebarMenu('enderecoFiscalParceiro')" 
                                   onmouseleave="hideSidebarMenu('enderecoFiscalParceiro')">
                                    <i class="bi bi-geo-alt-fill"></i> Endereço Fiscal
                                    <i class="bi bi-chevron-right float-end"></i>
                                </a>
                                <ul class="sidebar-submenu" id="enderecoFiscalParceiroMenu" 
                                    onmouseenter="showSidebarMenu('enderecoFiscalParceiro')" 
                                    onmouseleave="hideSidebarMenu('enderecoFiscalParceiro')">
                                    <li>
                                        <a class="nav-link" href="@Url.Action("MyAddresses", "Parceiro")">
                                            <i class="bi bi-geo-alt"></i> Meus Endereços Fiscais
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link" href="@Url.Action("ActiveContracts", "Parceiro")">
                                            <i class="bi bi-file-earmark-text"></i> Contratos de Endereço Fiscal
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            
                            <a class="nav-link" href="@Url.Action("MyContract", "Parceiro")">
                                <i class="bi bi-file-earmark-text"></i> Meu Contrato
                            </a>
                            <a class="nav-link" href="@Url.Action("Services", "Parceiro")">
                                <i class="bi bi-grid-3x3-gap"></i> Serviços e Percentagens
                            </a>
                            
                            @* Menu de Reservas e Aluguel de Salas - só aparece se habilitado nas configurações *@
                            @if (showCoworkingMenus)
                            {
                                <a class="nav-link" href="@Url.Action("Reservations", "Parceiro")">
                                    <i class="bi bi-calendar-check"></i> Reservas
                                </a>
                                
                                @* Menu de Aluguel de Salas - só aparece se o produto estiver marcado *@
                                @if (hasRoomRental)
                                {
                                    <a class="nav-link" href="@Url.Action("RoomRevenueReport", "Parceiro")">
                                        <i class="bi bi-currency-dollar"></i> Receita de Salas
                                    </a>
                                }
                            }
                            
                            @* Menu Financeiro com submenu *@
                            <div class="sidebar-dropdown" id="financeiroParceiroDropdown">
                                <a class="nav-link sidebar-dropdown-toggle" id="financeiroParceiroLink" 
                                   onmouseenter="showSidebarMenu('financeiroParceiro')" 
                                   onmouseleave="hideSidebarMenu('financeiroParceiro')">
                                    <i class="bi bi-wallet2"></i> Financeiro
                                    <i class="bi bi-chevron-right float-end"></i>
                                </a>
                                <ul class="sidebar-submenu" id="financeiroParceiroMenu" 
                                    onmouseenter="showSidebarMenu('financeiroParceiro')" 
                                    onmouseleave="hideSidebarMenu('financeiroParceiro')">
                                    <li>
                                        <a class="nav-link" href="@Url.Action("Commissions", "Parceiro")">
                                            <i class="bi bi-cash-coin"></i> Comissões
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link" href="@Url.Action("Transfers", "Parceiro")">
                                            <i class="bi bi-arrow-left-right"></i> Repasses
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        @if (User.IsInRole("Client"))
                        {
                            <a class="nav-link" href="@Url.Action("Services", "Client")">
                                <i class="bi bi-grid"></i> Serviços
                            </a>
                            <a class="nav-link" href="@Url.Action("DashboardDetails", "Client")">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                            
                            @* Menu Reservar Sala com submenu - só aparece se habilitado nas configurações *@
                            @if (showCoworkingMenus)
                            {
                                <div class="sidebar-dropdown" id="reservarSalaDropdown">
                                    <a class="nav-link sidebar-dropdown-toggle" id="reservarSalaLink" 
                                       onmouseenter="showSidebarMenu('reservarSala')" 
                                       onmouseleave="hideSidebarMenu('reservarSala')">
                                        <i class="bi bi-building"></i> Reservar Sala
                                        <i class="bi bi-chevron-right float-end"></i>
                                    </a>
                                    <ul class="sidebar-submenu" id="reservarSalaMenu" 
                                        onmouseenter="showSidebarMenu('reservarSala')" 
                                        onmouseleave="hideSidebarMenu('reservarSala')">
                                        <li>
                                            <a class="nav-link" href="@Url.Action("Marketplace", "Home")">
                                                <i class="bi bi-search"></i> Buscar Salas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="nav-link" href="@Url.Action("MyReservations", "Client")">
                                                <i class="bi bi-calendar-check"></i> Minhas Reservas
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            }
                            
                            <a class="nav-link" href="@Url.Action("CreditSpendingReport", "Client")">
                                <i class="bi bi-graph-up"></i> Relatório de Gastos
                            </a>
                            
                            @* Menu Endereço Fiscal com submenu *@
                            <div class="sidebar-dropdown" id="enderecoFiscalDropdown">
                                <a class="nav-link sidebar-dropdown-toggle" id="enderecoFiscalLink" 
                                   onmouseenter="showSidebarMenu('enderecoFiscal')" 
                                   onmouseleave="hideSidebarMenu('enderecoFiscal')">
                                    <i class="bi bi-geo-alt-fill"></i> Endereço Fiscal
                                    <i class="bi bi-chevron-right float-end"></i>
                                </a>
                                <ul class="sidebar-submenu" id="enderecoFiscalMenu" 
                                    onmouseenter="showSidebarMenu('enderecoFiscal')" 
                                    onmouseleave="hideSidebarMenu('enderecoFiscal')">
                                    <li>
                                        <a class="nav-link" href="@Url.Action("MyPayments", "Client")">
                                            <i class="bi bi-credit-card"></i> Meus Pagamentos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link" href="@Url.Action("ChooseLocation", "Client")">
                                            <i class="bi bi-plus-circle"></i> Contratar Endereço Fiscal
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link" href="@Url.Action("MyContracts", "Client")">
                                            <i class="bi bi-file-earmark-text"></i> Meus Contratos de Endereço Fiscal
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link" href="@Url.Action("MyPayments", "Client")">
                                            <i class="bi bi-receipt"></i> Cobranças de Endereço Fiscal
                                        </a>
                                    </li>
                                    <li>
                                        <a class="nav-link" href="@Url.Action("Declarations", "Client")">
                                            <i class="bi bi-file-text"></i> Declarações de Endereço Fiscal
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                    </nav>
                </div>
                <div class="col-md-10 main-content p-4">
                    @RenderBody()
                </div>
            }
            else
            {
                <div class="col-12 p-4">
                    @RenderBody()
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/masks.js" asp-append-version="true"></script>
    <script src="~/js/loading.js" asp-append-version="true"></script>
    <script>
        // Garantir que os formulários de idioma recarreguem a página após o submit
        document.addEventListener('DOMContentLoaded', function() {
            const languageForms = document.querySelectorAll('.language-form');
            languageForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    // Não prevenir o submit padrão, mas garantir que a página será recarregada
                    // O servidor já faz o redirect, mas isso garante que funcione
                });
            });
        });

        // Variáveis para controlar os timeouts de fechamento
        let hideUserMenuTimeout = null;
        let hideSidebarMenuTimeouts = {};

        // Função para mostrar o menu do usuário ao passar o mouse
        function showUserMenu() {
            // Cancelar qualquer timeout de fechamento pendente
            if (hideUserMenuTimeout) {
                clearTimeout(hideUserMenuTimeout);
                hideUserMenuTimeout = null;
            }
            
            const userMenu = document.getElementById('userMenu');
            if (userMenu) {
                userMenu.style.display = 'block';
            }
        }

        // Função para esconder o menu do usuário ao sair do mouse
        function hideUserMenu() {
            const userMenu = document.getElementById('userMenu');
            if (userMenu) {
                // Delay para evitar fechar quando o mouse está se movendo entre elementos
                hideUserMenuTimeout = setTimeout(function() {
                    const dropdown = document.getElementById('userMenuDropdown');
                    if (dropdown) {
                        // Verificar se o mouse ainda está sobre o dropdown ou o menu
                        const isHovering = dropdown.matches(':hover') || 
                                          (userMenu && userMenu.matches(':hover'));
                        
                        if (!isHovering) {
                            userMenu.style.display = 'none';
                        }
                    }
                }, 150);
            }
        }

        // Função para mostrar o submenu da sidebar
        function showSidebarMenu(menuId) {
            // Cancelar qualquer timeout de fechamento pendente para este menu
            if (hideSidebarMenuTimeouts[menuId]) {
                clearTimeout(hideSidebarMenuTimeouts[menuId]);
                hideSidebarMenuTimeouts[menuId] = null;
            }
            
            const menu = document.getElementById(menuId + 'Menu');
            if (menu) {
                menu.style.display = 'block';
            }
        }

        // Função para esconder o submenu da sidebar
        function hideSidebarMenu(menuId) {
            const menu = document.getElementById(menuId + 'Menu');
            const dropdown = document.getElementById(menuId + 'Dropdown');
            
            if (menu) {
                // Delay para evitar fechar quando o mouse está se movendo entre elementos
                hideSidebarMenuTimeouts[menuId] = setTimeout(function() {
                    if (dropdown) {
                        // Verificar se o mouse ainda está sobre o dropdown ou o menu
                        const isHovering = dropdown.matches(':hover') || 
                                          (menu && menu.matches(':hover'));
                        
                        if (!isHovering) {
                            menu.style.display = 'none';
                        }
                    } else {
                        menu.style.display = 'none';
                    }
                }, 150);
            }
        }

        // Garantir que os menus funcionem corretamente ao carregar a página
        document.addEventListener('DOMContentLoaded', function() {
            // Menu do usuário no topo
            const dropdown = document.getElementById('userMenuDropdown');
            const userMenu = document.getElementById('userMenu');
            
            if (dropdown && userMenu) {
                // Adicionar event listeners para melhor controle
                dropdown.addEventListener('mouseenter', function() {
                    showUserMenu();
                });
                
                dropdown.addEventListener('mouseleave', function() {
                    hideUserMenu();
                });
                
                // Garantir que o menu também responda ao hover direto
                userMenu.addEventListener('mouseenter', function() {
                    showUserMenu();
                });
                
                userMenu.addEventListener('mouseleave', function() {
                    hideUserMenu();
                });
            }

            // Submenus da sidebar
            const enderecoFiscalDropdown = document.getElementById('enderecoFiscalDropdown');
            const enderecoFiscalMenu = document.getElementById('enderecoFiscalMenu');
            
            if (enderecoFiscalDropdown && enderecoFiscalMenu) {
                enderecoFiscalDropdown.addEventListener('mouseenter', function() {
                    showSidebarMenu('enderecoFiscal');
                });
                
                enderecoFiscalDropdown.addEventListener('mouseleave', function() {
                    hideSidebarMenu('enderecoFiscal');
                });
                
                enderecoFiscalMenu.addEventListener('mouseenter', function() {
                    showSidebarMenu('enderecoFiscal');
                });
                
                enderecoFiscalMenu.addEventListener('mouseleave', function() {
                    hideSidebarMenu('enderecoFiscal');
                });
            }

            // Submenu Reservar Sala
            const reservarSalaDropdown = document.getElementById('reservarSalaDropdown');
            const reservarSalaMenu = document.getElementById('reservarSalaMenu');
            
            if (reservarSalaDropdown && reservarSalaMenu) {
                reservarSalaDropdown.addEventListener('mouseenter', function() {
                    showSidebarMenu('reservarSala');
                });
                
                reservarSalaDropdown.addEventListener('mouseleave', function() {
                    hideSidebarMenu('reservarSala');
                });
                
                reservarSalaMenu.addEventListener('mouseenter', function() {
                    showSidebarMenu('reservarSala');
                });
                
                reservarSalaMenu.addEventListener('mouseleave', function() {
                    hideSidebarMenu('reservarSala');
                });
            }

            // Submenu Endereço Fiscal Parceiro
            const enderecoFiscalParceiroDropdown = document.getElementById('enderecoFiscalParceiroDropdown');
            const enderecoFiscalParceiroMenu = document.getElementById('enderecoFiscalParceiroMenu');
            
            if (enderecoFiscalParceiroDropdown && enderecoFiscalParceiroMenu) {
                enderecoFiscalParceiroDropdown.addEventListener('mouseenter', function() {
                    showSidebarMenu('enderecoFiscalParceiro');
                });
                
                enderecoFiscalParceiroDropdown.addEventListener('mouseleave', function() {
                    hideSidebarMenu('enderecoFiscalParceiro');
                });
                
                enderecoFiscalParceiroMenu.addEventListener('mouseenter', function() {
                    showSidebarMenu('enderecoFiscalParceiro');
                });
                
                enderecoFiscalParceiroMenu.addEventListener('mouseleave', function() {
                    hideSidebarMenu('enderecoFiscalParceiro');
                });
            }

            // Submenu Financeiro Parceiro
            const financeiroParceiroDropdown = document.getElementById('financeiroParceiroDropdown');
            const financeiroParceiroMenu = document.getElementById('financeiroParceiroMenu');
            
            if (financeiroParceiroDropdown && financeiroParceiroMenu) {
                financeiroParceiroDropdown.addEventListener('mouseenter', function() {
                    showSidebarMenu('financeiroParceiro');
                });
                
                financeiroParceiroDropdown.addEventListener('mouseleave', function() {
                    hideSidebarMenu('financeiroParceiro');
                });
                
                financeiroParceiroMenu.addEventListener('mouseenter', function() {
                    showSidebarMenu('financeiroParceiro');
                });
                
                financeiroParceiroMenu.addEventListener('mouseleave', function() {
                    hideSidebarMenu('financeiroParceiro');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

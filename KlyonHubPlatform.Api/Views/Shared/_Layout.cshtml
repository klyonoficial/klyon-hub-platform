    <script>
        // Garantir que os formulários de idioma recarreguem a página após o submit
        document.addEventListener('DOMContentLoaded', function() {
            const languageForms = document.querySelectorAll('.language-form');
            languageForms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    // Não prevenir o submit padrão, mas garantir que a página será recarregada
                    // O servidor já faz o redirect, mas isso garante que funcione
                });
            });
        });

        // Variáveis para controlar os timeouts de fechamento (hideUserMenuTimeout já definida no head)
        let hideSidebarMenuTimeouts = {};

        // Função para mostrar o menu do usuário ao passar o mouse
        function showUserMenu() {
            // Cancelar qualquer timeout de fechamento pendente
            if (hideUserMenuTimeout) {
                clearTimeout(hideUserMenuTimeout);
                hideUserMenuTimeout = null;
            }
            
            const userMenu = document.getElementById('userMenu');
            if (userMenu) {
                userMenu.style.display = 'block';
            }
        }

        // Função para esconder o menu do usuário ao sair do mouse
        function hideUserMenu() {
            const userMenu = document.getElementById('userMenu');
            if (userMenu) {
                // Delay para evitar fechar quando o mouse está se movendo entre elementos
                hideUserMenuTimeout = setTimeout(function() {
                    const dropdown = document.getElementById('userMenuDropdown');
                    if (dropdown) {
                        // Verificar se o mouse ainda está sobre o dropdown ou o menu
                        const isHovering = dropdown.matches(':hover') || 
                                          (userMenu && userMenu.matches(':hover'));
                        
                        if (!isHovering) {
                            userMenu.style.display = 'none';
                        }
                    }
                }, 150);
            }
        }
        window.hideUserMenu = hideUserMenu;

        // Função para mostrar o submenu da sidebar
        // Função para alternar (abrir/fechar) o menu da sidebar
        function toggleSidebarMenu(menuId) {
            const dropdown = document.getElementById(menuId + 'Dropdown');
            const menu = document.getElementById(menuId + 'Menu');
            
            if (!dropdown || !menu) return;
            
            // Verificar se o menu está aberto
            const isOpen = dropdown.classList.contains('open');
            
            if (isOpen) {
                // Fechar o menu
                dropdown.classList.remove('open');
                menu.style.display = 'none';
            } else {
                // Fechar outros menus abertos (opcional - pode remover se quiser múltiplos abertos)
                document.querySelectorAll('.sidebar-dropdown.open').forEach(function(openDropdown) {
                    if (openDropdown !== dropdown) {
                        openDropdown.classList.remove('open');
                        const openMenu = openDropdown.querySelector('.sidebar-submenu');
                        if (openMenu) {
                            openMenu.style.display = 'none';
                        }
                    }
                });
                
                // Abrir o menu
                dropdown.classList.add('open');
                menu.style.display = 'block';
            }
        }

        // Função para verificar se uma URL corresponde à URL atual
        function isUrlMatch(linkHref, currentPath, currentUrl) {
            if (!linkHref) return false;
            
            try {
                // Tentar fazer match mais preciso
                const linkUrl = new URL(linkHref, window.location.origin);
                const linkPath = linkUrl.pathname.toLowerCase();
                
                // Verificar se a URL atual corresponde ao link (ignorando query strings para comparação)
                const currentPathOnly = currentPath.split('?')[0];
                const linkPathOnly = linkPath.split('?')[0];
                
                // Match exato ou se a URL atual começa com o path do link
                if (currentPathOnly === linkPathOnly || 
                    currentPathOnly.startsWith(linkPathOnly + '/') ||
                    (linkPathOnly !== '/' && currentPathOnly.includes(linkPathOnly))) {
                    return true;
                }
            } catch (e) {
                // Se não conseguir criar URL, fazer comparação simples
                const linkPath = linkHref.toLowerCase();
                const linkPathOnly = linkPath.split('?')[0];
                const currentPathOnly = currentPath.split('?')[0];
                
                if (currentPathOnly === linkPathOnly || 
                    currentPathOnly.startsWith(linkPathOnly + '/') ||
                    (linkPathOnly !== '/' && currentPathOnly.includes(linkPathOnly))) {
                    return true;
                }
            }
            
            return false;
        }

        // Função para marcar todos os menus ativos (links simples e dropdowns)
        function checkAndOpenActiveMenu() {
            const currentPath = window.location.pathname.toLowerCase();
            const currentUrl = window.location.href.toLowerCase();
            
            // Verificar todos os links simples da sidebar (não dropdowns)
            const sidebar = document.querySelector('.sidebar nav');
            if (sidebar) {
                const allLinks = sidebar.querySelectorAll('a.nav-link:not(.sidebar-dropdown-toggle)');
                allLinks.forEach(function(link) {
                    const linkHref = link.getAttribute('href');
                    if (linkHref && linkHref !== '#' && !linkHref.startsWith('#')) {
                        if (isUrlMatch(linkHref, currentPath, currentUrl)) {
                            link.classList.add('active');
                        } else {
                            link.classList.remove('active');
                        }
                    }
                });
            }
            
            // Lista de todos os menus dropdown
            const menuIds = ['enderecoFiscal', 'enderecoFiscalParceiro', 'enderecoFiscalAdmin', 'financeiroParceiro', 'reservarSala', 'notaFiscal', 'notaFiscalAdmin', 'financeiro', 'financeiroAdmin', 'configuracaoAdmin'];
            
            menuIds.forEach(function(menuId) {
                const menu = document.getElementById(menuId + 'Menu');
                if (!menu) return;
                
                // Verificar se algum link dentro do menu corresponde à URL atual
                const links = menu.querySelectorAll('a.nav-link');
                let hasActiveLink = false;
                
                links.forEach(function(link) {
                    const linkHref = link.getAttribute('href');
                    if (isUrlMatch(linkHref, currentPath, currentUrl)) {
                        link.classList.add('active');
                        hasActiveLink = true;
                    } else {
                        link.classList.remove('active');
                    }
                });
                
                // Se houver um link ativo, abrir o menu
                if (hasActiveLink) {
                    const dropdown = document.getElementById(menuId + 'Dropdown');
                    if (dropdown) {
                        dropdown.classList.add('open');
                        menu.style.display = 'block';
                    }
                }
            });
        }
        
        // Garantir que os menus funcionem corretamente ao carregar a página
        document.addEventListener('DOMContentLoaded', function() {
            // Menu do usuário no topo
            const dropdown = document.getElementById('userMenuDropdown');
            const userMenu = document.getElementById('userMenu');
            
            if (dropdown && userMenu) {
                // Adicionar event listeners para melhor controle
                dropdown.addEventListener('mouseenter', function() {
                    showUserMenu();
                });
                
                dropdown.addEventListener('mouseleave', function() {
                    hideUserMenu();
                });
                
                // Garantir que o menu também responda ao hover direto
                userMenu.addEventListener('mouseenter', function() {
                    showUserMenu();
                });
                
                userMenu.addEventListener('mouseleave', function() {
                    hideUserMenu();
                });
            }

            // Verificar e abrir menus que contêm itens ativos
            checkAndOpenActiveMenu();
            
            // Adicionar event listeners aos links do submenu para manter o menu aberto
            document.querySelectorAll('.sidebar-submenu a.nav-link').forEach(function(link) {
                link.addEventListener('click', function() {
                    // Encontrar o dropdown pai e mantê-lo aberto
                    const menu = this.closest('.sidebar-submenu');
                    if (menu) {
                        const menuId = menu.id.replace('Menu', '');
                        const dropdown = document.getElementById(menuId + 'Dropdown');
                        if (dropdown) {
                            dropdown.classList.add('open');
                            menu.style.display = 'block';
                        }
                    }
                });
            });
        });
    </script>
    
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999;" id="toastContainer"></div>
    
    <!-- Sistema de Notificações Toast -->
    <script>
        /**
         * Sistema de notificações toast elegante
         * Substitui os alerts padrão do JavaScript
         * 
         * Uso:
         * showToast('Mensagem de sucesso', 'success');
         * showToast('Mensagem de erro', 'error');
         * showToast('Mensagem de aviso', 'warning');
         * showToast('Mensagem informativa', 'info');
         */
        function showToast(message, type, duration) {
            type = type || (typeof Klyon !== 'undefined' && Klyon.ToastType ? Klyon.ToastType.Info : 'info');
            duration = duration || 5000;
            const toastTypes = (typeof Klyon !== 'undefined' && Klyon.ToastTypes) ? Klyon.ToastTypes : {
                success: { class: 'bg-success text-white', icon: 'bi-check-circle-fill', title: 'Sucesso', closeClass: 'btn-close btn-close-white' },
                error: { class: 'bg-danger text-white', icon: 'bi-exclamation-triangle-fill', title: 'Erro', closeClass: 'btn-close btn-close-white' },
                warning: { class: 'bg-warning text-dark', icon: 'bi-exclamation-triangle-fill', title: 'Atenção', closeClass: 'btn-close' },
                info: { class: 'bg-info text-white', icon: 'bi-info-circle-fill', title: 'Informação', closeClass: 'btn-close btn-close-white' }
            };
            const config = toastTypes[type] || toastTypes.info;
            const closeBtnClass = config.closeClass || 'btn-close btn-close-white';
            const toastId = 'toast-' + Date.now();
            
            // Criar elemento toast
            const toastElement = document.createElement('div');
            toastElement.id = toastId;
            toastElement.className = 'toast align-items-center border-0 shadow-lg';
            toastElement.setAttribute('role', 'alert');
            toastElement.setAttribute('aria-live', 'assertive');
            toastElement.setAttribute('aria-atomic', 'true');
            toastElement.style.minWidth = '350px';
            toastElement.style.maxWidth = '500px';
            
            toastElement.innerHTML = `
                <div class="d-flex ${config.class} rounded">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi ${config.icon} fs-4 me-3"></i>
                        <div class="flex-grow-1">
                            <strong>${config.title}:</strong> ${message}
                        </div>
                        <button type="button" class="${closeBtnClass} ms-2" data-bs-dismiss="toast" aria-label="Fechar"></button>
                    </div>
                </div>
            `;
            
            // Adicionar ao container
            const container = document.getElementById('toastContainer');
            if (!container) {
                // Criar container se não existir
                const newContainer = document.createElement('div');
                newContainer.id = 'toastContainer';
                newContainer.className = 'toast-container position-fixed top-0 end-0 p-3';
                newContainer.style.zIndex = '9999';
                document.body.appendChild(newContainer);
                newContainer.appendChild(toastElement);
            } else {
                container.appendChild(toastElement);
            }
            
            // Inicializar e mostrar toast
            const toast = new bootstrap.Toast(toastElement, {
                autohide: true,
                delay: duration
            });
            
            toast.show();
            
            // Remover elemento após esconder
            toastElement.addEventListener('hidden.bs.toast', function() {
                toastElement.remove();
            });
            
            return toast;
        }
        
        // Substituir alert padrão (opcional - pode ser comentado se não quiser sobrescrever)
        // window.alert = function(message) {
        //     showToast(message, 'info');
        // };
    </script>
    
    @{
        var _toastSuccess = TempData[SuccessMessage.TempDataKey]?.ToString();
        var _toastError = TempData[ErrorMessages.TempDataKey]?.ToString();
        var _toastErrorDetails = TempData[TempDataKeys.ErrorDetails]?.ToString();
        var _toastWarning = TempData[TempDataKeys.Warning]?.ToString();
        var _toastInfo = TempData[TempDataKeys.Info]?.ToString();
        var _toastUnsupportedStates = TempData[TempDataKeys.UnsupportedStates]?.ToString();
    }
    <script>
        (function() {
            document.addEventListener('DOMContentLoaded', function() {
                var delay = 0;
                function showTempToast(message, type, duration) {
                    if (!message) return;
                    setTimeout(function() {
                        if (typeof showToast === 'function') showToast(message, type, duration || 5000);
                    }, delay);
                    delay += 200;
                }
                var err = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastError ?? ""));
                if (err) {
                    var errDetail = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastErrorDetails ?? ""));
                    showTempToast(errDetail ? (err + " " + errDetail) : err, 'error', 7000);
                }
                showTempToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastWarning ?? "")), (typeof Klyon !== 'undefined' && Klyon.ToastType ? Klyon.ToastType.Warning : 'warning'));
                showTempToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastSuccess ?? "")), (typeof Klyon !== 'undefined' && Klyon.ToastType ? Klyon.ToastType.Success : 'success'));
                showTempToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastInfo ?? "")), (typeof Klyon !== 'undefined' && Klyon.ToastType ? Klyon.ToastType.Info : 'info'));
                showTempToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(_toastUnsupportedStates ?? "")), (typeof Klyon !== 'undefined' && Klyon.ToastType ? Klyon.ToastType.Warning : 'warning'));
            });
        })();
    </script>
    
    <!-- Modal de Confirmação Elegante -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title d-flex align-items-center" id="confirmModalLabel">
                        <i class="bi bi-question-circle-fill text-primary me-2 fs-4"></i>
                        <span id="confirmModalTitle">Confirmar Ação</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body pt-3">
                    <p class="mb-0" id="confirmModalMessage"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="confirmModalCancel">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" id="confirmModalConfirm">
                        <i class="bi bi-check-circle"></i> Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Sistema de Confirmação Elegante -->
    <script>
        /**
         * Sistema de confirmação elegante
         * Substitui o confirm() padrão do JavaScript
         * 
         * Uso:
         * showConfirm('Deseja realmente fazer isso?', 'Atenção', 'warning')
         *   .then(result => {
         *     if (result) {
         *       // Usuário confirmou
         *     }
         *   });
         * 
         * Ou com async/await:
         * const confirmed = await showConfirm('Deseja continuar?');
         * if (confirmed) { ... }
         */
        function showConfirm(message, title = 'Confirmar Ação', type = 'info') {
            return new Promise((resolve) => {
                const modal = document.getElementById('confirmModal');
                if (!modal) {
                    console.error('Modal de confirmação não encontrado');
                    resolve(false);
                    return;
                }
                
                const modalTitle = document.getElementById('confirmModalTitle');
                const modalMessage = document.getElementById('confirmModalMessage');
                const confirmBtn = document.getElementById('confirmModalConfirm');
                const cancelBtn = document.getElementById('confirmModalCancel');
                
                if (!modalTitle || !modalMessage || !confirmBtn || !cancelBtn) {
                    console.error('Elementos do modal de confirmação não encontrados');
                    resolve(false);
                    return;
                }
                
                const modalInstance = bootstrap.Modal.getOrCreateInstance(modal);
                
                // Configurar título e mensagem
                modalTitle.textContent = title;
                modalMessage.textContent = message;
                
                // Configurar cores e ícones baseado no tipo
                const typeConfig = {
                    'danger': {
                        icon: 'bi-exclamation-triangle-fill',
                        iconColor: 'text-danger',
                        btnClass: 'btn-danger'
                    },
                    'warning': {
                        icon: 'bi-exclamation-triangle-fill',
                        iconColor: 'text-warning',
                        btnClass: 'btn-warning'
                    },
                    'success': {
                        icon: 'bi-check-circle-fill',
                        iconColor: 'text-success',
                        btnClass: 'btn-success'
                    },
                    'info': {
                        icon: 'bi-question-circle-fill',
                        iconColor: 'text-primary',
                        btnClass: 'btn-primary'
                    }
                };
                
                const config = typeConfig[type] || typeConfig['info'];
                
                // Atualizar ícone do título
                const titleIcon = modalTitle.querySelector('i');
                if (titleIcon) {
                    titleIcon.className = `bi ${config.icon} ${config.iconColor} me-2 fs-4`;
                }
                
                // Atualizar botão de confirmação
                confirmBtn.className = `btn ${config.btnClass}`;
                
                // Remover listeners anteriores clonando os botões
                const newConfirmBtn = confirmBtn.cloneNode(true);
                const newCancelBtn = cancelBtn.cloneNode(true);
                confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);
                cancelBtn.parentNode.replaceChild(newCancelBtn, cancelBtn);
                
                // Flag para não resolver false quando o usuário clicou em Confirmar (o onHidden resolve true)
                let userConfirmed = false;
                // Adicionar novos listeners: ao confirmar, fechar o modal e só depois exibir o loading (para o loading não ser bloqueado por isConfirmModalOpen)
                newConfirmBtn.addEventListener('click', () => {
                    userConfirmed = true;
                    modal.removeAttribute('data-confirm-open');
                    const onHidden = () => {
                        if (window.KlyonLoading && window.KlyonLoading.show) {
                            window.KlyonLoading.show();
                        }
                        resolve(true);
                    };
                    modal.addEventListener('hidden.bs.modal', onHidden, { once: true });
                    modalInstance.hide();
                });
                
                newCancelBtn.addEventListener('click', () => {
                    modalInstance.hide();
                    resolve(false);
                });
                
                // Fechar ao clicar no X ou fora do modal (só resolve false se não foi Confirmar)
                const handleHidden = () => {
                    if (!userConfirmed) resolve(false);
                };
                modal.addEventListener('hidden.bs.modal', handleHidden, { once: true });
                
                // REGRA CRÍTICA: Esconder loading se estiver visível antes de mostrar o modal de confirmação
                // O loading NUNCA deve aparecer na frente do modal de confirmação
                if (window.KlyonLoading && window.KlyonLoading.hide) {
                    window.KlyonLoading.hide();
                }
                
                // Marcar modal como aberto antes de mostrar
                modal.setAttribute('data-confirm-open', 'true');
                
                // Mostrar modal
                modalInstance.show();
                
                // Remover marcação quando o modal for fechado
                const handleModalHidden = () => {
                    modal.removeAttribute('data-confirm-open');
                };
                modal.addEventListener('hidden.bs.modal', handleModalHidden, { once: true });
            });
        }
        
        // Substituir confirm padrão do JavaScript por showConfirm elegante
        // NOTA: Como confirm() é síncrono/bloqueante e showConfirm() é assíncrono,
        // não podemos substituir diretamente. O código deve usar showConfirm() explicitamente.
        // Esta função serve apenas como fallback e aviso para desenvolvedores.
        const originalConfirm = window.confirm;
        window.confirm = function(message) {
            console.warn('⚠️ window.confirm() foi chamado. Use showConfirm() para uma experiência melhor e consistente com o sistema.');
            return originalConfirm(message);
        };
    </script>
    

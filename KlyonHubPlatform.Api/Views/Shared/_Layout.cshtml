@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@inject KlyonHubPlatform.Application.Interfaces.IClientMenuService ClientMenuService
@using System.Security.Claims
@using KlyonHubPlatform.Api.Constants
@using KlyonHubPlatform.Domain.Core.Enums
@{
    // Verificar se os menus de coworking estão habilitados
    var enableCoworkingMenus = await SystemConfigurationService.GetValueAsync(FeaturesConfigKey.EnableCoworkingMenus.ToConfigKey());
    var showCoworkingMenus = enableCoworkingMenus?.ToLower() == "true";

    // Cliente não pode adicionar novo endereço fiscal se já tiver contrato ativo (status "Ativo" em Meus Contratos).
    // Ocultar "Localidades Disponíveis" no menu quando houver endereço ativo.
    var clientHasActiveContract = false;
    if (User.IsInRole("Client") && User.Identity?.IsAuthenticated == true)
    {
        var userIdStr = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userIdStr, out var userId))
            clientHasActiveContract = await ClientMenuService.ClientHasActiveContractAsync(userId);
    }
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData[ViewDataKeys.Title] - Klyon Endereço Fiscal</title>
    <link rel="icon" href="~/favicon.png" type="image/png" />
    <script>
        // Definir no head para que existam antes do navbar (evita ReferenceError no onmouseenter)
        var hideUserMenuTimeout = null;
        function showUserMenu() {
            if (hideUserMenuTimeout) { clearTimeout(hideUserMenuTimeout); hideUserMenuTimeout = null; }
            var el = document.getElementById('userMenu');
            if (el) el.style.display = 'block';
        }
        function hideUserMenu() {
            var userMenu = document.getElementById('userMenu');
            if (userMenu) {
                hideUserMenuTimeout = setTimeout(function() {
                    var dropdown = document.getElementById('userMenuDropdown');
                    if (dropdown && !dropdown.matches(':hover') && !(userMenu.matches(':hover')))
                        userMenu.style.display = 'none';
                }, 150);
            }
        }
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/klyon-theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true">

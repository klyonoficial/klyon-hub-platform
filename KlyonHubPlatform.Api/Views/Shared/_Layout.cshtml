@inject KlyonHubPlatform.Application.Interfaces.ISystemConfigurationService SystemConfigurationService
@{
    // Verificar se os menus de coworking estão habilitados
    var enableCoworkingMenus = await SystemConfigurationService.GetValueAsync("Features.EnableCoworkingMenus");
    var showCoworkingMenus = enableCoworkingMenus?.ToLower() == "true";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Klyon Endereço Fiscal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/klyon-theme.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/loading.css" asp-append-version="true">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .sidebar {
            min-height: calc(100vh - 56px);
        }
        .main-content {
            min-height: calc(100vh - 56px);
        }
        .content-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
        }
        .container-fluid.d-flex {
            flex: 1;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-building"></i> Klyon Gestão de Endereço Fiscal
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @{
                        var isClient = User.IsInRole("Client");
                        var isCoworking = User.IsInRole("CoworkingPartner");
                        var isAdmin = User.IsInRole("Administrator");
                        var isAuthenticated = User.Identity?.IsAuthenticated == true;
                    }
                    @if ((!isAuthenticated || (isClient && !isCoworking && !isAdmin)) && showCoworkingMenus)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Marketplace", "Home")">
                                <i class="bi bi-search"></i> Encontrar Coworking
                            </a>
                        </li>
                    }
                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            @{
                                // Prioridade: Administrator > CoworkingPartner > Client
                                // isAdmin, isCoworking, isClient já foram definidos acima
                            }
                            @if (isAdmin)
                            {
                                <a class="nav-link" href="@Url.Action("Dashboard", "Admin")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            }
                            else if (isCoworking && !isAdmin)
                            {
                                <a class="nav-link" href="@Url.Action("Dashboard", "Parceiro")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            }
                            else if (isClient && !isAdmin && !isCoworking)
                            {
                                <a class="nav-link" href="@Url.Action("Dashboard", "Client")">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            }
                        </li>
                        <li class="nav-item dropdown" id="userMenuDropdown">
                            <span class="nav-link dropdown-toggle" id="userNameLink" style="cursor: pointer;" 
                                  onmouseenter="showUserMenu()" onmouseleave="hideUserMenu()">
                                @User.Identity.Name
                            </span>
                            <ul class="dropdown-menu" id="userMenu" style="display: none; margin-top: 0;" 
                                onmouseenter="showUserMenu()" onmouseleave="hideUserMenu()">
                                @if (isClient)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Client")">
                                        <i class="bi bi-person-badge"></i> Meu Perfil
                                    </a></li>
                                }
                                else if (isCoworking)
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Profile", "Parceiro")">
                                        <i class="bi bi-person-badge"></i> Meu Perfil
                                    </a></li>
                                }
                            </ul>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="@Url.Action("Logout", "Auth")" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link text-white">
                                    <i class="bi bi-box-arrow-right"></i> Sair
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Login", "Auth")">
                                <i class="bi bi-box-arrow-in-right"></i> Entrar

@using KlyonHubPlatform.Api.Constants
@{
    var mustChangePassword = ViewData[ViewDataKeys.MustChangePassword] as bool? == true;
}
<!-- Modal Alterar Senha -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title d-flex align-items-center" id="changePasswordModalLabel">
                    <i class="bi bi-key-fill text-primary me-2 fs-4"></i>
                    @PageTitles.ChangePassword
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <form id="changePasswordForm" method="post" action="@Url.Action(ActionNames.ChangePassword, ControllerNames.Auth)" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-body pt-3">
                    <div id="changePasswordAlert" class="alert alert-danger d-none" role="alert"></div>

                    <div class="mb-3 @(mustChangePassword ? "d-none" : "")" id="currentPasswordGroup"
                         data-must-change="@(mustChangePassword ? "true" : "false")">
                        <label for="modalCurrentPassword" class="form-label">Senha atual <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="modalCurrentPassword" name="currentPassword"
                               autocomplete="current-password" @(mustChangePassword ? "" : "required") />
                    </div>

                    <div class="mb-3">
                        <label for="modalNewPassword" class="form-label">Nova senha <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="modalNewPassword" name="newPassword"
                               required minlength="6" autocomplete="new-password" />
                        <small class="form-text text-muted">Mínimo de 6 caracteres.</small>
                    </div>

                    <div class="mb-0">
                        <label for="modalConfirmPassword" class="form-label">Confirmar nova senha <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="modalConfirmPassword" name="confirmPassword"
                               required minlength="6" autocomplete="new-password" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary" id="changePasswordSubmitBtn">
                        <i class="bi bi-check-circle"></i> Alterar Senha
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    var form = document.getElementById('changePasswordForm');
    if (!form) return;

    var alertEl = document.getElementById('changePasswordAlert');
    var currentGroup = document.getElementById('currentPasswordGroup');
    var currentInput = document.getElementById('modalCurrentPassword');
    var newInput = document.getElementById('modalNewPassword');
    var confirmInput = document.getElementById('modalConfirmPassword');
    var submitBtn = document.getElementById('changePasswordSubmitBtn');
    var modalEl = document.getElementById('changePasswordModal');
    var statusUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action(ActionNames.MustChangePasswordStatus, ControllerNames.Auth)));

    function showError(msg) {
        if (!alertEl) return;
        alertEl.textContent = msg || 'Não foi possível alterar a senha.';
        alertEl.classList.remove('d-none');
    }

    function hideError() {
        if (!alertEl) return;
        alertEl.textContent = '';
        alertEl.classList.add('d-none');
    }

    function applyMustChange(mustChange) {
        if (!currentGroup || !currentInput) return;
        currentGroup.setAttribute('data-must-change', mustChange ? 'true' : 'false');
        if (mustChange) {
            currentGroup.classList.add('d-none');
            currentInput.removeAttribute('required');
            currentInput.value = '';
        } else {
            currentGroup.classList.remove('d-none');
            currentInput.setAttribute('required', 'required');
        }
    }

    if (modalEl) {
        modalEl.addEventListener('show.bs.modal', function () {
            hideError();
            form.reset();
            applyMustChange(currentGroup && currentGroup.getAttribute('data-must-change') === 'true');
            if (statusUrl) {
                fetch(statusUrl, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data && data.success === true) {
                            applyMustChange(!!data.mustChangePassword);
                        }
                    })
                    .catch(function () { /* mantém flag do ViewData */ });
            }
        });
    }

    confirmInput && confirmInput.addEventListener('input', function () {
        if (newInput && this.value !== newInput.value) {
            this.setCustomValidity('As senhas não coincidem.');
        } else {
            this.setCustomValidity('');
        }
    });

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        hideError();

        if (newInput && confirmInput && newInput.value !== confirmInput.value) {
            showError('As senhas não coincidem.');
            return;
        }
        if (newInput && newInput.value.length < 6) {
            showError('A senha deve ter no mínimo 6 caracteres.');
            return;
        }

        var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
        var token = tokenInput ? tokenInput.value : '';
        var body = new FormData(form);
        if (submitBtn) {
            submitBtn.disabled = true;
        }

        fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'RequestVerificationToken': token,
                'Accept': 'application/json'
            },
            body: body
        })
        .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
        .then(function (result) {
            if (result.data && result.data.success) {
                var modalInstance = bootstrap.Modal.getInstance(modalEl) || (modalEl ? new bootstrap.Modal(modalEl) : null);
                if (modalInstance) modalInstance.hide();
                applyMustChange(false);
                if (typeof showToast === 'function') {
                    showToast(result.data.message || 'Senha alterada com sucesso!', 'success');
                }
                return;
            }
            showError((result.data && result.data.error) || 'Não foi possível alterar a senha.');
        })
        .catch(function () {
            showError('Erro de comunicação. Tente novamente.');
        })
        .finally(function () {
            if (submitBtn) submitBtn.disabled = false;
        });
    });
})();
</script>

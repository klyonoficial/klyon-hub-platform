@{
    ViewData[ViewDataKeys.Title] = "Quero ser Parceiro";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    var urlCadastro = Url.Action("Register", "Auth") + "?role=CoworkingPartner";
    var urlLogin = Url.Action("Login", "Auth");
}

<section class="lp-commercial-hero">
    <div class="lp-container position-relative">
        <div class="text-center">
            <h1 class="lp-section-title mb-3">Seja parceiro Klyon</h1>
            <p class="lp-section-subtitle mx-auto mb-4">
                Cadastre seu coworking ou espaço corporativo e receba clientes em busca de endereço fiscal e salas — com processo digital e suporte da Klyon.
            </p>
            <a href="@urlCadastro" class="lp-btn-primary btn-lg mb-3" data-funnel="cta_partner_apply">
                <i class="fa-solid fa-handshake me-2" aria-hidden="true"></i> Candidatar meu espaço
            </a>
            <p class="lp-text-muted small">Leva cerca de 10 minutos · Análise em até 3 dias úteis</p>
        </div>
    </div>
</section>

<section class="lp-section">
    <div class="lp-container">
        <h2 class="lp-section-title text-center mb-2">O que você ganha</h2>
        <div class="lp-benefits justify-content-center mb-5">
            <div class="lp-benefit">
                <div class="lp-benefit-icon"><i class="fa-solid fa-eye" aria-hidden="true"></i></div>
                <div>
                    <h4>Visibilidade nacional</h4>
                    <p>Seu endereço aparece para empresas que buscam contratar endereço fiscal na sua região.</p>
                </div>
            </div>
            <div class="lp-benefit">
                <div class="lp-benefit-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
                <div>
                    <h4>Clientes qualificados</h4>
                    <p>Demanda de MEIs e empresas que já conhecem a plataforma Klyon.</p>
                </div>
            </div>
            <div class="lp-benefit">
                <div class="lp-benefit-icon"><i class="fa-solid fa-file-contract" aria-hidden="true"></i></div>
                <div>
                    <h4>Operação digital</h4>
                    <p>Contratos, correspondências e repasses centralizados no painel do parceiro.</p>
                </div>
            </div>
        </div>

        <h2 class="lp-section-title text-center mb-2">Como funciona</h2>
        <p class="lp-section-subtitle text-center mx-auto mb-4">Quatro passos até seu endereço estar no ar.</p>
        <div class="row g-4 mb-5">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <span class="badge bg-primary rounded-pill mb-2">1</span>
                        <h5 class="card-title">Conta</h5>
                        <p class="card-text small text-muted">Nome, e-mail e senha. Role fixo como parceiro.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <span class="badge bg-primary rounded-pill mb-2">2</span>
                        <h5 class="card-title">Empresa + endereço</h5>
                        <p class="card-text small text-muted">CNPJ, dados do espaço e preço anual do endereço fiscal.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <span class="badge bg-primary rounded-pill mb-2">3</span>
                        <h5 class="card-title">Documentos</h5>
                        <p class="card-text small text-muted">Comprovante de endereço, autorização fiscal e cartão CNPJ.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center">
                        <span class="badge bg-success rounded-pill mb-2">4</span>
                        <h5 class="card-title">No ar</h5>
                        <p class="card-text small text-muted">Após aprovação da Klyon, clientes encontram seu endereço na listagem.</p>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="lp-section-title text-center mb-2">O que você precisa ter em mãos</h2>
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <ul class="list-group list-group-flush shadow-sm rounded">
                    <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i> CNPJ ativo do coworking</li>
                    <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i> Comprovante de endereço (água, luz ou IPTU — últimos 90 dias)</li>
                    <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i> Declaração de autorização de uso de endereço fiscal</li>
                    <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i> Cartão CNPJ</li>
                    <li class="list-group-item"><i class="bi bi-check-circle-fill text-success me-2"></i> Endereço completo e preço anual pretendido</li>
                </ul>
                <p class="text-muted small mt-3 text-center">Dados bancários e fotos podem ser completados depois, no perfil.</p>
            </div>
        </div>

        <div class="text-center">
            <a href="@urlCadastro" class="lp-btn-primary btn-lg" data-funnel="cta_partner_apply_bottom">
                <i class="fa-solid fa-handshake me-2" aria-hidden="true"></i> Candidatar meu espaço
            </a>
            <p class="lp-text-muted small mt-3 mb-2">Já tem conta?</p>
            <a href="@urlLogin" class="lp-btn-secondary">Entrar</a>
        </div>
    </div>
</section>

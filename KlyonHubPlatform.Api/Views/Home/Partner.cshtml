@{
    ViewData[ViewDataKeys.Title] = "Quero ser Parceiro";
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    var urlCadastro = Url.Action("Register", "Auth") + "?role=CoworkingPartner";
    var urlLogin = Url.Action("Login", "Auth");
}

<section class="lp-commercial-hero">
    <div class="lp-container position-relative">
        <div class="text-center">
            <h1 class="lp-section-title mb-3">Quero ser Parceiro</h1>
            <p class="lp-section-subtitle mx-auto mb-4">
                Cadastre seu coworking ou espaço corporativo na Klyon e receba clientes em busca de endereço fiscal e salas de reunião.
            </p>
            <a href="@urlCadastro" class="lp-btn-primary btn-lg mb-3">
                <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i> Cadastrar como parceiro
            </a>
        </div>
    </div>
</section>

<section class="lp-section">
    <div class="lp-container">
        <h2 class="lp-section-title text-center mb-2">Por que ser parceiro Klyon</h2>
        <p class="lp-section-subtitle text-center mx-auto mb-4">
            Visibilidade, clientes qualificados e suporte em todo o fluxo.
        </p>
        <div class="lp-benefits justify-content-center">
            <div class="lp-benefit">
                <div class="lp-benefit-icon"><i class="fa-solid fa-eye" aria-hidden="true"></i></div>
                <div>
                    <h4>Visibilidade</h4>
                    <p>Seu espaço aparece para clientes que buscam endereço fiscal e salas em sua região.</p>
                </div>
            </div>
            <div class="lp-benefit">
                <div class="lp-benefit-icon"><i class="fa-solid fa-handshake" aria-hidden="true"></i></div>
                <div>
                    <h4>Clientes qualificados</h4>
                    <p>Receba demandas de empresas e profissionais que já conhecem a plataforma.</p>
                </div>
            </div>
            <div class="lp-benefit">
                <div class="lp-benefit-icon"><i class="fa-solid fa-headset" aria-hidden="true"></i></div>
                <div>
                    <h4>Suporte</h4>
                    <p>Processo digital, contrato e documentação com suporte da Klyon.</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <p class="lp-text-muted small mb-2">Já tem conta?</p>
            <a href="@urlLogin" class="lp-btn-secondary">Entrar</a>
        </div>
    </div>
</section>

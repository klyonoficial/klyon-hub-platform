@section Scripts {
    <style>
        .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
        }
        .form-control.is-valid {
            border-color: #28a745;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%2328a745' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right calc(0.375em + 0.1875rem) center;
            background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
        }
        .form-control.is-invalid {
            border-color: #dc3545;
        }
        #submitBtn {
            transition: all 0.3s ease;
        }
        #submitBtn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }
        .form-label i {
            margin-right: 5px;
        }
    </style>

    <script>
        function openPhotoGallery(index) {
            // A função é chamada quando clica na imagem
            // O modal já abre automaticamente via data-bs-toggle
        }

        // Atualizar contador de fotos
        var galleryCarousel = document.getElementById('galleryCarousel');
        if (galleryCarousel) {
            galleryCarousel.addEventListener('slid.bs.carousel', function (e) {
                var activeIndex = Array.from(e.target.querySelectorAll('.carousel-item')).indexOf(e.relatedTarget);
                var total = @Model.PhotoIds.Count;
                document.getElementById('photoCounter').textContent = (activeIndex + 1) + ' / ' + total;
            });
        }

        // Validação de horários no modal de reserva
        var reservationStartTime = document.getElementById('reservationStartTime');
        var reservationEndTime = document.getElementById('reservationEndTime');
        var sharedPricePerHour = @(ViewBag.SharedRoomPricePerHour?.ToString("F2") ?? "0");
        var privatePricePerHour = @(ViewBag.PrivateRoomPricePerHour?.ToString("F2") ?? "0");

        // Garantir que as variáveis globais estejam inicializadas
        window.unavailableDates = window.unavailableDates || [];
        window.unavailableTimeSlots = window.unavailableTimeSlots || [];
        var currentRoomType = 'Shared';
        var addressId = @Model.Address.Id;

        // Carregar disponibilidade quando o tipo de sala mudar ou data for selecionada
        async function loadAvailability(roomType, selectedDate) {
            currentRoomType = roomType;
            
            try {
                var url = '@Url.Action("GetAvailability", "Home")?addressId=' + addressId + '&roomType=' + roomType;
                if (selectedDate) {
                    url += '&date=' + selectedDate;
                }

                var response = await fetch(url);
                var data = await response.json();

                if (data.error) {
                    console.error('Erro ao carregar disponibilidade:', data.error);
                    return;
                }

                if (selectedDate) {
                    // Carregar horários ocupados para a data específica
                    window.unavailableTimeSlots = data.occupiedSlots || [];
                    updateTimeInputsAvailability();
                } else {
                    // Carregar dias indisponíveis
                    window.unavailableDates = data.unavailableDates || [];
                    updateDateInputAvailability();
                }
            } catch (error) {
                console.error('Erro ao carregar disponibilidade:', error);
            }
        }

        function updateDateInputAvailability() {
            var dateInput = document.getElementById('reservationDate');
            if (!dateInput) return;

            // Limpar validação customizada anterior
            dateInput.setCustomValidity('');

            dateInput.addEventListener('change', function() {
                var selectedDate = this.value;
                if (selectedDate && window.unavailableDates && window.unavailableDates.includes(selectedDate)) {
                    this.setCustomValidity('Esta data não está disponível para reserva.');
                    this.classList.add('is-invalid');
                    var infoEl = document.getElementById('dateAvailabilityInfo');
                    if (infoEl) {
                        infoEl.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Data indisponível</span>';
                    }
                } else {
                    this.setCustomValidity('');
                    this.classList.remove('is-invalid');
                    var infoEl = document.getElementById('dateAvailabilityInfo');
                    if (infoEl) {
                        infoEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Data disponível</span>';
                    }
                    // Carregar horários disponíveis para esta data
                    if (selectedDate) {
                        loadAvailability(currentRoomType, selectedDate);
                    }
                }
            });
        }

        function updateTimeInputsAvailability() {
            // Esta função pode ser expandida para desabilitar horários específicos
            // Por enquanto, apenas valida se o horário está disponível ao tentar reservar
        }

        function calculateReservationCost() {
            var startTime = reservationStartTime?.value;
            var endTime = reservationEndTime?.value;
            var roomType = document.querySelector('input[name="RoomType"]:checked')?.value || 'Shared';
            var costInfo = document.getElementById('reservationCostInfo');
            var creditsNeededSpan = document.getElementById('creditsNeeded');
            var durationSpan = document.getElementById('duration');
            var endTimeInvalidFeedback = document.getElementById('endTimeInvalidFeedback');

            if (!startTime || !endTime || !costInfo) {
                if (costInfo) costInfo.style.display = 'none';
                return;
            }

            // Validar horários
            if (endTime <= startTime) {
                if (reservationEndTime) {
                    reservationEndTime.setCustomValidity('O horário final deve ser maior que o inicial.');
                    reservationEndTime.classList.add('is-invalid');
                    if (endTimeInvalidFeedback) {
                        endTimeInvalidFeedback.textContent = 'O horário final deve ser maior que o inicial.';
                    }
                }
                if (costInfo) costInfo.style.display = 'none';
                return;
            } else {
                if (reservationEndTime) {
                    reservationEndTime.setCustomValidity('');
                    reservationEndTime.classList.remove('is-invalid');
                }
            }

            // Verificar se o horário está disponível
            var selectedDate = document.getElementById('reservationDate')?.value;
            if (selectedDate && window.unavailableTimeSlots && window.unavailableTimeSlots.length > 0) {
                var hasConflict = false;
                for (var slot of window.unavailableTimeSlots) {
                    // Verificar sobreposição de horários
                    if ((startTime >= slot.start && startTime < slot.end) ||
                        (endTime > slot.start && endTime <= slot.end) ||
                        (startTime <= slot.start && endTime >= slot.end)) {
                        hasConflict = true;
                        break;
                    }
                }
                
                if (hasConflict) {
                    if (reservationStartTime) {
                        reservationStartTime.setCustomValidity('Este horário não está disponível.');
                        reservationStartTime.classList.add('is-invalid');
                    }
                    if (reservationEndTime) {
                        reservationEndTime.setCustomValidity('Este horário não está disponível.');
                        reservationEndTime.classList.add('is-invalid');
                    }
                    if (costInfo) costInfo.style.display = 'none';
                    return;
                }
            }

            // Calcular duração em horas
            var start = new Date('2000-01-01T' + startTime + ':00');
            var end = new Date('2000-01-01T' + endTime + ':00');
            if (end <= start) {
                end.setDate(end.getDate() + 1); // Se passar da meia-noite
            }
            var diffMs = end - start;
            var diffHours = Math.max(1, Math.ceil(diffMs / (1000 * 60 * 60))); // Mínimo 1 hora, arredondar para cima

            // Obter preço por hora baseado no tipo
            var pricePerHour = roomType === 'Shared' ? sharedPricePerHour : privatePricePerHour;

            if (pricePerHour <= 0) {
                costInfo.style.display = 'none';
                return;
            }

            // Calcular créditos necessários (1 crédito = R$ 1,00)
            var totalValue = pricePerHour * diffHours;
            var creditsNeeded = Math.ceil(totalValue);

            // Atualizar exibição
            creditsNeededSpan.textContent = creditsNeeded;
            durationSpan.textContent = diffHours + (diffHours === 1 ? ' hora' : ' horas');
            costInfo.style.display = 'block';

            // Verificar créditos disponíveis
            if (creditsWarning) {
                if (availableCredits < creditsNeeded) {
                    creditsWarning.style.display = 'block';
                    creditsWarningText.textContent = 'Você não possui créditos suficientes. Necessário: ' + creditsNeeded + ' créditos, Disponível: ' + availableCredits + ' créditos.';
                } else {
                    creditsWarning.style.display = 'none';
                }
            }
        }

        if (reservationStartTime && reservationEndTime) {
            reservationStartTime.addEventListener('change', calculateReservationCost);
            reservationEndTime.addEventListener('change', calculateReservationCost);
            
            // Calcular ao carregar se já houver valores
            setTimeout(calculateReservationCost, 100);
        }

        // Carregar disponibilidade inicial
        var initialRoomType = document.querySelector('input[name="RoomType"]:checked')?.value || 'Shared';
        loadAvailability(initialRoomType);

        // Atualizar disponibilidade quando o tipo de sala mudar
        var roomTypeInputs = document.querySelectorAll('input[name="RoomType"]');
        roomTypeInputs.forEach(function(input) {
            input.addEventListener('change', function() {
                var selectedDate = document.getElementById('reservationDate')?.value;
                loadAvailability(this.value, selectedDate);
                calculateReservationCost();
            });
        });

        // Atualizar disponibilidade quando a data mudar
        var dateInput = document.getElementById('reservationDate');
        if (dateInput) {
            dateInput.addEventListener('change', function() {
                var roomType = document.querySelector('input[name="RoomType"]:checked')?.value || 'Shared';
                if (this.value) {
                    loadAvailability(roomType, this.value);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Máscara para telefone com formatação dinâmica
            const phoneInput = document.querySelector('input[name="Phone"]');
            if (phoneInput) {
                phoneInput.addEventListener('input', function(e) {
                    let value = e.target.value.replace(/\D/g, '');
                    if (value.startsWith('55')) {
                        value = '+' + value;
                    } else if (!value.startsWith('+55')) {
                        value = '+55' + value;
                    }
                    e.target.value = value;
                    
                    // Feedback visual
                    if (value.length >= 13) {
                        this.classList.add('is-valid');
                        this.classList.remove('is-invalid');
                    }
                });
            }

            // Validação dinâmica de horários
            const startTimeInput = document.getElementById('startTime');
            const endTimeInput = document.getElementById('endTime');
            const allocationDateInput = document.getElementById('allocationDate');

            function validateTimes() {
                if (startTimeInput && endTimeInput && startTimeInput.value && endTimeInput.value) {
                    const startTime = startTimeInput.value;
                    const endTime = endTimeInput.value;
                    
                    if (startTime >= endTime) {
                        endTimeInput.setCustomValidity('O horário final deve ser maior que o horário inicial');
                        endTimeInput.classList.add('is-invalid');
                        endTimeInput.classList.remove('is-valid');
                        return false;
                    } else {
                        endTimeInput.setCustomValidity('');
                        endTimeInput.classList.remove('is-invalid');
                        endTimeInput.classList.add('is-valid');
                        return true;
                    }
                } else {
                    if (endTimeInput) {
                        endTimeInput.setCustomValidity('');
                        endTimeInput.classList.remove('is-invalid');
                    }
                    return true;
                }
            }

            // Auto-completar horário final quando inicial for preenchido
            if (startTimeInput && endTimeInput) {
                startTimeInput.addEventListener('change', function() {
                    validateTimes();
                    // Sugerir horário final (1 hora depois)
                    if (this.value && !endTimeInput.value) {
                        const [hours, minutes] = this.value.split(':');
                        const suggestedEnd = new Date();
                        suggestedEnd.setHours(parseInt(hours) + 1, parseInt(minutes), 0);
                        const suggestedTime = suggestedEnd.toTimeString().slice(0, 5);
                        endTimeInput.placeholder = `Sugestão: ${suggestedTime}`;
                    }
                });
                
                endTimeInput.addEventListener('change', validateTimes);
                endTimeInput.addEventListener('input', function() {
                    if (this.value) {
                        validateTimes();
                    }
                });
            }

            // Definir data mínima como hoje
            if (allocationDateInput) {
                const today = new Date().toISOString().split('T')[0];
                allocationDateInput.min = today;
                allocationDateInput.addEventListener('change', function() {
                    if (this.value) {
                        this.classList.add('is-valid');
                        this.classList.remove('is-invalid');
                    }
                });
            }

            // Feedback visual em tempo real para todos os campos
            const formInputs = document.querySelectorAll('#interestForm input');
            formInputs.forEach(input => {
                // Validação ao sair do campo
                input.addEventListener('blur', function() {
                    if (this.hasAttribute('required')) {
                        if (this.value.trim() !== '' && this.checkValidity()) {
                            this.classList.add('is-valid');
                            this.classList.remove('is-invalid');
                        } else if (this.value.trim() === '') {
                            this.classList.remove('is-valid');
                            this.classList.add('is-invalid');
                        }
                    } else if (this.value.trim() !== '') {
                        // Campos opcionais também recebem feedback quando preenchidos
                        this.classList.add('is-valid');
                        this.classList.remove('is-invalid');
                    }
                });

                // Remover erro ao começar a digitar
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.classList.remove('is-invalid');
                        if (this.checkValidity()) {
                            this.classList.add('is-valid');
                        }
                    } else {
                        this.classList.remove('is-valid');
                    }
                });
            });

            // Validação completa do formulário antes de enviar
            const interestForm = document.getElementById('interestForm');
            const submitBtn = document.getElementById('submitBtn');
            
            if (interestForm) {
                interestForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    // Validar horários
                    if (!validateTimes()) {
                        endTimeInput.focus();
                        this.classList.add('was-validated');
                        return false;
                    }

                    // Validar todos os campos obrigatórios
                    if (!this.checkValidity()) {
                        this.classList.add('was-validated');
                        // Focar no primeiro campo inválido
                        const firstInvalid = this.querySelector(':invalid');
                        if (firstInvalid) {
                            firstInvalid.focus();
                            firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }
                        return false;
                    }

                    // Desabilitar botão e mostrar loading
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';
                    }

                    // Enviar formulário
                    this.submit();
                });
            }

            // Animações suaves ao abrir o modal
            const interestModal = document.getElementById('interestModal');
            if (interestModal) {
                interestModal.addEventListener('shown.bs.modal', function() {
                    // Focar no primeiro campo
                    const firstInput = interestForm?.querySelector('input[required]');
                    if (firstInput) {
                        setTimeout(() => firstInput.focus(), 300);
                    }
                });
            }

        });
    </script>
}

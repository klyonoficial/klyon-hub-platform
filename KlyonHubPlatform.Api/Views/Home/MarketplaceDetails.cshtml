<!-- Modal de Galeria de Fotos -->
<div class="modal fade" id="photoGalleryModal" tabindex="-1" aria-labelledby="photoGalleryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white" id="photoGalleryModalLabel">Fotos do Coworking</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 position-relative" style="height: calc(100vh - 120px);">
                <div id="galleryCarousel" class="carousel slide h-100" data-bs-ride="carousel" data-bs-interval="false">
                    <div class="carousel-inner h-100">
                        @for (int i = 0; i < Model.PhotoIds.Count; i++)
                        {
                            <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                <div class="d-flex align-items-center justify-content-center h-100">
                                    <img src="@Url.Action("GetPhoto", "Coworking", new { photoId = Model.PhotoIds[i] })"

@{
    ViewData[ViewDataKeys.Title] = PageTitles.Index;
    Layout = LayoutPaths.LandingLayout;
    var urlChooseLocation = Url.Action(ActionNames.ChooseLocation, ControllerNames.Client);
    var urlFiscal = User.Identity?.IsAuthenticated == true && User.IsInRole("Client")
        ? urlChooseLocation
        : Url.Action(ActionNames.FiscalAddress, ControllerNames.Home);
    var urlSalas = User.Identity?.IsAuthenticated == true && User.IsInRole("Client")
        ? Url.Action(ActionNames.Marketplace, ControllerNames.Home)
        : Url.Action(ActionNames.Rooms, ControllerNames.Home);
    var urlParceiro = Url.Action(ActionNames.Partner, ControllerNames.Home);
    var enableCoworkingMenus = ViewData[ViewDataKeys.EnableCoworkingMenus] as bool? ?? true;
}

<section class="lp-commercial-hero lp-choice-section-alive">
    <div class="lp-choice-bg-glow"></div>
    <div class="lp-container position-relative text-center">
        <div class="lp-choice-header">
            <h1 class="lp-choice-title">Endereço fiscal para sua empresa</h1>
            <p class="lp-choice-subtitle mx-auto">
                Escolha a cidade, compare endereços verificados e contrate em poucos cliques, sem burocracia.
            </p>
            <a href="@urlChooseLocation" class="lp-btn-primary btn-lg mt-3" data-funnel="cta_home_fiscal_primary">
                <i class="fa-solid fa-building me-2" aria-hidden="true"></i> Ver endereços disponíveis
            </a>
            <p class="lp-text-muted small mt-3 mb-0">
                Já tem conta? <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)" class="link-light">Entrar</a>
            </p>
        </div>
    </div>
</section>

@if (enableCoworkingMenus)
{
<section class="lp-section py-4">
    <div class="lp-container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <a href="@urlSalas" class="lp-choice-card lp-choice-card-salas d-block text-decoration-none" data-funnel="cta_home_salas">
                    <div class="lp-choice-card-overlay"></div>
                    <div class="lp-choice-card-content py-4 px-4">
                        <h2 class="h4 mb-2"><i class="fa-solid fa-people-roof me-2" aria-hidden="true"></i>Aluguel de Salas</h2>
                        <p class="lp-choice-card-desc mb-3">Reserve salas de reunião, consultórios e espaços corporativos por hora.</p>
                        <span class="lp-choice-cta">Buscar salas <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
}

<section class="lp-section py-3 border-top border-secondary border-opacity-25">
    <div class="lp-container text-center">
        <p class="lp-text-muted small mb-2">Tem um coworking ou espaço corporativo?</p>
        <a href="@urlParceiro" class="lp-btn-secondary btn-sm" data-funnel="cta_home_parceiro_secondary">
            <i class="fa-solid fa-handshake me-1" aria-hidden="true"></i> Quero ser parceiro Klyon
        </a>
    </div>
</section>

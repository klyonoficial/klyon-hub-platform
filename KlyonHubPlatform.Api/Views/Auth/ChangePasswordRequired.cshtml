@{
    ViewData[ViewDataKeys.Title] = PageTitles.ChangePasswordRequired;
    Layout = LayoutPaths.Layout;
    var mustChangePassword = ViewData[ViewDataKeys.MustChangePassword] as bool? ?? true;
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg mt-5">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-shield-exclamation"></i> @PageTitles.ChangePasswordRequired
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i> <strong>Atenção:</strong> Por segurança, você precisa alterar sua senha antes de continuar usando o sistema.
                    </div>

                    @if (ViewData[ViewDataKeys.Error] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle"></i> @ViewData[ViewDataKeys.Error]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" action="@Url.Action(ActionNames.ChangePasswordRequired, ControllerNames.Auth)">
                        @Html.AntiForgeryToken()

                        @if (!mustChangePassword)
                        {
                            <div class="mb-3">
                                <label for="currentPassword" class="form-label">Senha Atual <span class="text-danger">*</span></label>
                                <input type="password" class="form-control" id="currentPassword" name="currentPassword" required autofocus>
                            </div>
                        }

                        <div class="mb-3">
                            <label for="newPassword" class="form-label">Nova Senha <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6" @(mustChangePassword ? "autofocus" : null)>
                            <small class="form-text text-muted">Mínimo de 6 caracteres.</small>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirmar Nova Senha <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="6">
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-key"></i> Alterar Senha
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmPassword')?.addEventListener('input', function() {
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = this.value;

            if (newPassword !== confirmPassword) {
                this.setCustomValidity('As senhas não coincidem.');
            } else {
                this.setCustomValidity('');
            }
        });
    </script>
}

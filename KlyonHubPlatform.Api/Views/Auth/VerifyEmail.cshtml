@{
    ViewData["Title"] = "Verificar Email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-envelope-check"></i> Verificar Email
                    </h2>

                    @if (ViewData["Success"] != null)
                    {
                        var loginReturnUrl = ViewData["ReturnUrl"]?.ToString();
                        var loginUrl = string.IsNullOrEmpty(loginReturnUrl) ? Url.Action("Login", "Auth") : Url.Action("Login", "Auth") + "?returnUrl=" + Uri.EscapeDataString(loginReturnUrl);
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle"></i> @ViewData["Success"]
                            <div class="mt-3">
                                <a href="@loginUrl" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-in-right"></i> Fazer Login
                                </a>
                            </div>
                        </div>
                    }
                    else if (ViewData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @ViewData["Error"]
                        </div>
                    }
                    else if (ViewData["Message"] != null)
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> @ViewData["Message"]
                        </div>
                    }

                    @if (ViewData["Success"] == null)
                    {
                        <form method="post" action="@Url.Action("VerifyEmail", "Auth")">
                            <div class="mb-3">
                                <label for="token" class="form-label">Token de Verificação</label>
                                <input type="text" class="form-control" id="token" name="token" 
                                       value="@Context.Request.Query["token"]" 
                                       placeholder="Cole o token recebido por email" required>
                                <small class="form-text text-muted">
                                    Se você não recebeu o email, entre em contato com o administrador.
                                </small>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                <i class="bi bi-check-circle"></i> Verificar Email
                            </button>
                        </form>

                        <hr>

                        <div class="text-center">
                            <p class="text-muted">Não recebeu o email?</p>
                            <a href="@Url.Action("ResendVerification", "Auth")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise"></i> Solicitar Novo Token
                            </a>
                        </div>
                    }

                    <div class="text-center mt-4">
                        @{
                            var backReturnUrl = ViewData["ReturnUrl"]?.ToString();
                            var backLoginUrl = string.IsNullOrEmpty(backReturnUrl) ? Url.Action("Login", "Auth") : Url.Action("Login", "Auth") + "?returnUrl=" + Uri.EscapeDataString(backReturnUrl);
                        }
                        <a href="@backLoginUrl">Voltar para o login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

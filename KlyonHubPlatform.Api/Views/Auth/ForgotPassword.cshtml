@{
    ViewData["Title"] = "Recuperar Senha";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-key"></i> Recuperar Senha
                    </h2>

                    @if (ViewData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle"></i> @ViewData["Success"]
                        </div>
                    }

                    <form method="post" action="@Url.Action(ActionNames.ForgotPassword, ControllerNames.Auth)">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-send"></i> Enviar Link de Recuperação
                        </button>
                    </form>

                    <div class="text-center">
                        <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)">Voltar para o login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

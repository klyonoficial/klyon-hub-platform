@{
    ViewData[ViewDataKeys.Title] = "Recuperar Senha";
    Layout = LayoutPaths.Layout;
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-key"></i> Recuperar Senha
                    </h2>

                    @if (ViewData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-1"></i> @ViewData["Error"]
                        </div>
                    }

                    @if (ViewData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @ViewData["Success"]
                        </div>
                    }
                    else
                    {
                        <p id="forgotDescription" class="text-muted small mb-4">
                            Informe o <strong>e-mail</strong> cadastrado e o <strong>CPF ou CNPJ</strong> vinculado à sua conta.
                            Um link para redefinir a senha será enviado para o seu e-mail.
                        </p>

                        <div id="forgotAlertArea"></div>

                        <form id="forgotPasswordForm" method="post" action="@Url.Action(ActionNames.ForgotPassword, ControllerNames.Auth)" data-ajax-request="true">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="email" class="form-label fw-semibold">E-mail</label>
                                <input type="email" class="form-control" id="email" name="email"
                                       placeholder="seu@email.com" required autocomplete="email">
                            </div>
                            <div class="mb-4">
                                <label for="taxId" class="form-label fw-semibold">CPF ou CNPJ</label>
                                <input type="text" class="form-control" id="taxId" name="taxId"
                                       placeholder="000.000.000-00 ou 00.000.000/0001-00"
                                       maxlength="18" autocomplete="off" inputmode="numeric">
                                <div class="form-text">Digite apenas os números — a formatação é aplicada automaticamente.</div>
                                <div id="taxIdFeedback" class="invalid-feedback"></div>
                            </div>
                            <button type="submit" id="btnEnviarLink" class="btn btn-primary w-100 mb-3">
                                <i class="bi bi-send me-1"></i> Enviar Link de Recuperação
                            </button>
                        </form>
                    }

                    <div class="text-center mt-2">
                        <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)" class="text-muted small">Voltar para o login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var taxInput = document.getElementById('taxId');
    var form = document.getElementById('forgotPasswordForm');
    var btn = document.getElementById('btnEnviarLink');
    var alertArea = document.getElementById('forgotAlertArea');
    var taxFeedback = document.getElementById('taxIdFeedback');

    // Máscara dinâmica CPF/CNPJ — maxLength sempre 18 para não travar no CPF
    if (taxInput) {
        taxInput.maxLength = 18;
        taxInput.addEventListener('input', function () {
            var digits = this.value.replace(/\D/g, '').substring(0, 14);
            if (digits.length <= 11) {
                this.value = digits
                    .replace(/(\d{3})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d{1,2})$/, '$1-$2');
            } else {
                this.value = digits
                    .replace(/(\d{2})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d)/, '$1/$2')
                    .replace(/(\d{4})(\d{1,2})$/, '$1-$2');
            }
            this.classList.remove('is-invalid');
            if (taxFeedback) taxFeedback.textContent = '';
        });
    }

    function validateTaxId() {
        if (!taxInput) return true;
        var digits = taxInput.value.replace(/\D/g, '');
        var msg = digits.length === 0 ? 'Informe o CPF ou CNPJ.'
            : digits.length < 11 ? 'CPF incompleto — informe os 11 dígitos.'
            : (digits.length === 12 || digits.length === 13) ? 'CNPJ incompleto — informe os 14 dígitos.'
            : (digits.length !== 11 && digits.length !== 14) ? 'Informe um CPF (11 dígitos) ou CNPJ (14 dígitos).'
            : '';
        if (msg) {
            taxInput.classList.add('is-invalid');
            if (taxFeedback) taxFeedback.textContent = msg;
            taxInput.focus();
            return false;
        }
        taxInput.classList.remove('is-invalid');
        if (taxFeedback) taxFeedback.textContent = '';
        return true;
    }

    function showAlert(type, html) {
        if (!alertArea) return;
        alertArea.innerHTML = '<div class="alert alert-' + type + '" role="alert">' + html + '</div>';
    }

    if (form) {
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            if (!validateTaxId()) {
                if (window.KlyonLoading) window.KlyonLoading.hide();
                return;
            }

            var emailEl = document.getElementById('email');
            if (emailEl && !emailEl.value.trim()) {
                emailEl.focus();
                return;
            }

            if (alertArea) alertArea.innerHTML = '';
            if (btn) btn.disabled = true;
            if (window.KlyonLoading) window.KlyonLoading.show();

            var formData = new FormData(form);
            var params = new URLSearchParams();
            formData.forEach(function (value, key) { params.append(key, value); });

            fetch(form.action, {
                method: 'POST',
                body: params,
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                redirect: 'follow'
            })
                .then(function (response) {
                    if (response.redirected) {
                        window.location.href = response.url;
                        return;
                    }
                    return response.json().then(function (data) {
                        if (window.KlyonLoading) window.KlyonLoading.hide();
                        if (data.success) {
                            showAlert('success', '<i class="bi bi-check-circle me-1"></i> ' + data.message);
                            if (form) form.style.display = 'none';
                            var desc = document.getElementById('forgotDescription');
                            if (desc) desc.style.display = 'none';
                        } else {
                            if (btn) btn.disabled = false;
                            showAlert('danger', '<i class="bi bi-exclamation-triangle me-1"></i> ' + (data.error || 'Não foi possível processar a solicitação. Tente novamente.'));
                        }
                    });
                })
                .catch(function () {
                    if (window.KlyonLoading) window.KlyonLoading.hide();
                    if (btn) btn.disabled = false;
                    showAlert('danger', '<i class="bi bi-exclamation-triangle me-1"></i> <strong>Erro de conexão.</strong> Verifique sua internet e tente novamente.');
                });
        });
    }
})();
</script>

@{
    ViewData[ViewDataKeys.Title] = "Definir Senha";
    Layout = LayoutPaths.Layout;
    var requireTaxId = ViewBag.RequireTaxId == true;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-key"></i> Definir Senha
                    </h2>

                    @if (ViewData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-1"></i> @ViewData["Error"]
                        </div>
                    }

                    @if (ViewData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @ViewData["Success"]
                        </div>
                        <div class="text-center mt-3">
                            @if (isAuthenticated)
                            {
                                <a href="@Url.Action(ActionNames.DashboardDetails, ControllerNames.Client)" class="btn btn-primary rounded-pill px-4">
                                    <i class="bi bi-speedometer2 me-1"></i> Ir Para Dashboard
                                </a>
                            }
                            else
                            {
                                <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)" class="btn btn-primary rounded-pill px-4">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Fazer Login
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        @if (requireTaxId)
                        {
                            <div class="alert alert-info d-flex align-items-start gap-2 mb-4" role="alert" style="font-size:.9rem;">
                                <i class="bi bi-shield-lock-fill mt-1 flex-shrink-0"></i>
                                <span>Para proteger sua conta, confirme o <strong>CPF ou CNPJ</strong> cadastrado antes de definir sua senha.</span>
                            </div>
                        }

                        <form method="post" asp-action="ResetPassword" asp-controller="Auth" id="resetPasswordForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="token" value="@Context.Request.Query["token"]">

                            @if (requireTaxId)
                            {
                                <div class="mb-3">
                                    <label for="taxId" class="form-label fw-semibold">CPF ou CNPJ</label>
                                    <input type="text" class="form-control" id="taxId" name="taxId"
                                           placeholder="000.000.000-00 ou 00.000.000/0001-00"
                                           maxlength="18" required autocomplete="off" inputmode="numeric">
                                    <div class="form-text">Digite apenas os números; a formatação é aplicada automaticamente.</div>
                                </div>
                            }

                            <div class="mb-3">
                                <label for="newPassword" class="form-label fw-semibold">Nova Senha</label>
                                <input type="password" class="form-control" id="newPassword" name="newPassword"
                                       required minlength="6" autocomplete="new-password">
                            </div>
                            <div class="mb-4">
                                <label for="confirmPassword" class="form-label fw-semibold">Confirmar Nova Senha</label>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                                       required minlength="6" autocomplete="new-password">
                            </div>

                            <button type="submit" id="btnDefinirSenha" class="btn btn-primary w-100 mb-3 rounded-pill">
                                <span id="btnDefinirSenhaText">
                                    <i class="bi bi-key me-1"></i> Definir Senha
                                </span>
                                <span id="btnDefinirSenhaLoading" class="d-none">
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                    Salvando...
                                </span>
                            </button>
                        </form>
                    }

                    @if (!isAuthenticated)
                    {
                        <div class="text-center mt-2">
                            <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)" class="text-muted small">Voltar para o login</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var taxInput = document.getElementById('taxId');

    // Máscara dinâmica CPF/CNPJ
    // maxLength sempre 18 para permitir digitar os 14 dígitos do CNPJ sem travar no CPF
    if (taxInput) {
        taxInput.maxLength = 18;
        taxInput.addEventListener('input', function () {
            var digits = this.value.replace(/\D/g, '').substring(0, 14);
            if (digits.length <= 11) {
                this.value = digits
                    .replace(/(\d{3})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d{1,2})$/, '$1-$2');
            } else {
                this.value = digits
                    .replace(/(\d{2})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d)/, '$1.$2')
                    .replace(/(\d{3})(\d)/, '$1/$2')
                    .replace(/(\d{4})(\d{1,2})$/, '$1-$2');
            }
            // Limpa erro ao digitar
            this.classList.remove('is-invalid');
            var fb = document.getElementById('taxIdFeedback');
            if (fb) fb.textContent = '';
        });
    }

    function validateTaxId() {
        if (!taxInput) return true;
        var digits = taxInput.value.replace(/\D/g, '');
        var fb = document.getElementById('taxIdFeedback');
        if (!fb) {
            fb = document.createElement('div');
            fb.id = 'taxIdFeedback';
            fb.className = 'invalid-feedback';
            taxInput.parentNode.appendChild(fb);
        }
        var msg = '';
        if (digits.length === 0) {
            msg = 'Informe o CPF ou CNPJ.';
        } else if (digits.length > 0 && digits.length < 11) {
            msg = 'CPF incompleto: informe os 11 dígitos.';
        } else if (digits.length === 12 || digits.length === 13) {
            msg = 'CNPJ incompleto: informe os 14 dígitos.';
        } else if (digits.length !== 11 && digits.length !== 14) {
            msg = 'Informe um CPF (11 dígitos) ou CNPJ (14 dígitos) válido.';
        }
        if (msg) {
            taxInput.classList.add('is-invalid');
            fb.textContent = msg;
            taxInput.focus();
            return false;
        }
        taxInput.classList.remove('is-invalid');
        fb.textContent = '';
        return true;
    }

    // Validação do formulário ao submeter
    var form = document.getElementById('resetPasswordForm');
    if (form) {
        form.addEventListener('submit', function (e) {
            // Valida CPF/CNPJ antes das senhas
            if (taxInput && !validateTaxId()) {
                e.preventDefault();
                return;
            }

            var pwd = document.getElementById('newPassword');
            var confirm = document.getElementById('confirmPassword');
            if (pwd && confirm && pwd.value !== confirm.value) {
                e.preventDefault();
                if (typeof showToast === 'function') showToast('As senhas não coincidem!', 'warning');
                else alert('As senhas não coincidem!');
                return;
            }

            var btn = document.getElementById('btnDefinirSenha');
            var txtSpan = document.getElementById('btnDefinirSenhaText');
            var loadSpan = document.getElementById('btnDefinirSenhaLoading');
            if (btn) btn.disabled = true;
            if (txtSpan) txtSpan.classList.add('d-none');
            if (loadSpan) loadSpan.classList.remove('d-none');
        });
    }
})();
</script>

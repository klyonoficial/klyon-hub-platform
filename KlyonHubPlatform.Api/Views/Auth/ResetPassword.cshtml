@{
    ViewData[ViewDataKeys.Title] = "Redefinir Senha";
    Layout = LayoutPaths.Layout;
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-key"></i> Redefinir Senha
                    </h2>

                    @if (ViewData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @ViewData["Error"]
                        </div>
                    }

                    @if (ViewData["Success"] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle"></i> @ViewData["Success"]
                            <div class="mt-3">
                                <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)" class="btn btn-primary">
                                    <i class="bi bi-box-arrow-in-right"></i> Fazer Login
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form method="post" action="@Url.Action(ActionNames.ResetPassword, ControllerNames.Auth)">
                            <input type="hidden" name="token" value="@Context.Request.Query["token"]">
                            <div class="mb-3">
                                <label for="newPassword" class="form-label">Nova Senha</label>
                                <input type="password" class="form-control" id="newPassword" name="newPassword" required minlength="6">
                            </div>
                            <div class="mb-3">
                                <label for="confirmPassword" class="form-label">Confirmar Nova Senha</label>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required minlength="6">
                            </div>
                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                <i class="bi bi-key"></i> Redefinir Senha
                            </button>
                        </form>
                    }

                    <div class="text-center">
                        <a href="@Url.Action(ActionNames.Login, ControllerNames.Auth)">Voltar para o login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.querySelector('form')?.addEventListener('submit', function(e) {
    var password = document.getElementById('newPassword').value;
    var confirmPassword = document.getElementById('confirmPassword').value;
    
    if (password !== confirmPassword) {
        e.preventDefault();
        showToast('As senhas não coincidem!', 'warning');
        return false;
    }
});
</script>

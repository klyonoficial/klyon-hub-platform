@{
    ViewData[ViewDataKeys.Title] = "Reenviar Verificação";
    Layout = LayoutPaths.Layout;
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-arrow-clockwise"></i> Reenviar Verificação
                    </h2>

                    @if (ViewData["Message"] != null)
                    {
                        <div class="alert alert-info" role="alert">
                            <i class="bi bi-info-circle"></i> @ViewData["Message"]
                        </div>
                    }

                    <form method="post" action="@Url.Action("ResendVerification", "Auth")">
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-send"></i> Solicitar Novo Token
                        </button>
                    </form>

                    <div class="text-center">
                        <a href="@Url.Action("Login", "Auth")">Voltar para o login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

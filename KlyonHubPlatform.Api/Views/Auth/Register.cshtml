@{
    ViewData[ViewDataKeys.Title] = "Cadastro";
    Layout = LayoutPaths.Layout;
    var initialRole = ViewBag.RegisterRole as string ?? ViewBag.PreSelectedRole as string ?? "Client";
    var isPartnerRegistration = string.Equals(initialRole, "CoworkingPartner", StringComparison.OrdinalIgnoreCase);
    var preservedFullName = ViewBag.RegisterFullName as string;
    var preservedEmail = ViewBag.RegisterEmail as string;
    var preservedAcceptLgpd = ViewBag.RegisterAcceptLgpdTerms as bool? == true;
    var showLgpdError = ViewData["Error"] != null && ViewData["Error"]?.ToString()?.Contains("Termos de Uso") == true;
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-person-plus"></i> @(isPartnerRegistration ? "Candidatar meu espaço" : "Criar Conta")
                    </h2>

                    @if (ViewData["Error"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @ViewData["Error"]
                        </div>
                    }

                    <form method="post" action="@Url.Action("Register", "Auth")">
                        @if (ViewData["ReturnUrl"] != null && !string.IsNullOrEmpty(ViewData["ReturnUrl"]?.ToString()))
                        {
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                        }
                        <div class="mb-3">
                            <label for="fullName" class="form-label">Nome Completo</label>
                            <input type="text" class="form-control" id="fullName" name="fullName" value="@preservedFullName" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" value="@preservedEmail" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="password" name="password" required minlength="6">
                        </div>
                        <div class="mb-3 @(isPartnerRegistration ? "d-none" : "")">
                            <label for="role" class="form-label">Tipo de Conta</label>
                            <select class="form-select" id="role" name="role">
                                <option value="Client">Cliente (Empresa/Profissional)</option>
                                <option value="CoworkingPartner">Coworking Parceiro</option>
                            </select>
                        </div>
                        @if (isPartnerRegistration)
                        {
                            <input type="hidden" name="role" value="CoworkingPartner" />
                        }
                        <div class="mb-3 d-none" id="cpfContainer">
                            <label for="cpf" class="form-label">
                                CPF <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="form-control" id="cpf" name="cpf"
                                   placeholder="000.000.000-00" maxlength="14"
                                   autocomplete="off" inputmode="numeric">
                            <div id="cpfFeedback" class="invalid-feedback"></div>
                            <div class="form-text">Digite apenas os números — a formatação é aplicada automaticamente.</div>
                        </div>
                        <div class="mb-3 d-none" id="hasCnpjContainer">
                            <label class="form-label fw-semibold">Possui CNPJ?</label>
                            <div class="d-flex gap-3 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="hasCnpj" id="hasCnpjSim" value="true">
                                    <label class="form-check-label" for="hasCnpjSim">Sim</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="hasCnpj" id="hasCnpjNao" value="false" checked>
                                    <label class="form-check-label" for="hasCnpjNao">Não</label>
                                </div>
                            </div>
                            <div id="cnpjFieldContainer" class="d-none">
                                <label for="cnpj" class="form-label">CNPJ <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="cnpj" name="cnpj"
                                       placeholder="00.000.000/0001-00" maxlength="18"
                                       autocomplete="off" inputmode="numeric">
                                <div id="cnpjFeedback" class="invalid-feedback"></div>
                                <div class="form-text">Digite apenas os números — a formatação é aplicada automaticamente.</div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input type="hidden" name="acceptLgpdTerms" id="acceptLgpdTermsValue" value="@(preservedAcceptLgpd ? "true" : "false")">
                                <input class="form-check-input @(showLgpdError ? "is-invalid" : "")" type="checkbox" id="acceptLgpdTerms" aria-describedby="lgpdError" @(preservedAcceptLgpd ? "checked" : "")>
                                <label class="form-check-label" for="acceptLgpdTerms">
                                    Li e aceito os <a href="javascript:void(0)" class="link-primary" data-bs-toggle="modal" data-bs-target="#modalTermosLgpd">Termos de Uso e a Política de Privacidade (LGPD)</a>.
                                </label>
                            </div>
                            <div id="lgpdError" class="alert alert-danger mt-2 @(showLgpdError ? "" : "d-none")" role="alert">
                                <i class="bi bi-exclamation-triangle me-1"></i> É obrigatório aceitar os Termos de Uso e a Política de Privacidade (LGPD) para criar sua conta.
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3" id="btnCadastrar">
                            <i class="bi bi-person-plus"></i> @(isPartnerRegistration ? "Criar conta e continuar" : "Cadastrar")
                        </button>
                    </form>

                    <div class="text-center">
                        <p>Já tem uma conta? <a href="@(Url.Action("Login", "Auth") + (ViewData["ReturnUrl"] != null && !string.IsNullOrEmpty(ViewData["ReturnUrl"]?.ToString()) ? "?returnUrl=" + Uri.EscapeDataString(ViewData["ReturnUrl"]!.ToString()!) : ""))">Entrar</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Termos de Uso e LGPD -->
<div class="modal fade" id="modalTermosLgpd" tabindex="-1" aria-labelledby="modalTermosLgpdLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTermosLgpdLabel">Termos de Uso e Política de Privacidade (LGPD)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body p-0">
                <iframe src="@Url.Action("TermosUsoLgpd", "Home", new { embed = 1 })" title="Termos de Uso e LGPD" class="w-100 border-0" style="min-height: 70vh;"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var sel = document.getElementById('role');
        if (sel && '@initialRole') sel.value = '@initialRole';

        var cpfContainer       = document.getElementById('cpfContainer');
        var cpfInput           = document.getElementById('cpf');
        var cpfFeedback        = document.getElementById('cpfFeedback');
        var hasCnpjContainer   = document.getElementById('hasCnpjContainer');
        var cnpjFieldContainer = document.getElementById('cnpjFieldContainer');
        var cnpjInput          = document.getElementById('cnpj');
        var cnpjFeedback       = document.getElementById('cnpjFeedback');

        var preservedHasCnpj = '@(ViewBag.RegisterHasCnpj as string ?? "")';
        var preservedCnpj    = '@(ViewBag.RegisterCnpj as string ?? "")';
        var preservedCpf     = '@(ViewBag.RegisterCpf as string ?? "")';

        // ── CPF: limpa erro ao digitar; valida algoritmo ao sair do campo
        if (cpfInput) {
            cpfInput.addEventListener('input', function () {
                this.classList.remove('is-invalid');
                if (cpfFeedback) cpfFeedback.textContent = '';
            });
            cpfInput.addEventListener('blur', function () {
                if (!this.value) return;
                var valid = typeof validateCPF === 'function'
                    ? validateCPF(this.value)
                    : this.value.replace(/\D/g, '').length === 11;
                if (!valid) {
                    this.classList.add('is-invalid');
                    if (cpfFeedback) cpfFeedback.textContent = 'CPF inválido. Verifique os dígitos informados.';
                } else {
                    this.classList.remove('is-invalid');
                    if (cpfFeedback) cpfFeedback.textContent = '';
                }
            });
            if (preservedCpf) cpfInput.value = preservedCpf;
        }

        // ── CNPJ: limpa erro ao digitar; valida algoritmo ao sair do campo
        if (cnpjInput) {
            cnpjInput.addEventListener('input', function () {
                this.classList.remove('is-invalid');
                if (cnpjFeedback) cnpjFeedback.textContent = '';
            });
            cnpjInput.addEventListener('blur', function () {
                if (!this.value) return;
                var valid = typeof validateCNPJ === 'function'
                    ? validateCNPJ(this.value)
                    : this.value.replace(/\D/g, '').length === 14;
                if (!valid) {
                    this.classList.add('is-invalid');
                    if (cnpjFeedback) cnpjFeedback.textContent = 'CNPJ inválido. Verifique os dígitos informados.';
                } else {
                    this.classList.remove('is-invalid');
                    if (cnpjFeedback) cnpjFeedback.textContent = '';
                }
            });
            if (preservedCnpj) cnpjInput.value = preservedCnpj;
        }

        // ── Mostra/esconde campo CNPJ
        function toggleCnpjField() {
            var hasSim = document.getElementById('hasCnpjSim');
            if (hasSim && hasSim.checked) {
                cnpjFieldContainer.classList.remove('d-none');
                if (cnpjInput) cnpjInput.required = true;
            } else {
                cnpjFieldContainer.classList.add('d-none');
                if (cnpjInput) { cnpjInput.required = false; cnpjInput.value = ''; cnpjInput.classList.remove('is-invalid'); }
            }
        }

        // ── Mostra/esconde seção de campos de cliente conforme papel selecionado
        function toggleHasCnpj() {
            var isClient = sel && sel.value === 'Client';
            if (cpfContainer)     { cpfContainer.classList.toggle('d-none', !isClient); if (cpfInput) cpfInput.required = isClient; }
            if (hasCnpjContainer) hasCnpjContainer.classList.toggle('d-none', !isClient);
            if (isClient) {
                if (preservedHasCnpj === 'true') document.getElementById('hasCnpjSim').checked = true;
                else if (preservedHasCnpj === 'false') document.getElementById('hasCnpjNao').checked = true;
            }
            toggleCnpjField();
        }

        var hasCnpjSim = document.getElementById('hasCnpjSim');
        var hasCnpjNao = document.getElementById('hasCnpjNao');
        if (hasCnpjSim) hasCnpjSim.addEventListener('change', toggleCnpjField);
        if (hasCnpjNao) hasCnpjNao.addEventListener('change', toggleCnpjField);

        if (sel) {
            sel.addEventListener('change', toggleHasCnpj);
            toggleHasCnpj();
        }

        // ── Validação no submit
        var form = document.querySelector('form[action*="Register"]');
        var acceptCheckbox = document.getElementById('acceptLgpdTerms');
        var acceptHidden   = document.getElementById('acceptLgpdTermsValue');
        var lgpdError      = document.getElementById('lgpdError');

        function syncAcceptLgpd() {
            if (acceptHidden) acceptHidden.value = acceptCheckbox && acceptCheckbox.checked ? 'true' : 'false';
        }

        if (form && acceptCheckbox && acceptHidden) {
            acceptCheckbox.addEventListener('change', function() {
                syncAcceptLgpd();
                if (acceptCheckbox.checked) {
                    lgpdError.classList.add('d-none');
                    acceptCheckbox.classList.remove('is-invalid');
                }
            });

            form.addEventListener('submit', function(e) {
                syncAcceptLgpd();
                var blocked = false;

                // LGPD
                if (!acceptCheckbox.checked) {
                    lgpdError.classList.remove('d-none');
                    acceptCheckbox.classList.add('is-invalid');
                    blocked = true;
                } else {
                    lgpdError.classList.add('d-none');
                    acceptCheckbox.classList.remove('is-invalid');
                }

                // CPF (validateCPF de validation.js)
                if (cpfInput && cpfInput.required) {
                    var cpfValid = typeof validateCPF === 'function'
                        ? validateCPF(cpfInput.value)
                        : cpfInput.value.replace(/\D/g, '').length === 11;
                    if (!cpfValid) {
                        cpfInput.classList.add('is-invalid');
                        if (cpfFeedback) cpfFeedback.textContent = 'CPF inválido. Verifique os dígitos informados.';
                        blocked = true;
                    }
                }

                // CNPJ (validateCNPJ de validation.js)
                if (cnpjInput && cnpjInput.required) {
                    var cnpjValid = typeof validateCNPJ === 'function'
                        ? validateCNPJ(cnpjInput.value)
                        : cnpjInput.value.replace(/\D/g, '').length === 14;
                    if (!cnpjValid) {
                        cnpjInput.classList.add('is-invalid');
                        if (cnpjFeedback) cnpjFeedback.textContent = 'CNPJ inválido. Verifique os dígitos informados.';
                        blocked = true;
                    }
                }

                if (blocked) {
                    e.preventDefault();
                    if (typeof window.KlyonLoading !== 'undefined' && window.KlyonLoading.hide) {
                        window.KlyonLoading.hide();
                    }
                    return false;
                }
            });
        }
    });
</script>

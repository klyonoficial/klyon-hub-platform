@{
    ViewData[ViewDataKeys.Title] = PageTitles.Login;
    Layout = LayoutPaths.Layout;
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">
                        <i class="bi bi-box-arrow-in-right"></i> Entrar
                    </h2>

                    @if (ViewData[ViewDataKeys.Error] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @ViewData[ViewDataKeys.Error]
                        </div>
                    }

                    @if (ViewData[ViewDataKeys.Success] != null)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle"></i> @ViewData[ViewDataKeys.Success]
                        </div>
                    }

                    <form method="post" action="@Url.Action(ActionNames.Login, ControllerNames.Auth)">
                        @if (ViewData[ViewDataKeys.ReturnUrl] != null)
                        {
                            <input type="hidden" name="returnUrl" value="@ViewData[ViewDataKeys.ReturnUrl]" />
                        }
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="password" name="password" required>
                        </div>
                        <div class="mb-3 form-check">
                            <input type="checkbox" class="form-check-input" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">
                                Lembrar-me
                            </label>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right"></i> Entrar
                        </button>
                    </form>

                    <div class="text-center">
                        <a href="@Url.Action(ActionNames.ForgotPassword, ControllerNames.Auth)">Esqueceu sua senha?</a>
                    </div>
                    <hr>
                    <div class="text-center">
                        <p>Não tem uma conta? <a href="@(Url.Action(ActionNames.Register, ControllerNames.Auth) + (ViewData[ViewDataKeys.ReturnUrl] != null && !string.IsNullOrEmpty(ViewData[ViewDataKeys.ReturnUrl]?.ToString()) ? "?returnUrl=" + Uri.EscapeDataString(ViewData[ViewDataKeys.ReturnUrl]!.ToString()!) : ""))">Cadastre-se</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

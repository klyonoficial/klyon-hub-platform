@{
    ViewData["Title"] = "Escolher Localidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonEF.Models.Location>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-geo-alt"></i> Escolher Localidade</h2>
</div>

<div class="row">
    @foreach (var location in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-geo-alt-fill text-primary"></i> @location.City
                    </h5>
                    <p class="card-text">
                        <strong>Estado:</strong> @location.State<br>
                        <strong>Região:</strong> @location.Region
                    </p>
                    <a href="@Url.Action("AvailableAddresses", "Client", new { locationId = location.Id })" class="btn btn-primary">
                        <i class="bi bi-arrow-right"></i> Ver Endereços Disponíveis
                    </a>
                </div>
            </div>
        </div>
    }
</div>

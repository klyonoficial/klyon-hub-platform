@{
    ViewData["Title"] = "Editar Usuário";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonEF.Models.User

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Usuário</h2>
    <a href="@Url.Action("Users", "Admin")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form method="post" action="@Url.Action("EditUser", "Admin", new { id = Model.Id })">
                    <input type="hidden" name="id" value="@Model.Id">
                    
                    <div class="mb-3">
                        <label for="fullName" class="form-label">Nome Completo</label>
                        <input type="text" class="form-control" id="fullName" name="fullName" value="@Model.FullName" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" value="@Model.Email" required>
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">Telefone</label>
                        <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone">
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isActive" name="isActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <input type="hidden" name="isActive" value="false">
                            <label class="form-check-label" for="isActive">
                                Usuário Ativo
                            </label>
                        </div>
                        <small class="form-text text-muted">Quando marcado, o usuário poderá fazer login no sistema.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Roles (Perfis)</label>
                        <div class="border p-3 rounded">
                            @foreach (var role in ViewBag.AllRoles as List<KlyonEF.Models.Role>)
                            {
                                var userRoles = ViewBag.UserRoles as List<int>;
                                var isChecked = userRoles?.Contains(role.Id) ?? false;
                                
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" 
                                           id="role_@role.Id" 
                                           name="roleIds" 
                                           value="@role.Id"
                                           @(isChecked ? "checked" : "")>
                                    <label class="form-check-label" for="role_@role.Id">
                                        @role.Name
                                        <small class="text-muted">(@role.Description)</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Informações</h5>
            </div>
            <div class="card-body">
                <p><strong>ID:</strong> @Model.Id</p>
                <p><strong>Cadastrado em:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy")</p>
                <p><strong>Email Verificado:</strong> 
                    @if (Model.EmailVerified)
                    {
                        <i class="bi bi-check-circle text-success"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-circle text-danger"></i>
                    }
                </p>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Gerenciar Coworkings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<KlyonEF.Models.Coworking>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-building"></i> Gerenciar Coworkings</h2>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Coworkings", "Admin")" class="row g-3">
            <div class="col-md-4">
                <label for="search" class="form-label">Buscar</label>
                <input type="text" class="form-control" id="search" name="search" 
                       value="@ViewBag.Search" placeholder="Nome, CNPJ ou Email">
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select class="form-select" id="status" name="status">
                    <option value="">Todos</option>
                    <option value="active" selected="@(ViewBag.Status == "active")">Ativos</option>
                    <option value="inactive" selected="@(ViewBag.Status == "inactive")">Inativos</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="isPartner" class="form-label">Tipo</label>
                <select class="form-select" id="isPartner" name="isPartner">
                    <option value="">Todos</option>
                    <option value="true" selected="@(ViewBag.IsPartner == "true")">Parceiros</option>
                    <option value="false" selected="@(ViewBag.IsPartner == "false")">Próprios</option>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filtrar
                </button>
                <a href="@Url.Action("Coworkings", "Admin")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Limpar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Informações de paginação -->
@if (ViewBag.TotalItems != null)
{
    <div class="mb-3">
        <p class="text-muted mb-0">
            Mostrando <strong>@((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1)</strong> a 
            <strong>@(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems))</strong> de 
            <strong>@ViewBag.TotalItems</strong> coworking(s)
        </p>
    </div>
}

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>CNPJ</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Endereços</th>
                            <th>Status</th>
                            <th>Tipo</th>
                            <th>Data Cadastro</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var coworking in Model)
                        {
                            <tr>
                                <td>@coworking.Id</td>
                                <td>@coworking.Name</td>
                                <td>@coworking.CNPJ</td>
                                <td>@coworking.ContactEmail</td>
                                <td>@coworking.ContactPhone</td>
                                <td>
                                    <span class="badge bg-info">@(coworking.Addresses?.Count ?? 0) endereços</span>
                                </td>
                                <td>
                                    <span class="badge bg-@(coworking.IsActive ? "success" : "danger")">
                                        @(coworking.IsActive ? "Ativo" : "Inativo")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@(coworking.IsPartner ? "primary" : "secondary")">
                                        @(coworking.IsPartner ? "Parceiro" : "Próprio")
                                    </span>
                                </td>
                                <td>@coworking.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="viewCoworking(@coworking.Id)" title="Visualizar">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="editCoworking(@coworking.Id)" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Paginação -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Paginação">
                    <ul class="pagination justify-content-center mt-3">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    page = ViewBag.CurrentPage - 1 
                                })">
                                    <i class="bi bi-chevron-left"></i> Anterior
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    page = i 
                                })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Coworkings", "Admin", new { 
                                    search = ViewBag.Search, 
                                    status = ViewBag.Status, 
                                    isPartner = ViewBag.IsPartner, 
                                    page = ViewBag.CurrentPage + 1 
                                })">
                                    Próxima <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Nenhum coworking encontrado.
            </div>
        }
    </div>
</div>

<script>
function viewCoworking(coworkingId) {
    alert('Visualizar coworking: ' + coworkingId);
}

function editCoworking(coworkingId) {
    alert('Editar coworking: ' + coworkingId);
}
</script>

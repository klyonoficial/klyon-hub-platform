@{
    ViewData["Title"] = "Cadastrar Localidade";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-plus-circle"></i> Cadastrar Nova Localidade</h2>
    <a href="@Url.Action("Locations", "Admin")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5>Informações da Localidade</h5>
            </div>
            <div class="card-body">
                <form method="post" action="@Url.Action("CreateLocation", "Admin")">
                    <div class="mb-3">
                        <label for="city" class="form-label">Cidade <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="city" name="city" required maxlength="100" placeholder="Ex: São Paulo">
                    </div>

                    <div class="mb-3">
                        <label for="state" class="form-label">Estado (UF) <span class="text-danger">*</span></label>
                        <select class="form-select" id="state" name="state" required>
                            <option value="">Selecione o estado</option>
                            @foreach (var stateOption in ViewBag.BrazilianStates as List<string>)
                            {
                                <option value="@stateOption">@stateOption</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="region" class="form-label">Região</label>
                        <select class="form-select" id="region" name="region">
                            <option value="">Selecione a região</option>
                            @foreach (var regionOption in ViewBag.Regions as List<string>)
                            {
                                <option value="@regionOption">@regionOption</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="commissionPercentage" class="form-label">Comissão Inicial (%)</label>
                        <input type="number" step="0.1" min="0" max="100" class="form-control" 
                               id="commissionPercentage" name="commissionPercentage" 
                               value="15.0" required>
                        <small class="form-text text-muted">Comissão padrão que será aplicada a esta localidade.</small>
                    </div>

                    <div class="mb-3 form-check">
                        <input type="hidden" name="isActive" value="false">
                        <input type="checkbox" class="form-check-input" id="isActive" name="isActive" value="true" checked>
                        <label class="form-check-label" for="isActive">
                            Localidade Ativa
                        </label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Locations", "Admin")" class="btn btn-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Cadastrar Localidade
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="bi bi-info-circle"></i> Informações</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">
                    <strong>Campos obrigatórios:</strong> Cidade e Estado são obrigatórios para cadastrar uma nova localidade.
                </p>
                <p class="text-muted">
                    <strong>Comissão:</strong> A comissão inicial será aplicada automaticamente. Você pode alterá-la depois na lista de localidades.
                </p>
                <p class="text-muted">
                    <strong>Status:</strong> Apenas localidades ativas aparecerão para os clientes na escolha de endereço fiscal.
                </p>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Editar Endereço";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model KlyonEF.Models.CoworkingAddress

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-pencil"></i> Editar Endereço</h2>
    <a href="@Url.Action("MyAddresses", "Coworking")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Voltar
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-body">
        <form method="post" action="@Url.Action("EditAddress", "Coworking", new { id = Model.Id })">
            <!-- CEP como primeiro campo -->
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="ZipCode" class="form-label">CEP <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="ZipCode" name="ZipCode" 
                           value="@Model.ZipCode" placeholder="00000-000" maxlength="9" required
                           onkeypress="return onlyNumbers(event)"
                           onblur="buscarCEP(this.value)">
                    <small class="form-text text-muted">Digite o CEP para buscar o endereço automaticamente</small>
                </div>
                <div class="col-md-8 mb-3">
                    <label for="LocationId" class="form-label">Localidade <span class="text-danger">*</span></label>
                    <select class="form-select" id="LocationId" name="LocationId" required onchange="preencherEstado()">
                        <option value="">Selecione a localidade...</option>
                        @foreach (var location in ViewBag.Locations as List<KlyonEF.Models.Location>)
                        {
                            <option value="@location.Id" data-state="@location.State" 
                                    @(Model.LocationId == location.Id ? "selected" : "")>
                                @location.City/@location.State
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- Endereço -->
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label for="Address" class="form-label">Endereço <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Address" name="Address" value="@Model.Address" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="Number" class="form-label">Número <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Number" name="Number" value="@Model.Number" required>
                </div>
            </div>

            <!-- Complemento e Bairro -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Complement" class="form-label">Complemento</label>
                    <input type="text" class="form-control" id="Complement" name="Complement" value="@Model.Complement">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="Neighborhood" class="form-label">Bairro <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="Neighborhood" name="Neighborhood" value="@Model.Neighborhood" required>
                </div>
            </div>

            <!-- Cidade e Estado -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="City" class="form-label">Cidade <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="City" name="City" value="@Model.City" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="State" class="form-label">Estado (UF) <span class="text-danger">*</span></label>
                    <select class="form-select" id="State" name="State" required>
                        <option value="">Selecione o estado</option>
                        <option value="AC" @(Model.State == "AC" ? "selected" : "")>AC - Acre</option>
                        <option value="AL" @(Model.State == "AL" ? "selected" : "")>AL - Alagoas</option>
                        <option value="AP" @(Model.State == "AP" ? "selected" : "")>AP - Amapá</option>
                        <option value="AM" @(Model.State == "AM" ? "selected" : "")>AM - Amazonas</option>
                        <option value="BA" @(Model.State == "BA" ? "selected" : "")>BA - Bahia</option>
                        <option value="CE" @(Model.State == "CE" ? "selected" : "")>CE - Ceará</option>
                        <option value="DF" @(Model.State == "DF" ? "selected" : "")>DF - Distrito Federal</option>
                        <option value="ES" @(Model.State == "ES" ? "selected" : "")>ES - Espírito Santo</option>
                        <option value="GO" @(Model.State == "GO" ? "selected" : "")>GO - Goiás</option>
                        <option value="MA" @(Model.State == "MA" ? "selected" : "")>MA - Maranhão</option>
                        <option value="MT" @(Model.State == "MT" ? "selected" : "")>MT - Mato Grosso</option>
                        <option value="MS" @(Model.State == "MS" ? "selected" : "")>MS - Mato Grosso do Sul</option>
                        <option value="MG" @(Model.State == "MG" ? "selected" : "")>MG - Minas Gerais</option>
                        <option value="PA" @(Model.State == "PA" ? "selected" : "")>PA - Pará</option>
                        <option value="PB" @(Model.State == "PB" ? "selected" : "")>PB - Paraíba</option>
                        <option value="PR" @(Model.State == "PR" ? "selected" : "")>PR - Paraná</option>
                        <option value="PE" @(Model.State == "PE" ? "selected" : "")>PE - Pernambuco</option>
                        <option value="PI" @(Model.State == "PI" ? "selected" : "")>PI - Piauí</option>
                        <option value="RJ" @(Model.State == "RJ" ? "selected" : "")>RJ - Rio de Janeiro</option>
                        <option value="RN" @(Model.State == "RN" ? "selected" : "")>RN - Rio Grande do Norte</option>
                        <option value="RS" @(Model.State == "RS" ? "selected" : "")>RS - Rio Grande do Sul</option>
                        <option value="RO" @(Model.State == "RO" ? "selected" : "")>RO - Rondônia</option>
                        <option value="RR" @(Model.State == "RR" ? "selected" : "")>RR - Roraima</option>
                        <option value="SC" @(Model.State == "SC" ? "selected" : "")>SC - Santa Catarina</option>
                        <option value="SP" @(Model.State == "SP" ? "selected" : "")>SP - São Paulo</option>
                        <option value="SE" @(Model.State == "SE" ? "selected" : "")>SE - Sergipe</option>
                        <option value="TO" @(Model.State == "TO" ? "selected" : "")>TO - Tocantins</option>
                    </select>
                </div>
            </div>

            <!-- Preço e Máximo de Contratos -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="BasePrice" class="form-label">Preço Base (R$) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" min="0" class="form-control" id="BasePrice" name="BasePrice" 
                           value="@Model.BasePrice.ToString("F2")" required>
                    <small class="form-text text-muted">O valor deve ser maior ou igual a zero</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="MaxContracts" class="form-label">Máximo de Contratos <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" id="MaxContracts" name="MaxContracts" 
                           value="@Model.MaxContracts" min="@Model.CurrentContracts" required>
                    <small class="form-text text-muted">Mínimo: @Model.CurrentContracts (contratos ativos)</small>
                </div>
            </div>

            <!-- Status -->
            <div class="row">
                <div class="col-md-6 mb-3">
                    <input type="hidden" name="IsAvailable" value="false">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="IsAvailable" name="IsAvailable" 
                               value="true" @(Model.IsAvailable ? "checked" : "")>
                        <label class="form-check-label" for="IsAvailable">
                            Endereço Disponível
                        </label>
                    </div>
                    <small class="form-text text-muted">Desmarque para tornar o endereço indisponível</small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Atualizar Endereço
            </button>
        </form>
    </div>
</div>

<script>
// Formatar CEP
function formatarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    if (cep.length === 8) {
        return cep.substring(0, 5) + '-' + cep.substring(5);
    }
    return cep;
}

// Apenas números
function onlyNumbers(event) {
    const char = String.fromCharCode(event.which);
    if (!/[0-9]/.test(char)) {
        event.preventDefault();
        return false;
    }
    return true;
}

// Aplicar máscara de CEP
document.getElementById('ZipCode').addEventListener('input', function(e) {
    e.target.value = formatarCEP(e.target.value);
});

// Buscar CEP via API ViaCEP
async function buscarCEP(cep) {
    cep = cep.replace(/\D/g, '');
    
    if (cep.length !== 8) {
        return;
    }

    try {
        const response = await fetch(`https://viacep.com.br/ws/${cep}/json/`);
        const data = await response.json();

        if (!data.erro) {
            document.getElementById('Address').value = data.logradouro || '';
            document.getElementById('Neighborhood').value = data.bairro || '';
            document.getElementById('City').value = data.localidade || '';
            document.getElementById('State').value = data.uf || '';
            
            // Se o estado foi preenchido e há uma localidade selecionada, verificar compatibilidade
            const locationSelect = document.getElementById('LocationId');
            if (locationSelect.value && data.uf) {
                const selectedOption = locationSelect.options[locationSelect.selectedIndex];
                const locationState = selectedOption.getAttribute('data-state');
                if (locationState !== data.uf) {
                    alert('Atenção: O estado do CEP (' + data.uf + ') não corresponde ao estado da localidade selecionada (' + locationState + ').');
                }
            }
        } else {
            alert('CEP não encontrado. Por favor, preencha os dados manualmente.');
        }
    } catch (error) {
        console.error('Erro ao buscar CEP:', error);
        alert('Erro ao buscar CEP. Por favor, preencha os dados manualmente.');
    }
}

// Preencher estado quando selecionar localidade
function preencherEstado() {
    const locationSelect = document.getElementById('LocationId');
    const stateSelect = document.getElementById('State');
    
    if (locationSelect.value) {
        const selectedOption = locationSelect.options[locationSelect.selectedIndex];
        const state = selectedOption.getAttribute('data-state');
        
        if (state) {
            stateSelect.value = state;
        }
    }
}

// Validar preço base (não permitir valores negativos)
document.getElementById('BasePrice').addEventListener('input', function(e) {
    const value = parseFloat(e.target.value);
    if (value < 0) {
        e.target.setCustomValidity('O preço base não pode ser negativo.');
        e.target.value = '';
    } else {
        e.target.setCustomValidity('');
    }
});

// Validar maxContracts (não pode ser menor que currentContracts)
document.getElementById('MaxContracts').addEventListener('input', function(e) {
    const minValue = parseInt(e.target.min);
    const value = parseInt(e.target.value);
    if (value < minValue) {
        e.target.setCustomValidity('O máximo de contratos não pode ser menor que ' + minValue + '.');
    } else {
        e.target.setCustomValidity('');
    }
});

// Validar antes de enviar o formulário
document.querySelector('form').addEventListener('submit', function(e) {
    const basePrice = parseFloat(document.getElementById('BasePrice').value);
    if (basePrice < 0) {
        e.preventDefault();
        alert('O preço base não pode ser negativo. Por favor, informe um valor maior ou igual a zero.');
        document.getElementById('BasePrice').focus();
        return false;
    }

    const maxContracts = parseInt(document.getElementById('MaxContracts').value);
    const minContracts = parseInt(document.getElementById('MaxContracts').min);
    if (maxContracts < minContracts) {
        e.preventDefault();
        alert('O máximo de contratos não pode ser menor que ' + minContracts + '.');
        document.getElementById('MaxContracts').focus();
        return false;
    }
});
</script>
